{% extends "templates/base.twig" %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
<style>
:root{
    --gourmet-primary:#f59e0b;
    --gourmet-primary-dark:#d97706;
    --gourmet-accent:#fb923c;
    --gourmet-cream:#fff8ef;
    --gourmet-soft:#fff3df;
    --gourmet-dark:#1f1307;
    --gourmet-text:#2d241c;
    --gourmet-muted:#6f6255;
    --gourmet-border:#ecd9bf;
    --gourmet-success:#16a34a;
    --gourmet-danger:#dc2626;
    --gourmet-shadow:0 18px 44px rgba(79,43,8,.10);
}

body{
    color:var(--gourmet-text);
    background:#fffaf4;
}

.order-wrap{
    max-width:1240px;
    margin:0 auto;
    padding:2rem 1rem 4rem;
}

.order-header{
    background:linear-gradient(135deg,#fff6e8 0%, #fffdf8 100%);
    border:1px solid var(--gourmet-border);
    border-radius:28px;
    padding:2rem 1.5rem;
    box-shadow:var(--gourmet-shadow);
    margin-bottom:1.5rem;
}

.order-title{
    font-family:'Poppins', sans-serif;
    font-weight:900;
    font-size:clamp(2rem,4vw,3rem);
    line-height:1.05;
    color:var(--gourmet-dark);
    margin-bottom:.75rem;
}

.order-subtitle{
    color:var(--gourmet-muted);
    line-height:1.8;
    max-width:820px;
    margin:0;
}

.order-shell{
    display:grid;
    grid-template-columns:1fr .95fr;
    gap:1.2rem;
}

.order-card{
    background:#fff;
    border:1px solid #efdec5;
    border-radius:26px;
    box-shadow:var(--gourmet-shadow);
    overflow:hidden;
}

.order-card-body{
    padding:1.5rem;
}

.order-section-title{
    font-size:1.35rem;
    font-weight:900;
    color:var(--gourmet-dark);
    margin-bottom:1rem;
}

.status-badge{
    display:inline-flex;
    align-items:center;
    gap:.5rem;
    border-radius:999px;
    padding:.6rem 1rem;
    font-size:.92rem;
    font-weight:900;
}

.status-paid{
    background:#ecfdf3;
    color:#166534;
    border:1px solid #bbf7d0;
}

.status-pending{
    background:#fff7ed;
    color:#9a3412;
    border:1px solid #fed7aa;
}

.status-failed{
    background:#fff1f2;
    color:#be123c;
    border:1px solid #fecdd3;
}

.status-refunded{
    background:#f5f3ff;
    color:#6d28d9;
    border:1px solid #ddd6fe;
}

.info-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:1rem;
}

.info-box{
    border:1px solid #efdec7;
    border-radius:18px;
    padding:1rem;
    background:#fffdf9;
}

.info-label{
    font-size:.85rem;
    color:var(--gourmet-muted);
    margin-bottom:.25rem;
}

.info-value{
    font-weight:900;
    color:var(--gourmet-dark);
    word-break:break-word;
}

.order-items{
    display:flex;
    flex-direction:column;
    gap:1rem;
}

.order-item{
    display:grid;
    grid-template-columns:80px 1fr auto;
    gap:1rem;
    align-items:center;
    border:1px solid #efdec7;
    border-radius:18px;
    padding:1rem;
    background:#fffdf9;
}

.order-item-image{
    width:80px;
    height:80px;
    object-fit:cover;
    border-radius:14px;
    background:#f6f6f6;
}

.order-item-title{
    font-weight:900;
    color:var(--gourmet-dark);
    margin-bottom:.2rem;
}

.order-item-meta{
    color:var(--gourmet-muted);
    font-size:.94rem;
    line-height:1.6;
}

.order-item-total{
    font-weight:900;
    color:var(--gourmet-primary-dark);
}

.summary-box{
    background:linear-gradient(135deg,#fff5e6, #fffdf9);
    border:1px solid #efd4a9;
    border-radius:22px;
    padding:1rem;
    margin-bottom:1rem;
}

.summary-row{
    display:flex;
    justify-content:space-between;
    gap:1rem;
    padding:.5rem 0;
    color:#4f463d;
}

.summary-row.total{
    border-top:1px dashed #ebd6b2;
    margin-top:.35rem;
    padding-top:.95rem;
    font-weight:900;
    color:var(--gourmet-dark);
    font-size:1.05rem;
}

.notice-box{
    border-radius:20px;
    padding:1rem 1.1rem;
    margin-bottom:1rem;
    line-height:1.7;
}

.notice-success{
    background:#ecfdf3;
    border:1px solid #bbf7d0;
    color:#166534;
}

.notice-soft{
    background:#fff8e7;
    border:1px solid #f6ddb1;
    color:#7c4a03;
}

.btn-main{
    background:linear-gradient(135deg,var(--gourmet-primary),var(--gourmet-accent));
    color:#23160a !important;
    padding:1rem 1.75rem;
    font-size:1rem;
    border-radius:999px;
    text-decoration:none;
    font-weight:900;
    display:inline-flex;
    gap:.55rem;
    align-items:center;
    justify-content:center;
    border:none;
    box-shadow:0 12px 28px rgba(245,158,11,.28);
    transition:all .22s ease;
}

.btn-light{
    padding:.95rem 1.4rem;
    font-size:1rem;
    border-radius:999px;
    font-weight:800;
    border:1.2px solid #f1d1a3;
    color:var(--gourmet-dark) !important;
    background:#fff;
    text-decoration:none;
    display:inline-flex;
    align-items:center;
    gap:.45rem;
    justify-content:center;
}

.cta-stack{
    display:flex;
    flex-wrap:wrap;
    gap:.75rem;
}

@media (max-width: 991px){
    .order-shell{
        grid-template-columns:1fr;
    }
}

@media (max-width: 768px){
    .info-grid{
        grid-template-columns:1fr;
    }

    .order-item{
        grid-template-columns:1fr;
    }

    .cta-stack{
        flex-direction:column;
    }

    .btn-main,
    .btn-light{
        width:100%;
        justify-content:center;
    }
}
</style>
{% endblock %}

{% block body %}
<main class="order-wrap">
    <section class="order-header">
        <h1 class="order-title">Your order is confirmed</h1>
        <p class="order-subtitle">
            Thank you for your order. Below you can review your meal plan, payment status, and any subscription details associated with this purchase.
        </p>
    </section>

    <section class="order-shell">
        <div class="order-card">
            <div class="order-card-body">
                <h2 class="order-section-title">Order details</h2>

                {% if order.payment_status == 'PAID' %}
                    <div class="notice-box notice-success">
                        <strong>Payment completed successfully.</strong> Your order has been recorded and is now part of your gourmet order history.
                    </div>
                {% endif %}

                <div class="info-grid mb-4">
                    <div class="info-box">
                        <div class="info-label">Order ID</div>
                        <div class="info-value">#{{ order.id }}</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Payment status</div>
                        <div class="info-value">
                            {% if order.payment_status == 'PAID' %}
                                <span class="status-badge status-paid"><i class="fa-solid fa-circle-check"></i> PAID</span>
                            {% elseif order.payment_status == 'FAILED' %}
                                <span class="status-badge status-failed"><i class="fa-solid fa-circle-xmark"></i> FAILED</span>
                            {% elseif order.payment_status == 'REFUNDED' %}
                                <span class="status-badge status-refunded"><i class="fa-solid fa-rotate-left"></i> REFUNDED</span>
                            {% else %}
                                <span class="status-badge status-pending"><i class="fa-solid fa-clock"></i> PENDING</span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Customer name</div>
                        <div class="info-value">{{ order.guest_name ?: '—' }}</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Email</div>
                        <div class="info-value">{{ order.guest_email ?: '—' }}</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Phone</div>
                        <div class="info-value">{{ order.guest_phone ?: '—' }}</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">City / area</div>
                        <div class="info-value">{{ order.city ?: '—' }}</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Meal audience</div>
                        <div class="info-value">{{ order.audience_type ?: '—' }}</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Meal style</div>
                        <div class="info-value">{{ order.meal_style ?: '—' }}</div>
                    </div>
                </div>

                <h2 class="order-section-title">Items purchased</h2>

                <div class="order-items">
                    {% for item in order.items %}
                        <div class="order-item">
                            {% if item.main_image %}
                                <img src="{{ item.main_image }}" alt="{{ item.product_name_snapshot }}" class="order-item-image">
                            {% else %}
                                <div class="order-item-image d-flex align-items-center justify-content-center text-muted">No image</div>
                            {% endif %}

                            <div>
                                <div class="order-item-title">{{ item.product_name_snapshot }}</div>
                                <div class="order-item-meta">
                                    {{ item.quantity }} meal(s) × ${{ item.unit_price|number_format(2, '.', ',') }}
                                </div>
                            </div>

                            <div class="order-item-total">
                                ${{ item.line_total|number_format(2, '.', ',') }}
                            </div>
                        </div>
                    {% else %}
                        <div class="notice-box notice-soft">
                            No order items found.
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="order-card">
            <div class="order-card-body">
                <h2 class="order-section-title">Summary</h2>

                <div class="summary-box">
                    <div class="summary-row">
                        <span>Meals selected</span>
                        <strong>{{ order.meals_count }}</strong>
                    </div>
                    <div class="summary-row">
                        <span>Pricing mode</span>
                        <strong>{{ order.pricing_mode }}</strong>
                    </div>
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <strong>${{ order.subtotal|number_format(2, '.', ',') }}</strong>
                    </div>
                    <div class="summary-row">
                        <span>Discount</span>
                        <strong>${{ order.discount|number_format(2, '.', ',') }}</strong>
                    </div>
                    <div class="summary-row total">
                        <span>Total</span>
                        <strong>${{ order.total|number_format(2, '.', ',') }}</strong>
                    </div>
                </div>

                {% if subscription %}
                    <div class="notice-box notice-success">
                        <strong>Weekly subscription active.</strong><br>
                        Your subscription was created from this order and is currently scheduled as <strong>{{ subscription.frequency }}</strong>.
                        {% if subscription.next_charge_date %}
                            Next charge date: <strong>{{ subscription.next_charge_date }}</strong>.
                        {% endif %}
                    </div>
                {% endif %}

                {% if existingUser %}
                    <div class="notice-box notice-success">
                        <strong>Your account is ready.</strong><br>
                        This order is already linked to your account <strong>{{ order.guest_email }}</strong>.
                        You can log in anytime to manage your meals, subscriptions and future orders.
                    </div>

                    <div class="cta-stack">
                        <a href="{{ path('login') }}" class="btn-main">
                            <i class="fa-solid fa-right-to-bracket"></i> Log in
                        </a>
                    </div>
                {% else %}
                    <div class="notice-box notice-soft">
                        <strong>No account detected yet.</strong><br>
                        You can create an account using <strong>{{ order.guest_email }}</strong> to manage your orders and subscriptions.
                    </div>

                    <div class="cta-stack">
                        <a href="{{ path('signup') }}" class="btn-main">
                            <i class="fa-solid fa-user-plus"></i> Create account
                        </a>
                    </div>
                {% endif %}

                <div class="cta-stack mt-3">
                    <a href="{{ path('/meal-plans') }}" class="btn-light">
                        <i class="fa-solid fa-bowl-food"></i> Order more meals
                    </a>
                    <a href="{{ path('planner-hub') }}" class="btn-light">
                        <i class="fa-solid fa-house"></i> Back to home
                    </a>
                </div>
            </div>
        </div>
    </section>
</main>
{% endblock %}