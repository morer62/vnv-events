{% extends 'templates/base.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block head %}
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-Avb2QiuDEEvB4bZJYdft2mNjVShBftLdPG8FJ0V7irTLQ8Uo0qcPxh4Plq6cZ9Yp9R3SZkqCJzFYnRg4P9L4A==" crossorigin="anonymous" referrerpolicy="no-referrer"/>
{% endblock %}

{% block body %}
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>

	{# ============================================================
	   NUEVO: Categories (Collapsible + Multiselect) — OPCIONAL
	   Se muestra sólo si existe "categories"
	   ============================================================ #}
	{% if categories is defined and categories %}
	<section id="vnv-catFilter" class="vnv-ac-section is-collapsed" data-key="vnv_cat_ac_open">
		<header class="vnv-ac-header" role="button" tabindex="0" aria-controls="vnv-catBody" aria-expanded="false">
			<div class="vnv-ac-title">
				<strong>Categories</strong>
				<span class="vnv-ac-count" id="vnv-catCount">0 selected</span>
			</div>
			<div class="vnv-ac-summary" id="vnv-catSummary"></div>
			<i class="fa-solid fa-chevron-down vnv-ac-chevron"></i>
		</header>

		<div id="vnv-catBody" class="vnv-ac-body">
			<div class="vnv-ac-actions">
				<input id="vnv-catSearch" class="vnv-ac-input" type="text" placeholder="Filter categories..." autocomplete="off">
				<div class="vnv-ac-links">
					<button type="button" class="vnv-ac-link" id="vnv-catSelectAll">Select all</button>
					<span class="vnv-ac-sep">•</span>
					<button type="button" class="vnv-ac-link" id="vnv-catClear">Clear</button>
				</div>
			</div>

			<div id="vnv-catGrid" class="vnv-ac-grid" role="group" aria-label="Categories">
				{% for c in categories %}
					{# Hidden input para enviar multiselect #}
					<input type="checkbox"
						   name="categories[]"
						   value="{{ c.id }}"
						   id="vnv-cat-{{ c.id }}"
						   class="vnv-ac-hidden"
						   {% if selected_categories is defined and c.id in selected_categories %}checked{% endif %}>

					<button type="button"
							class="vnv-ac-pill {% if selected_categories is defined and c.id in selected_categories %}is-selected{% endif %}"
							data-id="{{ c.id }}"
							data-label="{{ c.name }}"
							aria-pressed="{% if selected_categories is defined and c.id in selected_categories %}true{% else %}false{% endif %}">
						<span class="vnv-ac-label">{{ c.name }}</span>
						<i class="fa-solid fa-check vnv-ac-check"></i>
					</button>
				{% endfor %}
			</div>
		</div>
	</section>
	{% endif %}
	{# ========== FIN BLOQUE NUEVO (no altera el resto de tu página) ========== #}

	<div class="vnv-promo-banner">
		<div class="vnv-promo-content">
			<p class="vnv-promo-text">Want them for your <strong>{{ venue.category_name }}</strong>?</p>
			<div class="vnv-promo-actions">
				<a class="vnv-promo-button" href="{{ base_url }}/search/client_request/index?profile_cat=venue&id={{ venue.id }}">Get a quote</a>
				<p class="vnv-promo-offer">Book this venue today and save your date.
				 
				</p>
			</div>
		</div>
	</div> 
	<div class="vnv-detail-wrapper">
		<h2>{{ services.name }}</h2>
		<div class="vnv-detail-header">
			<div class="vnv-detail-map">
				{% if venue.lat and venue.lng %}
					<iframe src="https://www.google.com/maps?q={{ venue.lat }},{{ venue.lng }}&output=embed" width="100%" height="300" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
				{% else %}
					<div class="map-placeholder">
						<i class="fa-solid fa-map-location-dot"></i>
						<p>Map not available</p>
					</div>
				{% endif %}
			</div>
			<div class="vnv-detail-info">
				<ul class="vnv-detail-list">
					<li>
						<i class="fa-solid fa-location-dot"></i>
						<span>Address</span>
						<strong>{{ venue.address }}</strong>
					</li>

					{% if services.indoor_outdoor_type %}
						<li>
							<i class="fa-solid fa-warehouse"></i>
							<span>Space Type</span>
							<strong>{{ venue.indoor_outdoor_type|title }}</strong>
						</li>
					{% endif %}

					{% if venue.category_name %}
						<li>
							<i class="fa-solid fa-tags"></i>
							<span>Category</span>
							<strong>
								{{ venue.category_name }}
								{% if venue.extra_categories and (venue.extra_categories|length) > 0 %}
									<span class="text-muted"> • </span>
									{{ venue.extra_categories|join(', ') }}
								{% endif %}
							</strong>
						</li>
					{% endif %}

					{% if venue.phone_number %}
						<li>
							<i class="fa-solid fa-phone"></i>
							<span>Phone</span>
							<strong>{{ venue.phone_number }}</strong>
						</li>
					{% endif %}

					{% if venue.email %}
						<li>
							<i class="fa-solid fa-envelope"></i>
							<span>Email</span>
							<strong>
								<a href="mailto:{{ venue.email }}">{{ venue.email }}</a>
							</strong>
						</li>
					{% endif %}

					{% if venue.website and venue.website != '' %}
						<li>
							<i class="fa-solid fa-globe"></i>
							<span>Website</span>
							<strong>
								<a href="{{ venue.website }}" target="_blank">{{ venue.website }}</a>
							</strong>
						</li>
					{% endif %}

					{% if venue.capacity and venue.capacity > 0 %}
						<li>
							<i class="fa-solid fa-users"></i>
							<span>Capacity</span>
							<strong>
								{{ venue.capacity }}
								guests
							</strong>
						</li>
					{% endif %}

					{% if venue.base_price %}
						<li>
							<i class="fa-solid fa-dollar-sign"></i>
							<span>Base Price</span>
							<strong>${{ venue.base_price }}</strong>
						</li>
					{% endif %}

					{% set social_links = [] %}
					{% if venue.instagram and venue.instagram != '' and venue.instagram != 'Not_available' %}
						{% set social_links = social_links|merge([{ url: venue.instagram, icon: 'fab fa-instagram' }]) %}
					{% endif %}
					{% if venue.facebook and venue.facebook != '' and venue.facebook != 'Not_available' %}
						{% set social_links = social_links|merge([{ url: venue.facebook, icon: 'fab fa-facebook-f' }]) %}
					{% endif %}
					{% if venue.twitter and venue.twitter != '' and venue.twitter != 'Not_available' %}
						{% set social_links = social_links|merge([{ url: venue.twitter, icon: 'fab fa-twitter' }]) %}
					{% endif %}
					{% if venue.yelp and venue.yelp != '' and venue.yelp != 'Not_available' %}
						{% set social_links = social_links|merge([{ url: venue.yelp, icon: 'fab fa-yelp' }]) %}
					{% endif %}

					{% if (social_links|length) > 0 %}
						<li>
							<i class="fa-solid fa-share-nodes"></i>
							<span>Social</span>
							<strong>
								{% for social in social_links %}
									<a href="{{ social.url }}" target="_blank" style="margin-left:10px;">
										<i class="{{ social.icon }}"></i>
									</a>
								{% endfor %}
							</strong>
						</li>
					{% endif %}
				</ul>
			</div>
		</div>

		<!-- Gallery -->
		{% if venue.photos and (venue.photos|length) > 0 %}
			<div class="vnv-detail-gallery">
				{% for photo in venue.photos|slice(0, 5) %}
					<img src="{{ photo }}" class="vnv-thumb" onclick="vnvOpenPopup('{{ photo }}')"/>
				{% endfor %}
			</div>
		{% endif %}

		<!-- Description -->
		{% if venue.description %}
			<div class="vnv-detail-description">{{ venue.description|raw }}</div>
		{% endif %}

		<!-- Weekly Availability -->
		{% set day_names = { sun: 'Sunday', mon: 'Monday', tue: 'Tuesday', wed: 'Wednesday', thu: 'Thursday', fri: 'Friday', sat: 'Saturday' } %}

		<h3>🗓️ Weekly Availability</h3>
		{% if venue.availability %}
			<table class="vnv-table">
				<thead>
					<tr>
						<th>Day</th>
						<th>Status</th>
						<th>From</th>
						<th>To</th>
					</tr>
				</thead>
				<tbody>
					{% for day, info in venue.availability %}
						<tr>
							<td>{{ day_names[day] ? : day|title }}</td>
							<td>
								{% if info.is_closed %}
									❌ Closed
								{% else %}
									✅ Open
								{% endif %}
							</td>
							<td>
								{% if info.is_closed %}
									-
								{% elseif info.opens %}
									{{ info.opens|date('g:i A') }}
								{% else %}
									-
								{% endif %}
							</td>
							<td>
								{% if info.is_closed %}
									-
								{% elseif info.closes %}
									{{ info.closes|date('g:i A') }}
								{% else %}
									-
								{% endif %}
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		{% else %}
			<p>No availability data.</p>
		{% endif %}

		<!-- Events -->
		<h3>📅 Events</h3>
		{% if venue.events and (venue.events|length) > 0 %}
			<table class="vnv-table">
				<thead>
					<tr>
						<th>Name</th>
						<th>Description</th>
						<th>Date</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for event in venue.events %}
						<tr>
							<td>
								<strong>{{ event.name }}</strong>
							</td>
							<td>{{ event.description }}</td>
							<td>
								{% if event.start_date %}
									{{ event.start_date|date('M j, Y g:i A') }}
								{% else %}
									-
								{% endif %}
							</td>
                            <td>
                                {% if event.ticket_sales_enabled %}
                                    <button type="button" class="btn btn-primary btn-sm buy-tickets-btn" 
                                            data-event-id="{{ event.id }}" 
                                            data-event-name="{{ event.name|e('html_attr') }}" 
                                            data-event-date="{{ event.start_date|date('Y-m-d H:i:s') }}">
                                        <i class="fa-solid fa-ticket"></i> Buy Tickets
                                    </button>
                                {% elseif event.external_link %}
                                    <a href="{{ event.external_link }}" target="_blank" class="btn btn-outline-primary btn-sm">
                                        <i class="fa-solid fa-external-link"></i> View Event
                                    </a>
                                {% else %}
                                    <span class="text-muted">Tickets not available</span>
								{% endif %}
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		{% else %}
			<p>No events available.</p>
		{% endif %}

		<!-- Promotions -->
		<h3>🎁 Promotions</h3>
		{% if venue.promos and (venue.promos|length) > 0 %}
			<table class="vnv-table">
				<thead>
					<tr>
						<th>Name</th>
						<th>Description</th>
					</tr>
				</thead>
				<tbody>
					{% for promo in venue.promos %}
						<tr>
							<td>
								{{ promo.name }}
								{% if promo.start_date %}
									<hr/>{{ promo.start_date }}
								{% endif %}
							</td>
							<td>{{ promo.description }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		{% else %}
			<p>No promotions available.</p>
		{% endif %}

		{% set icon_map = { 'All-inclusive: Full food, beverage, rentals': 'fa-utensils', 'Raw space: Only the space': 'fa-box', 'Select services: Some basic add-ons': 'fa-puzzle-piece', 'Bar services': 'fa-martini-glass', 'Dance floor': 'fa-music', 'Event rentals': 'fa-chair', 'Lighting/sound': 'fa-lightbulb', 'Service staff': 'fa-user-tie', 'Wedding cake services': 'fa-cake-candles', 'Catering services': 'fa-bowl-food', 'Dressing room / bridal suite': 'fa-person-dress', 'Event staff': 'fa-user', 'On-site accommodations': 'fa-bed', 'Set up': 'fa-screwdriver-wrench', 'Wheelchair accessible': 'fa-wheelchair', 'Clean up': 'fa-soap', 'Event coordinator': 'fa-clipboard-list', 'Liability insurance': 'fa-file-shield', 'Pet friendly': 'fa-dog', Transportation: 'fa-bus', Wifi: 'fa-wifi' } %}

		<!-- Services -->
		{% if venue.services and (venue.services|length) > 0 %}
			<h3>🛎️ Services</h3>
			<ul class="vnv-icon-list">
				{% for service in venue.services %}
					<li>
						<i class="fa-solid {{ icon_map[service] ? : 'fa-check' }}"></i>
						{{ service }}
					</li>
				{% endfor %}
			</ul>
		{% endif %}

		<!-- Amenities -->
		{% if venue.amenities and (venue.amenities|length) > 0 %}
			<h3>🎯 Amenities</h3>
			<ul class="vnv-icon-list">
				{% for amenity in venue.amenities %}
					<li>
						<i class="fa-solid {{ icon_map[amenity] ? : 'fa-check' }}"></i>
						{{ amenity }}
					</li>
				{% endfor %}
			</ul>
		{% endif %}

		<!-- Fullscreen image popup -->
		<div id="vnv-popup" onclick="this.style.display='none'">
			<img id="vnv-popup-img"/>
		</div>

		<!-- Ticket Purchase Modal -->
		<div class="modal fade" id="ticketModal" tabindex="-1" aria-labelledby="ticketModalLabel" aria-hidden="true">
			<div class="modal-dialog modal-xl">
				<div class="modal-content border-0 shadow-lg">
					<div class="modal-header bg-primary text-white border-0">
						<div class="d-flex align-items-center">
							<i class="fa-solid fa-ticket-alt me-2 fs-4"></i>
							<h4 class="modal-title mb-0" id="ticketModalLabel">Buy Tickets</h4>
					</div>
						<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="modal-body p-4">
						<!-- Event Info -->
						<div class="card border-0 shadow-sm mb-4">
							<div class="card-body bg-gradient bg-light">
								<div class="row align-items-center">
									<div class="col-12">
										<h5 class="card-title mb-1 text-primary" id="modalEventName">Event Name</h5>
										<p class="card-text text-muted mb-0" id="modalEventDate">
											<i class="fa-solid fa-calendar-alt me-1"></i>Event Date
										</p>
									</div>
								</div>
							</div>
						</div>

						<!-- Authentication Section -->
						<div id="authSection">
							<!-- Login Form -->
							<div id="loginForm" style="display: none;">
								<div class="card border-0 shadow-sm">
									<div class="card-header bg-white border-0 pb-0">
										<h5 class="card-title text-center mb-0">
											<i class="fa-solid fa-sign-in-alt me-2 text-primary"></i>Welcome Back
										</h5>
										<p class="text-muted text-center mt-2">Sign in to continue with your purchase</p>
									</div>
									<div class="card-body">
								<form id="modalLoginForm">
									<div class="mb-3">
												<label class="form-label fw-semibold">
													<i class="fa-solid fa-envelope me-1"></i>Email Address
												</label>
												<input type="email" class="form-control form-control-lg" name="email" 
													   placeholder="Enter your email" required>
									</div>
											<div class="mb-4">
												<label class="form-label fw-semibold">
													<i class="fa-solid fa-lock me-1"></i>Password
												</label>
												<input type="password" class="form-control form-control-lg" name="password" 
													   placeholder="Enter your password" required>
									</div>
											<button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
												<i class="fa-solid fa-sign-in-alt me-2"></i>Sign In
											</button>
								</form>
										<div class="text-center">
											<p class="text-muted mb-0">Don't have an account?</p>
											<button type="button" class="btn btn-link text-decoration-none" onclick="showSignupForm()">
												<i class="fa-solid fa-user-plus me-1"></i>Create Account
											</button>
										</div>
									</div>
								</div>
							</div>

							<!-- Signup Form -->
							<div id="signupForm" style="display: none;">
								<div class="card border-0 shadow-sm">
									<div class="card-header bg-white border-0 pb-0">
										<h5 class="card-title text-center mb-0">
											<i class="fa-solid fa-user-plus me-2 text-success"></i>Create Account
										</h5>
										<p class="text-muted text-center mt-2">Join us to purchase your tickets</p>
									</div>
									<div class="card-body">
								<form id="modalSignupForm">
									<div class="row">
										<div class="col-md-6 mb-3">
													<label class="form-label fw-semibold">
														<i class="fa-solid fa-user me-1"></i>First Name
													</label>
													<input type="text" class="form-control form-control-lg" name="name" 
														   placeholder="Your first name" required>
										</div>
										<div class="col-md-6 mb-3">
													<label class="form-label fw-semibold">
														<i class="fa-solid fa-user me-1"></i>Last Name
													</label>
													<input type="text" class="form-control form-control-lg" name="lastname" 
														   placeholder="Your last name" required>
										</div>
									</div>
									<div class="mb-3">
												<label class="form-label fw-semibold">
													<i class="fa-solid fa-envelope me-1"></i>Email Address
												</label>
												<input type="email" class="form-control form-control-lg" name="email" 
													   placeholder="your.email@example.com" required>
									</div>
									<div class="mb-3">
												<label class="form-label fw-semibold">
													<i class="fa-solid fa-phone me-1"></i>Phone Number
												</label>
												<input type="tel" class="form-control form-control-lg" name="phoneNumber" 
													   placeholder="+1 (555) 123-4567">
									</div>
									<div class="row">
										<div class="col-md-6 mb-3">
													<label class="form-label fw-semibold">
														<i class="fa-solid fa-lock me-1"></i>Password
													</label>
													<input type="password" class="form-control form-control-lg" name="password" 
														   placeholder="Create a password" required>
										</div>
										<div class="col-md-6 mb-3">
													<label class="form-label fw-semibold">
														<i class="fa-solid fa-lock me-1"></i>Confirm Password
													</label>
													<input type="password" class="form-control form-control-lg" name="passwordConfirmation" 
														   placeholder="Confirm your password" required>
										</div>
									</div>
											<button type="submit" class="btn btn-success btn-lg w-100 mb-3">
												<i class="fa-solid fa-user-plus me-2"></i>Create Account & Continue
											</button>
								</form>
										<div class="text-center">
											<p class="text-muted mb-0">Already have an account?</p>
											<button type="button" class="btn btn-link text-decoration-none" onclick="showLoginForm()">
												<i class="fa-solid fa-sign-in-alt me-1"></i>Sign In
											</button>
										</div>
									</div>
								</div>
							</div>
						</div>

						<!-- Ticket Purchase Section -->
						<div id="ticketPurchaseSection" style="display: none;">
							<div class="row">
								<div class="col-lg-8">
									<div class="card border-0 shadow-sm mb-4">
										<div class="card-header bg-white border-0">
											<h5 class="card-title mb-0">
												<i class="fa-solid fa-ticket-alt me-2 text-primary"></i>Select Your Tickets
											</h5>
										</div>
										<div class="card-body">
							<div id="ticketTypesContainer">
								<!-- Dynamic content will be loaded here -->
											</div>
										</div>
									</div>
							</div>
							
								<div class="col-lg-4">
							<!-- Buyer Information -->
							<div id="buyerInfoSection" style="display: none;">
										<div class="card border-0 shadow-sm mb-4">
											<div class="card-header bg-white border-0">
												<h6 class="card-title mb-0">
													<i class="fa-solid fa-user me-2 text-info"></i>Buyer Information
												</h6>
											</div>
											<div class="card-body">
												<div class="mb-3">
													<label class="form-label fw-semibold">Full Name</label>
										<input type="text" class="form-control" id="buyerName" readonly>
									</div>
												<div class="mb-3">
													<label class="form-label fw-semibold">Email</label>
										<input type="email" class="form-control" id="buyerEmail" readonly>
									</div>
												<div class="mb-3">
													<label class="form-label fw-semibold">Phone</label>
										<input type="tel" class="form-control" id="buyerPhone" placeholder="Optional">
												</div>
									</div>
								</div>

								<!-- Payment Section -->
										<div class="card border-0 shadow-sm mb-4">
											<div class="card-header bg-white border-0">
												<h6 class="card-title mb-0">
													<i class="fa-solid fa-credit-card me-2 text-warning"></i>Payment Information
												</h6>
											</div>
											<div class="card-body">
												<div id="card-element" class="form-control p-3 border-2"></div>
												<div id="card-errors" class="text-danger mt-2 small"></div>
											</div>
								</div>

								<!-- Order Summary -->
										<div class="card border-0 shadow-sm">
											<div class="card-header bg-success text-white border-0">
												<h6 class="card-title mb-0">
													<i class="fa-solid fa-receipt me-2"></i>Order Summary
												</h6>
											</div>
									<div class="card-body">
										<div id="orderSummary">
													<p class="text-muted text-center">Select tickets to see order summary</p>
										</div>
										<hr>
												<div class="d-flex justify-content-between align-items-center">
													<span class="fw-bold fs-5">Total:</span>
													<span class="fw-bold fs-4 text-success" id="totalAmount">$0.00</span>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
						</div>
					</div>
					<div class="modal-footer bg-light border-0">
						<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
							<i class="fa-solid fa-times me-1"></i>Close
						</button>
