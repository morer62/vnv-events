	<!-- Hidden data elements -->
	<div id="auth-data" style="display: none;" 
		 data-authenticated="{{ is_authenticated ? 'true' : 'false' }}" 
		 data-user="{{ user|json_encode|e('html_attr') }}">
	</div>

	<script>
		function vnvOpenPopup(url) {
			const popup = document.getElementById('vnv-popup')
			const img = document.getElementById('vnv-popup-img')
			img.src = url
			popup.style.display = 'flex'
		}

		// Ticket Modal Variables
		let currentEventId = null;
		let currentEventName = '';
		let currentEventDate = '';
		let selectedTickets = {};
		let stripe = null;
		let elements = null;
		let card = null;

		// Initialize Stripe when modal opens
		function initializeStripe() {
			if (typeof Stripe !== 'undefined' && !stripe) {
				try {
				stripe = Stripe('{{ _ENV.STRIPE_PUBLIC }}');
				elements = stripe.elements();
				card = elements.create('card');
				card.mount('#card-element');
				} catch (error) {
					// Stripe initialization failed
			}
			}
		}

		// Open Ticket Modal
		function openTicketModal(eventId, eventName, eventDate) {
			currentEventId = eventId;
			currentEventName = eventName;
			currentEventDate = eventDate;

			// Update modal content
			document.getElementById('modalEventName').textContent = eventName;
			document.getElementById('modalEventDate').textContent = new Date(eventDate).toLocaleDateString();

			// Check if user is authenticated using server-side data
			const authData = document.getElementById('auth-data');
			const isAuthenticated = authData.dataset.authenticated === 'true';
			const userData = JSON.parse(authData.dataset.user || 'null');
			
			if (isAuthenticated) {
						// User is authenticated, go directly to ticket purchase
				showTicketPurchaseSection(userData);
						loadTicketTypes();
				// Initialize Stripe when showing purchase section
				setTimeout(initializeStripe, 500);
					} else {
				// User not authenticated, show signup form
						showSignupForm();
					}

			// Show modal
			const modal = new bootstrap.Modal(document.getElementById('ticketModal'));
			modal.show();
		}

		// Show Login Form
		function showLoginForm() {
			document.getElementById('loginForm').style.display = 'block';
			document.getElementById('signupForm').style.display = 'none';
			document.getElementById('ticketPurchaseSection').style.display = 'none';
			document.getElementById('authSection').style.display = 'block';
		}

		// Show Signup Form
		function showSignupForm() {
			document.getElementById('loginForm').style.display = 'none';
			document.getElementById('signupForm').style.display = 'block';
			document.getElementById('ticketPurchaseSection').style.display = 'none';
			document.getElementById('authSection').style.display = 'block';
		}

		// Show Ticket Purchase Section
		function showTicketPurchaseSection(userData = null) {
			document.getElementById('authSection').style.display = 'none';
			document.getElementById('ticketPurchaseSection').style.display = 'block';
			
			// If user data is provided, fill in the buyer information
			if (userData) {
				document.getElementById('buyerName').value = userData.name + ' ' + userData.lastname;
				document.getElementById('buyerEmail').value = userData.email;
				document.getElementById('buyerPhone').value = userData.phone || '';
			}
		}

		// Load Ticket Types
		function loadTicketTypes() {
			fetch(`{{ base_url }}/api/tickets/info?event_id=${currentEventId}`)
				.then(response => response.json())
				.then(data => {
					if (data.success) {
						if (data.event_ended) {
							alert('This event has already ended. Ticket sales are no longer available.');
							return;
						}
						renderTicketTypes(data.tickets, data.current_stage, data.event);
					} else {
						alert('Error loading ticket types: ' + data.message);
					}
				})
				.catch(error => {
					console.error('Error loading ticket types:', error);
					alert('Error loading ticket types');
				});
		}

		// Load ticket availability
		function loadTicketAvailability() {
			if (!currentEventId) {
				console.log('No currentEventId set');
				return;
			}
			
			console.log('Loading availability for event:', currentEventId);
			
			fetch(`{{ base_url }}/api/tickets/availability?event_id=${currentEventId}`)
				.then(response => {
					console.log('Availability response status:', response.status);
					return response.json();
				})
				.then(data => {
					console.log('Availability data:', data);
					if (data.success) {
						updateTicketAvailability(data.data);
					} else {
						console.error('Error loading availability:', data.message);
					}
				})
				.catch(error => {
					console.error('Error loading ticket availability:', error);
				});
		}

		// Update ticket availability display
		function updateTicketAvailability(availability) {
			console.log('Updating availability for:', availability);
			
			Object.keys(availability).forEach(ticketTypeId => {
				const ticketInfo = availability[ticketTypeId];
				const ticketElement = document.querySelector(`[data-ticket-id="${ticketTypeId}"]`);
				
				console.log(`Looking for ticket element with ID ${ticketTypeId}:`, ticketElement);
				
				if (ticketElement) {
					const availabilityElement = ticketElement.querySelector('.ticket-availability');
					if (availabilityElement) {
						const iconElement = availabilityElement.querySelector('i');
						const textElement = availabilityElement.querySelector('span');
						
						if (ticketInfo.available > 0) {
							iconElement.className = 'fa-solid fa-circle-check text-success me-2';
							textElement.textContent = `${ticketInfo.available} available`;
							textElement.className = 'text-success fw-semibold';
						} else {
							iconElement.className = 'fa-solid fa-circle-xmark text-danger me-2';
							textElement.textContent = 'Sold out';
							textElement.className = 'text-danger fw-semibold';
						}
						console.log(`Updated availability for ${ticketTypeId}: ${ticketInfo.available} available`);
					}
					
					const quantityInput = ticketElement.querySelector('.ticket-quantity');
					if (quantityInput) {
						quantityInput.max = ticketInfo.available;
						if (ticketInfo.available === 0) {
							quantityInput.disabled = true;
							quantityInput.value = 0;
							quantityInput.classList.add('bg-light');
						} else {
							quantityInput.disabled = false;
							quantityInput.classList.remove('bg-light');
						}
					}
				} else {
					console.warn(`Ticket element not found for ID ${ticketTypeId}`);
				}
				});
		}

		// Render Ticket Types
		function renderTicketTypes(tickets, currentStage, event) {
			const container = document.getElementById('ticketTypesContainer');
			let html = '';

			// Show current stage info if available
			if (currentStage) {
				html += `
					<div class="alert alert-info mb-4">
						<div class="d-flex align-items-center">
							<i class="fa-solid fa-tag me-2"></i>
											<div>
								<strong>Current Stage: ${currentStage.name}</strong>
								${currentStage.discount_percentage > 0 ? `<span class="badge bg-success ms-2">${currentStage.discount_percentage}% OFF</span>` : ''}
											</div>
									</div>
						<small class="text-muted">Valid until: ${new Date(currentStage.end_date).toLocaleDateString()}</small>
								</div>
				`;
			}

			tickets.forEach(ticket => {
				const originalPrice = parseFloat(ticket.original_price);
				const finalPrice = parseFloat(ticket.discounted_price);
				const hasDiscount = ticket.discount_percentage > 0;

				html += `
					<div class="card border-0 shadow-sm mb-3 ticket-card" data-ticket-id="${ticket.id}" data-price="${finalPrice}" data-name="${ticket.name}">
						<div class="card-body p-4">
							<div class="row align-items-center">
								<div class="col-md-8">
									<div class="d-flex align-items-start">
										<div class="ticket-icon me-3">
											<i class="fa-solid fa-ticket-alt text-primary fs-3"></i>
									</div>
										<div class="flex-grow-1">
											<h5 class="card-title mb-2 text-dark fw-bold">${ticket.name}</h5>
											<p class="card-text text-muted mb-3">${ticket.description || 'Standard admission ticket'}</p>
											
											<div class="price-section mb-3">
												${hasDiscount ? `
													<div class="d-flex align-items-center">
														<span class="text-muted text-decoration-line-through me-2">$${originalPrice.toFixed(2)}</span>
														<span class="h4 text-success fw-bold me-2">$${finalPrice.toFixed(2)}</span>
														<span class="badge bg-success">${ticket.discount_percentage}% OFF</span>
								</div>
												` : `
													<span class="h4 text-primary fw-bold">$${finalPrice.toFixed(2)}</span>
												`}
											</div>
											
											<div class="ticket-availability">
												<div class="d-flex align-items-center">
													<i class="fa-solid fa-circle-check text-muted me-2"></i>
													<span class="text-muted">Available: ${ticket.available_quantity} tickets</span>
												</div>
											</div>
										</div>
									</div>
								</div>
								<div class="col-md-4">
									<div class="quantity-section">
										<label class="form-label fw-semibold text-center d-block mb-3">Quantity</label>
										<div class="quantity-selector d-flex align-items-center justify-content-center">
											<button type="button" class="btn btn-outline-danger btn-sm rounded-circle" 
													onclick="decreaseQuantity(${ticket.id})" style="width: 40px; height: 40px;">
												<i class="fa-solid fa-minus"></i>
											</button>
											<input type="number" id="qty-${ticket.id}" 
												   class="form-control text-center mx-3 ticket-quantity border-2" 
												   value="0" min="0" max="${ticket.available_quantity}" style="width: 80px; font-weight: bold;" 
												   onchange="updateSelection()">
											<button type="button" class="btn btn-outline-success btn-sm rounded-circle" 
													onclick="increaseQuantity(${ticket.id})" style="width: 40px; height: 40px;">
												<i class="fa-solid fa-plus"></i>
											</button>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				`;
			});

			container.innerHTML = html;
		}

		// Quantity Management
		function increaseQuantity(ticketTypeId) {
			const input = document.getElementById(`qty-${ticketTypeId}`);
			const max = parseInt(input.getAttribute('max'));
			if (parseInt(input.value) < max) {
				input.value = parseInt(input.value) + 1;
				updateSelection();
			}
		}

		function decreaseQuantity(ticketTypeId) {
			const input = document.getElementById(`qty-${ticketTypeId}`);
			if (parseInt(input.value) > 0) {
				input.value = parseInt(input.value) - 1;
				updateSelection();
			}
		}

		function updateSelection() {
			selectedTickets = {};
			let hasSelection = false;

			document.querySelectorAll('input[type="number"]').forEach(input => {
				const ticketTypeId = parseInt(input.id.replace('qty-', ''));
				const quantity = parseInt(input.value);
				const ticketCard = input.closest('.ticket-card');

				if (quantity > 0) {
					selectedTickets[ticketTypeId] = quantity;
					hasSelection = true;
					ticketCard.classList.add('selected');
				} else {
					ticketCard.classList.remove('selected');
				}
			});

			if (hasSelection) {
				document.getElementById('buyerInfoSection').style.display = 'block';
				updateOrderSummary();
			} else {
				document.getElementById('buyerInfoSection').style.display = 'none';
			}
		}

		function updateOrderSummary() {
			const container = document.getElementById('orderSummary');
			let html = '';
			let totalAmount = 0;

			Object.keys(selectedTickets).forEach(ticketTypeId => {
				const quantity = selectedTickets[ticketTypeId];
				if (quantity > 0) {
					// Buscar el precio del ticket desde los datos cargados
					const ticketElement = document.querySelector(`[data-ticket-id="${ticketTypeId}"]`);
					if (ticketElement) {
						const price = parseFloat(ticketElement.dataset.price);
						const subtotal = price * quantity;
						totalAmount += subtotal;
						
						html += `
							<div class="d-flex justify-content-between align-items-center mb-3 p-2 bg-light rounded">
								<div class="d-flex align-items-center">
									<i class="fa-solid fa-ticket-alt text-primary me-2"></i>
									<span class="fw-semibold">${ticketElement.dataset.name}</span>
									<span class="text-muted ms-2">x ${quantity}</span>
								</div>
								<span class="fw-bold text-success">$${subtotal.toFixed(2)}</span>
							</div>
						`;
					}
				}
			});

			if (html) {
				container.innerHTML = html;
				document.getElementById('totalAmount').textContent = `$${totalAmount.toFixed(2)}`;
				document.getElementById('purchaseBtn').style.display = 'block';
			} else {
				container.innerHTML = '<div class="text-center py-3"><i class="fa-solid fa-shopping-cart text-muted fs-1 mb-2"></i><p class="text-muted mb-0">Select tickets to see order summary</p></div>';
				document.getElementById('totalAmount').textContent = '$0.00';
				document.getElementById('purchaseBtn').style.display = 'none';
			}
		}

		// Process Purchase
		function processPurchase() {
			if (Object.keys(selectedTickets).length === 0) {
				alert('Please select at least one ticket');
				return;
			}

			// Validate availability before processing
			let validationPassed = true;
			Object.keys(selectedTickets).forEach(ticketId => {
				const quantity = selectedTickets[ticketId];
				const card = document.querySelector(`[data-ticket-id="${ticketId}"]`);
				const availabilityElement = card.querySelector('.ticket-availability');
				const availableText = availabilityElement.textContent;
				const available = parseInt(availableText.match(/\d+/)?.[0] || 0);
				
				if (quantity > available) {
					alert(`Not enough tickets available for ${card.dataset.name}. Only ${available} tickets left.`);
					validationPassed = false;
					return;
				}
			});
			
			if (!validationPassed) {
				return;
			}

			// Obtener información del comprador
			const buyerInfo = {
				name: document.getElementById('buyerName').value,
				email: document.getElementById('buyerEmail').value,
				phone: document.getElementById('buyerPhone').value || ''
			};

			if (!buyerInfo.name || !buyerInfo.email) {
				alert('Please fill in buyer information');
				return;
			}

			// Deshabilitar botón de compra
			const purchaseBtn = document.getElementById('purchaseBtn');
			const cardErrors = document.getElementById('card-errors');
			
			purchaseBtn.disabled = true;
			purchaseBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processing...';
			cardErrors.textContent = '';

			// Crear token de tarjeta con Stripe (igual que order-access)
			if (typeof Stripe === 'undefined') {
				alert('Stripe is not loaded. Please refresh the page and try again.');
				purchaseBtn.disabled = false;
				purchaseBtn.innerHTML = '<i class="fa-solid fa-credit-card"></i> Purchase Tickets';
				return;
			}

			stripe.createToken(card).then(function(result) {
				if (result.error) {
					console.error('Stripe token error:', result.error);
					cardErrors.textContent = result.error.message;
					purchaseBtn.disabled = false;
					purchaseBtn.innerHTML = '<i class="fa-solid fa-credit-card"></i> Purchase Tickets';
				} else {
					// Crear formulario de pago
					const form = document.createElement('form');
					form.method = 'POST';
					form.action = '{{ base_url }}/tickets/purchase';
					
					// Agregar campos ocultos
					const eventIdInput = document.createElement('input');
					eventIdInput.type = 'hidden';
					eventIdInput.name = 'event_id';
					eventIdInput.value = currentEventId;
					form.appendChild(eventIdInput);

					const ticketsInput = document.createElement('input');
					ticketsInput.type = 'hidden';
					ticketsInput.name = 'tickets';
					ticketsInput.value = JSON.stringify(selectedTickets);
					form.appendChild(ticketsInput);

					const buyerInput = document.createElement('input');
					buyerInput.type = 'hidden';
					buyerInput.name = 'buyer_info';
					buyerInput.value = JSON.stringify(buyerInfo);
					form.appendChild(buyerInput);

					// Agregar token de tarjeta
					const tokenInput = document.createElement('input');
					tokenInput.type = 'hidden';
					tokenInput.name = 'customer_token';
					tokenInput.value = result.token.id;
					form.appendChild(tokenInput);

					// Enviar formulario
					document.body.appendChild(form);
					form.submit();
				}
			});
		}

		// Handle Login Form Submission
		document.getElementById('modalLoginForm').addEventListener('submit', function(e) {
			e.preventDefault();
			
			const formData = new FormData(this);
			
			fetch('{{ base_url }}/login', {
				method: 'POST',
				headers: {
					'X-Requested-With': 'XMLHttpRequest'
				},
				body: formData
			})
			.then(response => {
				if (!response.ok) {
					throw new Error('Network response was not ok');
				}
				return response.json();
			})
			.then(data => {
				if (data.success) {
					// Login successful, get user data and show ticket purchase section
					fetch('{{ base_url }}/api/check-auth')
						.then(response => response.json())
						.then(authData => {
							if (authData.success && authData.user) {
								showTicketPurchaseSection(authData.user);
							} else {
					showTicketPurchaseSection();
							}
					loadTicketTypes();
							// Initialize Stripe when showing purchase section
							setTimeout(initializeStripe, 500);
						})
						.catch(error => {
							console.error('Error getting user data:', error);
							showTicketPurchaseSection();
							loadTicketTypes();
							setTimeout(initializeStripe, 500);
						});
				} else {
					alert('Login failed: ' + data.message);
				}
			})
			.catch(error => {
				console.error('Login error:', error);
				alert('Login error occurred: ' + error.message);
			});
		});

		// Handle Buy Tickets buttons
		document.addEventListener('click', function(e) {
			if (e.target.closest('.buy-tickets-btn')) {
				const btn = e.target.closest('.buy-tickets-btn');
				const eventId = parseInt(btn.dataset.eventId);
				const eventName = btn.dataset.eventName;
				const eventDate = btn.dataset.eventDate;
				openTicketModal(eventId, eventName, eventDate);
			}
		});

		// Handle Signup Form Submission
		document.getElementById('modalSignupForm').addEventListener('submit', function(e) {
			e.preventDefault();
			
			const formData = new FormData(this);
			formData.append('level', '5');
			
			
			fetch('{{ base_url }}/signup', {
				method: 'POST',
				headers: {
					'X-Requested-With': 'XMLHttpRequest'
				},
				body: formData
			})
			.then(response => {
				
				if (!response.ok) {
					throw new Error(`HTTP ${response.status}: ${response.statusText}`);
				}
				return response.json();
			})
			.then(data => {
				if (data.success) {
					// Signup successful, get user data and show ticket purchase section
					fetch('{{ base_url }}/api/check-auth')
						.then(response => response.json())
						.then(authData => {
							if (authData.success && authData.user) {
								showTicketPurchaseSection(authData.user);
							} else {
					showTicketPurchaseSection();
							}
					loadTicketTypes();
							// Initialize Stripe when showing purchase section
							setTimeout(initializeStripe, 500);
						})
						.catch(error => {
							console.error('Error getting user data:', error);
							showTicketPurchaseSection();
							loadTicketTypes();
							setTimeout(initializeStripe, 500);
						});
				} else {
					// Check if user already exists
					if (data.message && data.message.includes('already registered')) {
						// User exists, try to login automatically
						attemptAutoLogin(formData.get('email'), formData.get('password'));
					} else {
						alert('Signup failed: ' + data.message);
					}
				}
			})
			.catch(error => {
				console.error('Signup error:', error);
				alert('Signup error occurred: ' + error.message);
			});
		});

		// Function to attempt auto-login for existing users
		function attemptAutoLogin(email, password) {
			const loginData = new FormData();
			loginData.append('email', email);
			loginData.append('password', password);
			
			fetch('{{ base_url }}/login', {
				method: 'POST',
				headers: {
					'X-Requested-With': 'XMLHttpRequest'
				},
				body: loginData
			})
			.then(response => response.json())
			.then(data => {
				if (data.success) {
					// Login successful, show ticket purchase section
					showTicketPurchaseSection();
					loadTicketTypes();
					// Initialize Stripe when showing purchase section
					setTimeout(initializeStripe, 500);
				} else {
					alert('User exists but login failed: ' + data.message);
				}
			})
			.catch(error => {
				console.error('Auto-login error:', error);
				alert('User exists but could not login automatically');
			});
		}
	</script>

	{# ======= NUEVO: JS del acordeón de categorías (no interfiere con lo demás) ======= #}
	{% if categories is defined and categories %}
	<script>
	(function() {
	  const section   = document.getElementById('vnv-catFilter');
	  const header    = section.querySelector('.vnv-ac-header');
	  const grid      = document.getElementById('vnv-catGrid');
	  const countEl   = document.getElementById('vnv-catCount');
	  const summaryEl = document.getElementById('vnv-catSummary');
	  const searchEl  = document.getElementById('vnv-catSearch');
	  const btnAll    = document.getElementById('vnv-catSelectAll');
	  const btnClear  = document.getElementById('vnv-catClear');
	  const storageKey = section.dataset.key || 'vnv_cat_ac_open';

	  const getAllPills = () => Array.from(grid.querySelectorAll('.vnv-ac-pill'));
	  const getHiddenById = (id) => grid.querySelector('#vnv-cat-' + id);

	  function setOpen(isOpen) {
		section.classList.toggle('is-open', isOpen);
		section.classList.toggle('is-collapsed', !isOpen);
		header.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
		try { localStorage.setItem(storageKey, isOpen ? '1' : '0'); } catch(e) {}
		updateSummary();
	  }

	  function restoreOpenState() {
		let v = '0';
		try { v = localStorage.getItem(storageKey) || '0'; } catch(e) {}
		const isMobile = matchMedia('(max-width: 768px)').matches;
		setOpen(v === '1' ? true : (!isMobile)); // desktop abierto, mobile cerrado
	  }

	  function updateCount() {
		const selected = grid.querySelectorAll('.vnv-ac-pill.is-selected').length;
		countEl.textContent = (selected === 0) ? '0 selected' :
							  (selected === 1) ? '1 selected' : `${selected} selected`;
	  }

	  function updateSummary() {
		const isOpen = section.classList.contains('is-open');
		if (isOpen) { summaryEl.textContent = ''; return; }
		const selected = getAllPills().filter(p => p.classList.contains('is-selected'));
		if (selected.length === 0) { summaryEl.textContent = 'No filters applied'; return; }
		const names = selected.map(p => p.dataset.label);
		const first = names.slice(0,3).join(', ');
		const rest  = names.length > 3 ? ` +${names.length - 3}` : '';
		summaryEl.innerHTML = first + rest;
	  }

	  function togglePill(pill) {
		const id = pill.dataset.id;
		const hidden = getHiddenById(id);
		const sel = pill.classList.toggle('is-selected');
		pill.setAttribute('aria-pressed', sel ? 'true' : 'false');
		if (hidden) hidden.checked = sel;
		updateCount();
		updateSummary();
	  }

	  function selectAll() {
		getAllPills().forEach(p => { if (!p.classList.contains('is-selected')) togglePill(p); });
	  }

	  function clearAll() {
		getAllPills().forEach(p => { if (p.classList.contains('is-selected')) togglePill(p); });
	  }

	  function applySearchFilter(term) {
		const q = term.trim().toLowerCase();
		getAllPills().forEach(p => {
		  const label = (p.dataset.label || '').toLowerCase();
		  p.style.display = label.includes(q) ? '' : 'none';
		});
	  }

	  header.addEventListener('click', () => {
		const isOpen = section.classList.contains('is-open');
		setOpen(!isOpen);
	  });
	  header.addEventListener('keydown', (e) => {
		if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); header.click(); }
	  });

	  grid.addEventListener('click', (e) => {
		const pill = e.target.closest('.vnv-ac-pill');
		if (!pill) return;
		togglePill(pill);
	  });

	  btnAll && btnAll.addEventListener('click', selectAll);
	  btnClear && btnClear.addEventListener('click', clearAll);
	  searchEl && searchEl.addEventListener('input', (e) => applySearchFilter(e.target.value));

	  restoreOpenState();
	  updateCount();
	  updateSummary();
	})();
	</script>

