{% extends 'templates/base.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
<style>
.venue-title {
    font-family: 'Poppins', sans-serif;
    font-weight: 200;
    font-size: 2.2rem;
}
.venue-title .highlight {
    color: #26a69a;
    font-weight: 700;
}

.platform-filter {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
}

.platform-btn {
    padding: 0.75rem 1.5rem;
    border-radius: 50px;
    border: 2px solid #e5e7eb;
    background: white;
    color: #111827;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.platform-btn:hover {
    border-color: #26a69a;
    color: #26a69a;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(38, 166, 154, 0.2);
}

.platform-btn.active {
    background: #26a69a;
    border-color: #26a69a;
    color: white;
}

.category-navigation {
    max-width: 1100px;
    margin: 0 auto 2rem;
}

.category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1rem;
}

.category-card {
    display: block;
    padding: 1rem;
    border-radius: 16px;
    text-decoration: none;
    color: #111827;
    background: #fff;
    border: 1px solid #e5e7eb;
    box-shadow: 0 10px 28px rgba(15, 23, 42, .06);
    transition: .2s ease;
}

.category-card:hover,
.category-card.active {
    transform: translateY(-2px);
    border-color: #26a69a;
    color: #111827;
    box-shadow: 0 16px 34px rgba(38, 166, 154, .16);
}

.category-card strong {
    display: block;
    font-size: 1rem;
}

.category-card span {
    color: #64748b;
    font-size: .86rem;
}

.vnv-empty-state {
    padding: 1.2rem;
    border: 1px dashed #cbd5e1;
    border-radius: 14px;
    background: #f8fafc;
    color: #64748b;
}

.search-box {
    max-width: 600px;
    margin: 0 auto 2rem;
}

.search-input-group {
    display: flex;
    gap: 0.5rem;
}

.search-input-group input {
    flex: 1;
    padding: 0.75rem 1rem;
    border: 2px solid #e5e7eb;
    border-radius: 50px;
    font-size: 1rem;
}

.search-input-group input:focus {
    outline: none;
    border-color: #26a69a;
}

.search-input-group button {
    padding: 0.75rem 1.5rem;
    background: #26a69a;
    color: white;
    border: none;
    border-radius: 50px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.3s ease;
}

.search-input-group button:hover {
    background: #1f8d82;
}

.sessions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.session-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.session-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
}

.session-card-header {
    padding: 1.5rem;
    background: linear-gradient(135deg, #0a0a0a, #1b1b1b);
    color: white;
}

.session-card-header h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.25rem;
    font-weight: 700;
}

.session-card-body {
    padding: 1.5rem;
}

.session-platform {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
}

.session-platform.youtube {
    background: #ff0000;
    color: white;
}

.session-platform.soundcloud {
    background: #ff5500;
    color: white;
}

.session-platform.spotify {
    background: #1db954;
    color: white;
}

.session-description {
    color: #6b7280;
    font-size: 0.95rem;
    margin-bottom: 1rem;
    line-height: 1.6;
}

.session-keywords {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding: 0.75rem;
    background: #f8fafc;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
}

.session-keywords-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 0.5rem;
    width: 100%;
}

.session-keyword {
    padding: 0.4rem 0.9rem;
    background: linear-gradient(135deg, #26a69a, #1f8d82);
    border-radius: 20px;
    font-size: 0.85rem;
    color: white;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    display: inline-block;
}

.session-keyword:hover {
    background: linear-gradient(135deg, #1f8d82, #26a69a);
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(38, 166, 154, 0.3);
}

.session-embed {
    margin-top: 1rem;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    background: #f3f4f6;
    min-height: 400px;
}

.session-embed .embed-wrapper {
    position: relative;
    width: 100%;
}

.session-embed iframe {
    width: 100%;
    border: none;
    opacity: 1;
    transition: opacity 0.3s ease;
}

.session-embed iframe.loaded {
    opacity: 1;
}

.session-embed .loading-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f3f4f6, #e5e7eb);
    color: #6b7280;
    flex-direction: column;
    gap: 1rem;
}

.session-embed .loading-placeholder.hidden {
    display: none;
}

.session-embed .loading-placeholder i {
    font-size: 3rem;
    animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% {
        opacity: 1;
    }
    50% {
        opacity: 0.5;
    }
}

.loading-skeleton {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.skeleton-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    padding: 1.5rem;
}

.skeleton-header {
    height: 2rem;
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: loading 1.5s ease-in-out infinite;
    border-radius: 4px;
    margin-bottom: 1rem;
}

.skeleton-line {
    height: 1rem;
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: loading 1.5s ease-in-out infinite;
    border-radius: 4px;
    margin-bottom: 0.75rem;
}

.skeleton-line.short {
    width: 60%;
}

.skeleton-embed {
    height: 400px;
    background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
    background-size: 200% 100%;
    animation: loading 1.5s ease-in-out infinite;
    border-radius: 8px;
    margin-top: 1rem;
}

@keyframes loading {
    0% {
        background-position: 200% 0;
    }
    100% {
        background-position: -200% 0;
    }
}

.empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: #6b7280;
}

.empty-state i {
    font-size: 4rem;
    margin-bottom: 1rem;
    color: #d1d5db;
}

@media (max-width: 768px) {
    .sessions-grid {
        grid-template-columns: 1fr;
    }
    
    .platform-filter {
        flex-direction: column;
        align-items: stretch;
    }
    
    .platform-btn {
        justify-content: center;
    }
}
</style>
{% endblock %}

{% block body %}
<main class="container py-5">
    <h1 class="venue-title text-center mb-4">
        🎵 Music <span class="highlight">Sessions</span>
    </h1>
    
    <p class="text-center text-muted mb-4">
        Discover Multimedia Sessions from YouTube, SoundCloud, and Spotify
    </p>
    
    <div class="platform-filter">
        <a href="{{ path('search/multimedia-sessions/main') }}?platform=youtube" 
           class="platform-btn {{ selected_platform == 'youtube' ? 'active' : '' }}">
            <i class="fab fa-youtube"></i> YouTube
        </a>
        <a href="{{ path('search/multimedia-sessions/main') }}?platform=soundcloud" 
           class="platform-btn {{ selected_platform == 'soundcloud' ? 'active' : '' }}">
            <i class="fab fa-soundcloud"></i> SoundCloud
        </a>
        <a href="{{ path('search/multimedia-sessions/main') }}?platform=spotify" 
           class="platform-btn {{ selected_platform == 'spotify' ? 'active' : '' }}">
            <i class="fab fa-spotify"></i> Spotify
        </a>
    </div>
    
    <div class="search-box">
        <form method="get" action="{{ path('search/multimedia-sessions/main') }}" class="search-input-group" id="searchForm">
            <input type="hidden" name="platform" value="{{ selected_platform }}" id="platformInput">
            {% if selected_category %}
                <input type="hidden" name="category" value="{{ selected_category }}">
            {% endif %}
            <input type="text" 
                   name="search" 
                   placeholder="Search by title, description, or keywords..." 
                   value="{{ search_query ?? '' }}"
                   class="form-control"
                   id="searchInput">
            <button type="submit" id="searchBtn">
                <i class="fas fa-search"></i> Search
            </button>
        </form>
    </div>
    
    <div class="loading-skeleton" id="loadingSkeleton" style="display: none;">
        {% for i in 1..6 %}
            <div class="skeleton-card">
                <div class="skeleton-header"></div>
                <div class="skeleton-line"></div>
                <div class="skeleton-line short"></div>
                <div class="skeleton-embed"></div>
            </div>
        {% endfor %}
    </div>
    
    <div id="resultsContainer">
    <div class="category-navigation">
        <h2 class="h5 text-center fw-bold mb-3">Choose a category</h2>
        <div class="category-grid">
            {% for category in categories %}
                <a class="category-card {{ selected_category == category.id ? 'active' : '' }}" href="{{ path('search/multimedia-sessions/main') }}?platform={{ selected_platform }}&category={{ category.id }}{% if search_query %}&search={{ search_query|url_encode }}{% endif %}">
                    <strong>{{ category.name }}</strong>
                    <span>{{ category.sessions_count }} session{{ category.sessions_count == 1 ? '' : 's' }}</span>
                </a>
            {% else %}
                <div class="vnv-empty-state">No music categories are available for this platform yet.</div>
            {% endfor %}
        </div>
    </div>

    {% if not selected_category %}
        <div class="text-center text-muted my-5">
            Select a category above to load a focused set of Multimedia Sessions.
        </div>
    {% elseif sessions|length > 0 %}
        <div class="sessions-grid">
            {% for session in sessions %}
                <div class="session-card">
                    <div class="session-card-header">
                        <h3>{{ session.title }}</h3>
                        {% if session.category_name %}
                            <span style="font-size: 0.9rem; opacity: 0.9;">{{ session.category_name }}</span>
                        {% endif %}
                    </div>
                    <div class="session-card-body">
                        <span class="session-platform {{ session.platform|lower }}">
                            {{ session.platform|upper }}
                        </span>
                        
                        {% if session.description %}
                            <p class="session-description">
                                {{ session.description|slice(0, 150) }}{% if session.description|length > 150 %}...{% endif %}
                            </p>
                        {% endif %}
                        
                        {% if session.keywords and session.keywords|length > 0 %}
                            <div class="session-keywords">
                                <div class="session-keywords-label">
                                    <i class="fas fa-tags"></i> Keywords
                                </div>
                                {% for keyword in session.keywords %}
                                    <a href="{{ path('search/multimedia-sessions/main') }}?platform={{ selected_platform }}&search={{ keyword.keyword|url_encode }}" 
                                       class="session-keyword" 
                                       title="Search for '{{ keyword.keyword }}'">
                                        {{ keyword.keyword }}
                                    </a>
                                {% endfor %}
                            </div>
                        {% endif %}
                        
                        {% if session.embed_code %}
                            <div class="session-embed">
                                <div class="loading-placeholder" id="loading-{{ session.id }}">
                                    <i class="fas fa-music"></i>
                                    <span>Loading player...</span>
                                </div>
                                <div class="embed-wrapper" data-session-id="{{ session.id }}">
                                    {{ session.embed_code|raw }}
                                </div>
                            </div>
                        {% else %}
                            <a href="{{ session.url }}" target="_blank" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-external-link-alt"></i> View on {{ session.platform|upper }}
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-state">
            <i class="fas fa-music"></i>
            <h3>No sessions found</h3>
            <p>
                {% if search_query %}
                    No Multimedia Sessions found matching "{{ search_query }}" on {{ selected_platform|upper }}.
                {% else %}
                    No Multimedia Sessions available in this category for {{ selected_platform|upper }} at the moment.
                {% endif %}
            </p>
            <p class="mt-3">
                <a href="{{ path('search/multimedia-sessions/main') }}?platform={{ selected_platform }}" class="btn btn-outline-secondary">
                    Clear search
                </a>
            </p>
        </div>
    {% endif %}
    </div>
</main>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const embedWrappers = document.querySelectorAll('.embed-wrapper');
    
    embedWrappers.forEach(wrapper => {
        const iframe = wrapper.querySelector('iframe');
        const sessionId = wrapper.getAttribute('data-session-id');
        const loadingPlaceholder = document.getElementById('loading-' + sessionId);
        
        if (iframe) {
            iframe.classList.add('loaded');
            
            if (loadingPlaceholder) {
                const hidePlaceholder = () => {
                    setTimeout(() => {
                        loadingPlaceholder.classList.add('hidden');
                    }, 500);
                };
                
                if (iframe.complete) {
                    hidePlaceholder();
                } else {
                    iframe.addEventListener('load', hidePlaceholder);
                    
                    setTimeout(() => {
                        if (loadingPlaceholder && !loadingPlaceholder.classList.contains('hidden')) {
                            loadingPlaceholder.classList.add('hidden');
                        }
                    }, 2000);
                }
            }
        }
    });
    
    const searchForm = document.getElementById('searchForm');
    const resultsContainer = document.getElementById('resultsContainer');
    const loadingSkeleton = document.getElementById('loadingSkeleton');
    
    if (searchForm && resultsContainer && loadingSkeleton) {
        searchForm.addEventListener('submit', function() {
            resultsContainer.style.display = 'none';
            loadingSkeleton.style.display = 'grid';
        });
    }
    
    const platformButtons = document.querySelectorAll('.platform-btn');
    const currentPlatform = '{{ selected_platform }}';
    
    platformButtons.forEach(btn => {
        btn.addEventListener('click', function(e) {
            const href = this.getAttribute('href');
            if (href && !href.includes('platform=' + currentPlatform)) {
                if (resultsContainer) resultsContainer.style.display = 'none';
                if (loadingSkeleton) loadingSkeleton.style.display = 'grid';
            }
        });
    });
});
</script>
{% endblock %}

