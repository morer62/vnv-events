{% block body %}

{% include "templates/layout/publicHeaderVnv.html.twig" %}

<section class="vnv-hero-master">
    <div class="hero-split-container">
        <div class="hero-info-pane">
            <span class="vnv-badge">Welcome to VNV Event</span>
            <h1>Full-Service Luxury Event Planning & <span class="text-gold">Catering Studio in South Florida</span></h1>
            <p class="fs-5 mb-5 hero-description">
               The event you imagine come to life
            </p>
            <div class="d-flex flex-wrap gap-4 justify-content-center justify-content-lg-start">
                <a href="{{ path('login') }}" class="vnv-btn btn-outline-vnv">Login to your account</a>
                <a href="tel:+13052045427" class="vnv-btn btn-gold-vnv">Call (305)204-5427</a>
                <button type="button" data-vnv-open-request class="vnv-btn btn-outline-vnv hero-mobile-request-cta">Plan My Event</button>
            </div>
            <br><br>
        </div>

        <div class="hero-visual-pane" aria-hidden="true">
            <video class="hero-video-src" muted loop playsinline preload="none" data-vnv-lazy-video>
                <source data-src="{{ asset_for('assets/video/intro_vnv.mp4') }}" type="video/mp4">
            </video>
        </div>
    </div>
</section>

<section class="metric-strip-vnv text-center">
    <div class="container">
        <div class="row g-4 justify-content-center">
            <div class="col-12 col-lg-3">
                <div class="metric-item">
                    <div class="metric-val" aria-label="More than five years of experience">5+</div>
                    <p class="metric-label">YEARS OF EXPERIENCE</p>
                </div>
            </div>

            <div class="col-12 col-lg-3">
                <div class="metric-item">
                    <div class="metric-val" aria-label="More than two hundred events per year">200+</div>
                    <p class="metric-label">EVENTS PER YEAR</p>
                </div>
            </div>

            <div class="col-12 col-lg-3">
                <div class="metric-item">
                    <div class="metric-val" aria-label="Full service support">FULL</div>
                    <p class="metric-label">SERVICE SUPPORT</p>
                </div>
            </div>

            <div class="col-12 col-lg-3">
                <div class="metric-logo-block">
                    <img class="metric-logo-vnv" src="{{ asset_for('assets/images/planner-hub-logo-positive.png') }}" alt="VNV Events" width="280" height="179" loading="lazy" decoding="async">
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-services-vnv" id="services">
    <div class="services-bg-video-wrap">
        <video class="services-bg-video" muted loop playsinline preload="none" data-vnv-lazy-video="observe">
            <source data-src="{{ asset_for('assets/video/intro.mp4') }}" type="video/mp4">
        </video>
        <div class="services-bg-overlay"></div>
    </div>

    <div class="container position-relative" style="z-index:2;">
        <div class="text-center mb-5 pb-5">
            <h2 class="display-2 fw-black text-white">Our <span class="text-vnv">Services</span></h2>
            <p class="text-vnv-muted fs-4">A modern event house combining planning, production, design, entertainment and hospitality.</p>
        </div>

