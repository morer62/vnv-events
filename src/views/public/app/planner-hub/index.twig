{% extends "templates/base.twig" %}
{% set defer_public_third_party = true %}
{% set skip_public_app_bundle = true %}
{% set skip_public_google_maps = true %}
{% set skip_public_stripe = true %}
{% set skip_base_fontawesome = true %}
{% set skip_base_inter_font = true %}
{% set skip_base_app_css = true %}
{% set skip_base_bootstrap_css = true %}
{% set skip_public_gtm_initial = true %}
{% set skip_public_bootstrap_js = true %}

{#
    VNV EVENTS - CLEANED / MOBILE FIXED VERSION
#}

{% set show_whatsapp = true %}
{% set seo = {
    title: 'VNV Events | Full-Service Luxury Event Planning & Catering Studio in South Florida',
    description: 'VNV Events is a full-service luxury event planning, catering, production, entertainment and event rental studio serving Miami, Broward, Palm Beach and South Florida.'
} %}

{% block meta_description %}VNV Events is a full-service luxury event planning, catering, production, entertainment and event rental studio serving Miami, Broward, Palm Beach and South Florida.{% endblock %}
{% block meta_keywords %}VNV Events, South Florida event planning, Miami event planner, Broward event planner, catering South Florida, wedding planning, corporate events, event rentals, DJ services, photo booth, event production{% endblock %}

{% block styles %}
<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"></noscript>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Playfair+Display:wght@700;900&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet"></noscript>

<style>
:root {
    --vnv-primary: #5EC6C4;
    --vnv-primary-dark: #4aa8a6;
    --vnv-gold: #c5a059;
    --vnv-gold-gradient: linear-gradient(135deg, #bf953f 0%, #fcf6ba 45%, #b38728 100%);
    --vnv-dark-deep: #0a0c0c;
    --vnv-dark-soft: #161a1b;
    --vnv-dark-card: #1c2223;
    --vnv-light: #ffffff;
    --vnv-marble: #f4f7f8;
    --vnv-text-main: #2d3436;
    --vnv-text-dark: #11181a;
    --vnv-text-light: #f1f2f6;
    --vnv-text-muted: rgba(255, 255, 255, 0.72);
    --vnv-text-muted-soft: rgba(255, 255, 255, 0.62);
    --vnv-shadow-lg: 0 40px 100px rgba(0,0,0,0.18);
    --vnv-glow: 0 0 40px rgba(94, 198, 196, 0.2);
    --vnv-border: rgba(255, 255, 255, 0.06);
}

html {
    scroll-behavior: smooth;
}

html, body {
    width: 100%;
    max-width: 100%;
    margin: 0;
    overflow-x: hidden;
}

*, *::before, *::after {
    box-sizing: border-box;
}

.container {
    width: 100%;
    max-width: 1140px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 15px;
    padding-right: 15px;
}

.container-fluid {
    width: 100%;
    padding-left: 15px;
    padding-right: 15px;
}

.row {
    display: flex;
    flex-wrap: wrap;
    margin-left: -12px;
    margin-right: -12px;
}

.row > * {
    width: 100%;
    max-width: 100%;
    padding-left: 12px;
    padding-right: 12px;
}

.g-3 { row-gap: 1rem; }
.g-4 { row-gap: 1.5rem; }
.g-5 { row-gap: 3rem; }
.g-3 > *, .g-4 > *, .g-5 > * { margin-bottom: 0; }

.col-12 { flex: 0 0 auto; width: 100%; }
.col-6 { flex: 0 0 auto; width: 50%; }

.d-block { display: block; }
.d-flex { display: flex; }
.inline-flex { display: inline-flex; }
.flex-wrap { flex-wrap: wrap; }
.flex-column { flex-direction: column; }
.align-items-center { align-items: center; }
.align-items-start { align-items: flex-start; }
.justify-content-center { justify-content: center; }
.justify-content-end { justify-content: flex-end; }
.gap-3 { gap: 1rem; }
.gap-4 { gap: 1.5rem; }
.gap-5 { gap: 3rem; }
.position-relative { position: relative; }
.text-center { text-align: center; }
.text-lg-end { text-align: inherit; }
.text-white { color: #fff !important; }
.text-muted { color: #6c757d !important; }
.fw-bold { font-weight: 700; }
.fw-black { font-weight: 900; }
.small { font-size: .875rem; }
.opacity-50 { opacity: .5; }
.opacity-75 { opacity: .75; }
.m-0 { margin: 0 !important; }
.mb-1 { margin-bottom: .25rem !important; }
.mb-2 { margin-bottom: .5rem !important; }
.mb-3 { margin-bottom: 1rem !important; }
.mb-4 { margin-bottom: 1.5rem !important; }
.mb-5 { margin-bottom: 3rem !important; }
.mt-5 { margin-top: 3rem !important; }
.pb-5 { padding-bottom: 3rem !important; }
.ms-2 { margin-left: .5rem !important; }
.fs-3 { font-size: 1.75rem !important; }
.fs-4 { font-size: 1.5rem !important; }
.fs-5 { font-size: 1.25rem !important; }
.display-2 { font-size: clamp(3rem, 6vw, 5.5rem); line-height: 1.04; }
.display-3 { font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1.05; }
.ratio {
    position: relative;
    width: 100%;
}
.ratio::before {
    content: "";
    display: block;
}
.ratio-16x9::before { padding-top: 56.25%; }
.ratio > * {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
}

@media (min-width: 768px) {
    .col-sm-6 { flex: 0 0 auto; width: 50%; }
    .col-md-4 { flex: 0 0 auto; width: 33.333333%; }
    .col-md-6 { flex: 0 0 auto; width: 50%; }
}

@media (min-width: 992px) {
    .container { max-width: 960px; }
    .col-lg-3 { flex: 0 0 auto; width: 25%; }
    .col-lg-2 { flex: 0 0 auto; width: 16.666667%; }
    .col-lg-4 { flex: 0 0 auto; width: 33.333333%; }
    .col-lg-5 { flex: 0 0 auto; width: 41.666667%; }
    .col-lg-6 { flex: 0 0 auto; width: 50%; }
    .col-lg-7 { flex: 0 0 auto; width: 58.333333%; }
    .mb-lg-0 { margin-bottom: 0 !important; }
    .mt-lg-0 { margin-top: 0 !important; }
    .justify-content-lg-start { justify-content: flex-start; }
    .justify-content-lg-end { justify-content: flex-end; }
    .text-lg-start { text-align: left; }
    .text-lg-end { text-align: right; }
    .flex-lg-row { flex-direction: row; }
}

@media (min-width: 1200px) {
    .container { max-width: 1140px; }
}

body {
    background-color: var(--vnv-dark-deep);
    color: var(--vnv-text-light);
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

.vnv-hero-master {
    background:
        radial-gradient(circle at 78% 24%, rgba(94,198,196,.22), transparent 34%),
        linear-gradient(135deg, #07100f 0%, #102a27 48%, #050706 100%);
}

.vnv-media-mini-label {
    color: #0f766e !important;
}

.vnv-core-feature-title {
    font-size: 1rem;
    line-height: 1.25;
}

section,
.container,
.container-fluid,
.row,
.hero-visual-pane,
.hero-video-src,
.choose-visual-composition,
.choose-main-frame,
.choose-secondary-frame,
.ophyra-ui-console,
.plan-vnv-card,
.vnv-studio-card,
.tool-bento-card,
.featured-horizontal,
.featured-horizontal-inner {
    max-width: 100%;
}

h1, h2, h3, h4, .luxury-font {
    font-family: 'Playfair Display', serif;
}

.text-gold {
    background: var(--vnv-gold-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 700;
}

.text-vnv { color: var(--vnv-primary) !important; }
.text-vnv-muted { color: rgba(94, 198, 196, 0.82) !important; }
.border-vnv { border-color: var(--vnv-primary) !important; }
.letter-spacing-lg { letter-spacing: 5px; }

.section-light .text-vnv,
.section-podcast-vnv .text-vnv,
.vnv-media-mini-label {
    color: #0f766e !important;
}

.section-light .text-muted,
.section-podcast-vnv .text-muted {
    color: #4f5b5e !important;
}

.vnv-btn {
    padding: 22px 50px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 3px;
    transition: all 0.45s cubic-bezier(0.165, 0.84, 0.44, 1);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: 0.8rem;
    position: relative;
    z-index: 1;
    border-radius: 999px;
}

.btn-gold-vnv {
    background: var(--vnv-gold-gradient);
    color: #000 !important;
}

.btn-gold-vnv:hover {
    transform: translateY(-4px) scale(1.01);
    box-shadow: 0 20px 40px rgba(197, 160, 89, 0.3);
}

.btn-outline-vnv {
    border: 2px solid var(--vnv-primary);
    color: var(--vnv-primary) !important;
    background: transparent;
}

.btn-outline-vnv:hover {
    background: var(--vnv-primary);
    color: #fff !important;
}

.btn-ghost-white {
    border: 1px solid rgba(255,255,255,0.2);
    color: #fff !important;
    background: transparent;
}

.btn-ghost-white:hover {
    background: #fff;
    color: #000 !important;
}

.hero-mobile-request-cta {
    display: none;
}

.section-vnv {
    padding: 160px 0;
    position: relative;
}

.metric-strip-vnv,
.section-services-vnv,
.section-tools-bento,
.section-light,
.section-ophyra-vnv,
.section-podcast-vnv,
.section-instagram-vnv,
.section-plan-vnv {
    content-visibility: auto;
    contain-intrinsic-size: 900px;
}

.section-light {
    background-color: var(--vnv-marble);
    color: var(--vnv-text-dark);
    border-radius: 140px 0 0 0;
    margin-top: -100px;
    z-index: 10;
}

/* HERO */
.vnv-hero-master {
    min-height: 100vh;
    display: flex;
    background: #ffffff;
    position: relative;
    z-index: 1;
}

.hero-split-container {
    display: flex;
    width: 100%;
    min-height: 100vh;
}

.hero-info-pane {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 8%;
    background: #fff;
    z-index: 2;
}

.hero-visual-pane {
    flex: 1.3;
    position: relative;
    clip-path: polygon(15% 0, 100% 0, 100% 100%, 0% 100%);
    background: #000;
}

.hero-video-src {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.9);
}

.hero-info-pane h1 {
    font-size: clamp(3rem, 6.5vw, 5.5rem);
    font-weight: 900;
    color: #1a1f20;
    line-height: 1.08;
    margin-bottom: 35px;
}

.hero-description {
    max-width: 550px;
    color: #5d6668;
}

.vnv-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(94,198,196,.1);
    color: var(--vnv-primary);
    font-size: .74rem;
    letter-spacing: 2px;
    font-weight: 800;
    text-transform: uppercase;
}

/* METRICS */
.metric-strip-vnv {
    background: var(--vnv-dark-deep);
    padding: 100px 0;
    border-bottom: 1px solid var(--vnv-border);
}

.metric-strip-vnv .row > div {
    display: flex;
    justify-content: center;
}

.metric-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-align: left;
}

.metric-val {
    font-size: 4.5rem;
    font-weight: 900;
    color: var(--vnv-primary);
    line-height: 1;
    margin: 0;
    flex: 0 0 auto;
}

.metric-label {
    letter-spacing: 5px;
    font-weight: 700;
    opacity: 0.5;
    font-size: 0.7rem;
    line-height: 1.5;
    margin: 0;
    text-align: left;
}

.metric-logo-block {
    min-height: 180px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.metric-logo-vnv {
    width: min(280px, 82%);
    max-width: 280px;
    height: auto;
    display: block;
    margin: 0 auto;
    opacity: .98;
}

/* SERVICES */
.section-services-vnv {
    background-color: var(--vnv-dark-deep);
    padding: 160px 0;
    position: relative;
    overflow: hidden;
    isolation: isolate;
}

.services-bg-video-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
}

.services-bg-video {
    width: 100%;
    height: 120%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.60;
    filter: blur(2px) saturate(0.8);
    transform: translateY(-6%);
}

.services-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to bottom,
        rgba(10,12,12,0.25),
        rgba(10,12,12,0.28),
        rgba(10,12,12,0.25)
    );
}

.vnv-service-grid-card {
    background: rgba(28, 34, 35, 0.82);
    backdrop-filter: blur(6px);
    border-radius: 28px;
    padding: 60px 45px;
    height: 100%;
    border: 1px solid rgba(197, 160, 89, 0.08);
    transition: all 0.45s cubic-bezier(0.165, 0.84, 0.44, 1);
    position: relative;
    overflow: hidden;
    z-index: 2;
}

.vnv-service-grid-card:hover {
    transform: translateY(-12px);
    border-color: var(--vnv-gold);
    box-shadow: 0 40px 80px rgba(0,0,0,0.5);
}

.service-icon-box {
    width: 60px;
    height: 60px;
    background: rgba(197, 160, 89, 0.1);
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--vnv-gold);
    font-size: 1.6rem;
    margin-bottom: 35px;
}

.service-num-floating {
    position: absolute;
    top: 40px;
    right: 45px;
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem;
    font-weight: 900;
    color: rgba(197, 160, 89, 0.48);
}

.vnv-service-grid-card h3 {
    font-size: 2rem;
    font-weight: 700;
    color: white;
    margin-bottom: 25px;
}

.vnv-service-grid-card p {
    color: var(--vnv-text-muted);
    font-size: 1.05rem;
    margin-bottom: 40px;
}

.vnv-link-gold {
    color: var(--vnv-gold) !important;
    font-weight: 800;
    letter-spacing: 2px;
    font-size: 0.85rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    transition: 0.3s;
}

.vnv-link-gold:hover {
    gap: 18px;
    color: white !important;
}

/* TOOLS BENTO */
.section-tools-bento {
    background:
        radial-gradient(circle at top right, rgba(94,198,196,0.10), transparent 24%),
        linear-gradient(180deg, #0b0d0e 0%, #111516 100%);
    padding: 145px 0;
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgba(255,255,255,0.04);
    border-bottom: 1px solid rgba(255,255,255,0.04);
}

.section-tools-bento::before {
    content:"";
    position:absolute;
    left:-120px;
    bottom:-120px;
    width:340px;
    height:340px;
    background: radial-gradient(circle, rgba(197,160,89,0.12) 0%, transparent 70%);
    pointer-events:none;
}

.tools-bento-heading {
    max-width: 920px;
    margin-bottom: 52px;
}

.tools-bento-eyebrow {
    display:inline-flex;
    align-items:center;
    gap:10px;
    padding:10px 18px;
    border-radius:999px;
    background: rgba(94,198,196,.10);
    color: var(--vnv-primary);
    font-size: .74rem;
    letter-spacing: 2px;
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: 22px;
}

.tools-bento-heading h2 {
    font-size: clamp(2.3rem, 4.2vw, 4.4rem);
    line-height: 1.03;
    color:#fff;
    margin-bottom: 18px;
    max-width: 780px;
}

.tools-bento-heading p {
    color: rgba(255,255,255,.68);
    font-size: 1.05rem;
    margin:0;
    max-width: 760px;
}

.tools-bento-layout {
    display:grid;
    grid-template-columns: 1.2fr .9fr .9fr;
    gap: 22px;
    align-items: stretch;
}

.tools-bento-col {
    display:grid;
    gap:22px;
}

.tool-bento-card {
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    background: linear-gradient(145deg, rgba(28,34,35,0.96) 0%, rgba(15,18,19,0.98) 100%);
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 30px;
    padding: 28px 26px;
    box-shadow: 0 24px 60px rgba(0,0,0,.24);
    text-decoration:none;
    transition: transform .35s ease, border-color .35s ease, box-shadow .35s ease;
    position: relative;
    overflow: hidden;
    min-height: 220px;
}

.tool-bento-card::after {
    content:"";
    position:absolute;
    inset:0;
    background: linear-gradient(180deg, rgba(255,255,255,.03), transparent 34%);
    pointer-events:none;
}

.tool-bento-card:hover {
    transform: translateY(-8px);
    border-color: rgba(94,198,196,.34);
    box-shadow: 0 34px 80px rgba(0,0,0,.32);
}

.tool-bento-card.featured {
    min-height: 470px;
    padding: 34px 32px;
}

.tool-bento-card.medium {
    min-height: 224px;
}

.tool-bento-card.small {
    min-height: 180px;
}

.tool-bento-top {
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:14px;
    margin-bottom: 18px;
}

.tool-bento-icon {
    width:64px;
    height:64px;
    border-radius:18px;
    display:flex;
    align-items:center;
    justify-content:center;
    background: rgba(197,160,89,.10);
    color: var(--vnv-gold);
    font-size:1.4rem;
    flex:0 0 auto;
}

.tool-bento-card.small .tool-bento-icon {
    width:52px;
    height:52px;
    border-radius:15px;
    font-size:1.15rem;
}

.tool-bento-badge {
    display:inline-flex;
    padding:7px 12px;
    border-radius:999px;
    background: rgba(255,255,255,.05);
    color: rgba(255,255,255,.62);
    font-size:.67rem;
    font-weight:800;
    letter-spacing:1.5px;
    text-transform:uppercase;
    white-space:nowrap;
}

.tool-bento-card h3 {
    font-size:1.55rem;
    line-height:1.15;
    color:#fff;
    margin-bottom:12px;
    max-width: 95%;
}

.tool-bento-card.small h3 {
    font-size:1.08rem;
    line-height:1.2;
    max-width: 100%;
    margin-bottom: 10px;
}

.tool-bento-card p {
    color: rgba(255,255,255,.68);
    font-size: .96rem;
    line-height: 1.65;
    margin: 0 0 22px;
    max-width: 95%;
}

.tool-bento-card.small p {
    font-size: .88rem;
    line-height: 1.55;
    margin-bottom: 16px;
}

.tool-bento-footer {
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:14px;
    margin-top:auto;
}

.tool-bento-footer span {
    color: var(--vnv-primary);
    font-size:.78rem;
    font-weight:800;
    letter-spacing:1.6px;
    text-transform:uppercase;
}

.tool-bento-arrow {
    width:42px;
    height:42px;
    border-radius:50%;
    border:1px solid rgba(255,255,255,.12);
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    transition: all .28s ease;
    flex:0 0 auto;
}

.tool-bento-card:hover .tool-bento-arrow {
    background: var(--vnv-primary);
    border-color: var(--vnv-primary);
    transform: translateX(4px);
}

/* WHY CHOOSE US */
.choose-visual-composition {
    position: relative;
    width: 560px;
    max-width: 100%;
    height: 620px;
    margin: 0 auto;
}

.choose-main-frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    overflow: hidden;
    border: 18px solid #3a3a3a;
    box-shadow: 0 40px 100px rgba(0,0,0,0.18);
    background: #fff;
}

.choose-main-frame::after {
    content: "";
    position: absolute;
    inset: 18px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.18);
    pointer-events: none;
}

.choose-img-main,
.choose-img-secondary {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
}

.choose-secondary-frame {
    position: absolute;
    right: 0;
    bottom: 10px;
    width: 240px;
    height: 300px;
    border-radius: 34px;
    overflow: hidden;
    border: 12px solid #ffffff;
    box-shadow: 0 28px 70px rgba(0,0,0,0.18);
    background: #fff;
}

.choose-secondary-frame::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.12), transparent 40%);
    pointer-events: none;
    z-index: 1;
}

.check-vnv {
    font-size: 1.8rem;
    color: var(--vnv-primary);
    margin-top: 5px;
}

/* OPHYRA */
.section-ophyra-vnv {
    background: var(--vnv-dark-soft);
    padding: 160px 0;
}

.ophyra-ui-console {
    background:
        linear-gradient(90deg, rgba(0, 0, 0, .71), rgba(0, 0, 0, .43) 48%, rgba(0, 0, 0, .55)),
        linear-gradient(180deg, rgba(0, 0, 0, .45), rgba(0, 0, 0, .67)),
        url("{{ path('/assets/images/vnv-core-brunch-mansion-hero.png') }}") center 46% / cover fixed;
    border-radius: 35px;
    padding: 80px;
    border: 1px solid var(--vnv-border);
    box-shadow: var(--vnv-glow);
    position: relative;
    overflow: hidden;
}

.ophyra-ui-console > .row {
    position: relative;
    z-index: 2;
}

.ophyra-ui-console::before {
    content: "";
    position: absolute;
    top: -120px;
    right: -80px;
    width: 280px;
    height: 280px;
    background: radial-gradient(circle, rgba(94, 198, 196, 0.18) 0%, transparent 70%);
    pointer-events: none;
}

.vnv-app-download-panel {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-left: 24px;
}

.vnv-app-download-eyebrow {
    display: inline-block;
    margin-bottom: 14px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 3px;
    color: var(--vnv-primary);
    text-transform: uppercase;
}

.vnv-app-download-panel h3 {
    color: #fff;
    font-size: clamp(2rem, 2.8vw, 3rem);
    line-height: 1.05;
    margin: 0 0 14px;
}

.vnv-app-download-panel p {
    max-width: 420px;
    color: rgba(255,255,255,0.68);
    margin: 0 0 24px;
    font-size: 1.02rem;
}

.vnv-app-download-badges {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 280px;
    max-width: 280px;
}

.vnv-app-download-badges a {
    display: block;
    transition: transform .25s ease, opacity .25s ease;
}

.vnv-app-download-badges a:hover {
    transform: translateY(-2px);
    opacity: .96;
}

.vnv-app-download-badges img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 18px;
}

/* PODCAST */
.section-podcast-vnv {
    position: relative;
    background:
        radial-gradient(circle at top left, rgba(94,198,196,.10), transparent 26%),
        radial-gradient(circle at bottom right, rgba(197,160,89,.10), transparent 24%),
        #f7f8f9;
    padding: 110px 0;
    border-radius: 0 140px 0 0;
    overflow: hidden;
}

.vnv-section-kicker {
    display:inline-flex;
    align-items:center;
    gap:10px;
    padding:10px 18px;
    border-radius:999px;
    background:rgba(94,198,196,.12);
    color:var(--vnv-primary);
    font-size:.78rem;
    font-weight:800;
    letter-spacing:1.8px;
    text-transform:uppercase;
    margin-bottom:20px;
}

.vnv-media-intro-card {
    display:flex;
    align-items:flex-start;
    gap:16px;
    padding:20px;
    border-radius:22px;
    background:#fff;
    border:1px solid rgba(17,24,26,.08);
    box-shadow:0 16px 40px rgba(0,0,0,.05);
}

.vnv-media-intro-icon {
    width:56px;
    height:56px;
    min-width:56px;
    border-radius:18px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(94,198,196,.12);
    color:var(--vnv-primary);
    font-size:1.2rem;
}

.vnv-media-intro-card h4 {
    font-size:1.05rem;
    font-weight:800;
    color:var(--vnv-text-dark);
}

.vnv-media-intro-card h3 {
    color: var(--vnv-text-dark);
}

.vnv-media-intro-card p {
    color:#5d676b;
    line-height:1.7;
}

.vnv-media-mini-grid {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
}

.vnv-media-mini-card {
    background:#fff;
    border:1px solid rgba(17,24,26,.08);
    border-radius:20px;
    padding:18px;
    box-shadow:0 14px 34px rgba(0,0,0,.04);
}

.vnv-media-mini-label {
    font-size:.78rem;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:1.5px;
    color:#0f766e;
    margin-bottom:8px;
}

.vnv-media-mini-card p {
    color:#5d676b;
    font-size:.95rem;
    line-height:1.7;
}

.vnv-media-stack {
    display:grid;
    gap:22px;
}

.vnv-media-card {
    background:linear-gradient(145deg, #101516 0%, #161c1d 100%);
    border:1px solid rgba(255,255,255,.08);
    border-radius:28px;
    padding:22px;
    box-shadow:0 25px 70px rgba(0,0,0,.18);
}

.vnv-media-card-header {
    margin-bottom:16px;
}

.vnv-media-card h3 {
    color:#fff;
    font-size:1.45rem;
    line-height:1.15;
}

.vnv-media-card p {
    color:rgba(255,255,255,.72);
    line-height:1.7;
}

.vnv-media-pill {
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:8px 14px;
    border-radius:999px;
    background:rgba(94,198,196,.12);
    color:var(--vnv-primary);
    font-size:.72rem;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:1.3px;
    margin-bottom:12px;
}

.vnv-media-pill.alt {
    background:rgba(197,160,89,.14);
    color:var(--vnv-gold);
}

.vnv-embed-frame,
.vnv-audio-frame {
    overflow:hidden;
    border-radius:22px;
    background:#000;
    border:1px solid rgba(255,255,255,.06);
}

.vnv-embed-frame iframe,
.vnv-audio-frame iframe {
    width:100%;
    display:block;
}

/* INSTAGRAM */
.section-instagram-vnv {
    background:
        linear-gradient(90deg, rgba(8, 12, 13, .62), rgba(8, 12, 13, .38)),
        linear-gradient(180deg, rgba(8, 12, 13, .5), rgba(8, 12, 13, .68)),
        url("{{ path('/assets/images/faq-event-answers-hero.png') }}") center 42% / cover fixed;
    padding: 160px 0;
    position: relative;
    overflow: hidden;
}

.section-instagram-vnv::before {
    content: "";
    position: absolute;
    top: -120px;
    left: -120px;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(94,198,196,0.14) 0%, transparent 70%);
    pointer-events: none;
}

.ig-modern-card {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    background: #151a1b;
    border: 1px solid rgba(255,255,255,0.06);
    aspect-ratio: 1 / 1;
    display: block;
    transition: transform .45s ease, box-shadow .45s ease, border-color .45s ease;
}

.ig-modern-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .7s ease, opacity .4s ease;
}

.ig-modern-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.52), rgba(0,0,0,.06));
}

.ig-modern-card:hover {
    transform: translateY(-8px);
    border-color: rgba(94,198,196,0.35);
    box-shadow: 0 30px 60px rgba(0,0,0,0.35);
}

.ig-modern-card:hover img {
    transform: scale(1.06);
}

.ig-modern-badge {
    position: absolute;
    right: 18px;
    bottom: 18px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,.12);
    color: #fff;
    z-index: 2;
    backdrop-filter: blur(8px);
}

.ig-modern-caption {
    position: absolute;
    left: 18px;
    right: 70px;
    bottom: 16px;
    z-index: 2;
    color: #fff;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.35;
}

.vnv-studio-card {
    background: linear-gradient(145deg, rgba(22, 26, 27, .94) 0%, rgba(13, 15, 15, .92) 100%);
    border-radius: 30px;
    padding: 50px;
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow: 0 20px 60px rgba(0,0,0,0.35);
    backdrop-filter: blur(6px);
}

.vnv-studio-card h3 {
    font-size: 1.8rem;
    font-weight: 800;
}

.vnv-studio-card p {
    color: rgba(255,255,255,0.7);
    margin-bottom: 20px;
}

.vnv-studio-info {
    display: flex;
    gap: 12px;
    align-items: center;
    color: #fff;
    font-weight: 600;
    margin-bottom: 25px;
}

.vnv-studio-info i {
    color: var(--vnv-primary);
}

.vnv-studio-actions {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

/* PLAN */
.section-plan-vnv {
    padding: 140px 0;
    background: var(--vnv-dark-deep);
}

.plan-vnv-card {
    background: linear-gradient(145deg, #161a1b 0%, #0d0f0f 100%);
    border-radius: 45px;
    padding: 100px 80px;
    border: 1px solid var(--vnv-border);
    position: relative;
    overflow: hidden;
}

.plan-vnv-card::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 10%;
    width: 400px;
    height: 400px;
    transform: translateY(-50%);
    background: radial-gradient(circle, rgba(94, 198, 196, 0.08) 0%, transparent 70%);
    pointer-events: none;
}

.plan-vnv-card p {
    color: var(--vnv-text-muted-soft);
}

.vnv-badge-request {
    background: rgba(94, 198, 196, 0.1);
    color: var(--vnv-primary);
    padding: 10px 25px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 2px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 40px;
    text-transform: uppercase;
}

.vnv-btn-fixed {
    min-width: 240px;
    text-align: center;
    white-space: normal;
    line-height: 1.35;
    padding: 20px 28px;
}

/* TABLET */
@media (max-width: 1199px) {
