        <li>Milk / Dairy</li>
        <li>Eggs</li>
        <li>Fish</li>
        <li>Shellfish</li>
        <li>Tree Nuts</li>
        <li>Peanuts</li>
        <li>Wheat / Gluten</li>
        <li>Soy</li>
        <li>Sesame</li>
