{% extends "templates/base.twig" %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
<style>
.hero {
    background: linear-gradient(135deg, #0a0a0a, #1b1b1b);
    color: white;
    text-align: center;
    padding: 5rem 2rem;
}
.hero h1 { font-size: 2.8rem; font-weight: 700; }
.hero p { font-size: 1.2rem; margin-top: 1rem; }

.section {
    padding: 4rem 2rem;
    line-height: 1.8;
    font-size: 1rem;
}
.section h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-top: 3rem;
    margin-bottom: 1rem;
}
.section h3 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: .75rem;
}
.section ul {
    padding-left: 1.2rem;
}
.section li {
    margin-bottom: .6rem;
}
.btn-main {
    background: #28a745;
    color: white;
    padding: 0.75rem 2rem;
    font-size: 1.1rem;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    display: inline-block;
    margin-top: 2rem;
}
.note-box {
    background: #f8f9fa;
    border-left: 4px solid #28a745;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    margin: 1.5rem 0;
}
</style>
{% endblock %}

{% block body %}
<main>
  <section class="hero">
    <h1 style="color:#fff">Terms & Conditions</h1>
    <p>Last updated: March 31, 2026</p>
  </section>

  <section class="section">
    <div class="container" style="max-width: 900px; margin: auto;">

      <p>
        These Terms & Conditions ("Terms") apply to your use of <strong>Avomeal</strong>, including our website, customer dashboard, mobile application, ordering system, subscription services, meal delivery operations, and any related services we provide.
      </p>

      <p>
