<style>
.vnv-app-prompt {
    position: fixed;
    inset: 0;
    z-index: 1080;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 18px;
    background: rgba(3, 8, 9, .62);
    backdrop-filter: blur(8px);
}

.vnv-app-prompt.is-open {
    display: flex;
}

.vnv-app-prompt-card {
    width: min(100%, 520px);
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, .18);
    background:
        radial-gradient(circle at 12% 0%, rgba(94, 198, 196, .22), transparent 34%),
        radial-gradient(circle at 100% 10%, rgba(197, 160, 89, .18), transparent 30%),
        linear-gradient(145deg, #0a0f10 0%, #121a1b 100%);
    color: #fff;
    box-shadow: 0 32px 90px rgba(0, 0, 0, .38);
}

.vnv-app-prompt-body {
    padding: 30px;
}

.vnv-app-prompt-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(255, 255, 255, .16);
    border-radius: 999px;
    background: rgba(255, 255, 255, .08);
    color: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
}

.vnv-app-prompt-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    padding: 9px 13px;
    border-radius: 999px;
    background: rgba(94, 198, 196, .12);
    color: #9ff3ef;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.vnv-app-prompt h2 {
    margin: 0 0 10px;
    color: #fff;
    font-size: clamp(28px, 5vw, 40px);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.05;
}

.vnv-app-prompt p {
    margin: 0;
    color: rgba(255, 255, 255, .76);
    font-size: 15px;
    line-height: 1.7;
}

.vnv-app-prompt-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
}

.vnv-app-store-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 6px 10px;
    border-radius: 16px;
    background: rgba(255, 255, 255, .96);
    border: 1px solid rgba(255, 255, 255, .16);
    box-shadow: 0 16px 32px rgba(0, 0, 0, .18);
}

.vnv-app-store-link img {
    display: block;
    width: 150px;
    max-width: 100%;
    height: auto;
}

@media (max-width: 520px) {
    .vnv-app-prompt-body {
        padding: 26px 20px;
    }

    .vnv-app-prompt-actions,
    .vnv-app-store-link {
        width: 100%;
    }
}
</style>

<div class="vnv-app-prompt" id="vnvMobileAppPrompt" aria-hidden="true">
    <div class="vnv-app-prompt-card" role="dialog" aria-modal="true" aria-labelledby="vnvMobileAppPromptTitle">
        <button class="vnv-app-prompt-close" type="button" data-vnv-app-prompt-close aria-label="Close">&times;</button>
        <div class="vnv-app-prompt-body">
            <span class="vnv-app-prompt-kicker">
                <i class="fa-solid fa-mobile-screen-button"></i>
                Mobile app
            </span>
            <h2 id="vnvMobileAppPromptTitle">Download the VNV Events app</h2>
            <p>Manage your event, orders, payments, files, messages and music sessions from your phone.</p>
            <div class="vnv-app-prompt-actions">
                <a class="vnv-app-store-link" href="https://play.google.com/store/apps/details?id=com.vnvevents.eplannerhub" target="_blank" rel="noopener">
                    <img src="{{ asset_for('assets/images/google-play-store-badge.png') }}" alt="Get it on Google Play" width="150" height="45" loading="lazy" decoding="async">
                </a>
                <a class="vnv-app-store-link" href="https://apps.apple.com/us/app/vnv-events/id6747983836" target="_blank" rel="noopener">
                    <img src="{{ asset_for('assets/images/download-on-the-app-store-apple-logo.png') }}" alt="Download on the App Store" width="150" height="45" loading="lazy" decoding="async">
                </a>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const prompt = document.getElementById('vnvMobileAppPrompt');
    if (!prompt) return;

    const closeButtons = prompt.querySelectorAll('[data-vnv-app-prompt-close]');
    const storageKey = 'vnvMobileAppPromptSeen:' + window.location.pathname;

    const closePrompt = function () {
        prompt.classList.remove('is-open');
        prompt.setAttribute('aria-hidden', 'true');
        try { sessionStorage.setItem(storageKey, '1'); } catch (error) {}
    };

    closeButtons.forEach(function (button) {
        button.addEventListener('click', closePrompt);
    });

    prompt.addEventListener('click', function (event) {
        if (event.target === prompt) closePrompt();
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && prompt.classList.contains('is-open')) closePrompt();
    });

    let seen = false;
    try { seen = sessionStorage.getItem(storageKey) === '1'; } catch (error) {}

    if (!seen) {
        window.setTimeout(function () {
            prompt.classList.add('is-open');
            prompt.setAttribute('aria-hidden', 'false');
        }, 650);
    }
});
</script>
