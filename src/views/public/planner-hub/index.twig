{% extends "templates/base.twig" %}

{# 
    VNV EVENTS - POLISHED VERSION + SERVICES PARALLAX + INSTAGRAM SECTION
#}

{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&display=swap" rel="stylesheet">

<style>
:root {
    --vnv-primary: #5EC6C4;
    --vnv-primary-dark: #4aa8a6;
    --vnv-gold: #c5a059;
    --vnv-gold-gradient: linear-gradient(135deg, #bf953f 0%, #fcf6ba 45%, #b38728 100%);
    --vnv-dark-deep: #0a0c0c;
    --vnv-dark-soft: #161a1b;
    --vnv-dark-card: #1c2223;
    --vnv-light: #ffffff;
    --vnv-marble: #f4f7f8;
    --vnv-text-main: #2d3436;
    --vnv-text-dark: #11181a;
    --vnv-text-light: #f1f2f6;
    --vnv-text-muted: rgba(255, 255, 255, 0.72);
    --vnv-text-muted-soft: rgba(255, 255, 255, 0.62);
    --vnv-shadow-lg: 0 40px 100px rgba(0,0,0,0.18);
    --vnv-glow: 0 0 40px rgba(94, 198, 196, 0.2);
    --vnv-border: rgba(255, 255, 255, 0.06);
}

html { scroll-behavior: smooth; }

body {
    background-color: var(--vnv-dark-deep);
    color: var(--vnv-text-light);
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

h1, h2, h3, h4, .luxury-font {
    font-family: 'Playfair Display', serif;
}

.text-gold {
    background: var(--vnv-gold-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 700;
}

.text-vnv { color: var(--vnv-primary) !important; }
.text-vnv-muted { color: rgba(94, 198, 196, 0.82) !important; }
.border-vnv { border-color: var(--vnv-primary) !important; }
.letter-spacing-lg { letter-spacing: 5px; }

.vnv-btn {
    padding: 22px 50px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 3px;
    transition: all 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: 0.8rem;
    position: relative;
    z-index: 1;
    border-radius: 999px;
}

.btn-gold-vnv {
    background: var(--vnv-gold-gradient);
    color: #000 !important;
}

.btn-gold-vnv:hover {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 20px 40px rgba(197, 160, 89, 0.3);
}

.btn-outline-vnv {
    border: 2px solid var(--vnv-primary);
    color: var(--vnv-primary) !important;
    background: transparent;
}

.btn-outline-vnv:hover {
    background: var(--vnv-primary);
    color: white !important;
}

.btn-ghost-white {
    border: 1px solid rgba(255,255,255,0.2);
    color: white !important;
    background: transparent;
}

.btn-ghost-white:hover {
    background: white;
    color: black !important;
}

.section-vnv {
    padding: 160px 0;
    position: relative;
}

.section-light {
    background-color: var(--vnv-marble);
    color: var(--vnv-text-dark);
    border-radius: 140px 0 0 0;
    margin-top: -100px;
    z-index: 10;
}

.vnv-hero-master {
    min-height: 100vh;
    display: flex;
    background: #ffffff;
    position: relative;
    z-index: 1;
}

.hero-split-container {
    display: flex;
    width: 100%;
    min-height: 100vh;
}

.hero-info-pane {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 8%;
    background: white;
    z-index: 100;
}

.hero-visual-pane {
    flex: 1.3;
    position: relative;
    clip-path: polygon(15% 0, 100% 0, 100% 100%, 0% 100%);
    background: #000;
}

.hero-video-src {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.9);
}

.hero-info-pane h1 {
    font-size: clamp(3rem, 6.5vw, 5.5rem);
    font-weight: 900;
    color: #1a1f20;
    line-height: 1.08;
    margin-bottom: 35px;
}

.hero-tagline {
    color: var(--vnv-primary);
    font-weight: 800;
    letter-spacing: 4px;
    display: block;
    margin-bottom: 20px;
    text-transform: uppercase;
}

.hero-description {
    max-width: 550px;
    color: #5d6668;
}

.metric-strip-vnv {
    background: var(--vnv-dark-deep);
    padding: 100px 0;
    border-bottom: 1px solid var(--vnv-border);
}

.metric-val {
    font-size: 4.5rem;
    font-weight: 900;
    color: var(--vnv-primary);
    line-height: 1;
}

.metric-label {
    letter-spacing: 5px;
    font-weight: 700;
    opacity: 0.5;
    font-size: 0.7rem;
    margin-top: 15px;
}

/* SERVICES + PARALLAX VIDEO */
.section-services-vnv {
    background-color: var(--vnv-dark-deep);
    padding: 160px 0;
    position: relative;
    overflow: hidden;
    isolation: isolate;
}

.services-bg-video-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
}

.services-bg-video {
    width: 100%;
    height: 120%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.15;
    filter: blur(2px) saturate(0.8);
    transform: translateY(-6%);
}

.services-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to bottom,
        rgba(10,12,12,0.25),
        rgba(10,12,12,0.28),
        rgba(10,12,12,0.25)
    );
}

.vnv-service-grid-card {
    background: rgba(28, 34, 35, 0.82);
    backdrop-filter: blur(6px);
    border-radius: 28px;
    padding: 60px 45px;
    height: 100%;
    border: 1px solid rgba(197, 160, 89, 0.08);
    transition: all 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    position: relative;
    overflow: hidden;
    z-index: 2;
}

.vnv-service-grid-card:hover {
    transform: translateY(-15px);
    border-color: var(--vnv-gold);
    box-shadow: 0 40px 80px rgba(0,0,0,0.5);
}

.service-icon-box {
    width: 60px;
    height: 60px;
    background: rgba(197, 160, 89, 0.1);
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--vnv-gold);
    font-size: 1.6rem;
    margin-bottom: 35px;
}

.service-num-floating {
    position: absolute;
    top: 40px;
    right: 45px;
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem;
    font-weight: 900; 
    color: rgba(197, 160, 89, 0.48);
}

.vnv-service-grid-card h3 {
    font-size: 2rem;
    font-weight: 700;
    color: white;
    margin-bottom: 25px;
}

.vnv-service-grid-card p {
    color: var(--vnv-text-muted);
    font-size: 1.05rem;
    margin-bottom: 40px;
}

.vnv-link-gold {
    color: var(--vnv-gold) !important;
    font-weight: 800;
    letter-spacing: 2px;
    font-size: 0.85rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    transition: 0.4s;
}

.vnv-link-gold:hover {
    gap: 20px;
    color: white !important;
}

/* WHY CHOOSE US COMPOSITION */
.choose-visual-composition{
    position: relative;
    width: 560px;
    max-width: 100%;
    height: 620px;
    margin: 0 auto;
}

.choose-main-frame{
    position: absolute;
    top: 0;
    left: 0;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    overflow: hidden;
    border: 18px solid #3a3a3a;
    box-shadow: 0 40px 100px rgba(0,0,0,0.18);
    background: #fff;
}

.choose-main-frame::after{
    content: "";
    position: absolute;
    inset: 18px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.18);
    pointer-events: none;
}

.choose-img-main,
.choose-img-secondary{
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
}

.choose-secondary-frame{
    position: absolute;
    right: 0;
    bottom: 10px;
    width: 240px;
    height: 300px;
    border-radius: 34px;
    overflow: hidden;
    border: 12px solid #ffffff;
    box-shadow: 0 28px 70px rgba(0,0,0,0.18);
    background: #fff;
}

.choose-secondary-frame::before{
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.12), transparent 40%);
    pointer-events: none;
    z-index: 1;
}

.check-vnv {
    font-size: 1.8rem;
    color: var(--vnv-primary);
    margin-top: 5px;
}

.section-ophyra-vnv {
    background: var(--vnv-dark-soft);
    padding: 160px 0;
}

.ophyra-ui-console {
    background: #000;
    border-radius: 35px;
    padding: 80px;
    border: 1px solid var(--vnv-border);
    box-shadow: var(--vnv-glow);
    position: relative;
    overflow: hidden;
}

.ophyra-ui-console::before {
    content: "";
    position: absolute;
    top: -120px;
    right: -80px;
    width: 280px;
    height: 280px;
    background: radial-gradient(circle, rgba(94, 198, 196, 0.18) 0%, transparent 70%);
    pointer-events: none;
}

.section-podcast-vnv {
    background: white;
    padding: 160px 0;
    border-radius: 0 140px 0 0;
}

.podcast-glow-frame {
    background: white;
    padding: 25px;
    border: 1px solid #eee;
    box-shadow: 40px 40px 0px var(--vnv-primary);
    border-radius: 16px;
}

/* INSTAGRAM SECTION */
.section-instagram-vnv {
    background: #0d1011;
    padding: 160px 0;
    position: relative;
    overflow: hidden;
}

.section-instagram-vnv::before {
    content: "";
    position: absolute;
    top: -120px;
    left: -120px;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(94,198,196,0.14) 0%, transparent 70%);
    pointer-events: none;
}

.ig-modern-card {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    background: #151a1b;
    border: 1px solid rgba(255,255,255,0.06);
    aspect-ratio: 1 / 1;
    display: block;
    transition: transform .45s ease, box-shadow .45s ease, border-color .45s ease;
}

.ig-modern-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .7s ease, opacity .4s ease;
}

.ig-modern-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,.52), rgba(0,0,0,.06));
}

.ig-modern-card:hover {
    transform: translateY(-8px);
    border-color: rgba(94,198,196,0.35);
    box-shadow: 0 30px 60px rgba(0,0,0,0.35);
}

.ig-modern-card:hover img {
    transform: scale(1.06);
}

.ig-modern-badge {
    position: absolute;
    right: 18px;
    bottom: 18px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,.12);
    color: #fff;
    z-index: 2;
    backdrop-filter: blur(8px);
}

.ig-modern-caption {
    position: absolute;
    left: 18px;
    right: 70px;
    bottom: 16px;
    z-index: 2;
    color: #fff;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.35;
}

.section-plan-vnv {
    padding: 140px 0;
    background: var(--vnv-dark-deep);
}

.plan-vnv-card {
    background: linear-gradient(145deg, #161a1b 0%, #0d0f0f 100%);
    border-radius: 45px;
    padding: 100px 80px;
    border: 1px solid var(--vnv-border);
    position: relative;
    overflow: hidden;
}

.plan-vnv-card::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 10%;
    width: 400px;
    height: 400px;
    transform: translateY(-50%);
    background: radial-gradient(circle, rgba(94, 198, 196, 0.08) 0%, transparent 70%);
    pointer-events: none;
}

.plan-vnv-card p {
    color: var(--vnv-text-muted-soft);
}

.vnv-badge-request {
    background: rgba(94, 198, 196, 0.1);
    color: var(--vnv-primary);
    padding: 10px 25px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 2px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 40px;
    text-transform: uppercase;
}

.vnv-footer-bento {
    background: var(--vnv-dark-deep);
    padding-bottom: 80px;
}

.bento-foot-card {
    background: var(--vnv-dark-card);
    border-radius: 30px;
    padding: 60px;
    height: 100%;
    border: 1px solid var(--vnv-border);
}

.bento-foot-card p {
    color: var(--vnv-text-muted-soft);
}

.contact-line {
    display: flex;
    gap: 25px;
    margin-bottom: 30px;
    align-items: flex-start;
}

.contact-line i {
    color: var(--vnv-primary);
    font-size: 1.3rem;
    margin-top: 5px;
}

.vnv-btn-fixed{
    min-width: 240px;
    text-align: center;
    white-space: normal;
    line-height: 1.35;
    padding: 20px 28px;
}

@keyframes rotateSlow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

@media (max-width: 1199px) {
    .vnv-btn { padding: 18px 34px; }
    .ophyra-ui-console,
    .plan-vnv-card { padding: 60px 45px; }
}

@media (max-width: 991px) {
    .vnv-hero-master,
    .hero-split-container {
        flex-direction: column;
        min-height: auto;
    }

    .hero-info-pane {
        padding: 100px 30px 70px;
        text-align: center;
    }

    .hero-description {
        margin-left: auto;
        margin-right: auto;
    }

    .hero-visual-pane {
        height: 45vh;
        clip-path: none;
    }

    .choose-visual-composition{
        width: 340px;
        height: 430px;
    }

    .choose-main-frame{
        width: 300px;
        height: 300px;
        border-width: 12px;
    }

    .choose-secondary-frame{
        width: 150px;
        height: 190px;
        border-width: 8px;
        border-radius: 22px;
        right: 0;
        bottom: 0;
    }

    .plan-vnv-card,
    .ophyra-ui-console {
        padding: 50px 30px;
        text-align: center;
    }

    .section-services-vnv,
    .section-light,
    .section-podcast-vnv {
        border-radius: 0;
    }

    .podcast-glow-frame {
        box-shadow: 20px 20px 0px var(--vnv-primary);
    }

    .metric-val {
        font-size: 3rem;
    }

    .services-bg-video {
        height: 100%;
        transform: none;
        filter: blur(1px) saturate(0.8);
    }

    .vnv-btn-fixed{
        min-width: 100%;
    }
}

@media (max-width: 575px) {
    .section-vnv,
    .section-services-vnv,
    .section-ophyra-vnv,
    .section-podcast-vnv,
    .section-instagram-vnv,
    .section-plan-vnv {
        padding: 100px 0;
    }

    .hero-info-pane h1 {
        font-size: 2.7rem;
    }

    .vnv-btn {
        width: 100%;
        padding: 18px 24px;
        letter-spacing: 2px;
    }

    .vnv-service-grid-card,
    .bento-foot-card {
        padding: 40px 28px;
    }

    .service-num-floating {
        top: 24px;
        right: 24px;
        font-size: 2rem;
    }

    .ig-modern-caption {
        font-size: 0.82rem;
        left: 14px;
        right: 62px;
        bottom: 14px;
    }

    .ig-modern-badge {
        right: 14px;
        bottom: 14px;
        width: 40px;
        height: 40px;
    }

    .vnv-app-download-panel{
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-left: 20px;
}

.vnv-app-download-eyebrow{
    display: inline-block;
    margin-bottom: 14px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 3px;
    color: var(--vnv-primary);
    text-transform: uppercase;
}

.vnv-app-download-panel h3{
    color: #fff;
    font-size: clamp(2rem, 2.8vw, 3rem);
    line-height: 1.05;
    margin: 0 0 14px;
}

.vnv-app-download-panel p{
    max-width: 420px;
    color: rgba(255,255,255,0.68);
    margin: 0 0 24px;
    font-size: 1.02rem;
}

.vnv-app-download-badges{
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    max-width: 320px;
}

.vnv-app-download-badges a{
    display: block;
    transition: transform .25s ease, opacity .25s ease;
}

.vnv-app-download-badges a:hover{
    transform: translateY(-2px);
    opacity: .96;
}

.vnv-app-download-badges img{
    width: 100%;
    height: auto;
    display: block;
    border-radius: 14px;
}

.vnv-app-download-links{
    margin-top: 24px;
}


}


.vnv-app-download-panel{
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-left: 24px;
}

.vnv-app-download-eyebrow{
    display: inline-block;
    margin-bottom: 14px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 3px;
    color: var(--vnv-primary);
    text-transform: uppercase;
}

.vnv-app-download-panel h3{
    color: #fff;
    font-size: clamp(2rem, 2.8vw, 3rem);
    line-height: 1.05;
    margin: 0 0 14px;
}

.vnv-app-download-panel p{
    max-width: 420px;
    color: rgba(255,255,255,0.68);
    margin: 0 0 24px;
    font-size: 1.02rem;
}

.vnv-app-download-badges{
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 280px;
    max-width: 280px;
}

.vnv-app-download-badges a{
    display: block;
    transition: transform .25s ease, opacity .25s ease;
}

.vnv-app-download-badges a:hover{
    transform: translateY(-2px);
    opacity: .96;
}

.vnv-app-download-badges img{
    width: 100%;
    height: auto;
    display: block;
    border-radius: 18px;
}

@media (max-width: 991px){
    .vnv-app-download-panel{
    padding-left: 0;
    margin-top: 34px;
    align-items: center;
    text-align: center;
    }

    .vnv-app-download-panel p{
        max-width: 100%;
    }

    .vnv-app-download-badges{
        max-width: 320px;
    }
}


.vnv-studio-card{
    background: linear-gradient(145deg, #161a1b 0%, #0d0f0f 100%);
    border-radius: 30px;
    padding: 50px;
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow: 0 20px 60px rgba(0,0,0,0.35);
}

.vnv-studio-card h3{
    font-size: 1.8rem;
    font-weight: 800;
}

.vnv-studio-card p{
    color: rgba(255,255,255,0.7);
    margin-bottom: 20px;
}

.vnv-studio-info{
    display: flex;
    gap: 12px;
    align-items: center;
    color: #fff;
    font-weight: 600;
    margin-bottom: 25px;
}

.vnv-studio-info i{
    color: var(--vnv-primary);
}

.vnv-studio-actions{
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

</style>
{% endblock %}

{% block body %}

{% include "templates/layout/publicHeaderVnv.html.twig" %}

<section class="vnv-hero-master">
    <div class="hero-split-container">
        <div class="hero-info-pane animate__animated animate__fadeIn">
            <span class="hero-tagline"><br>VNV EVENTS</span>
            <h1>Full-Service Luxury Event Planning & <span class="text-gold">Catering Studio in South Florida</span></h1>
            <p class="fs-5 mb-5 hero-description">
               From Luxurious weddings to high-end corporate events
            </p>
            <div class="d-flex flex-wrap gap-4 justify-content-center justify-content-lg-start">
                <a href="tel:+13052045427" class="vnv-btn btn-gold-vnv">CALL (305) 204-5427</a>
                <a href="#services" class="vnv-btn btn-outline-vnv">Our Services</a>
            </div><br><br>
        </div>

        <div class="hero-visual-pane">
            <video class="hero-video-src" autoplay muted loop playsinline preload="auto">
                <source src="{{ asset_for('assets/video/intro_vnv.mp4') }}" type="video/mp4">
            </video>
        </div>
    </div>
</section>

<section class="metric-strip-vnv text-center">
    <div class="container">
        <div class="row g-5">
            <div class="col-6 col-lg-3">
                <h3 class="metric-val">5+</h3>
                <p class="metric-label">YEARS OF EXPERIENCE</p>
            </div>
            <div class="col-6 col-lg-3">
