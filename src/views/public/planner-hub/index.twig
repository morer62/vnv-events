{% extends "templates/base.twig" %}

{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

<style>
:root{
    --av-primary:#8fbc2e;
    --av-primary-dark:#6a9616;
    --av-accent:#f59e0b;
    --av-accent-dark:#d97706;
    --av-cream:#fffdf3;
    --av-soft:#f7f6ea;
    --av-soft-2:#f2f0dd;
    --av-text:#223018;
    --av-muted:#657255;
    --av-border:#dfe6bf;
    --av-shadow:0 18px 44px rgba(66,84,25,.12);
    --av-shadow-strong:0 24px 58px rgba(54,70,18,.18);
    --av-dark:#17210f;
}

body{
    background:linear-gradient(180deg,#fffef8 0%, #f8f7ec 100%);
    color:var(--av-text);
}

.section{
    padding:5rem 0;
    position:relative;
}

.section-alt{
    background:linear-gradient(180deg,#f9f7ea 0%, #f3f1dd 100%);
}

.container-narrow{
    max-width:1180px;
    margin:0 auto;
    padding:0 1rem;
}

.badge-pill{
    display:inline-flex;
    align-items:center;
    gap:.5rem;
    padding:.55rem .95rem;
    border-radius:999px;
    font-weight:800;
    font-size:.92rem;
    border:1px solid rgba(255,255,255,.18);
    backdrop-filter:blur(8px);
}

.badge-light{
    background:rgba(255,255,255,.16);
    color:#fff;
}

.g-title{
    font-size:clamp(2rem,4vw,3.25rem);
    line-height:1.06;
    font-weight:900;
    color:var(--av-dark);
    letter-spacing:-1px;
    margin-bottom:1rem;
}

.g-title .highlight{
    color:var(--av-primary-dark);
}

.g-subtitle{
    max-width:850px;
    margin:0 auto;
    color:var(--av-muted);
    font-size:1.07rem;
    line-height:1.8;
}

.btn-main{
    background:linear-gradient(135deg,var(--av-accent),#ffb11f);
    color:#2a2007 !important;
    padding:1rem 1.45rem;
    border-radius:999px;
    text-decoration:none;
    font-weight:900;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:.6rem;
    border:none;
    box-shadow:0 16px 34px rgba(245,158,11,.28);
    transition:all .22s ease;
}

.btn-main:hover{
    transform:translateY(-2px);
    color:#2a2007 !important;
}

.btn-glass{
    background:rgba(255,255,255,.10);
    color:#fff !important;
    padding:1rem 1.35rem;
    border-radius:999px;
    text-decoration:none;
    font-weight:800;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:.55rem;
    border:1px solid rgba(255,255,255,.18);
    backdrop-filter:blur(8px);
    transition:all .22s ease;
}

.btn-glass:hover{
    transform:translateY(-2px);
    color:#fff !important;
}

.btn-soft{
    background:#fff;
    color:var(--av-dark) !important;
    padding:1rem 1.35rem;
    border-radius:999px;
    text-decoration:none;
    font-weight:800;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:.55rem;
    border:1px solid #e8eacb;
    box-shadow:0 10px 26px rgba(76,95,31,.08);
}

.hero{
    min-height:100vh;
    position:relative;
    overflow:hidden;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#fff;
    text-align:center;
    background:#19220f;
}

.hero-video-bg{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    object-fit:cover;
    z-index:0;
}

.hero-overlay{
    position:absolute;
    inset:0;
    background:
        linear-gradient(180deg, rgba(10,16,7,.45) 0%, rgba(14,22,8,.56) 40%, rgba(18,24,10,.70) 100%),
        radial-gradient(circle at 20% 20%, rgba(146,188,46,.22), transparent 28%),
        radial-gradient(circle at 80% 25%, rgba(245,158,11,.18), transparent 24%);
    z-index:1;
}

.hero-content{
    position:relative;
    z-index:3;
    width:100%;
    max-width:1260px;
    padding:2.3rem 1rem 4rem;
}

.hero-logo{
    max-width:235px;
    width:100%;
    filter:drop-shadow(0 8px 22px rgba(0,0,0,.22));
}

.hero h1{
    font-size:clamp(2.5rem,5.6vw,5.1rem);
    line-height:1.02;
    letter-spacing:-1.2px;
    font-weight:900;
    margin:1rem auto 1rem;
    max-width:980px;
    text-shadow:0 12px 30px rgba(0,0,0,.25);
}

.hero h1 .warm{
    color:#d8f372;
}

.hero-lead{
    max-width:900px;
    margin:0 auto;
    font-size:1.14rem;
    line-height:1.85;
    color:#f2f8df;
    text-shadow:0 2px 10px rgba(0,0,0,.18);
}

.hero-cta-row{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:.9rem;
    margin-top:2rem;
}

.hero-micro{
    margin-top:1rem;
    color:#eef7d3;
    font-size:.96rem;
}

.hero-mini-grid{
    margin-top:2.2rem;
}

.hero-mini-card{
    background:rgba(255,255,255,.10);
    border:1px solid rgba(255,255,255,.14);
    border-radius:22px;
    padding:1.15rem 1rem;
    text-align:left;
    height:100%;
    backdrop-filter:blur(7px);
    box-shadow:0 14px 34px rgba(0,0,0,.16);
}

.hero-mini-card i{
    color:#d8f372;
    font-size:1.3rem;
    margin-bottom:.7rem;
}

.hero-mini-card strong{
    display:block;
    color:#fff;
    margin-bottom:.25rem;
    font-size:1rem;
}

.hero-mini-card span{
    color:#f3f8e5;
    line-height:1.6;
    font-size:.95rem;
}

.mascot-hero-left{
    position:absolute;
    left:0;
    bottom:0;
    width:min(27vw, 310px);
    z-index:2;
    pointer-events:none;
    filter:drop-shadow(0 16px 32px rgba(0,0,0,.20));
}

.mascot-hero-right{
    position:absolute;
    right:0;
    bottom:0;
    width:min(34vw, 400px);
    z-index:2;
    pointer-events:none;
    filter:drop-shadow(0 18px 34px rgba(0,0,0,.20));
}

.value-ribbon{
    margin-top:-2.2rem;
    position:relative;
    z-index:5;
}

.value-grid{
    background:#fff;
    border:1px solid #e7ebca;
    border-radius:28px;
    box-shadow:var(--av-shadow);
    overflow:hidden;
}

.value-box{
    padding:1.35rem 1rem;
    text-align:center;
    height:100%;
    background:linear-gradient(180deg,#fffef7 0%, #f9f8ee 100%);
    border-right:1px solid #edf0d9;
}

.value-box:last-child{
    border-right:none;
}

.value-box strong{
    display:block;
    font-size:1.55rem;
    color:var(--av-primary-dark);
    margin-bottom:.2rem;
    font-weight:900;
}

.value-box span{
    color:var(--av-muted);
    line-height:1.55;
    font-weight:700;
}

.story-card{
    background:#fff;
    border:1px solid #e6ebc8;
    border-radius:28px;
    box-shadow:var(--av-shadow);
    padding:2rem 1.5rem;
    position:relative;
    overflow:hidden;
}

.story-points{
    display:grid;
    gap:1rem;
    margin-top:1.4rem;
}

.story-point{
    display:flex;
    gap:.85rem;
    align-items:flex-start;
    padding:1rem 1rem;
    border:1px solid #edf0da;
    border-radius:18px;
    background:linear-gradient(180deg,#fffef8 0%, #faf9f0 100%);
}

.story-point i{
    color:var(--av-primary-dark);
    font-size:1rem;
    margin-top:.2rem;
}

.story-point strong{
    display:block;
    color:var(--av-dark);
    margin-bottom:.18rem;
}

.story-point span{
    color:var(--av-muted);
    line-height:1.65;
}

.plan-card{
    display:flex;
    flex-direction:column;
    height:100%;
    background:#fff;
    border:2px solid #dfe6bf;
    border-radius:30px;
    overflow:hidden;
    box-shadow:var(--av-shadow);
    position:relative;
}

.plan-card.featured{
    border-color:var(--av-primary);
    transform:translateY(-6px);
    box-shadow:var(--av-shadow-strong);
}

.plan-head{
    background:linear-gradient(180deg,#fbf8d9 0%, #f2efc7 100%);
    padding:1.5rem 1.5rem 1.35rem;
    border-bottom:1px solid #e7ebc8;
}

.plan-head .label{
    display:inline-flex;
    align-items:center;
    padding:.45rem .8rem;
    border-radius:999px;
    background:#fff;
    color:var(--av-primary-dark);
    font-size:.84rem;
    font-weight:900;
    border:1px solid #dde8ab;
    margin-bottom:.9rem;
}

.plan-head h3{
    font-size:1.1rem;
    font-weight:900;
    color:var(--av-dark);
    margin-bottom:.5rem;
}

.plan-head p{
    margin:0;
    color:var(--av-muted);
    line-height:1.7;
    font-size:.96rem;
}

.plan-body{
    display:flex;
    flex-direction:column;
    padding:1.6rem 1.5rem 1.8rem;
    flex:1;
    min-height:480px;
    position:relative;
}

.plan-price{
    font-size:3rem;
    font-weight:900;
    color:var(--av-primary-dark);
    line-height:1;
    margin-bottom:.5rem;
}

.plan-price small{
    font-size:1rem;
    color:var(--av-muted);
    font-weight:800;
}

.plan-note{
    color:var(--av-muted);
    line-height:1.7;
    margin-bottom:1rem;
    font-size:1.02rem;
}

.plan-list{
    list-style:none;
    padding:0;
    margin:0 0 1.2rem;
    display:grid;
    gap:.7rem;
}

.plan-list li{
    padding:.85rem 0;
    border-bottom:1px dashed #dce6b4;
    color:#45543b;
    font-size:1.02rem;
    line-height:1.55;
}

.plan-list li::before{
    content:"✓";
    color:#22a64f;
    font-weight:900;
    margin-right:.8rem;
}

.plan-card .btn-main,
.plan-card .btn-soft{
    margin-top:auto;
    width:100%;
    justify-content:center;
    text-align:center;
    min-height:58px;
}

.mascot-card-large{
    position:absolute;
    right:18px;
    bottom:16px;
    width:110px;
    opacity:.96;
    pointer-events:none;
}

.mascot-side-left{
    position:absolute;
    left:-18px;
    bottom:-18px;
    width:170px;
    opacity:.96;
    pointer-events:none;
}

.mascot-side-right{
    position:absolute;
    right:-22px;
    top:-18px;
    width:150px;
    opacity:.95;
    pointer-events:none;
}

.feature-grid{
    margin-top:2rem;
}

.feature-card{
    height:100%;
    background:#fff;
    border:1px solid #e4eac2;
    border-radius:24px;
    padding:1.4rem 1.2rem;
    box-shadow:0 12px 28px rgba(76,95,31,.08);
}

.feature-card i{
    width:52px;
    height:52px;
    border-radius:16px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(135deg,#edf7c8,#fff0cf);
    color:var(--av-primary-dark);
    font-size:1.2rem;
    margin-bottom:.95rem;
}

.feature-card h4{
    font-size:1.08rem;
    font-weight:900;
    color:var(--av-dark);
    margin-bottom:.45rem;
}

.feature-card p{
    margin:0;
    color:var(--av-muted);
    line-height:1.75;
}

.cta-shell{
    position:relative;
    background:linear-gradient(135deg,#213112 0%, #2a4014 48%, #435f15 100%);
    border-radius:32px;
    padding:3rem 1.3rem;
    color:#fff;
    overflow:hidden;
    box-shadow:0 26px 60px rgba(38,54,13,.22);
}

.cta-shell h2{
    color:#fff;
    margin-bottom:1rem;
}

.cta-shell p{
    max-width:780px;
    margin:0 auto 1.3rem;
    color:#eef7d5;
    line-height:1.85;
    font-size:1.06rem;
}

.cta-mascot-left{
    position:absolute;
    left:24px;
    bottom:-6px;
    width:180px;
    opacity:.97;
    pointer-events:none;
}

.cta-mascot-right{
    position:absolute;
    right:18px;
    top:18px;
    width:135px;
    opacity:.95;
    pointer-events:none;
}

.footer-link-row{
    display:flex;
    flex-wrap:wrap;
    gap:.8rem;
    justify-content:center;
    align-items:center;
    margin-top:1.4rem;
}

.spm-popup{
    position:fixed;
    right:18px;
    bottom:18px;
    width:min(420px, calc(100vw - 22px));
    z-index:99;
    background:linear-gradient(180deg,#fffef8 0%, #fbfaef 100%);
    border:1px solid #e4e8c4;
    border-radius:24px;
    box-shadow:0 24px 54px rgba(56,73,18,.18);
    overflow:hidden;
}

.spm-popup.hidden{
    display:none;
}

.spm-top{
    padding:1rem 1rem .9rem;
    background:linear-gradient(180deg,#f7f6d5 0%, #f1efc5 100%);
    border-bottom:1px solid #e8ebca;
}

.spm-top h4{
    margin:0;
    font-size:1.1rem;
    font-weight:900;
    color:var(--av-dark);
}

.spm-body{
    padding:1rem;
}

.spm-body p{
    color:var(--av-muted);
    line-height:1.7;
    margin-bottom:.9rem;
}

.spm-chips{
    display:flex;
    flex-wrap:wrap;
    gap:.45rem;
    margin-bottom:.95rem;
}

.spm-chip{
    display:inline-flex;
    align-items:center;
    padding:.45rem .72rem;
    border-radius:999px;
    background:#fff;
    border:1px solid #e2e8bf;
    color:var(--av-primary-dark);
    font-size:.83rem;
    font-weight:900;
}

.spm-actions{
    display:flex;
    gap:.65rem;
    flex-wrap:wrap;
}

.spm-close{
    position:absolute;
    top:10px;
    right:12px;
    width:34px;
    height:34px;
    border:none;
    border-radius:50%;
    background:#fff;
    color:#56604b;
    font-size:1rem;
    box-shadow:0 8px 18px rgba(0,0,0,.08);
}

@media (max-width: 1199px){
    .mascot-hero-left{
        width:min(23vw,240px);
    }

    .mascot-hero-right{
        width:min(28vw,300px);
    }
}

@media (max-width: 991px){
    .hero{
        min-height:auto;
        padding:6rem 0 4rem;
    }

    .mascot-hero-left,
    .mascot-hero-right{
        display:none;
    }

    .value-box{
        border-right:none;
        border-bottom:1px solid #edf0d9;
    }

    .value-box:last-child{
        border-bottom:none;
    }

    .plan-card.featured{
        transform:none;
    }

    .plan-body{
        min-height:auto;
    }

    .mascot-side-left,
    .mascot-side-right,
    .cta-mascot-left,
    .cta-mascot-right{
        display:none;
    }
}

@media (max-width: 768px){
    .section{
        padding:4rem 0;
    }

    .hero-content{
        padding:1.8rem 1rem 3rem;
    }

    .hero h1{
        font-size:2.4rem;
    }

    .hero-lead{
        font-size:1rem;
    }

    .hero-cta-row{
        flex-direction:column;
    }

    .hero-cta-row .btn-main,
    .hero-cta-row .btn-glass,
    .footer-link-row .btn-main,
    .footer-link-row .btn-glass{
        width:100%;
    }

    .plan-card .btn-main,
    .plan-card .btn-soft{
        width:100%;
        white-space:normal;
        line-height:1.3;
        padding:1rem 1rem;
    }

    .spm-popup{
        right:10px;
        left:10px;
        width:auto;
        bottom:10px;
    }
}

@media (max-width: 768px){
    footer .container-narrow > div{
        flex-direction:column;
        text-align:center;
    }
}


.wellness-shell{
    position:relative;
    background:linear-gradient(135deg,#fffef7 0%, #f7f5e7 48%, #eef4d7 100%);
    border:1px solid #e2e8c3;
    border-radius:36px;
    padding:2.8rem 2.2rem;
    overflow:hidden;
    box-shadow:var(--av-shadow);
}

.wellness-badge{
    display:inline-flex;
    align-items:center;
    gap:.5rem;
    padding:.55rem .95rem;
    border-radius:999px;
    background:#fff;
    color:var(--av-primary-dark);
    border:1px solid #dfe6bf;
    font-size:.9rem;
    font-weight:900;
    margin-bottom:1rem;
}

.wellness-shell h3{
    font-size:clamp(2rem,3.5vw,3rem);
    line-height:1.08;
    font-weight:900;
    color:var(--av-dark);
    letter-spacing:-1px;
    margin-bottom:1rem;
    max-width:720px;
}

.wellness-shell p{
    color:var(--av-muted);
    line-height:1.9;
    font-size:1.06rem;
    margin-bottom:1.2rem;
    max-width:760px;
}

.wellness-list{
    list-style:none;
    padding:0;
    margin:1.3rem 0 1.6rem;
    display:grid;
    gap:.9rem;
    max-width:760px;
}

.wellness-list li{
    display:flex;
    gap:.8rem;
    align-items:flex-start;
    color:var(--av-text);
    font-weight:700;
    line-height:1.7;
    background:rgba(255,255,255,.78);
    border:1px solid #e4eac5;
    padding:1rem 1rem;
    border-radius:18px;
    box-shadow:0 10px 24px rgba(76,95,31,.06);
}

.wellness-list li i{
    color:var(--av-primary-dark);
    margin-top:.2rem;
    font-size:1rem;
}

.wellness-side-card{
    position:relative;
    background:linear-gradient(180deg,#ffffff 0%, #f8f7ee 100%);
    border:1px solid #e4eac5;
    border-radius:28px;
    padding:1.4rem 1.2rem;
    box-shadow:0 14px 30px rgba(76,95,31,.08);
    height:100%;
    z-index:2;
}

.wellness-side-card i{
    width:54px;
    height:54px;
    border-radius:16px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:linear-gradient(135deg,#edf7c8,#fff0cf);
    color:var(--av-primary-dark);
    font-size:1.2rem;
    margin-bottom:.9rem;
}

.wellness-side-card h4{
    font-size:1.08rem;
    font-weight:900;
    color:var(--av-dark);
    margin-bottom:.45rem;
}

.wellness-side-card p{
    margin:0;
    color:var(--av-muted);
    line-height:1.75;
    font-size:.98rem;
}

.wellness-mascot{
    position:absolute;
    right:-20px;
    bottom:-18px;
    width:min(34vw, 420px);
    max-width:420px;
    z-index:1;
    pointer-events:none;
    opacity:.98;
    filter:drop-shadow(0 18px 36px rgba(56,73,18,.16));
}

.wellness-glow{
    position:absolute;
    right:40px;
    bottom:20px;
    width:300px;
    height:300px;
    border-radius:50%;
    background:radial-gradient(circle, rgba(143,188,46,.18) 0%, rgba(143,188,46,0) 70%);
    z-index:0;
    pointer-events:none;
}

@media (max-width: 991px){
    .wellness-shell{
        padding:2rem 1.3rem 2.2rem;
    }

    .wellness-mascot{
        position:relative;
        right:auto;
        bottom:auto;
        display:block;
        width:min(78vw, 340px);
        margin:1.5rem auto 0;
    }

    .wellness-glow{
        display:none;
    }

    .wellness-shell h3,
    .wellness-shell p,
    .wellness-list{
        max-width:none;
    }
}


