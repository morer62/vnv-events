{% extends "templates/base.twig" %}

{% set show_whatsapp = true %}

{% block head %}
<style>
.card {
    border: 1px solid #e9ecef;
    border-radius: 12px;
}

.form-control {
    border-radius: 8px;
    border: 1px solid #dee2e6;
}

.btn {
    border-radius: 8px;
}

.divider {
    text-align: center;
    margin: 12px 0;
    position: relative;
}

.divider::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: #e9ecef;
}

.divider span {
    background: white;
    padding: 0 8px;
    color: #6c757d;
    font-size: 14px;
}

.input-group .form-control {
    border-right: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

.input-group .btn {
    border-left: 0;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    border-color: #dee2e6;
}

.input-group .btn:hover {
    background-color: #e9ecef;
    border-color: #ced4da;
}

.input-group .btn:focus {
    box-shadow: none;
}

[data-feather] {
    width: 18px;
    height: 18px;
}

#togglePassword {
    min-width: 45px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.mb-3 {
    margin-bottom: .8rem !important;
}

.mb-4 {
    margin-bottom: 1rem !important;
}
</style>
{% endblock %}

{% block body %}
<main class="bg-light d-flex justify-content-center align-items-center min-vh-100 flex-column">

                
                <!-- Header Section -->
                <div class="text-center mb-4">
                    <a href="{{ path('planner-hub') }}" class="d-inline-block mb-3">
                        <img src="{{ asset_for('assets/images/planner-hub-logo-negative.png') }}" width="180px" alt="E-Planner Hub">
                    </a>
                    <h4 class="fw-normal text-dark mb-2">Sign in to your account to continue</h4>
                    <p class="text-muted small mb-0">
                        Need Help? 
                        <a href="{{ path('support') }}" class="text-decoration-none">Go to Support Center</a>
                    </p>
                </div>

                <!-- Login Card -->
                <div class="card shadow-sm bg-white" style="min-width: 30dvw;">
                    <div class="card-body p-4">

                        <section class="d-flex flex-row gap-4">
                            <!-- Google Login Button -->
                         <!--   <div class="text-center mb-3" style="width: 50%">
                                <a href="{{ googleAuthUrl }}" class="btn btn-outline-primary w-100 py-3 d-flex align-items-center justify-content-center">
                                    <img src="{{ asset_for('assets/images/google-icon.svg') }}" style="width:18px;margin-right:10px;" alt="Google">
                                    Google
                                </a>
                            </div>

                            <div class="text-center mb-3" style="width: 50%">
                                <a href="{{ apple_url }}" class="btn btn-outline-secondary w-100 py-3 mb-3 d-flex align-items-center justify-content-center">
                                    <img src="{{ asset_for('assets/images/apple-icon.svg') }}" style="width:20px;margin-right:10px;" alt="Apple">
                                    Apple
                                </a>
                            </div> -->

                        </section>
                        <!-- Divider -->
                       <!-- <div class="divider">
                            <span>or</span>
                        </div> -->

                        <!-- Login Form -->
                        <form method="post">
                            <div class="mb-3">
                                <label class="form-label fw-medium">Email</label>
                                <input class="form-control form-control-lg" 
                                       type="email" 
                                       name="email" 
                                       placeholder="Enter your email" 
                                       required/>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label fw-medium">Password</label>
                                <div class="input-group">
                                    <input class="form-control form-control-lg" 
                                           type="password" 
                                           name="password" 
                                           id="password"
                                           placeholder="Enter your password" 
                                           required/>
                                    <button class="btn btn-outline-secondary" 
                                            type="button" 
                                            id="togglePassword">
                                        <i data-feather="eye" id="eyeIcon"></i>
                                    </button>
                                </div>
                            </div>

                           

                            
                            
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input id="customControlInline" 
                                           type="checkbox" 
                                           class="form-check-input" 
                                           value="remember-me" 
                                           name="remember-me" 
                                           checked>
                                    <label class="form-check-label small" for="customControlInline">
                                        Remember me
                                    </label>
                                </div>
                                <a href="{{ path('forgot_password') }}" class="text-decoration-none small text-muted">
                                    Forgot Password?
                                </a>
                            </div>
                            
                            <div class="d-grid">
                                <button type="submit" class="btn btn-dark btn-lg py-3">Sign in</button>
                            </div>
                        </form>
                        
                    </div>
                </div>

                <!-- Sign Up Link -->
                <div class="text-center mt-4">
                    <p class="text-muted small mb-0">
                        Don't have an account? 
                        <a href="{{ path('signup?level=5') }}" class="text-decoration-none fw-medium">Sign up</a> - 

                         <a href="{{ path('terms_and_conditions') }}" class="text-decoration-none small ">
                                   Privacy Policy
                                </a>
                    </p>
                </div>
</main>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const togglePassword = document.getElementById('togglePassword');
    const password = document.getElementById('password');
    const eyeIcon = document.getElementById('eyeIcon');

    togglePassword.addEventListener('click', function() {
        const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
        password.setAttribute('type', type);
        
        console.log('Password type changed to:', type);
        console.log('Current eye icon:', eyeIcon.getAttribute('data-feather'));
        
        if (type === 'text') {
            eyeIcon.setAttribute('data-feather', 'eye-off');
            console.log('Changed to eye-off');
        } else {
            eyeIcon.setAttribute('data-feather', 'eye');
            console.log('Changed to eye');
        }
        
        if (typeof feather !== 'undefined') {
            feather.replace();
            console.log('Feather icons replaced');
        } else {
            console.log('Feather not available');
        }
    });
});
</script>

{% endblock %}