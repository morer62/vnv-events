{% extends "templates/base.twig" %}

{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&display=swap" rel="stylesheet">

<style>
:root {
    --vnv-primary: #5EC6C4;
    --vnv-primary-dark: #4aa8a6;
    --vnv-gold: #c5a059;
    --vnv-gold-gradient: linear-gradient(135deg, #bf953f 0%, #fcf6ba 45%, #b38728 100%);
    --vnv-dark-deep: #0a0c0c;
    --vnv-dark-soft: #141818;
    --vnv-dark-card: #1b2021;
    --vnv-light: #ffffff;
    --vnv-marble: #f4f7f8;
    --vnv-text-main: #2d3436;
    --vnv-text-dark: #11181a;
    --vnv-text-light: #f3f5f6;
    --vnv-text-muted: rgba(255,255,255,.74);
    --vnv-text-muted-soft: rgba(255,255,255,.60);
    --vnv-border: rgba(255,255,255,.08);
}

html { scroll-behavior: smooth; }

body {
    background: var(--vnv-dark-deep);
    color: var(--vnv-text-light);
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

h1, h2, h3, h4, h5, .luxury-font {
    font-family: 'Playfair Display', serif;
}

.text-vnv { color: var(--vnv-primary) !important; }
.text-gold {
    background: var(--vnv-gold-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.letter-spacing-lg { letter-spacing: 4px; }

.vnv-btn {
    padding: 18px 30px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: all .35s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: .78rem;
    border-radius: 999px;
}

.btn-gold-vnv {
    background: var(--vnv-gold-gradient);
    color: #000 !important;
}
.btn-gold-vnv:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 40px rgba(197,160,89,.22);
}
.btn-outline-vnv {
    border: 2px solid var(--vnv-primary);
    color: var(--vnv-primary) !important;
    background: transparent;
}
.btn-outline-vnv:hover {
    background: var(--vnv-primary);
    color: #fff !important;
}
.btn-ghost-white {
    border: 1px solid rgba(255,255,255,.18);
    color: #fff !important;
    background: transparent;
}
.btn-ghost-white:hover {
    background: #fff;
    color: #000 !important;
}

.section-vnv {
    padding: 120px 0;
    position: relative;
}

.vnv-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(94,198,196,.1);
    color: var(--vnv-primary);
    font-size: .74rem;
    letter-spacing: 2px;
    font-weight: 800;
    text-transform: uppercase;
}

.hero-media {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
        linear-gradient(90deg, rgba(10,12,12,.88) 0%, rgba(10,12,12,.68) 42%, rgba(10,12,12,.42) 100%),
        url('{{ asset_for('assets/images/media1.jpg') }}') center/cover no-repeat;
}

.hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at top right, rgba(94,198,196,.16), transparent 28%),
        radial-gradient(circle at bottom left, rgba(197,160,89,.10), transparent 24%);
    pointer-events: none;
}

.hero-media-inner {
    position: relative;
    z-index: 2;
    width: 100%;
}

.hero-media h1 {
    font-size: clamp(3rem, 6vw, 5.4rem);
    line-height: 1.02;
    margin: 20px 0 24px;
    max-width: 940px;
}

.hero-media p.hero-copy {
    font-size: 1.1rem;
    color: var(--vnv-text-muted);
    max-width: 640px;
    margin-bottom: 28px;
}

.hero-services-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 30px;
}
.hero-services-row span {
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,.18);
    font-size: .74rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: rgba(255,255,255,.8);
}

.hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 20px;
}

/* Trust stats bar */
.trust-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 44px;
    margin-top: 42px;
}
.trust-stat .num {
    font-family: 'Playfair Display', serif;
    font-size: 2.4rem;
    font-weight: 900;
    line-height: 1;
    background: var(--vnv-gold-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.trust-stat .label {
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--vnv-text-muted-soft);
    margin-top: 4px;
}

.section-white {
    background: var(--vnv-marble);
    color: var(--vnv-text-dark);
}

.section-dark {
    background: var(--vnv-dark-deep);
    color: var(--vnv-text-light);
}

.section-heading {
    max-width: 920px;
    margin-bottom: 55px;
}
.section-heading h2 {
    font-size: clamp(2.2rem, 4vw, 4.2rem);
    line-height: 1.04;
    margin: 16px 0 18px;
}
.section-heading p {
    font-size: 1.05rem;
    margin: 0;
}
.section-white .section-heading p {
    color: #566164;
}
.section-dark .section-heading p {
    color: var(--vnv-text-muted);
}

.intro-wrap {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 40px;
    align-items: center;
}

.intro-image-card {
    border-radius: 30px;
    overflow: hidden;
    box-shadow: 0 25px 70px rgba(0,0,0,.10);
    border: 1px solid rgba(17,24,26,.08);
    background: #fff;
}

.intro-image-card img {
    width: 100%;
    min-height: 420px;
    object-fit: cover;
    display: block;
}

.intro-panel {
    background: #fff;
    border: 1px solid rgba(17,24,26,.08);
    border-radius: 30px;
    padding: 40px;
    box-shadow: 0 25px 70px rgba(0,0,0,.08);
}

.intro-panel h3 {
    font-size: 2rem;
    color: var(--vnv-text-dark);
    margin-bottom: 20px;
}

.intro-panel p,
.intro-panel li {
    color: #4f5b5f;
}

.intro-panel ul {
    list-style: none;
    padding: 0;
    margin: 25px 0 0;
}
.intro-panel ul li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 10px;
}
.intro-panel ul li::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vnv-gold);
    position: absolute;
    left: 0;
    top: 12px;
}

.trust-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px solid rgba(17,24,26,.08);
}
.trust-strip span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: .8rem;
    color: #566164;
}
.trust-strip i { color: var(--vnv-primary-dark); }

.services-bg-video-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
}

.services-bg-video {
    width: 100%;
    height: 120%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.12;
    filter: blur(2px) saturate(0.8);
    transform: translateY(-6%);
}

.services-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to bottom,
        rgba(10,12,12,0.25),
        rgba(10,12,12,0.30),
        rgba(10,12,12,0.25)
    );
}

.service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.service-card {
    background: rgba(28, 34, 35, 0.82);
    backdrop-filter: blur(6px);
    border-radius: 28px;
    padding: 42px 34px;
    border: 1px solid rgba(197, 160, 89, 0.08);
    height: 100%;
    position: relative;
    z-index: 2;
    transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
}
.service-card:hover {
    transform: translateY(-8px);
    border-color: var(--vnv-gold);
}

.service-card h3 {
    color: #fff;
    font-size: 1.6rem;
    margin-bottom: 14px;
}
.service-card p,
.service-card li {
    color: var(--vnv-text-muted);
}

.service-icon-box {
    width: 60px;
    height: 60px;
    background: rgba(197, 160, 89, 0.1);
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--vnv-gold);
    font-size: 1.6rem;
    margin-bottom: 24px;
}

.photobooth-wrap {
    display: grid;
    grid-template-columns: .95fr 1.05fr;
    gap: 40px;
    align-items: stretch;
}

.photobooth-image-stack {
    display: grid;
    gap: 24px;
}

.photobooth-image-stack img {
    width: 100%;
    border-radius: 26px;
    object-fit: cover;
    display: block;
    box-shadow: 0 20px 60px rgba(0,0,0,.10);
    border: 1px solid rgba(17,24,26,.08);
}

.photobooth-image-stack img:first-child,
.photobooth-image-stack img:last-child {
    min-height: 260px;
    max-height: 260px;
}

.photobooth-panel {
    background: #fff;
    border: 1px solid rgba(17,24,26,.08);
    border-radius: 30px;
    padding: 42px;
    box-shadow: 0 25px 70px rgba(0,0,0,.08);
}

.photobooth-panel h3 {
    font-size: 2rem;
    color: var(--vnv-text-dark);
    margin-bottom: 18px;
}

.photobooth-panel p,
.photobooth-panel li {
    color: #4f5b5f;
}

.photobooth-panel ul {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
}
.photobooth-panel ul li {
    position: relative;
    padding-left: 24px;
    margin-bottom: 12px;
}
.photobooth-panel ul li::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vnv-primary);
    position: absolute;
    left: 0;
    top: 12px;
}

/* Package pricing cards */
.package-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}
.package-card {
    background: #fff;
    border: 1px solid rgba(17,24,26,.08);
    border-radius: 30px;
    padding: 34px 30px;
    height: 100%;
    box-shadow: 0 20px 60px rgba(0,0,0,.08);
    position: relative;
}
.package-card.popular {
    border: 2px solid var(--vnv-gold);
    box-shadow: 0 25px 70px rgba(197,160,89,.18);
}
.popular-badge {
    display: inline-block;
    background: var(--vnv-gold-gradient);
    color: #000;
    font-size: .66rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 16px;
}
.package-card h3 {
    color: var(--vnv-text-dark);
    font-size: 1.55rem;
    margin-bottom: 6px;
}
.package-price {
    font-size: 2.1rem;
    font-weight: 900;
    line-height: 1;
    color: var(--vnv-primary-dark);
    margin-bottom: 6px;
}
.package-meta {
    font-size: .88rem;
    color: #8a9295;
    text-transform: uppercase;
    letter-spacing: .5px;
    margin-bottom: 18px;
    display: block;
}
.package-card p,
.package-card li {
    color: #4f5b5f;
}
.package-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
}
.package-card ul li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 10px;
}
.package-card ul li::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vnv-gold);
    position: absolute;
    left: 0;
    top: 11px;
}

.rate-disclaimer {
    text-align: center;
    margin-top: 32px;
    color: #677174;
    font-size: .92rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
}
.rate-disclaimer.on-dark {
    color: var(--vnv-text-muted);
}

/* Add-ons strip */
.addon-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 10px;
}
.addon-chip {
    background: rgba(28, 34, 35, 0.82);
    border: 1px solid rgba(197, 160, 89, 0.10);
    border-radius: 22px;
    padding: 24px 26px;
}
.addon-chip h4 {
    color: #fff;
    font-size: 1.1rem;
    margin-bottom: 6px;
}
.addon-chip .addon-price {
    color: var(--vnv-primary);
    font-weight: 800;
    font-size: .95rem;
    display: block;
    margin-bottom: 8px;
}
.addon-chip p {
    color: var(--vnv-text-muted);
    font-size: .88rem;
    margin: 0;
}

.media-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
}

.media-mini-card {
    background: #fff;
    border: 1px solid rgba(17,24,26,.08);
    border-radius: 28px;
    padding: 30px 24px;
    box-shadow: 0 20px 60px rgba(0,0,0,.08);
    height: 100%;
}

.media-mini-card h4 {
    color: var(--vnv-text-dark);
    font-size: 1.35rem;
    margin-bottom: 12px;
}
.media-mini-card p {
    color: #4f5b5f;
    margin: 0;
}

/* FAQ */
.faq-wrap {
    max-width: 880px;
    margin: 0 auto;
}
.faq-item {
    border-bottom: 1px solid rgba(17,24,26,.08);
    padding: 26px 0;
}
.faq-item:last-child { border-bottom: none; }
.faq-item h4 {
    font-size: 1.15rem;
    color: var(--vnv-text-dark);
    margin-bottom: 8px;
}
.faq-item p {
    color: #566164;
    margin: 0;
}

.instagram-block {
    position: relative;
    overflow: hidden;
}

.instagram-block::before {
    content: "";
    position: absolute;
    top: -120px;
    left: -120px;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(94,198,196,0.14) 0%, transparent 70%);
    pointer-events: none;
}

.vnv-studio-card {
    background: linear-gradient(145deg, #161a1b 0%, #0d0f0f 100%);
    border-radius: 30px;
    padding: 50px;
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow: 0 20px 60px rgba(0,0,0,0.35);
}

.vnv-studio-card h3 {
    font-size: 1.8rem;
    font-weight: 800;
}

.vnv-studio-card p {
    color: rgba(255,255,255,0.7);
    margin-bottom: 20px;
}

.vnv-studio-info {
    display: flex;
    gap: 12px;
    align-items: center;
    color: #fff;
    font-weight: 600;
    margin-bottom: 25px;
}

.vnv-studio-info i {
    color: var(--vnv-primary);
}

.vnv-studio-actions {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.instagram-gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.instagram-gallery-grid img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 22px;
    display: block;
    border: 1px solid rgba(255,255,255,.08);
}

.final-cta-card {
    background: linear-gradient(145deg, #161a1b 0%, #0d0f0f 100%);
    border-radius: 45px;
    padding: 90px 70px;
    border: 1px solid rgba(255,255,255,.06);
    position: relative;
    overflow: hidden;
}

.final-cta-card::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 10%;
    width: 360px;
    height: 360px;
    transform: translateY(-50%);
    background: radial-gradient(circle, rgba(94, 198, 196, 0.08) 0%, transparent 70%);
    pointer-events: none;
}

.final-cta-card p {
    color: var(--vnv-text-muted-soft);
}

.final-cta-note {
    font-size: .85rem;
    color: var(--vnv-primary);
    margin-top: 18px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 700;
}

.vnv-btn-fixed {
    min-width: 240px;
    text-align: center;
    white-space: normal;
    line-height: 1.35;
    padding: 20px 28px;
}

@media (max-width: 1199px) {
    .service-grid,
    .media-grid,
    .package-grid,
    .addon-strip {
        grid-template-columns: 1fr 1fr;
    }
    .final-cta-card {
        padding: 60px 45px;
    }
}

@media (max-width: 991px) {
    .intro-wrap,
    .photobooth-wrap {
        grid-template-columns: 1fr;
    }

    .service-grid,
    .media-grid,
    .package-grid,
    .addon-strip {
        grid-template-columns: 1fr;
    }

    .intro-panel,
    .photobooth-panel,
    .vnv-studio-card {
        padding: 32px 28px;
    }

    .final-cta-card {
        padding: 50px 30px;
        text-align: center;
    }

    .vnv-btn-fixed {
        min-width: 100%;
    }

    .services-bg-video {
        height: 100%;
        transform: none;
        filter: blur(1px) saturate(0.8);
    }
}

@media (max-width: 767px) {
    .section-vnv {
        padding: 90px 0;
    }

    .hero-media h1 {
        font-size: 2.7rem;
    }

    .vnv-btn {
        width: 100%;
        padding: 18px 24px;
        letter-spacing: 2px;
    }

    .hero-cta-row {
        flex-direction: column;
    }

    .trust-bar {
        gap: 26px;
    }
    .trust-stat .num {
        font-size: 1.9rem;
    }

    .instagram-gallery-grid img {
        height: 150px;
    }
}
</style>
{% endblock %}

{% block body %}

{% include "templates/layout/publicHeaderVnv.html.twig" %}

<section class="hero-media">
    <div class="container hero-media-inner">
        <span class="vnv-badge">VNV Multimedia</span>

        <h1>Photo Booth, <span class="text-gold">Video & Photography</span> Services in South Florida</h1>

        <p class="hero-copy">
            Interactive guest experiences and polished event coverage, captured by the same team that built the event — not a freelancer hired after the fact.
        </p>

        <div class="hero-services-row">
            <span>Photobooth</span>
            <span>Photography</span>
            <span>Videography</span>
            <span>Drone</span>
            <span>Podcast Studio</span>
        </div>

        <div class="hero-cta-row">
            <a href="tel:+13052045427" class="vnv-btn btn-gold-vnv">Call Now (305) 204-5427</a>
            <a href="#media-services" class="vnv-btn btn-outline-vnv">Explore Services</a>
        </div>

        <div class="trust-bar">
            <div class="trust-stat">
                <div class="num">200+</div>
                <div class="label">Events Produced Yearly</div>
            </div>
            <div class="trust-stat">
                <div class="num">3</div>
                <div class="label">South Florida Counties Served</div>
            </div>
            <div class="trust-stat">
                <div class="num">20+</div>
                <div class="label">Years Combined Experience</div>
            </div>
        </div>
    </div>
</section>

<section class="section-vnv section-white">
    <div class="container">
        <div class="intro-wrap">
            <div class="intro-image-card">
                <img src="{{ asset_for('assets/images/media2.jpg') }}" alt="Photo booth and photography by VNV">
            </div>

            <div class="intro-panel">
                <span class="vnv-badge">Capture the Experience</span>
                <h3>More than photos. More than a booth.</h3>
                <p>
                    This service brings together three essential pieces: interactive photobooth experiences, professional visual coverage and personalized branding elements that make the event feel more complete.
                </p>
                <p>
                    It works especially well for clients who want something guests can enjoy in real time, while making sure the event is documented in a clean, professional way.
                </p>

                <ul>
                    <li>Interactive photobooth experience for guests</li>
                    <li>Professional event photography and video coverage</li>
                    <li>Drone and streaming options when needed</li>
                    <li>Branding elements for custom frames, prints and visuals</li>
                </ul>

                <div class="trust-strip">
                    <span><i class="fa-solid fa-shield-check"></i> Fully insured equipment & attendants</span>
                    <span><i class="fa-solid fa-bolt"></i> Same-day preview delivery available</span>
                    <span><i class="fa-solid fa-people-arrows"></i> One team for photo, video & booth</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-vnv section-dark" id="media-services">
    <div class="services-bg-video-wrap">
        <video class="services-bg-video" autoplay muted loop playsinline preload="auto">
            <source src="{{ asset_for('assets/video/intro.mp4') }}" type="video/mp4">
        </video>
        <div class="services-bg-overlay"></div>
    </div>

    <div class="container position-relative" style="z-index:2;">
