{% extends "templates/base.twig" %}
{% block title %}Retro Glam Sessions | VNV Events Productions{% endblock %}
{% block meta_description %}Explore four Retro Glam Sessions concepts in South Florida, from 70s disco to a 2000s flashback. Join the VNV Events priority list for edition announcements.{% endblock %}
{% block canonical %}https://vnvevents.com/vnv-events-productions/retro-glam/{% endblock %}
{% block og_image %}https://vnvevents.com/assets/retro-glam/hero.webp{% endblock %}
{% block og_image_alt %}An illustrated Art Deco ballroom concept for Retro Glam Sessions{% endblock %}

{% set editions = [
  {
    slug: 'disco-70s', era: '1970s', title: 'Disco in Gold',
    image: 'disco-70s.webp', alt: 'Guests dancing under a gold mirror ball in a velvet ballroom',
    teaser: 'Disco, funk and soul under a mirror ball.',
    sound: 'A DJ set of disco, funk and soul. Live percussion can join the set on select editions.',
    room: 'Gold mirror-ball light, warm brass and velvet with a dance floor at the center.',
    photo: 'A mirror-ball portrait set with amber light and a metallic backdrop.'
  },
  {
    slug: 'neon-80s', era: '1980s', title: 'Neon Nights',
    image: 'neon-80s.webp', alt: 'A DJ at turntables lit in pink and blue',
    teaser: 'Synth-pop and Miami freestyle in electric color.',
    sound: 'Synth-pop, dance-floor classics and Miami freestyle, with a live sax feature on select editions.',
    room: 'Chrome, sharp silhouettes and a dance floor lit in magenta and electric blue.',
    photo: 'A chrome portrait set with colored light shaped around each guest.'
  },
  {
    slug: 'after-dark-90s', era: '1990s', title: 'After Dark',
    image: 'after-dark-90s.webp', alt: 'Guests in eveningwear socializing beside a teal velvet lounge',
    teaser: 'R&B, house and club classics with a lounge feel.',
    sound: 'A DJ set of R&B, house and club favorites. Guest vocals can be featured when the edition calls for them.',
    room: 'Dark teal velvet, amber lamps and room for dancing or catching up in the lounge.',
    photo: 'A softly lit portrait spot with the feel of a late-night club editorial.'
  },
  {
    slug: 'flashback-00s', era: '2000s', title: 'Flashback',
    image: 'flashback-00s.webp', alt: 'An eveningwear pair on a red carpet with chrome accents',
    teaser: 'Y2K pop and hip-hop with a red-carpet entrance.',
    sound: 'Early-2000s pop, hip-hop and club hits in a DJ-led throwback set.',
    room: 'A red-carpet arrival, cool silver finishes and a dance floor for the songs everyone knows.',
    photo: 'A chrome-framed red-carpet photo moment inspired by point-and-shoot party portraits.'
  }
] %}
{% set priority = path('vnv-events-productions') ~ '#priority-list' %}

{% block styles %}
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-retro-glam.css') }}">
{% endblock %}

{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}
<main class="rg-page">
  <section class="rg-hero rg-shell" aria-labelledby="retro-title">
    <div class="rg-hero__copy">
      <p class="rg-kicker">A VNV original · South Florida</p>
      <h1 id="retro-title">Retro Glam <span>Sessions</span></h1>
      <p class="rg-hero__intro">Dress up for a night of throwback music, dancing and red-carpet photos. Each edition brings a different era to the room, framed by the glamour of Miami art déco.</p>
      <div class="rg-actions">
        <a class="rg-button" href="#retro-editions">Explore the editions <span aria-hidden="true">↓</span></a>
        <a class="rg-link" href="{{ priority }}">Join the priority list</a>
      </div>
    </div>
    <figure class="rg-hero__image">
      <img src="{{ asset_for('assets/retro-glam/hero.webp') }}" width="1440" height="960" alt="Black-tie guests entering an imagined Art Deco ballroom in Miami" fetchpriority="high" decoding="async">
    </figure>
  </section>

  <section class="rg-section rg-shell" id="retro-editions" aria-labelledby="retro-editions-title">
    <header class="rg-section__intro">
      <h2 id="retro-editions-title">Pick your decade</h2>
      <p>Explore the sound, look and photo moments of four concepts in development. Each announcement will include the venue, lineup and what your ticket covers.</p>
    </header>
    <div class="rg-editions">
      {% for edition in editions %}
        <article class="rg-edition">
          <img src="{{ asset_for('assets/retro-glam/' ~ edition.image) }}" width="1050" height="700" alt="" loading="lazy" decoding="async">
          <div class="rg-edition__copy">
            <p class="rg-kicker">{{ edition.era }}</p>
            <h3>{{ edition.title }}</h3>
            <p>{{ edition.teaser }}</p>
            <button type="button" class="rg-edition__open" data-retro-edition-open="{{ edition.slug }}" aria-controls="retro-dialog-{{ edition.slug }}" aria-haspopup="dialog">Explore <span class="visually-hidden">{{ edition.era }} {{ edition.title }} </span><span aria-hidden="true">↗</span></button>
          </div>
        </article>
      {% endfor %}
    </div>
  </section>

  <section class="rg-section rg-amenities" aria-labelledby="retro-amenities-title">
    <div class="rg-shell">
      <header class="rg-section__intro">
        <h2 id="retro-amenities-title">What makes the night</h2>
      </header>
      <ul class="rg-amenities__grid" role="list">
        <li><h3>Red-carpet arrival</h3><p>An entrance worth dressing up for, with room to stop for a portrait.</p></li>
        <li><h3>Retro DJ sets</h3><p>DJs build the dance floor around the decade, with live musicians or guest performances on select editions.</p></li>
        <li><h3>Styled photo moments</h3><p>Era-specific sets and lighting for group shots, portraits and the details you want to keep.</p></li>
        <li><h3>Space to socialize</h3><p>Slip out of the dance floor for a conversation or find your friends in the lounge.</p></li>
      </ul>
    </div>
  </section>

  <section class="rg-section rg-partners rg-shell" aria-labelledby="retro-partners-title">
    <div>
      <h2 id="retro-partners-title">Host or sponsor an edition</h2>
      <p>Bring the night to your venue or partner on a red-carpet moment, a styled photo set, a lounge or a live performance.</p>
    </div>
    <button type="button" class="rg-button" data-vnv-open-sponsor>Talk to VNV Events <span aria-hidden="true">↗</span></button>
  </section>
</main>

{% for edition in editions %}
  <dialog class="rg-dialog" id="retro-dialog-{{ edition.slug }}" aria-labelledby="retro-dialog-title-{{ edition.slug }}">
    <article class="rg-dialog__content">
      <form class="rg-dialog__close" method="dialog"><button type="submit" autofocus aria-label="Close {{ edition.title }}">×</button></form>
      <img class="rg-dialog__photo" src="{{ asset_for('assets/retro-glam/' ~ edition.image) }}" width="1050" height="700" alt="{{ edition.alt }}" loading="lazy" decoding="async">
      <div class="rg-dialog__body">
        <p class="rg-kicker">{{ edition.era }}</p>
        <h2 id="retro-dialog-title-{{ edition.slug }}">{{ edition.title }}</h2>
        <dl class="rg-dialog__details">
          <div><dt>The sound</dt><dd>{{ edition.sound }}</dd></div>
          <div><dt>The room</dt><dd>{{ edition.room }}</dd></div>
          <div><dt>The photo moment</dt><dd>{{ edition.photo }}</dd></div>
        </dl>
        <a class="rg-button" href="{{ priority }}">Get edition invitations <span aria-hidden="true">↗</span></a>
      </div>
    </article>
  </dialog>
{% endfor %}

{% include "templates/components/publicSponsorRequestModal.html.twig" with {
  sponsor_form_action: path('api/public/sponsor-request')
} %}
{% include "templates/layout/publicFooterVnv.html.twig" %}
{% endblock %}

{% block scripts %}
<script defer src="{{ asset_for('assets/js/vnv-retro-glam.js') }}"></script>
{% endblock %}
