{% extends "templates/base.twig" %}

{% block title %}Retro Glam Sessions | VNV Events Productions{% endblock %}
{% block meta_description %}Discover a South Florida night of disco, retro pop and dancing from the 1970s through the 1990s. Join the Retro Glam priority list for the first edition.{% endblock %}
{% block canonical %}https://vnvevents.com/vnv-events-productions/retro-glam/{% endblock %}
{% block og_image %}https://vnvevents.com/assets/images/productions/retro-glam.jpg{% endblock %}
{% block og_image_alt %}Retro Glam fashion portrait with white sunglasses and a red striped backdrop{% endblock %}
{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-originals.css') }}">
{% endblock %}

{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}
{% set list_url = path('vnv-events-productions') ~ '#priority-list' %}
<main class="rg-page">
  <section class="rg-hero" aria-labelledby="rg-title">
    <div class="rg-hero__copy">
      <a class="rg-back" href="{{ path('vnv-events-productions') }}">← VNV Original Experiences</a>
      <p class="rg-eyebrow">South Florida · Music &amp; nightlife</p>
      <h1 id="rg-title">Retro Glam <em>Sessions</em></h1>
      <p class="rg-lead">Dress for your favorite decade. Meet for a cocktail, find your friends in the photo lounge and dance to the records you grew up with.</p>
      <div class="rg-actions">
        <a class="rg-cta" href="{{ list_url }}">Join the Retro Glam priority list <span aria-hidden="true">↗</span></a>
        <a class="rg-link" href="#agenda">Explore the evening</a>
      </div>
      <p class="rg-availability">The first edition is in development. Join the list for date, venue and ticket updates.</p>
    </div>
    <div class="rg-hero__picture">
      <img fetchpriority="high" src="{{ asset_for('assets/images/productions/retro-glam.jpg') }}" alt="Retro fashion portrait in white sunglasses against red stripes" width="800" height="600">
    </div>
  </section>

  <section class="rg-section rg-experience" id="experience" aria-labelledby="rg-experience-title">
    <div class="rg-experience__image"><img loading="lazy" decoding="async" src="{{ asset_for('assets/images/productions/retro-glam-sessions-hero.jpg') }}" alt="Guests facing a light-filled stage under a shower of confetti" width="1920" height="1080"></div>
    <div>
      <p class="rg-eyebrow">The music &amp; the room</p>
      <h2 id="rg-experience-title">Three decades.<br><em>One dance floor.</em></h2>
      <p>Disco, soulful edits and retro pop take the DJ set from the ’70s through the ’90s. Between songs, slip into the lounge for a conversation or get the group together at a styled photo set.</p>
      <a class="rg-link" href="{{ path('vnv-events-productions') }}#original-experiences-film">Watch the VNV Originals film <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section id="agenda" class="rg-section rg-agenda" aria-labelledby="rg-agenda-title">
    <div>
      <p class="rg-eyebrow">The proposed evening</p>
      <h2 id="rg-agenda-title">From first drink<br><em>to last track.</em></h2>
      <p>The four-hour format runs from 7 to 11 PM. The invitation will confirm the schedule for the first edition.</p>
    </div>
    <ol class="rg-times">
      <li><span>7:00 – 7:45 PM</span><div><h3>Arrive for cocktails</h3><p>Meet your group and get your first look at the room.</p></div></li>
      <li><span>7:45 – 8:30 PM</span><div><h3>Find your photo set</h3><p>Try the styled backdrops and explore the partner experiences.</p></div></li>
      <li><span>8:30 – 10:00 PM</span><div><h3>Meet on the dance floor</h3><p>The DJ takes the room through the evening’s throwback set.</p></div></li>
      <li><span>10:00 – 11:00 PM</span><div><h3>Stay for the closing set</h3><p>One last dance and a final photo with your friends.</p></div></li>
    </ol>
  </section>

  <section class="rg-section rg-partners" aria-labelledby="rg-partners-title">
    <div>
      <p class="rg-eyebrow">Venue &amp; brand partners</p>
      <h2 id="rg-partners-title">Give guests something <em>to remember.</em></h2>
      <p>Host the evening, design a photo set or pour a signature drink. Tell us how your venue or brand would fit into a Retro Glam night.</p>
    </div>
    <div class="rg-actions">
      <button class="rg-cta" type="button" data-vnv-open-sponsor>Talk to VNV about a partnership <span aria-hidden="true">↗</span></button>
      <a class="rg-link" href="{{ list_url }}">Coming as a guest? Join the list</a>
    </div>
  </section>
</main>
{% include "templates/components/publicSponsorRequestModal.html.twig" with {sponsor_form_action: path('api/public/sponsor-request')} %}
{% include "templates/layout/publicFooterVnv.html.twig" %}
{% endblock %}
