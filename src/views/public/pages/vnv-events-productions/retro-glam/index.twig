{% extends "templates/base.twig" %}

{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&display=swap" rel="stylesheet">

<style>
:root {
    --vnv-primary: #5EC6C4;
    --vnv-primary-dark: #4aa8a6;
    --vnv-gold: #c5a059;
    --vnv-gold-gradient: linear-gradient(135deg, #bf953f 0%, #fcf6ba 45%, #b38728 100%);
    --vnv-rose: #d86aa7;
    --vnv-purple: #7657d8;
    --vnv-dark-deep: #09090c;
    --vnv-dark-soft: #141418;
    --vnv-dark-card: #171821;
    --vnv-light: #ffffff;
    --vnv-marble: #f5f4f8;
    --vnv-text-dark: #11181a;
    --vnv-text-light: #f3f5f6;
    --vnv-text-muted: rgba(255,255,255,.74);
    --vnv-text-muted-dark: #536063;
    --vnv-border: rgba(255,255,255,.08);
    --vnv-shadow-lg: 0 40px 100px rgba(0,0,0,.24);
}

html { scroll-behavior: smooth; }

html, body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
}

body {
    background: var(--vnv-dark-deep);
    color: var(--vnv-text-light);
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

*, *::before, *::after {
    box-sizing: border-box;
}

h1, h2, h3, h4, h5 {
    font-family: 'Playfair Display', serif;
}

.text-vnv { color: var(--vnv-primary) !important; }
.text-rose { color: var(--vnv-rose) !important; }
.text-gold {
    background: var(--vnv-gold-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.vnv-btn {
    padding: 18px 30px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: all .35s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: .78rem;
    border-radius: 999px;
}

.btn-gold-vnv {
    background: var(--vnv-gold-gradient);
    color: #000 !important;
}
.btn-gold-vnv:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 40px rgba(197,160,89,.22);
}

.btn-outline-vnv {
    border: 2px solid var(--vnv-primary);
    color: var(--vnv-primary) !important;
    background: transparent;
}
.btn-outline-vnv:hover {
    background: var(--vnv-primary);
    color: #fff !important;
}

.btn-rose-vnv {
    border: 2px solid rgba(216,106,167,.9);
    color: var(--vnv-rose) !important;
    background: transparent;
}
.btn-rose-vnv:hover {
    background: var(--vnv-rose);
    color: #fff !important;
}

.section-vnv {
    padding: 120px 0;
    position: relative;
}

.section-white {
    background: var(--vnv-marble);
    color: var(--vnv-text-dark);
}

.section-dark {
    background: linear-gradient(180deg, #09090c 0%, #11111a 100%);
    color: var(--vnv-text-light);
}

.vnv-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(94,198,196,.1);
    color: var(--vnv-primary);
    font-size: .74rem;
    letter-spacing: 2px;
    font-weight: 800;
    text-transform: uppercase;
}

.vnv-badge--rose {
    background: rgba(216,106,167,.14);
    color: #f2a6cf;
}

.vnv-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: .88rem;
    color: rgba(255,255,255,.6);
    margin-top: 18px;
}
.vnv-breadcrumbs a {
    color: rgba(255,255,255,.76);
    text-decoration: none;
}
.vnv-breadcrumbs span.sep {
    opacity: .4;
}

.event-hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
        linear-gradient(90deg, rgba(9,9,12,.90) 0%, rgba(9,9,12,.68) 40%, rgba(9,9,12,.38) 100%),
        url('{{ asset_for('assets/images/productions/retro-glam-sessions-hero.jpg') }}') center/cover no-repeat;
}

.event-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at top right, rgba(216,106,167,.18), transparent 26%),
        radial-gradient(circle at bottom left, rgba(118,87,216,.18), transparent 24%),
        radial-gradient(circle at center left, rgba(94,198,196,.12), transparent 24%);
    pointer-events: none;
}

.event-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
}

.event-hero h1 {
    font-size: clamp(3rem, 6vw, 5.2rem);
    line-height: 1.02;
    margin: 20px 0 24px;
    max-width: 940px;
}

.event-hero .hero-copy {
    font-size: 1.08rem;
    color: rgba(255,255,255,.84);
    max-width: 780px;
    margin-bottom: 18px;
}

.hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin: 34px 0 28px;
}

.section-heading {
    max-width: 960px;
    margin-bottom: 55px;
}
.section-heading h2 {
    font-size: clamp(2.2rem, 4vw, 4.3rem);
    line-height: 1.04;
    margin: 16px 0 18px;
}
.section-dark .section-heading p {
    color: var(--vnv-text-muted);
}
.section-white .section-heading p {
    color: #5a6669;
}

.experience-grid,
.agenda-list,
.info-grid,
.sponsor-grid {
    display: grid;
    gap: 22px;
}

.experience-grid {
    grid-template-columns: 1fr 1fr;
}

.info-grid,
.sponsor-grid {
    grid-template-columns: 1fr 1fr;
}

.card-vnv,
.agenda-card {
    border-radius: 30px;
    padding: 30px;
    box-shadow: 0 20px 60px rgba(0,0,0,.10);
}

.section-dark .card-vnv,
.section-dark .agenda-card {
    background: linear-gradient(145deg, rgba(28,29,39,.96) 0%, rgba(17,17,26,.97) 100%);
    border: 1px solid rgba(255,255,255,.07);
}

.section-white .card-vnv {
    background: #fff;
    border: 1px solid rgba(17,24,26,.08);
}

.card-vnv h3,
.agenda-card h3,
.card-vnv h4 {
    margin-bottom: 14px;
}

.section-dark .card-vnv h3,
.section-dark .card-vnv h4,
.section-dark .agenda-card h3 {
    color: #fff;
}

.section-white .card-vnv h3,
.section-white .card-vnv h4 {
    color: var(--vnv-text-dark);
}

.card-vnv p,
.agenda-card p {
    margin: 0;
}

.section-dark .card-vnv p,
.section-dark .agenda-card p {
    color: var(--vnv-text-muted);
}

.section-white .card-vnv p {
    color: #485457;
}

.card-icon {
    width: 58px;
    height: 58px;
    border-radius: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    background: linear-gradient(135deg, rgba(216,106,167,.18), rgba(118,87,216,.18));
    color: #f0b2d6;
    font-size: 1.2rem;
}

.agenda-list {
    grid-template-columns: 1fr;
}

.agenda-card {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 30px;
    align-items: start;
}

.agenda-time {
    color: #e8c776;
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.2;
}

.agenda-card h3 {
    font-size: 1.9rem;
    line-height: 1.05;
}

.detail-list {
    list-style: none;
    padding-left: 0;
    margin: 0;
}

.detail-list li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 8px;
}

.detail-list li::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vnv-gold);
    position: absolute;
    left: 0;
    top: 12px;
}

.call-strip {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid rgba(255,255,255,.08);
}
.call-strip a {
    color: var(--vnv-primary);
    text-decoration: none;
    font-weight: 800;
    letter-spacing: 1px;
}

.event-visual {
    min-height: 420px;
    border-radius: 30px;
    overflow: hidden;
    background:
        linear-gradient(180deg, rgba(0,0,0,.08), rgba(0,0,0,.24)),
        url('{{ asset_for('assets/images/productions/retro-glam-sessions-detail.jpg') }}') center/cover no-repeat;
    border: 1px solid rgba(255,255,255,.08);
}

@media (max-width: 1199px) {
    .experience-grid,
    .info-grid,
    .sponsor-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 991px) {
    .event-hero {
        min-height: auto;
        padding: 120px 0 80px;
        background-position: center center;
    }

    .agenda-card {
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .event-visual {
        min-height: 300px;
    }
}

@media (max-width: 767px) {
    .section-vnv {
        padding: 90px 0;
    }

    .event-hero h1 {
        font-size: 2.7rem;
    }

    .vnv-btn {
        width: 100%;
    }

    .card-vnv,
    .agenda-card {
        padding: 22px;
    }

    .agenda-card h3 {
        font-size: 1.55rem;
    }
}
</style>
{% endblock %}

{% block body %}

{% include "templates/layout/publicHeaderVnv.html.twig" %}

<section class="event-hero">
    <div class="container event-hero__inner">
        <span class="vnv-badge vnv-badge--rose">VNV Events Productions</span>

        <h1>Retro Glam Sessions</h1>

        <p class="hero-copy">
            A 4-hour night built around retro-inspired music, polished visuals, immersive photo moments and a social atmosphere that feels elevated, stylish and easy to enjoy.
        </p>

        <p class="hero-copy">
            Retro Glam Sessions is not just a themed party. It is a curated evening with era-driven mood, strong DJ sets, visual storytelling and sponsor-friendly moments designed to keep guests moving, interacting and remembering the night.
        </p>

        <div class="hero-cta-row">
            <a href="#agenda" class="vnv-btn btn-gold-vnv">View Agenda</a>
            <a href="#experience" class="vnv-btn btn-rose-vnv">The Experience</a>
            <a href="#" data-vnv-open-sponsor class="vnv-btn btn-outline-vnv">Sponsor Inquiry</a>
        </div>

        <div class="vnv-breadcrumbs">
            <a href="{{ path('/') }}">Home</a>
            <span class="sep">/</span>
            <a href="{{ path('vnv-events-productions') }}">VNV Events Productions</a>
            <span class="sep">/</span>
            <span>Retro Glam Sessions</span>
        </div>
    </div>
</section>

<section class="section-vnv section-white" id="experience">
    <div class="container">
        <div class="section-heading">
            <span class="vnv-badge vnv-badge--rose">The Experience</span>
            <h2>A retro night designed to feel <span class="text-rose">immersive, musical and visually memorable</span></h2>
            <p>
                Retro Glam Sessions is built around what guests actually enjoy in this type of event: a room with identity, music they recognize, beautiful photo moments, stylish people, a strong social rhythm and enough structure to make the entire night feel intentional.
            </p>
        </div>

        <div class="experience-grid">
            <div class="card-vnv">
                <div class="card-icon"><i class="fa-solid fa-record-vinyl"></i></div>
                <h3>Era-inspired environments</h3>
                <p>
                    The event should feel retro from the moment guests enter. Lighting, textures, backdrops, styling details and subtle references to the 70s, 80s and 90s help create an environment that feels transportive without becoming costume-heavy.
                </p>
            </div>

            <div class="card-vnv">
                <div class="card-icon"><i class="fa-solid fa-camera-retro"></i></div>
                <h3>Photo ops with real pull</h3>
                <p>
                    Styled photo areas are part of the core experience. Guests should feel invited to stop, interact, capture content and become part of the visual life of the event instead of just attending passively.
                </p>
            </div>

            <div class="card-vnv">
                <div class="card-icon"><i class="fa-solid fa-headphones-simple"></i></div>
                <h3>DJ-led music flow</h3>
                <p>
                    Music is one of the strongest engines of the night. The set can move through throwback dance favorites, soulful edits, disco, retro pop and polished crossover moments that keep the room energized without losing elegance.
                </p>
            </div>

            <div class="card-vnv">
                <div class="card-icon"><i class="fa-solid fa-star"></i></div>
                <h3>Stylish social energy</h3>
                <p>
                    Retro Glam Sessions works best when people can dance, connect, move through sponsor activations and enjoy the visual environment without the event ever feeling messy or random.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="section-vnv section-dark" id="agenda">
    <div class="container">
        <div class="section-heading">
            <span class="vnv-badge vnv-badge--rose">Agenda</span>
            <h2>A 4-hour session with rhythm, visuals and movement</h2>
            <p>
                The event is designed to run from 7:00 PM to 11:00 PM, beginning with arrival and visual discovery, building into the musical core of the night and closing with a stronger final stretch for dancing, connection and last sponsor moments.
            </p>
        </div>

        <div class="agenda-list">
            <div class="agenda-card">
                <div class="agenda-time">7:00 – 7:45 PM</div>
                <div>
                    <h3>Arrival, Cocktails & Visual Discovery</h3>
                    <p>
                        Guests enter the environment, explore the first retro moments, settle in with cocktails and begin the night with an easy social pace.
                    </p>
                </div>
            </div>

            <div class="agenda-card">
                <div class="agenda-time">7:45 – 8:30 PM</div>
                <div>
                    <h3>Photo Sessions, Activations & Social Flow</h3>
                    <p>
                        This block gives guests time to move through styled photo moments, sponsor activations and lounge areas while the music continues to build.
                    </p>
                </div>
            </div>

            <div class="agenda-card">
                <div class="agenda-time">8:30 – 10:00 PM</div>
                <div>
                    <h3>Main Music Session with Featured DJs</h3>
                    <p>
                        The event reaches its strongest entertainment period, with the room fully activated through retro-inspired music, movement and immersive atmosphere.
                    </p>
                </div>
            </div>

            <div class="agenda-card">
                <div class="agenda-time">10:00 – 11:00 PM</div>
                <div>
                    <h3>Closing Set, Final Photos & Night Close</h3>
                    <p>
                        The last hour keeps the energy high, allows for final content moments and gives the event a strong close without making guests feel rushed out.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-vnv section-white">
    <div class="container">
        <div class="section-heading">
            <span class="vnv-badge vnv-badge--rose">What Makes It Valuable</span>
            <h2>Why this format works for guests and sponsors</h2>
            <p>
                Retro Glam Sessions works because it combines music, identity and visual atmosphere in a format that is easy to understand and highly marketable. Guests get a better night out, and sponsors get multiple ways to become part of the experience.
            </p>
        </div>

        <div class="info-grid">
            <div class="card-vnv">
                <h4>For guests</h4>
                <ul class="detail-list">
                    <li>A stronger identity than a generic nightlife event</li>
                    <li>Recognizable music with better visual presentation</li>
                    <li>Space for dancing, conversation and photo moments</li>
                    <li>A retro concept that still feels polished and adult</li>
                </ul>
            </div>

            <div class="card-vnv">
                <h4>For sponsor brands</h4>
                <ul class="detail-list">
                    <li>Excellent fit for fashion, beauty, beverages, hospitality and lifestyle brands</li>
                    <li>High potential for memorable photo-led activations</li>
                    <li>Guests interact with branded moments naturally</li>
                    <li>Better opportunity for recall than passive logo placement alone</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="section-vnv section-dark">
    <div class="container">
        <div class="sponsor-grid">
            <div class="card-vnv">
                <span class="vnv-badge vnv-badge--rose">Sponsor Visibility</span>
                <h3 style="margin-top:18px;">A visual and musical night where brands can live inside the atmosphere</h3>
                <p>
                    Sponsorship inside Retro Glam Sessions works best when the brand becomes part of the mood, the photo experience, the lounge energy or the social rhythm of the night. This is a format where branded moments can feel stylish instead of forced.
                </p>

                <div class="call-strip">
                    <a href="#" data-vnv-open-sponsor>Open sponsor form</a>
                </div>

                <div style="margin-top:24px;">
                    <a href="#" data-vnv-open-sponsor class="vnv-btn btn-gold-vnv">Sponsor Inquiry</a>
                </div>
            </div>

            <div class="event-visual"></div>
        </div>
    </div>
</section>

{% include "templates/components/publicSponsorRequestModal.html.twig" with {
    sponsor_form_action: "/api/public/sponsor-request"
} %}

{% include "templates/layout/publicFooterVnv.html.twig" %}

{% endblock %}

{% block scripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<script>
if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
    const isMobile = window.innerWidth <= 767;

    if (!isMobile) {
        gsap.registerPlugin(ScrollTrigger);

        gsap.utils.toArray('.card-vnv, .agenda-card, .event-visual').forEach((card) => {
            gsap.from(card, {
                scrollTrigger: {
                    trigger: card,
                    start: "top 88%"
                },
                y: 36,
                opacity: 0,
                duration: 0.9,
                ease: "power3.out"
            });
        });
    }
}
</script>
{% endblock %}