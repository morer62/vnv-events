{% extends "templates/base.twig" %}
{% block title %}VNV Original Experiences | Retro Glam & Mommy and Daddy Break{% endblock %}
{% block meta_description %}Join the priority list for Retro Glam or Mommy and Daddy Break, two original South Florida social experiences currently in development by VNV Events.{% endblock %}
{% block canonical %}https://vnvevents.com/vnv-events-productions/{% endblock %}
{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-partnerships.css') }}">
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-partner-value.css', { v: '1' }) }}">
<style>
.originals-hero{padding:clamp(90px,13vw,170px) 0;color:#fff;background:radial-gradient(circle at 80% 10%,rgba(94,198,196,.22),transparent 35%),#0b1517}.originals-hero h1{max-width:900px;margin:0;color:#fff;font-size:clamp(3.1rem,8vw,7.2rem);font-weight:850;line-height:.92;letter-spacing:-.065em}.originals-hero p{max-width:760px;margin:24px 0 0;color:rgba(255,255,255,.75);font-size:1.16rem;line-height:1.75}.originals-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.original-card{min-width:0;overflow:hidden;border:1px solid rgba(16,25,27,.12);border-radius:28px;background:#fff;box-shadow:0 24px 70px rgba(12,29,31,.1)}.original-card__image{aspect-ratio:16/10;overflow:hidden;background:#102126}.original-card__image img{width:100%;height:100%;object-fit:cover;transition:transform .4s ease}.original-card:hover img{transform:scale(1.035)}.original-card__body{padding:clamp(24px,4vw,40px)}.original-card h2{margin:0;font-size:clamp(2rem,4vw,3.5rem);font-weight:850;line-height:1}.original-card p,.original-card li{color:#596668;line-height:1.7}.original-card ul{padding-left:20px}.original-label{display:inline-flex;margin-bottom:16px;padding:7px 11px;border-radius:999px;color:#123638;background:#d9f5f3;font-size:.72rem;font-weight:900;letter-spacing:.09em;text-transform:uppercase}@media(max-width:760px){.originals-grid{grid-template-columns:1fr}.originals-hero{padding:76px 0 90px}}
</style>
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-production-offers.css', { v: 'production-films-2' }) }}">
{% include "templates/components/vnvProductionEditorialAssets.html.twig" %}
{% endblock %}

{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}
<main class="vnv-partnership-page ve-page ve-page--originals">
  {% include "templates/components/vnvProductionHero.html.twig" with {
  hero: {
    slug: 'original-experiences',
    label: 'VNV Original Experiences · South Florida',
    title: 'Original experiences',
    emphasis: 'by VNV Events.',
    description: 'A slow morning together or a night worth dressing up for. Explore two experiences we produce in South Florida.',
    details: ['Mommy & Daddy Break Club · Morning socials for parents', 'Retro Glam · Throwback music, dancing and photo moments', 'Priority lists and venue or sponsor partnerships'],
    cta: 'Explore the experiences',
    href: '#original-experiences',
    preview_label: 'Illustrative scenes from the Break Club morning and Retro Glam night concepts'
  }
} only %}
  <section class="vnvp-section" id="original-experiences"><div class="vnvp-container originals-grid">
    <article class="original-card"><div class="original-card__image"><img src="{{ asset_for('assets/video/production-films/v8/retro-glam.webp', {v:'production-commercial-1'}) }}" alt="Retro Glam original experience concept by VNV Events" width="900" height="562"></div><div class="original-card__body"><span class="original-label">Decade-themed DJ nights</span><h2>Retro Glam Sessions</h2><p>Choose a decade-themed edition, from 1970s disco to Y2K hip-hop. VNV produces each night around its music, lighting and guests.</p><ul><li>Interest options: attendee, private host, sponsor or venue partner</li><li>Concept and date are still in development</li><li>No ticket sale is open on this page</li></ul><a class="vnvp-button" href="{{ path('vnv-events-productions/retro-glam') }}">Explore Retro Glam</a></div></article>
    <article class="original-card"><div class="original-card__image"><img src="{{ asset_for('assets/break-club/hero-miami-morning.webp') }}" alt="Mommy and Daddy Break original morning social concept by VNV Events" width="900" height="562"></div><div class="original-card__body"><span class="original-label">Parent morning social</span><h2>Mommy &amp; Daddy Break Club</h2><p>Brunch-style hospitality, a morning DJ, relaxed introductions and time to recharge at rotating South Florida venues.</p><ul><li>Free priority list for one or two adults</li><li>This concept does not provide or promise childcare</li><li>No ticket sale is open on this page</li></ul><a class="vnvp-button" href="{{ path('vnv-events-productions/mommy-and-daddy-break') }}">Explore the club &amp; join the list</a></div></article>
  </div>
  <div class="vnvp-container vp-original-partners">
    <h2>Bring your brand into an experience</h2>
    <p>VNV develops, promotes and produces these concepts. Interested in a hosted lounge, a tasting, an exhibitor space or a venue partnership? We confirm the edition, rights, available placements and costs with you before an agreement.</p>
    <a class="vnvp-button" href="{{ path('sponsor-activation-production') }}#activation-delivery">Explore brand partnerships</a>
    <details class="vp-sponsor-details">
      <summary>What digital tools come with an approved sponsorship?</summary>
      {% include "templates/components/vnvProductionPartnerValue.html.twig" with { audience: 'edition', compact: true } only %}
    </details>
  </div></section>

  {% include "templates/components/vnvProductionFilm.html.twig" with {
  film: {
    slug: 'original-experiences',
    route: 'vnv-events-productions',
    title: 'Meet the VNV originals',
    credit: 'Illustrative footage of the two event concepts. AI-generated narration.',
    description: 'Compare a Break Club morning built around coffee, brunch and conversation with a Retro Glam night shaped by the DJ set, lighting and photo moments of a single decade.',
    cta: 'Explore the experiences',
    href: '#original-experiences'
  }
} only %}

  <section class="vnvp-section vnvp-section--soft" id="priority-list"><div class="vnvp-container vnvp-form-wrap">
    <div class="vnvp-form-intro">
      {% if retro_title %}
        <span class="vnvp-eyebrow">Retro Glam Sessions</span>
        <h2>{{ private_request ? 'Host ' : 'Join the waitlist for ' }}{{ retro_title }}.</h2>
        <p>{{ private_request ? 'Tell us about your guests, venue or preferred date. A VNV producer will follow up about availability and a proposal for your event.' : 'Leave your email for an invitation when VNV announces this edition. Dates, venue and ticket details will follow.' }}</p>
        <a href="{{ path('vnv-events-productions/retro-glam') }}#retro-editions">Explore the other editions</a>
      {% else %}
        <span class="vnvp-eyebrow">Priority list</span><h2>Join the Retro Glam priority list.</h2><p>Receive updates about the upcoming Retro Glam experience. For morning socials, <a href="{{ path('vnv-events-productions/mommy-and-daddy-break') }}#waitlist">join the Break Club list</a>.</p>
      {% endif %}
    </div>
    <form class="vnvp-form" action="{{ path(private_request ? 'api/public/quick-request' : 'api/public/partnership-request') }}" method="post">
      {% if submitted %}<div class="vnvp-success" role="status">{% if private_request %}<strong>Private event request received.</strong> VNV will contact you about {{ retro_title }}.{% else %}<strong>You're on the list.</strong>{% if retro_title %} We'll email you when {{ retro_title }} is announced.{% endif %}{% endif %}</div>{% endif %}
      {% if retro_edition %}<input type="hidden" name="retro_edition" value="{{ retro_edition }}">{% endif %}
      {% if private_request %}
        <input type="hidden" name="request_type" value="PRODUCTION"><input type="hidden" name="form_source" value="retro_glam_private_event">
        <input type="hidden" name="_token" value="{{ quick_request_csrf }}">
      {% else %}
        <input type="hidden" name="program" value="ORIGINAL"><input type="hidden" name="_token" value="{{ partnership_csrf }}">
        <input type="hidden" name="event_name" value="Retro Glam"><input type="hidden" name="requested_services[]" value="Priority list updates">
        {% if retro_edition %}<input type="hidden" name="request_kind" value="waitlist">{% endif %}
      {% endif %}
      <div class="vnvp-hidden" aria-hidden="true"><label>Website confirmation<input type="text" name="website_confirm" tabindex="-1" autocomplete="off"></label></div>
      {% for key in ['gclid','gbraid','wbraid','utm_source','utm_medium','utm_campaign','utm_term','utm_content','landing_url'] %}<input type="hidden" name="{{ key }}" data-attribution="{{ key }}">{% endfor %}
      <div class="vnvp-fields">
        <div class="vnvp-field"><label for="original-name">Name *</label><input id="original-name" name="contact_name" required maxlength="191"></div>
        <div class="vnvp-field"><label for="original-email">Email *</label><input id="original-email" name="email" type="email" required maxlength="191"></div>
        <div class="vnvp-field"><label for="original-phone">Phone (optional)</label><input id="original-phone" name="phone" type="tel" maxlength="80"></div>
        {% if private_request %}<div class="vnvp-field vnvp-field--full"><label for="original-brief">Tell us about your event *</label><textarea id="original-brief" name="project_brief" required minlength="10" maxlength="1800" rows="3" placeholder="Occasion, expected guests, preferred venue or date"></textarea></div>{% endif %}
      </div>
      <label class="vnvp-consent"><input type="checkbox" name="consent" value="1" required><span>{% if private_request %}I agree that VNV Events may contact me about this private event request.{% elseif retro_title %}I agree to receive email invitations and updates for {{ retro_title }} from VNV Events.{% else %}I agree that VNV Events may contact me about the selected original experience. I understand this is not a ticket, invitation or confirmed event date.{% endif %} <a href="{{ path('privacy-policy') }}" target="_blank" rel="noopener">Privacy Policy</a></span></label>
      <button class="vnvp-button vnvp-button--gold" type="submit">{{ private_request ? 'Send private event request' : (retro_title ? 'Join this waitlist' : 'Join Priority List') }}</button>
    </form>
  </div></section>
</main>
{% include "templates/components/publicEventRequestModal.html.twig" with { request_form_action: path('api/public/event-request'), request_form_source: 'original_experiences' } %}
{% include "templates/layout/publicFooterVnv.html.twig" %}
{% endblock %}
{% block scripts %}<script>(function(){const params=new URLSearchParams(location.search);document.querySelectorAll('[data-attribution]').forEach(function(input){input.value=input.dataset.attribution==='landing_url'?location.href:(params.get(input.dataset.attribution)||'');});})();</script>{% endblock %}
