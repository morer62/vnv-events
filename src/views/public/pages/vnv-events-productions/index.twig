{% extends "templates/base.twig" %}

{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&display=swap" rel="stylesheet">

<style>
:root {
    --vnv-primary: #5EC6C4;
    --vnv-primary-dark: #4aa8a6;
    --vnv-gold: #c5a059;
    --vnv-gold-gradient: linear-gradient(135deg, #bf953f 0%, #fcf6ba 45%, #b38728 100%);
    --vnv-dark-deep: #0a0c0c;
    --vnv-dark-soft: #141818;
    --vnv-dark-card: #1b2021;
    --vnv-light: #ffffff;
    --vnv-marble: #f4f7f8;
    --vnv-text-dark: #11181a;
    --vnv-text-light: #f3f5f6;
    --vnv-text-muted: rgba(255,255,255,.74);
    --vnv-text-muted-dark: #536063;
    --vnv-border: rgba(255,255,255,.08);
    --vnv-shadow-lg: 0 40px 100px rgba(0,0,0,.24);
}

html { scroll-behavior: smooth; }

html, body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
}

body {
    background: var(--vnv-dark-deep);
    color: var(--vnv-text-light);
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

*, *::before, *::after {
    box-sizing: border-box;
}

h1, h2, h3, h4, h5 {
    font-family: 'Playfair Display', serif;
}

.text-vnv { color: var(--vnv-primary) !important; }
.text-gold {
    background: var(--vnv-gold-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.letter-spacing-lg { letter-spacing: 4px; }

.vnv-btn {
    padding: 18px 30px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: all .35s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: .78rem;
    border-radius: 999px;
}

.btn-gold-vnv {
    background: var(--vnv-gold-gradient);
    color: #000 !important;
}
.btn-gold-vnv:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 40px rgba(197,160,89,.22);
}

.btn-outline-vnv {
    border: 2px solid var(--vnv-primary);
    color: var(--vnv-primary) !important;
    background: transparent;
}
.btn-outline-vnv:hover {
    background: var(--vnv-primary);
    color: #fff !important;
}

.btn-ghost-white {
    border: 1px solid rgba(255,255,255,.16);
    color: #fff !important;
    background: transparent;
}
.btn-ghost-white:hover {
    background: #fff;
    color: #000 !important;
}

.section-vnv {
    padding: 120px 0;
    position: relative;
}

.vnv-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(94,198,196,.1);
    color: var(--vnv-primary);
    font-size: .74rem;
    letter-spacing: 2px;
    font-weight: 800;
    text-transform: uppercase;
}

.vnv-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: .88rem;
    color: rgba(255,255,255,.6);
    margin-top: 18px;
}
.vnv-breadcrumbs a {
    color: rgba(255,255,255,.76);
    text-decoration: none;
}
.vnv-breadcrumbs span.sep {
    opacity: .4;
}

.hero-productions {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
        linear-gradient(90deg, rgba(10,12,12,.90) 0%, rgba(10,12,12,.72) 42%, rgba(10,12,12,.44) 100%),
        url('{{ asset_for('assets/images/productions/hero-productions.jpg') }}') center/cover no-repeat;
}

.hero-productions::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at top right, rgba(94,198,196,.16), transparent 28%),
        radial-gradient(circle at bottom left, rgba(197,160,89,.12), transparent 24%);
    pointer-events: none;
}

.hero-productions-inner {
    position: relative;
    z-index: 2;
    width: 100%;
}

.hero-productions h1 {
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 1.02;
    margin: 20px 0 28px;
    max-width: 980px;
}

.hero-productions p.hero-copy {
    font-size: 1.08rem;
    color: var(--vnv-text-muted);
    max-width: 760px;
    margin-bottom: 20px;
}

.hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin: 32px 0 28px;
}

.section-white {
    background: var(--vnv-marble);
    color: var(--vnv-text-dark);
}

.section-dark {
    background: var(--vnv-dark-deep);
    color: var(--vnv-text-light);
}

.section-heading {
    max-width: 940px;
    margin-bottom: 55px;
}
.section-heading h2 {
    font-size: clamp(2.2rem, 4vw, 4.3rem);
    line-height: 1.04;
    margin: 16px 0 18px;
}
.section-dark .section-heading p {
    color: var(--vnv-text-muted);
}
.section-white .section-heading p {
    color: #5a6669;
}

.production-card {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 26px;
    align-items: stretch;
    border-radius: 30px;
    padding: 22px;
    height: 100%;
    position: relative;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,.10);
}

.section-dark .production-card,
.section-dark .sponsor-tier-card,
.section-dark .sponsor-feature-card,
.section-dark .location-card {
    background: linear-gradient(145deg, rgba(28,34,35,.95) 0%, rgba(16,18,18,.96) 100%);
    border: 1px solid rgba(255,255,255,.07);
}

.section-white .production-card,
.section-white .why-card,
.section-white .studio-card {
    background: #fff;
    border: 1px solid rgba(17,24,26,.08);
}

.production-media {
    min-height: 280px;
    border-radius: 22px;
    overflow: hidden;
    background: #dfe7e9;
}

.production-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.production-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.production-body h3,
.sponsor-tier-card h4,
.sponsor-feature-card h4,
.location-card h4,
.why-card h4,
.studio-card h4 {
    margin-bottom: 16px;
}

.section-dark .production-body h3,
.section-dark .sponsor-tier-card h4,
.section-dark .sponsor-feature-card h4,
.section-dark .location-card h4 {
    color: #fff;
}

.section-white .production-body h3,
.section-white .why-card h4,
.section-white .studio-card h4 {
    color: var(--vnv-text-dark);
}

.production-body h3 {
    font-size: 2.05rem;
    line-height: 1.04;
}

.production-body p,
.section-dark .sponsor-tier-card p,
.section-dark .sponsor-tier-card li,
.section-dark .sponsor-feature-card p,
.section-dark .sponsor-feature-card li,
.section-dark .location-card p,
.section-dark .location-card li {
    color: var(--vnv-text-muted);
}

.section-white .production-body p,
.section-white .why-card p,
.section-white .studio-card p,
.section-white .why-card li,
.section-white .studio-card li {
    color: #485457;
}

.production-points,
.sponsor-tier-card ul,
.sponsor-feature-card ul,
.location-card ul,
.why-card ul,
.studio-card ul {
    list-style: none;
    padding-left: 0;
    margin: 0;
}

.production-points li,
.sponsor-tier-card ul li,
.sponsor-feature-card ul li,
.location-card ul li,
.why-card ul li,
.studio-card ul li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 8px;
}

.production-points li::before,
.sponsor-tier-card ul li::before,
.sponsor-feature-card ul li::before,
.location-card ul li::before,
.why-card ul li::before,
.studio-card ul li::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vnv-gold);
    position: absolute;
    left: 0;
    top: 12px;
}

.production-top-actions,
.sponsor-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0 0 18px;
}

.call-strip {
    margin-top: 22px;
    padding-top: 18px;
}
.section-dark .call-strip {
    border-top: 1px solid rgba(255,255,255,.08);
}
.section-white .call-strip {
    border-top: 1px solid rgba(17,24,26,.08);
}
.call-strip a {
    color: var(--vnv-primary);
    text-decoration: none;
    font-weight: 800;
    letter-spacing: 1px;
}

.sponsor-hero-grid {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 26px;
    align-items: stretch;
    margin-bottom: 30px;
}

.sponsor-feature-card,
.sponsor-tier-card,
.location-card,
.why-card,
.studio-card {
    border-radius: 28px;
    padding: 30px;
    height: 100%;
}

.sponsor-side-list ul {
    margin-top: 18px;
}

.sponsor-packages-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
}

.sponsor-price {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(197,160,89,.14);
    color: var(--vnv-gold);
    font-weight: 800;
    letter-spacing: 1px;
    margin-bottom: 14px;
}

.sponsor-note {
    margin-top: 18px;
    font-size: .95rem;
    color: rgba(255,255,255,.64);
}

.studio-wrap {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 26px;
    align-items: stretch;
}

.studio-visual {
    border-radius: 28px;
    overflow: hidden;
    min-height: 420px;
    background:
        linear-gradient(180deg, rgba(0,0,0,.08), rgba(0,0,0,.22)),
        url('{{ asset_for('assets/images/productions/studio-sunrise.jpg') }}') center/cover no-repeat;
    border: 1px solid rgba(17,24,26,.08);
}

@media (max-width: 1199px) {
    .production-card {
        grid-template-columns: 300px 1fr;
    }

    .studio-wrap,
    .sponsor-hero-grid,
    .sponsor-packages-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 991px) {
    .hero-productions {
        min-height: auto;
        padding: 120px 0 80px;
        background-position: center center;
    }

    .production-card {
        grid-template-columns: 1fr;
    }

    .production-media {
        min-height: 240px;
    }
}

@media (max-width: 767px) {
    .section-vnv {
        padding: 90px 0;
    }

    .hero-productions h1 {
        font-size: 2.7rem;
    }

    .vnv-btn {
        width: 100%;
    }

    .production-card,
    .sponsor-tier-card,
    .sponsor-feature-card,
    .location-card,
    .why-card,
    .studio-card {
        padding: 22px;
    }

    .production-body h3 {
        font-size: 1.75rem;
    }
}
</style>
{% endblock %}

{% block body %}

{% include "templates/layout/publicHeaderVnv.html.twig" %}

<section class="hero-productions">
    <div class="container hero-productions-inner">
        <span class="vnv-badge">VNV Events Productions</span>

        <h1>Curated event concepts with <span class="text-gold">community, elegance and sponsor value</span></h1>

        <p class="hero-copy">
            VNV Events Productions is built around recurring experiences that bring people together through style, music, conversation, food and elevated brand-friendly moments.
        </p>

        <p class="hero-copy">
            From refined business gatherings to immersive lifestyle concepts, each production is built to create memorable experiences while opening the door to meaningful sponsor integration.
        </p>
        <div class="hero-cta-row">
            <a href="#event-models" class="vnv-btn btn-gold-vnv">Explore Events</a>
            
             <a href="#" data-vnv-open-sponsor class="vnv-btn btn-gold-vnv">Sponsor Inquiry</a>
   
            <a href="tel:+13052045427" class="vnv-btn btn-outline-vnv">Call (305) 204-5427</a>
        </div>

        <div class="vnv-breadcrumbs">
            <a href="{{ path('/') }}">Home</a>
            <span class="sep">/</span>
            <span>VNV Events Productions</span>
        </div>
    </div>
</section>

<section class="section-vnv section-white" id="event-models">
    <div class="container">
        <div class="section-heading">
            <span class="vnv-badge">Event Models</span>
            <h2>Four signature experiences for <span class="text-vnv">four different audiences</span></h2>
            <p>
                I replaced B2B Live with Vanguard Business Gala, because today that concept already has a stronger standalone identity and a clearer high-end positioning than the old B2B reference.  
            </p>
        </div>

        <div class="row g-4">
            <div class="col-12">
                <div class="production-card">
                    <div class="production-media">
                        <img src="{{ asset_for('assets/images/productions/vanguard-business-gala.jpg') }}" alt="Vanguard Business Gala by VNV Events">
                    </div>
                    <div class="production-body">
                        <div>
                            <div class="production-top-actions">
                                <a href="{{ path('vnv-events-productions/vanguard-business-gala') }}" class="vnv-btn btn-gold-vnv">View Event</a>
                            </div>

                            <h3>Vanguard Business Gala</h3>
                            <p>
                                A private, high-level evening designed to connect South Florida decision makers through refined networking, seated dinner and three featured speakers.
                            </p>

                            <ul class="production-points">
                                <li>Curated audience of founders, investors, executives and key leaders</li>
                                <li>Seated dinner paired with business, technology and leadership insight</li>
                                <li>Classic lounge close with elevated energy, never a festival feel</li>
                            </ul>
                        </div>

                        <div class="call-strip">
                            <a href="{{ path('vnv-events-productions/vanguard-business-gala') }}">Go to Vanguard Business Gala  </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="production-card">
                    <div class="production-media">
                        <img src="{{ asset_for('assets/images/productions/retro-glam.jpg') }}" alt="VNV Retro Glam event">
                    </div>
                    <div class="production-body">
                        <div>
                            <div class="production-top-actions">
                                <a href="{{ path('vnv-events-productions/retro-glam') }}" class="vnv-btn btn-gold-vnv">View Event</a>
                            </div>

                            <h3>VNV Retro Glam</h3>
                            <p>
                                An immersive music-and-style concept inspired by the 70s, 80s and 90s, built for nostalgia, visual impact and strong social energy.
                            </p>

                            <ul class="production-points">
                                <li>Perfect for lifestyle brands and visual sponsor moments</li>
                                <li>Built around themed environments, music and memory-triggering design</li>
                                <li>Highly shareable, playful and stylish without losing polish</li>
                            </ul>
                        </div>

                        <div class="call-strip">
                            <a href="{{ path('vnv-events-productions/retro-glam') }}">Go to Retro Glam  </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="production-card">
                    <div class="production-media">
                        <img src="{{ asset_for('assets/images/productions/flavor-fusion-fest.jpg') }}" alt="Flavor Fusion Fest by VNV Events">
                    </div>
                    <div class="production-body">
                        <div>
                            <div class="production-top-actions">
                                <a href="{{ path('vnv-events-productions/flavor-fusion-fest') }}" class="vnv-btn btn-gold-vnv">View Event</a>
                            </div>

                            <h3>Flavor Fusion Fest</h3>
                            <p>
                                A food, beverage and live-experience format that celebrates local flavor, artisanal pairings and sponsor-friendly community traffic.
                            </p>

                            <ul class="production-points">
                                <li>Strong fit for food, beverage and hospitality brands</li>
                                <li>Can blend tastings, exhibitor presence, music and community energy</li>
                                <li>Designed for discovery, hospitality and sensory appeal</li>
                            </ul>
                        </div>

                        <div class="call-strip">
                            <a href="{{ path('vnv-events-productions/flavor-fusion-fest') }}">Go to Flavor Fusion Fest  </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="production-card">
                    <div class="production-media">
                        <img src="{{ asset_for('assets/images/productions/mommy-and-daddy-break.jpg') }}" alt="Mommy and Daddy Break by VNV Events">
                    </div>
                    <div class="production-body">
                        <div>
                            <div class="production-top-actions">
                                <a href="{{ path('vnv-events-productions/mommy-and-daddy-break') }}" class="vnv-btn btn-gold-vnv">View Event</a>
                            </div>

                            <h3>Mommy and Daddy Break</h3>
                            <p>
                                A biweekly concept designed for parents who need room to reconnect, unwind and enjoy a quality experience outside of the daily routine.
                            </p>

                            <ul class="production-points">
                                <li>Perfect for family-oriented brands and wellness partnerships</li>
                                <li>Blends leisure, conversation, music and sponsor-led comfort moments</li>
                                <li>Built around recharge, connection and premium casual energy</li>
                            </ul>
                        </div>

                        <div class="call-strip">
                            <a href="{{ path('vnv-events-productions/mommy-and-daddy-break') }}">Go to Mommy and Daddy Break  </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-vnv section-dark" id="sponsorships">
    <div class="container">
        <div class="section-heading">
            <span class="vnv-badge">2026–2027 Sponsorship Packages</span>
            <h2>Sponsorship opportunities designed for <span class="text-gold">visibility, positioning and real connection</span></h2>
            <p>
                Partner with VNV Events and place your brand inside experiences built around business, lifestyle, hospitality and community. These packages are designed to give sponsors more than exposure — they create real touchpoints with the right audience.
            </p>
        </div>

        <div class="sponsor-hero-grid">
            <div class="sponsor-feature-card sponsor-side-list">
                <h4>Where your brand can show up</h4>
                <p>
                    Partner with VNV Events and showcase your brand across some of South Florida’s most creative and community-driven experiences.
                </p>

                <ul>
                    <li>Vanguard Business Gala — elevated networking, refined seated dinner and 3 featured speakers</li>
                    <li>Retro Glam — immersive retro experience with strong visual and social moments</li>
                    <li>Flavor Fusion Fest — local cuisine, artisanal beverages and live community energy</li>
                    <li>Mommy and Daddy Break — wellness, comfort and family-oriented sponsor alignment</li>
                </ul>
            </div>

            <div class="sponsor-feature-card">
                <div class="sponsor-price">
                    <i class="fa-solid fa-camera-retro"></i>
                    Sponsored Photo Booth Experience — $1,690
                </div>

                <h4>Signature visual integration</h4>
                <p>
                    One of the strongest offers from your current page. It is easy to understand, highly visual and naturally sponsor-friendly.  
                </p>

                <ul>
                    <li>Available for Vanguard Business Gala, Flavor Fusion Fest and Retro Glam</li>
                    <li>Exclusive branding of one themed photo booth area</li>
                    <li>Choose from custom backdrop concepts</li>
                    <li>Logo integration in booth design, photo overlays and printing</li>
                    <li>Recognition in signage, digital guide and website</li>
                    <li>4 VIP tickets included</li>
                </ul>

                <div class="sponsor-actions" style="margin-top:22px;">
                    <a href="#" data-vnv-open-sponsor class="vnv-btn btn-gold-vnv">Sponsor Inquiry</a>
                </div>
            </div>
        </div>

        <div class="sponsor-packages-grid">
            <div class="sponsor-tier-card">
                <div class="sponsor-price">
                    <i class="fa-solid fa-puzzle-piece"></i>
                    Standard Exhibitor Package — $460
                </div>

                <h4>Exhibitor visibility with practical value</h4>
                <ul>
                    <li>Best fit for Flavor Fusion Fest and selected business-forward editions</li>
                    <li>8×8 ft exhibitor space (table or booth option)</li>
                    <li>Listing in printed and digital event guide</li>
                    <li>Logo placement on sponsor webpage</li>
                    <li>2 general admission tickets included</li>
                </ul>
            </div>

            <div class="sponsor-tier-card">
                <div class="sponsor-price">
                    <i class="fa-solid fa-microphone"></i>
                    Speaker Add-On — $220
                </div>

                <h4>Thought leadership without a full booth package</h4>
                <ul>
                    <li>Great fit for business-driven and educational event formats</li>
                    <li>Speaking slot during conference or workshop segment</li>
                    <li>Recognition in printed program and social graphics</li>
                    <li>On-stage business mention</li>
                    <li>1 additional VIP ticket included</li>
                </ul>
            </div>

            <div class="sponsor-tier-card">
                <div class="sponsor-price">
                    <i class="fa-solid fa-rocket"></i>
                    Emerging Entrepreneur Package — $120
                </div>

                <h4>Accessible entry point for newer brands</h4>
                <ul>
                    <li>Works across all VNV production formats</li>
                    <li>Logo featured on main booth design and event banner</li>
                    <li>Recognition in event marketing emails</li>
                    <li>Spotlight interview featured on website</li>
                    <li>1 VIP + 2 General Admission tickets included</li>
                </ul>
            </div>

            <div class="sponsor-tier-card">
                <div class="sponsor-price">
                    <i class="fa-solid fa-building-columns"></i>
                    Premium Booth or Anchor Integration
                </div>

                <h4>For brands that want stronger positioning</h4>
                <ul>
                    <li>Best aligned with Vanguard Business Gala and flagship editions</li>
                    <li>Primary booth placement or enhanced lounge presence</li>
                    <li>Featured placement on website and digital materials</li>
                    <li>Higher-touch hospitality and guest interaction opportunities</li>
                    <li>Ideal for brands that want more than logo exposure</li>
                </ul>
            </div>
        </div>

        <p class="sponsor-note">
            Package availability may vary by event, format and audience size. Custom sponsor integrations are also available for brands looking for a more tailored presence.
        </p>
    </div>
</section>

<section class="section-vnv section-white">
    <div class="container">
        <div class="section-heading">
            <span class="vnv-badge">Why It Works</span>
            <h2>Not just standalone nights — <span class="text-vnv">recurring ecosystems</span></h2>
            <p>
                The real strength here is that these are not random events. They can become recurring platforms where guests, brands and community keep meeting under the VNV umbrella.
            </p>
        </div>

        <div class="row g-4">
