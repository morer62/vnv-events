{% extends "templates/base.twig" %}
{% block title %}VNV Original Experiences | Retro Glam & Mommy and Daddy Break{% endblock %}
{% block meta_description %}Join the priority list for Retro Glam or Mommy and Daddy Break, two original South Florida social experiences currently in development by VNV Events.{% endblock %}
{% block canonical %}https://vnvevents.com/vnv-events-productions/{% endblock %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-partnerships.css') }}">
<style>
.originals-hero{padding:clamp(90px,13vw,170px) 0;color:#fff;background:radial-gradient(circle at 80% 10%,rgba(94,198,196,.22),transparent 35%),#0b1517}.originals-hero h1{max-width:900px;margin:0;color:#fff;font-size:clamp(3.1rem,8vw,7.2rem);font-weight:850;line-height:.92;letter-spacing:-.065em}.originals-hero p{max-width:760px;margin:24px 0 0;color:rgba(255,255,255,.75);font-size:1.16rem;line-height:1.75}.originals-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.original-card{min-width:0;overflow:hidden;border:1px solid rgba(16,25,27,.12);border-radius:28px;background:#fff;box-shadow:0 24px 70px rgba(12,29,31,.1)}.original-card__image{aspect-ratio:16/10;overflow:hidden;background:#102126}.original-card__image img{width:100%;height:100%;object-fit:cover;transition:transform .4s ease}.original-card:hover img{transform:scale(1.035)}.original-card__body{padding:clamp(24px,4vw,40px)}.original-card h2{margin:0;font-size:clamp(2rem,4vw,3.5rem);font-weight:850;line-height:1}.original-card p,.original-card li{color:#596668;line-height:1.7}.original-card ul{padding-left:20px}.original-label{display:inline-flex;margin-bottom:16px;padding:7px 11px;border-radius:999px;color:#123638;background:#d9f5f3;font-size:.72rem;font-weight:900;letter-spacing:.09em;text-transform:uppercase}@media(max-width:760px){.originals-grid{grid-template-columns:1fr}.originals-hero{padding:76px 0 90px}}
</style>
{% endblock %}

{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}
<main class="vnv-partnership-page">
  <section class="originals-hero"><div class="vnvp-container"><span class="vnvp-eyebrow">VNV Original Experiences</span><h1>Two concepts. Thoughtfully in development.</h1><p>VNV creates hospitality-led social experiences for South Florida. Retro Glam and Mommy &amp; Daddy Break are currently in development; join a priority list for future announcements, venue collaboration or brand-partner opportunities.</p></div></section>
  <section class="vnvp-section"><div class="vnvp-container originals-grid">
    <article class="original-card"><div class="original-card__image"><img src="{{ asset_for('assets/images/productions/retro-glam.jpg') }}" alt="Retro Glam original experience concept by VNV Events" width="900" height="562"></div><div class="original-card__body"><span class="original-label">Elegant night gala · Coming soon</span><h2>Retro Glam</h2><p>A polished South Florida night inspired by the music, fashion and visual energy of the 1970s through the 1990s.</p><ul><li>Interest options: attendee, VIP, sponsor or venue partner</li><li>Concept and date are still in development</li><li>No ticket sale is open on this page</li></ul><a class="vnvp-button" href="{{ path('vnv-events-productions/retro-glam') }}">Explore Retro Glam</a></div></article>
    <article class="original-card"><div class="original-card__image"><img src="{{ asset_for('assets/images/productions/mommy-and-daddy-break.jpg') }}" alt="Mommy and Daddy Break original morning social concept by VNV Events" width="900" height="562"></div><div class="original-card__body"><span class="original-label">Approx. 3-hour morning social · Coming soon</span><h2>Mommy &amp; Daddy Break</h2><p>A relaxed morning experience with hospitality, music, conversation and restorative moments for adults.</p><ul><li>Interest options: attending, venue partner or brand partner</li><li>This concept does not provide or promise childcare</li><li>No ticket sale is open on this page</li></ul><a class="vnvp-button" href="{{ path('vnv-events-productions/mommy-and-daddy-break') }}">Explore the Morning Social</a></div></article>
  </div></section>

  <section class="vnvp-section vnvp-section--soft" id="priority-list"><div class="vnvp-container vnvp-form-wrap">
    <div class="vnvp-form-intro"><span class="vnvp-eyebrow">Priority list</span><h2>Tell us which experience interests you.</h2><p>This is an interest list, not a ticket purchase or event confirmation. We will only use these details for the selected VNV original experience and related follow-up.</p></div>
    <form class="vnvp-form" action="{{ path('api/public/partnership-request') }}" method="post">
      {% if submitted %}<div class="vnvp-success" role="status"><strong>You're on the list.</strong> We sent an acknowledgment with your reference number.</div>{% endif %}
      <input type="hidden" name="program" value="ORIGINAL"><input type="hidden" name="_token" value="{{ partnership_csrf }}">
      <div class="vnvp-hidden" aria-hidden="true"><label>Website confirmation<input type="text" name="website_confirm" tabindex="-1" autocomplete="off"></label></div>
      {% for key in ['gclid','gbraid','wbraid','utm_source','utm_medium','utm_campaign','utm_term','utm_content','landing_url'] %}<input type="hidden" name="{{ key }}" data-attribution="{{ key }}">{% endfor %}
      <div class="vnvp-fields">
        <div class="vnvp-field vnvp-field--full"><label for="original-event">Experience *</label><select id="original-event" name="event_name" required><option value="">Select</option><option>Retro Glam</option><option>Mommy and Daddy Break</option></select></div>
        <fieldset class="vnvp-group"><legend>I am interested in</legend><div class="vnvp-checks">{% for option in ['Attending','VIP updates','Sponsor / brand partner','Venue partner'] %}<label class="vnvp-check"><input type="checkbox" name="requested_services[]" value="{{ option }}"><span>{{ option }}</span></label>{% endfor %}</div></fieldset>
        <div class="vnvp-field"><label for="original-name">Name *</label><input id="original-name" name="contact_name" required maxlength="191"></div>
        <div class="vnvp-field"><label for="original-role">Company / role</label><input id="original-role" name="contact_role" maxlength="150"></div>
        <div class="vnvp-field"><label for="original-email">Email *</label><input id="original-email" name="email" type="email" required maxlength="191"></div>
        <div class="vnvp-field"><label for="original-phone">Phone *</label><input id="original-phone" name="phone" type="tel" required maxlength="80"></div>
        <div class="vnvp-field vnvp-field--full"><label for="original-notes">Notes</label><textarea id="original-notes" name="notes" maxlength="1000"></textarea></div>
      </div>
      <label class="vnvp-consent"><input type="checkbox" name="consent" value="1" required><span>I agree that VNV Events may contact me about the selected original experience. I understand this is not a ticket, invitation or confirmed event date.</span></label>
      <button class="vnvp-button vnvp-button--gold" type="submit">Join Priority List</button>
    </form>
  </div></section>
</main>
{% include "templates/layout/publicFooterVnv.html.twig" %}
{% endblock %}
{% block scripts %}<script>(function(){const params=new URLSearchParams(location.search);document.querySelectorAll('[data-attribution]').forEach(function(input){input.value=input.dataset.attribution==='landing_url'?location.href:(params.get(input.dataset.attribution)||'');});})();</script>{% endblock %}
