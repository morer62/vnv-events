{% extends "templates/base.twig" %}
{% block title %}VNV Original Experiences | Retro Glam & Mommy and Daddy Break{% endblock %}
{% block meta_description %}Explore two VNV Originals in South Florida. Join the free Break Club priority list for morning socials or get updates on Retro Glam Sessions, a throwback dance night.{% endblock %}
{% block canonical %}https://vnvevents.com/vnv-events-productions/{% endblock %}
{% block og_image %}https://vnvevents.com/assets/video/production-films/v3/original-experiences.webp{% endblock %}
{% block og_image_alt %}A preview of VNV’s original South Florida experiences{% endblock %}
{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-partnerships.css') }}">
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-production-offers.css', { v: 'production-films-2' }) }}">
{% include "templates/components/vnvProductionEditorialAssets.html.twig" %}
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-originals.css', { v: 'deco-editions-1' }) }}">
{% endblock %}

{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}
<main class="vnv-partnership-page vo-page">
  {% include "templates/components/vnvProductionHero.html.twig" with {
    hero: {
      slug: 'original-experiences',
      label: 'VNV Original Experiences · South Florida',
      title: 'Original experiences',
      emphasis: 'by VNV Events.',
      description: 'A slow morning together or a night worth dressing up for. Explore two experiences we produce in South Florida.',
      details: ['Mommy & Daddy Break Club · Morning socials for parents', 'Retro Glam Sessions · Throwback music and dancing'],
      cta: 'Explore the experiences',
      href: '#original-experiences',
      preview_label: 'Illustrative scenes from the Break Club morning and Retro Glam night concepts'
    }
  } only %}

  <section class="vnvp-section vo-collection" id="original-experiences" aria-label="Choose your experience">
    <div class="vnvp-container vo-grid">
      <article class="vo-card">
        <div class="vo-card__image">
          <img loading="lazy" decoding="async" src="{{ asset_for('assets/break-club/hero-poster.webp') }}" width="1440" height="810" alt="Friends sharing coffee at a shaded outdoor table">
        </div>
        <div class="vo-card__body">
          <p class="vo-card__time">Morning · For parents</p>
          <h2>Mommy &amp; Daddy Break Club</h2>
          <p class="vo-card__intro">Meet other parents over brunch, music and a little time to yourself at rotating South Florida venues.</p>
          <p class="vo-card__terms">Join the free priority list for one or two adults. The club does not provide or promise childcare.</p>
          <a class="vo-link" href="{{ path('vnv-events-productions/mommy-and-daddy-break') }}">Explore the club &amp; join the list <span aria-hidden="true">→</span></a>
        </div>
      </article>
      <article class="vo-card vo-card--night">
        <div class="vo-card__image">
          <img loading="lazy" decoding="async" src="{{ asset_for('assets/original-experiences/retro-glam-ballroom.webp') }}" width="1440" height="1080" alt="A Retro Glam concept ballroom with brass Art Deco arches, a live DJ and dancers">
        </div>
        <div class="vo-card__body">
          <p class="vo-card__time">Evening · Music &amp; nightlife</p>
          <h2>Retro Glam Sessions</h2>
          <p class="vo-card__intro">Choose a night devoted to your favorite decade. The DJ, the dress and the photo sets change for each edition in a Miami Art Deco setting.</p>
          <p class="vo-card__terms">The first edition is in development. Join the priority list for date, venue and ticket announcements.</p>
          <a class="vo-link" href="{{ path('vnv-events-productions/retro-glam') }}">Explore Retro Glam <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </div>
  </section>

  {% include "templates/components/vnvProductionFilm.html.twig" with {
    film: {
      slug: 'original-experiences',
      route: 'vnv-events-productions',
      title: 'Meet the VNV originals',
      description: 'Meet other parents over coffee at Break Club, or dress for a night of throwback music at Retro Glam. Each experience has its own invitation list.',
      cta: 'Choose your experience',
      href: '#original-experiences'
    }
  } only %}

  <section class="vnvp-section vnvp-section--soft vo-signup" id="priority-list" aria-labelledby="retro-list-title">
    <div class="vnvp-container vnvp-form-wrap" id="application">
      <div class="vnvp-form-intro">
        <span class="vnvp-eyebrow">Retro Glam Sessions</span>
        <h2 id="retro-list-title">Be first to hear about the next night.</h2>
        <p>Leave your email for the date, venue and ticket details when the first edition is announced. Looking for the morning socials? <a href="{{ path('vnv-events-productions/mommy-and-daddy-break') }}#waitlist">Join the Break Club list.</a></p>
      </div>
      <form class="vnvp-form" action="{{ path('api/public/partnership-request') }}" method="post">
        {% if submitted and alertMessage.type|default('') == 'success' %}
          <div class="vnvp-success" role="status" tabindex="-1" data-originals-confirmed><strong>You’re on the Retro Glam list.</strong> We’ll contact you when event details are announced.</div>
        {% endif %}
        <input type="hidden" name="program" value="ORIGINAL">
        <input type="hidden" name="_token" value="{{ partnership_csrf }}">
        <input type="hidden" name="event_name" value="Retro Glam">
        <input type="hidden" name="requested_services[]" value="Priority list updates">
        <div class="vnvp-hidden" aria-hidden="true"><label>Website confirmation<input type="text" name="website_confirm" tabindex="-1" autocomplete="off"></label></div>
        {% for key in ['gclid','gbraid','wbraid','utm_source','utm_medium','utm_campaign','utm_term','utm_content','landing_url'] %}
          <input type="hidden" name="{{ key }}" data-attribution="{{ key }}">
        {% endfor %}
        <div class="vnvp-fields">
          <div class="vnvp-field"><label for="original-name">Name *</label><input id="original-name" name="contact_name" autocomplete="name" required maxlength="191"></div>
          <div class="vnvp-field"><label for="original-email">Email *</label><input id="original-email" name="email" type="email" autocomplete="email" required maxlength="191"></div>
          <div class="vnvp-field"><label for="original-phone">Phone (optional)</label><input id="original-phone" name="phone" type="tel" autocomplete="tel" maxlength="80"></div>
        </div>
        <label class="vnvp-consent"><input type="checkbox" name="consent" value="1" required><span>I agree that VNV Events may contact me about Retro Glam Sessions. I understand this is not a ticket, invitation or confirmed event date.</span></label>
        <button class="vnvp-button vnvp-button--gold" type="submit">Join Priority List</button>
      </form>
    </div>
  </section>
</main>
{% include "templates/layout/publicFooterVnv.html.twig" %}
{% endblock %}
{% block scripts %}
<script>
(function () {
  const params = new URLSearchParams(location.search);
  document.querySelectorAll('#priority-list [data-attribution]').forEach(function (input) {
    const key = input.dataset.attribution;
    input.value = key === 'landing_url' ? location.href : (params.get(key) || '');
  });
  const confirmation = document.querySelector('[data-originals-confirmed]');
  if (confirmation) confirmation.focus();
})();
</script>
{% endblock %}
