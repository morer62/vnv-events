{% extends "templates/base.twig" %}
{% block title %}Mommy &amp; Daddy Break Club | South Florida Morning Socials{% endblock %}
{% block meta_description %}A morning of coffee, music and conversation for South Florida parents. Join the free Mommy &amp; Daddy Break Club priority list for invitations to individually ticketed events.{% endblock %}
{% block canonical %}https://vnvevents.com/vnv-events-productions/mommy-and-daddy-break/{% endblock %}
{% block og_image %}https://vnvevents.com/assets/break-club/hero-miami-morning.webp{% endblock %}
{% block og_image_alt %}Illustrative Miami poolside brunch for the Mommy and Daddy Break Club{% endblock %}
{% block styles %}
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-partnerships.css') }}">
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-production-offers.css', { v: 'production-films-2' }) }}">
{% include "templates/components/vnvProductionEditorialAssets.html.twig" %}
<link rel="stylesheet" href="{{ asset_for('assets/break-club/landing.css', { v: 'morning-film-2' }) }}">
{% endblock %}
{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}
<main class="break-club">
    <section class="bc-hero" aria-labelledby="club-title">
        <div class="bc-hero-copy">
            <img class="bc-logo" width="544" height="118" src="{{ asset_for('assets/break-club/club-logo.svg') }}" alt="Mommy &amp; Daddy Break Club">
            <p class="bc-kicker">A South Florida social club for parents</p>
            <h1 id="club-title">A morning<br><em>of your own.</em></h1>
            <p>Finish a coffee while it’s still warm. Hear the end of a story. Spend a few hours with adults who get it.</p>
            <p class="bc-cadence">We’re planning two mornings a month, each at a different South Florida venue.</p>
            <a class="bc-button" href="#waitlist">Join the free priority list <span aria-hidden="true">↗</span></a>
            <a class="bc-member-link" href="{{ path('panel/break-club') }}">Already a member? Open your dashboard</a>
        </div>
        <div class="bc-hero-film" data-vnv-preview data-mobile-width="610">
            <video id="club-film" muted loop playsinline preload="none" poster="{{ asset_for('assets/break-club/hero-miami-morning.webp') }}" aria-label="A concept preview of a Miami morning club for parents with poolside brunch, a DJ, massage tables, photo moments and relaxed conversation" data-src="{{ asset_for('assets/break-club/hero-miami-morning.mp4') }}" data-mobile-src="{{ asset_for('assets/break-club/hero-miami-morning-mobile.mp4') }}"></video>
            <button class="bc-film-toggle" type="button" aria-controls="club-film" data-pause-label="Pause film" hidden>Play film</button>
        </div>
    </section>

    <section class="bc-story bc-shell" id="experience" aria-labelledby="experience-title">
        <div>
            <p class="bc-kicker">A sample three-hour morning</p>
            <h2 id="experience-title">Come alone.<br><em>Pull up a chair.</em></h2>
            <p class="bc-intro">Come on your own or invite one other adult. Each edition gives you time to recharge, meet other parents and discover a different South Florida setting. Each invitation lists the venue, activities and what your ticket includes.</p>
            <p class="bc-intro">Childcare is arranged separately by each guest.</p>
            <a class="bc-text-link bc-watch-link" data-vnv-watch-film href="#morning-club-film">Watch the club film with sound</a>
        </div>
        <div id="agenda">
            <ol class="bc-agenda" role="list">
                <li><span class="bc-agenda-time">First 30 min</span><div><h3>Arrive and settle in</h3><p>Meet the hosts over coffee, matcha or a welcome drink and enjoy brunch bites.</p></div></li>
                <li><span class="bc-agenda-time">30–75 min</span><div><h3>Meet someone new</h3><p>A morning DJ sets the pace while hosts make easy introductions. Share a table, exchange ideas or make a connection worth following up on.</p></div></li>
                <li><span class="bc-agenda-time">75–135 min</span><div><h3>Make time for yourself</h3><p>Take a quiet pause or reserve a short session at a massage table when offered.</p></div></li>
                <li><span class="bc-agenda-time">135–180 min</span><div><h3>Stay for one more conversation</h3><p>Take a photo, trade contact details if you like and head back to your day at your own pace.</p></div></li>
            </ol>
            <div class="bc-edition-note">
                <h3>On select dates</h3>
                <p>Try a separate beginner-friendly yoga or mobility class, a short guided breathing session or a wellness demonstration hosted by a partner. Each edition has its own program.</p>
            </div>
        </div>
    </section>

    {% include "templates/components/vnvProductionFilm.html.twig" with {
      film: {
        slug: 'morning-club',
        route: 'vnv-events-productions/mommy-and-daddy-break/',
        title: 'Time for one more coffee',
        description: 'Imagine a morning at the club, from the first pour to a conversation you can finish. Each invitation includes the venue, price and booking link.',
        cta: 'Join the free priority list',
        href: '#waitlist'
      }
    } only %}

    <section id="waitlist" class="bc-signup" aria-labelledby="signup-title">
        <div class="bc-shell bc-signup-grid">
            <div class="bc-signup-copy">
                <p class="bc-kicker">The priority list</p>
                <h2 id="signup-title">Get the<br><em>first invitation.</em></h2>
                <p>Joining is free. We’ll email members first when a date opens, with the venue, ticket price and a link to reserve. You choose which mornings to attend.</p>
                <p>Each request is for one or two adults. Tickets are paid per event.</p>
            </div>
            <div class="bc-form-wrap">
            {% if club_checkout_cancelled %}<p class="bc-notice" role="status">You left checkout. To pick up where you left off, reopen the ticket link in your invitation.</p>{% endif %}
            {% if club_received %}
                <div class="bc-notice" role="status"><h3>Check your inbox</h3><p>If your address needs confirmation, you’ll receive a link from VNV Events. Already confirmed? Your spot on the priority list stays active.</p><a href="{{ path('panel/break-club') }}">Open the member dashboard</a></div>
            {% else %}
                {% if club_error %}<p class="bc-alert" role="alert">{{ club_error }}</p>{% endif %}
                <form id="club-signup" action="{{ path('api/public/break-club/join') }}" method="post">
                    <input type="hidden" name="_token" value="{{ club_csrf }}">
                    {% for key, value in club_attribution %}<input type="hidden" name="{{ key }}" value="{{ value }}">{% endfor %}
                    <div class="bc-honey" aria-hidden="true"><label>Leave this field blank<input name="website_confirm" tabindex="-1" autocomplete="off"></label></div>
                    <div class="bc-fields">
                        <label class="bc-wide">Full name<input name="name" autocomplete="name" required maxlength="150"></label>
                        <label>Email address<input type="email" name="email" autocomplete="email" required maxlength="190"></label>
                        <label>Phone number<input type="tel" name="phone" autocomplete="tel" required maxlength="32"></label>
                        <label>People in your party<select name="party_size" id="bc-party-size"><option value="1">Just me</option><option value="2">Me and one adult guest</option></select></label>
                        <label>Top interest<select name="category">{% for key, label in club_categories %}<option value="{{ key }}">{{ label }}</option>{% endfor %}</select></label>
                        <div class="bc-wide bc-companion" id="bc-companion"><label>Guest’s full name <small>(for a party of two)</small><input name="companion_name" maxlength="150" autocomplete="off"></label><label>Guest email <small>(optional)</small><input type="email" name="companion_email" maxlength="190" autocomplete="off"></label></div>
                    </div>
                    <label class="bc-consent"><input type="checkbox" name="consent" value="1" required><span>I agree to receive Mommy &amp; Daddy Break Club event invitations by email from VNV Events. I can unsubscribe at any time.</span></label>
                    <button class="bc-button bc-submit" type="submit">Join the priority list <span aria-hidden="true">↗</span></button>
                </form>
            {% endif %}
            </div>
        </div>
    </section>
    <aside class="bc-shell bc-partners"><div><p class="bc-kicker">Venue &amp; brand partners</p><h2>Host a morning with us.</h2><p>Host an edition or sponsor a part of the morning, from the welcome bar to a massage station, movement class or photo moment.</p></div><button class="bc-text-link" type="button" data-vnv-open-sponsor>Talk to VNV Events <span aria-hidden="true">↗</span></button></aside>
</main>
{% include "templates/components/publicSponsorRequestModal.html.twig" with { sponsor_form_action: path('api/public/sponsor-request') } %}
{% include "templates/layout/publicFooterVnv.html.twig" %}
{% endblock %}
{% block scripts %}
<script defer src="{{ asset_for('assets/break-club/landing.js', { v: 'party-fields-1' }) }}"></script>
{% endblock %}
