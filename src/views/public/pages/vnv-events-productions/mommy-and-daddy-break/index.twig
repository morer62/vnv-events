{% extends "templates/base.twig" %}

{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&display=swap" rel="stylesheet">

<style>
:root {
    --vnv-primary: #5EC6C4;
    --vnv-primary-dark: #4aa8a6;
    --vnv-gold: #d8b55b;
    --vnv-gold-gradient: linear-gradient(135deg, #e6c86d 0%, #fff2bf 45%, #c79b36 100%);
    --vnv-sun: #f7d36f;
    --vnv-sky: #9ed8e8;
    --vnv-cream: #fff8ec;
    --vnv-dark-deep: #0a0c0c;
    --vnv-dark-soft: #141818;
    --vnv-dark-card: #171b1c;
    --vnv-light: #ffffff;
    --vnv-marble: #f7f7f3;
    --vnv-text-dark: #11181a;
    --vnv-text-light: #f3f5f6;
    --vnv-text-muted: rgba(255,255,255,.74);
    --vnv-text-muted-dark: #536063;
    --vnv-border: rgba(255,255,255,.08);
    --vnv-shadow-lg: 0 40px 100px rgba(0,0,0,.24);
}

html { scroll-behavior: smooth; }

html, body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
}

body {
    background: var(--vnv-dark-deep);
    color: var(--vnv-text-light);
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

*, *::before, *::after {
    box-sizing: border-box;
}

h1, h2, h3, h4, h5 {
    font-family: 'Playfair Display', serif;
}

.text-vnv { color: var(--vnv-primary) !important; }
.text-sun { color: var(--vnv-sun) !important; }
.text-gold {
    background: var(--vnv-gold-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.vnv-btn {
    padding: 18px 30px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: all .35s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: .78rem;
    border-radius: 999px;
}

.btn-gold-vnv {
    background: var(--vnv-gold-gradient);
    color: #000 !important;
}
.btn-gold-vnv:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 40px rgba(216,181,91,.24);
}

.btn-outline-vnv {
    border: 2px solid var(--vnv-primary);
    color: var(--vnv-primary) !important;
    background: transparent;
}
.btn-outline-vnv:hover {
    background: var(--vnv-primary);
    color: #fff !important;
}

.btn-sun-vnv {
    border: 2px solid rgba(247,211,111,.8);
    color: var(--vnv-sun) !important;
    background: transparent;
}
.btn-sun-vnv:hover {
    background: var(--vnv-sun);
    color: #111 !important;
}

.section-vnv {
    padding: 120px 0;
    position: relative;
}

.section-white {
    background: var(--vnv-cream);
    color: var(--vnv-text-dark);
}

.section-dark {
    background: linear-gradient(180deg, #0a0c0c 0%, #0d1114 100%);
    color: var(--vnv-text-light);
}

.vnv-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(94,198,196,.12);
    color: var(--vnv-primary);
    font-size: .74rem;
    letter-spacing: 2px;
    font-weight: 800;
    text-transform: uppercase;
}

.vnv-badge--sun {
    background: rgba(247,211,111,.14);
    color: var(--vnv-sun);
}

.vnv-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: .88rem;
    color: rgba(255,255,255,.66);
    margin-top: 18px;
}
.vnv-breadcrumbs a {
    color: rgba(255,255,255,.8);
    text-decoration: none;
}
.vnv-breadcrumbs span.sep {
    opacity: .4;
}

.event-hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
        linear-gradient(90deg, rgba(10,12,12,.82) 0%, rgba(10,12,12,.60) 38%, rgba(10,12,12,.28) 100%),
        url('{{ asset_for('assets/images/productions/mommy-and-daddy-break-hero.jpg') }}') center/cover no-repeat;
}

.event-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at top left, rgba(158,216,232,.18), transparent 26%),
        radial-gradient(circle at top right, rgba(247,211,111,.18), transparent 30%),
        radial-gradient(circle at bottom left, rgba(94,198,196,.14), transparent 22%);
    pointer-events: none;
}

.event-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
}

.event-hero h1 {
    font-size: clamp(3rem, 6vw, 5.2rem);
    line-height: 1.02;
    margin: 20px 0 24px;
    max-width: 940px;
}

.event-hero .hero-copy {
    font-size: 1.08rem;
    color: rgba(255,255,255,.84);
    max-width: 780px;
    margin-bottom: 18px;
}

.hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin: 34px 0 28px;
}

.section-heading {
    max-width: 960px;
    margin-bottom: 55px;
}
.section-heading h2 {
    font-size: clamp(2.2rem, 4vw, 4.3rem);
    line-height: 1.04;
    margin: 16px 0 18px;
}
.section-dark .section-heading p {
    color: var(--vnv-text-muted);
}
.section-white .section-heading p {
    color: #5a6669;
}

.experience-grid,
.agenda-list,
.info-grid,
.sponsor-grid {
    display: grid;
    gap: 22px;
}

.experience-grid {
    grid-template-columns: 1fr 1fr;
}

.info-grid,
.sponsor-grid {
    grid-template-columns: 1fr 1fr;
}

.card-vnv,
.agenda-card {
    border-radius: 30px;
    padding: 30px;
    box-shadow: 0 20px 60px rgba(0,0,0,.10);
}

.section-dark .card-vnv,
.section-dark .agenda-card {
    background: linear-gradient(145deg, rgba(28,34,35,.95) 0%, rgba(16,18,18,.96) 100%);
    border: 1px solid rgba(255,255,255,.07);
}

.section-white .card-vnv {
    background: linear-gradient(180deg, #fffdf8 0%, #fff9f0 100%);
    border: 1px solid rgba(17,24,26,.08);
}

.card-vnv h3,
.agenda-card h3,
.card-vnv h4 {
    margin-bottom: 14px;
}

.section-dark .card-vnv h3,
.section-dark .card-vnv h4,
.section-dark .agenda-card h3 {
    color: #fff;
}

.section-white .card-vnv h3,
.section-white .card-vnv h4 {
    color: var(--vnv-text-dark);
}

.card-vnv p,
.agenda-card p {
    margin: 0;
}

.section-dark .card-vnv p,
.section-dark .agenda-card p {
    color: var(--vnv-text-muted);
}

.section-white .card-vnv p {
    color: #485457;
}

.card-icon {
    width: 58px;
    height: 58px;
    border-radius: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    background: linear-gradient(135deg, rgba(247,211,111,.22), rgba(158,216,232,.18));
    color: #9f7a18;
    font-size: 1.2rem;
}

.agenda-list {
    grid-template-columns: 1fr;
}

.agenda-card {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 30px;
    align-items: start;
}

.agenda-time {
    color: #e8c776;
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1.2;
}

.agenda-card h3 {
    font-size: 1.9rem;
    line-height: 1.05;
}

.detail-list {
    list-style: none;
    padding-left: 0;
    margin: 0;
}

.detail-list li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 8px;
}

.detail-list li::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vnv-gold);
    position: absolute;
    left: 0;
    top: 12px;
}

.call-strip {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid rgba(255,255,255,.08);
}
.call-strip a {
    color: var(--vnv-primary);
    text-decoration: none;
    font-weight: 800;
    letter-spacing: 1px;
}

.event-visual {
    min-height: 420px;
    border-radius: 30px;
    overflow: hidden;
    background:
        linear-gradient(180deg, rgba(0,0,0,.06), rgba(0,0,0,.20)),
        url('{{ asset_for('assets/images/productions/mommy-and-daddy-break-detail.jpg') }}') center/cover no-repeat;
    border: 1px solid rgba(255,255,255,.08);
}

@media (max-width: 1199px) {
    .experience-grid,
    .info-grid,
    .sponsor-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 991px) {
    .event-hero {
        min-height: auto;
        padding: 120px 0 80px;
        background-position: center center;
    }

    .agenda-card {
        grid-template-columns: 1fr;
        gap: 16px;
    }

    .event-visual {
        min-height: 300px;
    }
}

@media (max-width: 767px) {
    .section-vnv {
        padding: 90px 0;
    }

    .event-hero h1 {
        font-size: 2.7rem;
    }

    .vnv-btn {
        width: 100%;
    }

    .card-vnv,
    .agenda-card {
        padding: 22px;
    }

    .agenda-card h3 {
        font-size: 1.55rem;
    }
}
</style>
{% endblock %}

{% block body %}

{% include "templates/layout/publicHeaderVnv.html.twig" %}

<section class="event-hero">
    <div class="container event-hero__inner">
        <span class="vnv-badge vnv-badge--sun">VNV Events Productions</span>

        <h1>Mommy and Daddy Break</h1>

        <p class="hero-copy">
            A luxury morning reset designed for parents, professionals and couples who want a better start to the day: good coffee, relaxed conversation, massage stations, polished music and a space that feels light, social and restorative.
        </p>

        <p class="hero-copy">
            This is not a rushed networking breakfast and not a full brunch production. It is a 2-hour coffee-and-chill experience built around connection, recharge and easy premium moments from 9:30 AM to 11:30 AM.
        </p>

        <div class="hero-cta-row">
            <a href="#agenda" class="vnv-btn btn-gold-vnv">View Agenda</a>
            <a href="#experience" class="vnv-btn btn-sun-vnv">The Experience</a>
            <a href="#" data-vnv-open-sponsor class="vnv-btn btn-outline-vnv">Sponsor Inquiry</a>
        </div>

        <div class="vnv-breadcrumbs">
            <a href="{{ path('/') }}">Home</a>
            <span class="sep">/</span>
            <a href="{{ path('vnv-events-productions') }}">VNV Events Productions</a>
            <span class="sep">/</span>
            <span>Mommy and Daddy Break</span>
        </div>
    </div>
</section>

<section class="section-vnv section-white" id="experience">
    <div class="container">
        <div class="section-heading">
            <span class="vnv-badge vnv-badge--sun">The Experience</span>
            <h2>A morning event designed to feel <span class="text-sun">calm, social and worth stepping out for</span></h2>
            <p>
                Mommy and Daddy Break is built around what people actually want from a premium morning event: good coffee, something light to sip, a chance to reset, good music in the background, real conversation and small wellness moments that make the morning feel different from the rest of the week.
            </p>
        </div>

        <div class="experience-grid">
            <div class="card-vnv">
                <div class="card-icon"><i class="fa-solid fa-mug-hot"></i></div>
                <h3>Coffee, matcha and brunch-style drinks</h3>
                <p>
                    The morning starts with energy, but in a polished way. Coffee service, matcha options and a small menu of brunch-style drinks help guests settle in, circulate and enjoy the event without it feeling heavy or overproduced.
                </p>
            </div>

            <div class="card-vnv">
                <div class="card-icon"><i class="fa-solid fa-hand-sparkles"></i></div>
                <h3>Massage and recharge stations</h3>
                <p>
                    Quick wellness moments make this format stand out. Chair massage, neck-and-shoulder resets or sponsor-led relaxation stations give guests a reason to pause, recharge and stay longer.
                </p>
            </div>

            <div class="card-vnv">
                <div class="card-icon"><i class="fa-solid fa-music"></i></div>
                <h3>Morning DJ mood and soft social energy</h3>
                <p>
                    Music should feel present but never aggressive. A morning DJ set with elegant house, chill edits, soft latin grooves or soulful brunch energy keeps the room alive while still leaving space for conversation.
                </p>
            </div>

            <div class="card-vnv">
                <div class="card-icon"><i class="fa-solid fa-people-arrows"></i></div>
                <h3>Connection without pressure</h3>
                <p>
                    The event works best when people can connect naturally. Parents, professionals, couples and local brands can talk, meet and relax without the pressure of a formal networking structure.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="section-vnv section-dark" id="agenda">
    <div class="container">
        <div class="section-heading">
            <span class="vnv-badge vnv-badge--sun">Agenda</span>
            <h2>A 2-hour morning reset with flow and breathing room</h2>
            <p>
                The event is designed to run from 9:30 AM to 11:30 AM, giving guests time to arrive, enjoy the coffee-and-wellness experience, connect at a relaxed pace and leave feeling better than when they came in.
            </p>
        </div>

        <div class="agenda-list">
            <div class="agenda-card">
                <div class="agenda-time">9:30 – 10:00 AM</div>
                <div>
                    <h3>Arrival, Coffee Bar & Welcome Moments</h3>
                    <p>
                        Guests arrive into a bright, easy morning environment with coffee, matcha, light bites and the first social interactions of the event.
                    </p>
                </div>
            </div>

            <div class="agenda-card">
                <div class="agenda-time">10:00 – 10:35 AM</div>
                <div>
                    <h3>Wellness Lounge & Massage Stations</h3>
                    <p>
                        This block gives guests time to move through quick reset experiences, visit sponsor activations and enjoy the event at a slower, more restorative pace.
                    </p>
                </div>
            </div>

            <div class="agenda-card">
                <div class="agenda-time">10:35 – 11:05 AM</div>
                <div>
                    <h3>Morning Cocktails, Music & Connection Time</h3>
                    <p>
                        The social center of the event opens up with polished music, a more relaxed brunch-cocktail feel and natural conversation across the room.
                    </p>
                </div>
            </div>

            <div class="agenda-card">
                <div class="agenda-time">11:05 – 11:30 AM</div>
                <div>
                    <h3>Final Recharge, Photos & Event Close</h3>
                    <p>
                        The final stretch gives guests time for one more reset, a few last sponsor moments, photos and a clean close before heading into the rest of the day.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-vnv section-white">
    <div class="container">
        <div class="section-heading">
            <span class="vnv-badge vnv-badge--sun">What Makes It Valuable</span>
            <h2>Why this format works for guests and sponsors</h2>
            <p>
                Mommy and Daddy Break works because it sits between brunch, wellness and casual networking. Guests get a premium morning experience that feels easy to attend, and sponsors get a format where interaction feels natural instead of forced.
            </p>
        </div>

        <div class="info-grid">
            <div class="card-vnv">
                <h4>For guests</h4>
                <ul class="detail-list">
                    <li>Short morning format that fits real schedules</li>
                    <li>Coffee, cocktails and wellness in one polished experience</li>
                    <li>More relaxing than a typical networking breakfast</li>
                    <li>Easy balance of music, conversation and recharge</li>
                </ul>
            </div>

            <div class="card-vnv">
                <h4>For sponsor brands</h4>
                <ul class="detail-list">
                    <li>Strong fit for coffee, wellness, beauty, medspa, family and luxury local brands</li>
                    <li>Massage, skincare and beverage activations feel especially natural here</li>
                    <li>Morning format helps brands feel memorable and personal</li>
                    <li>Guests interact with the experience, not just the signage</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="section-vnv section-dark">
    <div class="container">
        <div class="sponsor-grid">
            <div class="card-vnv">
                <span class="vnv-badge vnv-badge--sun">Sponsor Visibility</span>
                <h3 style="margin-top:18px;">A morning event where brands can feel helpful, present and memorable</h3>
                <p>
                    Sponsorship inside Mommy and Daddy Break works best when the brand becomes part of the reset. Coffee bars, massage stations, beauty touchups, wellness activations, refresh moments and curated product experiences all fit naturally inside this format.
                </p>

                <div class="call-strip">
                    <a href="#" data-vnv-open-sponsor>Open sponsor form</a>
                </div>

                <div style="margin-top:24px;">
                    <a href="#" data-vnv-open-sponsor class="vnv-btn btn-gold-vnv">Sponsor Inquiry</a>
                </div>
            </div>

            <div class="event-visual"></div>
        </div>
    </div>
</section>

{% include "templates/components/publicSponsorRequestModal.html.twig" with {
    sponsor_form_action: "/api/public/sponsor-request"
} %}

{% include "templates/layout/publicFooterVnv.html.twig" %}

{% endblock %}

{% block scripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<script>
if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
    const isMobile = window.innerWidth <= 767;

    if (!isMobile) {
        gsap.registerPlugin(ScrollTrigger);

        gsap.utils.toArray('.card-vnv, .agenda-card, .event-visual').forEach((card) => {
            gsap.from(card, {
                scrollTrigger: {
                    trigger: card,
                    start: "top 88%"
                },
                y: 36,
                opacity: 0,
                duration: 0.9,
                ease: "power3.out"
            });
        });
    }
}
</script>
{% endblock %}