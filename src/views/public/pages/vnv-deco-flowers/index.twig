{% extends "templates/base.twig" %}

{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&display=swap" rel="stylesheet">

<style>
:root {
    --vnv-primary: #5EC6C4;
    --vnv-primary-dark: #4aa8a6;
    --vnv-gold: #c5a059;
    --vnv-gold-gradient: linear-gradient(135deg, #bf953f 0%, #fcf6ba 45%, #b38728 100%);
    --vnv-dark-deep: #0a0c0c;
    --vnv-dark-soft: #141818;
    --vnv-dark-card: #1b2021;
    --vnv-light: #ffffff;
    --vnv-marble: #f4f7f8;
    --vnv-text-main: #2d3436;
    --vnv-text-dark: #11181a;
    --vnv-text-light: #f3f5f6;
    --vnv-text-muted: rgba(255,255,255,.74);
    --vnv-text-muted-soft: rgba(255,255,255,.60);
    --vnv-border: rgba(255,255,255,.08);
}

html { scroll-behavior: smooth; }

body {
    background: var(--vnv-dark-deep);
    color: var(--vnv-text-light);
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

h1, h2, h3, h4, h5, .luxury-font {
    font-family: 'Playfair Display', serif;
}

.text-vnv { color: var(--vnv-primary) !important; }
.text-gold {
    background: var(--vnv-gold-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.letter-spacing-lg { letter-spacing: 4px; }

.vnv-btn {
    padding: 18px 30px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: all .35s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: .78rem;
    border-radius: 999px;
}

.btn-gold-vnv {
    background: var(--vnv-gold-gradient);
    color: #000 !important;
}
.btn-gold-vnv:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 40px rgba(197,160,89,.22);
}
.btn-outline-vnv {
    border: 2px solid var(--vnv-primary);
    color: var(--vnv-primary) !important;
    background: transparent;
}
.btn-outline-vnv:hover {
    background: var(--vnv-primary);
    color: #fff !important;
}
.btn-ghost-white {
    border: 1px solid rgba(255,255,255,.18);
    color: #fff !important;
    background: transparent;
}
.btn-ghost-white:hover {
    background: #fff;
    color: #000 !important;
}

.section-vnv {
    padding: 120px 0;
    position: relative;
}

.vnv-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(94,198,196,.1);
    color: var(--vnv-primary);
    font-size: .74rem;
    letter-spacing: 2px;
    font-weight: 800;
    text-transform: uppercase;
}

.hero-deco {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
        linear-gradient(90deg, rgba(10,12,12,.88) 0%, rgba(10,12,12,.68) 42%, rgba(10,12,12,.42) 100%),
        url('{{ asset_for('assets/images/deco1.jpg') }}') center/cover no-repeat;
}

.hero-deco::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at top right, rgba(94,198,196,.16), transparent 28%),
        radial-gradient(circle at bottom left, rgba(197,160,89,.10), transparent 24%);
    pointer-events: none;
}

.hero-deco-inner {
    position: relative;
    z-index: 2;
    width: 100%;
}

.hero-deco h1 {
    font-size: clamp(3rem, 6vw, 5.4rem);
    line-height: 1.02;
    margin: 20px 0 28px;
    max-width: 920px;
}

.hero-deco p.hero-copy {
    font-size: 1.08rem;
    color: var(--vnv-text-muted);
    max-width: 760px;
    margin-bottom: 34px;
}

.hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 20px;
}

.section-white {
    background: var(--vnv-marble);
    color: var(--vnv-text-dark);
}

.section-dark {
    background: var(--vnv-dark-deep);
    color: var(--vnv-text-light);
}

.section-heading {
    max-width: 920px;
    margin-bottom: 55px;
}
.section-heading h2 {
    font-size: clamp(2.2rem, 4vw, 4.2rem);
    line-height: 1.04;
    margin: 16px 0 18px;
}
.section-heading p {
    font-size: 1.05rem;
    margin: 0;
}
.section-white .section-heading p {
    color: #566164;
}
.section-dark .section-heading p {
    color: var(--vnv-text-muted);
}

.deco-intro-wrap {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 40px;
    align-items: center;
}

.deco-image-card {
    border-radius: 30px;
    overflow: hidden;
    box-shadow: 0 25px 70px rgba(0,0,0,.10);
    border: 1px solid rgba(17,24,26,.08);
    background: #fff;
}

.deco-image-card img {
    width: 100%;
    height: 100%;
    min-height: 420px;
    object-fit: cover;
    display: block;
}

.deco-info-panel {
    background: #fff;
    border: 1px solid rgba(17,24,26,.08);
    border-radius: 30px;
    padding: 40px;
    box-shadow: 0 25px 70px rgba(0,0,0,.08);
}

.deco-info-panel h3 {
    font-size: 2rem;
    color: var(--vnv-text-dark);
    margin-bottom: 20px;
}

.deco-info-panel p,
.deco-info-panel li {
    color: #4f5b5f;
}

.deco-info-panel ul {
    list-style: none;
    padding: 0;
    margin: 25px 0 0;
}
.deco-info-panel ul li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 10px;
}
.deco-info-panel ul li::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vnv-gold);
    position: absolute;
    left: 0;
    top: 12px;
}

.services-bg-video-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
}

.services-bg-video {
    width: 100%;
    height: 120%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.12;
    filter: blur(2px) saturate(0.8);
    transform: translateY(-6%);
}

.services-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to bottom,
        rgba(10,12,12,0.25),
        rgba(10,12,12,0.30),
        rgba(10,12,12,0.25)
    );
}

.vnv-service-grid-card {
    background: rgba(28, 34, 35, 0.82);
    backdrop-filter: blur(6px);
    border-radius: 28px;
    padding: 50px 38px;
    height: 100%;
    border: 1px solid rgba(197, 160, 89, 0.08);
    transition: all 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    position: relative;
    overflow: hidden;
    z-index: 2;
}

.vnv-service-grid-card:hover {
    transform: translateY(-12px);
    border-color: var(--vnv-gold);
    box-shadow: 0 40px 80px rgba(0,0,0,0.42);
}

.service-icon-box {
    width: 60px;
    height: 60px;
    background: rgba(197, 160, 89, 0.1);
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--vnv-gold);
    font-size: 1.6rem;
    margin-bottom: 30px;
}

.service-num-floating {
    position: absolute;
    top: 30px;
    right: 34px;
    font-family: 'Playfair Display', serif;
    font-size: 2.2rem;
    font-weight: 900;
    color: rgba(197, 160, 89, 0.40);
}

.vnv-service-grid-card h3 {
    font-size: 1.8rem;
    font-weight: 700;
    color: white;
    margin-bottom: 18px;
}

.vnv-service-grid-card p {
    color: var(--vnv-text-muted);
    font-size: 1rem;
    margin-bottom: 30px;
}

.vnv-link-gold {
    color: var(--vnv-gold) !important;
    font-weight: 800;
    letter-spacing: 2px;
    font-size: 0.85rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    transition: 0.4s;
}

.vnv-link-gold:hover {
    gap: 20px;
    color: white !important;
}

.process-wrap {
    display: grid;
    grid-template-columns: .95fr 1.05fr;
    gap: 40px;
    align-items: stretch;
}

.process-image-stack {
    display: grid;
    gap: 24px;
}

.process-image-stack img {
    width: 100%;
    border-radius: 26px;
    object-fit: cover;
    display: block;
    box-shadow: 0 20px 60px rgba(0,0,0,.10);
    border: 1px solid rgba(17,24,26,.08);
}

.process-image-stack img:first-child {
    min-height: 260px;
    max-height: 260px;
}
.process-image-stack img:last-child {
    min-height: 260px;
    max-height: 260px;
}

.process-panel {
    background: #fff;
    border: 1px solid rgba(17,24,26,.08);
    border-radius: 30px;
    padding: 42px;
    box-shadow: 0 25px 70px rgba(0,0,0,.08);
}

.process-panel h3 {
    font-size: 2rem;
    color: var(--vnv-text-dark);
    margin-bottom: 18px;
}

.process-panel p,
.process-panel li {
    color: #4f5b5f;
}

.process-steps {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
}
.process-steps li {
    padding: 0 0 24px 0;
    margin-bottom: 24px;
    border-bottom: 1px solid rgba(17,24,26,.08);
}
.process-steps li:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
}
.process-steps strong {
    display: block;
    color: var(--vnv-text-dark);
    font-size: 1.2rem;
    margin-bottom: 8px;
}

.instagram-block {
    position: relative;
    overflow: hidden;
}

.instagram-block::before {
    content: "";
    position: absolute;
    top: -120px;
    left: -120px;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(94,198,196,0.14) 0%, transparent 70%);
    pointer-events: none;
}

.vnv-studio-card {
    background: linear-gradient(145deg, #161a1b 0%, #0d0f0f 100%);
    border-radius: 30px;
    padding: 50px;
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow: 0 20px 60px rgba(0,0,0,0.35);
}

.vnv-studio-card h3 {
    font-size: 1.8rem;
    font-weight: 800;
}

.vnv-studio-card p {
    color: rgba(255,255,255,0.7);
    margin-bottom: 20px;
}

.vnv-studio-info {
    display: flex;
    gap: 12px;
    align-items: center;
    color: #fff;
    font-weight: 600;
    margin-bottom: 25px;
}

.vnv-studio-info i {
    color: var(--vnv-primary);
}

.vnv-studio-actions {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.instagram-gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.instagram-gallery-grid img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 22px;
    display: block;
    border: 1px solid rgba(255,255,255,.08);
}

.final-cta-card {
    background: linear-gradient(145deg, #161a1b 0%, #0d0f0f 100%);
    border-radius: 45px;
    padding: 90px 70px;
    border: 1px solid rgba(255,255,255,.06);
    position: relative;
    overflow: hidden;
}

.final-cta-card::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 10%;
    width: 360px;
    height: 360px;
    transform: translateY(-50%);
    background: radial-gradient(circle, rgba(94, 198, 196, 0.08) 0%, transparent 70%);
    pointer-events: none;
}

.final-cta-card p {
    color: var(--vnv-text-muted-soft);
}

.vnv-btn-fixed {
    min-width: 240px;
    text-align: center;
    white-space: normal;
    line-height: 1.35;
    padding: 20px 28px;
}

@media (max-width: 1199px) {
    .final-cta-card { padding: 60px 45px; }
}

@media (max-width: 991px) {
    .deco-intro-wrap,
    .process-wrap {
        grid-template-columns: 1fr;
    }

    .deco-info-panel,
    .process-panel,
    .vnv-studio-card {
        padding: 32px 28px;
    }

    .final-cta-card {
        padding: 50px 30px;
        text-align: center;
    }

    .vnv-btn-fixed {
        min-width: 100%;
    }

    .services-bg-video {
        height: 100%;
        transform: none;
        filter: blur(1px) saturate(0.8);
    }
}

@media (max-width: 767px) {
    .section-vnv {
        padding: 90px 0;
    }

    .hero-deco h1 {
        font-size: 2.7rem;
    }

    .vnv-btn {
        width: 100%;
        padding: 18px 24px;
        letter-spacing: 2px;
    }

    .hero-cta-row {
        flex-direction: column;
    }

    .instagram-gallery-grid img {
        height: 150px;
    }
}
</style>
{% endblock %}

{% block body %}

{% include "templates/layout/publicHeaderVnv.html.twig" %}

<section class="hero-deco">
    <div class="container hero-deco-inner">
        <span class="vnv-badge">VNV Deco Flowers</span>

        <h1>Floral Decorations & <span class="text-gold">Event Space Design</span> in South Florida</h1>

        <p class="hero-copy">
            VNV Flowers & Deco transforms event spaces with flowers, balloons, lighting, draping, props and design elements that help the entire environment feel more intentional, immersive and memorable.
        </p>

        <p class="hero-copy">
            From wedding aisles and banquet tables to entrances, photo-op backdrops, salon decoration and expo stands, our goal is to help your space feel fully designed instead of partially decorated.
        </p>

        <div class="hero-cta-row">
            <a href="tel:+13052045427" class="vnv-btn btn-gold-vnv">Call Now (305) 204-5427</a>
            <a href="#deco-services" class="vnv-btn btn-outline-vnv">Explore Services</a>
        </div>
    </div>
</section>

<section class="section-vnv section-white">
    <div class="container">
        <div class="deco-intro-wrap">
            <div class="deco-image-card">
                <img src="{{ asset_for('assets/images/deco2.jpg') }}" alt="Event floral installation by VNV Deco Flowers">
            </div>

            <div class="deco-info-panel">
                <span class="vnv-badge">About VNV Flowers & Deco</span>
                <h3>Let us bloom your special moments.</h3>
                <p>
                    VNV Flowers & Deco was created to give clients a more complete decorative service, where florals, structures, lighting and styling work together instead of competing with each other.
                </p>
                <p>
                    We design event environments for South Florida clients who want the space itself to become part of the experience — not just a backdrop for it.
                </p>

                <ul>
                    <li>Event design and concept development</li>
                    <li>Floral arrangements and botanicals</li>
                    <li>Lighting, backdrops and draping</li>
                    <li>Balloon artistry and photo-op structures</li>
                    <li>Tablescapes, props, signage and setup support</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="section-vnv section-dark" id="deco-services">
    <div class="services-bg-video-wrap">
        <video class="services-bg-video" autoplay muted loop playsinline preload="auto">
            <source src="{{ asset_for('assets/video/intro.mp4') }}" type="video/mp4">
        </video>
        <div class="services-bg-overlay"></div>
    </div>

    <div class="container position-relative" style="z-index:2;">
        <div class="text-center mb-5 pb-5 section-heading">
            <span class="vnv-badge">Design Specialties</span>
            <h2 class="text-white">What We Create in <span class="text-vnv">Decor & Flowers</span></h2>
            <p>These are the kinds of decorative moments clients usually need when they want the space to actually feel transformed. :contentReference[oaicite:1]{index=1}</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-xl-4">
                <div class="vnv-service-grid-card">
                    <span class="service-num-floating">01</span>
                    <div class="service-icon-box"><i class="fa-solid fa-ring"></i></div>
                    <h3>Wedding Aisle & Altar</h3>
                    <p>Crystal floors, arches, gazebos, florals and aisle styling designed to shape the most important visual moments of the ceremony. :contentReference[oaicite:2]{index=2}</p>
                    <a href="#" class="vnv-link-gold">MORE INFO & CATALOG →</a>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="vnv-service-grid-card">
                    <span class="service-num-floating">02</span>
                    <div class="service-icon-box"><i class="fa-solid fa-champagne-glasses"></i></div>
                    <h3>Banquet Tables</h3>
                    <p>Centerpieces, candelabras, hanging florals and lighting details that elevate the dining experience and complete the room design. :contentReference[oaicite:3]{index=3}</p>
                    <a href="#" class="vnv-link-gold">MORE INFO & CATALOG →</a>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="vnv-service-grid-card">
                    <span class="service-num-floating">03</span>
                    <div class="service-icon-box"><i class="fa-solid fa-door-open"></i></div>
                    <h3>Entrances & Pathways</h3>
                    <p>Decorative entrances, illuminated walkways and welcoming moments that set the tone before guests even reach the main event space. :contentReference[oaicite:4]{index=4}</p>
                    <a href="#" class="vnv-link-gold">MORE INFO & CATALOG →</a>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="vnv-service-grid-card">
                    <span class="service-num-floating">04</span>
                    <div class="service-icon-box"><i class="fa-solid fa-camera"></i></div>
                    <h3>Photo-Ops & Statement Walls</h3>
                    <p>Balloon décor, grass walls, flower walls and custom-designed backdrops made to create memorable content moments for guests. :contentReference[oaicite:5]{index=5}</p>
                    <a href="#" class="vnv-link-gold">MORE INFO & CATALOG →</a>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="vnv-service-grid-card">
                    <span class="service-num-floating">05</span>
                    <div class="service-icon-box"><i class="fa-solid fa-lightbulb"></i></div>
                    <h3>Custom Neon Signs</h3>
                    <p>LED neon pieces and custom wording that add a stronger visual identity to celebrations, branded events and specialty spaces. :contentReference[oaicite:6]{index=6}</p>
                    <a href="#" class="vnv-link-gold">MORE INFO & CATALOG →</a>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="vnv-service-grid-card">
                    <span class="service-num-floating">06</span>
                    <div class="service-icon-box"><i class="fa-solid fa-store"></i></div>
                    <h3>Promotional Stands & Expo Design</h3>
                    <p>Decorative and branded structures for expo shows and public-facing activations where design has to attract attention and support the brand message. :contentReference[oaicite:7]{index=7}</p>
                    <a href="#" class="vnv-link-gold">MORE INFO & CATALOG →</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-vnv section-white">
    <div class="container">
        <div class="process-wrap">
            <div class="process-image-stack">
                <img src="{{ asset_for('assets/images/deco3.jpg') }}" alt="Event design process by VNV Deco Flowers">
                <img src="{{ asset_for('assets/images/deco4.jpg') }}" alt="Luxury floral styling by VNV Deco Flowers">
            </div>

            <div class="process-panel">
                <span class="vnv-badge">Our Design Process</span>
                <h3>From inspiration to installation, the process stays clear.</h3>

                <p>
                    We keep the design process organized so clients can move from idea to approval with less confusion and more confidence.
                </p>

                <ol class="process-steps">
                    <li>
                        <strong>01 · Discovery Meeting</strong>
                        We begin by understanding your needs, including space, colors, budget and inspirations. :contentReference[oaicite:8]{index=8}
                    </li>
                    <li>
                        <strong>02 · Customized Design Proposals</strong>
                        Our team develops tailored options designed to fit the style and budget of the event. :contentReference[oaicite:9]{index=9}
                    </li>
                    <li>
                        <strong>03 · Setup & Transformation</strong>
                        Once approved, our team handles the installation so the vision becomes a real, cohesive environment. This reflects the page’s “sit back and watch the magic happen” step and the setup/teardown service they describe. :contentReference[oaicite:10]{index=10}
                    </li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="section-vnv section-dark instagram-block">
    <div class="container position-relative" style="z-index:2;">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="text-vnv fw-bold d-block mb-3 letter-spacing-lg">PORTFOLIO & SOCIAL</span>

                <h2 class="display-3 fw-black text-white mb-3">
                    See our work on <span class="text-vnv">@vnv_events</span>
                </h2>

                <p class="fs-5 mb-4" style="color:rgba(255,255,255,0.65);">
                    Explore real installations, event styling moments and behind-the-scenes details from our decor and floral work.
                </p>

                <a href="https://www.instagram.com/vnv_events/" target="_blank" class="vnv-btn btn-outline-vnv">
                    View Instagram
                </a>

                <div class="instagram-gallery-grid mt-4">
                    <img src="{{ asset_for('assets/images/deco1.jpg') }}" alt="Decor gallery 1">
                    <img src="{{ asset_for('assets/images/deco2.jpg') }}" alt="Decor gallery 2">
                    <img src="{{ asset_for('assets/images/deco3.jpg') }}" alt="Decor gallery 3">
                    <img src="{{ asset_for('assets/images/deco4.jpg') }}" alt="Decor gallery 4">
                </div>
