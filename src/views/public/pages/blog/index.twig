{% extends 'templates/base.twig' %}
{% set show_whatsapp = true %}

{% block title %}Tips and Advices | VNV Events{% endblock %}
{% block meta_description %}Ideas, planning tips, and expert guidance for stress-free luxury events in South Florida.{% endblock %}

{% block body %}
{% set placeholderImage = asset_for('assets/images/store-category-planning.jpg') %}
{% set heroImage = featured_posts|length and featured_posts[0].featured_image_url ? featured_posts[0].featured_image_url : placeholderImage %}

<style>
    :root {
        --vnv-mint: #4df7d2;
        --vnv-mint-soft: rgba(77, 247, 210, 0.18);
        --vnv-gold: #e7bb55;
        --vnv-ink: #071010;
        --vnv-charcoal: #171b1c;
        --vnv-plomo: #24292b;
        --vnv-line: rgba(255, 255, 255, 0.13);
        --vnv-text: #f7fbf8;
        --vnv-muted: rgba(247, 251, 248, 0.72);
    }

    .vnv-blog-page {
        background:
            radial-gradient(circle at 12% 8%, rgba(77, 247, 210, 0.16), transparent 28rem),
            radial-gradient(circle at 86% 12%, rgba(231, 187, 85, 0.14), transparent 24rem),
            linear-gradient(135deg, #071010 0%, #1d2324 42%, #111616 100%);
        color: var(--vnv-text);
        min-height: 100vh;
        overflow: hidden;
    }

    .vnv-blog-shell {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
    }

    .vnv-blog-hero {
        position: relative;
        padding: 150px 0 78px;
    }

    .vnv-blog-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 54px 54px;
        mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.72), transparent 82%);
        pointer-events: none;
    }

    .vnv-blog-hero-card {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
        gap: 34px;
        align-items: stretch;
        border: 1px solid rgba(77, 247, 210, 0.2);
        border-radius: 36px;
        background:
            linear-gradient(135deg, rgba(36, 41, 43, 0.96), rgba(10, 18, 18, 0.92)),
            repeating-linear-gradient(135deg, rgba(77, 247, 210, 0.035) 0 1px, transparent 1px 18px);
        box-shadow: 0 34px 90px rgba(0, 0, 0, 0.38);
        overflow: hidden;
    }

    .vnv-blog-hero-card::before {
        content: '';
        position: absolute;
        width: 360px;
        height: 360px;
        left: -120px;
        bottom: -160px;
        border-radius: 999px;
        background: radial-gradient(circle, rgba(77, 247, 210, 0.22), transparent 68%);
        pointer-events: none;
    }

    .vnv-blog-hero-copy {
        padding: 56px;
        position: relative;
        z-index: 2;
    }

    .vnv-blog-kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 9px 14px;
        border: 1px solid rgba(77, 247, 210, 0.28);
        border-radius: 999px;
        background: rgba(77, 247, 210, 0.1);
        color: var(--vnv-mint);
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        font-size: 0.74rem;
    }

    .vnv-blog-hero h1 {
        margin: 24px 0 18px;
        font-size: clamp(2.6rem, 7vw, 6.8rem);
        line-height: 0.88;
        letter-spacing: -0.07em;
        max-width: 760px;
    }

    .vnv-blog-hero h1 span {
        color: var(--vnv-gold);
        display: block;
    }

    .vnv-blog-hero p {
        max-width: 620px;
        color: var(--vnv-muted);
        font-size: 1.08rem;
        line-height: 1.8;
    }

    .vnv-blog-stat-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin-top: 30px;
        max-width: 640px;
    }

    .vnv-blog-stat {
        padding: 16px;
        border-radius: 22px;
        border: 1px solid rgba(255, 255, 255, 0.11);
        background: rgba(255, 255, 255, 0.055);
    }

    .vnv-blog-stat strong {
        display: block;
        color: var(--vnv-mint);
        font-size: 1.35rem;
        line-height: 1;
        margin-bottom: 8px;
    }

    .vnv-blog-stat span {
        display: block;
        color: rgba(247, 251, 248, 0.7);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .vnv-blog-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 30px;
    }

    .vnv-blog-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 50px;
        padding: 0 22px;
        border-radius: 999px;
        font-weight: 900;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .vnv-blog-btn-primary {
        background: linear-gradient(135deg, var(--vnv-mint), #74e0d8);
        color: #061211;
        box-shadow: 0 18px 38px rgba(77, 247, 210, 0.22);
    }

    .vnv-blog-btn-secondary {
        border: 1px solid rgba(255, 255, 255, 0.16);
        color: var(--vnv-text);
        background: rgba(255, 255, 255, 0.05);
    }

    .vnv-blog-btn:hover {
        transform: translateY(-2px);
        text-decoration: none;
    }

    .vnv-blog-hero-media {
        position: relative;
        min-height: 520px;
        overflow: hidden;
    }

    .vnv-blog-hero-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: saturate(1.05) contrast(1.04);
    }

    .vnv-blog-hero-media::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(23, 27, 28, 0.88), transparent 48%), linear-gradient(0deg, rgba(7, 16, 16, 0.28), transparent);
    }

    .vnv-blog-floating-note {
        position: absolute;
        right: 28px;
        bottom: 28px;
        z-index: 2;
        max-width: 250px;
        padding: 18px;
        border-radius: 24px;
        border: 1px solid rgba(77, 247, 210, 0.24);
        background: rgba(7, 16, 16, 0.78);
        backdrop-filter: blur(16px);
    }

    .vnv-blog-floating-note strong {
        display: block;
        color: var(--vnv-mint);
        margin-bottom: 6px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 0.75rem;
    }

    .vnv-blog-service-strip {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-top: 18px;
    }

    .vnv-blog-service-pill {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 74px;
        padding: 16px;
        border-radius: 24px;
        border: 1px solid rgba(77, 247, 210, 0.18);
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.035));
        color: rgba(247, 251, 248, 0.82);
        font-weight: 850;
    }

    .vnv-blog-service-pill i {
        display: inline-flex;
        width: 38px;
        height: 38px;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: rgba(77, 247, 210, 0.12);
        color: var(--vnv-mint);
    }

    .vnv-blog-section {
        padding: 0 0 76px;
    }

    .vnv-blog-section-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 24px;
        margin-bottom: 26px;
    }

    .vnv-blog-section-head h2 {
        margin: 0;
        font-size: clamp(2rem, 4vw, 3.4rem);
        letter-spacing: -0.05em;
    }

    .vnv-blog-section-head p {
        margin: 8px 0 0;
        color: var(--vnv-muted);
        max-width: 520px;
        line-height: 1.7;
    }

    .vnv-blog-category-grid {
        counter-reset: category-card;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .vnv-blog-category-card {
        counter-increment: category-card;
        position: relative;
        min-height: 280px;
        border-radius: 30px;
        overflow: hidden;
        color: #fff;
        text-decoration: none;
        border: 1px solid rgba(255, 255, 255, 0.12);
        background: var(--vnv-plomo);
        box-shadow: 0 22px 54px rgba(0, 0, 0, 0.24);
    }

    .vnv-blog-category-card img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: scale(1.03);
        transition: transform 0.42s ease;
    }

    .vnv-blog-category-card::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(4, 10, 10, 0.1), rgba(4, 10, 10, 0.88));
    }

    .vnv-blog-category-card::before {
        content: '0' counter(category-card);
        position: absolute;
        top: 18px;
        right: 20px;
        z-index: 2;
        color: rgba(255, 255, 255, 0.62);
        font-size: 0.78rem;
        font-weight: 950;
        letter-spacing: 0.18em;
    }

    .vnv-blog-category-card:hover img {
        transform: scale(1.1);
    }

    .vnv-blog-category-content {
        position: absolute;
        inset: auto 22px 22px;
        z-index: 2;
    }

    .vnv-blog-category-count {
        display: inline-flex;
        padding: 7px 11px;
        border-radius: 999px;
        background: rgba(77, 247, 210, 0.16);
        color: var(--vnv-mint);
        font-size: 0.78rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    .vnv-blog-category-content h3 {
        margin: 0 0 8px;
        font-size: 1.45rem;
        letter-spacing: -0.03em;
    }

    .vnv-blog-category-content p {
        margin: 0;
        color: rgba(255, 255, 255, 0.76);
        line-height: 1.55;
    }

    .vnv-blog-post-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
    }

    .vnv-blog-post-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        min-height: 100%;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 28px;
        background: rgba(255, 255, 255, 0.055);
        color: var(--vnv-text);
        text-decoration: none;
        transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
        box-shadow: 0 22px 46px rgba(0, 0, 0, 0.18);
    }

    .vnv-blog-post-card:hover {
        transform: translateY(-4px);
        border-color: rgba(77, 247, 210, 0.34);
        background: rgba(255, 255, 255, 0.08);
        text-decoration: none;
    }

    .vnv-blog-post-image {
        height: 220px;
        overflow: hidden;
        background: #101617;
    }

    .vnv-blog-post-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.38s ease;
    }

    .vnv-blog-post-card:hover .vnv-blog-post-image img {
        transform: scale(1.06);
    }

    .vnv-blog-post-body {
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        flex: 1;
    }

    .vnv-blog-post-body small {
        color: var(--vnv-mint);
        font-weight: 900;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .vnv-blog-post-body h3 {
        margin: 0;
        font-size: 1.28rem;
        line-height: 1.22;
        letter-spacing: -0.03em;
    }

    .vnv-blog-post-body p {
        margin: 0;
        color: var(--vnv-muted);
        line-height: 1.65;
    }

    .vnv-blog-read-more {
        margin-top: auto;
        color: var(--vnv-gold);
        font-weight: 900;
    }

    .vnv-blog-empty {
        padding: 38px;
        border: 1px dashed rgba(77, 247, 210, 0.32);
        border-radius: 28px;
        background: rgba(255, 255, 255, 0.05);
        color: var(--vnv-muted);
        line-height: 1.8;
    }

    @media (max-width: 980px) {
        .vnv-blog-hero {
            padding-top: 118px;
        }

        .vnv-blog-hero-card,
        .vnv-blog-category-grid,
        .vnv-blog-post-grid {
            grid-template-columns: 1fr;
        }

        .vnv-blog-hero-card::before {
        content: '';
        position: absolute;
        width: 360px;
        height: 360px;
        left: -120px;
        bottom: -160px;
        border-radius: 999px;
        background: radial-gradient(circle, rgba(77, 247, 210, 0.22), transparent 68%);
        pointer-events: none;
    }

    .vnv-blog-hero-copy {
            padding: 38px 28px;
        }

        .vnv-blog-hero-media {
            min-height: 360px;
        }

        .vnv-blog-section-head {
            display: block;
        }

        .vnv-blog-service-strip,
        .vnv-blog-stat-row {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 640px) {
        .vnv-blog-shell {
            width: min(100% - 22px, 1180px);
        }

        .vnv-blog-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        background-size: 54px 54px;
        mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.72), transparent 82%);
        pointer-events: none;
    }

    .vnv-blog-hero-card {
            border-radius: 28px;
        }

        .vnv-blog-hero h1 {
            font-size: clamp(2.65rem, 15vw, 4.6rem);
        }

        .vnv-blog-actions,
        .vnv-blog-btn {
            width: 100%;
        }

        .vnv-blog-floating-note {
            left: 18px;
            right: 18px;
            max-width: none;
        }
    }
</style>

<div class="vnv-blog-page">
    {% include 'templates/layout/publicHeaderVnv.html.twig' %}

    <main>
        <section class="vnv-blog-hero">
            <div class="vnv-blog-shell">
                <div class="vnv-blog-hero-card">
                    <div class="vnv-blog-hero-copy">
                        <span class="vnv-blog-kicker">VNV Events Journal</span>
                        <h1>Tips for <span>luxury events.</span></h1>
                        <p>Fresh planning ideas, vendor guidance, guest-flow notes, and production insight for clients who want the event to feel effortless from the first call to the last song.</p>
                        <div class="vnv-blog-stat-row">
                            <div class="vnv-blog-stat">
                                <strong>{{ categories|length ?: '01' }}</strong>
                                <span>Planning categories</span>
                            </div>
                            <div class="vnv-blog-stat">
                                <strong>{{ (featured_posts|length + recent_posts|length) ?: 'New' }}</strong>
                                <span>Event articles</span>
                            </div>
                            <div class="vnv-blog-stat">
                                <strong>VNV</strong>
                                <span>Real production notes</span>
                            </div>
                        </div>
                        <div class="vnv-blog-actions">
                            <a class="vnv-blog-btn vnv-blog-btn-primary" href="#latest-articles">Read latest articles</a>
                            <a class="vnv-blog-btn vnv-blog-btn-secondary" href="#blog-categories">Explore categories</a>
                        </div>
                    </div>
                    <div class="vnv-blog-hero-media">
                        <img src="{{ heroImage starts with 'http' or heroImage starts with '/' ? heroImage : asset_for(heroImage) }}" alt="VNV Events planning inspiration">
                        <div class="vnv-blog-floating-note">
                            <strong>Stress-free luxury</strong>
                            <span>Practical advice from real event production, not generic party tips.</span>
                        </div>
                    </div>
                </div>
                <div class="vnv-blog-service-strip">
                    <div class="vnv-blog-service-pill"><i class="fa-solid fa-wand-magic-sparkles"></i><span>Design ideas</span></div>
                    <div class="vnv-blog-service-pill"><i class="fa-solid fa-champagne-glasses"></i><span>Guest experience</span></div>
                    <div class="vnv-blog-service-pill"><i class="fa-solid fa-music"></i><span>DJ sessions</span></div>
                    <div class="vnv-blog-service-pill"><i class="fa-solid fa-clipboard-check"></i><span>Planning tips</span></div>
                </div>
            </div>
        </section>

        <section class="vnv-blog-section" id="blog-categories">
            <div class="vnv-blog-shell">
                <div class="vnv-blog-section-head">
                    <div>
                        <h2>Browse by category</h2>
                        <p>Categories are pulled from the blog setup and use the category image when available, or the first matching article image as a dynamic fallback.</p>
                    </div>
                </div>

                {% if categories|length %}
                    <div class="vnv-blog-category-grid">
                        {% for category in categories %}
                            {% set categoryImage = category.dynamic_image_url ?: placeholderImage %}
                            <a class="vnv-blog-category-card" href="{{ path('blog/' ~ category.slug ~ '/') }}">
                                <img src="{{ categoryImage starts with 'http' or categoryImage starts with '/' ? categoryImage : asset_for(categoryImage) }}" alt="{{ category.name }}">
                                <div class="vnv-blog-category-content">
                                    <span class="vnv-blog-category-count">{{ category.posts_count ?: 0 }} article{{ (category.posts_count ?: 0) == 1 ? '' : 's' }}</span>
                                    <h3>{{ category.name }}</h3>
                                    {% if category.description %}
                                        <p>{{ category.description|striptags|length > 110 ? category.description|striptags|slice(0, 110) ~ '...' : category.description|striptags }}</p>
                                    {% endif %}
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="vnv-blog-empty">No blog categories are published yet. Once categories and articles are created in the generator, they will appear here automatically.</div>
                {% endif %}
            </div>
        </section>

        <section class="vnv-blog-section" id="latest-articles">
            <div class="vnv-blog-shell">
                <div class="vnv-blog-section-head">
                    <div>
                        <h2>Latest articles</h2>
                        <p>Articles published through the content generator appear here with their public blog routes.</p>
                    </div>
                </div>

                {% if featured_posts|length %}
                    <div class="vnv-blog-post-grid">
                        {% for post in featured_posts %}
                            {% set postImage = post.featured_image_url ?: post.category_featured_image_url ?: placeholderImage %}
                            {% set postUrl = post.main_route ?: ('/blog/' ~ post.slug ~ '/') %}
                            <a class="vnv-blog-post-card" href="{{ path(postUrl|trim('/')) }}">
                                <div class="vnv-blog-post-image">
                                    <img src="{{ postImage starts with 'http' or postImage starts with '/' ? postImage : asset_for(postImage) }}" alt="{{ post.title }}">
                                </div>
                                <div class="vnv-blog-post-body">
                                    <small>{{ post.category_name ?: 'VNV Guide' }}</small>
                                    <h3>{{ post.title }}</h3>
                                    <p>{{ (post.excerpt ?: post.meta_description ?: post.description ?: '')|striptags|length > 140 ? (post.excerpt ?: post.meta_description ?: post.description)|striptags|slice(0, 140) ~ '...' : (post.excerpt ?: post.meta_description ?: post.description ?: '')|striptags }}</p>
                                    <span class="vnv-blog-read-more">Read article</span>
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="vnv-blog-empty">No blog articles are published yet. Add articles in the generator and they will populate this page automatically.</div>
                {% endif %}
            </div>
        </section>

        {% if recent_posts|length %}
            <section class="vnv-blog-section">
                <div class="vnv-blog-shell">
                    <div class="vnv-blog-section-head">
                        <div>
                            <h2>More planning notes</h2>
                        </div>
                    </div>
                    <div class="vnv-blog-post-grid">
                        {% for post in recent_posts %}
                            {% set postImage = post.featured_image_url ?: post.category_featured_image_url ?: placeholderImage %}
                            {% set postUrl = post.main_route ?: ('/blog/' ~ post.slug ~ '/') %}
                            <a class="vnv-blog-post-card" href="{{ path(postUrl|trim('/')) }}">
                                <div class="vnv-blog-post-image">
                                    <img src="{{ postImage starts with 'http' or postImage starts with '/' ? postImage : asset_for(postImage) }}" alt="{{ post.title }}">
                                </div>
                                <div class="vnv-blog-post-body">
                                    <small>{{ post.category_name ?: 'VNV Guide' }}</small>
                                    <h3>{{ post.title }}</h3>
                                    <p>{{ (post.excerpt ?: post.meta_description ?: post.description ?: '')|striptags|length > 120 ? (post.excerpt ?: post.meta_description ?: post.description)|striptags|slice(0, 120) ~ '...' : (post.excerpt ?: post.meta_description ?: post.description ?: '')|striptags }}</p>
                                    <span class="vnv-blog-read-more">Read article</span>
                                </div>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </section>
        {% endif %}
    </main>

    {% include 'templates/components/publicEventRequestModal.html.twig' %}
    {% include 'templates/layout/publicFooterVnv.html.twig' %}
</div>
{% endblock %}


