{% extends "templates/base.twig" %}

{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&display=swap" rel="stylesheet">

<style>
:root {
    --vnv-primary: #5EC6C4;
    --vnv-primary-dark: #4aa8a6;
    --vnv-gold: #c5a059;
    --vnv-gold-gradient: linear-gradient(135deg, #bf953f 0%, #fcf6ba 45%, #b38728 100%);
    --vnv-dark-deep: #0a0c0c;
    --vnv-dark-soft: #141818;
    --vnv-dark-card: #1b2021;
    --vnv-light: #ffffff;
    --vnv-marble: #f4f7f8;
    --vnv-text-main: #2d3436;
    --vnv-text-dark: #11181a;
    --vnv-text-light: #f3f5f6;
    --vnv-text-muted: rgba(255,255,255,.74);
    --vnv-text-muted-soft: rgba(255,255,255,.60);
    --vnv-border: rgba(255,255,255,.08);
}

html { scroll-behavior: smooth; }

body {
    background: var(--vnv-dark-deep);
    color: var(--vnv-text-light);
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

h1, h2, h3, h4, h5, .luxury-font {
    font-family: 'Playfair Display', serif;
}

.text-vnv { color: var(--vnv-primary) !important; }
.text-gold {
    background: var(--vnv-gold-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.letter-spacing-lg { letter-spacing: 4px; }

.vnv-btn {
    padding: 18px 30px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: all .35s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: .78rem;
    border-radius: 999px;
}

.btn-gold-vnv {
    background: var(--vnv-gold-gradient);
    color: #000 !important;
}
.btn-gold-vnv:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 40px rgba(197,160,89,.22);
}
.btn-outline-vnv {
    border: 2px solid var(--vnv-primary);
    color: var(--vnv-primary) !important;
    background: transparent;
}
.btn-outline-vnv:hover {
    background: var(--vnv-primary);
    color: #fff !important;
}
.btn-ghost-white {
    border: 1px solid rgba(255,255,255,.18);
    color: #fff !important;
    background: transparent;
}
.btn-ghost-white:hover {
    background: #fff;
    color: #000 !important;
}

.section-vnv {
    padding: 120px 0;
    position: relative;
}

.vnv-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(94,198,196,.1);
    color: var(--vnv-primary);
    font-size: .74rem;
    letter-spacing: 2px;
    font-weight: 800;
    text-transform: uppercase;
}

.hero-staffing {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
        linear-gradient(90deg, rgba(10,12,12,.90) 0%, rgba(10,12,12,.68) 42%, rgba(10,12,12,.44) 100%),
        url('{{ asset_for('assets/images/staffing1.jpg') }}') center/cover no-repeat;
}

.hero-staffing::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at top right, rgba(94,198,196,.16), transparent 28%),
        radial-gradient(circle at bottom left, rgba(197,160,89,.10), transparent 24%);
    pointer-events: none;
}

.hero-staffing-inner {
    position: relative;
    z-index: 2;
    width: 100%;
}

.hero-staffing h1 {
    font-size: clamp(3rem, 6vw, 5.4rem);
    line-height: 1.02;
    margin: 20px 0 28px;
    max-width: 980px;
}

.hero-staffing p.hero-copy {
    font-size: 1.08rem;
    color: var(--vnv-text-muted);
    max-width: 790px;
    margin-bottom: 24px;
}

.hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 22px;
}

.section-white {
    background: var(--vnv-marble);
    color: var(--vnv-text-dark);
}

.section-dark {
    background: var(--vnv-dark-deep);
    color: var(--vnv-text-light);
}

.section-heading {
    max-width: 920px;
    margin-bottom: 55px;
}
.section-heading h2 {
    font-size: clamp(2.2rem, 4vw, 4.2rem);
    line-height: 1.04;
    margin: 16px 0 18px;
}
.section-heading p {
    font-size: 1.05rem;
    margin: 0;
}
.section-white .section-heading p {
    color: #566164;
}
.section-dark .section-heading p {
    color: var(--vnv-text-muted);
}

.intro-wrap {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 40px;
    align-items: center;
}

.intro-image-card {
    border-radius: 30px;
    overflow: hidden;
    box-shadow: 0 25px 70px rgba(0,0,0,.10);
    border: 1px solid rgba(17,24,26,.08);
    background: #fff;
}

.intro-image-card img {
    width: 100%;
    min-height: 430px;
    object-fit: cover;
    display: block;
}

.intro-panel {
    background: linear-gradient(145deg, #161a1b 0%, #0d0f0f 100%);
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 30px;
    padding: 40px;
    box-shadow: 0 25px 70px rgba(0,0,0,.12);
    color: #fff;
}

.intro-panel h3 {
    font-size: 2rem;
    color: #fff;
    margin-bottom: 20px;
}

.intro-panel p,
.intro-panel li {
    color: rgba(255,255,255,.78);
}

.intro-panel ul {
    list-style: none;
    padding: 0;
    margin: 25px 0 0;
}
.intro-panel ul li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 10px;
}
.intro-panel ul li::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vnv-gold);
    position: absolute;
    left: 0;
    top: 12px;
}

.services-bg-video-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
}

.services-bg-video {
    width: 100%;
    height: 120%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.12;
    filter: blur(2px) saturate(0.8);
    transform: translateY(-6%);
}

.services-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to bottom,
        rgba(10,12,12,0.25),
        rgba(10,12,12,0.30),
        rgba(10,12,12,0.25)
    );
}

.service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.service-card {
    background: rgba(28, 34, 35, 0.82);
    backdrop-filter: blur(6px);
    border-radius: 28px;
    padding: 42px 34px;
    border: 1px solid rgba(197, 160, 89, 0.08);
    height: 100%;
    position: relative;
    z-index: 2;
}

.service-card h3 {
    color: #fff;
    font-size: 1.7rem;
    margin-bottom: 14px;
}
.service-card p,
.service-card li {
    color: var(--vnv-text-muted);
}

.service-icon-box {
    width: 60px;
    height: 60px;
    background: rgba(197, 160, 89, 0.1);
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--vnv-gold);
    font-size: 1.6rem;
    margin-bottom: 24px;
}

.role-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
}

.role-card {
    background: #fff;
    border: 1px solid rgba(17,24,26,.08);
    border-radius: 28px;
    padding: 30px 24px;
    box-shadow: 0 20px 60px rgba(0,0,0,.08);
    height: 100%;
}

.role-card h4 {
    color: var(--vnv-text-dark);
    font-size: 1.25rem;
    margin-bottom: 10px;
}
.role-card p {
    color: #4f5b5f;
    margin: 0;
}

.staffing-wrap {
    display: grid;
    grid-template-columns: .95fr 1.05fr;
    gap: 40px;
    align-items: stretch;
}

.staffing-image-stack {
    display: grid;
    gap: 24px;
}

.staffing-image-stack img {
    width: 100%;
    border-radius: 26px;
    object-fit: cover;
    display: block;
    box-shadow: 0 20px 60px rgba(0,0,0,.10);
    border: 1px solid rgba(17,24,26,.08);
}

.staffing-image-stack img:first-child,
.staffing-image-stack img:last-child {
    min-height: 260px;
    max-height: 260px;
}

.staffing-panel {
    background: #fff;
    border: 1px solid rgba(17,24,26,.08);
    border-radius: 30px;
    padding: 42px;
    box-shadow: 0 25px 70px rgba(0,0,0,.08);
}

.staffing-panel h3 {
    font-size: 2rem;
    color: var(--vnv-text-dark);
    margin-bottom: 18px;
}

.staffing-panel p,
.staffing-panel li {
    color: #4f5b5f;
}

.staffing-panel ul {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
}
.staffing-panel ul li {
    position: relative;
    padding-left: 24px;
    margin-bottom: 12px;
}
.staffing-panel ul li::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vnv-primary);
    position: absolute;
    left: 0;
    top: 12px;
}

.price-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.price-card {
    background: #fff;
    border: 1px solid rgba(17,24,26,.08);
    border-radius: 30px;
    padding: 36px 30px;
    box-shadow: 0 20px 60px rgba(0,0,0,.08);
    height: 100%;
}

.price-card h3 {
    color: var(--vnv-text-dark);
    font-size: 1.6rem;
    margin-bottom: 12px;
}

.price-card .price-line {
    font-size: 2rem;
    font-weight: 800;
    color: var(--vnv-text-dark);
    margin-bottom: 14px;
}

.price-card p,
.price-card li {
    color: #4f5b5f;
}

.price-card ul {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
}
.price-card ul li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 10px;
}
.price-card ul li::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vnv-gold);
    position: absolute;
    left: 0;
    top: 11px;
}

.location-block {
    position: relative;
    overflow: hidden;
}

.location-block::before {
    content: "";
    position: absolute;
    top: -120px;
    left: -120px;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(94,198,196,0.14) 0%, transparent 70%);
    pointer-events: none;
}

.vnv-location-card {
    background: linear-gradient(145deg, #161a1b 0%, #0d0f0f 100%);
    border-radius: 30px;
    padding: 50px;
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow: 0 20px 60px rgba(0,0,0,0.35);
}

.vnv-location-card h3 {
    font-size: 1.8rem;
    font-weight: 800;
}

.vnv-location-card p {
    color: rgba(255,255,255,0.7);
    margin-bottom: 20px;
}

.vnv-location-info {
    display: flex;
    gap: 12px;
    align-items: center;
    color: #fff;
    font-weight: 600;
    margin-bottom: 18px;
}

.vnv-location-info i {
    color: var(--vnv-primary);
}

.location-gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.location-gallery-grid img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 22px;
    display: block;
    border: 1px solid rgba(255,255,255,.08);
}

.final-cta-card {
    background: linear-gradient(145deg, #161a1b 0%, #0d0f0f 100%);
    border-radius: 45px;
    padding: 90px 70px;
    border: 1px solid rgba(255,255,255,.06);
    position: relative;
    overflow: hidden;
}

.final-cta-card::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 10%;
    width: 360px;
    height: 360px;
    transform: translateY(-50%);
    background: radial-gradient(circle, rgba(94, 198, 196, 0.08) 0%, transparent 70%);
    pointer-events: none;
}

.final-cta-card p {
    color: var(--vnv-text-muted-soft);
}

.vnv-btn-fixed {
    min-width: 240px;
    text-align: center;
    white-space: normal;
    line-height: 1.35;
    padding: 20px 28px;
}

@media (max-width: 1199px) {
    .role-grid,
    .price-grid {
        grid-template-columns: 1fr 1fr;
    }
    .final-cta-card {
        padding: 60px 45px;
    }
}

@media (max-width: 991px) {
    .intro-wrap,
    .staffing-wrap {
        grid-template-columns: 1fr;
    }

    .service-grid,
    .role-grid,
    .price-grid {
        grid-template-columns: 1fr;
    }

    .intro-panel,
    .staffing-panel,
    .vnv-location-card {
        padding: 32px 28px;
    }

    .final-cta-card {
        padding: 50px 30px;
        text-align: center;
    }

    .vnv-btn-fixed {
        min-width: 100%;
    }

    .services-bg-video {
        height: 100%;
        transform: none;
        filter: blur(1px) saturate(0.8);
    }
}

@media (max-width: 767px) {
    .section-vnv {
        padding: 90px 0;
    }

    .hero-staffing h1 {
        font-size: 2.7rem;
    }

    .vnv-btn {
        width: 100%;
        padding: 18px 24px;
        letter-spacing: 2px;
    }

    .hero-cta-row {
        flex-direction: column;
    }

    .location-gallery-grid img {
        height: 150px;
    }
}
</style>
{% endblock %}

{% block body %}

{% include "templates/layout/publicHeaderVnv.html.twig" %}

<section class="hero-staffing">
    <div class="container hero-staffing-inner">
        <span class="vnv-badge">VNV Event Staffing</span>

        <h1>Event Staffing Services in <span class="text-gold">South Florida</span></h1>

        <p class="hero-copy">
            Great events do not run on rentals and decor alone. They run on people who know how to keep service moving, support guests, protect the timeline and help everything feel smooth from start to finish.
        </p>

        <p class="hero-copy">
            VNV provides event staffing support for weddings, corporate gatherings, private celebrations, social events and branded experiences across Broward, Miami and West Palm Beach.
        </p>

        <div class="hero-cta-row">
            <a href="tel:+13052045427" class="vnv-btn btn-gold-vnv">Call Now (305) 204-5427</a>
            <a href="#staff-roles" class="vnv-btn btn-outline-vnv">Explore Staff Roles</a>
        </div>
    </div>
</section>

<section class="section-vnv section-white">
    <div class="container">
        <div class="intro-wrap">
            <div class="intro-image-card">
                <img src="{{ asset_for('assets/images/staffing2.jpg') }}" alt="Professional event staffing by VNV Events">
            </div>

            <div class="intro-panel">
                <span class="vnv-badge">More Than Extra Hands</span>
                <h3>More than staff. They control the experience.</h3>
                <p>
                    Guests may not remember every rental item, but they absolutely remember how the event felt. The right team keeps service moving, supports the host, reduces stress and helps the entire event feel more polished.
                </p>
                <p>
                    For event staffing in South Florida, clients usually look for servers, bartenders, captains, support staff, registration help and other guest-facing roles because those are the positions that most directly affect flow, hospitality and guest perception.
                </p>

                <ul>
                    <li>Professional servers for passed bites, buffet support and guest service</li>
                    <li>Bartenders and bar staff for smooth beverage service</li>
                    <li>Event assistants for logistics, guest guidance and general support</li>
                    <li>Setup and breakdown teams to reduce pressure before and after the event</li>
                    <li>Captains or coordinators to help maintain timing and service flow</li>
                    <li>Flexible staffing based on guest count, service style and event complexity</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="section-vnv section-dark" id="staff-roles">
    <div class="services-bg-video-wrap">
        <video class="services-bg-video" autoplay muted loop playsinline preload="auto">
            <source src="{{ asset_for('assets/video/intro.mp4') }}" type="video/mp4">
        </video>
        <div class="services-bg-overlay"></div>
    </div>

    <div class="container position-relative" style="z-index:2;">
        <div class="text-center mb-5 pb-5 section-heading">
            <span class="vnv-badge">Staffing Roles</span>
            <h2 class="text-white">The people who keep the <span class="text-vnv">event moving</span></h2>
            <p>
                Different events need different levels of service, support and guest-facing presence.
            </p>
        </div>

        <div class="service-grid">
            <div class="service-card">
                <div class="service-icon-box"><i class="fa-solid fa-utensils"></i></div>
                <h3>Servers</h3>
                <p>
                    Ideal for buffet assistance, plated service support, passed appetizers, table clearing and overall guest care throughout the event.
                </p>
            </div>

            <div class="service-card">
                <div class="service-icon-box"><i class="fa-solid fa-martini-glass-citrus"></i></div>
                <h3>Bartenders</h3>
                <p>
                    Professional bar staff to manage cocktails, wine, beer service and guest interaction while keeping the bar area organized and efficient.
                </p>
            </div>

            <div class="service-card">
                <div class="service-icon-box"><i class="fa-solid fa-clipboard-check"></i></div>
                <h3>Captains & Coordinators</h3>
                <p>
                    For events that need stronger control of service timing, team communication and overall flow from start to finish.
                </p>
            </div>

            <div class="service-card">
                <div class="service-icon-box"><i class="fa-solid fa-user-group"></i></div>
                <h3>Event Assistants</h3>
                <p>
                    Extra support for guest direction, check-in, vendor assistance, setup details and other general event logistics.
                </p>
            </div>

            <div class="service-card">
                <div class="service-icon-box"><i class="fa-solid fa-box-open"></i></div>
                <h3>Setup & Breakdown</h3>
                <p>
                    Teams that help handle physical preparation before guests arrive and cleanup support once the event is over.
                </p>
            </div>

            <div class="service-card">
                <div class="service-icon-box"><i class="fa-solid fa-star"></i></div>
                <h3>Custom Event Staffing</h3>
                <p>
                    Flexible staff planning for private parties, social events, corporate functions, launches, celebrations and more.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="section-vnv section-white">
    <div class="container">
        <div class="section-heading">
            <span class="vnv-badge">Ideal For</span>
            <h2>Staffing support for <span class="text-vnv">different event types</span></h2>
            <p>
                The right staffing mix depends on guest count, event format, service style and how much operational support the host wants on-site.
            </p>
        </div>

        <div class="role-grid">
            <div class="role-card">
                <h4>Weddings</h4>
                <p>Servers, bartenders and support staff help keep hospitality polished while allowing the family to actually enjoy the event.</p>
            </div>

            <div class="role-card">
                <h4>Corporate Events</h4>
                <p>Useful for guest-facing service, registration support, beverage management and a stronger professional presentation.</p>
            </div>

            <div class="role-card">
                <h4>Private Parties</h4>
                <p>Perfect for birthdays, showers, home events and celebrations where the host wants less stress and better flow.</p>
            </div>

            <div class="role-card">
                <h4>Brand Activations</h4>
                <p>Support for check-in, interaction, hospitality and the overall guest-facing experience at public or branded events.</p>
            </div>
        </div>
    </div>
</section>

<section class="section-vnv section-white">
    <div class="container">
        <div class="staffing-wrap">
            <div class="staffing-image-stack">
                <img src="{{ asset_for('assets/images/staffing3.jpg') }}" alt="Servers and hospitality staff at event">
                <img src="{{ asset_for('assets/images/staffing4.jpg') }}" alt="Event staff in action at South Florida celebration">
            </div>

            <div class="staffing-panel">
                <span class="vnv-badge">Why It Matters</span>
                <h3>Even a beautiful event can feel disorganized without the right team.</h3>

                <p>
                    Staffing is one of the most overlooked parts of event planning until service starts to slow down, guests begin waiting or the host ends up solving operational problems instead of enjoying the event.
                </p>

                <ul>
                    <li>Faster service usually creates a stronger guest experience</li>
                    <li>Clearer roles reduce confusion during busy moments</li>
                    <li>Better timing supports the entire event flow</li>
                    <li>A polished staff presence elevates the perception of the event</li>
                    <li>More support on-site means less pressure on the host</li>
                </ul>

                <p class="mt-3">
                    This is why many event staffing providers in the Miami area emphasize trained service teams, captains, support staff and role-based assignments instead of offering just generic labor.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="section-vnv section-dark">
    <div class="container">
        <div class="section-heading">
            <span class="vnv-badge">How Pricing Works</span>
            <h2 class="text-white">Custom quotes are usually better than <span class="text-vnv">flat pricing</span></h2>
            <p>
                Staffing rates in South Florida often vary depending on the role, shift length, service style, event size and level of responsibility required.
            </p>
        </div>

        <div class="price-grid">
            <div class="price-card">
                <h3>What Affects Pricing</h3>
                <div class="price-line">Role + Hours</div>
                <p>
                    Bartenders, captains and specialty staff are usually priced differently than standard support roles, and longer shifts naturally change the quote.
                </p>
                <ul>
                    <li>Role type</li>
                    <li>Shift duration</li>
                    <li>Arrival and breakdown time</li>
                </ul>
            </div>

            <div class="price-card">
