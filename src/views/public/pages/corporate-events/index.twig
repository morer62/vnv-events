{% extends "templates/base.twig" %}
{% block title %}Corporate Event Production & Annual Partnerships | VNV Events{% endblock %}
{% block meta_description %}Explore South Florida corporate event production for a conference, product launch, employee event or annual series. Compare scopes and request a production proposal.{% endblock %}
{% block canonical %}https://vnvevents.com/corporate-events/{% endblock %}

{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-production-offers.css', { v: 'production-films-2' }) }}">

<style>
:root {
    --vnv-primary: #5EC6C4;
    --vnv-primary-dark: #4aa8a6;
    --vnv-gold: #c5a059;
    --vnv-gold-gradient: linear-gradient(135deg, #bf953f 0%, #fcf6ba 45%, #b38728 100%);
    --vnv-dark-deep: #0a0c0c;
    --vnv-dark-soft: #141818;
    --vnv-dark-card: #1b2021;
    --vnv-light: #ffffff;
    --vnv-marble: #f4f7f8;
    --vnv-text-main: #2d3436;
    --vnv-text-dark: #11181a;
    --vnv-text-light: #f3f5f6;
    --vnv-text-muted: rgba(255,255,255,.74);
    --vnv-text-muted-soft: rgba(255,255,255,.60);
    --vnv-border: rgba(255,255,255,.08);
    --vnv-shadow-lg: 0 40px 100px rgba(0,0,0,.24);
    --vnv-glow: 0 0 40px rgba(94,198,196,.16);
}

html { scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
}

body {
    background: var(--vnv-dark-deep);
    color: var(--vnv-text-light);
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

h1, h2, h3, h4, h5, .luxury-font {
    font-family: 'Playfair Display', serif;
}

.text-vnv { color: var(--vnv-primary) !important; }
.text-gold {
    background: var(--vnv-gold-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.letter-spacing-lg { letter-spacing: 4px; }

.vnv-btn {
    padding: 18px 30px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: all .35s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: .78rem;
    border-radius: 999px;
}

.btn-gold-vnv {
    background: var(--vnv-gold-gradient);
    color: #000 !important;
}
.btn-gold-vnv:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 40px rgba(197,160,89,.22);
}
.btn-outline-vnv {
    border: 2px solid var(--vnv-primary);
    color: var(--vnv-primary) !important;
    background: transparent;
}
.btn-outline-vnv:hover {
    background: var(--vnv-primary);
    color: #fff !important;
}
.btn-ghost-white {
    border: 1px solid rgba(255,255,255,.18);
    color: #fff !important;
    background: transparent;
}
.btn-ghost-white:hover {
    background: #fff;
    color: #000 !important;
}

.section-vnv {
    padding: 120px 0;
    position: relative;
}

.vnv-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(94,198,196,.1);
    color: var(--vnv-primary);
    font-size: .74rem;
    letter-spacing: 2px;
    font-weight: 800;
    text-transform: uppercase;
}

.hero-corporate {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
        linear-gradient(90deg, rgba(10,12,12,.88) 0%, rgba(10,12,12,.68) 42%, rgba(10,12,12,.42) 100%),
        url('{{ asset_for('assets/images/corp1.jpg') }}') center/cover no-repeat;
}

.hero-corporate::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at top right, rgba(94,198,196,.16), transparent 28%),
        radial-gradient(circle at bottom left, rgba(197,160,89,.10), transparent 24%);
    pointer-events: none;
}

.hero-corporate-inner {
    position: relative;
    z-index: 2;
    width: 100%;
}

.hero-corporate h1 {
    font-size: clamp(3rem, 6vw, 5.4rem);
    line-height: 1.02;
    margin: 20px 0 28px;
    max-width: 920px;
}

.hero-corporate p.hero-copy {
    font-size: 1.08rem;
    color: var(--vnv-text-muted);
    max-width: 760px;
    margin-bottom: 34px;
}

.hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 20px;
}

.section-white {
    background: var(--vnv-marble);
    color: var(--vnv-text-dark);
}
.section-white .text-vnv { color: #247a78 !important; }
.section-white .btn-outline-vnv { border-color: #247a78; color: #1e6665 !important; }

.section-dark {
    background: var(--vnv-dark-deep);
    color: var(--vnv-text-light);
}

.section-heading {
    max-width: 920px;
    margin-bottom: 55px;
}
.section-heading h2 {
    font-size: clamp(2.2rem, 4vw, 4.2rem);
    line-height: 1.04;
    margin: 16px 0 18px;
}
.section-heading p {
    font-size: 1.05rem;
    margin: 0;
}
.section-white .section-heading p {
    color: #566164;
}
.section-white .section-heading .vnv-badge {
    color: #236763;
}
.section-dark .section-heading p {
    color: var(--vnv-text-muted);
}

.services-bg-video-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
}

.services-bg-video {
    width: 100%;
    height: 120%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.12;
    filter: blur(2px) saturate(0.8);
    transform: translateY(-6%);
}

.services-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to bottom,
        rgba(10,12,12,0.25),
        rgba(10,12,12,0.30),
        rgba(10,12,12,0.25)
    );
}

.vnv-service-grid-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: rgba(28, 34, 35, 0.82);
    backdrop-filter: blur(6px);
    border-radius: 28px;
    padding: 50px 38px;
    height: 100%;
    border: 1px solid rgba(197, 160, 89, 0.08);
    transition: all 0.6s cubic-bezier(0.165, 0.84, 0.44, 1);
    position: relative;
    overflow: hidden;
    z-index: 2;
}

.vnv-service-grid-card:hover {
    transform: translateY(-12px);
    border-color: var(--vnv-gold);
    box-shadow: 0 40px 80px rgba(0,0,0,0.42);
}

.service-icon-box {
    width: 60px;
    height: 60px;
    background: rgba(197, 160, 89, 0.1);
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--vnv-gold);
    font-size: 1.6rem;
    margin-bottom: 30px;
}

.service-num-floating {
    position: absolute;
    top: 30px;
    right: 34px;
    font-family: 'Playfair Display', serif;
    font-size: 2.2rem;
    font-weight: 900;
    color: rgba(197, 160, 89, 0.40);
}

.vnv-service-grid-card h3 {
    font-size: 1.8rem;
    font-weight: 700;
    color: white;
    margin-bottom: 18px;
}

.vnv-service-grid-card p {
    color: var(--vnv-text-muted);
    font-size: 1rem;
    margin-bottom: 30px;
}

.vnv-link-gold {
    margin-top: auto;
    color: var(--vnv-gold) !important;
    font-weight: 800;
    letter-spacing: 2px;
    font-size: 0.85rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    transition: 0.4s;
}

.vnv-link-gold:hover {
    gap: 20px;
    color: white !important;
}
.section-white .vnv-service-grid-card .vnv-link-gold {
    color: #f6d38d !important;
}

.solution-wrap {
    display: grid;
    grid-template-columns: .95fr 1.05fr;
    gap: 40px;
    align-items: stretch;
}

.solution-image-stack {
    display: grid;
    gap: 24px;
}

.solution-image-stack img {
    width: 100%;
    border-radius: 26px;
    object-fit: cover;
    display: block;
    box-shadow: 0 20px 60px rgba(0,0,0,.10);
    border: 1px solid rgba(17,24,26,.08);
}

.solution-image-stack img:first-child {
    min-height: 260px;
    max-height: 260px;
}
.solution-image-stack img:last-child {
    min-height: 260px;
    max-height: 260px;
}

.solution-panel {
    background: #fff;
    border: 1px solid rgba(17,24,26,.08);
    border-radius: 30px;
    padding: 42px;
    box-shadow: 0 25px 70px rgba(0,0,0,.08);
}

.solution-panel h2 {
    font-size: 2rem;
    color: var(--vnv-text-dark);
    margin-bottom: 18px;
}

.solution-panel p,
.solution-panel li {
    color: #4f5b5f;
}

.solution-panel ul {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
}
.solution-panel ul li {
    position: relative;
    padding-left: 24px;
    margin-bottom: 12px;
}
.solution-panel ul li::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vnv-primary);
    position: absolute;
    left: 0;
    top: 12px;
}

.instagram-block {
    position: relative;
    overflow: hidden;
}

.instagram-block::before {
    content: "";
    position: absolute;
    top: -120px;
    left: -120px;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(94,198,196,0.14) 0%, transparent 70%);
    pointer-events: none;
}

.vnv-studio-card {
    background: linear-gradient(145deg, #161a1b 0%, #0d0f0f 100%);
    border-radius: 30px;
    padding: 50px;
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow: 0 20px 60px rgba(0,0,0,0.35);
}

.vnv-studio-card h3 {
    font-size: 1.8rem;
    font-weight: 800;
}

.vnv-studio-card p {
    color: rgba(255,255,255,0.7);
    margin-bottom: 20px;
}

.vnv-studio-info {
    display: flex;
    gap: 12px;
    align-items: center;
    color: #fff;
    font-weight: 600;
    margin-bottom: 25px;
}

.vnv-studio-info i {
    color: var(--vnv-primary);
}

.vnv-studio-actions {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.instagram-gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.instagram-gallery-grid img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 22px;
    display: block;
    border: 1px solid rgba(255,255,255,.08);
}

.final-cta-card {
    background: linear-gradient(145deg, #161a1b 0%, #0d0f0f 100%);
    border-radius: 45px;
    padding: 90px 70px;
    border: 1px solid var(--vnv-border);
    position: relative;
    overflow: hidden;
}

.final-cta-card::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 10%;
    width: 360px;
    height: 360px;
    transform: translateY(-50%);
    background: radial-gradient(circle, rgba(94, 198, 196, 0.08) 0%, transparent 70%);
    pointer-events: none;
}

.final-cta-card p {
    color: var(--vnv-text-muted-soft);
}

.vnv-btn-fixed {
    min-width: 240px;
    text-align: center;
    white-space: normal;
    line-height: 1.35;
    padding: 20px 28px;
}

@media (max-width: 1199px) {
    .final-cta-card { padding: 60px 45px; }
}

@media (max-width: 991px) {
    .solution-wrap {
        grid-template-columns: 1fr;
    }

    .section-vnv,
    .section-dark,
    .section-white {
        border-radius: 0;
    }

    .solution-panel,
    .vnv-studio-card {
        padding: 32px 28px;
    }

    .final-cta-card {
        padding: 50px 30px;
        text-align: center;
    }

    .vnv-btn-fixed {
        min-width: 100%;
    }

    .services-bg-video {
        height: 100%;
        transform: none;
        filter: blur(1px) saturate(0.8);
    }
}

@media (max-width: 767px) {
    .section-vnv {
        padding: 90px 0;
    }

    .hero-corporate h1 {
        font-size: 2.7rem;
    }

    .vnv-btn {
        width: 100%;
        padding: 18px 24px;
        letter-spacing: 2px;
    }

    .hero-cta-row {
        flex-direction: column;
    }

    .instagram-gallery-grid {
        grid-template-columns: 1fr 1fr;
    }

    .instagram-gallery-grid img {
        height: 150px;
    }
}
</style>
{% include "templates/components/vnvProductionEditorialAssets.html.twig" %}
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-partner-value.css', { v: '1' }) }}">
{% endblock %}

{% block body %}

{% include "templates/layout/publicHeaderVnv.html.twig" %}

<main class="ve-page ve-page--corporate">
{% include "templates/components/vnvProductionHero.html.twig" with {
  hero: {
    slug: 'corporate-events',
    label: 'Corporate programs · South Florida',
    title: 'Corporate event',
    emphasis: 'production.',
    description: 'Produce your conference, launch or client event with a producer who builds the program, briefs your vendors and prepares the room plan.',
    details: ['One run of show for venues, vendors and presenters', 'Audiovisual cues, staffing and hospitality', 'Guest registration and check-in when needed'],
    cta: 'Request Proposal',
    request_service: 'event-production',
    preview_label: 'Guests and exhibitors at a corporate event'
  }
} only %}

<nav class="vp-commercial vp-related" aria-label="Corporate production options"><div class="vp-commercial__inner vp-service-links"><a href="#corporate-services">Explore Services</a><a href="#production-fees">How pricing works</a><a href="{{ path('sponsor-activation-production') }}">Explore a brand activation</a></div></nav>
{% include "templates/components/vnvProductionOffer.html.twig" with {
    offer: {
        id: 'corporate-production',
        label: 'Integrated corporate production',
        title: 'Built for business environments',
        description: 'Jonathan Moreno leads the VNV production team. We build the scope and budget with you, then confirm venue requirements, vendor decisions and the rehearsal plan in VNV-Q.',
        image: 'assets/images/corp2.jpg',
        image_alt: 'Attendees listening to a participant with a handheld microphone',
        caption: 'Illustrative format · Conference and speaker session',
        deliverables: [
            ['Meetings and conferences', 'Plan seating and room flow, set microphone and presentation cues, coordinate speaker transitions and build in time for networking and food service.'],
            ['Product launches and client events', 'Plan the reveal, demo or guest interaction. Coordinate sound, screens, lighting, staffing and hospitality around the sequence of the event.'],
            ['A written production plan', 'Align the venue, vendors and event team around one run of show. Define who manages each handoff and include digital RSVP and check-in when the event needs them.']
        ]
    }
} only %}

{% include "templates/components/vnvProductionFilm.html.twig" with {
    film: {
        slug: 'corporate-events',
        route: 'corporate-events',
        credit: 'Illustrative event footage and animated workflows. AI-generated narration.',
        title: 'From the guest list to the show floor',
        description: 'Breakfast is still being served as the keynote begins. Who cues the microphone? See how we rehearse the handoff between catering, sound and the show caller. Full corporate production includes the digital event system at no extra cost for this event and future ones.',
        cta: 'Tell us about your event',
        request_service: 'event-production'
    }
} only %}

<section class="section-vnv section-dark" id="corporate-services">
    <div class="services-bg-video-wrap">
        <div class="services-bg-overlay"></div>
    </div>

    <div class="container position-relative" style="z-index:2;">
        <div class="text-center mb-5 pb-5 section-heading">
            <span class="vnv-badge">Core Services</span>
            <h2 class="text-white">Services for your <span class="text-vnv">corporate event</span></h2>
            <p>Your producer coordinates the services in your approved scope. If you already have a production team, you can also explore individual services below.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-xl-3">
                <div class="vnv-service-grid-card">
                    <span class="service-num-floating">01</span>
                    <div class="service-icon-box"><i class="fa-solid fa-utensils"></i></div>
                    <h3>Food service &amp; catering</h3>
                    <p>Plan coffee breaks, working lunches or a reception around the session times, guest count and layout of your venue.</p>
                    <a href="{{ path('vnv-gourmet') }}" class="vnv-link-gold">Explore catering <span aria-hidden="true">→</span></a>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="vnv-service-grid-card">
                    <span class="service-num-floating">02</span>
                    <div class="service-icon-box"><i class="fa-solid fa-volume-high"></i></div>
                    <h3>Sound &amp; entertainment</h3>
                    <p>Coordinate microphones for presenters and Q&amp;A. For a reception, choose a DJ or live music to suit the room.</p>
                    <a href="{{ path('vnv-live') }}" class="vnv-link-gold">Explore DJs and live music <span aria-hidden="true">→</span></a>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="vnv-service-grid-card">
                    <span class="service-num-floating">03</span>
                    <div class="service-icon-box"><i class="fa-solid fa-display"></i></div>
                    <h3>Multimedia</h3>
                    <p>Plan how slides and video will play during the program. Add event photography, filming or a photo booth when your brief calls for it.</p>
                    <a href="{{ path('photo-booth-rental-video-photography-services-in-south-florida') }}" class="vnv-link-gold">Explore photo and video <span aria-hidden="true">→</span></a>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="vnv-service-grid-card">
                    <span class="service-num-floating">04</span>
                    <div class="service-icon-box"><i class="fa-solid fa-user-group"></i></div>
                    <h3>Staffing</h3>
                    <p>Assign setup, welcome desk and service roles so your employees know who handles arrivals and whom to call during the program.</p>
                    <a href="{{ path('event-staffing/') }}" class="vnv-link-gold">Explore event staffing <span aria-hidden="true">→</span></a>
                </div>
            </div>
        </div>
    </div>
</section>

{% include "templates/components/vnvProductionFees.html.twig" with {
    heading: 'How pricing works', show_activation_note: false,
    services: production_services, keys: ['production-essential', 'full-event-production', 'full-event-production-plus', 'advanced-production'],
    fee_includes: fee_includes, direct_costs: direct_costs
} only %}

{% include "templates/components/vnvHowWeWork.html.twig" only %}

{% include "templates/components/vnvProductionPartnerValue.html.twig" with { audience: 'corporate' } only %}

<section class="section-vnv section-white" id="corporate-partnerships">
    <div class="container">
        <div class="text-center mb-5 section-heading" style="margin-left:auto;margin-right:auto;">
            <span class="vnv-badge">Corporate Production Programs</span>
            <h2>Planning one event or an annual series?</h2>
            <p>VNV offers paid production for a single event or an annual calendar. Your proposal sets out the event count, deliverables, budget and approvals.</p>
        </div>
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="vnv-service-grid-card h-100">
                    <div class="service-icon-box"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i></div>
                    <h3>One-time full production</h3>
                    <p>For a single conference, launch or reception, we scope the venue coordination, technical production, hospitality and crew your program needs.</p>
                    <a href="{{ path('') }}?request_service=event-production#vnvRequestModal" data-vnv-open-request data-vnv-request-service="event-production" class="vnv-link-gold">Discuss one event <span aria-hidden="true">→</span></a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="vnv-service-grid-card h-100">
                    <div class="service-icon-box"><i class="fa-solid fa-repeat" aria-hidden="true"></i></div>
                    <h3>Annual production partnership</h3>
                    <p>Plan 2, 4 or 6 events with shared production standards and quarterly reviews. Each event has an agreed scope within the annual plan.</p>
                    <a href="{{ path('') }}?request_service=event-production#vnvRequestModal" data-vnv-open-request data-vnv-request-service="event-production" class="vnv-link-gold">Discuss an annual plan <span aria-hidden="true">→</span></a>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="vnv-service-grid-card h-100">
                    <div class="service-icon-box"><i class="fa-solid fa-bullseye" aria-hidden="true"></i></div>
                    <h3>Brand Experiences &amp; Activation</h3>
                    <p>Brand activation is included when VNV produces your event. At another organizer’s event, standalone activation is {{ production_services['brand-activation'].price }}. We quote graphics, installation and booth staff for your approval.</p>
                    <a href="{{ path('sponsor-activation-production') }}" class="vnv-link-gold">Explore brand experiences <span aria-hidden="true">→</span></a>
                </div>
            </div>
        </div>
        <p class="text-center text-muted mt-4">Sponsorship-development support is available only under a written agreement. VNV does not guarantee sponsors, revenue or return on investment.</p>
    </div>
</section>

<section class="section-vnv section-white">
    <div class="container">
        <div class="solution-wrap">
            <div class="solution-image-stack">
                <img src="{{ asset_for('assets/images/corp3.jpg') }}" alt="Guests raising a toast at an outdoor evening reception">
                <img src="{{ asset_for('assets/images/corp4.jpg') }}" alt="Guests talking around cocktail tables at a daytime networking event">
            </div>

            <div class="solution-panel">
                <h2>How this helps your team</h2>
                <p>You set the objective, approve the budget and decide who signs off on brand and program changes. Your producer records approvals in VNV-Q so the crew can see which version of the plan to use.</p>

                <ul>
                    <li><strong>Before the event.</strong> Agree on the venue plan, vendor responsibilities, speaker materials and the run of show.</li>
                    <li><strong>On site.</strong> If you book a Day Coordinator, that person briefs the welcome team and keeps service and speakers on schedule.</li>
                    <li><strong>At handoff.</strong> Review the deliverables in your brief, such as event photos or attendance records when check-in is included.</li>
                </ul>
            </div>
        </div>
    </div>
</section>

