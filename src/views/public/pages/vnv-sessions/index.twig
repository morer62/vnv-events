{% extends "templates/base.twig" %}

{% set show_whatsapp = true %}
{% set defer_public_third_party = true %}
{% set skip_public_gtm_initial = true %}
{% set skip_public_app_bundle = true %}
{% set skip_public_google_maps = true %}
{% set skip_public_stripe = true %}
{% set skip_public_bootstrap_js = true %}
{% set skip_base_fontawesome = true %}
{% set skip_base_inter_font = true %}
{% set skip_base_app_css = true %}
{% set skip_base_bootstrap_css = true %}

{% block title %}VNV Studio | DJ Sessions, Local Tech Lab & The Ground Floor{% endblock %}

{% block meta_description %}
    Explore VNV Studio: open-format DJ Sessions by DJ Jonny in the Mix plus Local Tech Lab and The Ground Floor podcasts from VNV Events.
{% endblock %}
{% block canonical %}https://vnvevents.com/vnv-sessions/{% endblock %}

{% block styles %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,800;1,800&display=swap" rel="stylesheet">
<style>
:root {
    --sessions-ink: #0b1010;
    --sessions-panel: #111819;
    --sessions-soft: #f5f7f7;
    --sessions-line: rgba(17, 24, 26, .1);
    --sessions-muted: #617073;
    --sessions-teal: #45e3cf;
    --sessions-teal-dark: #0f766e;
    --sessions-gold: #d8ad45;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background:
        radial-gradient(circle at 9% 18%, rgba(69, 227, 207, .16), transparent 24rem),
        radial-gradient(circle at 90% 10%, rgba(216, 173, 69, .14), transparent 24rem),
        linear-gradient(180deg, #eef4f4 0%, #ffffff 42%, #0b1010 100%);
    color: var(--sessions-ink);
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    overflow-x: hidden;
}

.sessions-page {
    min-height: 100vh;
}

.sessions-wrap {
    width: min(1320px, calc(100% - 40px));
    margin: 0 auto;
}

.sessions-hero {
    padding: 84px 0 72px;
}

.sessions-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(420px, 1.1fr);
    gap: 38px;
    align-items: center;
}

.sessions-kicker,
.sessions-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-radius: 999px;
    padding: 10px 16px;
    background: rgba(69, 227, 207, .12);
    color: var(--sessions-teal-dark);
    font-size: .76rem;
    font-weight: 900;
    letter-spacing: 1.6px;
    text-transform: uppercase;
}

.sessions-hero h1 {
    margin: 24px 0 22px;
    max-width: 760px;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(4rem, 8vw, 8.4rem);
    line-height: .88;
    letter-spacing: 0;
}

.sessions-hero h1 span {
    color: var(--sessions-teal-dark);
    font-style: italic;
}

.sessions-lede {
    max-width: 650px;
    margin: 0 0 28px;
    color: #425053;
    font-size: clamp(1.08rem, 1.8vw, 1.32rem);
    line-height: 1.75;
}

.sessions-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
}

.sessions-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 22px;
    border-radius: 999px;
    color: #091010;
    background: linear-gradient(135deg, #f3d779 0%, var(--sessions-gold) 100%);
    font-size: .82rem;
    font-weight: 900;
    letter-spacing: 1.2px;
    text-decoration: none;
    text-transform: uppercase;
    box-shadow: 0 20px 44px rgba(216, 173, 69, .24);
}

.sessions-btn--ghost {
    color: var(--sessions-ink);
    background: rgba(255, 255, 255, .65);
    border: 1px solid rgba(17, 24, 26, .12);
    box-shadow: none;
}

.sessions-btn:focus-visible,
.sessions-mini-card:focus-visible,
.sessions-podcast-card__link:focus-visible {
    outline: 3px solid var(--sessions-gold);
    outline-offset: 4px;
}

.sessions-intro-card {
    display: flex;
    gap: 16px;
    max-width: 660px;
    padding: 20px;
    border: 1px solid var(--sessions-line);
    border-radius: 8px;
    background: rgba(255, 255, 255, .72);
    box-shadow: 0 20px 60px rgba(17, 24, 26, .08);
    backdrop-filter: blur(14px);
}

.sessions-intro-card i {
    width: 52px;
    height: 52px;
    flex: 0 0 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: rgba(69, 227, 207, .14);
    color: var(--sessions-teal-dark);
    font-size: 1.2rem;
}

.sessions-intro-card h2 {
    margin: 0 0 6px;
    font-size: 1.08rem;
}

.sessions-intro-card p {
    margin: 0;
    color: var(--sessions-muted);
    line-height: 1.7;
}

.sessions-feature {
    position: relative;
    min-height: 620px;
    border-radius: 8px;
    overflow: hidden;
    background:
        linear-gradient(135deg, rgba(8, 13, 13, .96), rgba(8, 13, 13, .48)),
        url("{{ asset_for('assets/images/dj3.jpg') }}") center/cover no-repeat;
    box-shadow: 0 34px 90px rgba(0, 0, 0, .24);
}

.sessions-feature__content {
    position: absolute;
    inset: auto 0 0 0;
    padding: 34px;
    color: #fff;
}

.sessions-feature__tag {
    color: var(--sessions-teal);
    font-size: .76rem;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}

.sessions-feature h2 {
    margin: 14px 0 12px;
    max-width: 620px;
    font-size: clamp(2rem, 4vw, 4.2rem);
    line-height: .98;
}

.sessions-feature p {
    max-width: 620px;
    margin: 0;
    color: rgba(255, 255, 255, .76);
    line-height: 1.75;
}

.sessions-mini-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 18px;
}

.sessions-mini-card {
    display: block;
    border: 1px solid var(--sessions-line);
    border-radius: 8px;
    padding: 18px;
    color: inherit;
    background: rgba(255, 255, 255, .76);
    text-decoration: none;
    transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
}

.sessions-mini-card:hover {
    color: inherit;
    transform: translateY(-3px);
    border-color: rgba(15, 118, 110, .32);
    box-shadow: 0 18px 42px rgba(17, 24, 26, .08);
}

.sessions-mini-card strong {
    display: block;
    margin-bottom: 8px;
    color: var(--sessions-teal-dark);
    font-size: .8rem;
    letter-spacing: 1.4px;
    text-transform: uppercase;
}

.sessions-mini-card p {
    margin: 0;
    color: var(--sessions-muted);
    line-height: 1.65;
}

.sessions-section {
    padding: 74px 0;
}

.sessions-section--dark {
    background: var(--sessions-ink);
    color: #fff;
}

.sessions-heading {
    max-width: 820px;
    margin-bottom: 32px;
}

.sessions-heading h2 {
    margin: 14px 0 12px;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 5.4rem);
    line-height: .96;
}

.sessions-heading p {
    margin: 0;
    color: var(--sessions-muted);
    font-size: 1.08rem;
    line-height: 1.75;
}

.sessions-section--dark .sessions-heading p {
    color: rgba(255, 255, 255, .68);
}

.sessions-media-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
}

.sessions-media-card {
    min-width: 0;
    border-radius: 8px;
    padding: 22px;
    background: linear-gradient(145deg, #101617 0%, #171f20 100%);
    border: 1px solid rgba(255, 255, 255, .08);
    box-shadow: 0 26px 70px rgba(0, 0, 0, .25);
}

.sessions-media-card--light {
    background: #fff;
    border-color: var(--sessions-line);
    box-shadow: 0 20px 60px rgba(17, 24, 26, .08);
}

.sessions-media-card h3 {
    margin: 12px 0 8px;
    color: #fff;
    font-size: clamp(1.4rem, 2.2vw, 2rem);
}

.sessions-media-card--light h3 {
    color: var(--sessions-ink);
}

.sessions-media-card p {
    margin: 0 0 18px;
    color: rgba(255, 255, 255, .7);
    line-height: 1.7;
}

.sessions-media-card--light p {
    color: var(--sessions-muted);
}

.sessions-section--podcasts {
    position: relative;
    overflow: hidden;
    background:
        radial-gradient(circle at 9% 12%, rgba(69, 227, 207, .18), transparent 26rem),
        radial-gradient(circle at 91% 86%, rgba(216, 173, 69, .15), transparent 24rem),
        #f4f7f7;
}

.sessions-podcast-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
}

.sessions-podcast-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 4vw, 40px);
    border: 1px solid var(--sessions-line);
    border-radius: 18px;
    background: rgba(255, 255, 255, .9);
    box-shadow: 0 24px 70px rgba(17, 24, 26, .09);
}

.sessions-podcast-card--ground {
    color: #fff;
    background: linear-gradient(145deg, #0b1214, #152326);
    border-color: rgba(255, 255, 255, .1);
}

.sessions-podcast-card__logo {
    height: 94px;
    display: flex;
    align-items: center;
    margin-bottom: 26px;
    padding: 14px;
    border-radius: 14px;
    background: #071416;
    overflow: hidden;
}

.sessions-podcast-card__logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: left center;
}

.sessions-podcast-card__eyebrow {
    color: var(--sessions-teal-dark);
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .14em;
    text-transform: uppercase;
}

.sessions-podcast-card--ground .sessions-podcast-card__eyebrow,
.sessions-podcast-card--ground .sessions-podcast-card__link {
    color: var(--sessions-teal);
}

.sessions-podcast-card h3 {
    margin: 10px 0 12px;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1;
}

.sessions-podcast-card p {
    margin: 0 0 24px;
    color: var(--sessions-muted);
    line-height: 1.72;
}

.sessions-podcast-card--ground p {
    color: rgba(255, 255, 255, .68);
}

.sessions-podcast-card__meta {
    margin-top: auto;
    color: #6a7779;
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
}

.sessions-podcast-card--ground .sessions-podcast-card__meta {
    color: rgba(255, 255, 255, .48);
}

.sessions-podcast-card__link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 17px;
    color: var(--sessions-teal-dark);
    font-size: .78rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-decoration: none;
    text-transform: uppercase;
}

.sessions-podcast-catalog {
    display: flex;
    justify-content: flex-end;
    margin-top: 26px;
}

.sessions-player {
    overflow: hidden;
    border-radius: 8px;
    background: #050707;
    border: 1px solid rgba(255, 255, 255, .08);
}

.sessions-player--audio {
    background: #f0f3f3;
    border-color: var(--sessions-line);
}

.sessions-player iframe {
    display: block;
    width: 100%;
    border: 0;
}

.sessions-video {
    aspect-ratio: 16 / 9;
}

.sessions-video iframe {
    height: 100%;
}

.sessions-audio iframe {
    height: 420px;
}

.sessions-details-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
}

.sessions-detail-card {
    min-height: 220px;
    border-radius: 8px;
    padding: 24px;
    background: rgba(255, 255, 255, .06);
    border: 1px solid rgba(255, 255, 255, .1);
}

.sessions-detail-card i {
    color: var(--sessions-teal);
    font-size: 1.5rem;
}

.sessions-detail-card h3 {
    margin: 18px 0 10px;
    color: #fff;
}

.sessions-detail-card p {
    margin: 0;
    color: rgba(255, 255, 255, .68);
    line-height: 1.7;
}

.sessions-cta {
    padding: 84px 0;
    background:
        linear-gradient(135deg, rgba(69, 227, 207, .12), rgba(216, 173, 69, .1)),
        #f7f9f9;
}

.sessions-cta__box {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 26px;
    align-items: center;
    border-radius: 8px;
    padding: 32px;
    background: #fff;
    border: 1px solid var(--sessions-line);
    box-shadow: 0 22px 70px rgba(17, 24, 26, .1);
}

.sessions-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 12px;
}

.sessions-cta h2 {
    margin: 0 0 8px;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(2rem, 4vw, 4rem);
    line-height: 1;
}

.sessions-cta p {
    max-width: 760px;
    margin: 0;
    color: var(--sessions-muted);
    line-height: 1.75;
}

@media (max-width: 1100px) {
    .sessions-hero__grid,
    .sessions-media-grid,
    .sessions-cta__box {
        grid-template-columns: 1fr;
    }

    .sessions-cta__actions {
        justify-content: flex-start;
    }

    .sessions-feature {
        min-height: 520px;
    }
}

@media (max-width: 760px) {
    .sessions-wrap {
        width: min(100% - 28px, 1320px);
    }

    .sessions-hero {
        padding: 54px 0 48px;
    }

    .sessions-hero h1 {
        font-size: clamp(3.2rem, 18vw, 5rem);
    }

    .sessions-intro-card {
        flex-direction: column;
    }

    .sessions-feature {
        min-height: 470px;
    }

    .sessions-feature__content {
        padding: 24px;
    }

    .sessions-mini-grid,
    .sessions-podcast-grid,
    .sessions-details-grid {
        grid-template-columns: 1fr;
    }

    .sessions-podcast-catalog {
        justify-content: stretch;
    }

    .sessions-podcast-catalog .sessions-btn,
    .sessions-cta__actions .sessions-btn {
        width: 100%;
    }

    .sessions-section {
        padding: 56px 0;
    }

    .sessions-media-card,
    .sessions-cta__box {
        padding: 18px;
    }
}
</style>
{% endblock %}

{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}

<main class="sessions-page">
    <section class="sessions-hero">
        <div class="sessions-wrap">
            <div class="sessions-hero__grid">
                <div>
                    <span class="sessions-kicker"><i class="fa-solid fa-headphones" aria-hidden="true"></i> Listen, watch &amp; discover</span>
                    <h1>VNV <span>Studio</span></h1>
                    <p class="sessions-lede">
                        One creative home for <strong>VNV Sessions</strong>, <strong>Local Tech Lab</strong> and <strong>The Ground Floor</strong>—music, practical ideas and honest conversations connected to events and local business.
                    </p>

                    <div class="sessions-intro-card">
                        <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                        <div>
                            <h2>Three formats. One VNV point of view.</h2>
                            <p>
                                Start with curated DJ sets, move into useful technology conversations, or hear the real stories and systems behind memorable events.
                            </p>
                        </div>
                    </div>

                    <div class="sessions-actions">
                        <a class="sessions-btn" href="#music"><i class="fa-solid fa-play" aria-hidden="true"></i> Play DJ Sessions</a>
                        <a class="sessions-btn sessions-btn--ghost" href="#podcasts"><i class="fa-solid fa-microphone-lines" aria-hidden="true"></i> Explore Podcasts</a>
                    </div>
                </div>

                <div class="sessions-feature" aria-label="VNV Studio music and conversations">
                    <div class="sessions-feature__content">
                        <div class="sessions-feature__tag">Music · Podcasts · Conversations</div>
                        <h2>The VNV experience, in sound and on camera.</h2>
                        <p>
                            A growing media space for the energy, ideas and people shaping VNV Events and the businesses around it.
                        </p>
                    </div>
                </div>
            </div>

            <div class="sessions-mini-grid">
                <a class="sessions-mini-card" href="#music">
                    <strong>VNV Sessions</strong>
                    <p>Open-format DJ sets and event-ready energy by DJ Jonny in the Mix.</p>
                </a>
                <a class="sessions-mini-card" href="{{ path('/podcasts') }}#local-tech-lab">
                    <strong>Local Tech Lab</strong>
                    <p>Practical conversations about technology, automation, marketing and local business.</p>
                </a>
                <a class="sessions-mini-card" href="{{ path('/podcasts') }}#the-ground-floor">
                    <strong>The Ground Floor</strong>
                    <p>Honest conversations about events, service businesses and the work behind the experience.</p>
                </a>
            </div>
        </div>
    </section>

    <section class="sessions-section sessions-section--dark" id="music">
        <div class="sessions-wrap">
            <div class="sessions-heading">
                <span class="sessions-pill"><i class="fa-solid fa-music"></i> Music Sessions</span>
                <h2>Official VNV Sessions playlist</h2>
                <p>
                    A curated playlist of mixes designed to bring energy, rhythm and atmosphere to any setting.
                </p>
            </div>

            <div class="sessions-media-grid">
                <div class="sessions-media-card">
                    <span class="sessions-pill">Playlist</span>
                    <h3>Press play and set the room.</h3>
                    <p>
                        Use the playlist when you want to feel the VNV sound before an event, share a vibe with a client or simply keep the day moving.
                    </p>
                    <div class="sessions-player sessions-video">
                        <iframe
                            src="https://www.youtube-nocookie.com/embed/videoseries?list=PL8hdMpm11FxmEz_1IrnoN3DpbOoMHtFkP"
                            title="VNV Sessions Playlist"
                            loading="lazy"
                            referrerpolicy="strict-origin-when-cross-origin"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            allowfullscreen>
                        </iframe>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="sessions-section sessions-section--podcasts" id="podcasts" aria-labelledby="studio-podcasts-title">
        <div class="sessions-wrap">
            <div class="sessions-heading">
                <span class="sessions-pill"><i class="fa-solid fa-microphone-lines" aria-hidden="true"></i> Podcasts</span>
                <h2 id="studio-podcasts-title">Two programs. Different conversations.</h2>
                <p>
                    Local Tech Lab explores practical tools for local business. The Ground Floor shares honest conversations about events, relationships and the systems behind service businesses.
                </p>
            </div>

            <div class="sessions-podcast-grid">
                {% for program in programs %}
                    <article class="sessions-podcast-card sessions-podcast-card--{{ program.identity }}">
                        <div class="sessions-podcast-card__logo">
                            <img src="{{ asset_for(program.logo) }}" alt="{{ program.logo_alt }}" width="{{ program.logo_width }}" height="{{ program.logo_height }}" loading="lazy" decoding="async">
                        </div>
                        <span class="sessions-podcast-card__eyebrow">{{ program.publisher }} original</span>
                        <h3>{{ program.name }}</h3>
                        <p>{{ program.summary }}</p>
                        <span class="sessions-podcast-card__meta">{{ program.episodes|length }} published episode{{ program.episodes|length == 1 ? '' : 's' }}</span>
                        <a class="sessions-podcast-card__link" href="{{ path('/podcasts') }}#{{ program.key }}">
                            Explore {{ program.name }} <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                        </a>
                    </article>
                {% endfor %}
            </div>

            <div class="sessions-podcast-catalog">
                <a class="sessions-btn" href="{{ path('/podcasts') }}"><i class="fa-solid fa-circle-play" aria-hidden="true"></i> View All Podcast Episodes</a>
            </div>
        </div>
    </section>

    <section class="sessions-cta">
        <div class="sessions-wrap">
            <div class="sessions-cta__box">
                <div>
                    <h2>Choose what you want to play next.</h2>
                    <p>
                        Start with DJ Sessions, explore both podcast programs, or open a new request when you want VNV music direction at your event.
                    </p>
                </div>
                <div class="sessions-cta__actions">
                    <a class="sessions-btn sessions-btn--ghost" href="{{ path('/podcasts') }}"><i class="fa-solid fa-microphone-lines" aria-hidden="true"></i> Podcast Catalog</a>
                    <a class="sessions-btn" href="#" data-vnv-open-request><i class="fa-solid fa-paper-plane" aria-hidden="true"></i> New Request</a>
                </div>
            </div>
        </div>
    </section>
</main>

{% include "templates/components/publicEventRequestModal.html.twig" with {
    request_form_action: "/api/public/event-request"
} %}

{% include "templates/layout/publicFooterVnv.html.twig" %}
{% endblock %}
