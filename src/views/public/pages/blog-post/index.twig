{% extends "templates/base.twig" %}

{% block title %}
    {{ post.meta_title ?: post.title ~ ' | VNV Events Blog' }}
{% endblock %}

{% block meta_description %}
    {{ post.meta_description ?: post.excerpt ?: 'VNV Events blog article' }}
{% endblock %}

{% block meta_keywords %}
    {{ post.meta_keywords ?: 'VNV Events blog, South Florida events, event planning blog' }}
{% endblock %}

{% block canonical %}
    {{ post.canonical_url ?: ('https://vnvevents.com' ~ route.route) }}
{% endblock %}

{% block og_title %}
    {{ post.og_title ?: post.meta_title ?: post.title }}
{% endblock %}

{% block og_description %}
    {{ post.og_description ?: post.meta_description ?: post.excerpt ?: 'VNV Events blog article' }}
{% endblock %}

{% block og_url %}
    {{ post.canonical_url ?: ('https://vnvevents.com' ~ route.route) }}
{% endblock %}

{% block og_image %}
    {{ post.featured_image_url ?: asset_for('assets/images/planner-hub-logo-negative.png') }}
{% endblock %}

{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}
<style>
    :root{
        --vnv-bg:#f6f1e8;
        --vnv-surface:#ffffff;
        --vnv-text:#171717;
        --vnv-muted:#6b6358;
        --vnv-border:#e8ddcc;
        --vnv-primary:#15161d;
        --vnv-primary-soft:#252a33;
        --vnv-accent:#3f4553;
        --vnv-highlight:#c8a86b;
        --vnv-radius-lg:24px;
        --vnv-shadow:0 18px 42px rgba(24,18,10,.14);
    }

    body{
        font-family:"Inter",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
        color:var(--vnv-text);
        background:
            radial-gradient(circle at 12% 0%, rgba(200,168,107,.18), transparent 34%),
            radial-gradient(circle at 88% 12%, rgba(23,27,38,.1), transparent 38%),
            linear-gradient(180deg,#fff 0%,var(--vnv-bg) 100%);
    }

    body::before{
        display:none !important;
        content:none !important;
    }

    html, body{
        overflow-x:hidden;
    }

    .blog-post-shell{ padding:64px 0 80px; position:relative; }

    .blog-post-hero{
        margin-bottom:34px;
        background:linear-gradient(135deg,var(--vnv-primary) 0%,var(--vnv-primary-soft) 55%,var(--vnv-accent) 100%);
        color:#fff;
        border-radius:30px;
        padding:38px 34px;
        box-shadow:0 28px 66px rgba(10,10,14,.28);
        position:relative;
        overflow:hidden;
        border:1px solid rgba(255,255,255,.16);
    }

    .blog-post-hero::after{
        content:"";
        position:absolute;
        inset:auto -70px -70px auto;
        width:260px;
        height:260px;
        border-radius:999px;
        background:radial-gradient(circle,rgba(200,168,107,.34),transparent 68%);
    }

    .blog-post-hero::before{
        content:"";
        position:absolute;
        inset:0;
        pointer-events:none;
        background:linear-gradient(110deg, rgba(255,255,255,.13), transparent 36%);
    }

    .blog-post-category{
        display:inline-flex;
        align-items:center;
        gap:8px;
        padding:8px 14px;
        border-radius:999px;
        background:rgba(255,255,255,.12);
        border:1px solid rgba(200,168,107,.5);
        color:#fff;
        text-decoration:none;
        font-weight:800;
        font-size:.78rem;
        margin-bottom:18px;
        letter-spacing:.08em;
        text-transform:uppercase;
    }

    .blog-post-title{
        font-size:clamp(2.3rem,4.2vw,3.8rem);
        line-height:1.05;
        font-weight:700;
        margin-bottom:18px;
        color:#fff;
        font-family:Georgia,"Times New Roman",serif;
        letter-spacing:-.3px;
    }

    .blog-post-excerpt{
        font-size:1.12rem;
        line-height:1.8;
        color:rgba(255,255,255,.9);
        max-width:900px;
        margin-bottom:18px;
    }

    .blog-post-meta{
        display:flex;
        flex-wrap:wrap;
        gap:14px 22px;
        color:rgba(255,255,255,.9);
        font-size:.9rem;
        margin-bottom:12px;
    }

    .blog-post-meta span{
        display:inline-flex;
        align-items:center;
        gap:8px;
        border-radius:999px;
        background:rgba(255,255,255,.12);
        border:1px solid rgba(255,255,255,.2);
        padding:6px 12px;
    }

    .blog-post-featured{ margin:32px 0 40px; }

    .blog-post-featured img{
        width:100%;
        max-height:560px;
        object-fit:cover;
        border-radius:24px;
        border:1px solid var(--vnv-border);
        display:block;
        box-shadow:var(--vnv-shadow);
    }

    .blog-post-body{
        font-size:1.03rem;
        line-height:1.9;
        color:var(--vnv-text);
        background:var(--vnv-surface);
        border:1px solid var(--vnv-border);
        border-radius:var(--vnv-radius-lg);
        box-shadow:var(--vnv-shadow);
        padding:30px 28px;
    }

    .blog-post-body h2,
    .blog-post-body h3,
    .blog-post-body h4{
        margin-top:2.2rem;
        margin-bottom:1rem;
        color:var(--vnv-text);
        font-weight:700;
        font-family:Georgia,"Times New Roman",serif;
        letter-spacing:-.2px;
    }

    .blog-post-body p{ margin-bottom:1.25rem; }

    .blog-post-body > p:first-of-type::first-letter{
        float:left;
        font-size:3.4rem;
        line-height:.85;
        font-weight:800;
        color:var(--vnv-highlight);
        margin:.08rem .44rem 0 0;
        font-family:Georgia,"Times New Roman",serif;
    }

    .blog-post-body ul,
    .blog-post-body ol{
        margin-bottom:1.25rem;
        padding-left:1.3rem;
    }

    .blog-post-body blockquote{
        border-left:4px solid var(--vnv-highlight);
        padding:14px 20px;
        background:linear-gradient(135deg,#fffaf1 0%, #f9f4ea 100%);
        border-radius:0 14px 14px 0;
        margin:1.5rem 0;
        font-style:italic;
        color:#433829;
    }

    .blog-post-body img{
        max-width:100%;
        height:auto;
        border-radius:18px;
    }

    .blog-post-back{ margin-top:48px; }
    .blog-post-top-back{ margin:0 0 18px; }

    .blog-post-back a,
    .blog-post-top-back a{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        padding:12px 18px;
        border-radius:12px;
        background:#f3f4f6;
        color:var(--vnv-text);
        text-decoration:none;
        font-weight:700;
        border:1px solid var(--vnv-border);
        transition:.2s ease;
        box-shadow:0 8px 22px rgba(17,13,9,.08);
    }

    .blog-post-back a:hover,
    .blog-post-top-back a:hover{ background:#e5e7eb; }

    @media (max-width: 768px){
        .blog-post-shell{ padding:48px 0 58px; }
        .blog-post-hero{ border-radius:22px; padding:28px 20px; }
        .blog-post-body{ padding:22px 18px; }
    }
</style>

<section class="blog-post-shell">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="blog-post-top-back">
                    {% if category %}
                        <a href="{{ path('blog/' ~ category.slug ~ '/') }}">&larr; Back to {{ category.name }}</a>
                    {% else %}
                        <a href="{{ path('blog') }}">&larr; Back to Blog</a>
                    {% endif %}
                </div>

                <header class="blog-post-hero">
                    {% if category %}
                        <a class="blog-post-category" href="{{ path('blog/' ~ category.slug ~ '/') }}">
                            {{ category.name }}
                        </a>
                    {% endif %}

                    <h1 class="blog-post-title">{{ post.title }}</h1>

                    {% if post.excerpt %}
                        <div class="blog-post-excerpt">{{ post.excerpt }}</div>
                    {% endif %}

                    <div class="blog-post-meta">
                        {% if post.published_at %}
                            <span>Published: {{ post.published_at|date("F j, Y") }}</span>
                        {% endif %}

                        {% if category %}
                            <span>Category: {{ category.name }}</span>
                        {% endif %}
                    </div>
                </header>

                {% if post.featured_image_url %}
                    <div class="blog-post-featured">
                        <img src="{{ post.featured_image_url }}" alt="{{ post.title }}">
                    </div>
                {% endif %}

                {% if post.body_html %}
                    <article class="blog-post-body">
                        {{ post.body_html|raw }}
                    </article>
                {% elseif content_json.hero or content_json.blocks %}
                    <article class="blog-post-body">
                        {% if content_json.hero %}
                            <section class="mb-4">
                                {% if content_json.hero.title %}
                                    <h2>{{ content_json.hero.title }}</h2>
                                {% endif %}
                                {% if content_json.hero.subtitle %}
                                    <p>{{ content_json.hero.subtitle }}</p>
                                {% endif %}
                            </section>
                        {% endif %}

                        {% if content_json.blocks %}
                            {% for block in content_json.blocks %}
                                <section class="mb-4">
                                    {% if block.title %}
                                        <h3>{{ block.title }}</h3>
                                    {% endif %}
                                    {% if block.content %}
                                        <div>{{ block.content|raw }}</div>
                                    {% endif %}
                                </section>
                            {% endfor %}
                        {% endif %}
                    </article>
                {% else %}
                    <div class="alert alert-light border">
                        This article has no public body content yet.
                    </div>
                {% endif %}

                {% if internal_links is defined and internal_links is not empty %}
                    <nav class="blog-post-back" aria-label="Related VNV Events links">
                        {% for link in internal_links %}
                            <a href="{{ link.url }}" class="me-2 mb-2">{{ link.label }}</a>
                        {% endfor %}
                    </nav>
                {% endif %}

                <div class="blog-post-back">
                    {% if category %}
                        <a href="{{ path('blog/' ~ category.slug ~ '/') }}">&larr; Back to {{ category.name }}</a>
                    {% else %}
                        <a href="{{ path('blog') }}">&larr; Back to Blog</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>
{% include "templates/components/publicEventRequestModal.html.twig" %}
{% include "templates/layout/publicFooterVnv.html.twig" %}
{% endblock %}
