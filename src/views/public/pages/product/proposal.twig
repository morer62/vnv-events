{% extends "templates/base.twig" %}
{% block title %}{{ service.name }} | VNV Events{% endblock %}
{% block meta_description %}{{ service.price }}. {{ service.summary }}{% endblock %}
{% block canonical %}https://vnvevents.com/product/{{ slug }}{% endblock %}
{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}
<style>
.vnv-proposal{max-width:76rem;margin:auto;padding:clamp(1.25rem,4vw,4rem)}.vnv-proposal nav{margin-bottom:1.5rem}.vnv-proposal article{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,23rem),1fr));background:#112b31;color:#fff;border-radius:1.4rem;overflow:hidden}.vnv-proposal article img{width:100%;height:100%;max-height:38rem;object-fit:cover}.vnv-proposal section{padding:clamp(1.5rem,4vw,3.5rem)}.vnv-proposal h1{font-size:clamp(2rem,4.2vw,3.8rem);line-height:1.06;color:#fff}.vnv-proposal .fee{color:#ffda8c;font-weight:700;font-size:1.3rem}.vnv-proposal .request{display:inline-block;padding:.75rem 1.05rem;background:#99ebd2;color:#142d31;border-radius:.45rem;font-weight:700}.vnv-proposal section>a:last-child{display:block;color:white;margin-top:1rem}
</style>
<main class="vnv-proposal">
    <nav aria-label="Breadcrumb"><a href="{{ path('store-categories/') }}">Service catalog</a> / <a href="{{ path('product-category/event-planners-and-coordinator/') }}">Planning, Coordination &amp; Production</a></nav>
    <article>
        <img src="{{ asset_for(service.image) }}" alt="">
        <section>
            <h1>{{ service.name }}</h1><p>{{ service.summary }}</p>
            <p class="fee">{{ service.price }}</p>
            {% if slug != 'brand-activation' %}<p>{{ fee_includes }}</p>{% endif %}
            <p>{{ direct_costs }}</p>
            <p>On-site coordination is booked separately as <a style="color:inherit" href="{{ path('product/' ~ coordinator_slug) }}">Day Coordinator</a>.</p>
            <a class="request" href="{{ path('') }}?request_service={{ slug }}#vnvRequestModal" data-vnv-open-request data-vnv-request-service="{{ slug }}">Request a proposal</a>
            <a href="{{ path(service.route) }}">Explore {{ slug == 'brand-activation' ? 'brand activation' : 'event production' }}</a>
        </section>
    </article>
</main>
{% include "templates/components/publicEventRequestModal.html.twig" with {request_form_source:'production_store'} %}
{% include "templates/layout/publicFooterVnv.html.twig" %}
{% endblock %}
