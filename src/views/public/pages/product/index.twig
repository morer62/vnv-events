{% extends "templates/base.store.twig" %}
{% set product_brand_label = is_vnv_gourmet_service|default(false) ? 'VNV Gourmet' : 'VNV Gourmet To Go' %}

{% block title %}
    {{ product ? product.name ~ ' | ' ~ product_brand_label : 'Product not found' }}
{% endblock %}
{% block canonical %}https://vnvevents.com/product/{{ product.slug }}{% endblock %}
{% block og_type %}product{% endblock %}
{% block og_site_name %}{{ product_brand_label }}{% endblock %}
{% block og_title %}{{ product.name }} | {{ product_brand_label }}{% endblock %}
{% block twitter_title %}{{ product.name }} | {{ product_brand_label }}{% endblock %}

{% block meta_description %}
    {{ product and product.short_description ? product.short_description : 'Explore product details in our store.' }}
{% endblock %}

{% block store_body %}
<style>
    :root{
        --pp-bg:#f8fafc;
        --pp-card:#ffffff;
        --pp-text:#111827;
        --pp-muted:#6b7280;
        --pp-border:#e5e7eb;
        --pp-soft:#f3f4f6;
        --pp-accent:#111827;
        --pp-shadow:0 18px 44px rgba(15,23,42,.08);
    }

    body{
        background:var(--pp-bg);
        color:var(--pp-text);
        max-width:100%;
        overflow-x:hidden;
    }

    .pp-wrap{
        width:100%;
        max-width:1240px;
        margin:0 auto;
        padding:42px 16px 64px;
    }

    .pp-breadcrumb{
        display:flex;
        gap:8px;
        flex-wrap:wrap;
        font-size:.88rem;
        color:var(--pp-muted);
        margin-bottom:14px;
    }

    .pp-breadcrumb a{
        color:#111827;
        text-decoration:none;
        font-weight:700;
    }

    .pp-shell{
        width:100%;
        max-width:100%;
        border:1px solid var(--pp-border);
        border-radius:26px;
        background:#fff;
        box-shadow:var(--pp-shadow);
        overflow:hidden;
    }

    .pp-main{
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:0;
        min-width:0;
    }

    .pp-image-wrap{
        padding:22px;
        background:linear-gradient(135deg,#f8fafc 0%, #ffffff 100%);
    }

    .pp-image{
        width:100%;
        height:min(420px,52vw);
        aspect-ratio:4/5;
        object-fit:cover;
        border-radius:20px;
        border:1px solid var(--pp-border);
        background:#f3f4f6;
    }

    .pp-details{
        padding:26px;
        min-width:0;
    }

    .pp-title{
        font-size:clamp(1.8rem,3vw,2.6rem);
        line-height:1.1;
        margin:0 0 8px;
        color:var(--pp-text);
        font-weight:900;
        overflow-wrap:anywhere;
    }

    .pp-sub{
        color:var(--pp-muted);
        line-height:1.75;
        margin:0 0 14px;
    }

    .pp-badges{
        display:flex;
        flex-wrap:wrap;
        gap:8px;
        margin-bottom:14px;
    }

    .pp-badge{
        display:inline-flex;
        align-items:center;
        gap:6px;
        padding:8px 12px;
        border-radius:999px;
        background:#fff;
        border:1px solid var(--pp-border);
        font-size:.78rem;
        font-weight:900;
        color:#374151;
    }

    .pp-badge-dark{
        background:#111827;
        color:#fff;
        border-color:#111827;
    }

    .pp-price-row{
        display:flex;
        align-items:end;
        gap:10px;
        margin:8px 0 12px;
        flex-wrap:wrap;
    }

    .pp-price{
        font-size:2rem;
        font-weight:900;
        color:#111827;
        line-height:1;
    }

    .pp-price-note{
        font-size:.95rem;
        color:var(--pp-muted);
        font-weight:600;
    }

    .pp-meta{
        display:grid;
        grid-template-columns:repeat(3,minmax(0,1fr));
        gap:10px;
        margin:14px 0 18px;
    }

    .pp-meta-card{
        border:1px solid var(--pp-border);
        border-radius:14px;
        background:#fcfcfd;
        padding:10px 12px;
    }

    .pp-meta-label{
        font-size:.76rem;
        font-weight:800;
        color:var(--pp-muted);
        text-transform:uppercase;
        letter-spacing:.04em;
    }

    .pp-meta-value{
        font-size:1rem;
        font-weight:900;
        color:var(--pp-text);
        margin-top:2px;
    }

    .pp-purchase-box{
        margin-top:10px;
        border:1px solid var(--pp-border);
        border-radius:18px;
        background:#fcfcfd;
        padding:16px;
    }

    .pp-form-label{
        display:block;
        font-size:.86rem;
        font-weight:800;
        color:#374151;
        margin-bottom:6px;
    }

    .pp-select,
    .pp-input{
        width:100%;
        border:1px solid #d1d5db;
        border-radius:14px;
        background:#fff;
        color:#111827;
        padding:12px 14px;
        outline:none;
    }

    .pp-select:focus,
    .pp-input:focus{
        border-color:#111827;
        box-shadow:0 0 0 3px rgba(17,24,39,.08);
    }

    .pp-size-buttons{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem}.pp-size-button{min-height:74px;padding:.75rem;border:1px solid var(--pp-border);border-radius:14px;background:#fff;color:var(--pp-text);text-align:left;cursor:pointer}.pp-size-button strong,.pp-size-button span{display:block}.pp-size-button strong{text-transform:none}.pp-size-button span{margin-top:.25rem;font-size:.78rem;color:var(--pp-muted);line-height:1.35}.pp-size-button.is-selected{border-color:#173f35;background:#eff8f4;box-shadow:0 0 0 2px rgba(23,63,53,.12)}.pp-selection-hint{min-height:1.25rem;margin-top:.35rem;color:#a43f2f;font-size:.82rem;font-weight:800}.pp-selection-hint.is-complete{visibility:hidden}.pp-btn:disabled{opacity:.5;cursor:not-allowed}@media(max-width:700px){.pp-size-buttons{grid-template-columns:1fr}.pp-actions{position:sticky;bottom:8px;z-index:30;background:#fff;padding:8px;border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,.18)}}
    .pp-gallery-thumbs{display:grid;grid-template-columns:repeat(3,1fr);gap:.55rem;margin-top:.7rem}.pp-gallery-thumb{padding:0;border:1px solid var(--pp-border);border-radius:12px;overflow:hidden;background:#fff;cursor:pointer}.pp-gallery-thumb img{display:block;width:100%;aspect-ratio:1/1;object-fit:cover}.pp-gallery-thumb.is-active{border-color:#173f35;box-shadow:0 0 0 2px rgba(23,63,53,.14)}

    .pp-purchase-grid{
        display:grid;
        grid-template-columns:1fr 130px;
        gap:12px;
        align-items:end;
    }

    .pp-catalog-grid{
        display:grid;
        grid-template-columns:1fr;
        gap:12px;
        align-items:end;
    }

    .pp-variation-preview{
        margin-top:14px;
        display:none;
        border-top:1px dashed #d1d5db;
        padding-top:14px;
    }

    .pp-variation-meta{
        display:grid;
        grid-template-columns:repeat(3,minmax(0,1fr));
        gap:10px;
    }

    .pp-variation-meta-item{
        border:1px solid var(--pp-border);
        border-radius:14px;
        background:#fff;
        padding:10px 12px;
    }

    .pp-variation-meta-label{
        font-size:.76rem;
        color:var(--pp-muted);
        font-weight:700;
        margin-bottom:3px;
    }

    .pp-variation-meta-value{
        font-size:.95rem;
        color:#111827;
        font-weight:800;
        line-height:1.45;
    }

    .pp-actions{
        display:flex;
        gap:10px;
        flex-wrap:wrap;
        margin-top:14px;
    }

    .pp-btn{
        border:none;
        border-radius:999px;
        padding:12px 18px;
        font-weight:900;
        text-decoration:none;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        gap:8px;
        cursor:pointer;
    }

    .pp-btn-main{
        background:#111827;
        color:#fff;
        box-shadow:0 12px 28px rgba(17,24,39,.18);
    }

    .pp-btn-light{
        background:#fff;
        color:#111827;
        border:1px solid #d1d5db;
    }

    .pp-helper{
        margin-top:10px;
        color:var(--pp-muted);
        font-size:.9rem;
    }

    .pp-block{
        margin-top:18px;
        border:1px solid var(--pp-border);
        border-radius:20px;
        background:#fff;
        box-shadow:var(--pp-shadow);
        padding:18px;
    }

    .pp-block h3{
        font-size:1.2rem;
        font-weight:900;
        color:var(--pp-text);
        margin:0 0 10px;
    }

    .pp-desc{
        color:#4b5563;
        line-height:1.8;
    }

    .pp-chip{
        display:inline-flex;
        align-items:center;
        padding:6px 10px;
        border-radius:999px;
        background:#f3f4f6;
        border:1px solid var(--pp-border);
        color:#374151;
        font-size:.78rem;
        font-weight:800;
        margin:0 8px 8px 0;
    }

    .pp-related-grid{
        display:grid;
        grid-template-columns:repeat(4,minmax(0,1fr));
        gap:12px;
    }

    .pp-card{
        border:1px solid var(--pp-border);
        border-radius:18px;
        background:#fff;
        overflow:hidden;
        display:flex;
        flex-direction:column;
        box-shadow:0 10px 20px rgba(15,23,42,.05);
        text-decoration:none;
        color:inherit;
    }

    .pp-card img{
        width:100%;
        height:160px;
        object-fit:cover;
        background:#f3f4f6;
    }

    .pp-card-body{
        padding:12px;
    }

    .pp-card-title{
        font-size:.96rem;
        font-weight:900;
        color:var(--pp-text);
        margin-bottom:5px;
        line-height:1.3;
    }

    .pp-card-price{
        font-size:1rem;
        font-weight:900;
        color:#111827;
    }

    .pp-not-found{
        text-align:center;
        border:1px solid var(--pp-border);
        border-radius:24px;
        background:#fff;
        box-shadow:var(--pp-shadow);
        padding:48px 24px;
    }

    @media (max-width: 1024px){
        .pp-main{
            grid-template-columns:1fr;
        }

        .pp-image{
            height:360px;
        }

        .pp-related-grid{
            grid-template-columns:repeat(2,minmax(0,1fr));
        }
    }

    @media (max-width: 640px){
        .pp-wrap{
            padding-top:22px;
            padding-left:12px;
            padding-right:12px;
        }

        .pp-shell,
        .pp-main,
        .pp-image-wrap,
        .pp-details{
            width:100%;
            max-width:100%;
            min-width:0;
        }

        .pp-title{
            font-size:clamp(1.55rem,8vw,2rem);
        }

        .pp-price{
            max-width:100%;
            font-size:clamp(1.55rem,8vw,2rem);
            line-height:1.08;
            overflow-wrap:anywhere;
        }

        .pp-details{
            padding:16px;
        }

        .pp-image-wrap{
            padding:16px;
        }

        .pp-image{
            height:260px;
        }

        .pp-meta{
            grid-template-columns:1fr 1fr;
        }

        .pp-purchase-grid,
        .pp-catalog-grid,
        .pp-variation-meta{
            grid-template-columns:1fr;
        }

        .pp-actions .pp-btn{
            width:100%;
        }

        .pp-related-grid{
            grid-template-columns:1fr;
        }
    }
</style>

<main class="pp-wrap">
    {% if not product %}
        <section class="pp-not-found">
            <h1 class="h3 mb-2">Product not found</h1>
            <p class="text-muted mb-0">This product is unavailable or no longer public.</p>
        </section>
    {% else %}
        <div class="pp-breadcrumb">
            {% if is_vnv_gourmet_service|default(false) %}<a href="{{ path('vnv-gourmet') }}">VNV Gourmet</a>{% elseif is_gourmet_express %}<a href="{{ path('gourmet-to-go') }}">Gourmet To Go</a>{% else %}<a href="{{ path('') }}">Home</a>{% endif %}
            <span>/</span>
            {% if is_vnv_gourmet_service|default(false) %}<a href="{{ path('vnv-gourmet') }}#menu-services">Food Stations</a>{% elseif is_gourmet_express %}<a href="{{ path('gourmet-to-go') }}#{{ gourmet_category_anchor }}">{{ gourmet_category_name }}</a>{% elseif product.categories is defined and product.categories|length > 0 %}
                {% set main_category = product.categories|first %}
                <a href="{{ path('product-category/' ~ main_category.slug) }}">{{ main_category.name }}</a>
            {% endif %}

            <span>/</span>
            <strong>{{ product.name }}</strong>
        </div>

        <section class="pp-shell">
            <div class="pp-main">
                <div class="pp-image-wrap">
                    {% set primary_media = product_media|default([])|first %}
                    {% if primary_media or product.main_image %}
                        <img src="{{ primary_media.image_url|default(product.main_image) }}" alt="{{ primary_media.alt_text|default(product.name) }}" class="pp-image" id="pp-main-image" style="object-position:{{ primary_media.focal_x|default(50) }}% {{ primary_media.focal_y|default(50) }}%">
                        {% if product_media|default([])|length > 1 %}<div class="pp-gallery-thumbs" aria-label="Product photos">{% for media in product_media %}<button type="button" class="pp-gallery-thumb {{ loop.first ? 'is-active' : '' }}" data-gallery-src="{{ media.image_url }}" data-gallery-alt="{{ media.alt_text|default(product.name)|e('html_attr') }}" data-gallery-position="{{ media.focal_x|default(50) }}% {{ media.focal_y|default(50) }}%"><img src="{{ media.image_url }}" alt="" width="160" height="160" loading="lazy"></button>{% endfor %}</div>{% endif %}
                    {% else %}
                        <div class="pp-image d-flex align-items-center justify-content-center text-muted">No image</div>
                    {% endif %}
                </div>

                <div class="pp-details">
                    <h1 class="pp-title">{{ product.name }}</h1>
                    <p class="pp-sub">{{ product.short_description ?: 'Explore the details of this product.' }}</p>

                    {% if not is_gourmet_express %}<div class="pp-badges">
                        {% if product.product_type == 'VARIABLE' %}
                            <span class="pp-badge pp-badge-dark">Variable Product</span>
                        {% else %}
                            <span class="pp-badge">Fixed Price</span>
                        {% endif %}
                        {% if product.is_featured %}<span class="pp-badge">Featured</span>{% endif %}
                        {% if product.is_public %}<span class="pp-badge">Public</span>{% endif %}
                        {% if product.status %}<span class="pp-badge">{{ product.status }}</span>{% endif %}
                    </div>{% endif %}

                    <div class="pp-price-row">
                        <div class="pp-price" id="product-price-display">
                            {% if product.product_type == 'VARIABLE' %}
                                {% if product.min_price == product.max_price %}
                                    ${{ product.min_price|number_format(2, '.', ',') }}
                                {% else %}
                                    From ${{ product.min_price|number_format(2, '.', ',') }}
                                {% endif %}
                            {% else %}
                                {% if is_gourmet_express and product.slug == 'brazo-gitano' %}${{ product.display_price|number_format(0, '.', ',') }} · 10–12 slices{% else %}${{ product.display_price|number_format(2, '.', ',') }}{% endif %}
                            {% endif %}
                        </div>

                        {% if product.short_description and not is_gourmet_express %}
                            <div class="pp-helper" style="margin-top:0; margin-bottom:14px;">
                                {{ product.short_description }}
                            </div>
                        {% endif %}

                        {% if store_active and not is_gourmet_express %}
                            <div class="pp-price-note" id="product-price-note">
                                {% if product.product_type == 'VARIABLE' %}
                                    Select an option to see the exact price.
                                {% else %}
                                    Ready to purchase.
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>

                    {% if is_gourmet_express and product.slug in ['appetizer-box','appetizer-box-breakfast-brunch'] %}
                    <aside class="pp-serving-tip" aria-label="Serving tip">
                        <span class="pp-serving-tip__icon" aria-hidden="true">♨</span>
                        <div><strong>Serving Tip</strong><br>For the best experience, pick up warm and enjoy within 1–2 hours. If serving later, reheat at 350°F using the instructions included with your order.</div>
                    </aside>
                    <style>.pp-serving-tip{display:flex;gap:.8rem;align-items:flex-start;margin:0 0 1rem;padding:1rem;border:2px solid #E8892B;border-radius:16px;background:#FFF3E6;color:#2d2118}.pp-serving-tip__icon{font-size:1.45rem;line-height:1}.pp-serving-tip strong{font-size:1.05rem}@media(max-width:650px){.pp-serving-tip{width:100%}}</style>
                    {% endif %}

                    {% if product.purchase_mode|default('REQUEST') == 'REQUEST' %}
                        <div class="pp-purchase-box">
                            <h3>Request this experience</h3>
                            <p>This product requires confirmation from our team before payment.</p>
                            <a href="{{ path('/#request') }}" class="pp-btn pp-btn-main" data-vnv-open-request>Start a request</a>
                        </div>
                    {% elseif store_active and product.allow_immediate_payment|default(0) %}
                        <div class="pp-purchase-box">
                            <form id="public-product-form">
                                <input type="hidden" name="id_product" value="{{ product.id }}">
                                <input type="hidden" name="id_product_variation" id="selected-variation-id" value="">
                                <input type="hidden" name="selected_unit_price" id="selected-unit-price" value="{{ product.display_price|default(product.min_price)|default(0) }}">

                                <div class="pp-purchase-grid">
                                    <div>
                                        {% if product.product_type == 'VARIABLE' %}
                                            <label class="pp-form-label">Choose an option</label>
                                            {% if is_gourmet_express and variation_axes.flavor|default([])|length %}<label class="pp-form-label">Flavor</label><div class="pp-size-buttons pp-flavor-buttons" role="group" aria-label="Choose a flavor">{% for slug,label in variation_axes.flavor %}<button type="button" class="pp-size-button pp-axis-button" data-axis="flavor" data-axis-value="{{ slug }}"><strong>{{ label }}</strong></button>{% endfor %}</div><div class="pp-selection-hint" id="flavor-hint">Choose a flavor</div>{% endif %}
                                            {% if is_gourmet_express %}<label class="pp-form-label" style="margin-top:.8rem">Size</label><div class="pp-size-buttons" id="variation-buttons" role="group" aria-label="Choose a size">{% for size in variation_sizes %}<button type="button" class="pp-size-button pp-axis-button" data-axis="size" data-axis-value="{{ size.slug }}" data-price="{{ size.price }}" data-guests-min="{{ size.guests_min }}" data-guests-max="{{ size.guests_max }}"><strong>{{ size.label|default(size.code) }}</strong><span>${{ size.price|number_format(2,'.',',') }}</span></button>{% endfor %}</div><div class="pp-selection-hint" id="size-hint">Choose a size</div>{% endif %}
                                            <select class="pp-select" id="variation-select"{% if is_gourmet_express %} hidden aria-hidden="true"{% endif %}>
                                                <option value="">Select a variation</option>
                                                {% for variation in product.variations|default([]) %}
                                                    <option
                                                        value="{{ variation.id }}"
                                                        data-name="{{ variation.name|e('html_attr') }}"
                                                        data-size="{{ variation.size_code|default('')|e('html_attr') }}"
                                                         data-piece-count="{{ variation.piece_count|default(0) }}"
                                                        data-guests-min="{{ variation.guests_min|default(0) }}"
                                                        data-guests-max="{{ variation.guests_max|default(0) }}"
                                                        data-price="{{ variation.effective_price }}"
                                                        data-stock="{{ variation.stock_quantity|default(0) }}"
                                                        data-min="{{ variation.min_purchase_qty|default(1) }}"
                                                        data-max="{{ variation.max_purchase_qty is not null ? variation.max_purchase_qty : '' }}"
                                                        data-options='{{ variation.attribute_values|json_encode|e('html_attr') }}'
                                                    >
                                                        {{ variation.name }} — ${{ variation.effective_price|number_format(2, '.', ',') }}
                                                    </option>
                                                {% endfor %}
                                            </select>
                                        {% elseif not is_gourmet_express %}
                                            <label class="pp-form-label">Product</label>
                                            <input type="text" class="pp-input" value="{{ product.name }}" disabled>
                                        {% endif %}
                                    </div>

                                    <div>
                                        <label class="pp-form-label">Quantity</label>
                                        <input
                                            type="number"
                                            id="product-qty"
                                            class="pp-input"
                                            min="{{ product.min_purchase_qty|default(1) }}"
                                            value="{{ product.min_purchase_qty|default(1) }}"
                                            {% if product.product_type == 'FIXED' and product.max_purchase_qty %}
                                                max="{{ product.max_purchase_qty }}"
                                            {% endif %}
                                        >
                                    </div>
                                    {% if food_profile and not is_gourmet_express %}
                                    <div>
                                        <label class="pp-form-label" for="product-servings">Guests / servings</label>
                                        <input type="number" id="product-servings" class="pp-input"
                                            min="{{ food_profile.minimum_servings }}"
                                            {% if food_profile.maximum_servings %}max="{{ food_profile.maximum_servings }}"{% endif %}
                                            value="{{ food_profile.included_servings }}"
                                            data-included="{{ food_profile.included_servings }}"
                                            data-additional-price="{{ food_profile.additional_person_price }}">
                                        <small>Includes {{ food_profile.included_servings }} servings{% if food_profile.additional_person_price > 0 %}; additional guests ${{ food_profile.additional_person_price|number_format(2,'.',',') }} each{% endif %}.</small>
                                    </div>
                                    {% if food_profile.cooking_preferences|length %}
                                    <div>
                                        <label class="pp-form-label" for="cooking-preference">Cooking preference</label>
                                        <select class="pp-select" id="cooking-preference">
                                            {% for preference in food_profile.cooking_preferences %}<option value="{{ preference }}">{{ preference }}</option>{% endfor %}
                                        </select>
                                    </div>
                                    {% endif %}
                                    {% endif %}
                                </div>

                                <div class="pp-variation-preview" id="variation-preview">
                                    <div class="pp-variation-meta" id="variation-meta"></div>
                                </div>

                                {% if product_option_groups|length %}
                                <style>
                                .pp-option-group{margin:1.1rem 0;padding:1.1rem;border:1px solid #cfe0da;border-radius:18px;background:#f7fbf9}.pp-option-head{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-bottom:.8rem}.pp-option-counter{font-weight:900;color:#0c6d59}.pp-option-section-title{margin:1rem 0 .55rem;font-size:.9rem;text-transform:uppercase;letter-spacing:.06em;color:#385c51}.pp-option-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem}.pp-option-choice{display:grid;grid-template-columns:56px 1fr auto;gap:.75rem;align-items:center;padding:.7rem;border:1px solid #d7e4df;border-radius:14px;background:#fff;cursor:pointer}.pp-option-choice img{width:56px;height:56px;object-fit:cover;border-radius:10px;background:#eee}.pp-option-choice input{width:22px;height:22px}.pp-option-choice.is-disabled{opacity:.45}.pp-option-serve{font-size:.72rem;font-weight:900;color:#4f665e;display:block;margin-top:.2rem}@media(max-width:650px){.pp-option-grid{grid-template-columns:1fr}}
                                </style>
                                {% for group in product_option_groups %}
                                <section class="pp-option-group" data-option-group="{{ group.id }}" data-rules='{{ group.variation_rules|json_encode|e('html_attr') }}' data-default-required="{{ group.required_count_default }}" data-default-pieces="{{ group.pieces_per_option_default }}">
                                    <div class="pp-option-head"><div><strong>{{ group.name }}</strong><div class="pp-helper">Choose the exact number included with your selected size.</div></div><span class="pp-option-counter">Choose {{ group.required_count_default }} — 0 selected</span></div>
                                    {% set has_preferred = false %}{% set has_other = false %}{% for choice in group.choices %}{% if choice.is_preferred %}{% set has_preferred = true %}{% else %}{% set has_other = true %}{% endif %}{% endfor %}
                                    {% if has_preferred %}<h4 class="pp-option-section-title">{{ group.preferred_tag == 'breakfast' ? 'Recommended for breakfast' : 'All-day favorites' }}</h4>{% endif %}
                                    <div class="pp-option-grid">
                                    {% for choice in group.choices %}{% if choice.is_preferred %}
                                        <label class="pp-option-choice">
                                            {% if choice.image_url %}<img src="{{ choice.image_url }}" alt="{{ choice.name }}" loading="lazy">{% else %}<span></span>{% endif %}
                                            <span><strong>{{ choice.name }}</strong>{% if choice.serve_label %}<span class="pp-option-serve">{{ choice.serve_label }}</span>{% endif %}</span>
                                            <input type="checkbox" value="{{ choice.id }}" data-name="{{ choice.name|e('html_attr') }}" data-serve-label="{{ choice.serve_label|default('')|e('html_attr') }}" aria-label="{{ choice.name }}">
                                        </label>
                                    {% endif %}{% endfor %}
                                    </div>
                                    {% if has_other %}<h4 class="pp-option-section-title">{{ group.preferred_tag == 'breakfast' ? 'All-day favorites' : 'Also great for breakfast' }}</h4><div class="pp-option-grid">{% for choice in group.choices %}{% if not choice.is_preferred %}<label class="pp-option-choice">{% if choice.image_url %}<img src="{{ choice.image_url }}" alt="{{ choice.name }}" loading="lazy">{% else %}<span></span>{% endif %}<span><strong>{{ choice.name }}</strong>{% if choice.serve_label %}<span class="pp-option-serve">{{ choice.serve_label }}</span>{% endif %}</span><input type="checkbox" value="{{ choice.id }}" data-name="{{ choice.name|e('html_attr') }}" data-serve-label="{{ choice.serve_label|default('')|e('html_attr') }}" aria-label="{{ choice.name }}"></label>{% endif %}{% endfor %}</div>{% endif %}
                                </section>
                                {% endfor %}
                                {% endif %}

                                {% if is_gourmet_express %}
                                <section class="pp-block"><h3>Product Description</h3><div class="pp-desc">{{ product.description|raw }}</div></section>
                                {% if food_profile and food_profile.whats_included_html %}<section class="pp-block"><h3>What's included</h3><div class="pp-desc">{{ food_profile.whats_included_html|raw }}</div></section>{% endif %}
                                <section class="pp-block pp-dropoff"><p><strong>Free pickup in Sunrise</strong> or delivery for a fee. Order 24h ahead.</p></section>
                                {% if food_profile and food_profile.lead_time_note %}<section class="pp-block"><h3>Lead time</h3><p>{{ food_profile.lead_time_note }}</p></section>{% endif %}
                                {% endif %}

                                {% if product_addons|length %}
                                <div class="pp-block" style="margin:1rem 0;padding:1rem">
                                    <h4>Optional add-ons</h4>
                                    {% for addon in product_addons %}
                                    <div class="pp-addon" style="display:grid;grid-template-columns:auto 1fr;gap:.75rem;align-items:center;margin:.7rem 0">
                                        <input type="checkbox" class="product-addon-check" id="addon-{{ addon.id }}" data-id="{{ addon.id }}" data-name="{{ addon.name|e('html_attr') }}" data-slug="{{ addon.slug|e('html_attr') }}" data-image="{{ addon.main_image|default('')|e('html_attr') }}" data-price="{{ addon.price_override is not null ? addon.price_override : addon.price }}" data-type="{{ addon.product_type }}" data-size-match="{{ addon.size_match|default(0) }}">
                                        <label for="addon-{{ addon.id }}"><strong>{{ addon.name }}</strong>{% if addon.product_type == 'FIXED' %} · ${{ (addon.price_override is not null ? addon.price_override : addon.price)|number_format(2) }}{% endif %}</label>
                                        <input type="number" class="pp-input product-addon-qty" data-addon-id="{{ addon.id }}" min="1" value="1" style="grid-column:2;max-width:110px" disabled aria-label="{{ addon.name }} quantity">
                                        {% if addon.product_type == 'VARIABLE' %}<select class="pp-select product-addon-variation" data-addon-id="{{ addon.id }}" style="grid-column:2" disabled><option value="">Choose an option</option>{% for variation in addon.variations %}<option value="{{ variation.id }}" data-name="{{ variation.name|e('html_attr') }}" data-price="{{ variation.effective_price }}">{{ variation.name }} — ${{ variation.effective_price|number_format(2) }}</option>{% endfor %}</select>{% endif %}
                                    </div>
                                    {% endfor %}
                                </div>
                                {% endif %}

                                {% if is_gourmet_express %}
                                <style>.pp-staff-cta{margin:1rem 0;padding:1rem 1.1rem;border:1px solid #b8d8ce;border-radius:16px;background:#eff9f5;display:grid;gap:.75rem}.pp-staff-actions{display:flex;flex-wrap:wrap;gap:.55rem}.pp-staff-actions a{padding:.6rem .8rem;border-radius:10px;background:#173f34;color:#fff!important;font-weight:800;text-decoration:none}.pp-dropoff{border-left:5px solid #208269;background:#f2faf7}</style>
                                <aside class="pp-staff-cta">
                                    <div><strong>Need help during your event?</strong><br><span>Our full-service team can set up, serve and run your event.</span></div>
                                    <div class="pp-staff-actions">
                                        <a href="tel:+1{{ gourmet_settings.staff_phone|default('3052045427') }}" data-staff-method="call">Call VNV Events: (305) 204-5427</a>
                                        <a href="https://wa.me/{{ gourmet_settings.staff_whatsapp|default('13053761210') }}" rel="noopener" data-staff-method="whatsapp">WhatsApp</a>
                                        <a href="{{ path('gourmet-to-go') }}" data-staff-method="link">Back to Gourmet To Go →</a>
                                    </div>
                                </aside>
                                {% endif %}

                                <div class="pp-actions">
                                    <button
                                        type="button"
                                        class="pp-btn pp-btn-main"
                                        id="add-to-cart-btn"
                                        data-id="{{ product.id }}"
                                        data-name="{{ product.name|e('html_attr') }}"
                                        data-slug="{{ product.slug|default('')|e('html_attr') }}"
                                        data-short-description="{{ (product.short_description ?: '')|e('html_attr') }}"
                                        data-description="{{ (product.description ?: '')|e('html_attr') }}"
                                        data-main-image="{{ (product.main_image ?: '')|e('html_attr') }}"
                                        data-price="{{ product.display_price|default(product.min_price)|default(0) }}"
                                        data-lowest-price="{{ product.min_price|default(product.display_price)|default(0) }}"
                                        data-stock-quantity="{{ product.stock_quantity|default(0) }}"
                                        data-min-purchase-qty="{{ product.min_purchase_qty|default(1) }}"
                                        data-max-purchase-qty="{{ product.max_purchase_qty is not null ? product.max_purchase_qty : '' }}"
                                        data-sku="{{ product.sku|default('')|e('html_attr') }}"
                                        data-product-type="{{ product.product_type|default('FIXED') }}"
                                    >
                                        Add to cart
                                    </button>

                                    {% if product.slug in ['appetizer-box','appetizer-box-breakfast-brunch'] %}
                                    <button type="button" class="pp-btn pp-btn-light" id="add-build-another-btn">Add &amp; build another box</button>
                                    {% endif %}

                                    <a href="{{ path('store/cart') }}" class="pp-btn pp-btn-light">Go to cart</a>
                                </div>
                                {% if product.slug in ['appetizer-box','appetizer-box-breakfast-brunch'] %}<div id="box-cart-summary" class="pp-helper" aria-live="polite"></div>{% endif %}

                                {% if not is_gourmet_express %}<div class="pp-helper">Choose quantity and, if needed, a variation. {% if product.allow_recurring_purchase|default(0) %}This product also supports recurring purchases at checkout.{% endif %}</div>{% endif %}
                            </form>
                        </div>
                    {% else %}
                        {% if product.product_type == 'VARIABLE' %}
                            <div class="pp-purchase-box">
                                <div class="pp-catalog-grid">
                                    <div>
                                        <label class="pp-form-label">Choose an option</label>
                                        <select class="pp-select" id="variation-select">
                                            <option value="">Select a variation</option>
                                            {% for variation in product.variations|default([]) %}
                                                <option
                                                    value="{{ variation.id }}"
                                                    data-name="{{ variation.name|e('html_attr') }}"
                                                    data-price="{{ variation.effective_price }}"
                                                    data-options='{{ variation.attribute_values|json_encode|e('html_attr') }}'
                                                >
                                                    {{ variation.name }} — ${{ variation.effective_price|number_format(2, '.', ',') }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>

                                <div class="pp-variation-preview" id="variation-preview">
                                    <div class="pp-variation-meta" id="variation-meta"></div>
                                </div>
                            </div>
                        {% endif %}
                    {% endif %}
 
                </div>
            </div>
        </section>

        {% if not is_gourmet_express %}<section class="pp-block">
            <h3>Product Description</h3>
            <div class="pp-desc">{{ product.description|raw }}</div>
        </section>{% endif %}

        {% if food_profile and not is_gourmet_express %}
            <section class="pp-block">
                <h3>{{ is_gourmet_express ? 'Reheating & serving' : 'Your VNV Gourmet guide' }}</h3>
                {% if food_profile.preparation_instructions %}<h4>Preparation</h4><p>{{ food_profile.preparation_instructions }}</p>{% endif %}
                {% if food_profile.reheating_instructions %}<h4>Reheating</h4><p>{{ food_profile.reheating_instructions }}</p>{% endif %}
                {% if food_profile.serving_instructions %}<h4>Serving</h4><p>{{ food_profile.serving_instructions }}</p>{% endif %}
                {% if food_profile.plating_instructions %}<h4>Plating</h4><p>{{ food_profile.plating_instructions }}</p>{% endif %}
                {% if food_profile.presentation_instructions %}<h4>Presentation</h4><p>{{ food_profile.presentation_instructions }}</p>{% endif %}
            </section>
        {% endif %}

        {% if product.categories|length > 0 %}
            <section class="pp-block">
                <h3>Categories</h3>
                {% if is_gourmet_express %}<span class="pp-chip">{{ gourmet_category_name }}</span>{% else %}{% for c in product.categories %}<span class="pp-chip">{{ c.name }}</span>{% endfor %}{% endif %}
            </section>
        {% endif %}

        {% if product.attributes_grouped is not empty %}
            <section class="pp-block">
                <h3>Attributes</h3>
                {% for attributeName, values in product.attributes_grouped %}
                    <div class="mb-2">
                        <strong>{{ attributeName }}</strong>
                        <div class="mt-1">
                            {% for v in values %}
                                <span class="pp-chip">{{ v }}</span>
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
            </section>
        {% endif %}

        {% if related_products|length > 0 %}
            <section class="pp-block">
                <h3>You May Also Like</h3>
                <div class="pp-related-grid">
                    {% for r in related_products %}
                        <a class="pp-card" href="{{ path('product/' ~ r.slug) }}">
                            {% if r.main_image %}
                                <img src="{{ r.main_image }}" alt="{{ r.name }}">
                            {% endif %}
                            <div class="pp-card-body">
                                <div class="pp-card-title">{{ r.name }}</div>
                                <div class="pp-card-price">
                                    {% if r.product_type is defined and r.product_type == 'VARIABLE' %}
                                        {% if r.min_price is defined and r.max_price is defined and r.min_price != r.max_price %}
                                            From ${{ r.min_price|number_format(2, '.', ',') }}
                                        {% elseif r.min_price is defined %}
                                            ${{ r.min_price|number_format(2, '.', ',') }}
                                        {% else %}
                                            ${{ r.price|number_format(2, '.', ',') }}
                                        {% endif %}
                                    {% else %}
                                        {% if r.display_price is defined %}
                                            ${{ r.display_price|number_format(2, '.', ',') }}
                                        {% else %}
                                            ${{ r.price|number_format(2, '.', ',') }}
                                        {% endif %}
                                    {% endif %}
                                </div>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    {% endif %}
</main>

{% if store_active %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const galleryImage = document.getElementById('pp-main-image');
    document.querySelectorAll('[data-gallery-src]').forEach(button => button.addEventListener('click', () => {
        if (!galleryImage) return;
        galleryImage.src = button.dataset.gallerySrc || galleryImage.src;
        galleryImage.alt = button.dataset.galleryAlt || galleryImage.alt;
        galleryImage.style.objectPosition = button.dataset.galleryPosition || '50% 50%';
        document.querySelectorAll('[data-gallery-src]').forEach(item => item.classList.toggle('is-active', item === button));
    }));
    const CART_KEY = 'store_cart_selection';
    document.querySelectorAll('[data-staff-method]').forEach(link => link.addEventListener('click', event => {
        event.preventDefault();
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({event:'staff_cta_click',method:link.dataset.staffMethod});
        window.location.href = link.href;
    }));

    function toInt(value, fallback) {
        const n = parseInt(value, 10);
        return Number.isFinite(n) ? n : fallback;
    }

    function toFloat(value, fallback) {
        const n = parseFloat(value);
        return Number.isFinite(n) ? n : fallback;
    }

    function readCart() {
        try {
            const raw = localStorage.getItem(CART_KEY);
            if (!raw) {
                return { items: [] };
            }
            const parsed = JSON.parse(raw);
            if (!parsed || typeof parsed !== 'object') {
                return { items: [] };
            }
            if (!Array.isArray(parsed.items)) {
                parsed.items = [];
            }
            return parsed;
        } catch (e) {
            return { items: [] };
        }
    }

    function saveCart(cart) {
        localStorage.setItem(CART_KEY, JSON.stringify(cart));
    }

    const addBtn = document.getElementById('add-to-cart-btn');
    const buildAnotherBtn = document.getElementById('add-build-another-btn');
    const boxCartSummary = document.getElementById('box-cart-summary');
    const variationSelect = document.getElementById('variation-select');
    const variationButtons = document.querySelectorAll('[data-variation-id]');
    const axisButtons = Array.from(document.querySelectorAll('.pp-axis-button'));
    const variationPreview = document.getElementById('variation-preview');
    const variationMeta = document.getElementById('variation-meta');
    const selectedVariationId = document.getElementById('selected-variation-id');
    const selectedUnitPrice = document.getElementById('selected-unit-price');
    const priceDisplay = document.getElementById('product-price-display');
    const priceNote = document.getElementById('product-price-note');
    const qtyInput = document.getElementById('product-qty');
    const servingsInput = document.getElementById('product-servings');
    const cookingPreferenceInput = document.getElementById('cooking-preference');
    const addonChecks = Array.from(document.querySelectorAll('.product-addon-check'));
    window.dataLayer = window.dataLayer || [];
    if (!window.__vnvStoreViewContent) {
        window.__vnvStoreViewContent = true;
        window.dataLayer.push({event:'ViewContent',content_ids:[String(addBtn?.dataset.id || '')],content_name:addBtn?.dataset.name || '',content_type:'product',currency:'USD',value:Number(addBtn?.dataset.price || 0)});
    }
    variationButtons.forEach(button => button.addEventListener('click', () => {
        if (!variationSelect) return;
        variationSelect.value = button.dataset.variationId || '';
        variationButtons.forEach(item => item.classList.toggle('is-selected', item === button));
        variationSelect.dispatchEvent(new Event('change', {bubbles:true}));
    }));
    const axisSelects = Array.from(document.querySelectorAll('.pp-axis-select'));
    const selectedAxes = {};
    function selectAxisVariation() {
        if (!variationSelect || (!axisButtons.length && !axisSelects.length)) return;
        const wanted = {...selectedAxes, ...Object.fromEntries(axisSelects.filter(select => select.value).map(select => [select.dataset.axis, select.value]))};
        const requiredAxes = new Set(axisButtons.map(button => button.dataset.axis).concat(axisSelects.map(select => select.dataset.axis)));
        if (Array.from(requiredAxes).some(axis => !wanted[axis])) {
            variationSelect.value = '';
            variationSelect.dispatchEvent(new Event('change', {bubbles:true}));
            updateSelectionState();
            return;
        }
        const match = Array.from(variationSelect.options).find(option => {
            if (!option.value) return false;
            let values = [];
            try { values = JSON.parse(option.dataset.options || '[]'); } catch (e) { values = []; }
            const map = Object.fromEntries(values.map(item => [item.attribute_slug, item.attribute_value_slug]));
            if (!map.size && option.dataset.size) map.size = option.dataset.size === 'S' ? 'small' : (option.dataset.size === 'M' ? 'medium' : (option.dataset.size === 'L' ? 'large' : option.dataset.size.toLowerCase()));
            return Object.keys(wanted).every(axis => map[axis] === wanted[axis]);
        });
        variationSelect.value = match ? match.value : '';
        variationSelect.dispatchEvent(new Event('change', {bubbles:true}));
        updateSelectionState();
    }
    axisSelects.forEach(select => select.addEventListener('change', selectAxisVariation));
    axisButtons.forEach(button => button.addEventListener('click', () => {
        selectedAxes[button.dataset.axis] = button.dataset.axisValue;
        axisButtons.filter(item => item.dataset.axis === button.dataset.axis).forEach(item => item.classList.toggle('is-selected', item === button));
        selectAxisVariation();
    }));
    const isGourmetExpress = {{ is_gourmet_express ? 'true' : 'false' }};
    const gourmetStorePaused = {{ gourmet_settings.store_paused ? 'true' : 'false' }};
    const gourmetClosedMessage = {{ (gourmet_settings.pause_message|default('VNV Gourmet To Go is temporarily pausing new orders. You can still browse the menu.'))|json_encode|raw }};
    const gourmetReopenAt = {{ (gourmet_settings.reopen_at|default(''))|json_encode|raw }};
    function updateBoxCartSummary(message = '') {
        if (!boxCartSummary) return;
        const cart = readCart();
        const boxes = (cart.items || []).filter(item => ['appetizer-box','appetizer-box-breakfast-brunch'].includes(item.slug));
        const total = boxes.reduce((sum, item) => sum + Number(item.line_total || 0), 0);
        boxCartSummary.innerHTML = (message ? '<strong>'+message+'</strong><br>' : '') + (boxes.length ? `${boxes.length} box${boxes.length === 1 ? '' : 'es'} in your cart · $${total.toFixed(2)} · <a href="{{ path('store/cart') }}">Checkout</a>` : 'Build each box separately; every selection stays attached to its own cart line.');
    }
    updateBoxCartSummary();
    function matchAddonSize(check) {
        if (!check || check.dataset.sizeMatch !== '1' || !variationSelect?.value) return;
        const parentOption = variationSelect.options[variationSelect.selectedIndex];
        const parentSize = parentOption?.dataset.size || (parentOption?.dataset.name || '').split(' ')[0].toUpperCase();
        const select = document.querySelector('.product-addon-variation[data-addon-id="'+check.dataset.id+'"]');
        if (!select || !parentSize) return;
        const option = Array.from(select.options).find(item => {
            const name = (item.dataset.name || '').toUpperCase();
            return name.startsWith(parentSize) || name.startsWith(parentSize === 'S' ? 'SMALL' : parentSize === 'M' ? 'MEDIUM' : parentSize === 'L' ? 'LARGE' : parentSize);
        });
        if (option) select.value = option.value;
    }
    addonChecks.forEach(check => check.addEventListener('change',()=>{const select=document.querySelector('.product-addon-variation[data-addon-id="'+check.dataset.id+'"]');const qty=document.querySelector('.product-addon-qty[data-addon-id="'+check.dataset.id+'"]');if(select)select.disabled=!check.checked;if(qty)qty.disabled=!check.checked;if(check.checked)matchAddonSize(check);updateRunningTotal();}));
    document.querySelectorAll('.product-addon-variation,.product-addon-qty').forEach(input => { input.addEventListener('change', updateRunningTotal); input.addEventListener('input', updateRunningTotal); });

    function configuredUnitPrice(basePrice) {
        if (!servingsInput) return basePrice;
        const included = Math.max(1, toInt(servingsInput.dataset.included, 1));
        const servings = Math.max(included, toInt(servingsInput.value, included));
        const extra = Math.max(0, servings - included);
        return Number((basePrice + extra * toFloat(servingsInput.dataset.additionalPrice, 0)).toFixed(2));
    }

    function refreshConfiguredPrice() {
        const base = variationSelect && variationSelect.value
            ? toFloat(variationSelect.options[variationSelect.selectedIndex].dataset.price, 0)
            : toFloat(addBtn?.dataset.price, 0);
        const configured = configuredUnitPrice(base);
        if (selectedUnitPrice) selectedUnitPrice.value = configured.toFixed(2);
        updateRunningTotal();
    }
    if (servingsInput) servingsInput.addEventListener('input', refreshConfiguredPrice);

    function renderVariation(option) {
        if (!option || !option.value) {
            selectedVariationId.value = '';
            variationPreview.style.display = 'none';
            variationMeta.innerHTML = '';
            if (priceDisplay) priceDisplay.textContent = 'From $' + toFloat(addBtn?.dataset.lowestPrice, 0).toFixed(2);
            updateSelectionState();
            updateRunningTotal();
            return;
        }

        const price = parseFloat(option.dataset.price || '0');
        const stock = option.dataset.stock || '0';
        const minQty = option.dataset.min || '1';
        const maxQty = option.dataset.max || '';
        const name = option.dataset.name || '';
        let options = [];

        try {
            options = JSON.parse(option.dataset.options || '[]');
        } catch (e) {
            options = [];
        }

        selectedVariationId.value = option.value;
        selectedUnitPrice.value = price.toFixed(2);
        const pieceCount = toInt(option.dataset.pieceCount, 0);
        const guestsMin = toInt(option.dataset.guestsMin, 0), guestsMax = toInt(option.dataset.guestsMax, 0);
        const perPerson = guestsMax ? Math.ceil(price / guestsMax) : 0;
        const servingRange = guestsMax ? `Serves ${guestsMin}${guestsMax !== guestsMin ? `–${guestsMax}` : ''}` : '';
        priceDisplay.textContent = '$' + price.toFixed(2)
            + (pieceCount ? ` · ${pieceCount} pieces` : '')
            + (servingRange ? ` · ${servingRange} · ≈$${perPerson}/person` : '');
        if (priceNote) priceNote.textContent = name ? ('Selected: ' + name) : 'Variation selected';

        qtyInput.min = minQty || 1;
        qtyInput.value = Math.max(parseInt(qtyInput.value || '1', 10), parseInt(minQty || '1', 10));

        if (maxQty !== '') {
            qtyInput.max = maxQty;
            if (parseInt(qtyInput.value, 10) > parseInt(maxQty, 10)) {
                qtyInput.value = maxQty;
            }
        } else {
            qtyInput.removeAttribute('max');
        }

        const parts = [];
        parts.push(`
            <div class="pp-variation-meta-item">
                <div class="pp-variation-meta-label">Price</div>
                <div class="pp-variation-meta-value">$${price.toFixed(2)}</div>
            </div>
        `);

        if (pieceCount) parts.push(`
            <div class="pp-variation-meta-item">
                <div class="pp-variation-meta-label">Pieces</div>
                <div class="pp-variation-meta-value">${pieceCount}</div>
            </div>
        `);
        if (servingRange) parts.push(`
            <div class="pp-variation-meta-item">
                <div class="pp-variation-meta-label">Servings</div>
                <div class="pp-variation-meta-value">${servingRange.replace('Serves ', '')}</div>
            </div>
        `);

        variationMeta.innerHTML = parts.join('');
        variationPreview.style.display = 'block';
        updateSelectionState();
        updateRunningTotal();
    }

    const optionGroups = Array.from(document.querySelectorAll('[data-option-group]'));
    function currentOptionRule(group) {
        let rules = {};
        try { rules = JSON.parse(group.dataset.rules || '{}'); } catch (e) {}
        return rules[String(variationSelect?.value || '')] || {
            required_count: toInt(group.dataset.defaultRequired, 0),
            pieces_per_option: toInt(group.dataset.defaultPieces, 0)
        };
    }
    function refreshOptionGroup(group, clear = false) {
        if (clear) group.querySelectorAll('input[type="checkbox"]').forEach(input => input.checked = false);
        const rule = currentOptionRule(group);
        const inputs = Array.from(group.querySelectorAll('input[type="checkbox"]'));
        const selected = inputs.filter(input => input.checked).length;
        const required = toInt(rule.required_count, 0);
        group.querySelector('.pp-option-counter').textContent = `Choose ${required} — ${selected} selected`;
        inputs.forEach(input => {
            const disabled = selected >= required && !input.checked;
            input.disabled = disabled;
            input.closest('.pp-option-choice')?.classList.toggle('is-disabled', disabled);
        });
    }
    function optionGroupsValid() {
        return optionGroups.every(group => group.querySelectorAll('input[type="checkbox"]:checked').length === toInt(currentOptionRule(group).required_count, 0));
    }
    function selectedOptionGroups() {
        return optionGroups.map(group => {
            const rule = currentOptionRule(group);
            const selectedInputs = Array.from(group.querySelectorAll('input[type="checkbox"]:checked'));
            return {
                group_id: toInt(group.dataset.optionGroup, 0),
                group_name: group.querySelector('.pp-option-head strong')?.textContent?.trim() || '',
                exact_count: toInt(rule.required_count, 0),
                pieces_per_choice: toInt(rule.pieces_per_choice, 0),
                selected_choice_ids: selectedInputs.map(input => toInt(input.value, 0)),
                selections: selectedInputs.map(input => ({
                    id: toInt(input.value, 0),
                    name: input.dataset.name || '',
                    serve_label: input.dataset.serveLabel || ''
                }))
            };
        });
    }
    optionGroups.forEach(group => {
        group.addEventListener('change', () => { refreshOptionGroup(group); updateSelectionState(); });
        refreshOptionGroup(group);
    });

    function updateSelectionState() {
        const flavorRequired = axisButtons.some(button => button.dataset.axis === 'flavor');
        const sizeRequired = axisButtons.some(button => button.dataset.axis === 'size');
        const flavorReady = !flavorRequired || !!selectedAxes.flavor;
        const sizeReady = !sizeRequired || !!selectedAxes.size;
        document.getElementById('flavor-hint')?.classList.toggle('is-complete', flavorReady);
        document.getElementById('size-hint')?.classList.toggle('is-complete', sizeReady);
        const disabled = (productIsVariable && (!flavorReady || !sizeReady || !variationSelect?.value)) || !optionGroupsValid();
        if (addBtn) addBtn.disabled = disabled;
        if (buildAnotherBtn) buildAnotherBtn.disabled = disabled;
    }

    function updateRunningTotal() {
        if (!addBtn) return;
        if (productIsVariable && !variationSelect?.value) { addBtn.textContent = 'Add to cart'; return; }
        const option = variationSelect?.value ? variationSelect.options[variationSelect.selectedIndex] : null;
        const unit = configuredUnitPrice(toFloat(option?.dataset.price ?? addBtn.dataset.price, 0));
        const quantity = Math.max(1, toInt(qtyInput?.value, 1));
        let total = unit * quantity;
        addonChecks.forEach(check => {
            if (!check.checked) return;
            const addonQty = Math.max(1, toInt(document.querySelector('.product-addon-qty[data-addon-id="'+check.dataset.id+'"]')?.value, 1));
            const addonSelect = document.querySelector('.product-addon-variation[data-addon-id="'+check.dataset.id+'"]');
            const addonPrice = addonSelect?.value ? toFloat(addonSelect.options[addonSelect.selectedIndex].dataset.price, 0) : toFloat(check.dataset.price, 0);
            total += addonPrice * addonQty;
        });
        addBtn.textContent = 'Add to cart — $' + total.toFixed(2);
    }

    const productIsVariable = (addBtn?.dataset.productType || 'FIXED') === 'VARIABLE';
    updateSelectionState();
    qtyInput?.addEventListener('input', updateRunningTotal);

    if (variationSelect) {
        variationSelect.addEventListener('change', function () {
            renderVariation(this.options[this.selectedIndex]);
            optionGroups.forEach(group => refreshOptionGroup(group, true));
            addonChecks.filter(check => check.checked).forEach(matchAddonSize);
            updateRunningTotal();
        });
    }
    const firstSizeButton = axisButtons.find(button => button.dataset.axis === 'size');
    if (firstSizeButton) firstSizeButton.click(); else updateSelectionState();

    if (!addBtn) return;

    async function addConfiguredProduct(event) {
        const buildAnother = event.currentTarget === buildAnotherBtn;
        if (gourmetStorePaused) {
            let message = gourmetClosedMessage;
            if (gourmetReopenAt) message += ' We expect to reopen ' + new Date(gourmetReopenAt.replace(' ', 'T')).toLocaleString() + '.';
            alert(message);
            return;
        }
        const productType = addBtn.dataset.productType || 'FIXED';
        const productId = toInt(addBtn.dataset.id, 0);
        const quantity = Math.max(1, toInt(qtyInput.value, 1));
        const servings = servingsInput ? Math.max(1, toInt(servingsInput.value, 1)) : null;
        const configuration = servingsInput ? {
            servings: servings,
            cooking_preference: cookingPreferenceInput ? cookingPreferenceInput.value : ''
        } : {};
        if (optionGroups.length) {
            if (!optionGroupsValid()) {
                alert('Please complete the required selections before adding this item.');
                return;
            }
            configuration.option_groups = selectedOptionGroups();
        }

        if (!productId) {
            window.location.href = '{{ path("store/cart") }}';
            return;
        }

        let variationId = null;
        let variationName = '';
        let variationOptions = [];
        let unitPrice = configuredUnitPrice(toFloat(addBtn.dataset.price, 0));
        let stockQuantity = Math.max(0, toInt(addBtn.dataset.stockQuantity, 0));
        let minPurchaseQty = Math.max(1, toInt(addBtn.dataset.minPurchaseQty, 1));
        let maxPurchaseQty = addBtn.dataset.maxPurchaseQty !== '' ? Math.max(1, toInt(addBtn.dataset.maxPurchaseQty, 1)) : null;

        if (productType === 'VARIABLE') {
            if (!variationSelect || !variationSelect.value) {
                alert('Please select a variation first.');
                return;
            }

            const selectedOption = variationSelect.options[variationSelect.selectedIndex];
            variationId = toInt(selectedOption.value, 0);
            variationName = selectedOption.dataset.name || '';
            unitPrice = configuredUnitPrice(toFloat(selectedOption.dataset.price, 0));
            stockQuantity = Math.max(0, toInt(selectedOption.dataset.stock, 0));
            minPurchaseQty = Math.max(1, toInt(selectedOption.dataset.min, 1));
            maxPurchaseQty = selectedOption.dataset.max !== '' ? Math.max(1, toInt(selectedOption.dataset.max, 1)) : null;

            try {
                variationOptions = JSON.parse(selectedOption.dataset.options || '[]');
            } catch (e) {
                variationOptions = [];
            }
        }

        const cart = readCart();

        const configurationSignature = JSON.stringify(configuration.option_groups || []);
        const existingItem = buildAnother ? null : cart.items.find(function (item) {
            const sameProduct = toInt(item.id_product, 0) === productId;
            const sameVariation = toInt(item.id_product_variation || 0, 0) === toInt(variationId || 0, 0);
            return sameProduct && sameVariation && JSON.stringify(item.configuration?.option_groups || []) === configurationSignature;
        });

        if (existingItem) {
            existingItem.quantity = quantity;
            existingItem.unit_price = unitPrice;
            existingItem.line_total = Number((unitPrice * quantity).toFixed(2));
            existingItem.stock_quantity = stockQuantity;
            existingItem.min_purchase_qty = minPurchaseQty;
            existingItem.max_purchase_qty = maxPurchaseQty;
            existingItem.variation_name = variationName;
            existingItem.variation_options = variationOptions;
            existingItem.servings = servings;
            existingItem.configuration = configuration;
        } else {
            cart.items.push({
                id_product: productId,
                id_product_variation: variationId,
                product_name: addBtn.dataset.name || '',
                slug: addBtn.dataset.slug || '',
                short_description: addBtn.dataset.shortDescription || '',
                description: addBtn.dataset.description || '',
                main_image: addBtn.dataset.mainImage || '',
                sku: addBtn.dataset.sku || '',
                product_type: productType,
                variation_name: variationName,
                variation_options: variationOptions,
                servings: servings,
                configuration: configuration,
                unit_price: unitPrice,
                quantity: quantity,
                line_total: Number((unitPrice * quantity).toFixed(2)),
                stock_quantity: stockQuantity,
                min_purchase_qty: minPurchaseQty,
                max_purchase_qty: maxPurchaseQty
            });
        }

        for (const check of addonChecks) {
            if (!check.checked) continue;
            let addonVariationId=null, addonVariationName='', addonPrice=toFloat(check.dataset.price,0);
            const addonSelect=document.querySelector('.product-addon-variation[data-addon-id="'+check.dataset.id+'"]');
            if (check.dataset.type==='VARIABLE') {
                if (!addonSelect || !addonSelect.value) { alert('Please choose an option for '+check.dataset.name+'.'); return; }
                const option=addonSelect.options[addonSelect.selectedIndex];addonVariationId=toInt(option.value,0);addonVariationName=option.dataset.name||'';addonPrice=toFloat(option.dataset.price,0);
            }
            const addonId=toInt(check.dataset.id,0);const addonQty=Math.max(1,toInt(document.querySelector('.product-addon-qty[data-addon-id="'+check.dataset.id+'"]')?.value,1));const existingAddon=cart.items.find(item=>toInt(item.id_product,0)===addonId&&toInt(item.id_product_variation||0,0)===toInt(addonVariationId||0,0));
            const addonItem={id_product:addonId,id_product_variation:addonVariationId,product_name:check.dataset.name||'',slug:check.dataset.slug||'',main_image:check.dataset.image||'',sku:'',product_type:check.dataset.type||'FIXED',variation_name:addonVariationName,variation_options:[],servings:null,configuration:{addon_for:productId},unit_price:addonPrice,quantity:addonQty,line_total:Number((addonPrice*addonQty).toFixed(2)),stock_quantity:999,min_purchase_qty:1,max_purchase_qty:null};
            if(existingAddon)Object.assign(existingAddon,addonItem);else cart.items.push(addonItem);
        }

        cart.items_count = cart.items.length;
        cart.quantity_total = cart.items.reduce((sum, item) => sum + Math.max(0, toInt(item.quantity, 0)), 0);
        cart.subtotal = Number(cart.items.reduce((sum, item) => {
            return sum + Number(item.line_total || 0);
        }, 0).toFixed(2));
        cart.total = cart.subtotal;
        cart.updated_at = new Date().toISOString();

        saveCart(cart);
        window.dataLayer.push({event:'AddToCart',content_ids:[String(productId)],content_name:addBtn.dataset.name || '',content_type:'product',currency:'USD',value:Number((unitPrice * quantity).toFixed(2)),quantity:quantity});
        if (buildAnother) {
            optionGroups.forEach(group => refreshOptionGroup(group, true));
            if (qtyInput) qtyInput.value = 1;
            updateSelectionState();
            updateRunningTotal();
            updateBoxCartSummary('Box added. Build your next box below.');
            document.querySelector('.pp-purchase-box')?.scrollIntoView({behavior:'smooth',block:'start'});
            return;
        }
        window.location.href = '{{ path("store/cart") }}';
    }
    addBtn.addEventListener('click', addConfiguredProduct);
    buildAnotherBtn?.addEventListener('click', addConfiguredProduct);
});
</script>
{% else %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const variationSelect = document.getElementById('variation-select');
    const variationPreview = document.getElementById('variation-preview');
    const variationMeta = document.getElementById('variation-meta');
    const priceDisplay = document.getElementById('product-price-display');

    function renderVariationCatalog(option) {
        if (!option || !option.value) {
            variationPreview.style.display = 'none';
            variationMeta.innerHTML = '';

            {% if product.product_type == 'VARIABLE' %}
                {% if product.min_price == product.max_price %}
                    priceDisplay.textContent = '${{ product.min_price|number_format(2, '.', ',') }}';
                {% else %}
                    priceDisplay.textContent = 'From ${{ product.min_price|number_format(2, '.', ',') }}';
                {% endif %}
            {% endif %}

            return;
        }

        const price = parseFloat(option.dataset.price || '0');
        const name = option.dataset.name || '';
        let options = [];

        try {
            options = JSON.parse(option.dataset.options || '[]');
        } catch (e) {
            options = [];
        }

        priceDisplay.textContent = '$' + price.toFixed(2);

        variationMeta.innerHTML = `
            <div class="pp-variation-meta-item">
                <div class="pp-variation-meta-label">Selected Option</div>
                <div class="pp-variation-meta-value">${name || 'Variation selected'}</div>
            </div>
            <div class="pp-variation-meta-item">
                <div class="pp-variation-meta-label">Price</div>
                <div class="pp-variation-meta-value">$${price.toFixed(2)}</div>
            </div>
        `;
        variationPreview.style.display = 'block';
    }

    if (variationSelect) {
        variationSelect.addEventListener('change', function () {
            renderVariationCatalog(this.options[this.selectedIndex]);
        });
    }
});
</script>
{% endif %}
{% endblock %}
