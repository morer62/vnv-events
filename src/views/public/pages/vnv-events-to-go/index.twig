{% extends "templates/base.store.twig" %}
{% block title %}VNV Gourmet To Go | Latin Party Trays & Family Dinners{% endblock %}
{% block meta_description %}Chef-prepared Latin favorites, party boxes and family-style trays delivered in Broward, Miami-Dade and south Palm Beach, or ready for pickup.{% endblock %}
{% block canonical %}https://vnvevents.com/gourmet-to-go{% endblock %}
{% block og_title %}VNV Gourmet To Go{% endblock %}
{% block og_description %}You host. We cook. Latin favorites and family-style trays, delivered or ready for pickup.{% endblock %}
{% block og_url %}https://vnvevents.com/gourmet-to-go{% endblock %}
{% block og_image %}{{ store_hero_image|default(path('assets/images/vnv-gourmet-express-logo.webp')) }}{% endblock %}
{% block og_image_alt %}Chef-prepared food from VNV Gourmet To Go{% endblock %}
{% block store_styles %}<style>
.gtg-pause{padding:14px 18px;background:#fff3dc;border-bottom:1px solid #e8c983;text-align:center;color:#5c3c08}.gtg-pause strong{display:block}.gtg-pause a{color:inherit;font-weight:900}.gtg-hero{position:relative;min-height:68vh;display:grid;align-items:end;background:#183b32 center/cover no-repeat;color:#fff}.gtg-hero:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(9,23,19,.9),rgba(9,23,19,.38))}.gtg-hero__inner{position:relative;width:min(1180px,calc(100% - 32px));margin:0 auto;padding:90px 0 72px}.gtg-eyebrow{display:block;color:#f1cc7e;text-transform:uppercase;letter-spacing:.18em;font-weight:900;font-size:.76rem}.gtg-hero h1{font:900 clamp(3rem,8vw,6.8rem)/.91 Georgia,serif;letter-spacing:-.055em;max-width:720px;margin:16px 0}.gtg-hero p{max-width:670px;font-size:clamp(1rem,2vw,1.25rem);line-height:1.65;color:rgba(255,255,255,.86)}.gtg-price-anchor{font-weight:900;color:#fff!important}.gtg-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:26px}.gtg-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 22px;border-radius:999px;background:var(--store-gold);color:#17201d;text-decoration:none;font-weight:900;border:1px solid var(--store-gold)}.gtg-btn--ghost{background:rgba(0,0,0,.18);color:#fff;border-color:rgba(255,255,255,.5)}.gtg-trust{display:grid;grid-template-columns:repeat(3,1fr);background:var(--store-green);color:#fff}.gtg-trust div{padding:20px;text-align:center;border-right:1px solid rgba(255,255,255,.15);font-weight:800}.gtg-section{width:min(1180px,calc(100% - 32px));margin:0 auto;padding:74px 0}.gtg-section__head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:28px}.gtg-section h2{font:900 clamp(2rem,5vw,4rem)/1 Georgia,serif;letter-spacing:-.04em;margin:0}.gtg-muted{color:#70695d}.gtg-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.gtg-step{padding:26px;border:1px solid var(--store-line);border-radius:24px;background:#fff}.gtg-step span{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--store-gold);font-weight:900}.gtg-step h3{font-size:1.25rem;margin:18px 0 8px}.gtg-step p{line-height:1.6;color:#676157}.gtg-menu{background:#f1e9db}.gtg-category{scroll-margin-top:90px;margin-bottom:62px}.gtg-category:last-child{margin-bottom:0}.gtg-category__head{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid #cabca4;padding-bottom:14px;margin-bottom:20px}.gtg-category h3{font:900 clamp(1.7rem,4vw,2.7rem)/1 Georgia,serif;margin:0}.gtg-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.gtg-card{display:flex;flex-direction:column;background:#fff;border:1px solid #dfd2bb;border-radius:24px;overflow:hidden;box-shadow:0 12px 32px rgba(36,27,14,.06)}.gtg-card img{width:100%;aspect-ratio:4/5;object-fit:cover;background:#ddd}.gtg-card__body{display:flex;flex:1;flex-direction:column;padding:20px}.gtg-card h4{font-size:1.25rem;margin:0 0 8px}.gtg-card p{color:#6b6459;line-height:1.5}.gtg-card__meta{font-size:.85rem;font-weight:800;color:var(--store-green);margin-bottom:10px}.gtg-card__foot{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:auto}.gtg-card__price{font-size:1.15rem;font-weight:900}.gtg-card__price small{display:block;font-size:.72rem;color:#71695e}.gtg-card__link{color:var(--store-green);font-weight:900;text-decoration:none}.gtg-info{display:grid;grid-template-columns:1fr 1fr;gap:26px}.gtg-table{width:100%;border-collapse:collapse;background:#fff;border-radius:20px;overflow:hidden}.gtg-table th,.gtg-table td{padding:14px 16px;text-align:left;border-bottom:1px solid var(--store-line)}.gtg-faq details{background:#fff;border:1px solid var(--store-line);border-radius:16px;padding:18px 20px;margin:10px 0}.gtg-faq summary{cursor:pointer;font-weight:900}.gtg-faq p{line-height:1.65;color:#625c52}.gtg-final{padding:70px 16px;text-align:center;background:var(--store-green);color:#fff}.gtg-final h2{font:900 clamp(2.1rem,5vw,4.2rem)/1 Georgia,serif;margin:0 auto 16px;max-width:800px}@media(max-width:800px){.gtg-trust,.gtg-steps,.gtg-grid,.gtg-info{grid-template-columns:1fr}.gtg-trust div{border-right:0;border-bottom:1px solid rgba(255,255,255,.15)}.gtg-hero{min-height:620px}.gtg-section{padding:54px 0}.gtg-section__head{align-items:start;flex-direction:column}.gtg-card{display:grid;grid-template-columns:42% 58%}.gtg-card img{height:100%;aspect-ratio:4/5}.gtg-card__body{padding:16px}.gtg-card h4{font-size:1.05rem}.gtg-card p{font-size:.88rem}.gtg-card__foot{align-items:start;flex-direction:column}.gtg-btn{width:100%}}
</style>{% endblock %}
{% block store_body %}
{% if gourmet_settings.store_paused|default(0) %}<aside class="gtg-pause"><strong>{{ gourmet_settings.pause_message|default('Ordering is temporarily paused.') }}</strong><a href="https://wa.me/13053761210?text=Please%20notify%20me%20when%20VNV%20Gourmet%20To%20Go%20reopens">Notify me when ordering opens →</a></aside>{% endif %}
<main>
<section class="gtg-hero"{% if store_hero_image %} style="background-image:url('{{ store_hero_image }}')"{% endif %}><div class="gtg-hero__inner"><span class="gtg-eyebrow">VNV Gourmet To Go</span><h1>You host.<br>We cook.</h1><p>Latin favorites and family-style trays, made by the VNV kitchen and delivered ready to serve. No staff, no setup — just the food.</p><p class="gtg-price-anchor">{% if lowest_box_price %}Party boxes from ${{ lowest_box_price|number_format(0) }}{% endif %}{% if lowest_box_price and lowest_tray_price %} · {% endif %}{% if lowest_tray_price %}Family trays from ${{ lowest_tray_price|number_format(0) }}{% endif %}</p><div class="gtg-actions"><a class="gtg-btn" href="#menu">See the menu</a><a class="gtg-btn gtg-btn--ghost" href="https://wa.me/13053761210?text=Hi%21%20I%27d%20like%20to%20order%20from%20VNV%20Gourmet%20To%20Go" target="_blank" rel="noopener">Order on WhatsApp</a></div></div></section>
<section class="gtg-trust"><div>The kitchen behind South Florida events</div><div>Order {{ gourmet_settings.minimum_order_notice_hours|default(24) }}h ahead</div><div>{% if delivery_zones|length %}Delivery in {% for zone in delivery_zones %}{{ zone.zone_name }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}South Florida delivery{% endif %}</div></section>
{% if seasonal_products|default([])|length %}<section class="gtg-section" id="seasonal"><div class="gtg-section__head"><div><span class="gtg-eyebrow" style="color:var(--store-green)">Holiday table</span><h2>Order the season ahead</h2></div></div><div class="gtg-grid">{% for product in seasonal_products %}<article class="gtg-card">{% if product.main_image %}<img src="{{ product.main_image }}" alt="{{ product.name }}" width="640" height="800" loading="lazy">{% endif %}<div class="gtg-card__body"><h4>{{ product.name }}</h4><div class="gtg-card__meta">{% if product.smallest_guests_max %}Serves {{ product.smallest_guests_min }}–{{ product.smallest_guests_max }} · {% endif %}From ${{ product.min_price|number_format(2) }}</div><p>{% if product.holiday_sold_out %}Sold out for {{ 'now'|date('Y') }} — contact us to join next year's list.{% else %}Order by {{ product.holiday_config.order_deadline|date('M j, Y') }}{% if product.holiday_config.fulfillment_date|default('') %} for {{ product.holiday_config.fulfillment_date|date('M j') }}{% endif %}.{% endif %}</p><div class="gtg-card__foot">{% if product.holiday_sold_out %}<a class="gtg-card__link" href="https://wa.me/13053761210?text=Please%20add%20me%20to%20the%20holiday%20menu%20list">Join the list →</a>{% else %}<a class="gtg-card__link" href="{{ path('product/' ~ product.slug) }}">Choose →</a>{% endif %}</div></div></article>{% endfor %}</div></section>{% endif %}
<section class="gtg-section"><div class="gtg-section__head"><div><span class="gtg-eyebrow" style="color:var(--store-green)">Simple by design</span><h2>How it works</h2></div></div><div class="gtg-steps"><article class="gtg-step"><span>1</span><h3>Pick your food</h3><p>Choose trays and boxes by how many people you're feeding.</p></article><article class="gtg-step"><span>2</span><h3>Choose a date</h3><p>Order at least {{ gourmet_settings.minimum_order_notice_hours|default(24) }} hours ahead. Holiday deadlines may vary.</p></article><article class="gtg-step"><span>3</span><h3>We deliver it ready</h3><p>Labeled trays arrive with simple heating and serving instructions.</p></article></div></section>
<div class="gtg-menu" id="menu"><section class="gtg-section"><div class="gtg-section__head"><div><span class="gtg-eyebrow" style="color:var(--store-green)">Shop by occasion</span><h2>Food made for gathering</h2></div><p class="gtg-muted">Delivered or ready for pickup.</p></div>{% for slug,category in categories %}{% if category.products|length %}<section class="gtg-category" id="{{ slug }}"><div class="gtg-category__head"><h3>{{ category.title }}</h3><span>{{ category.products|length }} {{ category.products|length == 1 ? 'choice' : 'choices' }}</span></div><div class="gtg-grid">{% for product in category.products %}<article class="gtg-card">{% if product.main_image %}<img src="{{ product.main_image }}" alt="{{ product.name }}" width="640" height="800" loading="lazy">{% endif %}<div class="gtg-card__body"><h4>{{ product.name }}</h4><div class="gtg-card__meta">{% if product.smallest_guests_max %}Serves {{ product.smallest_guests_min }}–{{ product.smallest_guests_max }}{% endif %}{% if product.smallest_piece_count %} · {{ product.smallest_piece_count }} pieces{% endif %}</div><p>{{ product.short_description|striptags }}</p><div class="gtg-card__foot"><span class="gtg-card__price">From ${{ product.min_price|number_format(2,'.',',') }}{% if product.smallest_guests_max and product.min_price %}<small>≈ ${{ (product.min_price / product.smallest_guests_max)|round(0,'ceil') }}/person</small>{% endif %}</span><a class="gtg-card__link" href="{{ path('product/' ~ product.slug) }}">Choose →</a></div></div></article>{% endfor %}</div></section>{% endif %}{% endfor %}</section></div>
<section class="gtg-section gtg-info" id="delivery"><div><span class="gtg-eyebrow" style="color:var(--store-green)">Plan ahead</span><h2>Delivery & pickup</h2><p class="gtg-muted">Fees and availability come from the same configuration used at checkout.</p></div><table class="gtg-table"><thead><tr><th>Area</th><th>Delivery fee</th></tr></thead><tbody>{% for zone in delivery_zones %}<tr><td>{{ zone.zone_name }}</td><td>${{ zone.delivery_fee|number_format(2) }}{% if zone.free_delivery_threshold %}<br><small>Free from ${{ zone.free_delivery_threshold|number_format(0) }}</small>{% endif %}</td></tr>{% else %}<tr><td colspan="2">Delivery configuration pending owner approval.</td></tr>{% endfor %}<tr><td>Pickup</td><td>{{ gourmet_settings.pickup_address_1|default('10258 NW 47th St') }}, {{ gourmet_settings.pickup_city|default('Sunrise') }}</td></tr></tbody></table></section>
<section class="gtg-section gtg-faq" id="faq"><div class="gtg-section__head"><h2>Questions, answered</h2></div><details><summary>How far ahead do I need to order?</summary><p>Standard orders require at least {{ gourmet_settings.minimum_order_notice_hours|default(24) }} hours. Holiday menus may have an earlier deadline.</p></details><details><summary>Where do you deliver?</summary><p>{% if delivery_zones|length %}{% for zone in delivery_zones %}{{ zone.zone_name }}{% if not loop.last %}, {% endif %}{% endfor %}.{% else %}The confirmed delivery area will appear here before ordering opens.{% endif %}</p></details><details><summary>Can I pick up?</summary><p>Pickup is available at {{ gourmet_settings.pickup_address_1|default('10258 NW 47th St') }}, {{ gourmet_settings.pickup_city|default('Sunrise') }}, Florida.</p></details><details><summary>I need staff and setup too. Can you do that?</summary><p>Yes. <a href="{{ path('') }}">Visit VNV Events</a> for full-service planning, staff and setup.</p></details></section>
<section class="gtg-final"><h2>Hosting soon? Pick your food and we'll take care of the rest.</h2><div class="gtg-actions" style="justify-content:center"><a class="gtg-btn" href="#menu">See the menu</a><a class="gtg-btn gtg-btn--ghost" href="https://wa.me/13053761210?text=Hi%21%20I%27d%20like%20to%20order%20from%20VNV%20Gourmet%20To%20Go">Order on WhatsApp</a></div></section>
</main>
{% endblock %}
