{% extends "templates/base.store.twig" %}
{% block title %}VNV Gourmet To Go | Party Appetizer Boxes & Desserts | Sunrise, FL{% endblock %}
{% block meta_description %}Build your appetizer box, add family-recipe desserts and pick up in Sunrise. Party food for 6 to 60+ guests, ordered 24h ahead.{% endblock %}
{% block canonical %}https://vnvevents.com/gourmet-to-go{% endblock %}
{% block og_title %}Party bites, ready when you are. | VNV Gourmet To Go{% endblock %}
{% block og_description %}Pick your appetizers, add something sweet and pick it up free in Sunrise.{% endblock %}
{% block og_url %}https://vnvevents.com/gourmet-to-go{% endblock %}
{% block og_image %}{{ store_hero_image_absolute|default('https://vnvevents.com/assets/images/gourmet-to-go/gtg-box-hero.webp') }}{% endblock %}
{% block store_styles %}<style>
.gtg-pause{padding:12px 16px;background:#fff3dc;text-align:center;color:#5c3c08}.gtg-intro{width:min(1180px,calc(100% - 28px));margin:0 auto;padding:24px 0 14px;display:grid;grid-template-columns:150px 1fr;gap:22px;align-items:center}.gtg-intro img{width:145px;height:145px;object-fit:cover;border-radius:24px}.gtg-intro h1{font:900 clamp(2rem,5vw,4rem)/.96 Georgia,serif;margin:0 0 9px}.gtg-intro p{margin:0;color:#625e55;font-size:1.05rem}.gtg-strip{background:#153f35;color:white;text-align:center;padding:11px 16px;font-weight:800}.gtg-tabs{position:sticky;top:0;z-index:30;display:flex;justify-content:center;gap:8px;padding:10px;background:rgba(248,245,238,.96);border-bottom:1px solid #ded5c6;backdrop-filter:blur(10px)}.gtg-tabs a{padding:10px 18px;border-radius:999px;background:#fff;border:1px solid #cfbfaa;color:#153f35;text-decoration:none;font-weight:900}.gtg-section{width:min(1180px,calc(100% - 28px));margin:0 auto;padding:36px 0}.gtg-menu{background:#f3ede3}.gtg-category{scroll-margin-top:75px;margin-bottom:42px}.gtg-category h2{font:900 clamp(1.8rem,4vw,3rem)/1 Georgia,serif;margin:0 0 18px}.gtg-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.gtg-card{display:flex;flex-direction:column;background:#fff;border:1px solid #dfd2bb;border-radius:22px;overflow:hidden;box-shadow:0 10px 28px rgba(36,27,14,.06)}.gtg-card img{width:100%;aspect-ratio:4/5;object-fit:cover;background:#e8e4dd}.gtg-card__body{display:flex;flex:1;flex-direction:column;padding:18px}.gtg-card h3{font-size:1.22rem;margin:0 0 8px}.gtg-card p{color:#6b6459;line-height:1.45;margin:.25rem 0 1rem}.gtg-card__foot{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:auto}.gtg-card__foot a{color:#0c6d59;font-weight:900;text-decoration:none}.gtg-price{font-size:1.1rem;font-weight:900}.gtg-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.gtg-step{padding:20px;border:1px solid #ddd3c4;border-radius:18px;background:#fff}.gtg-step b{display:block;color:#0c6d59;margin-bottom:6px}.gtg-info{display:grid;grid-template-columns:1fr 1fr;gap:24px}.gtg-faq details{background:#fff;border:1px solid #ddd3c4;border-radius:14px;padding:16px 18px;margin:8px 0}.gtg-faq summary{font-weight:900;cursor:pointer}.gtg-faq p{line-height:1.55;color:#625c52}@media(max-width:760px){.gtg-intro{grid-template-columns:74px 1fr;padding-top:14px}.gtg-intro img{width:74px;height:74px;border-radius:16px}.gtg-intro h1{font-size:1.75rem}.gtg-intro p{font-size:.9rem}.gtg-grid{grid-template-columns:1fr}.gtg-card{display:grid;grid-template-columns:42% 58%}.gtg-card img{height:100%;min-height:210px}.gtg-steps,.gtg-info{grid-template-columns:1fr}.gtg-section{padding:26px 0}.gtg-tabs{justify-content:stretch}.gtg-tabs a{flex:1;text-align:center}}
</style>{% endblock %}
{% block store_body %}
{% if gourmet_settings.store_paused|default(0) %}<aside class="gtg-pause"><strong>{{ gourmet_settings.pause_message|default('Ordering is temporarily paused.') }}</strong></aside>{% endif %}
<main>
<section class="gtg-intro"><img src="{{ store_hero_image|default('/assets/images/gourmet-to-go/gtg-box-hero.webp') }}" alt="VNV Gourmet To Go appetizer box"><div><h1>Party bites, ready when you are.</h1><p>Pick your appetizers, add something sweet, pick it up in Sunrise. Made by the VNV Events kitchen.</p></div></section>
<div class="gtg-strip">Order 24h ahead · Free pickup in Sunrise · Delivery available</div>
<nav class="gtg-tabs" aria-label="Menu categories"><a href="#appetizer-boxes">Appetizer Boxes</a><a href="#desserts">Desserts</a></nav>
<section class="gtg-menu"><div class="gtg-section">
{% for slug,category in categories %}{% if category.products|length %}<section class="gtg-category" id="{{ slug }}"><h2>{{ category.title }}</h2><div class="gtg-grid">{% for product in category.products %}<article class="gtg-card"><img src="{{ product.main_image ?: '/assets/images/gourmet-to-go/gtg-box-hero.webp' }}" alt="{{ product.name }}" loading="lazy"><div class="gtg-card__body"><h3>{{ product.name }}</h3><p>{{ product.short_description|striptags }}</p><div class="gtg-card__foot"><span class="gtg-price">From ${{ product.min_price|number_format(0) }}</span><a href="{{ path('product/' ~ product.slug) }}">Choose options →</a></div></div></article>{% endfor %}</div></section>{% endif %}{% endfor %}
</div></section>
<section class="gtg-section"><h2>How it works</h2><div class="gtg-steps"><div class="gtg-step"><b>1. Pick</b>Pick your box and your bites.</div><div class="gtg-step"><b>2. Schedule</b>Choose a pickup date at least 24 hours ahead.</div><div class="gtg-step"><b>3. Serve</b>Pick it up, heat what needs heat, serve.</div></div></section>
<section class="gtg-section gtg-info"><div><h2>Pickup & delivery</h2><p><strong>Free pickup:</strong> VNV Events, 10258 NW 47th St, Sunrise, FL 33351.</p><p>Delivery is optional. Its address-based fee is calculated at checkout.</p><p>Orders are paid in full and require at least 24 hours' notice.</p></div><div class="gtg-faq"><h2>FAQ</h2><details><summary>How many boxes do I need?</summary><p>Plan five pieces per guest: 30 pieces serve 6, 45 serve 9 and 60 serve 12. For more guests, add another box.</p></details><details><summary>Do I need to heat anything?</summary><p>Items marked OVEN need 5–10 minutes in a preheated oven. Never microwave. Everything else is ready to serve.</p></details><details><summary>Can you deliver?</summary><p>Pickup in Sunrise is free. Delivery is available for a fee calculated at checkout.</p></details><details><summary>Do you also offer staff and setup?</summary><p>Yes. <a href="{{ path('vnv-gourmet') }}">Explore VNV Events full-service catering</a>.</p></details></div></section>
</main>
{% endblock %}
