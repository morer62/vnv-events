{% extends "templates/base.twig" %}
{% set show_whatsapp = true %}
{% block title %}VNV Gourmet Express | Gourmet Food Delivery in South Florida{% endblock %}
{% block meta_description %}Choose chef-prepared VNV Gourmet dishes, portions and add-ons, schedule delivery and enjoy polished presentation at home or at your event.{% endblock %}
{% block canonical %}https://vnvevents.com/vnv-gourmet-express{% endblock %}
{% block og_title %}VNV Gourmet Express{% endblock %}
{% block og_description %}Your favorite VNV Gourmet dishes, prepared by VNV and delivered.{% endblock %}
{% block og_type %}website{% endblock %}
{% block og_url %}https://vnvevents.com/vnv-gourmet-express{% endblock %}
{% block styles %}
<style>
:root{--tg-ink:#111817;--tg-gold:#d6a84b;--tg-cream:#fbf7ef;--tg-green:#244c3e}
.tg-page{background:var(--tg-cream);color:var(--tg-ink);padding-bottom:5rem}.tg-hero{min-height:72vh;display:grid;place-items:center;text-align:center;padding:6.5rem 1rem 5rem;background:linear-gradient(120deg,rgba(10,18,16,.94),rgba(24,55,44,.82)),url('https://res.cloudinary.com/djlzi8bdv/image/upload/v1787926830/ophyra-growth-hub/vnvevents/service-photos/pasta-station-1.webp') center/cover;color:#fff}.tg-hero-inner{max-width:1040px}.tg-logo{display:block;width:min(480px,88vw);height:auto;margin:0 auto 1.25rem;filter:drop-shadow(0 12px 28px rgba(0,0,0,.34))}.tg-hero h1{font:800 clamp(1.7rem,3.4vw,2.8rem)/1.15 'Poppins',sans-serif;margin:.5rem auto .7rem;max-width:820px}.tg-intro{font-size:clamp(1rem,1.8vw,1.2rem);line-height:1.65;color:rgba(255,255,255,.88);max-width:760px;margin:0 auto}.tg-benefits{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.7rem;margin:1.6rem auto .2rem;text-align:left}.tg-benefit{display:flex;align-items:flex-start;gap:.7rem;padding:.85rem;background:rgba(4,15,12,.6);border:1px solid rgba(242,206,131,.3);border-radius:16px;backdrop-filter:blur(8px);font-size:.9rem;line-height:1.35}.tg-benefit-icon{display:grid;place-items:center;flex:0 0 34px;width:34px;height:34px;border-radius:50%;background:var(--tg-gold);color:#172019}.tg-benefit-icon svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.tg-btn{display:inline-flex;padding:.9rem 1.4rem;border-radius:999px;background:var(--tg-gold);color:#16130d!important;font-weight:900;text-decoration:none;margin:1rem .35rem 0}.tg-btn.alt{background:transparent;color:#fff!important;border:1px solid rgba(255,255,255,.7)}.tg-nav{max-width:1180px;margin:-2rem auto 3rem;position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:.8rem;padding:0 1rem}.tg-nav a{background:#fff;border:1px solid #e8ddc8;border-radius:18px;padding:1.2rem;text-align:center;color:var(--tg-ink);text-decoration:none;font-weight:900;box-shadow:0 14px 35px rgba(17,24,23,.09)}.tg-section{max-width:1180px;margin:0 auto;padding:2rem 1rem}.tg-how{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.tg-step{background:#fff;border:1px solid #eadfcb;border-radius:20px;padding:1.25rem}.tg-step strong{display:block;color:var(--tg-green);margin-bottom:.4rem}.tg-heading{display:flex;justify-content:space-between;align-items:end;border-bottom:1px solid #ddcfb6;padding-bottom:.8rem;margin-bottom:1.2rem}.tg-heading h2{font:900 clamp(1.8rem,4vw,3rem)/1 'Poppins',sans-serif;margin:0}.tg-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.tg-card{background:#fff;border:1px solid #eadfcb;border-radius:22px;overflow:hidden;box-shadow:0 12px 30px rgba(17,24,23,.06)}.tg-card img{width:100%;aspect-ratio:4/3;object-fit:cover;background:#eee}.tg-card-body{padding:1.1rem}.tg-card h3{font-weight:900;font-size:1.15rem}.tg-price{color:var(--tg-green);font-weight:900;font-size:1.1rem}.tg-card-actions{display:flex;justify-content:space-between;align-items:center;gap:.7rem}.tg-link{color:var(--tg-green);font-weight:900;text-decoration:none}.tg-empty{padding:2rem;border:1px dashed #cdbc9d;border-radius:18px;color:#766b58}@media(max-width:900px){.tg-benefits{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:800px){.tg-nav,.tg-grid,.tg-how{grid-template-columns:1fr}.tg-hero{min-height:58vh;padding-top:5.5rem}.tg-nav{margin-top:-1.3rem}}@media(max-width:560px){.tg-benefits{grid-template-columns:1fr}.tg-logo{width:min(360px,92vw)}}
</style>
{% endblock %}
{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}
<main class="tg-page">
  <section class="tg-hero"><div class="tg-hero-inner"><img class="tg-logo" src="{{ path('assets/images/vnv-gourmet-express-logo.webp') }}" alt="VNV Gourmet Express" width="1000" height="500"><h1>Chef-prepared menus for effortless hosting.</h1><p class="tg-intro">Build your celebration à la carte with VNV favorites, flexible portions and polished delivery throughout South Florida.</p><div class="tg-benefits" aria-label="Gourmet Express benefits"><div class="tg-benefit"><span class="tg-benefit-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><span><strong>Order ahead</strong><br>Place your event order at least 24 hours in advance.</span></div><div class="tg-benefit"><span class="tg-benefit-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg></span><span><strong>South Florida delivery</strong><br>Broward, Palm Beach and Miami-Dade.</span></div><div class="tg-benefit"><span class="tg-benefit-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16M6 5l1 15h10l1-15M9 9v7M12 9v7M15 9v7"/></svg></span><span><strong>Create your own feast</strong><br>Mix entrées, trays, boxes, desserts and add-ons à la carte.</span></div><div class="tg-benefit"><span class="tg-benefit-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M9 8h6M9 12h6M10 17h4"/></svg></span><span><strong>Easy from the app</strong><br>Reorder favorites, add more or adjust your selections.</span></div></div><a class="tg-btn" href="#main-courses">Explore the Menu</a><a class="tg-btn alt" href="#how-it-works">How It Works</a></div></section>
  <nav class="tg-nav" aria-label="Gourmet Express categories"><a href="#main-courses">Main Courses</a><a href="#appetizers">Appetizers</a><a href="#desserts">Desserts</a><a href="#seasonal">Seasonal</a></nav>
  <section class="tg-section" id="how-it-works"><div class="tg-heading"><h2>Hosting, made easier</h2></div><div class="tg-how"><div class="tg-step"><strong>1. Choose</strong>Select dishes, portions, preferences and sides.</div><div class="tg-step"><strong>2. Schedule</strong>Choose an eligible delivery date and time.</div><div class="tg-step"><strong>3. Receive</strong>Your food arrives prepared by the VNV Gourmet team.</div><div class="tg-step"><strong>4. Present</strong>Use the included heating, plating and presentation guide.</div></div></section>
  {% for key, group in groups %}
  <section class="tg-section" id="{{ key == 'main' ? 'main-courses' : key }}"><div class="tg-heading"><h2>{{ group.title }}</h2><span>{{ group.products|length }} selections</span></div>
    {% if group.products|length %}<div class="tg-grid">{% for product in group.products %}<article class="tg-card"><img src="{{ product.main_image }}" alt="{{ product.name }}" loading="lazy"><div class="tg-card-body"><h3>{{ product.name }}</h3><p>{{ product.short_description|default('Prepared with the quality and care of VNV Events.') }}</p><div class="tg-card-actions"><span class="tg-price">{% if product.min_price is defined and product.min_price %}From ${{ product.min_price|number_format(2,'.',',') }}{% else %}${{ product.price|number_format(2,'.',',') }}{% endif %}</span><a class="tg-link" href="{{ path('product/' ~ product.slug) }}">View →</a></div></div></article>{% endfor %}</div>{% else %}<div class="tg-empty">Selections in this category are being prepared.</div>{% endif %}
  </section>{% endfor %}
</main>
{% include "templates/layout/publicFooterVnv.html.twig" %}
{% endblock %}
