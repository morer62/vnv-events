{% extends "templates/base.twig" %}
{% block title %}{{ seo.title }}{% endblock %}
{% block meta_description %}{{ seo.description }}{% endblock %}
{% block canonical %}{{ seo.canonical }}{% endblock %}
{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-partnerships.css') }}">
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-production-offers.css', { v: 'production-films-2' }) }}">
{% include "templates/components/vnvProductionEditorialAssets.html.twig" %}
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-partner-value.css', { v: '1' }) }}">
{% endblock %}

{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}
<main class="vnv-partnership-page ve-page ve-page--activation">
  {% include "templates/components/vnvProductionHero.html.twig" with {
  hero: {
    slug: 'brand-activation',
    label: 'South Florida · For brands and sponsors',
    title: 'Brand experiences',
    emphasis: '& activation.',
    description: 'Activate your brand at an existing event, partner on an approved experience or produce a launch of your own. We design the guest interaction and lead the team that delivers it.',
    details: ['Audience goals and creative direction', 'Organizer approvals, production and live staffing', 'Agreed participation measures and follow-up'],
    cta: 'Create Your Brand Experience',
    href: '#activation-brief',
    request_service: 'brand-activation',
    preview_label: 'A preview of trade show graphics, exhibit structures and the show floor'
  }
} only %}

  <section class="vnvp-section vp-brand-modes" id="activation-delivery" aria-labelledby="brand-formats">
    <div class="vnvp-container">
      <div class="vnvp-heading"><h2 id="brand-formats">Where do you want to meet your audience?</h2></div>
      <div class="vnvp-grid">
        <article class="vnvp-card"><h3>Activate at an existing event</h3><p>At a gala, trade show, conference or community event, give visitors a reason to stop and an action to take. We shape the concept, secure organizer approvals and coordinate the staffing, build, logistics and recap.</p>
          <a href="{{ path('') }}?request_service=brand-activation#vnvRequestModal" data-vnv-open-request data-vnv-request-service="brand-activation">Plan an activation ↗</a></article>
        <article class="vnvp-card"><h3>Partner with our experiences</h3><p>Explore sampling, hosted moments and sponsorships with VNV originals or authorized partners. Each project defines its audience, available inventory and approval process.</p>
          <a href="{{ path('vnv-events-productions') }}">Explore Original Experiences ↗</a></article>
        <article class="vnvp-card"><h3>Create your own brand event</h3><p>Launch a product, host a customer reception or bring employees together. We develop the program, direct vendors and run the event under one production scope.</p>
          <a href="{{ path('event-production') }}#production-fees">See event production options ↗</a></article>
      </div>
    </div>
  </section>

{% include "templates/components/vnvProductionFees.html.twig" with { services: production_services, keys: ['brand-activation', 'sponsorship-opportunities'], managed_budget: managed_budget, direct_costs: direct_costs, activation: true } only %}

  {% include "templates/components/vnvProductionFilm.html.twig" with {
    film: {
      slug: 'brand-activation',
      route: 'sponsor-activation-production',
      credit: 'Illustrative trade show scenes and exhibit designs. AI-generated narration.',
      title: 'From a first impression to a real conversation',
      description: 'See how an audience goal becomes a live activation, a partnership or a brand-owned event. Your producer coordinates fabrication, multimedia, staffing and the next step for interested guests.',
      cta: 'Create Your Brand Experience',
      request_service: 'brand-activation'
    }
  } only %}

{% include "templates/components/vnvProductionPartnerValue.html.twig" with { audience: 'activation' } only %}

  <section class="vnvp-section" id="formats"><div class="vnvp-container">
    <div class="vnvp-heading"><h2>What do you want visitors to do?</h2><p>The experience at the booth determines the layout, staff and equipment we include in your proposal.</p></div>
    <div class="vnvp-grid">
      <article class="vnvp-card"><span class="vnvp-card__icon" aria-hidden="true"><i class="fa-solid fa-box-open"></i></span><h3>Try a product</h3><p>Give visitors a clear spot to watch a demo or try a sample. We plan the display, staff positions and queue around the show's sampling and power rules.</p></article>
      <article class="vnvp-card"><span class="vnvp-card__icon" aria-hidden="true"><i class="fa-solid fa-couch"></i></span><h3>Meet your team</h3><p>Use a welcome counter for first conversations and a hosted lounge for longer meetings. We scope seating, hospitality and staff around the number of guests you expect.</p></article>
      <article class="vnvp-card"><span class="vnvp-card__icon" aria-hidden="true"><i class="fa-solid fa-camera"></i></span><h3>Step into a photo moment</h3><p>Build a branded backdrop or scenic installation with room for guests and the camera. We plan the lighting and the line so the experience keeps the aisle clear.</p></article>
    </div>
  </div></section>

  <section class="vp-commercial" aria-labelledby="brand-build-title"><div class="vp-commercial__inner">
    <h2 id="brand-build-title">From the first brief to the handoff</h2>
    <p class="vp-form-summary">We confirm the audience, sponsorship rights, guest action and success measure. A branded booth, signage, product samples or a hosted lounge can support the plan. We select fabrication and staffing partners, coordinate load-in and rehearsal, and agree on a recap before the show opens.</p>
    <a href="{{ path('nonprofit-partnerships') }}">See how Cause on Cue works with nonprofit organizers</a>
  </div></section>

  <section class="vnvp-section" id="activation-brief"><div class="vnvp-container vnvp-form-wrap">
    <div class="vnvp-form-intro"><h2>Tell us what you want guests to do</h2><p>Share your objective, audience and preferred event or date. If you already have a footprint and organizer specifications, use the technical brief.</p>
      <a class="vnvp-button vnvp-button--gold" href="{{ path('') }}?request_service=brand-activation#vnvRequestModal" data-vnv-open-request data-vnv-request-service="brand-activation">Create Your Brand Experience</a></div>
    <details class="vnvp-advanced"><summary>Complete technical activation brief</summary><form class="vnvp-form" action="{{ path('api/public/partnership-request') }}" method="post">
      {% if submitted %}<div class="vnvp-success" role="status"><strong>Brief received.</strong> We sent an acknowledgment with your reference number.</div>{% endif %}
      <input type="hidden" name="program" value="ACTIVATION"><input type="hidden" name="_token" value="{{ partnership_csrf }}">
      <div class="vnvp-hidden" aria-hidden="true"><label>Website confirmation<input type="text" name="website_confirm" tabindex="-1" autocomplete="off"></label></div>
      {% for key in ['gclid','gbraid','wbraid','utm_source','utm_medium','utm_campaign','utm_term','utm_content','landing_url'] %}<input type="hidden" name="{{ key }}" data-attribution="{{ key }}">{% endfor %}
      <div class="vnvp-fields">
        <div class="vnvp-field"><label for="act-brand">Brand name *</label><input id="act-brand" name="brand_name" required maxlength="191"></div>
        <div class="vnvp-field"><label for="act-event">Event or organizer *</label><input id="act-event" name="event_organizer" required maxlength="220"></div>
        <div class="vnvp-field"><label for="act-status">Sponsorship status *</label><select id="act-status" name="sponsor_status" required><option value="">Select</option><option>Contracted sponsor</option><option>Approved sponsor, contract in progress</option><option>Event organizer requesting for a sponsor</option><option>Exploring before sponsor commitment</option></select></div>
        <div class="vnvp-field"><label for="act-date">Event date</label><input id="act-date" name="event_date" type="date"></div>
        <div class="vnvp-field"><label for="act-venue">Venue</label><input id="act-venue" name="venue" maxlength="255"></div>
        <div class="vnvp-field"><label for="act-city">City</label><input id="act-city" name="city" maxlength="120"></div>
        <div class="vnvp-field"><label for="act-type">Activation type</label><input id="act-type" name="activation_type" maxlength="150" placeholder="Trade show booth, demo, lounge, photo moment..."></div>
        <div class="vnvp-field"><label for="act-size">Available dimensions</label><input id="act-size" name="dimensions" maxlength="150"></div>
        <div class="vnvp-field vnvp-field--full"><label for="act-audience">Audience and expected attendance</label><textarea id="act-audience" name="audience" maxlength="500"></textarea></div>
        <div class="vnvp-field"><label for="act-budget">Budget range</label><input id="act-budget" name="budget_range" maxlength="120"></div>
        <div class="vnvp-field"><label for="act-art">Who owns/provides final artwork?</label><input id="act-art" name="artwork_owner" maxlength="150"></div>
        <div class="vnvp-field vnvp-field--full"><label for="act-approval">Organizer, venue and brand approval requirements</label><textarea id="act-approval" name="approval_requirements" maxlength="1000"></textarea></div>
        <div class="vnvp-field"><label for="act-power">Electricity / utility access</label><input id="act-power" name="electricity" maxlength="120"></div>
        <div class="vnvp-field"><label for="act-staff">Staffing needs</label><input id="act-staff" name="staffing" maxlength="500"></div>
        <fieldset class="vnvp-group"><legend>Requested deliverables</legend><div class="vnvp-checks">{% for option in ['Concept design','Brand identity adaptation','Custom trade show booth','Fabrication / install','Booth printing / graphics','Decor / scenic','Hospitality','Sampling operations','Activation staffing','Photo / video documentation','Event recap'] %}<label class="vnvp-check"><input type="checkbox" name="deliverables[]" value="{{ option }}"><span>{{ option }}</span></label>{% endfor %}</div></fieldset>
        <div class="vnvp-field"><label for="act-name">Contact name *</label><input id="act-name" name="contact_name" required maxlength="191"></div>
        <div class="vnvp-field"><label for="act-role">Role</label><input id="act-role" name="contact_role" maxlength="150"></div>
        <div class="vnvp-field"><label for="act-email">Email *</label><input id="act-email" name="email" type="email" required maxlength="191"></div>
        <div class="vnvp-field"><label for="act-phone">Phone *</label><input id="act-phone" name="phone" type="tel" required maxlength="80"></div>
        <div class="vnvp-field vnvp-field--full"><label for="act-notes">Anything else we should know?</label><textarea id="act-notes" name="notes" maxlength="2500"></textarea></div>
      </div>
      <label class="vnvp-consent"><input type="checkbox" name="consent" value="1" required><span>I agree that VNV Events may contact me about this brief. I understand that submission does not guarantee availability, organizer approval, event performance or ROI.</span></label>
      <button class="vnvp-button vnvp-button--gold" type="submit">Submit Technical Brief</button>
      <p class="vnvp-form-note">Final pricing depends on approved scope, footprint, venue rules, labor, fabrication, utilities, access and deliverables.</p>
    </form></details>
  </div></section>
</main>
{% include "templates/components/publicEventRequestModal.html.twig" with { request_form_action: path('api/public/event-request'), request_form_source: 'brand_experiences' } %}
{% include "templates/layout/publicFooterVnv.html.twig" %}
{% endblock %}

{% block scripts %}<script>(function(){const params=new URLSearchParams(location.search);document.querySelectorAll('[data-attribution]').forEach(function(input){input.value=input.dataset.attribution==='landing_url'?location.href:(params.get(input.dataset.attribution)||'');});})();</script>{% endblock %}
