    request_form_action: "/api/public/event-request"
} %}
{% include "templates/layout/publicFooterVnv.html.twig" %}

<script>
document.addEventListener('DOMContentLoaded', function () {
    const lightbox = document.getElementById('lpLightbox');
    const lightboxImage = document.getElementById('lpLightboxImage');
    const lightboxClose = document.getElementById('lpLightboxClose');
    const zoomableImages = Array.from(document.querySelectorAll('.lp-img-zoomable'));

    function closeLightbox() {
        if (!lightbox) return;
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
    }

    if (lightbox && lightboxImage && zoomableImages.length) {
        zoomableImages.forEach(function (img) {
            img.addEventListener('click', function () {
                lightboxImage.src = img.getAttribute('src') || '';
                lightboxImage.alt = img.getAttribute('alt') || 'Gallery image';
                lightbox.classList.add('is-open');
                lightbox.setAttribute('aria-hidden', 'false');
            });
        });
        if (lightboxClose) {
            lightboxClose.addEventListener('click', closeLightbox);
        }
        lightbox.addEventListener('click', function (event) {
            if (event.target === lightbox) closeLightbox();
        });
        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') closeLightbox();
        });
    }

    const mapEls = Array.from(document.querySelectorAll('[data-map]'));
    let mapsInitialized = false;

    function initLocationMaps() {
        if (mapsInitialized) return true;
        if (!mapEls.length || !window.google || !google.maps) return false;

        mapEls.forEach(function (mapEl) {
            if (mapEl.dataset.mapReady === '1') return;

            const initialLat = parseFloat(mapEl.dataset.lat || '0');
            const initialLng = parseFloat(mapEl.dataset.lng || '0');
            const initialAddress = mapEl.dataset.address || '';

            const fallbackCenter = { lat: 25.7617, lng: -80.1918 };
            const center = (!Number.isNaN(initialLat) && !Number.isNaN(initialLng) && initialLat && initialLng)
                ? { lat: initialLat, lng: initialLng }
                : fallbackCenter;

            const map = new google.maps.Map(mapEl, {
                center: center,
                zoom: 13,
                mapTypeControl: false,
                streetViewControl: false,
                fullscreenControl: false
            });
            const marker = new google.maps.Marker({ map: map, position: center });
            const geocoder = new google.maps.Geocoder();

            function geocodeAndCenter(address) {
                if (!address) return;
                geocoder.geocode({ address: address }, function (results, status) {
                    if (status !== 'OK' || !results || !results.length) return;
                    const loc = results[0].geometry.location;
                    map.setCenter(loc);
                    marker.setPosition(loc);
                });
            }

            if (initialAddress && (!initialLat || !initialLng)) {
                geocodeAndCenter(initialAddress);
            }

            // Ensure a proper render when the map API arrives after first paint.
            setTimeout(function () {
                google.maps.event.trigger(map, 'resize');
                map.setCenter(marker.getPosition());
            }, 80);

            mapEl.dataset.mapReady = '1';
        });

        mapsInitialized = true;
        return true;
    }

    if (!initLocationMaps()) {
        let tries = 0;
        const maxTries = 60; // ~9 seconds
        const timer = setInterval(function () {
            tries += 1;
            if (initLocationMaps() || tries >= maxTries) {
                clearInterval(timer);
            }
        }, 150);
    }

    window.addEventListener('load', initLocationMaps);

    function initTestimonialCarousels() {
        const shells = Array.from(document.querySelectorAll('.lp-testimonials-shell'));
        if (!shells.length) return;

        shells.forEach(function (shell) {
            const items = Array.from(shell.querySelectorAll('.js-testimonial-item'));
            const prevBtn = shell.querySelector('.js-testimonial-prev');
            const nextBtn = shell.querySelector('.js-testimonial-next');
            const dotsWrap = shell.querySelector('.js-testimonial-dots');
            if (items.length <= 3) return;

            let currentPage = 0;
            let autoTimer = null;

            function getPerView() {
                if (window.innerWidth <= 640) return 1;
                if (window.innerWidth <= 991) return 2;
                return 3;
            }

            function getPageCount(perView) {
                return Math.max(1, Math.ceil(items.length / perView));
            }

            function renderDots(pageCount) {
                if (!dotsWrap) return;
                dotsWrap.innerHTML = '';
                for (let i = 0; i < pageCount; i += 1) {
                    const dot = document.createElement('span');
                    if (i === currentPage) dot.classList.add('active');
                    dot.addEventListener('click', function () {
                        currentPage = i;
                        update();
                        restartAuto();
                    });
                    dotsWrap.appendChild(dot);
                }
            }

            function update() {
                const perView = getPerView();
                const pageCount = getPageCount(perView);
                if (currentPage >= pageCount) currentPage = 0;
                const start = currentPage * perView;
                const end = start + perView;

                items.forEach(function (item, idx) {
                    item.classList.toggle('is-hidden', !(idx >= start && idx < end));
                });

                const dots = dotsWrap ? Array.from(dotsWrap.querySelectorAll('span')) : [];
                if (!dots.length || dots.length !== pageCount) {
                    renderDots(pageCount);
                } else {
                    dots.forEach(function (dot, idx) {
                        dot.classList.toggle('active', idx === currentPage);
                    });
                }
            }

            function next() {
                const pageCount = getPageCount(getPerView());
                currentPage = (currentPage + 1) % pageCount;
                update();
            }

            function prev() {
                const pageCount = getPageCount(getPerView());
                currentPage = (currentPage - 1 + pageCount) % pageCount;
                update();
            }

            function startAuto() {
                if (autoTimer) clearInterval(autoTimer);
                autoTimer = setInterval(next, 5500);
            }

            function restartAuto() {
                startAuto();
            }

            if (nextBtn) nextBtn.addEventListener('click', function () { next(); restartAuto(); });
            if (prevBtn) prevBtn.addEventListener('click', function () { prev(); restartAuto(); });
            window.addEventListener('resize', update);

            update();
            startAuto();
        });
    }

    initTestimonialCarousels();
});
</script>
{% if page.custom_js %}
<script>{{ page.custom_js|raw }}</script>
{% endif %}
{% endblock %}
