{% extends "templates/base.twig" %}

{% block title %}
    {{ page.meta_title ?: page.title ~ ' | VNV Events' }}
{% endblock %}

{% block meta_description %}
    {{ page.meta_description ?: page.excerpt ?: 'VNV Events location page' }}
{% endblock %}

{% block meta_keywords %}
    {{ page.meta_keywords ?: page.primary_keyword ?: 'VNV Events, South Florida events' }}
{% endblock %}

{% block canonical %}
    {{ page.canonical_url ?: ('https://vnvevents.com/locations/' ~ page.slug ~ '/') }}
{% endblock %}

{% block og_title %}
    {{ page.og_title ?: page.meta_title ?: page.title }}
{% endblock %}

{% block og_description %}
    {{ page.og_description ?: page.meta_description ?: page.excerpt ?: 'VNV Events location page' }}
{% endblock %}

{% block og_url %}
    {{ page.canonical_url ?: ('https://vnvevents.com/locations/' ~ page.slug ~ '/') }}
{% endblock %}

{% block og_image %}
    {{ page.og_image ?: page.hero_image ?: asset_for('assets/images/planner-hub-logo-negative.png') }}
{% endblock %}

{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=Playfair+Display:wght@600;700;800&display=swap');
    :root{
        --lp-primary:#5EC6C4;
        --lp-gold:#c5a059;
        --lp-dark:#0a0c0c;
        --lp-dark-soft:#141818;
        --lp-light:#fff;
        --lp-marble:#f4f7f8;
        --lp-muted:rgba(255,255,255,.78);
    }
    .lp-wrap{background:var(--lp-dark);color:#f3f5f6;}
    .lp-wrap{font-family:'Manrope',system-ui,-apple-system,'Segoe UI',sans-serif;}
    .lp-hero{
        min-height:78vh;display:flex;align-items:center;position:relative;overflow:hidden;
        background:
            linear-gradient(90deg, rgba(10,12,12,.86) 0%, rgba(10,12,12,.62) 46%, rgba(10,12,12,.34) 100%),
            url('{{ page.hero_image ?: asset_for('assets/images/vnv-gourmet-hero.jpg') }}') center/cover no-repeat;
    }
    .lp-hero::after{
        content:"";position:absolute;inset:0;pointer-events:none;
        background:radial-gradient(circle at top right, rgba(94,198,196,.16), transparent 34%);
    }
    .lp-hero-inner{position:relative;z-index:2;max-width:1140px;margin:0 auto;padding:50px 16px;}
    .lp-badge{
        display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border-radius:999px;
        background:rgba(94,198,196,.1);color:var(--lp-primary);font-size:.76rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
    }
    .lp-title{
        font-family:'Playfair Display','Times New Roman',serif;
        font-size:clamp(2.3rem,5vw,4.4rem);line-height:1.02;margin:16px 0 16px;font-weight:800;max-width:920px;
    }
    .lp-sub{max-width:760px;color:var(--lp-muted);font-size:1.05rem;line-height:1.8;}
    .lp-cta-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px;}
    .lp-btn{
        display:inline-flex;align-items:center;justify-content:center;gap:10px;
        border:none;border-radius:999px;padding:13px 22px;font-weight:800;font-size:.82rem;
        letter-spacing:.08em;text-transform:uppercase;text-decoration:none;transition:.25s ease;
    }
    .lp-btn-gold{background:linear-gradient(135deg,#bf953f 0%,#fcf6ba 45%,#b38728 100%);color:#0f1112;}
    .lp-btn-gold:hover{transform:translateY(-3px);box-shadow:0 16px 28px rgba(197,160,89,.3);}
    .lp-btn-ghost{background:transparent;border:1px solid rgba(255,255,255,.26);color:#fff;}
    .lp-btn-ghost:hover{background:#fff;color:#121719;}
    .lp-meta{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px;}
    .lp-chip{padding:8px 12px;border-radius:999px;border:1px solid rgba(255,255,255,.2);font-size:.8rem;font-weight:700;color:#fff;}
    .lp-section{padding:76px 0;}
    .lp-white{background:var(--lp-marble);color:#11181a;}
    .lp-container{max-width:1140px;margin:0 auto;padding:0 16px;}
    .lp-card{
        background:#fff;border:1px solid rgba(17,24,26,.08);border-radius:22px;box-shadow:0 16px 36px rgba(0,0,0,.08);padding:24px;
        transition:transform .28s ease, box-shadow .28s ease, border-color .28s ease;
    }
    .lp-card:hover{
        transform:translateY(-4px);
        box-shadow:0 24px 44px rgba(0,0,0,.14);
        border-color:rgba(214,174,103,.45);
    }
    .lp-content{line-height:1.8;color:#334155;}
    .lp-content h2,.lp-content h3,.lp-block-title{color:#111827;}
    .lp-content h2,.lp-content h3,.lp-block-title{font-family:'Playfair Display','Times New Roman',serif;}
    .lp-grid{display:grid;gap:14px;}
    .lp-grid.cols-2{grid-template-columns:repeat(2,minmax(0,1fr));}
    .lp-grid.cols-3{grid-template-columns:repeat(3,minmax(0,1fr));}
    .lp-grid.cols-4{grid-template-columns:repeat(4,minmax(0,1fr));}
    .lp-img{width:100%;height:220px;object-fit:cover;border-radius:16px;border:1px solid #dbe5ea;transition:transform .35s ease, box-shadow .35s ease;cursor:zoom-in;}
    .lp-img:hover{transform:scale(1.03);box-shadow:0 14px 28px rgba(0,0,0,.18);}
    .lp-link-list{display:grid;gap:10px;}
    .lp-link-item{
        display:flex;justify-content:space-between;gap:10px;align-items:center;padding:12px 14px;border-radius:12px;
        background:#fff;border:1px solid #dbe5ea;color:#0f172a;text-decoration:none;font-weight:700;
    }
    .lp-breadcrumbs,.lp-internal-links{display:flex;flex-wrap:wrap;gap:8px;align-items:center;}
    .lp-breadcrumbs a,.lp-internal-links a{color:inherit;text-decoration:none;}
    .lp-breadcrumbs{margin-bottom:14px;color:rgba(255,255,255,.78);font-size:.86rem;}
    .lp-internal-links{margin-top:18px;}
    .lp-info-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;}
    .lp-info{
        background:#fff;border:1px solid #dbe5ea;border-radius:14px;padding:12px;
    }
    .lp-info .k{font-size:.76rem;color:#64748b;text-transform:uppercase;font-weight:800;letter-spacing:.04em;}
    .lp-info .v{font-size:1rem;color:#0f172a;font-weight:900;margin-top:2px;}
    .lp-map-wrap{display:block;}
    .lp-map-canvas{height:340px;border-radius:14px;border:1px solid #dbe5ea;background:#eef3f6;}
    .lp-faq .accordion-item{border-radius:10px;overflow:hidden;margin-bottom:10px;}
    .lp-testimonial-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;}
    .lp-testimonial-item{
        border:1px solid #e5edf2;
        border-radius:16px;
        padding:16px;
        background:#fff;
        transition:transform .28s ease, box-shadow .28s ease, border-color .28s ease;
    }
    .lp-testimonial-item:hover{
        transform:translateY(-5px);
        border-color:rgba(214,174,103,.5);
        box-shadow:0 18px 32px rgba(0,0,0,.12);
    }
    .lp-testimonial-quote{font-size:.98rem;line-height:1.75;color:#334155;margin-bottom:14px;}
    .lp-testimonial-name{font-weight:800;color:#0f172a;}
    .lp-testimonial-role{font-size:.86rem;color:#64748b;}
    .lp-lightbox-overlay{
        position:fixed;inset:0;z-index:3000;background:rgba(6,9,11,.88);
        display:none;align-items:center;justify-content:center;padding:24px;
    }
    .lp-lightbox-overlay.is-open{display:flex;}
    .lp-lightbox-dialog{position:relative;max-width:min(1100px,95vw);max-height:90vh;}
    .lp-lightbox-image{max-width:100%;max-height:86vh;border-radius:16px;box-shadow:0 26px 54px rgba(0,0,0,.44);}
    .lp-lightbox-close{
        position:absolute;top:-12px;right:-12px;border:none;border-radius:999px;width:40px;height:40px;
        background:linear-gradient(135deg,#bf953f,#b38728);color:#111;font-size:1.1rem;font-weight:900;cursor:pointer;
    }
    @media (max-width: 991px){
        .lp-info-grid{grid-template-columns:repeat(2,minmax(0,1fr));}
        .lp-grid.cols-3,.lp-grid.cols-4{grid-template-columns:repeat(2,minmax(0,1fr));}
        .lp-testimonial-grid{grid-template-columns:repeat(2,minmax(0,1fr));}
    }
    @media (max-width: 640px){
        .lp-section{padding:48px 0;}
        .lp-info-grid,.lp-grid.cols-2,.lp-grid.cols-3,.lp-grid.cols-4,.lp-testimonial-grid{grid-template-columns:1fr;}
    }
</style>
{% if page.custom_css %}
<style>{{ page.custom_css|raw }}</style>
{% endif %}
<style>
    /* Keep hero image visible even with aggressive custom CSS overrides */
    main.lp-wrap > section.lp-hero{
        background:
            linear-gradient(90deg, rgba(5,8,11,.9) 0%, rgba(5,8,11,.7) 44%, rgba(5,8,11,.38) 100%),
            url('{{ page.hero_image ?: asset_for('assets/images/vnv-gourmet-hero.jpg') }}') center/cover no-repeat !important;
    }
</style>
<style>
    /* Mock-accurate luxe refinement layer */
    :root{
        --lp-mock-bg:#04090f;
        --lp-mock-bg-soft:#07111b;
        --lp-mock-gold:#cfa75b;
        --lp-mock-gold-soft:#f0d7a2;
        --lp-mock-border:rgba(207,167,91,.28);
    }
    .lp-wrap{
        background:
            radial-gradient(1200px 520px at 85% -8%,rgba(207,167,91,.1),transparent 52%),
            repeating-linear-gradient(120deg, rgba(255,255,255,.012) 0 2px, transparent 2px 14px),
            var(--lp-mock-bg);
    }
    .lp-wrap::before{
        content:"";
        position:fixed;
        inset:0;
        pointer-events:none;
        background:
            radial-gradient(900px 460px at 90% 0%, rgba(207,167,91,.08), transparent 60%),
            radial-gradient(780px 420px at 10% 20%, rgba(94,198,196,.05), transparent 60%);
        z-index:0;
    }
    .lp-wrap > *{position:relative;z-index:1;}
    .lp-hero{
        min-height:640px;
        border-bottom:1px solid var(--lp-mock-border);
        box-shadow:inset 0 -120px 140px rgba(3,8,14,.85);
        position:relative;
        overflow:hidden;
    }
    .lp-hero::after{
        content:"";
        position:absolute;
        inset:0;
        pointer-events:none;
        background:
            linear-gradient(90deg, rgba(4,7,10,.84) 0%, rgba(4,7,10,.55) 45%, rgba(4,7,10,.18) 100%),
            radial-gradient(circle at 88% 16%, rgba(240,215,162,.18), transparent 42%);
    }
    .lp-hero-inner{max-width:1280px;padding:58px 24px 68px;position:relative;z-index:2;}
    .lp-badge{
        background:rgba(207,167,91,.12)!important;
        color:var(--lp-mock-gold-soft)!important;
        border:1px solid rgba(207,167,91,.42)!important;
        letter-spacing:.09em;
        box-shadow:0 0 0 1px rgba(207,167,91,.12), 0 8px 20px rgba(2,6,10,.45);
        position:relative;
        padding-left:34px;
    }
    .lp-badge::before{
        content:"✦";
        position:absolute;
        left:13px;
        top:50%;
        transform:translateY(-52%);
        color:var(--lp-mock-gold-soft);
        font-size:.72rem;
    }
    .lp-title{
        font-size:clamp(2.45rem,5.4vw,4.75rem);
        max-width:820px;
        margin-top:20px;
        margin-bottom:14px;
        text-shadow:0 14px 36px rgba(0,0,0,.58);
    }
    .lp-title .lp-accent{
        background:linear-gradient(135deg,#c29343 0%,#f4deaa 52%,#aa7e2a 100%);
        -webkit-background-clip:text;
        background-clip:text;
        color:transparent;
        text-shadow:none;
    }
    .lp-sub{max-width:690px;font-size:1.03rem;line-height:1.78;color:#d6dde4;}
    .lp-sub::first-letter{
        font-family:'Playfair Display','Times New Roman',serif;
        font-size:1.22em;
        color:var(--lp-mock-gold-soft);
    }
    .lp-btn{padding:13px 22px;border-radius:12px;transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease, background .25s ease;}
    .lp-btn-gold{
        background:linear-gradient(135deg,#c29343 0%,#f4deaa 46%,#aa7e2a 100%);
        box-shadow:0 10px 28px rgba(194,147,67,.35);
        border:1px solid rgba(255,231,177,.34);
    }
    .lp-btn-gold:hover{transform:translateY(-2px);box-shadow:0 16px 30px rgba(194,147,67,.4);}
    .lp-btn-ghost{
        border:1px solid rgba(236,241,246,.33);
        background:rgba(5,11,16,.28);
    }
    .lp-btn-ghost:hover{transform:translateY(-2px);border-color:rgba(246,226,177,.44);background:rgba(10,17,24,.62);}
    .lp-chip{
        border-color:rgba(207,167,91,.46)!important;
        background:rgba(207,167,91,.08)!important;
    }
    .lp-section{
        background:var(--lp-mock-bg)!important;
        padding:34px 0 58px;
    }
    .lp-white{background:var(--lp-mock-bg)!important;color:#eef4f8;}
    .lp-container{max-width:1280px;padding:0 18px;}
    .lp-card{
        background:linear-gradient(165deg,#06101a,#081522)!important;
        border:1px solid var(--lp-mock-border)!important;
        border-radius:16px;
        box-shadow:0 14px 34px rgba(0,0,0,.38);
        position:relative;
        overflow:hidden;
        transition:transform .3s ease, box-shadow .3s ease, border-color .3s ease;
    }
    .lp-card::before{
        content:"";
        position:absolute;
        left:0;right:0;top:0;height:1px;
        background:linear-gradient(90deg,transparent,rgba(240,215,162,.58),transparent);
        pointer-events:none;
    }
    .lp-card::after{
        content:"";
        position:absolute;
        inset:auto -10% -45% -10%;
        height:60%;
        background:radial-gradient(ellipse at center, rgba(207,167,91,.11), transparent 70%);
        pointer-events:none;
    }
    .lp-card:hover{
        transform:translateY(-3px);
        border-color:rgba(240,215,162,.38)!important;
        box-shadow:0 22px 46px rgba(0,0,0,.45);
    }
    .lp-dynamic-layout{
        display:grid;
        grid-template-columns:repeat(12,minmax(0,1fr));
        gap:14px;
    }
    .lp-split-feature{
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:0;
        position:relative;
    }
    .lp-split-col{padding:22px 24px;}
    .lp-split-col + .lp-split-col{border-left:1px solid rgba(207,167,91,.24);}
    .lp-split-star{
        position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
        width:22px;height:22px;border-radius:999px;
        display:flex;align-items:center;justify-content:center;
        color:#f5ddb0;font-size:1.05rem;
        text-shadow:0 0 14px rgba(245,221,176,.5);
        background:radial-gradient(circle,rgba(245,221,176,.18),transparent 70%);
    }
    .lp-gallery-frame{position:relative;}
    .lp-gallery-label{
        text-align:center;color:var(--lp-mock-gold);text-transform:uppercase;letter-spacing:.14em;
        font-size:.78rem;font-weight:800;margin-bottom:12px;
    }
    .lp-gallery-label::before,.lp-gallery-label::after{
        content:"";display:inline-block;vertical-align:middle;width:120px;height:1px;
        background:linear-gradient(90deg,transparent,rgba(207,167,91,.52));margin:0 10px;
    }
    .lp-gallery-nav{
        position:absolute;top:50%;transform:translateY(-50%);
        width:36px;height:36px;border-radius:999px;border:1px solid rgba(207,167,91,.46);
        background:rgba(6,12,19,.86);color:#f0d7a2;font-size:1.2rem;line-height:1;
        display:flex;align-items:center;justify-content:center;
    }
    .lp-gallery-nav.left{left:-18px;}
    .lp-gallery-nav.right{right:-18px;}
    .lp-dots{display:flex;justify-content:center;gap:8px;margin-top:10px;}
    .lp-dots span{width:8px;height:8px;border-radius:999px;background:rgba(255,255,255,.3);}
    .lp-dots span.active{background:#f0d7a2;}
    .lp-map-info-shell{display:grid;grid-template-columns:1.15fr 1fr;gap:12px;}
    .lp-map-info-shell .lp-map-wrap,.lp-map-info-shell .lp-info-grid{height:100%;}
    .lp-testimonials-shell{position:relative;}
    .lp-testimonials-shell .lp-gallery-nav{top:44%;}
    .lp-testimonial-item.is-hidden{display:none;}
    .lp-services-wrap{
        margin:0 0 14px;
        padding:22px;
        border-radius:16px;
        border:1px solid var(--lp-mock-border);
        background:linear-gradient(165deg,#06101a,#081522);
        box-shadow:0 14px 34px rgba(0,0,0,.34);
        position:relative;
        overflow:hidden;
    }
    .lp-services-wrap::before{
        content:"";
        position:absolute;
        top:0;left:0;right:0;height:2px;
        background:linear-gradient(90deg,transparent,rgba(240,215,162,.76),transparent);
    }
    .lp-services-wrap::after{
        content:"";
        position:absolute;
        width:220px;height:220px;right:-70px;top:-90px;
        background:radial-gradient(circle, rgba(207,167,91,.18), transparent 65%);
        pointer-events:none;
    }
    .lp-services-head{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:12px;
        margin-bottom:18px;
        padding-bottom:12px;
        border-bottom:1px solid rgba(207,167,91,.2);
    }
    .lp-services-title{
        margin:0;
        color:#f8fafc;
        font-family:'Playfair Display','Times New Roman',serif;
        font-size:clamp(1.45rem,2vw,2rem);
    }
    .lp-services-kicker{
        margin:0;
        color:var(--lp-mock-gold);
        font-size:.78rem;
        text-transform:uppercase;
        letter-spacing:.14em;
        font-weight:800;
    }
    .lp-services-grid{
        display:grid;
        grid-template-columns:repeat(2,minmax(0,1fr));
        gap:12px;
    }
    .lp-service-item{
        border:1px solid rgba(207,167,91,.24);
        border-radius:14px;
        background:linear-gradient(160deg,rgba(8,15,23,.86),rgba(8,14,20,.66));
        padding:16px 16px 16px 52px;
        position:relative;
        transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }
    .lp-service-item::after{
        content:attr(data-service-icon);
        position:absolute;
        left:16px;
        top:18px;
        width:24px;
        height:24px;
        border-radius:999px;
        border:1px solid rgba(240,215,162,.52);
        background:radial-gradient(circle at 35% 30%, rgba(240,215,162,.45), rgba(194,147,67,.12));
        box-shadow:inset 0 0 0 1px rgba(255,240,203,.24);
        display:flex;
        align-items:center;
        justify-content:center;
        color:#f7ddb0;
        font-size:.76rem;
        line-height:1;
    }
    .lp-service-item::before{
        content:"";
        position:absolute;
        top:0;left:0;right:0;height:1px;
        background:linear-gradient(90deg,rgba(240,215,162,.22),transparent);
    }
    .lp-service-item:nth-child(odd){transform:translateY(-2px);}
    .lp-service-item:nth-child(even){transform:translateY(2px);}
    .lp-service-item:hover{
        transform:translateY(-3px);
        border-color:rgba(240,215,162,.44);
        box-shadow:0 16px 30px rgba(0,0,0,.38);
    }
    .lp-service-number{
        color:var(--lp-mock-gold-soft);
        font-weight:800;
        font-size:.78rem;
        letter-spacing:.09em;
    }
    .lp-service-name{
        margin:6px 0 8px;
        color:#fff;
        font-size:1.02rem;
        font-weight:800;
    }
    .lp-service-copy{
        margin:0 0 12px;
        color:#d5dee6;
        line-height:1.72;
        font-size:.94rem;
    }
    .lp-service-cta{
        text-decoration:none;
        color:var(--lp-mock-gold-soft);
        text-transform:uppercase;
        letter-spacing:.08em;
        font-size:.76rem;
        font-weight:800;
    }
    .lp-service-cta:hover{color:#fff2d2;}
    .lp-service-name::after{
        content:"";
        display:block;
        width:42px;
        height:1px;
        margin-top:6px;
        background:linear-gradient(90deg,rgba(240,215,162,.62),transparent);
    }
    .lp-block{grid-column:span 12;}
    .lp-block-map,.lp-block-info{grid-column:span 6;}
    .lp-block-images,.lp-block-testimonials,.lp-block-text,.lp-block-links,.lp-block-image{grid-column:span 12;}
    .lp-content{color:#d6dfe7;}
    .lp-content h2,.lp-content h3{
        color:#f7fafc;
        font-size:clamp(1.6rem,2.2vw,2.15rem);
        margin-bottom:10px;
        text-wrap:balance;
    }
    .lp-content h2{
        position:relative;
        padding-left:14px;
    }
    .lp-content h2::before{
        content:"";
        position:absolute;
        left:0;top:.25em;bottom:.25em;width:2px;
        background:linear-gradient(180deg,rgba(240,215,162,.72),rgba(240,215,162,.12));
        border-radius:999px;
    }
    .lp-content ul{padding-left:1.1rem;}
    .lp-content li{margin-bottom:.48rem;}
    .lp-block-title{
        color:var(--lp-mock-gold)!important;
        text-transform:uppercase;
        letter-spacing:.12em;
        font-size:.84rem;
        font-family:'Manrope',system-ui,sans-serif;
        margin-bottom:14px!important;
        display:flex;
        align-items:center;
        gap:10px;
    }
    .lp-block-title::before{
        content:"✧";
        color:rgba(240,215,162,.88);
        font-size:.86rem;
    }
    .lp-block-title::after{
        content:"";
        height:1px;
        flex:1;
        background:linear-gradient(90deg,rgba(207,167,91,.52),transparent);
    }
    .lp-grid{gap:12px;}
    .lp-img{
        border-radius:14px;
        border:1px solid rgba(207,167,91,.22)!important;
        height:250px;
        transition:transform .35s ease, box-shadow .35s ease, border-color .35s ease;
    }
    .lp-img:hover{
        transform:translateY(-3px) scale(1.01);
        border-color:rgba(240,215,162,.52)!important;
        box-shadow:0 20px 38px rgba(0,0,0,.45);
    }
    .lp-info-grid{gap:0;border:1px solid var(--lp-mock-border);border-radius:14px;overflow:hidden;}
    .lp-info{
        border:0!important;
        border-right:1px solid rgba(207,167,91,.22)!important;
        border-bottom:1px solid rgba(207,167,91,.18)!important;
        border-radius:0!important;
        background:rgba(5,11,18,.58)!important;
        min-height:102px;
        display:flex;
        flex-direction:column;
        justify-content:center;
    }
    .lp-info .k{color:var(--lp-mock-gold-soft)!important;font-size:.72rem;}
    .lp-info .v{color:#f4f8fb!important;font-weight:800;}
    .lp-map-canvas{
        border-radius:14px;
        border:1px solid var(--lp-mock-border)!important;
        filter:saturate(1.05) brightness(.86);
    }
    .lp-testimonial-grid{gap:12px;}
    .lp-testimonial-item{
        background:rgba(6,12,18,.82)!important;
        border:1px solid rgba(207,167,91,.34)!important;
        border-radius:16px!important;
        position:relative;
    }
    .lp-testimonial-item::before{
        content:"“";
        position:absolute;
        top:8px;left:12px;
        font-size:2rem;
        line-height:1;
        color:rgba(240,215,162,.44);
        font-family:'Playfair Display','Times New Roman',serif;
    }
    .lp-testimonial-quote{color:#dfe7ef!important;font-size:.99rem;padding-top:14px;}
    .lp-testimonial-name{color:#fff!important;font-size:1.03rem;}
    .lp-testimonial-role{color:var(--lp-mock-gold)!important;}
    .lp-faq .accordion-item{
        border:1px solid var(--lp-mock-border)!important;
        background:rgba(6,12,18,.76)!important;
        backdrop-filter:blur(3px);
    }
    .lp-faq .accordion-button{
        background:rgba(8,14,20,.84)!important;
        color:#f0f5f9!important;
        border:none;
    }
    .lp-faq .accordion-button:not(.collapsed){
        background:linear-gradient(135deg,rgba(207,167,91,.24),rgba(207,167,91,.08))!important;
        color:#f5e1b6!important;
    }
    .lp-faq .accordion-body{background:rgba(5,10,16,.92)!important;color:#d8e1e9!important;}
    .lp-faq .accordion-button:focus{box-shadow:0 0 0 .14rem rgba(207,167,91,.28)!important;}
    .lp-faq .accordion-button::after{
        filter:brightness(1.2) sepia(1) hue-rotate(340deg) saturate(2.4);
    }
    @media (prefers-reduced-motion:no-preference){
        .lp-badge::before{animation:lpSpark 3.4s ease-in-out infinite;}
        .lp-services-kicker{animation:lpGlow 2.8s ease-in-out infinite;}
    }
    @keyframes lpSpark{
        0%,100%{opacity:.55;transform:translateY(-52%) scale(1);}
        50%{opacity:1;transform:translateY(-52%) scale(1.18);}
    }
    @keyframes lpGlow{
        0%,100%{text-shadow:0 0 0 rgba(240,215,162,0);}
        50%{text-shadow:0 0 12px rgba(240,215,162,.45);}
    }
    @media (max-width: 991px){
        .lp-hero{min-height:560px;}
        .lp-hero-inner{padding:48px 18px 56px;}
        .lp-title{font-size:clamp(2.1rem,8vw,3.35rem);}
        .lp-img{height:220px;}
        .lp-block-map,.lp-block-info{grid-column:span 12;}
        .lp-split-feature{grid-template-columns:1fr;}
        .lp-split-col + .lp-split-col{border-left:0;border-top:1px solid rgba(207,167,91,.24);}
        .lp-split-star{display:none;}
        .lp-map-info-shell{grid-template-columns:1fr;}
        .lp-gallery-nav.left{left:8px;}
        .lp-gallery-nav.right{right:8px;}
    }
    @media (max-width: 640px){
        .lp-hero{min-height:500px;}
        .lp-cta-row{gap:10px;}
        .lp-btn{width:100%;}
        .lp-chip{font-size:.76rem;}
        .lp-card{padding:18px;}
        .lp-info{min-height:86px;}
        .lp-img{height:200px;}
        .lp-services-grid{grid-template-columns:1fr;}
        .lp-service-item:nth-child(odd),
        .lp-service-item:nth-child(even){transform:none;}
    }
</style>

<main class="lp-wrap">
    <section class="lp-hero">
        <div class="lp-hero-inner">
            <nav class="lp-breadcrumbs" aria-label="Breadcrumb">
                <a href="/">Home</a>
                <span>/</span>
                <a href="/locations/">Locations</a>
                <span>/</span>
                <span>{{ page.city ?: page.title }}</span>
            </nav>
            <span class="lp-badge">VNV Events · {{ page.category ?: 'Location' }}</span>
            {% set heroDisplay = page.hero_title ?: page.title %}
            {% if page.city %}
                {% set cityStateText = page.city ~ (page.state ? ', ' ~ page.state : '') %}
                {% set heroDisplay = heroDisplay|replace({ (cityStateText): '<span class="lp-accent">' ~ cityStateText ~ '</span>' }) %}
            {% endif %}
            <h1 class="lp-title">{{ heroDisplay|raw }}</h1>
            <p class="lp-sub">{{ page.hero_subtitle ?: page.excerpt }}</p>
            <div class="lp-cta-row">
                <a href="#" data-vnv-open-request class="lp-btn lp-btn-gold">Request Your Event</a>
                <a href="tel:+13052045427" class="lp-btn lp-btn-ghost">Call (305) 204-5427</a>
            </div>
            <div class="lp-meta">
                {% if page.city %}<span class="lp-chip">{{ page.city }}</span>{% endif %}
                {% if page.county %}<span class="lp-chip">{{ page.county }}</span>{% endif %}
                {% if page.state %}<span class="lp-chip">{{ page.state }}</span>{% endif %}
            </div>
            {% if internal_links is defined and internal_links is not empty %}
                <nav class="lp-internal-links" aria-label="Related VNV Events links">
                    {% for link in internal_links|slice(0,5) %}
                        <a class="lp-chip" href="{{ link.url }}">{{ link.label }}</a>
                    {% endfor %}
                </nav>
            {% endif %}
        </div>
    </section>

    <section class="lp-section lp-white">
        <div class="lp-container">
            {% set fixedServices = [
                {'n':'01','icon':'✦','name':'Planner & Coordinator','copy':'Refined event planning and event-day coordination for weddings, social events and corporate functions.'},
                {'n':'02','icon':'✶','name':'Catering & Bartender','copy':'Gourmet food experiences, staffed service, drink planning and polished presentation for intimate or large events.'},
                {'n':'03','icon':'✿','name':'Décor & Floral Design','copy':'Floral arrangements, statement pieces and space styling designed to create a memorable visual impact.'},
                {'n':'04','icon':'♫','name':'DJ Services','copy':'Music direction and energy led by professionals with years of experience shaping celebrations and dance floors.'},
                {'n':'05','icon':'◉','name':'Photography & Videography','copy':'Photography and videography services that preserve the atmosphere, details and story behind every event.'},
                {'n':'06','icon':'◇','name':'Rentals','copy':'Tables, chairs, linens, tents and essential event pieces selected to support both aesthetics and functionality.'}
            ] %}
            <section class="lp-services-wrap">
                <div class="lp-services-head">
                    <p class="lp-services-kicker">What We Offer</p>
                    <h2 class="lp-services-title">Services We Offer</h2>
                </div>
                <div class="lp-services-grid">
                    {% for service in fixedServices %}
                        <article class="lp-service-item" data-service-icon="{{ service.icon }}">
                            <div class="lp-service-number">{{ service.n }}</div>
                            <h3 class="lp-service-name">{{ service.name }}</h3>
                            <p class="lp-service-copy">{{ service.copy }}</p>
                            <a href="#" data-vnv-open-request class="lp-service-cta">Request Service →</a>
                        </article>
                    {% endfor %}
                </div>
            </section>

            {% set whoBlock = null %}
            {% set offerBlock = null %}
            {% set galleryBlock = null %}
            {% set mapBlock = null %}
            {% set infoBlock = null %}
            {% set testimonialBlock = null %}
            {% set otherBlocks = [] %}

            {% for block in page.dynamic_blocks %}
                {% set blockType = block.type|default('text') %}
                {% if blockType == 'text' and whoBlock is null %}
                    {% set whoBlock = block %}
                {% elseif blockType == 'text' and offerBlock is null %}
                    {% set offerBlock = block %}
                {% elseif blockType == 'images' and galleryBlock is null %}
                    {% set galleryBlock = block %}
                {% elseif blockType == 'map' and mapBlock is null %}
                    {% set mapBlock = block %}
                {% elseif blockType == 'info' and infoBlock is null %}
                    {% set infoBlock = block %}
                {% elseif blockType == 'testimonials' and testimonialBlock is null %}
                    {% set testimonialBlock = block %}
                {% else %}
                    {% set otherBlocks = otherBlocks|merge([block]) %}
                {% endif %}
            {% endfor %}

            {% if whoBlock or offerBlock %}
                <div class="lp-card mb-4">
                    <div class="lp-split-feature">
                        <div class="lp-split-col">
                            <h3 class="lp-block-title mb-3">{{ whoBlock.title|default('Who We Are') }}</h3>
                            <div class="lp-content">{{ whoBlock.content|default('')|raw }}</div>
                        </div>
                        <div class="lp-split-col">
                            <h3 class="lp-block-title mb-3">{{ offerBlock.title|default('What We Offer in This Location') }}</h3>
                            <div class="lp-content">{{ offerBlock.content|default('')|raw }}</div>
                        </div>
                        <span class="lp-split-star">✶</span>
                    </div>
                </div>
            {% endif %}

            {% if galleryBlock %}
                {% set images = galleryBlock.images|default([]) %}
                {% if images is empty and galleryBlock.image_url %}
                    {% set images = [{ 'url': galleryBlock.image_url, 'alt': galleryBlock.title ?: page.title }] %}
                {% endif %}
                <div class="lp-card mb-4 lp-gallery-frame">
                    <div class="lp-gallery-label">{{ galleryBlock.title|default('Unforgettable Moments') }}</div>
                    <button type="button" class="lp-gallery-nav left" aria-label="Previous">‹</button>
                    <button type="button" class="lp-gallery-nav right" aria-label="Next">›</button>
                    <div class="lp-grid cols-3">
                        {% for image in images|slice(0,3) %}
                            <img class="lp-img lp-img-zoomable" src="{{ image.url|default(image) }}" alt="{{ image.alt|default(page.title) }}">
                        {% endfor %}
                    </div>
                    <div class="lp-dots"><span class="active"></span><span></span><span></span><span></span></div>
                </div>
            {% endif %}

            {% if mapBlock or infoBlock %}
                <div class="lp-card mb-4">
                    <div class="lp-map-info-shell">
                        <div class="lp-map-wrap">
                            <div class="lp-map-canvas"
                                 data-map
                                 data-lat="{{ mapBlock.lat|default('') }}"
                                 data-lng="{{ mapBlock.lng|default('') }}"
                                 data-address="{{ mapBlock.address|default(page.city ~ ', ' ~ page.state) }}"></div>
                        </div>
                        <div>
                            {% set items = infoBlock.items|default([]) %}
                            <div class="lp-info-grid">
                                {% for item in items %}
                                    <div class="lp-info">
                                        <div class="k">{{ item.label|default('Info') }}</div>
                                        <div class="v">{{ item.value|default('') }}</div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if testimonialBlock and testimonialBlock.enabled|default(true) %}
                {% set testimonials = testimonialBlock.items|default([]) %}
                {% set testimonialFallback = [
                    {'quote':'VNV Events made our wedding weekend look and feel like a luxury production.','name':'Sofia M.','role':'Bride'},
                    {'quote':'From timeline to guest experience, every detail felt intentional and elegant.','name':'Carla R.','role':'Corporate Client'},
                    {'quote':'Professional team, impeccable execution, and a truly glamorous setup.','name':'Alyssa D.','role':'Private Event Host'},
                    {'quote':'Their team transformed our venue into a refined, unforgettable experience for guests.','name':'Mariana L.','role':'Social Event Host'},
                    {'quote':'Planning felt effortless. Every milestone was organized, elegant and right on time.','name':'Daniel K.','role':'Groom'},
                    {'quote':'Exceptional communication and flawless production from concept to final toast.','name':'Vanessa T.','role':'Brand Manager'}
                ] %}
                {% if testimonials|length < 6 %}
                    {% set testimonials = testimonialFallback %}
                {% endif %}
                <div class="lp-card mb-4 lp-testimonials-shell">
                    <h3 class="lp-block-title mb-3">{{ testimonialBlock.title|default('What Our Clients Say') }}</h3>
                    <button type="button" class="lp-gallery-nav left js-testimonial-prev" aria-label="Previous">‹</button>
                    <button type="button" class="lp-gallery-nav right js-testimonial-next" aria-label="Next">›</button>
                    <div class="lp-testimonial-grid js-testimonial-carousel">
                        {% for t in testimonials|slice(0,8) %}
                            <article class="lp-testimonial-item js-testimonial-item">
                                <p class="lp-testimonial-quote">"{{ t.quote|default(t.content|default(t.value|default('Exceptional experience with VNV Events.'))) }}"</p>
                                <div class="lp-testimonial-name">{{ t.name|default('VNV Events Client') }}</div>
                                {% if t.role|default('') %}<div class="lp-testimonial-role">{{ t.role }}</div>{% endif %}
                            </article>
                        {% endfor %}
                    </div>
                    <div class="lp-dots js-testimonial-dots"></div>
                </div>
            {% endif %}

            {% if page.content_long %}
                <div class="lp-card lp-content mb-4">{{ page.content_long|raw }}</div>
            {% endif %}

            {% if otherBlocks is not empty %}
                <div class="lp-dynamic-layout">
                {% for block in otherBlocks %}
                    {% set blockType = block.type|default('text') %}
                    <div class="lp-card lp-block lp-block-{{ blockType }} mb-0">
                        {% if block.title %}<h3 class="lp-block-title mb-3">{{ block.title }}</h3>{% endif %}
                        {% if blockType == 'text' %}
                            <div class="lp-content">{{ block.content|default('')|raw }}</div>
                        {% endif %}
                        {% if blockType == 'image' and block.image_url %}
                            <img class="lp-img lp-img-zoomable" src="{{ block.image_url }}" alt="{{ block.title ?: page.title }}">
                        {% endif %}
                        {% if blockType == 'links' %}
                            {% set links = block.links|default([]) %}
                            <div class="lp-link-list">
                                {% for l in links %}
                                    <a class="lp-link-item" href="{{ l.url|default('#') }}" {% if l.new_tab %}target="_blank"{% endif %}>
                                        <span>{{ l.label|default(l.url|default('Open')) }}</span><span>→</span>
                                    </a>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
                </div>
            {% endif %}

            {% if page.faqs is not empty %}
                <div class="lp-card lp-faq">
                    <h3 class="lp-block-title mb-3">Frequently Asked Questions</h3>
                    <div class="accordion" id="locationFaqAccordion">
                        {% for faq in page.faqs %}
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="faqHeading{{ loop.index }}">
                                    <button class="accordion-button {{ not loop.first ? 'collapsed' : '' }}"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#faqCollapse{{ loop.index }}">
                                        {{ faq.question ?? '' }}
                                    </button>
                                </h2>
                                <div id="faqCollapse{{ loop.index }}"
                                     class="accordion-collapse collapse {{ loop.first ? 'show' : '' }}"
                                     data-bs-parent="#locationFaqAccordion">
                                    <div class="accordion-body">{{ faq.answer ?? '' }}</div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if nearby_pages is defined and nearby_pages is not empty %}
                <div class="lp-card mt-4">
                    <h3 class="lp-block-title mb-3">Nearby Service Areas</h3>
                    <div class="lp-link-list">
                        {% for nearby in nearby_pages %}
                            <a class="lp-link-item" href="/locations/{{ nearby.slug }}/">
                                <span>{{ nearby.city ?: nearby.title }}</span><span>→</span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
        </div>
    </section>
</main>

<div class="lp-lightbox-overlay" id="lpLightbox" aria-hidden="true">
    <div class="lp-lightbox-dialog">
        <button type="button" class="lp-lightbox-close" id="lpLightboxClose" aria-label="Close image">✕</button>
        <img src="" alt="" class="lp-lightbox-image" id="lpLightboxImage">
    </div>
</div>

