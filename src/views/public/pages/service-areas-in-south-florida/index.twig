{% extends "templates/base.twig" %}

{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&display=swap" rel="stylesheet">

<style>
:root{
    --vnv-primary:#5EC6C4;
    --vnv-primary-dark:#4aa8a6;
    --vnv-gold:#c5a059;
    --vnv-gold-gradient:linear-gradient(135deg,#bf953f 0%,#fcf6ba 45%,#b38728 100%);
    --vnv-dark-deep:#0a0c0c;
    --vnv-dark-soft:#141818;
    --vnv-dark-card:#151b1c;
    --vnv-light:#ffffff;
    --vnv-marble:#f4f7f8;
    --vnv-text-dark:#11181a;
    --vnv-text-light:#f3f5f6;
    --vnv-text-muted:rgba(255,255,255,.72);
    --vnv-border:rgba(255,255,255,.08);
    --vnv-shadow:0 25px 70px rgba(0,0,0,.14);
}

body{
    background:var(--vnv-dark-deep);
    color:var(--vnv-text-light);
    font-family:'Plus Jakarta Sans',sans-serif;
    line-height:1.8;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
}

h1,h2,h3,h4,h5,.luxury-font{
    font-family:'Playfair Display',serif;
}

.text-vnv{ color:var(--vnv-primary)!important; }

.text-gold{
    background:var(--vnv-gold-gradient);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
}

.section-vnv{
    padding:110px 0;
    position:relative;
}

.vnv-badge{
    display:inline-flex;
    align-items:center;
    gap:10px;
    padding:10px 18px;
    border-radius:999px;
    background:rgba(94,198,196,.1);
    color:var(--vnv-primary);
    font-size:.74rem;
    letter-spacing:2px;
    font-weight:800;
    text-transform:uppercase;
}

.vnv-btn{
    padding:18px 30px;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:2px;
    transition:all .35s ease;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    text-decoration:none;
    border:none;
    cursor:pointer;
    font-size:.78rem;
    border-radius:999px;
}

.btn-gold-vnv{
    background:var(--vnv-gold-gradient);
    color:#000!important;
}
.btn-gold-vnv:hover{
    transform:translateY(-3px);
    box-shadow:0 20px 40px rgba(197,160,89,.22);
}

.btn-outline-vnv{
    border:2px solid var(--vnv-primary);
    color:var(--vnv-primary)!important;
    background:transparent;
}
.btn-outline-vnv:hover{
    background:var(--vnv-primary);
    color:#fff!important;
}

.hero-service-areas{
    position:relative;
    min-height:72vh;
    display:flex;
    align-items:center;
    overflow:hidden;
    background:
        linear-gradient(90deg, rgba(10,12,12,.90) 0%, rgba(10,12,12,.70) 44%, rgba(10,12,12,.42) 100%),
        url('{{ asset_for('assets/images/service-areas-hero.jpg') }}') center/cover no-repeat;
}

.hero-service-areas::after{
    content:"";
    position:absolute;
    inset:0;
    background:
        radial-gradient(circle at top right, rgba(94,198,196,.14), transparent 28%),
        radial-gradient(circle at bottom left, rgba(197,160,89,.10), transparent 24%);
    pointer-events:none;
}

.hero-service-areas-inner{
    position:relative;
    z-index:2;
    width:100%;
}

.hero-service-areas h1{
    font-size:clamp(3rem,6vw,5.3rem);
    line-height:1.02;
    margin:20px 0 24px;
    max-width:980px;
}

.hero-service-areas p{
    font-size:1.08rem;
    color:var(--vnv-text-muted);
    max-width:820px;
    margin-bottom:18px;
}

.hero-service-areas-actions{
    display:flex;
    flex-wrap:wrap;
    gap:16px;
    margin-top:24px;
}

.section-white{
    background:var(--vnv-marble);
    color:var(--vnv-text-dark);
}

.service-areas-intro{
    text-align:center;
    max-width:980px;
    margin:0 auto 50px;
}

.service-areas-intro h2{
    font-size:clamp(2.2rem,4vw,3.5rem);
    line-height:1.06;
    margin:18px 0 18px;
    color:#101819;
}

.service-areas-intro p{
    color:#5b676b;
    font-size:1.02rem;
    margin:0 auto;
    max-width:780px;
}

.service-areas-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:24px;
}

.county-card{
    background:linear-gradient(145deg, #141a1b 0%, #0c1011 100%);
    border:1px solid rgba(255,255,255,.06);
    border-radius:28px;
    padding:26px;
    box-shadow:0 24px 60px rgba(0,0,0,.16);
    color:#fff;
}

.county-card-header{
    display:flex;
    align-items:flex-start;
    justify-content:space-between;
    gap:14px;
    margin-bottom:18px;
}

.county-card-icon{
    width:54px;
    height:54px;
    border-radius:18px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(94,198,196,.12);
    color:var(--vnv-primary);
    font-size:1.2rem;
    flex-shrink:0;
}

.county-card h3{
    font-size:1.8rem;
    margin:0 0 6px;
    color:#fff;
    line-height:1.08;
}

.county-card-sub{
    color:rgba(255,255,255,.60);
    font-size:.86rem;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:1.5px;
}

.county-card p{
    color:rgba(255,255,255,.72);
    margin:0 0 18px;
    font-size:.95rem;
    line-height:1.7;
}

.location-cloud{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
}

.location-pill{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:10px 14px;
    border-radius:999px;
    background:rgba(255,255,255,.05);
    border:1px solid rgba(255,255,255,.07);
    color:#fff !important;
    text-decoration:none !important;
    font-size:.88rem;
    line-height:1.2;
    transition:all .25s ease;
}

.location-pill:hover{
    transform:translateY(-2px);
    border-color:rgba(94,198,196,.34);
    background:rgba(94,198,196,.12);
    color:#5EC6C4 !important;
}

.service-areas-cta{
    margin-top:42px;
    display:flex;
    justify-content:center;
    gap:16px;
    flex-wrap:wrap;
}

.quick-jump-wrap{
    margin-top:34px;
    padding:18px 20px;
    background:#fff;
    border:1px solid rgba(17,24,26,.08);
    border-radius:22px;
    box-shadow:0 16px 40px rgba(0,0,0,.05);
}

.quick-jump-title{
    margin:0 0 10px;
    color:#122022;
    font-weight:800;
    font-size:.9rem;
    text-transform:uppercase;
    letter-spacing:1.6px;
}

.quick-jump-links{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
}

.quick-jump-links a{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:10px 14px;
    border-radius:999px;
    background:rgba(94,198,196,.10);
    color:#1d5151;
    text-decoration:none;
    font-weight:800;
    font-size:.86rem;
}

.quick-jump-links a:hover{
    background:#5EC6C4;
    color:#0a0c0c;
}

@media (max-width: 1199px){
    .service-areas-grid{
        grid-template-columns:1fr;
    }
}

@media (max-width: 767px){
    .section-vnv{
        padding:90px 0;
    }

    .hero-service-areas h1{
        font-size:2.7rem;
    }

    .hero-service-areas-actions{
        flex-direction:column;
    }

    .vnv-btn{
        width:100%;
    }

    .county-card{
        padding:20px;
        border-radius:22px;
    }

    .county-card h3{
        font-size:1.45rem;
    }
}
</style>
{% endblock %}

