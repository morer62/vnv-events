{% extends "templates/base.twig" %}

{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&display=swap" rel="stylesheet">

<style>
:root{
    --vnv-primary:#5EC6C4;
    --vnv-primary-dark:#4aa8a6;
    --vnv-gold:#c5a059;
    --vnv-gold-gradient:linear-gradient(135deg,#bf953f 0%,#fcf6ba 45%,#b38728 100%);
    --vnv-dark-deep:#0a0c0c;
    --vnv-dark-soft:#141818;
    --vnv-dark-card:#1b2021;
    --vnv-light:#ffffff;
    --vnv-marble:#f4f7f8;
    --vnv-text-dark:#11181a;
    --vnv-text-light:#f3f5f6;
    --vnv-text-muted:rgba(255,255,255,.72);
    --vnv-text-muted-soft:rgba(255,255,255,.58);
    --vnv-border:rgba(255,255,255,.08);
    --vnv-shadow:0 25px 70px rgba(0,0,0,.14);
}

html { scroll-behavior:smooth; }

body{
    background:var(--vnv-dark-deep);
    color:var(--vnv-text-light);
    font-family:'Plus Jakarta Sans',sans-serif;
    line-height:1.8;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
}

h1,h2,h3,h4,h5,.luxury-font{
    font-family:'Playfair Display',serif;
}

.text-vnv{ color:var(--vnv-primary)!important; }

.text-gold{
    background:var(--vnv-gold-gradient);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
}

.vnv-btn{
    padding:18px 30px;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:2px;
    transition:all .35s ease;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    text-decoration:none;
    border:none;
    cursor:pointer;
    font-size:.78rem;
    border-radius:999px;
}

.btn-gold-vnv{
    background:var(--vnv-gold-gradient);
    color:#000!important;
}
.btn-gold-vnv:hover{
    transform:translateY(-3px);
    box-shadow:0 20px 40px rgba(197,160,89,.22);
}

.btn-outline-vnv{
    border:2px solid var(--vnv-primary);
    color:var(--vnv-primary)!important;
    background:transparent;
}
.btn-outline-vnv:hover{
    background:var(--vnv-primary);
    color:#fff!important;
}

.section-vnv{
    padding:120px 0;
    position:relative;
}

.vnv-badge{
    display:inline-flex;
    align-items:center;
    gap:10px;
    padding:10px 18px;
    border-radius:999px;
    background:rgba(94,198,196,.1);
    color:var(--vnv-primary);
    font-size:.74rem;
    letter-spacing:2px;
    font-weight:800;
    text-transform:uppercase;
}

.hero-tool{
    position:relative;
    min-height:82vh;
    display:flex;
    align-items:center;
    overflow:hidden;
    background:
        linear-gradient(90deg, rgba(10,12,12,.90) 0%, rgba(10,12,12,.66) 44%, rgba(10,12,12,.38) 100%),
        url('{{ asset_for('assets/images/tool-food-calculator-hero.jpg') }}') center/cover no-repeat;
}

.hero-tool::after{
    content:"";
    position:absolute;
    inset:0;
    background:
        radial-gradient(circle at top right, rgba(94,198,196,.16), transparent 28%),
        radial-gradient(circle at bottom left, rgba(197,160,89,.10), transparent 24%);
    pointer-events:none;
}

.hero-tool-inner{
    position:relative;
    z-index:2;
    width:100%;
}

.hero-tool h1{
    font-size:clamp(3rem,6vw,5.4rem);
    line-height:1.02;
    margin:20px 0 28px;
    max-width:980px;
}

.hero-tool p.hero-copy{
    font-size:1.08rem;
    color:var(--vnv-text-muted);
    max-width:820px;
    margin-bottom:22px;
}

.hero-cta-row{
    display:flex;
    flex-wrap:wrap;
    gap:16px;
    margin-top:24px;
}

.section-white{
    background:var(--vnv-marble);
    color:var(--vnv-text-dark);
}

.tool-shell{
    background:linear-gradient(145deg, #151a1b 0%, #0c0f10 100%);
    border-radius:34px;
    border:1px solid rgba(255,255,255,.06);
    box-shadow:0 26px 80px rgba(0,0,0,.22);
    overflow:hidden;
}

.tool-topbar{
    padding:18px 22px;
    background:#0c0f10;
    border-bottom:1px solid rgba(255,255,255,.06);
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:16px;
    flex-wrap:wrap;
}

.tool-topbar-left{
    display:flex;
    align-items:center;
    gap:14px;
}

.tool-topbar-icon{
    width:46px;
    height:46px;
    border-radius:14px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(94,198,196,.12);
    color:var(--vnv-primary);
    font-size:1.15rem;
}

.tool-topbar-title{
    color:#fff;
    font-weight:800;
    font-size:1rem;
    line-height:1.2;
}

.tool-topbar-sub{
    color:var(--vnv-text-muted-soft);
    font-size:.8rem;
    font-weight:700;
}

.tool-topbar-note{
    color:rgba(255,255,255,.62);
    font-size:.88rem;
    font-weight:700;
}

.tool-body{
    padding:28px;
}

.tool-grid{
    display:grid;
    grid-template-columns: 430px 1fr;
    gap:24px;
    align-items:start;
}

.tool-panel{
    background:#f7f9fa;
    border:1px solid rgba(17,24,26,.08);
    border-radius:26px;
    padding:22px;
    box-shadow:0 18px 50px rgba(0,0,0,.06);
    color:#122022;
}

.tool-panel h3{
    font-family:'Plus Jakarta Sans',sans-serif;
    margin:0 0 18px;
    font-size:1.05rem;
    font-weight:800;
    color:#122022;
    letter-spacing:.3px;
}

.tool-field{
    margin-bottom:16px;
}

.tool-field label{
    display:block;
    font-size:.84rem;
    font-weight:800;
    color:#2c3a3d;
    margin-bottom:8px;
    text-transform:uppercase;
    letter-spacing:1px;
}

.tool-field input,
.tool-field select{
    width:100%;
    border:1px solid rgba(17,24,26,.12);
    background:#fff;
    border-radius:14px;
    outline:none;
    padding:14px 14px;
    font-size:1rem;
    color:#122022;
    font-family:'Plus Jakarta Sans',sans-serif;
}

.tool-inline-2{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
}

.tool-inline-3{
    display:grid;
    grid-template-columns:1fr 1fr 1fr;
    gap:14px;
}

.tool-actions{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
    margin-top:10px;
}

.tool-btn{
    border:none;
    outline:none;
    cursor:pointer;
    border-radius:14px;
    padding:14px 16px;
    font-weight:800;
    font-size:.88rem;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    transition:all .25s ease;
}

.tool-btn.primary{
    background:linear-gradient(135deg, #c0006b 0%, #e00087 100%);
    color:#fff;
}

.tool-btn.secondary{
    background:#11181a;
    color:#fff;
}

.tool-btn.accent{
    background:rgba(94,198,196,.12);
    color:#133133;
}

.tool-btn:hover{
    transform:translateY(-2px);
}

.tool-helper{
    margin-top:16px;
    background:#fff;
    border:1px solid rgba(17,24,26,.08);
    border-radius:18px;
    padding:16px;
    font-size:.92rem;
    color:#4e5c5f;
    line-height:1.65;
}

.tool-results{
    display:grid;
    gap:22px;
}

.result-card{
    background:linear-gradient(145deg, rgba(28,34,35,0.96) 0%, rgba(15,18,19,0.98) 100%);
    border:1px solid rgba(255,255,255,.06);
    border-radius:26px;
    padding:24px;
    box-shadow:0 24px 60px rgba(0,0,0,.18);
}

.result-card h3{
    font-size:1.45rem;
    color:#fff;
    margin:0 0 14px;
}

.result-card p{
    color:var(--vnv-text-muted);
    margin:0 0 14px;
}

.result-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:14px;
    margin-top:14px;
}

.result-stat{
    background:rgba(255,255,255,.04);
    border:1px solid rgba(255,255,255,.06);
    border-radius:18px;
    padding:16px 14px;
}

.result-stat-label{
    color:rgba(255,255,255,.58);
    font-size:.72rem;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:1.4px;
    margin-bottom:6px;
}

.result-stat-value{
    color:#fff;
    font-size:1.22rem;
    font-weight:800;
    line-height:1.25;
}

.ingredient-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:14px;
    margin-top:14px;
}

.ingredient-card{
    background:rgba(255,255,255,.04);
    border:1px solid rgba(255,255,255,.06);
    border-radius:18px;
    padding:16px 14px;
}

.ingredient-card h4{
    font-family:'Plus Jakarta Sans',sans-serif;
    color:#fff;
    margin:0 0 8px;
    font-size:1rem;
    font-weight:800;
}

.ingredient-card p{
    margin:0;
    color:var(--vnv-text-muted);
    font-size:.92rem;
    line-height:1.6;
}

.muted-note{
    margin-top:16px;
    color:rgba(255,255,255,.52);
    font-size:.84rem;
    line-height:1.6;
}

.empty-state{
    min-height:520px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:30px;
    background:linear-gradient(145deg, rgba(28,34,35,0.96) 0%, rgba(15,18,19,0.98) 100%);
    border:1px solid rgba(255,255,255,.06);
    border-radius:26px;
    color:var(--vnv-text-muted);
}

.empty-state-inner{
    max-width:460px;
}

.empty-state-icon{
    width:72px;
    height:72px;
    margin:0 auto 18px;
    border-radius:22px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(94,198,196,.10);
    color:var(--vnv-primary);
    font-size:1.5rem;
}

.tool-bento-card{
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    gap:18px;
    min-height:220px;
    padding:22px;
    border-radius:24px;
    background:linear-gradient(145deg, rgba(28,34,35,0.96) 0%, rgba(15,18,19,0.98) 100%);
    border:1px solid rgba(255,255,255,.06);
    box-shadow:0 24px 60px rgba(0,0,0,.18);
    text-decoration:none;
    color:#fff !important;
    transition:all .28s ease;
    margin-top:22px;
}

.tool-bento-card:hover{
    transform:translateY(-4px);
    border-color:rgba(94,198,196,.24);
    box-shadow:0 28px 70px rgba(0,0,0,.24);
    text-decoration:none;
}

.tool-bento-card.small{
    min-height:200px;
}

.tool-bento-top{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    margin-bottom:16px;
}

.tool-bento-icon{
    width:52px;
    height:52px;
    border-radius:16px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(94,198,196,.12);
    color:#5EC6C4;
    font-size:1.2rem;
    flex-shrink:0;
}

.tool-bento-badge{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:8px 14px;
    border-radius:999px;
    background:rgba(94,198,196,.10);
    color:#5EC6C4;
    font-size:.72rem;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:1.2px;
    white-space:nowrap;
}

.tool-bento-card h3{
    margin:0 0 10px;
    color:#fff !important;
    font-size:1.4rem;
    line-height:1.15;
}

.tool-bento-card p{
    margin:0;
    color:rgba(255,255,255,.72) !important;
    font-size:.96rem;
    line-height:1.65;
}

.tool-bento-footer{
    margin-top:auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:14px;
    padding-top:8px;
    color:#fff;
    font-weight:800;
    font-size:.9rem;
}

.tool-bento-arrow{
    width:40px;
    height:40px;
    border-radius:999px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(255,255,255,.06);
    color:#fff;
    transition:all .25s ease;
}

.tool-bento-card:hover .tool-bento-arrow{
    background:#5EC6C4;
    color:#0a0c0c;
}

@media (max-width: 1199px){
    .tool-grid{
        grid-template-columns: 1fr;
    }
}

@media (max-width: 767px){
    .section-vnv{
        padding:90px 0;
    }

    .hero-tool h1{
        font-size:2.7rem;
    }

    .vnv-btn{
        width:100%;
        padding:18px 24px;
        letter-spacing:2px;
    }

    .hero-cta-row{
        flex-direction:column;
    }

    .tool-body{
        padding:16px;
    }

    .tool-inline-2,
    .tool-inline-3,
    .result-grid,
    .ingredient-grid{
        grid-template-columns:1fr;
    }

    .tool-panel,
    .result-card{
        padding:18px;
    }

    .tool-bento-card{
        min-height:auto;
        padding:18px;
        border-radius:20px;
    }

    .tool-bento-card h3{
        font-size:1.2rem;
    }

    .tool-bento-card p{
        font-size:.92rem;
    }
}
</style>
{% endblock %}

{% block body %}

{% include "templates/layout/publicHeaderVnv.html.twig" %}

<section class="hero-tool">
    <div class="container hero-tool-inner">
        <span class="vnv-badge">Free Catering Planning Tool</span>

        <h1>Food Quantity & <span class="text-gold">Cost Calculator for Events</span></h1>

        <p class="hero-copy">
            Estimate appetizer counts, main meal portions, protein, sides, desserts and approximate food costs for weddings, private parties, birthdays, corporate events and venue celebrations.
        </p>

        <div class="hero-cta-row">
            <a href="#food-tool" class="vnv-btn btn-gold-vnv">Use the Calculator</a>
            <a href="#" data-vnv-open-request class="vnv-btn btn-outline-vnv">Need Catering Help?</a>
        </div>
    </div>
</section>

<section class="section-vnv section-white" id="food-tool">
    <div class="container">
        <div class="tool-shell">
            <div class="tool-topbar">
                <div class="tool-topbar-left">
                    <div class="tool-topbar-icon"><i class="fa-solid fa-utensils"></i></div>
                    <div>
                        <div class="tool-topbar-title">Complete Food Calculator for Events</div>
                        <div class="tool-topbar-sub">Quantities, portions, dessert count and estimated food cost</div>
                    </div>
                </div>

                <div class="tool-topbar-note">
                    Better for weddings, birthdays, corporate catering, backyard parties and venue planning
                </div>
            </div>

            <div class="tool-body">
                <div class="tool-grid">
                    <div class="tool-panel">
                        <h3>Plan Your Menu Quantities</h3>

                        <div class="tool-inline-2">
                            <div class="tool-field">
                                <label for="event-format">Event format</label>
                                <select id="event-format">
                                    <option value="light">Light Gathering</option>
                                    <option value="cocktail">Cocktail Reception</option>
                                    <option value="buffet">Buffet Meal</option>
                                    <option value="plated">Plated Dinner</option>
                                    <option value="heavyCocktail">Heavy Hors d’Oeuvres</option>
                                </select>
                            </div>

                            <div class="tool-field">
                                <label for="service-duration">Service duration</label>
                                <select id="service-duration">
                                    <option value="1.5">1.5 Hours</option>
                                    <option value="2" selected>2 Hours</option>
                                    <option value="3">3 Hours</option>
                                    <option value="4">4 Hours</option>
                                    <option value="5">5 Hours</option>
                                </select>
                            </div>
                        </div>

                        <div class="tool-inline-2">
                            <div class="tool-field">
                                <label for="adult-guests">Adult guests</label>
                                <input type="number" id="adult-guests" min="0" placeholder="e.g. 80">
                            </div>

                            <div class="tool-field">
                                <label for="child-guests">Children</label>
                                <input type="number" id="child-guests" min="0" value="0">
                            </div>
                        </div>

                        <div class="tool-inline-3">
                            <div class="tool-field">
                                <label for="child-factor">Child portion factor</label>
                                <select id="child-factor">
                                    <option value="0.4">40%</option>
                                    <option value="0.5" selected>50%</option>
                                    <option value="0.6">60%</option>
                                    <option value="0.75">75%</option>
                                </select>
                            </div>

                            <div class="tool-field">
                                <label for="buffer">Safety buffer</label>
                                <select id="buffer">
                                    <option value="0">0%</option>
                                    <option value="5">5%</option>
                                    <option value="10" selected>10%</option>
                                    <option value="15">15%</option>
                                </select>
                            </div>

                            <div class="tool-field">
                                <label for="dessert-style">Dessert style</label>
                                <select id="dessert-style">
                                    <option value="none">No Dessert</option>
                                    <option value="light">Light Dessert Table</option>
                                    <option value="standard" selected>Standard Dessert</option>
                                    <option value="premium">Premium Dessert Spread</option>
                                </select>
                            </div>
                        </div>

                        <h3 style="margin-top:28px;">Optional Cost Inputs</h3>

                        <div class="tool-inline-2">
                            <div class="tool-field">
                                <label for="appetizer-cost">Cost per appetizer piece</label>
                                <input type="number" id="appetizer-cost" min="0" step="0.01" placeholder="e.g. 2.50">
                            </div>

                            <div class="tool-field">
                                <label for="main-cost">Cost per main portion</label>
                                <input type="number" id="main-cost" min="0" step="0.01" placeholder="e.g. 18.00">
                            </div>
                        </div>

                        <div class="tool-inline-2">
                            <div class="tool-field">
                                <label for="dessert-cost">Cost per dessert serving</label>
                                <input type="number" id="dessert-cost" min="0" step="0.01" placeholder="e.g. 4.50">
                            </div>

                            <div class="tool-field">
                                <label for="extra-food-cost">Extra food line / misc.</label>
                                <input type="number" id="extra-food-cost" min="0" step="0.01" value="0" placeholder="0">
                            </div>
                        </div>

                        <div class="tool-actions">
                            <button type="button" class="tool-btn primary" id="calculate-btn">
                                <i class="fa-solid fa-calculator"></i>
                                Calculate
                            </button>

                            <button type="button" class="tool-btn secondary" id="reset-btn">
                                <i class="fa-solid fa-rotate-left"></i>
                                Reset
                            </button>
                        </div>

                        <div class="tool-helper">
                            This tool is best for early planning and quote building. It works especially well when you want a quick estimate for hors d’oeuvres, buffet meals, plated dinners, dessert count and overall food cost before finalizing the menu.
                        </div>
                    </div>

                    <div class="tool-results" id="tool-results">
                        <div class="empty-state">
                            <div class="empty-state-inner">
                                <div class="empty-state-icon"><i class="fa-solid fa-plate-wheat"></i></div>
                                <h3 style="font-size:1.7rem; color:#fff; margin-bottom:10px;">Your food estimate will appear here</h3>
                                <p style="margin:0;">
                                    Enter your guest count, event style and optional pricing to generate a more realistic quantity and cost estimate for your menu.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <a href="{{ path('bar-calculator-for-parties-and-venues') }}" class="tool-bento-card small">
                    <div>
                        <div class="tool-bento-top">
                            <div class="tool-bento-icon"><i class="fa-solid fa-martini-glass-citrus"></i></div>
                            <span class="tool-bento-badge">Staffing</span>
                        </div>

                        <h3>Bartender &amp; Server Calculator</h3>
                        <p>
                            Estimate how many bartenders, servers, barbacks and bar stations you may need based on guest count, bar type and food service style.
                        </p>
                    </div>

                    <div class="tool-bento-footer">
                        <span>Open Calculator</span>
                        <div class="tool-bento-arrow"><i class="fa-solid fa-arrow-right"></i></div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

{% include "templates/components/publicEventRequestModal.html.twig" with {
    request_form_action: "/api/public/event-request"
} %}

{% include "templates/layout/publicFooterVnv.html.twig" %}

{% endblock %}

{% block scripts %}
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"WebApplication",
  "name":"Food Quantity and Cost Calculator for Events",
  "applicationCategory":"BusinessApplication",
  "operatingSystem":"Web",
  "description":"A free web-based food calculator for events that estimates appetizer quantities, main portions, desserts and food cost.",
  "offers":{
    "@type":"Offer",
    "price":"0",
    "priceCurrency":"USD"
  }
}
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const eventFormat = document.getElementById('event-format');
    const serviceDuration = document.getElementById('service-duration');
    const adultGuests = document.getElementById('adult-guests');
    const childGuests = document.getElementById('child-guests');
    const childFactor = document.getElementById('child-factor');
    const buffer = document.getElementById('buffer');
    const dessertStyle = document.getElementById('dessert-style');

    const appetizerCost = document.getElementById('appetizer-cost');
    const mainCost = document.getElementById('main-cost');
    const dessertCost = document.getElementById('dessert-cost');
    const extraFoodCost = document.getElementById('extra-food-cost');

    const calculateBtn = document.getElementById('calculate-btn');
    const resetBtn = document.getElementById('reset-btn');
    const resultsWrap = document.getElementById('tool-results');

    function renderEmpty() {
        resultsWrap.innerHTML = `
            <div class="empty-state">
                <div class="empty-state-inner">
                    <div class="empty-state-icon"><i class="fa-solid fa-plate-wheat"></i></div>
                    <h3 style="font-size:1.7rem; color:#fff; margin-bottom:10px;">Your food estimate will appear here</h3>
                    <p style="margin:0;">
                        Enter your guest count, event style and optional pricing to generate a more realistic quantity and cost estimate for your menu.
                    </p>
                </div>
            </div>
        `;
    }

    function formatMoney(value) {
        return Number(value || 0).toLocaleString('en-US', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    }

    function roundUp(value) {
        return Math.ceil(value);
    }

    function getEffectiveGuestCount() {
        const adults = parseFloat(adultGuests.value || '0');
        const kids = parseFloat(childGuests.value || '0');
        const kidFactor = parseFloat(childFactor.value || '0.5');
        const base = adults + (kids * kidFactor);
        const bufferFactor = 1 + (parseFloat(buffer.value || '0') / 100);

        return {
            adults,
            kids,
            rawEquivalentGuests: base,
            adjustedEquivalentGuests: base * bufferFactor
        };
    }

    function getAppetizerPiecesPerPerson(format, duration) {
        duration = parseFloat(duration);

        if (format === 'light') {
            return duration <= 2 ? 4 : 5;
        }

        if (format === 'cocktail') {
            if (duration <= 2) return 6;
            if (duration <= 3) return 8;
            return 10;
        }

        if (format === 'heavyCocktail') {
            if (duration <= 2) return 8;
            if (duration <= 3) return 10;
            return 12;
        }

        if (format === 'buffet' || format === 'plated') {
            return duration <= 2 ? 2 : 3;
        }

        return 4;
    }

    function getMainPortionsPerGuest(format) {
        switch (format) {
            case 'light':
                return 0;
            case 'cocktail':
                return 0;
            case 'heavyCocktail':
                return 0.5;
            case 'buffet':
                return 1;
            case 'plated':
                return 1;
            default:
                return 1;
        }
    }

    function getProteinOzPerGuest(format) {
        switch (format) {
            case 'light':
                return 0;
            case 'cocktail':
                return 0;
            case 'heavyCocktail':
                return 4;
            case 'buffet':
                return 6;
            case 'plated':
                return 8;
            default:
                return 6;
        }
    }

    function getSidesOzPerGuest(format) {
        switch (format) {
            case 'light':
                return 0;
            case 'cocktail':
                return 0;
            case 'heavyCocktail':
                return 3;
            case 'buffet':
                return 6;
            case 'plated':
                return 5;
            default:
                return 5;
        }
    }

    function getDessertsPerGuest(style, format) {
        if (style === 'none') return 0;
        if (style === 'light') return 0.75;
        if (style === 'premium') return 1.25;

        if (format === 'cocktail' || format === 'light') return 0.8;
        return 1;
    }

    function getServiceNotes(format, duration) {
        const pieces = getAppetizerPiecesPerPerson(format, duration);

        switch (format) {
            case 'light':
                return `Light event planning usually works best with around ${pieces} appetizer pieces per equivalent guest, with little or no full meal service.`;
            case 'cocktail':
                return `Cocktail-style events usually need around ${pieces} appetizer pieces per equivalent guest at this duration, especially when passed bites carry most of the menu.`;
            case 'heavyCocktail':
                return `Heavy hors d’oeuvres service should feel closer to a meal, so this estimate raises bite count and includes partial meal weight.`;
            case 'buffet':
                return `Buffet events usually need one full main portion per guest, plus protein and side backup so the line still looks full late in service.`;
            case 'plated':
                return `Plated dinners usually rely on one main portion per guest, with a modest appetizer count and a cleaner dessert count.`;
            default:
                return `This estimate is designed as a practical planning guide for early food forecasting.`;
        }
    }

    function calculateFoodPlan() {
        const format = eventFormat.value;
        const duration = parseFloat(serviceDuration.value || '2');
        const dessertChoice = dessertStyle.value;

        const guestsData = getEffectiveGuestCount();
        const equivalentGuests = guestsData.adjustedEquivalentGuests;

        if (equivalentGuests <= 0) {
            renderEmpty();
            return;
        }

        const appetizerPiecesPerGuest = getAppetizerPiecesPerPerson(format, duration);
        const mainPortionsPerGuest = getMainPortionsPerGuest(format);
        const proteinOzPerGuest = getProteinOzPerGuest(format);
        const sideOzPerGuest = getSidesOzPerGuest(format);
        const dessertsPerGuest = getDessertsPerGuest(dessertChoice, format);

        const appetizerPieces = roundUp(equivalentGuests * appetizerPiecesPerGuest);
        const mainPortions = Math.ceil(equivalentGuests * mainPortionsPerGuest);
        const proteinLbs = (equivalentGuests * proteinOzPerGuest) / 16;
        const sideLbs = (equivalentGuests * sideOzPerGuest) / 16;
        const desserts = Math.ceil(equivalentGuests * dessertsPerGuest);

        const appetizerPrice = parseFloat(appetizerCost.value || '0');
        const mainPrice = parseFloat(mainCost.value || '0');
        const dessertPrice = parseFloat(dessertCost.value || '0');
        const miscCost = parseFloat(extraFoodCost.value || '0');

        const appetizerSubtotal = appetizerPieces * appetizerPrice;
        const mainSubtotal = mainPortions * mainPrice;
        const dessertSubtotal = desserts * dessertPrice;
        const totalCost = appetizerSubtotal + mainSubtotal + dessertSubtotal + miscCost;

        const formatLabel = eventFormat.options[eventFormat.selectedIndex].text;
        const dessertLabel = dessertStyle.options[dessertStyle.selectedIndex].text;

        resultsWrap.innerHTML = `
            <div class="result-card">
                <h3>Event Food Summary</h3>
                <p>${getServiceNotes(format, duration)}</p>

                <div class="result-grid">
                    <div class="result-stat">
                        <div class="result-stat-label">Adults</div>
                        <div class="result-stat-value">${guestsData.adults}</div>
                    </div>
                    <div class="result-stat">
                        <div class="result-stat-label">Children</div>
                        <div class="result-stat-value">${guestsData.kids}</div>
                    </div>
                    <div class="result-stat">
                        <div class="result-stat-label">Equivalent Guests</div>
                        <div class="result-stat-value">${equivalentGuests.toFixed(1)}</div>
                    </div>
                    <div class="result-stat">
                        <div class="result-stat-label">Event Style</div>
                        <div class="result-stat-value" style="font-size:1rem;">${formatLabel}</div>
                    </div>
                </div>
            </div>

            <div class="result-card">
                <h3>Quantity Planning Guide</h3>
                <div class="ingredient-grid">
                    <div class="ingredient-card">
                        <h4>Appetizer Pieces</h4>
                        <p>${appetizerPieces} total pieces</p>
                    </div>

                    <div class="ingredient-card">
                        <h4>Main Portions</h4>
                        <p>${mainPortions} full portions</p>
                    </div>

                    <div class="ingredient-card">
                        <h4>Protein Needed</h4>
                        <p>${proteinLbs.toFixed(1)} lb total protein</p>
                    </div>

                    <div class="ingredient-card">
                        <h4>Sides Needed</h4>
                        <p>${sideLbs.toFixed(1)} lb total sides</p>
                    </div>

                    <div class="ingredient-card">
                        <h4>Dessert Count</h4>
                        <p>${desserts} dessert servings</p>
                    </div>

                    <div class="ingredient-card">
                        <h4>Dessert Style</h4>
                        <p>${dessertLabel}</p>
                    </div>
                </div>

                <div class="muted-note">
                    These numbers include your selected buffer and child portion adjustment. They are intended for planning, shopping and early quoting, not as a final production sheet.
                </div>
            </div>

            <div class="result-card">
                <h3>Estimated Food Cost</h3>
                <div class="ingredient-grid">
                    <div class="ingredient-card">
                        <h4>Appetizers</h4>
                        <p>$${formatMoney(appetizerSubtotal)}</p>
                    </div>

                    <div class="ingredient-card">
                        <h4>Main Meal</h4>
                        <p>$${formatMoney(mainSubtotal)}</p>
                    </div>

                    <div class="ingredient-card">
                        <h4>Desserts</h4>
                        <p>$${formatMoney(dessertSubtotal)}</p>
                    </div>

                    <div class="ingredient-card">
                        <h4>Extra / Misc.</h4>
                        <p>$${formatMoney(miscCost)}</p>
                    </div>
                </div>

                <div class="result-grid" style="margin-top:18px;">
                    <div class="result-stat">
                        <div class="result-stat-label">Total Estimate</div>
                        <div class="result-stat-value">$${formatMoney(totalCost)}</div>
                    </div>

                    <div class="result-stat">
                        <div class="result-stat-label">Cost Per Equivalent Guest</div>
                        <div class="result-stat-value">$${formatMoney(equivalentGuests > 0 ? totalCost / equivalentGuests : 0)}</div>
                    </div>

                    <div class="result-stat">
                        <div class="result-stat-label">Appetizer Unit Cost</div>
                        <div class="result-stat-value">$${formatMoney(appetizerPrice)}</div>
                    </div>

                    <div class="result-stat">
                        <div class="result-stat-label">Main Unit Cost</div>
                        <div class="result-stat-value">$${formatMoney(mainPrice)}</div>
                    </div>
                </div>

                <div class="muted-note">
                    Tip: if you are quoting a client, this is a good operational estimate for food only. Staffing, rentals, service ware, delivery, tax and setup should usually be calculated separately.
                </div>
            </div>
        `;
    }

    calculateBtn.addEventListener('click', calculateFoodPlan);

    resetBtn.addEventListener('click', function () {
        eventFormat.value = 'light';
        serviceDuration.value = '2';
        adultGuests.value = '';
        childGuests.value = '0';
        childFactor.value = '0.5';
        buffer.value = '10';
        dessertStyle.value = 'standard';
        appetizerCost.value = '';
        mainCost.value = '';
        dessertCost.value = '';
        extraFoodCost.value = '0';
        renderEmpty();
    });

    renderEmpty();
});
</script>
{% endblock %}