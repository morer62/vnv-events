{% block scripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<script>
if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
    gsap.registerPlugin(ScrollTrigger);

    gsap.from(".intro-image-card, .intro-panel, .package-card, .music-image-stack, .music-panel, .addon-card, .feature-card, .faq-item, .vnv-studio-card, .final-cta-card", {
        scrollTrigger: {
            trigger: ".intro-image-card",
            start: "top 82%"
        },
        y: 35,
        opacity: 0,
        duration: 1,
        ease: "power3.out"
    });

    if (window.innerWidth > 991) {
        gsap.to('.services-bg-video', {
            yPercent: 12,
            ease: 'none',
            scrollTrigger: {
                trigger: '#dj-packages',
                start: 'top bottom',
                end: 'bottom top',
                scrub: true
            }
        });
    }
}
</script>
{% endblock %}
