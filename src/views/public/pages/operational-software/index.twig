{% extends "templates/base.twig" %}
{% block styles %}
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-operations-tour.css', { v: '20261125' }) }}">
<script defer src="{{ asset_for('assets/js/vnv-operations-tour.js', { v: '20261125' }) }}"></script>
{% endblock %}
{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}
{% set tour = 'assets/video/production-software/' ~ selected %}
<main class="ops-tour">
  <header class="ops-tour__header">
    <div class="ops-tour__wrap">
      <a class="ops-tour__back" href="{{ path('event-production') }}">← Event production</a>
      <h1>Event production software</h1>
      <p>The floor lead needs a call time. The producer needs to know who approved the program. The partnerships team needs the next sponsor follow-up. See how each person works inside the same event.</p>
      <div class="ops-tour__actions">
        <a class="ops-tour__button" href="#walkthrough">Watch a walkthrough <span aria-hidden="true">↓</span></a>
        {% if demo_live %}
          <a class="ops-tour__text-link" href="https://operations.vnvevents.com/login" rel="noreferrer">Open private demo login <span aria-hidden="true">↗</span></a>
        {% else %}
          <a class="ops-tour__text-link" href="#private-demo">Request a private demo</a>
        {% endif %}
      </div>
    </div>
  </header>
  <section class="ops-tour__wrap ops-tour__workspace" id="walkthrough" aria-labelledby="tour-title">
    <div class="ops-tour__chooser">
      <h2 id="tour-title">Choose your role</h2>
      <p>Five views of the working pilot. The organizations, contacts and assignments in these recordings are fictional.</p>
      <nav aria-label="Walkthrough by role">
        {% for slug, entry in roles %}
          <a href="{{ path('operational-software/', { role: slug }) }}#walkthrough"{% if slug == selected %} aria-current="page"{% endif %}>
            <span class="ops-tour__level">L{{ loop.index }}</span> {{ entry[0] }}
          </a>
        {% endfor %}
      </nav>
    </div>
    <div class="ops-tour__screen">
      <h3>{{ roles[selected][0] }}</h3>
      <p>{{ roles[selected][1] }}</p>
      <video id="ops-player" controls playsinline preload="metadata" width="1280" height="800" poster="{{ asset_for(tour ~ '.jpg') }}" aria-label="{{ roles[selected][0] }} walkthrough">
        <source src="{{ asset_for(tour ~ '.mp4') }}" type="video/mp4">
        <track kind="captions" srclang="en" label="English" src="{{ asset_for(tour ~ '.vtt') }}">
        <track kind="chapters" srclang="en" label="Modules" src="{{ asset_for(tour ~ '.chapters.vtt') }}">
        <a href="{{ asset_for(tour ~ '.mp4') }}">Open walkthrough video</a>
      </video>
      <div class="ops-tour__chapters" hidden>
        <h4>Jump to a task</h4>
        <ol id="ops-chapters"></ol>
      </div>
      <details class="ops-tour__transcript">
        <summary>Transcript</summary>
        <div data-ops-transcript><a href="{{ asset_for(tour ~ '.vtt') }}">Open English captions</a></div>
      </details>
    </div>
  </section>
  <section class="ops-tour__invite" id="private-demo" aria-labelledby="invite-title">
    <div class="ops-tour__wrap">
      <h2 id="invite-title">Try it with your team</h2>
      <p>Tell us which role you want to try and what you’re producing. An individual invitation opens the pilot workspace for your role.</p>
      <div class="ops-tour__actions">
        <a class="ops-tour__button" href="mailto:info@vnvevents.com?subject=Event%20production%20software%20demo">Email VNV for an invitation</a>
        {% if demo_live %}
          <a href="https://operations.vnvevents.com/login" rel="noreferrer">Already invited? Open the login</a>
        {% endif %}
      </div>
    </div>
  </section>
</main>
{% include "templates/layout/publicFooterVnv.html.twig" %}
{% endblock %}
