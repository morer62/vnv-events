{% extends "templates/base.twig" %}
{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700;800&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">

<style>
body{
    background:#0a0c0c;
    color:#fff;
    font-family:'Plus Jakarta Sans',sans-serif;
}

.hero{
    min-height:80vh;
    display:flex;
    align-items:center;
    background:
        linear-gradient(90deg, rgba(0,0,0,.85), rgba(0,0,0,.5)),
        url('{{ asset_for('assets/images/tool-space-planner-hero.jpg') }}') center/cover;
}

.hero h1{
    font-size:clamp(2.8rem,5vw,5rem);
    line-height:1;
}

.tool-wrap{
    padding:100px 0;
    background:#f4f7f8;
    color:#111;
}

.tool-card{
    background:#fff;
    border-radius:30px;
    padding:30px;
    box-shadow:0 25px 70px rgba(0,0,0,.08);
}

.input{
    width:100%;
    padding:14px;
    border-radius:14px;
    border:1px solid #ddd;
    margin-bottom:14px;
}

.btn-main{
    width:100%;
    padding:16px;
    background:#e00087;
    color:#fff;
    border:none;
    border-radius:14px;
    font-weight:800;
    cursor:pointer;
}

.result-card{
    background:#111;
    color:#fff;
    border-radius:24px;
    padding:24px;
}

.result-highlight{
    font-size:2rem;
    font-weight:800;
    color:#5EC6C4;
}

.range{
    font-size:1.4rem;
    font-weight:700;
}

.label{
    font-size:.8rem;
    text-transform:uppercase;
    opacity:.6;
}

</style>
{% endblock %}

{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}

<section class="hero">
    <div class="container">
        <h1>Balloon Decoration <br><span style="color:#c5a059">Pricing Calculator</span></h1>
        <p style="max-width:600px; margin-top:20px;">
            Estimate balloon quantities, design complexity and realistic pricing ranges based on real event industry standards.
        </p>
    </div>
</section>

<section class="tool-wrap">
    <div class="container">
        <div class="row">
            <div class="col-lg-5">
                <div class="tool-card">

                    <label>Decoration Type</label>
                    <select id="type" class="input">
                        <option value="arch">Balloon Arch</option>
                        <option value="garland">Organic Garland</option>
                        <option value="wall">Balloon Wall</option>
                        <option value="install">Full Installation</option>
                    </select>

                    <label>Size (Feet)</label>
                    <input id="size" type="number" class="input">

                    <label>Design Style</label>
                    <select id="style" class="input">
                        <option value="1">Simple</option>
                        <option value="1.5">Organic</option>
                        <option value="2">Luxury / Full</option>
                    </select>

                    <label>Setup Difficulty</label>
                    <select id="difficulty" class="input">
                        <option value="1">Easy Access</option>
                        <option value="1.3">Indoor Setup</option>
                        <option value="1.6">Outdoor / Complex</option>
                    </select>

                    <button class="btn-main" onclick="calc()">Calculate</button>

                </div>
            </div>

            <div class="col-lg-7">
                <div id="result" class="result-card">

                    <h3>Your Estimate</h3>
                    <p>Fill the form to calculate.</p>

                </div>
            </div>
        </div>
    </div>
</section>

<script>
function calc(){

    let type = document.getElementById("type").value;
    let size = parseFloat(document.getElementById("size").value) || 0;
    let style = parseFloat(document.getElementById("style").value);
    let difficulty = parseFloat(document.getElementById("difficulty").value);

    let balloonsPerFt = {
        arch: 8,
        garland: 10,
        wall: 12,
        install: 15
    };

    let baseCostPerFt = {
        arch: 25,
        garland: 35,
        wall: 45,
        install: 65
    };

    let balloons = Math.ceil(size * balloonsPerFt[type]);

    let base = size * baseCostPerFt[type];

    let adjusted = base * style * difficulty;

    let low = adjusted * 0.8;
    let mid = adjusted;
    let high = adjusted * 1.4;

    document.getElementById("result").innerHTML = `
        <h3>Estimated Design</h3>

        <p class="label">Total Balloons</p>
        <div class="result-highlight">${balloons}</div>

        <br>

        <p class="label">Typical Market Range</p>
        <div class="range">$${low.toFixed(0)} - $${high.toFixed(0)}</div>

        <br>

        <p class="label">Recommended Budget</p>
        <div class="result-highlight">$${mid.toFixed(0)}</div>

        <br>

        <p style="opacity:.7">
        Pricing varies depending on installation time, structure, color palette, and design detail.
        Organic and luxury designs require more labor and balloon density.
        </p>
    `;
}
</script>

{% include "templates/layout/publicFooterVnv.html.twig" %}
{% endblock %}