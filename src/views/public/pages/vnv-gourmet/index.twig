{% block scripts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

<script>
if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
    gsap.registerPlugin(ScrollTrigger);

    gsap.utils.toArray('.menu-card, .holiday-card, .mini-card, .contact-card, .instagram-card').forEach((card) => {
        gsap.from(card, {
            scrollTrigger: {
                trigger: card,
                start: "top 88%"
            },
            y: 36,
            opacity: 0,
            duration: 0.9,
            ease: "power3.out"
        });
    });

    gsap.from('.feature-box', {
        scrollTrigger: {
            trigger: '.feature-box',
            start: 'top 82%'
        },
        y: 40,
        opacity: 0,
        duration: 1.1,
        ease: "power3.out"
    });
}
</script>
{% endblock %}