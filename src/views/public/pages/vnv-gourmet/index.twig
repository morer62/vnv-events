                                <li>Elegant setup that adapts to the event theme</li>
                            </ul>
                        </div>
                        <div class="call-strip">
                            <a href="tel:+13052045427">Call Now (305) 204 5427</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="service-showcase-card">
                    <div class="service-showcase-media">
                        <img  loading="lazy" decoding="async" src="{{ asset_for('assets/images/service_photos/pasta_station_1.webp') }}" alt="VNV Gourmet pasta station"  >
                    </div>
                    <div class="service-showcase-body">
