            <a href="tel:+13052045427" class="vnv-btn btn-gold-vnv">Call Now (305) 204 5427</a>
            <a href="https://vnvevents.com/product-category/catering-services/" class="vnv-btn btn-outline-vnv">Price &amp; Menu</a>
            <a href="#" data-vnv-open-request class="vnv-btn btn-outline-vnv">New Request</a>
        </div>

        <div class="vnv-breadcrumbs">
            <a href="{{ path('/') }}">Home</a>
            <span class="sep">/</span>
            <a href="{{ path('/#services') }}">Our Services</a>
            <span class="sep">/</span>
            <span>VNV Gourmet</span>
        </div>
    </div>
</section>



<section class="metric-strip-vnv text-center">
    <div class="container">
        <div class="row g-4 justify-content-center">
            <div class="col-12 col-lg-3">
                <div class="metric-item">
                    <h3 class="metric-val">5+</h3>
                    <p class="metric-label">YEARS OF EXPERIENCE</p>
                </div>
