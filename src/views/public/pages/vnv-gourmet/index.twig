{% extends "templates/base.twig" %}

{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&display=swap" rel="stylesheet">

<style>
:root {
    --vnv-primary: #5EC6C4;
    --vnv-primary-dark: #4aa8a6;
    --vnv-gold: #c5a059;
    --vnv-gold-gradient: linear-gradient(135deg, #bf953f 0%, #fcf6ba 45%, #b38728 100%);
    --vnv-dark-deep: #0a0c0c;
    --vnv-dark-soft: #141818;
    --vnv-dark-card: #1b2021;
    --vnv-light: #ffffff;
    --vnv-marble: #f4f7f8;
    --vnv-text-main: #2d3436;
    --vnv-text-dark: #11181a;
    --vnv-text-light: #f3f5f6;
    --vnv-text-muted: rgba(255,255,255,.74);
    --vnv-text-muted-soft: rgba(255,255,255,.60);
    --vnv-border: rgba(255,255,255,.08);
    --vnv-shadow-lg: 0 40px 100px rgba(0,0,0,.24);
    --vnv-glow: 0 0 40px rgba(94,198,196,.16);
}

html { scroll-behavior: smooth; }

body {
    background: var(--vnv-dark-deep);
    color: var(--vnv-text-light);
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

h1, h2, h3, h4, h5, .luxury-font {
    font-family: 'Playfair Display', serif;
}

.text-vnv { color: var(--vnv-primary) !important; }
.text-gold {
    background: var(--vnv-gold-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.letter-spacing-lg { letter-spacing: 4px; }

.vnv-btn {
    padding: 18px 30px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: all .35s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: .78rem;
    border-radius: 999px;
}

.btn-gold-vnv {
    background: var(--vnv-gold-gradient);
    color: #000 !important;
}
.btn-gold-vnv:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 40px rgba(197,160,89,.22);
}
.btn-outline-vnv {
    border: 2px solid var(--vnv-primary);
    color: var(--vnv-primary) !important;
    background: transparent;
}
.btn-outline-vnv:hover {
    background: var(--vnv-primary);
    color: #fff !important;
}
.btn-ghost-dark {
    border: 1px solid rgba(17,24,26,.16);
    color: var(--vnv-text-dark) !important;
    background: transparent;
}
.btn-ghost-dark:hover {
    background: var(--vnv-text-dark);
    color: #fff !important;
}

.section-vnv {
    padding: 120px 0;
    position: relative;
}

.vnv-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(94,198,196,.1);
    color: var(--vnv-primary);
    font-size: .74rem;
    letter-spacing: 2px;
    font-weight: 800;
    text-transform: uppercase;
}

.vnv-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: .88rem;
    color: rgba(255,255,255,.6);
    margin-top: 18px;
}
.vnv-breadcrumbs a {
    color: rgba(255,255,255,.76);
    text-decoration: none;
}
.vnv-breadcrumbs span.sep {
    opacity: .4;
}

.hero-gourmet {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
        linear-gradient(90deg, rgba(10,12,12,.88) 0%, rgba(10,12,12,.68) 42%, rgba(10,12,12,.42) 100%),
        url('{{ asset_for('assets/images/vnv-gourmet-hero.jpg') }}') center/cover no-repeat;
}

.hero-gourmet::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at top right, rgba(94,198,196,.16), transparent 28%),
        radial-gradient(circle at bottom left, rgba(197,160,89,.10), transparent 24%);
    pointer-events: none;
}

.hero-gourmet-inner {
    position: relative;
    z-index: 2;
    width: 100%;
}

.hero-gourmet h1 {
    font-size: clamp(3rem, 6vw, 5.4rem);
    line-height: 1.02;
    margin: 20px 0 28px;
    max-width: 900px;
}

.hero-gourmet p.hero-copy {
    font-size: 1.08rem;
    color: var(--vnv-text-muted);
    max-width: 760px;
    margin-bottom: 34px;
}

.hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 28px;
}

.section-white {
    background: var(--vnv-marble);
    color: var(--vnv-text-dark);
}

.section-dark {
    background: var(--vnv-dark-deep);
    color: var(--vnv-text-light);
}

.section-heading {
    max-width: 900px;
    margin-bottom: 55px;
}
.section-heading h2 {
    font-size: clamp(2.2rem, 4vw, 4.3rem);
    line-height: 1.04;
    margin: 16px 0 18px;
}
.section-dark .section-heading p {
    color: var(--vnv-text-muted);
}
.section-white .section-heading p {
    color: #5a6669;
}

.menu-card {
    border-radius: 30px;
    padding: 34px 30px;
    height: 100%;
    position: relative;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,.10);
}

.section-dark .menu-card,
.section-dark .holiday-card,
.section-dark .mini-card,
.section-dark .contact-card {
    background: linear-gradient(145deg, rgba(28,34,35,.95) 0%, rgba(16,18,18,.96) 100%);
    border: 1px solid rgba(255,255,255,.07);
}

.section-white .menu-card,
.section-white .holiday-card,
.section-white .mini-card,
.section-white .instagram-card {
    background: #fff;
    border: 1px solid rgba(17,24,26,.08);
}

.menu-card h3,
.holiday-card h4,
.mini-card h4,
.contact-card h4,
.instagram-card h4,
.feature-copy h3 {
    margin-bottom: 18px;
}

.section-dark .menu-card h3,
.section-dark .holiday-card h4,
.section-dark .mini-card h4,
.section-dark .contact-card h4 {
    color: #fff;
}

.section-white .menu-card h3,
.section-white .holiday-card h4,
.section-white .mini-card h4,
.section-white .instagram-card h4,
.section-white .feature-copy h3 {
    color: var(--vnv-text-dark);
}

.menu-card h3 {
    font-size: 2rem;
}

.menu-card h4 {
    color: var(--vnv-primary);
    font-size: 1.15rem;
    margin: 26px 0 12px;
}

.section-dark .menu-card p,
.section-dark .holiday-card p,
.section-dark .mini-card p,
.section-dark .contact-card p,
.section-dark .menu-card li,
.section-dark .holiday-card li,
.section-dark .mini-card li,
.section-dark .contact-card li {
    color: var(--vnv-text-muted);
}

.section-white .menu-card p,
.section-white .holiday-card p,
.section-white .mini-card p,
.section-white .instagram-card p,
.section-white .menu-card li,
.section-white .holiday-card li,
.section-white .mini-card li {
    color: #485457;
}

.menu-card ul,
.holiday-card ul,
.mini-card ul,
.contact-card ul {
    list-style: none;
    padding-left: 0;
    margin: 0;
}

.menu-card ul li,
.holiday-card ul li,
.mini-card ul li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 8px;
}

.menu-card ul li::before,
.holiday-card ul li::before,
.mini-card ul li::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vnv-gold);
    position: absolute;
    left: 0;
    top: 12px;
}

.menu-top-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0 0 22px;
}

.call-strip {
    margin-top: 22px;
    padding-top: 20px;
}
.section-dark .call-strip {
    border-top: 1px solid rgba(255,255,255,.08);
}
.section-white .call-strip {
    border-top: 1px solid rgba(17,24,26,.08);
}
.call-strip a {
    color: var(--vnv-primary);
    text-decoration: none;
    font-weight: 800;
    letter-spacing: 1px;
}

.split-feature {
    position: relative;
}

.feature-box {
    border-radius: 34px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0,0,0,.12);
    border: 1px solid rgba(17,24,26,.08);
    background: #fff;
}

.feature-visual {
    min-height: 100%;
    background:
        linear-gradient(180deg, rgba(0,0,0,.10), rgba(0,0,0,.20)),
        url('{{ asset_for('assets/images/vnv-gourmet-corporate.jpg') }}') center/cover no-repeat;
}

.feature-copy {
    padding: 60px 50px;
    color: var(--vnv-text-dark);
}
.feature-copy p,
.feature-copy li {
    color: #4d595c;
}
.feature-copy ul {
    list-style: none;
    padding-left: 0;
    margin: 0;
}
.feature-copy ul li {
    padding-left: 22px;
    position: relative;
    margin-bottom: 10px;
}
.feature-copy ul li::before {
    content: "•";
    color: var(--vnv-gold);
    position: absolute;
    left: 0;
    top: 0;
    font-size: 1.2rem;
}

.holiday-card,
.mini-card,
.contact-card,
.instagram-card {
    border-radius: 28px;
    padding: 30px;
    height: 100%;
}

.instagram-visual {
    border-radius: 26px;
    overflow: hidden;
    min-height: 420px;
    background:
        linear-gradient(180deg, rgba(0,0,0,.08), rgba(0,0,0,.22)),
        url('{{ asset_for('assets/images/vnv-gourmet-instagram.jpg') }}') center/cover no-repeat;
    border: 1px solid rgba(17,24,26,.08);
}

.location-block {
    padding-bottom: 90px;
}
.contact-card ul li {
    margin-bottom: 10px;
}
.contact-card a {
    color: var(--vnv-primary);
    text-decoration: none;
}
.footer-links-inline {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 18px;
}
.footer-links-inline a {
    color: rgba(255,255,255,.75);
    text-decoration: none;
}

@media (max-width: 991px) {
    .hero-gourmet {
        min-height: auto;
        padding: 120px 0 80px;
        background-position: center center;
    }

    .feature-copy {
        padding: 38px 28px;
    }

    .instagram-card {
        padding: 32px;
    }
}

@media (max-width: 767px) {
    .section-vnv {
        padding: 90px 0;
    }

    .hero-gourmet h1 {
        font-size: 2.7rem;
    }

    .vnv-btn {
        width: 100%;
    }

    .menu-card,
    .mini-card,
    .holiday-card,
    .contact-card,
    .instagram-card {
        padding: 24px;
    }
}
</style>
{% endblock %}

