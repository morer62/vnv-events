            <div class="col-12 col-lg-3">
                <div class="metric-item">
                    <h3 class="metric-val">200+</h3>
                    <p class="metric-label">EVENTS PER YEAR</p>
                </div>
            </div>

            <div class="col-12 col-lg-3">
                <div class="metric-item">
                    <h3 class="metric-val">5.0</h3>
