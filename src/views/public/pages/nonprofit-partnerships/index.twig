{% extends "templates/base.twig" %}
{% block title %}{{ seo.title }}{% endblock %}
{% block meta_description %}{{ seo.description }}{% endblock %}
{% block canonical %}{{ seo.canonical }}{% endblock %}
{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-partnerships.css') }}">
{% endblock %}

{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}
<main class="vnv-partnership-page">
  <section class="vnvp-hero" style="--vnvp-hero-image:url('{{ asset_for('assets/images/production1.jpg') }}')">
    <div class="vnvp-container">
      <div class="vnvp-hero__copy">
        <span class="vnvp-eyebrow">Nonprofit Impact Initiative</span>
        <h1>VNV Support 2027</h1>
        <p>Empowering local missions through event production, operational expertise and technology.</p>
        <div class="vnvp-actions">
          <a class="vnvp-button vnvp-button--gold" href="#application">Apply to VNV Support 2027</a>
          <button class="vnvp-button vnvp-button--ghost" type="button" data-vnv-open-quick-request data-quick-request-type="NONPROFIT" data-quick-request-source="nonprofit_exploratory_2027">Request an Exploratory Meeting</button>
        </div>
      </div>
    </div>
  </section>

  <section class="vnvp-section" id="support">
    <div class="vnvp-container">
      <div class="vnvp-heading">
        <h2>A pilot for South Florida nonprofits</h2>
        <p>VNV Support aims to support up to 12 organizations during 2027, subject to available resources, project evaluation and approval of each scope. The pilot will help us measure results and improve future editions.</p>
        <p>Jonathan Moreno, Founder of VNV Events and Director of the VNV Support Initiative, brings together three areas of expertise to help nonprofits carry out projects that serve their communities.</p>
      </div>
      <div class="vnvp-grid">
        <article class="vnvp-card"><span class="vnvp-card__icon"><i class="fa-solid fa-compass-drafting" aria-hidden="true"></i></span><h3>Event Production</h3><p>Creative direction, experience design, audiovisual advice and fundraising event planning, including ways to give existing sponsors visibility.</p></article>
        <article class="vnvp-card"><span class="vnvp-card__icon"><i class="fa-solid fa-list-check" aria-hidden="true"></i></span><h3>Operational &amp; Logistics Support</h3><p>Vendor coordination, staffing and guest experience planning, process design and basic training for an approved project.</p></article>
        <article class="vnvp-card"><span class="vnvp-card__icon"><i class="fa-solid fa-laptop-code" aria-hidden="true"></i></span><h3>Technology &amp; Digital Integration</h3><p>Registration, RSVP, QR check-in, access control, communications and reporting adapted to your team’s needs and the tools available.</p></article>
      </div>
    </div>
  </section>

  {% include "templates/components/publicNonprofitStories.html.twig" with {
    story_heading_id: 'nonprofit-collaborations-title',
    story_section_class: 'vnvp-section vnvp-section--soft',
    story_container_class: 'vnvp-container',
    story_eyebrow: 'Collaboration in Practice',
    story_heading: 'Built around each organization’s real needs.',
    story_intro: 'Explore how our nonprofit support evolved from focused services to a connected event experience.'
  } %}

  <section class="vnvp-section vnvp-section--dark">
    <div class="vnvp-container">
      <div class="vnvp-heading"><h2>How support is structured</h2><p>Each selected organization receives an Approved Support Plan detailing what VNV will contribute, what the organization will pay, who is responsible, and what results the team will measure. External expenses require prior approval and an identified funding source.</p></div>
      <div class="vnvp-grid">
        <article class="vnvp-card"><h3>In-kind contributions</h3><p>Approved professional hours, planning, expertise or VNV-owned resources contributed at no cost.</p></article>
        <article class="vnvp-card"><h3>Subsidized support</h3><p>Selected services or resources for which VNV Events may approve a partial contribution.</p></article>
        <article class="vnvp-card"><h3>Additional paid services</h3><p>Additional staff, materials, vendors and other resources are quoted separately and require approval.</p></article>
      </div>
    </div>
  </section>

  <section class="vnvp-section vnvp-section--soft" id="process">
    <div class="vnvp-container">
      <div class="vnvp-heading"><h2>From application to results</h2><p>We prioritize South Florida nonprofits that can verify their organization, identify a concrete need, participate in the work and document results. We evaluate community benefit, feasibility and available resources.</p></div>
      <ol class="vnvp-process vnvp-process--nonprofit">
        {% for step in ['Application', 'Eligibility Review', 'Discovery Meeting', 'Needs Assessment', 'Approved Support Plan', 'Implementation', 'Impact & Results Review'] %}
          <li class="vnvp-step"><strong>{{ step }}</strong></li>
        {% endfor %}
      </ol>
    </div>
  </section>

  <section class="vnvp-section" id="nonprofit-faq">
    <div class="vnvp-container">
      <div class="vnvp-heading"><span class="vnvp-eyebrow">Frequently asked questions</span><h2>Clear expectations before you apply.</h2></div>
      <div class="vnvp-faq">
        <details><summary>Who can submit an application?</summary><p>Local nonprofits and organizations with a documented nonprofit structure, including a fiscal sponsor, can apply. Each request is evaluated on its needs, community impact and available resources.</p></details>
        <details><summary>Can we apply without a confirmed event?</summary><p>Yes. Describe the operational or technology challenge and the result your organization needs. Event details can be added later if they become relevant.</p></details>
        <details><summary>What does the program cover?</summary><p>VNV Events provides professional and operational support within a written Approved Support Plan. The program does not guarantee approval, cash grants, funding, sponsors, fundraising results, a free event or catering, payment of venues, materials or vendors, unlimited staffing or software development, or ongoing technical support.</p></details>
        <details><summary>How will we review results?</summary><p>VNV and the organization agree on expected outcomes in the support plan and review the work after delivery. We report only results that can be verified.</p></details>
        <details><summary>How is application data used?</summary><p>Information is used to review the request and coordinate follow-up. Attendee data is not converted into an unrelated commercial prospect list without appropriate consent.</p></details>
      </div>
    </div>
  </section>

  <section class="vnvp-section" id="application">
    <div class="vnvp-container vnvp-form-wrap">
      <div class="vnvp-form-intro">
        <span class="vnvp-eyebrow">Now accepting applications</span>
        <h2>Tell us what your organization needs</h2>
        <p>Share the problem you want to solve and how support could help. If you would like to discuss fit before applying, request an exploratory meeting.</p>
        <button class="vnvp-button" type="button" data-vnv-open-quick-request data-quick-request-type="NONPROFIT" data-quick-request-source="nonprofit_exploratory_2027">Request an Exploratory Meeting</button>
      </div>
      <details class="vnvp-advanced" open><summary>VNV Support 2027 Application</summary><form class="vnvp-form" action="{{ path('api/public/partnership-request') }}" method="post">
        {% if submitted %}<div class="vnvp-success" role="status"><strong>Application received.</strong> We sent an acknowledgment with your reference number.</div>{% endif %}
        <input type="hidden" name="program" value="NONPROFIT">
        <input type="hidden" name="_token" value="{{ partnership_csrf }}">
        <div class="vnvp-hidden" aria-hidden="true"><label>Website confirmation<input type="text" name="website_confirm" tabindex="-1" autocomplete="off"></label></div>
        {% for key in ['gclid','gbraid','wbraid','utm_source','utm_medium','utm_campaign','utm_term','utm_content','landing_url'] %}<input type="hidden" name="{{ key }}" data-attribution="{{ key }}">{% endfor %}
        <div class="vnvp-fields">
          <div class="vnvp-field"><label for="np-org">Organization name *</label><input id="np-org" name="organization_name" required maxlength="191"></div>
          <div class="vnvp-field"><label for="np-web">Organization website</label><input id="np-web" name="organization_website" type="url" maxlength="255"></div>
          <div class="vnvp-field"><label for="np-legal">Legal status</label><select id="np-legal" name="legal_status"><option value="">Select</option><option>501(c)(3)</option><option>Pending nonprofit status</option><option>Fiscal sponsor</option><option>Other nonprofit structure</option></select></div>
          <div class="vnvp-field"><label for="np-ein">EIN (optional)</label><input id="np-ein" name="ein" maxlength="40" inputmode="numeric"></div>
          <div class="vnvp-field"><label for="np-name">Contact name *</label><input id="np-name" name="contact_name" required maxlength="191"></div>
          <div class="vnvp-field"><label for="np-role">Role *</label><input id="np-role" name="contact_role" required maxlength="150"></div>
          <div class="vnvp-field"><label for="np-email">Email *</label><input id="np-email" name="email" type="email" required maxlength="191"></div>
          <div class="vnvp-field"><label for="np-phone">Phone *</label><input id="np-phone" name="phone" type="tel" required maxlength="80"></div>
          <div class="vnvp-field"><label for="np-event">Event name (if applicable)</label><input id="np-event" name="event_name" maxlength="220"></div>
          <div class="vnvp-field"><label for="np-date">Event date</label><input id="np-date" name="event_date" type="date"></div>
          <div class="vnvp-field"><label for="np-venue">Venue</label><input id="np-venue" name="venue" maxlength="255"></div>
          <div class="vnvp-field"><label for="np-city">City</label><input id="np-city" name="city" maxlength="120"></div>
          <div class="vnvp-field"><label for="np-format">Event format</label><input id="np-format" name="event_format" maxlength="120" placeholder="Gala, fundraiser, community event..."></div>
          <div class="vnvp-field"><label for="np-guests">Expected guests</label><input id="np-guests" name="guest_count" type="number" min="1" max="100000"></div>
          <div class="vnvp-field vnvp-field--full"><label for="np-budget">Budget range</label><input id="np-budget" name="budget_range" maxlength="120" placeholder="A range is enough; this helps us recommend a realistic scope."></div>
          <div class="vnvp-field vnvp-field--full"><label for="np-outcomes">What do you need help with? *</label><textarea id="np-outcomes" name="desired_outcomes" placeholder="Describe the need and the outcome you hope to achieve." required maxlength="2000"></textarea></div>
          <div class="vnvp-field vnvp-field--full"><label for="np-sponsors">Existing sponsors or partners</label><textarea id="np-sponsors" name="existing_sponsors" maxlength="1200"></textarea></div>
          <fieldset class="vnvp-group"><legend>Support requested</legend><div class="vnvp-checks">
            {% for option in ['Event Production', 'Operational & Logistics Support', 'Technology & Digital Integration'] %}<label class="vnvp-check"><input type="checkbox" name="requested_services[]" value="{{ option }}"><span>{{ option }}</span></label>{% endfor %}
          </div></fieldset>
          <div class="vnvp-field vnvp-field--full"><label for="np-time">Decision timeframe</label><input id="np-time" name="timeframe" maxlength="120"></div>
        </div>
        <label class="vnvp-consent"><input type="checkbox" name="consent" value="1" required><span>I agree that VNV Events may contact me about this request. I understand that submission does not guarantee approval, funding, sponsorship results, discounts or availability.</span></label>
        <button class="vnvp-button vnvp-button--gold" type="submit">Submit Nonprofit Application</button>
        <p class="vnvp-form-note">Your information is used to review this request and coordinate follow-up. It is not added to an unrelated prospect list without consent.</p>
      </form></details>
    </div>
  </section>
</main>
{% include "templates/components/publicQuickRequestModal.html.twig" with {
  quick_request_type: 'NONPROFIT',
  quick_request_source: 'nonprofit_exploratory_2027',
  quick_request_title: 'Request an Exploratory Meeting',
  quick_request_cta: 'Send Meeting Request'
} %}
{% include "templates/layout/publicFooterVnv.html.twig" %}
{% endblock %}

{% block scripts %}
<script>
(function(){const params=new URLSearchParams(location.search);document.querySelectorAll('[data-attribution]').forEach(function(input){input.value=input.dataset.attribution==='landing_url'?location.href:(params.get(input.dataset.attribution)||'');});})();
</script>
{% endblock %}
