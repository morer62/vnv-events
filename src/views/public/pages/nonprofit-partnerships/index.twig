{% extends "templates/base.twig" %}
{% block title %}{{ seo.title }}{% endblock %}
{% block meta_description %}{{ seo.description }}{% endblock %}
{% block canonical %}{{ seo.canonical }}{% endblock %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-partnerships.css') }}">
{% endblock %}

{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}
<main class="vnv-partnership-page">
  <section class="vnvp-hero" style="--vnvp-hero-image:url('{{ asset_for('assets/images/production1.jpg') }}')">
    <div class="vnvp-container">
      <div class="vnvp-hero__copy">
        <span class="vnvp-eyebrow">VNV Nonprofit Partnerships</span>
        <h1>Your Mission. Our Expertise.</h1>
        <p>We help nonprofits create extraordinary fundraising and community experiences — from concept development and visual design to logistics, event technology and on-site execution.</p>
        <div class="vnvp-actions">
          <a class="vnvp-button vnvp-button--gold" href="#application">Apply for Nonprofit Support</a>
          <a class="vnvp-button vnvp-button--ghost" href="#support">See How We Can Help</a>
        </div>
      </div>
    </div>
  </section>

  <section class="vnvp-section" id="support">
    <div class="vnvp-container">
      <div class="vnvp-heading">
        <span class="vnvp-eyebrow">Practical support, clearly scoped</span>
        <h2>You focus on your mission. We help create the complete experience.</h2>
        <p>VNV combines planning, production, hospitality and technology in one operating team. Applications are reviewed individually so approved support is useful, documented and financially responsible.</p>
      </div>
      <div class="vnvp-grid">
        <article class="vnvp-card"><span class="vnvp-card__icon"><i class="fa-solid fa-compass-drafting"></i></span><h3>Creative direction</h3><p>Theme, visual storytelling, moodboard, palette, stage concepts, guest journey, VIP areas, atmosphere, lighting and sponsor-visibility opportunities. Renderings are conceptual and every deliverable remains subject to approved scope.</p></article>
        <article class="vnvp-card"><span class="vnvp-card__icon"><i class="fa-solid fa-list-check"></i></span><h3>Planning & production</h3><p>Budget direction, venue and vendor sourcing, negotiation, staffing, run of show, setup and breakdown coordination, accountable owners and incident management according to the approved package.</p></article>
        <article class="vnvp-card"><span class="vnvp-card__icon"><i class="fa-solid fa-laptop-code"></i></span><h3>Event technology</h3><p>Standard configuration of VNV modules for registration, RSVP, invitations, companions, attendee lists, QR check-in and attendance reporting, within the documented limits of the support plan.</p></article>
        <article class="vnvp-card"><span class="vnvp-card__icon"><i class="fa-solid fa-handshake-angle"></i></span><h3>Sponsor guidance</h3><p>Package architecture, sponsor inventory, presentation guidance and possible consented introductions. Funding and meetings are never guaranteed; physical brand activations are quoted and paid separately.</p></article>
        <article class="vnvp-card"><span class="vnvp-card__icon"><i class="fa-solid fa-people-group"></i></span><h3>Hospitality resources</h3><p>Selected food, staffing and service resources may qualify for preferential nonprofit terms when capacity and scope allow.</p></article>
        <article class="vnvp-card"><span class="vnvp-card__icon"><i class="fa-solid fa-camera-retro"></i></span><h3>Event & recap</h3><p>Execution support and documented deliverables can help your team close the event with a clearer operational record.</p></article>
      </div>
    </div>
  </section>

  <section class="vnvp-section vnvp-section--dark">
    <div class="vnvp-container">
      <div class="vnvp-heading"><span class="vnvp-eyebrow">Preferential nonprofit terms</span><h2>Meaningful assistance without vague promises.</h2><p>Support is awarded case by case after discovery, budget review and written scope approval.</p></div>
      <div class="vnvp-grid">
        <article class="vnvp-card"><h3>Initial consultation</h3><p>A limited initial consultation may be offered at no cost to understand the event and determine fit.</p></article>
        <article class="vnvp-card"><h3>Selected food & staffing</h3><p>Approved nonprofit projects may receive up to 60% preferential pricing on selected catering or staffing components.</p></article>
        <article class="vnvp-card"><h3>Selected decor</h3><p>Approved projects may receive up to 80% preferential pricing on selected decor inventory or services.</p></article>
      </div>
    </div>
  </section>

  <section class="vnvp-section vnvp-section--soft" id="process">
    <div class="vnvp-container">
      <div class="vnvp-heading"><span class="vnvp-eyebrow">How it works</span><h2>A review process your team can follow.</h2></div>
      <div class="vnvp-process">
        <div class="vnvp-step"><strong>Apply</strong></div>
        <div class="vnvp-step"><strong>Discovery</strong></div>
        <div class="vnvp-step"><strong>Concept & Budget</strong></div>
        <div class="vnvp-step"><strong>Approved Support Plan</strong></div>
        <div class="vnvp-step"><strong>Production & Activation Opportunities</strong></div>
        <div class="vnvp-step"><strong>Event & Recap</strong></div>
      </div>
    </div>
  </section>

  <section class="vnvp-section" id="nonprofit-faq">
    <div class="vnvp-container">
      <div class="vnvp-heading"><span class="vnvp-eyebrow">Frequently asked questions</span><h2>Clear expectations before you apply.</h2></div>
      <div class="vnvp-faq">
        <details><summary>Who can submit an application?</summary><p>Nonprofit organizations, organizations with a fiscal sponsor and groups with a pending or other documented nonprofit structure may apply. VNV reviews legal status, event scope, timing, budget and available capacity.</p></details>
        <details><summary>Does an application guarantee approval or donated services?</summary><p>No. Submission starts a review only. Any consultation hours, discounts, technology configuration or production support must be approved in writing with a defined scope.</p></details>
        <details><summary>How do the preferential terms work?</summary><p>Approved projects may qualify for up to 60% preferential pricing on selected food or staffing components and up to 80% on selected decor. The actual terms depend on real reference pricing, availability and the approved support plan.</p></details>
        <details><summary>Will VNV guarantee sponsors or fundraising revenue?</summary><p>No. VNV may help structure inventory, materials and consented introductions, but cannot promise meetings, sponsors, funding, revenue or return on investment.</p></details>
        <details><summary>Is a sponsor activation included in nonprofit support?</summary><p>No. A brand that already sponsors an event can separately hire VNV to design, build and operate its branded experience. Organizer, venue and rights approvals are still required.</p></details>
        <details><summary>How is application data used?</summary><p>Information is used to review the request and coordinate follow-up. Attendee data is not converted into an unrelated commercial prospect list without appropriate consent.</p></details>
      </div>
    </div>
  </section>

  <section class="vnvp-section" id="application">
    <div class="vnvp-container vnvp-form-wrap">
      <div class="vnvp-form-intro">
        <span class="vnvp-eyebrow">Now accepting applications</span>
        <h2>Tell us about the mission and the event.</h2>
        <p>Submitting this application starts a review. It does not promise approval, donated services, a discount, sponsorship revenue or availability.</p>
        <p><strong>Already sponsoring an event?</strong><br><a href="{{ path('sponsor-activation-production') }}">Explore Sponsor Activation Production</a>.</p>
      </div>
      <form class="vnvp-form" action="{{ path('api/public/partnership-request') }}" method="post">
        {% if submitted %}<div class="vnvp-success" role="status"><strong>Application received.</strong> We sent an acknowledgment with your reference number.</div>{% endif %}
        <input type="hidden" name="program" value="NONPROFIT">
        <input type="hidden" name="_token" value="{{ partnership_csrf }}">
        <div class="vnvp-hidden" aria-hidden="true"><label>Website confirmation<input type="text" name="website_confirm" tabindex="-1" autocomplete="off"></label></div>
        {% for key in ['gclid','gbraid','wbraid','utm_source','utm_medium','utm_campaign','utm_term','utm_content','landing_url'] %}<input type="hidden" name="{{ key }}" data-attribution="{{ key }}">{% endfor %}
        <div class="vnvp-fields">
          <div class="vnvp-field"><label for="np-org">Organization name *</label><input id="np-org" name="organization_name" required maxlength="191"></div>
          <div class="vnvp-field"><label for="np-web">Organization website</label><input id="np-web" name="organization_website" type="url" maxlength="255"></div>
          <div class="vnvp-field"><label for="np-legal">Legal status</label><select id="np-legal" name="legal_status"><option value="">Select</option><option>501(c)(3)</option><option>Pending nonprofit status</option><option>Fiscal sponsor</option><option>Other nonprofit structure</option></select></div>
          <div class="vnvp-field"><label for="np-ein">EIN (optional)</label><input id="np-ein" name="ein" maxlength="40" inputmode="numeric"></div>
          <div class="vnvp-field"><label for="np-name">Contact name *</label><input id="np-name" name="contact_name" required maxlength="191"></div>
          <div class="vnvp-field"><label for="np-role">Role *</label><input id="np-role" name="contact_role" required maxlength="150"></div>
          <div class="vnvp-field"><label for="np-email">Email *</label><input id="np-email" name="email" type="email" required maxlength="191"></div>
          <div class="vnvp-field"><label for="np-phone">Phone *</label><input id="np-phone" name="phone" type="tel" required maxlength="80"></div>
          <div class="vnvp-field"><label for="np-event">Event name *</label><input id="np-event" name="event_name" required maxlength="220"></div>
          <div class="vnvp-field"><label for="np-date">Event date</label><input id="np-date" name="event_date" type="date"></div>
          <div class="vnvp-field"><label for="np-venue">Venue</label><input id="np-venue" name="venue" maxlength="255"></div>
          <div class="vnvp-field"><label for="np-city">City</label><input id="np-city" name="city" maxlength="120"></div>
          <div class="vnvp-field"><label for="np-format">Event format</label><input id="np-format" name="event_format" maxlength="120" placeholder="Gala, fundraiser, community event..."></div>
          <div class="vnvp-field"><label for="np-guests">Expected guests</label><input id="np-guests" name="guest_count" type="number" min="1" max="100000"></div>
          <div class="vnvp-field vnvp-field--full"><label for="np-budget">Budget range</label><input id="np-budget" name="budget_range" maxlength="120" placeholder="A range is enough; this helps us recommend a realistic scope."></div>
          <div class="vnvp-field vnvp-field--full"><label for="np-outcomes">Desired outcomes</label><textarea id="np-outcomes" name="desired_outcomes" maxlength="2000"></textarea></div>
          <div class="vnvp-field vnvp-field--full"><label for="np-sponsors">Existing sponsors or partners</label><textarea id="np-sponsors" name="existing_sponsors" maxlength="1200"></textarea></div>
          <fieldset class="vnvp-group"><legend>Support requested</legend><div class="vnvp-checks">
            {% for option in ['Consultation','Concept & Visual Design','Event Tech','Logistics','Food','Staffing','Decor','Sponsorship Guidance','Sponsor Activation Opportunity'] %}<label class="vnvp-check"><input type="checkbox" name="requested_services[]" value="{{ option }}"><span>{{ option }}</span></label>{% endfor %}
          </div></fieldset>
          <div class="vnvp-field vnvp-field--full"><label for="np-time">Decision timeframe</label><input id="np-time" name="timeframe" maxlength="120"></div>
        </div>
        <label class="vnvp-consent"><input type="checkbox" name="consent" value="1" required><span>I agree that VNV Events may contact me about this request. I understand that submission does not guarantee approval, funding, sponsorship results, discounts or availability.</span></label>
        <button class="vnvp-button vnvp-button--gold" type="submit">Submit Nonprofit Application</button>
        <p class="vnvp-form-note">Your information is used to review this request and coordinate follow-up. It is not added to an unrelated prospect list without consent.</p>
      </form>
    </div>
  </section>
</main>
{% include "templates/layout/publicFooterVnv.html.twig" %}
{% endblock %}

{% block scripts %}
<script>
(function(){const params=new URLSearchParams(location.search);document.querySelectorAll('[data-attribution]').forEach(function(input){input.value=input.dataset.attribution==='landing_url'?location.href:(params.get(input.dataset.attribution)||'');});})();
</script>
{% endblock %}
