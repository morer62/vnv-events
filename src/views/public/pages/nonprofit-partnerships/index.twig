{% extends "templates/base.twig" %}
{% block title %}{{ seo.title }}{% endblock %}
{% block meta_description %}{{ seo.description }}{% endblock %}
{% block canonical %}{{ seo.canonical }}{% endblock %}
{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-partnerships.css') }}">
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-support-2027.css') }}">
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-production-offers.css', { v: 'production-films-2' }) }}">
{% include "templates/components/vnvProductionEditorialAssets.html.twig" %}
<link rel="stylesheet" href="{{ asset_for('assets/css/vnv-production-studio.css', { v: '20261125d' }) }}">
{% endblock %}

{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}
<main class="production-studio vnv-partnership-page vnv-support">
  {% include "templates/components/vnvProductionHero.html.twig" with {
  hero: {
    slug: 'cause-on-cue',
    label: 'Nonprofit Impact Initiative · South Florida',
    title: 'Cause on Cue',
    emphasis: '2027',
    description: 'Planning a gala or charity tournament? We work alongside your nonprofit team on sponsors, vendors and event day, from the first guest check-in to the final handoff.',
    details: ['Sponsor outreach, vendor coordination and event-day production', 'One plan for your team, RSVPs and check-in', 'Year-round tools for donations, volunteers and sponsorships'],
    cta: 'Apply to Cause on Cue 2027',
    href: '#application',
    mark: 'assets/images/productions/cause-on-cue-mark-v1.webp',
    preview_label: 'Guest arrivals, the registration team and a speaker at the Victoria Venezuela Foundation tournament in Weston'
  }
} only %}

  <aside class="support-pilot" aria-label="2027 pilot">
    <div class="vnvp-container support-pilot__layout">
      <p><strong>Up to 12 organizations</strong> <span>Selected in 2027 based on project fit, capacity and approved scope.</span></p>
      <a href="#event-stories">See what we delivered in Weston <span aria-hidden="true">↓</span></a>
    </div>
  </aside>

  {% include "templates/components/vnvProductionOffer.html.twig" with {
    offer: {
      id: 'support',
      label: 'Fundraiser production',
      title: 'An experienced team to produce your fundraiser',
      description: 'From the first plan through event day, we bring years of production experience to the people, partners and logistics your fundraiser needs.',
      image: 'assets/images/case-studies/victoria-venezuela-2026-P4189.webp',
      image_alt: 'The registration crew at their laptops at the Victoria Venezuela Foundation tournament in Weston',
      caption: 'Registration team · Victoria Venezuela Foundation charity golf tournament, Weston, 2026',
      deliverables: [
        ['Sponsor outreach', 'Define sponsorship opportunities, identify aligned supporters and make introductions when both parties agree. Your organization leads the fundraising conversation.'],
        ['Production and logistics', 'Coordinate vendors, scheduling, sound, visuals and staffing around the moments that matter to your guests and sponsors.'],
        ['A connected event crew', 'Give staff and volunteers shared assignments and updates, with a live guest list and defined roles from arrival through the main program.']
      ]
    }
  } only %}

  {% include "templates/components/vnvProductionFilm.html.twig" with {
    film: {
      slug: 'cause-on-cue',
      route: 'nonprofit-partnerships',
      title: 'Watch Cause on Cue 2027',
      description: 'See how the welcome desk and sound crew supported the Weston tournament, then learn how VNV agrees on a scope with each selected nonprofit.',
      cta: 'Tell us about your fundraiser',
      href: '#application'
    }
  } only %}

  <section class="vnv-offer vnv-offer--platform" id="guest-platform" aria-labelledby="guest-platform-title">
    <div class="vnv-offer__wrap vnv-offer__platform">
      <div class="vnv-offer__copy">
        <span class="vnv-offer__eyebrow">Developed by VNV Events</span>
        <h2 id="guest-platform-title">One platform for the event and the year ahead</h2>
        <p>VNV’s event management system gives the production crew and your team one place to coordinate the work. It can support your nonprofit between events, too.</p>
        <ul class="vnv-offer__workflow" role="list">
          <li><strong>For the event.</strong> Share the schedule, crew assignments and changes. Manage RSVPs before the event and check-in at the door.</li>
          <li><strong>Year-round.</strong> Accept donations, recruit volunteers and offer sponsorship packages.</li>
          <li><strong>Your own mobile app.</strong> For selected nonprofits, mobile app development can be included at no development cost in the approved support plan.</li>
        </ul>
        <a class="studio-inline-link" href="{{ path('operational-software') }}">Tour the production team’s workspace</a>
      </div>
      <figure class="vnv-offer__portal vnv-offer__portal--overview">
        <img src="{{ asset_for('assets/video/production-films/v3/nonprofit-platform.webp', { v: '20261125d' }) }}" width="1120" height="630" alt="Illustration of year-round nonprofit tools for donations, volunteer sign-ups and sponsorship packages" loading="lazy" decoding="async">
      </figure>
    </div>
  </section>

  <div id="event-stories">
    {% include "templates/components/publicNonprofitStories.html.twig" with {
      story_heading_id: 'nonprofit-collaborations-title',
      story_section_class: 'vnvp-section vnvp-section--soft',
      story_container_class: 'vnvp-container',
      story_eyebrow: 'South Florida collaborations',
      story_heading: 'See the work behind the fundraiser',
      story_intro: 'At Victoria Venezuela Foundation’s charity golf tournament, a branded web portal and mobile app kept the guest list in sync from RSVP through event-day check-in.'
    } %}
  </div>

  <section class="vnvp-section vnvp-section--dark">
    <div class="vnvp-container">
      <div class="vnvp-heading"><h2>How support is structured</h2><p>Each selected organization receives an Approved Support Plan detailing what VNV will contribute, what the organization will pay, who is responsible, and what results the team will measure. External expenses require prior approval and an identified funding source.</p></div>
      <div class="vnvp-grid">
        <article class="vnvp-card"><h3>In-kind contributions</h3><p>Approved professional hours, planning, expertise or VNV-owned resources contributed at no cost.</p></article>
        <article class="vnvp-card"><h3>Subsidized support</h3><p>Selected services or resources for which VNV Events may approve a partial contribution.</p></article>
        <article class="vnvp-card"><h3>Additional paid services</h3><p>Additional staff, materials, vendors and other resources are quoted separately and require approval.</p></article>
      </div>
    </div>
  </section>

  <section class="vnvp-section support-process" id="process" aria-labelledby="support-process-title">
    <div class="vnvp-container support-process__layout">
      <div class="support-process__intro">
        <h2 id="support-process-title">From first conversation to event day</h2>
        <p>Start with the cause, the fundraiser you have in mind and what your team needs. You can apply before you have a confirmed date or venue.</p>
        <a href="#application">Start your application <span aria-hidden="true">→</span></a>
      </div>
      <ol class="support-process__steps" role="list">
        <li>
          <span class="support-process__number" aria-hidden="true">01</span>
          <div><h3>Tell us about your fundraiser</h3><p>We review your application for eligibility, community benefit, timing and fit.</p><small>Application · Eligibility Review</small></div>
        </li>
        <li>
          <span class="support-process__number" aria-hidden="true">02</span>
          <div><h3>Agree on what VNV will provide</h3><p>For a project that fits, you receive a written plan showing what VNV can contribute, which expenses your organization would cover and who approves the work. We agree on a date to review it together.</p><small>Discovery Meeting · Needs Assessment · Approved Support Plan</small></div>
        </li>
        <li>
          <span class="support-process__number" aria-hidden="true">03</span>
          <div><h3>Deliver the event and review results</h3><p>We carry out the approved work and review what was delivered and what your team can verify.</p><small>Implementation · Impact &amp; Results Review</small></div>
        </li>
      </ol>
    </div>
  </section>

  <section class="vnvp-section" id="nonprofit-faq">
    <div class="vnvp-container">
      <div class="vnvp-heading"><span class="vnvp-eyebrow">Frequently asked questions</span><h2>Clear expectations before you apply.</h2></div>
      <div class="vnvp-faq">
        <details><summary>Who can submit an application?</summary><p>Local nonprofits and organizations with a documented nonprofit structure, including a fiscal sponsor, can apply. Each request is evaluated on its needs, community impact and available resources.</p></details>
        <details><summary>Can we apply without a confirmed event?</summary><p>Yes. Tell us what you want your fundraiser to accomplish and what support you need. You can add the date and venue later.</p></details>
        <details><summary>Can VNV help us connect with donors or sponsors?</summary><p>Yes. For an approved project, we can help define sponsor opportunities and facilitate introductions when both parties agree. Your organization makes the fundraising decisions. Introductions do not guarantee sponsorship, donations or fundraising results.</p></details>
        <details><summary>What does the program cover?</summary><p>VNV Events provides professional and operational support within a written Approved Support Plan. The program does not guarantee approval, cash grants, funding, sponsors, fundraising results, a free event or catering, payment of venues, materials or vendors, unlimited staffing or software development, or ongoing technical support.</p></details>
        <details><summary>How will we review results?</summary><p>VNV and the organization agree on expected outcomes in the support plan and review the work after delivery. We report only results that can be verified.</p></details>
        <details><summary>How is application data used?</summary><p>Information is used to review the request and coordinate follow-up. Attendee data is not converted into an unrelated commercial prospect list without appropriate consent.</p></details>
      </div>
    </div>
  </section>

  <section class="vnvp-section" id="application">
    <div class="vnvp-container vnvp-form-wrap">
      <div class="vnvp-form-intro">
        <span class="vnvp-eyebrow">Now accepting applications</span>
        <h2>Tell us what your organization needs</h2>
        <p>Tell us about your planned fundraiser and the support your team needs. You can also request a meeting to discuss fit before applying.</p>
        <p class="support-leadership">Led by <strong>Jonathan Moreno</strong>, Founder of VNV Events and Director of the VNV Support Initiative.</p>
        <button class="vnvp-button" type="button" data-vnv-open-quick-request data-quick-request-type="NONPROFIT" data-quick-request-source="nonprofit_exploratory_2027">Request an Exploratory Meeting</button>
      </div>
      <details class="vnvp-advanced" open><summary>Cause on Cue 2027 Application</summary><form class="vnvp-form" action="{{ path('api/public/partnership-request') }}" method="post">
        {% if submitted %}<div class="vnvp-success" role="status"><strong>Application received.</strong> We sent an acknowledgment with your reference number.</div>{% endif %}
        <input type="hidden" name="program" value="NONPROFIT">
        <input type="hidden" name="_token" value="{{ partnership_csrf }}">
        <div class="vnvp-hidden" aria-hidden="true"><label>Website confirmation<input type="text" name="website_confirm" tabindex="-1" autocomplete="off"></label></div>
        {% for key in ['gclid','gbraid','wbraid','utm_source','utm_medium','utm_campaign','utm_term','utm_content','landing_url'] %}<input type="hidden" name="{{ key }}" data-attribution="{{ key }}">{% endfor %}
        <div class="vnvp-fields">
          <div class="vnvp-field"><label for="np-org">Organization name *</label><input id="np-org" name="organization_name" required maxlength="191"></div>
          <div class="vnvp-field"><label for="np-web">Organization website</label><input id="np-web" name="organization_website" type="url" maxlength="255"></div>
          <div class="vnvp-field"><label for="np-legal">Legal status</label><select id="np-legal" name="legal_status"><option value="">Select</option><option>501(c)(3)</option><option>Pending nonprofit status</option><option>Fiscal sponsor</option><option>Other nonprofit structure</option></select></div>
          <div class="vnvp-field"><label for="np-ein">EIN (optional)</label><input id="np-ein" name="ein" maxlength="40" inputmode="numeric"></div>
          <div class="vnvp-field"><label for="np-name">Contact name *</label><input id="np-name" name="contact_name" required maxlength="191"></div>
          <div class="vnvp-field"><label for="np-role">Role *</label><input id="np-role" name="contact_role" required maxlength="150"></div>
          <div class="vnvp-field"><label for="np-email">Email *</label><input id="np-email" name="email" type="email" required maxlength="191"></div>
          <div class="vnvp-field"><label for="np-phone">Phone *</label><input id="np-phone" name="phone" type="tel" required maxlength="80"></div>
          <div class="vnvp-field"><label for="np-event">Event name (if applicable)</label><input id="np-event" name="event_name" maxlength="220"></div>
          <div class="vnvp-field"><label for="np-date">Event date</label><input id="np-date" name="event_date" type="date"></div>
          <div class="vnvp-field"><label for="np-venue">Venue</label><input id="np-venue" name="venue" maxlength="255"></div>
          <div class="vnvp-field"><label for="np-city">City</label><input id="np-city" name="city" maxlength="120"></div>
          <div class="vnvp-field"><label for="np-format">Event format</label><input id="np-format" name="event_format" maxlength="120" placeholder="Gala, fundraiser, community event..."></div>
          <div class="vnvp-field"><label for="np-guests">Expected guests</label><input id="np-guests" name="guest_count" type="number" min="1" max="100000"></div>
          <div class="vnvp-field vnvp-field--full"><label for="np-budget">Budget range</label><input id="np-budget" name="budget_range" maxlength="120" placeholder="A range is enough; this helps us recommend a realistic scope."></div>
          <div class="vnvp-field vnvp-field--full"><label for="np-outcomes">What do you want your fundraiser to achieve? *</label><textarea id="np-outcomes" name="desired_outcomes" placeholder="Tell us what you are planning and where your team needs support." required maxlength="2000"></textarea></div>
          <div class="vnvp-field vnvp-field--full"><label for="np-sponsors">Existing sponsors or partners</label><textarea id="np-sponsors" name="existing_sponsors" maxlength="1200"></textarea></div>
          <fieldset class="vnvp-group"><legend>Support requested</legend><div class="vnvp-checks">
            {% for option in ['Event Production', 'Operational & Logistics Support', 'Technology & Digital Integration', 'Donor & Sponsor Connections'] %}<label class="vnvp-check"><input type="checkbox" name="requested_services[]" value="{{ option }}"><span>{{ option }}</span></label>{% endfor %}
          </div></fieldset>
          <div class="vnvp-field vnvp-field--full"><label for="np-time">Decision timeframe</label><input id="np-time" name="timeframe" maxlength="120"></div>
        </div>
        <label class="vnvp-consent"><input type="checkbox" name="consent" value="1" required><span>I agree that VNV Events may contact me about this request. I understand that submission does not guarantee approval, funding, sponsorship results, discounts or availability.</span></label>
        <button class="vnvp-button vnvp-button--gold" type="submit">Submit Nonprofit Application</button>
        <p class="vnvp-form-note">Your information is used to review this request and coordinate follow-up. It is not added to an unrelated prospect list without consent.</p>
      </form></details>
    </div>
  </section>
</main>
{% include "templates/components/publicQuickRequestModal.html.twig" with {
  quick_request_type: 'NONPROFIT',
  quick_request_source: 'nonprofit_exploratory_2027',
  quick_request_title: 'Request an Exploratory Meeting',
  quick_request_cta: 'Send Meeting Request'
} %}
{% include "templates/layout/publicFooterVnv.html.twig" %}
{% endblock %}

{% block scripts %}
<script>
(function(){const params=new URLSearchParams(location.search);document.querySelectorAll('[data-attribution]').forEach(function(input){input.value=input.dataset.attribution==='landing_url'?location.href:(params.get(input.dataset.attribution)||'');});})();
</script>
{% endblock %}
