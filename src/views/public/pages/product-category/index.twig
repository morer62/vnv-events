{% extends "templates/base.twig" %}

{% block title %}
    {{ category.meta_title ?: category.name ~ ' | VNV Events' }}
{% endblock %}

{% block meta_description %}
    {{ category.meta_description ?: category.description ?: 'Explore products by category' }}
{% endblock %}

{% block body %}
<style>
    :root{
        --pc-primary:#f59e0b;
        --pc-primary-dark:#d97706;
        --pc-accent:#fb923c;
        --pc-cream:#fff8ef;
        --pc-soft:#fff3df;
        --pc-dark:#1f1307;
        --pc-text:#2d241c;
        --pc-muted:#6f6255;
        --pc-border:#ecd9bf;
        --pc-shadow:0 18px 44px rgba(79,43,8,.10);
    }
    body{
        background:#fffaf4;
        color:var(--pc-text);
    }
    .pc-wrap{
        padding:42px 0 64px;
        position:relative;
        overflow:hidden;
    }
    .pc-wrap::before,
    .pc-wrap::after{
        content:"";
        position:absolute;
        border-radius:999px;
        pointer-events:none;
        filter:blur(2px);
    }
    .pc-wrap::before{
        width:380px;height:380px;
        top:-120px;right:-140px;
        background:radial-gradient(circle, rgba(245,158,11,.16), transparent 65%);
    }
    .pc-wrap::after{
        width:320px;height:320px;
        left:-120px;bottom:40px;
        background:radial-gradient(circle, rgba(251,146,60,.14), transparent 70%);
    }
    .pc-container{max-width:1220px;margin:0 auto;padding:0 16px;}
    .pc-breadcrumb{
        display:flex;gap:8px;flex-wrap:wrap;align-items:center;
        margin-bottom:14px;font-size:.88rem;color:var(--pc-muted);
    }
    .pc-breadcrumb a{
        color:var(--pc-primary-dark);
        text-decoration:none;
        font-weight:700;
    }
    .pc-badge{
        display:inline-flex;align-items:center;gap:8px;
        background:#fff;border:1px solid #f0d6b0;border-radius:999px;
        padding:8px 13px;font-size:.78rem;font-weight:900;
        color:#8b4f00;letter-spacing:.03em;text-transform:uppercase;
        margin-bottom:14px;
    }
    .pc-meta{
        margin-top:16px;
        display:flex;
        flex-wrap:wrap;
        gap:10px;
    }
    .pc-meta-chip{
        display:inline-flex;
        align-items:center;
        gap:6px;
        background:#fff;
        border:1px solid #f0d6b0;
        border-radius:999px;
        padding:8px 12px;
        font-size:.8rem;
        font-weight:800;
        color:#8b4f00;
    }
    .pc-hero{
        padding:38px;
        border:1px solid var(--pc-border);
        border-radius:26px;
        background:linear-gradient(135deg,#fff6e8 0%, #fffdf8 100%);
        box-shadow:var(--pc-shadow);
        margin-bottom:22px;
    }
    .pc-hero h1{
        margin:0 0 10px;
        font-size:clamp(2rem,4vw,3rem);
        font-weight:900;
        line-height:1.05;
        color:var(--pc-dark);
        letter-spacing:-.4px;
    }
    .pc-hero p{margin:0;color:var(--pc-muted);max-width:840px;line-height:1.7;}
    .pc-section{
        margin-bottom:20px;
        border:1px solid #efdec5;
        border-radius:24px;
        background:#fff;
        box-shadow:var(--pc-shadow);
        padding:22px;
    }
    .pc-section h2{
        font-size:1.45rem;
        font-weight:900;
        margin-bottom:12px;
        color:var(--pc-dark);
    }
    .pc-content{color:#564d43;line-height:1.8;font-size:1rem;}
    .pc-image{
        width:100%;
        border-radius:16px;
        border:1px solid #e9d5b8;
        box-shadow:0 12px 28px rgba(101,61,15,.08);
    }
    .pc-grid{display:grid;gap:14px;}
    .pc-grid.cols-1{grid-template-columns:repeat(1,minmax(0,1fr));}
    .pc-grid.cols-2{grid-template-columns:repeat(2,minmax(0,1fr));}
    .pc-grid.cols-3{grid-template-columns:repeat(3,minmax(0,1fr));}
    .pc-grid.cols-4{grid-template-columns:repeat(4,minmax(0,1fr));}
    .pc-card{
        border:1px solid #efdec7;border-radius:20px;background:#fff;overflow:hidden;display:flex;flex-direction:column;
        box-shadow:0 12px 28px rgba(101,61,15,.06);
        transition:transform .22s ease, box-shadow .22s ease;
        position:relative;
    }
    .pc-card:hover{
        transform:translateY(-4px);
        box-shadow:0 22px 38px rgba(101,61,15,.12);
    }
    .pc-card-badge{
        position:absolute;
        top:10px;
        left:10px;
        background:rgba(31,19,7,.82);
        color:#fff;
        border:1px solid rgba(255,255,255,.16);
        border-radius:999px;
        padding:6px 9px;
        font-size:.72rem;
        font-weight:800;
        letter-spacing:.03em;
        text-transform:uppercase;
    }
    .pc-card img{width:100%;height:205px;object-fit:cover;background:#f3f4f6;}
    .pc-card-body{padding:14px;display:flex;flex-direction:column;height:100%;}
    .pc-card-title{font-size:1.04rem;font-weight:900;color:var(--pc-dark);margin-bottom:6px;line-height:1.3;}
    .pc-card-desc{font-size:.92rem;color:var(--pc-muted);line-height:1.5;min-height:44px;}
    .pc-card-price{font-size:1.2rem;font-weight:900;color:var(--pc-primary-dark);margin-top:10px;}
    .pc-card-action{
        margin-top:12px;
        width:100%;
        border:1px solid #f0d2a2;
        border-radius:999px;
        padding:10px 12px;
        background:#fff8ec;
        color:#8b4f00;
        font-size:.85rem;
        font-weight:900;
        text-align:center;
        text-decoration:none;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        gap:8px;
        transition:all .2s ease;
    }
    .pc-card-action:hover{
        background:linear-gradient(135deg,var(--pc-primary),var(--pc-accent));
        color:#2a1a0f;
        transform:translateY(-1px);
    }
    .pc-empty{
        padding:30px;border:1px dashed #ead6b9;border-radius:18px;text-align:center;
        color:var(--pc-muted);background:#fffdf9;
    }
    .pc-cta{
        padding:24px;border-radius:20px;
        background:linear-gradient(135deg,var(--pc-primary),var(--pc-accent));
        color:#23160a;
    }
    .pc-cta h3{margin:0 0 8px;font-size:1.35rem;font-weight:900;}
    .pc-cta p{margin:0 0 16px;color:#3f2a14;line-height:1.7;}
    .pc-btn{
        display:inline-block;text-decoration:none;padding:10px 17px;border-radius:999px;
        background:#fff;color:#2a1a0f;font-weight:900;
        border:1px solid #f0d2a2;
    }
    .pc-divider{
        height:1px;
        background:linear-gradient(90deg, transparent, #eddabf, transparent);
        margin:8px 0 16px;
    }
    @media (max-width: 991px){
        .pc-grid.cols-3,.pc-grid.cols-4{grid-template-columns:repeat(2,minmax(0,1fr));}
    }
    @media (max-width: 640px){
        .pc-wrap{padding-top:24px;}
        .pc-hero{padding:22px;border-radius:20px;}
        .pc-section{padding:16px;border-radius:18px;}
        .pc-meta-chip{font-size:.75rem;}
        .pc-grid.cols-2,.pc-grid.cols-3,.pc-grid.cols-4{grid-template-columns:repeat(1,minmax(0,1fr));}
    }
</style>

<section class="pc-wrap">
    <div class="pc-container">
        <div class="pc-breadcrumb">
            <a href="{{ path('') }}">Home</a>
            <span>/</span>
            <span>Product Category</span>
            <span>/</span>
            <strong>{{ category.name }}</strong>
        </div>

        {% for b in blocks %}
            {% set type = b.type|default('text') %}

            {% if type == 'hero' %}
                <section class="pc-hero">
                    <span class="pc-badge">VNV Gourmet Category</span>
                    <h1>{{ b.title ?: category.name }}</h1>
                    {% if b.subtitle or category.description %}
                        <p>{{ b.subtitle ?: category.description }}</p>
                    {% endif %}
                    <div class="pc-meta">
                        <span class="pc-meta-chip">Freshly curated meals</span>
                        <span class="pc-meta-chip">{{ products|length }} products available</span>
                        <span class="pc-meta-chip">Miami premium delivery</span>
                    </div>
                </section>
            {% endif %}

            {% if type == 'text' %}
                <section class="pc-section">
                    {% if b.title %}<h2>{{ b.title }}</h2>{% endif %}
                    <div class="pc-content">{{ b.content|raw }}</div>
                </section>
            {% endif %}

            {% if type == 'image' %}
                <section class="pc-section">
                    {% if b.title %}<h2>{{ b.title }}</h2>{% endif %}
                    {% if b.image_url %}
                        <img class="pc-image" src="{{ b.image_url }}" alt="{{ b.title ?: category.name }}">
                    {% endif %}
                </section>
            {% endif %}

            {% if type == 'product_grid' %}
                {% set limit = b.limit|default(24) %}
                {% set columns = b.columns|default(3) %}
                <section class="pc-section">
                    <h2>{{ b.title ?: 'Products' }}</h2>
                    <div class="pc-divider"></div>
                    {% if products|length > 0 %}
                        <div class="pc-grid cols-{{ columns }}">
                            {% for p in products|slice(0, limit) %}
                                <article class="pc-card">
                                    <span class="pc-card-badge">Chef Pick</span>
                                    {% if p.main_image %}
                                        <img src="{{ p.main_image }}" alt="{{ p.name }}">
                                    {% endif %}
                                    <div class="pc-card-body">
                                        <div class="pc-card-title">{{ p.name }}</div>
                                        <div class="pc-card-desc">{{ p.short_description ?: 'Discover this product in our catalog.' }}</div>
                                        <div class="pc-card-price">${{ p.price|number_format(2, '.', ',') }}</div>
                                        <a
                                            class="pc-card-action"
                                            href="{{ path('store/cart') }}"
                                            data-add-to-plan
                                            data-id="{{ p.id }}"
                                            data-name="{{ p.name|e('html_attr') }}"
                                            data-slug="{{ p.slug|default('')|e('html_attr') }}"
                                            data-short-description="{{ (p.short_description ?: '')|e('html_attr') }}"
                                            data-description="{{ (p.description ?: '')|e('html_attr') }}"
                                            data-main-image="{{ (p.main_image ?: '')|e('html_attr') }}"
                                            data-price="{{ p.price|default(0) }}"
                                            data-stock-quantity="{{ p.stock_quantity|default(0) }}"
                                            data-min-purchase-qty="{{ p.min_purchase_qty|default(1) }}"
                                            data-max-purchase-qty="{{ p.max_purchase_qty is not null ? p.max_purchase_qty : '' }}"
                                            data-sku="{{ p.sku|default('')|e('html_attr') }}"
                                        >
                                            Add to plan
                                        </a>
                                    </div>
                                </article>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="pc-empty">No products in this category yet.</div>
                    {% endif %}
                </section>
            {% endif %}

            {% if type == 'cta' %}
                <section class="pc-section">
                    <div class="pc-cta">
                        <h3>{{ b.title ?: 'Ready to order?' }}</h3>
                        {% if b.content %}
                            <p>{{ b.content }}</p>
                        {% endif %}
                        {% if b.button_text and b.button_url %}
                            <a class="pc-btn" href="{{ b.button_url }}">{{ b.button_text }}</a>
                        {% endif %}
                    </div>
                </section>
            {% endif %}
        {% endfor %}
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const CHECKOUT_KEY = 'vnv_gourmet_checkout_selection';
    const DRAFT_KEY = 'vnv_gourmet_cart_draft';

    function toInt(value, fallback) {
        const n = parseInt(value, 10);
        return Number.isFinite(n) ? n : fallback;
    }

    function toFloat(value, fallback) {
        const n = parseFloat(value);
        return Number.isFinite(n) ? n : fallback;
    }

    function readSelection() {
        try {
            const raw = localStorage.getItem(CHECKOUT_KEY);
            if (!raw) return null;
            const parsed = JSON.parse(raw);
            return parsed && typeof parsed === 'object' ? parsed : null;
        } catch (e) {
            return null;
        }
    }

    function saveSelection(selection) {
        localStorage.setItem(CHECKOUT_KEY, JSON.stringify(selection));
        const quantities = {};
        (selection.items || []).forEach(function (item) {
            quantities[item.id] = item.quantity;
        });
        localStorage.setItem(DRAFT_KEY, JSON.stringify({
            audience: selection.audience || 'professional',
            mealStyle: selection.meal_style || 'balanced',
            quantities: quantities
        }));
    }

    document.querySelectorAll('[data-add-to-plan]').forEach(function (btn) {
        btn.addEventListener('click', function (event) {
            event.preventDefault();

            const id = toInt(btn.dataset.id, 0);
            if (!id) {
                window.location.href = btn.getAttribute('href');
                return;
            }

            const existing = readSelection();
            const selection = existing || {
                source: 'product-category',
                audience: 'professional',
                meal_style: 'balanced',
                membership_enabled: true,
                pricing_mode: 'SUBSCRIPTION',
                items: []
            };

            if (!Array.isArray(selection.items)) {
                selection.items = [];
            }

            const item = selection.items.find(function (x) {
                return toInt(x.id, 0) === id;
            });

            const stockQty = Math.max(0, toInt(btn.dataset.stockQuantity, 0));
            const maxPurchaseQty = btn.dataset.maxPurchaseQty !== '' ? Math.max(1, toInt(btn.dataset.maxPurchaseQty, 1)) : null;
            const maxAllowed = maxPurchaseQty !== null
                ? (stockQty > 0 ? Math.min(stockQty, maxPurchaseQty) : maxPurchaseQty)
                : stockQty;

            if (item) {
                const current = Math.max(0, toInt(item.quantity, 0));
                if (maxAllowed > 0) {
                    item.quantity = Math.min(current + 1, maxAllowed);
                } else {
                    item.quantity = current + 1;
                }
            } else {
                selection.items.push({
                    id: id,
                    name: btn.dataset.name || '',
                    slug: btn.dataset.slug || '',
                    short_description: btn.dataset.shortDescription || '',
                    description: btn.dataset.description || '',
                    main_image: btn.dataset.mainImage || '',
                    price: toFloat(btn.dataset.price, 0),
                    unit_price: toFloat(btn.dataset.price, 0),
                    quantity: 1,
                    line_total: toFloat(btn.dataset.price, 0),
                    stock_quantity: stockQty,
                    min_purchase_qty: Math.max(1, toInt(btn.dataset.minPurchaseQty, 1)),
                    max_purchase_qty: maxPurchaseQty,
                    categories: [],
                    audiences: [],
                    meal_styles: [],
                    attributes_grouped: {},
                    nutrition: null,
                    sku: btn.dataset.sku || ''
                });
            }

            selection.total_meals = selection.items.reduce(function (sum, it) {
                return sum + Math.max(0, toInt(it.quantity, 0));
            }, 0);
            selection.subtotal = Number(selection.items.reduce(function (sum, it) {
                const q = Math.max(0, toInt(it.quantity, 0));
                return sum + (q * toFloat(it.price, 0));
            }, 0).toFixed(2));
            selection.total = selection.subtotal;
            selection.saved_at = new Date().toISOString();

            saveSelection(selection);
            window.location.href = btn.getAttribute('href');
        });
    });
});
</script>
{% endblock %}
