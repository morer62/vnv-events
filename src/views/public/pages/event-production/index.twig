{% extends "templates/base.twig" %}

{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&display=swap" rel="stylesheet">

<style>
:root {
    --vnv-primary: #5EC6C4;
    --vnv-primary-dark: #4aa8a6;
    --vnv-gold: #c5a059;
    --vnv-gold-gradient: linear-gradient(135deg, #bf953f 0%, #fcf6ba 45%, #b38728 100%);
    --vnv-dark-deep: #0a0c0c;
    --vnv-dark-soft: #141818;
    --vnv-dark-card: #1b2021;
    --vnv-light: #ffffff;
    --vnv-marble: #f4f7f8;
    --vnv-text-main: #2d3436;
    --vnv-text-dark: #11181a;
    --vnv-text-light: #f3f5f6;
    --vnv-text-muted: rgba(255,255,255,.74);
    --vnv-text-muted-soft: rgba(255,255,255,.60);
    --vnv-border: rgba(255,255,255,.08);
}

html { scroll-behavior: smooth; }

body {
    background: var(--vnv-dark-deep);
    color: var(--vnv-text-light);
    font-family: 'Plus Jakarta Sans', sans-serif;
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
}

h1, h2, h3, h4, h5, .luxury-font {
    font-family: 'Playfair Display', serif;
}

.text-vnv { color: var(--vnv-primary) !important; }
.text-gold {
    background: var(--vnv-gold-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.letter-spacing-lg { letter-spacing: 4px; }

.vnv-btn {
    padding: 18px 30px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    transition: all .35s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: .78rem;
    border-radius: 999px;
}

.btn-gold-vnv {
    background: var(--vnv-gold-gradient);
    color: #000 !important;
}
.btn-gold-vnv:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 40px rgba(197,160,89,.22);
}
.btn-outline-vnv {
    border: 2px solid var(--vnv-primary);
    color: var(--vnv-primary) !important;
    background: transparent;
}
.btn-outline-vnv:hover {
    background: var(--vnv-primary);
    color: #fff !important;
}
.btn-ghost-white {
    border: 1px solid rgba(255,255,255,.18);
    color: #fff !important;
    background: transparent;
}
.btn-ghost-white:hover {
    background: #fff;
    color: #000 !important;
}

.section-vnv {
    padding: 120px 0;
    position: relative;
}

.vnv-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border-radius: 999px;
    background: rgba(94,198,196,.1);
    color: var(--vnv-primary);
    font-size: .74rem;
    letter-spacing: 2px;
    font-weight: 800;
    text-transform: uppercase;
}

.hero-production {
    position: relative;
    min-height: 94vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
        linear-gradient(90deg, rgba(10,12,12,.92) 0%, rgba(10,12,12,.70) 44%, rgba(10,12,12,.40) 100%),
        url('{{ asset_for('assets/images/production1.jpg') }}') center/cover no-repeat;
}

.hero-production::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(circle at top right, rgba(94,198,196,.16), transparent 28%),
        radial-gradient(circle at bottom left, rgba(197,160,89,.10), transparent 24%);
    pointer-events: none;
}

.hero-production-inner {
    position: relative;
    z-index: 2;
    width: 100%;
}

.hero-production h1 {
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 1.01;
    margin: 20px 0 24px;
    max-width: 1020px;
}

.hero-production p.hero-copy {
    font-size: 1.1rem;
    color: var(--vnv-text-muted);
    max-width: 680px;
    margin-bottom: 26px;
}

.hero-services-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 30px;
}
.hero-services-row span {
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,.18);
    font-size: .74rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: rgba(255,255,255,.8);
}

.hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 20px;
}

/* Trust stats bar */
.trust-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 44px;
    margin-top: 42px;
}
.trust-stat .num {
    font-family: 'Playfair Display', serif;
    font-size: 2.4rem;
    font-weight: 900;
    line-height: 1;
    background: var(--vnv-gold-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}
.trust-stat .label {
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--vnv-text-muted-soft);
    margin-top: 4px;
}

.section-white {
    background: var(--vnv-marble);
    color: var(--vnv-text-dark);
}

.section-dark {
    background: var(--vnv-dark-deep);
    color: var(--vnv-text-light);
}

.section-heading {
    max-width: 960px;
    margin-bottom: 55px;
}
.section-heading h2 {
    font-size: clamp(2.2rem, 4vw, 4.2rem);
    line-height: 1.04;
    margin: 16px 0 18px;
}
.section-heading p {
    font-size: 1.05rem;
    margin: 0;
}
.section-white .section-heading p {
    color: #566164;
}
.section-dark .section-heading p {
    color: var(--vnv-text-muted);
}

.intro-wrap {
    display: grid;
    grid-template-columns: 1.05fr .95fr;
    gap: 40px;
    align-items: center;
}

.intro-image-card {
    border-radius: 30px;
    overflow: hidden;
    box-shadow: 0 25px 70px rgba(0,0,0,.10);
    border: 1px solid rgba(17,24,26,.08);
    background: #fff;
}

.intro-image-card img {
    width: 100%;
    min-height: 430px;
    object-fit: cover;
    display: block;
}

.intro-panel {
    background: linear-gradient(145deg, #161a1b 0%, #0d0f0f 100%);
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 30px;
    padding: 40px;
    box-shadow: 0 25px 70px rgba(0,0,0,.12);
    color: #fff;
}

.intro-panel h3 {
    font-size: 2rem;
    color: #fff;
    margin-bottom: 20px;
}

.intro-panel p,
.intro-panel li {
    color: rgba(255,255,255,.78);
}

.intro-panel ul {
    list-style: none;
    padding: 0;
    margin: 25px 0 0;
}
.intro-panel ul li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 10px;
}
.intro-panel ul li::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vnv-gold);
    position: absolute;
    left: 0;
    top: 12px;
}

.services-bg-video-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
}

.services-bg-video {
    width: 100%;
    height: 120%;
    object-fit: cover;
    object-position: center center;
    opacity: 0.12;
    filter: blur(2px) saturate(0.8);
    transform: translateY(-6%);
}

.services-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to bottom,
        rgba(10,12,12,0.25),
        rgba(10,12,12,0.30),
        rgba(10,12,12,0.25)
    );
}

.service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.service-card {
    background: rgba(28, 34, 35, 0.82);
    backdrop-filter: blur(6px);
    border-radius: 28px;
    padding: 42px 34px;
    border: 1px solid rgba(197, 160, 89, 0.08);
    height: 100%;
    position: relative;
    z-index: 2;
    transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
}

.service-card:hover {
    transform: translateY(-8px);
    border-color: var(--vnv-gold);
}

.service-card h3 {
    color: #fff;
    font-size: 1.7rem;
    margin-bottom: 14px;
}
.service-card p,
.service-card li {
    color: var(--vnv-text-muted);
}

.service-icon-box {
    width: 60px;
    height: 60px;
    background: rgba(197, 160, 89, 0.1);
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--vnv-gold);
    font-size: 1.6rem;
    margin-bottom: 24px;
}

/* Jonnys.media banner */
.jonnys-banner {
    margin-top: 30px;
    background: linear-gradient(120deg, rgba(197,160,89,.10) 0%, rgba(94,198,196,.06) 100%);
    border: 2px solid var(--vnv-gold);
    border-radius: 30px;
    padding: 44px 42px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 30px;
    align-items: center;
    position: relative;
    z-index: 2;
}
.jonnys-banner-icon {
    width: 68px;
    height: 68px;
    border-radius: 20px;
    background: var(--vnv-gold-gradient);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #000;
    font-size: 1.8rem;
    flex-shrink: 0;
}
.jonnys-banner h3 {
    color: #fff;
    font-size: 1.6rem;
    margin-bottom: 10px;
}
.jonnys-banner p {
    color: var(--vnv-text-muted);
    margin: 0;
    max-width: 640px;
}
.jonnys-banner-cta {
    white-space: nowrap;
}

/* Ecosystem grid */
.ecosystem-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}
.ecosystem-card {
    background: #fff;
    border: 1px solid rgba(17,24,26,.08);
    border-radius: 28px;
    padding: 36px 32px;
    box-shadow: 0 20px 60px rgba(0,0,0,.06);
    height: 100%;
    transition: all 0.4s ease;
    display: flex;
    flex-direction: column;
}
.ecosystem-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 30px 70px rgba(0,0,0,.10);
}
.ecosystem-card .service-icon-box {
    background: rgba(94,198,196,.1);
    color: var(--vnv-primary-dark);
}
.ecosystem-card h3 {
    color: var(--vnv-text-dark);
    font-size: 1.35rem;
    margin-bottom: 10px;
}
.ecosystem-card p {
    color: #566164;
    margin-bottom: 18px;
    flex-grow: 1;
}
.ecosystem-card a {
    color: var(--vnv-primary-dark) !important;
    font-weight: 800;
    letter-spacing: 1px;
    font-size: .78rem;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-transform: uppercase;
}
.ecosystem-card a:hover { gap: 14px; }
.ecosystem-card.featured {
    border: 2px solid var(--vnv-gold);
    background: linear-gradient(160deg, #fff 0%, #fdf9f1 100%);
}
.ecosystem-card.featured .service-icon-box {
    background: var(--vnv-gold-gradient);
    color: #000;
}
.ecosystem-card.featured a {
    color: #96762f !important;
}

/* Old way vs VNV way comparison */
.compare-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px;
}
.compare-card {
    border-radius: 28px;
    padding: 44px 38px;
    height: 100%;
}
.compare-card.old {
    background: rgba(255,255,255,.03);
    border: 1px solid rgba(255,255,255,.08);
}
.compare-card.new {
    background: rgba(197,160,89,.06);
    border: 2px solid var(--vnv-gold);
    box-shadow: 0 25px 70px rgba(197,160,89,.14);
}
.compare-card h3 {
    color: #fff;
    font-size: 1.7rem;
    margin-bottom: 22px;
}
.compare-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
}
.compare-card ul li {
    position: relative;
    padding-left: 30px;
    margin-bottom: 16px;
    color: var(--vnv-text-muted);
}
.compare-card.old ul li::before {
    content: "✕";
    position: absolute;
    left: 0;
    top: 1px;
    color: rgba(255,255,255,.35);
    font-size: .82rem;
    font-weight: 700;
}
.compare-card.new ul li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 1px;
    color: var(--vnv-primary);
    font-weight: 800;
    font-size: .9rem;
}

.process-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
}

.process-step {
    background: #fff;
    border: 1px solid rgba(17,24,26,.08);
    border-radius: 28px;
    padding: 34px 30px;
    box-shadow: 0 20px 60px rgba(0,0,0,.08);
    height: 100%;
    position: relative;
}

.process-number {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(94,198,196,.12);
    color: var(--vnv-primary-dark);
    font-weight: 800;
    font-size: 1rem;
    margin-bottom: 18px;
}

.process-step h3 {
    color: var(--vnv-text-dark);
    font-size: 1.6rem;
    margin-bottom: 12px;
}

.process-step p,
.process-step li {
    color: #4f5b5f;
}

.process-step ul {
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
}
.process-step ul li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 10px;
}
.process-step ul li::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vnv-gold);
    position: absolute;
    left: 0;
    top: 11px;
}

.production-wrap {
    display: grid;
    grid-template-columns: .95fr 1.05fr;
    gap: 40px;
    align-items: stretch;
}

.production-image-stack {
    display: grid;
    gap: 24px;
}

.production-image-stack img {
    width: 100%;
    border-radius: 26px;
    object-fit: cover;
    display: block;
    box-shadow: 0 20px 60px rgba(0,0,0,.10);
    border: 1px solid rgba(17,24,26,.08);
}

.production-image-stack img:first-child,
.production-image-stack img:last-child {
    min-height: 260px;
    max-height: 260px;
}

.production-panel {
    background: #fff;
    border: 1px solid rgba(17,24,26,.08);
    border-radius: 30px;
    padding: 42px;
    box-shadow: 0 25px 70px rgba(0,0,0,.08);
}

.production-panel h3 {
    font-size: 2rem;
    color: var(--vnv-text-dark);
    margin-bottom: 18px;
}

.production-panel p,
.production-panel li {
    color: #4f5b5f;
}

.production-panel ul {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
}
.production-panel ul li {
    position: relative;
    padding-left: 24px;
    margin-bottom: 12px;
}
.production-panel ul li::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vnv-primary);
    position: absolute;
    left: 0;
    top: 12px;
}

.scope-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
}

.scope-card {
    background: #fff;
    border: 1px solid rgba(17,24,26,.08);
    border-radius: 28px;
    padding: 30px 24px;
    box-shadow: 0 20px 60px rgba(0,0,0,.08);
    height: 100%;
}

.scope-card h4 {
    color: var(--vnv-text-dark);
    font-size: 1.22rem;
    margin-bottom: 10px;
}
.scope-card p {
    color: #4f5b5f;
    margin: 0;
}

.blueprint-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.blueprint-card {
    background: linear-gradient(145deg, #161a1b 0%, #0d0f0f 100%);
    border-radius: 30px;
    padding: 34px 30px;
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow: 0 20px 60px rgba(0,0,0,0.30);
    height: 100%;
}

.blueprint-card h3 {
    color: #fff;
    font-size: 1.55rem;
    margin-bottom: 12px;
}

.blueprint-card p,
.blueprint-card li {
    color: rgba(255,255,255,.72);
}

.blueprint-card ul {
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
}
.blueprint-card ul li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 10px;
}
.blueprint-card ul li::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--vnv-primary);
    position: absolute;
    left: 0;
    top: 11px;
}

/* FAQ */
.faq-wrap {
    max-width: 880px;
    margin: 0 auto;
}
.faq-item {
    border-bottom: 1px solid rgba(255,255,255,.08);
    padding: 26px 0;
}
.faq-item:last-child { border-bottom: none; }
.faq-item h4 {
    font-size: 1.15rem;
    color: #fff;
    margin-bottom: 8px;
}
.faq-item p {
    color: var(--vnv-text-muted);
    margin: 0;
}

.location-block {
    position: relative;
    overflow: hidden;
}

.location-block::before {
    content: "";
    position: absolute;
    top: -120px;
    left: -120px;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(94,198,196,0.14) 0%, transparent 70%);
    pointer-events: none;
}

.vnv-location-card {
    background: linear-gradient(145deg, #161a1b 0%, #0d0f0f 100%);
    border-radius: 30px;
    padding: 50px;
    border: 1px solid rgba(255,255,255,0.06);
    box-shadow: 0 20px 60px rgba(0,0,0,0.35);
}

.vnv-location-card h3 {
    font-size: 1.8rem;
    font-weight: 800;
}

.vnv-location-card p {
    color: rgba(255,255,255,0.7);
    margin-bottom: 20px;
}

.vnv-location-info {
    display: flex;
    gap: 12px;
    align-items: center;
    color: #fff;
    font-weight: 600;
    margin-bottom: 18px;
}

.vnv-location-info i {
    color: var(--vnv-primary);
}

.location-gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.location-gallery-grid img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 22px;
    display: block;
    border: 1px solid rgba(255,255,255,.08);
}

.final-cta-card {
    background: linear-gradient(145deg, #161a1b 0%, #0d0f0f 100%);
    border-radius: 45px;
    padding: 90px 70px;
    border: 1px solid rgba(255,255,255,.06);
    position: relative;
    overflow: hidden;
}

.final-cta-card::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 10%;
    width: 360px;
    height: 360px;
    transform: translateY(-50%);
    background: radial-gradient(circle, rgba(94, 198, 196, 0.08) 0%, transparent 70%);
    pointer-events: none;
}

.final-cta-card p {
    color: var(--vnv-text-muted-soft);
}

.final-cta-note {
    font-size: .85rem;
    color: var(--vnv-primary);
    margin-top: 18px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 700;
}

.vnv-btn-fixed {
    min-width: 240px;
    text-align: center;
    white-space: normal;
    line-height: 1.35;
    padding: 20px 28px;
}

@media (max-width: 1199px) {
    .scope-grid,
    .blueprint-grid,
    .ecosystem-grid {
        grid-template-columns: 1fr 1fr;
    }
    .final-cta-card {
        padding: 60px 45px;
    }
    .jonnys-banner {
        grid-template-columns: auto 1fr;
    }
    .jonnys-banner-cta {
        grid-column: 1 / -1;
    }
}

@media (max-width: 991px) {
    .intro-wrap,
    .production-wrap,
    .process-grid,
    .compare-grid {
        grid-template-columns: 1fr;
    }

    .service-grid,
    .scope-grid,
    .blueprint-grid,
    .ecosystem-grid {
        grid-template-columns: 1fr;
    }

    .intro-panel,
    .production-panel,
    .vnv-location-card {
        padding: 32px 28px;
    }

    .jonnys-banner {
        grid-template-columns: 1fr;
        text-align: center;
        padding: 36px 28px;
    }
    .jonnys-banner-icon { margin: 0 auto; }

    .final-cta-card {
        padding: 50px 30px;
        text-align: center;
    }

    .vnv-btn-fixed {
        min-width: 100%;
    }

    .services-bg-video {
        height: 100%;
        transform: none;
        filter: blur(1px) saturate(0.8);
    }
}

@media (max-width: 767px) {
    .section-vnv {
        padding: 90px 0;
    }

    .hero-production h1 {
        font-size: 2.7rem;
    }

    .vnv-btn {
        width: 100%;
        padding: 18px 24px;
        letter-spacing: 2px;
    }

