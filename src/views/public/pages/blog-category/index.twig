 

{% extends "templates/base.twig" %}

{% block title %}
    {{ category.meta_title ?: category.name ~ ' | VNV Events Blog' }}
{% endblock %}

{% block meta_description %}
    {{ category.meta_description ?: category.description ?: 'VNV Events blog category' }}
{% endblock %}

{% block body %}
<style>
    :root{
      --vnv-bg:#f6f1e8;
      --vnv-surface:#ffffff;
      --vnv-text:#171717;
      --vnv-muted:#6b6358;
      --vnv-border:#e8ddcc;
      --vnv-primary:#15161d;
      --vnv-primary-soft:#252a33;
      --vnv-accent:#3f4553;
      --vnv-highlight:#c8a86b;
      --vnv-radius-lg:24px;
      --vnv-shadow:0 18px 42px rgba(24,18,10,.14);
    }

    body{
      font-family:"Inter",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
      color:var(--vnv-text);
      background:
        radial-gradient(circle at 10% 0%, rgba(200,168,107,.2), transparent 34%),
        radial-gradient(circle at 88% 14%, rgba(23,27,38,.1), transparent 40%),
        linear-gradient(180deg,#fff 0%,var(--vnv-bg) 100%);
    }

    body::before{
      display:none !important;
      content:none !important;
    }

    html, body{
      overflow-x:hidden;
    }

    .blog-cat-shell{ padding:72px 0 82px; position:relative; }

    .blog-cat-hero{
      background:linear-gradient(135deg,var(--vnv-primary) 0%,var(--vnv-primary-soft) 58%,var(--vnv-accent) 100%);
      color:#fff;
      border-radius:30px;
      padding:42px 36px;
      box-shadow:0 30px 68px rgba(10,10,14,.28);
      margin-bottom:38px;
      position:relative;
      overflow:hidden;
      border:1px solid rgba(255,255,255,.16);
    }

    .blog-cat-hero::before{
      content:"";
      position:absolute;
      inset:0;
      pointer-events:none;
      background:
        linear-gradient(110deg, rgba(255,255,255,.14), transparent 35%),
        radial-gradient(circle at 90% 10%, rgba(200,168,107,.35), transparent 38%);
    }

    .blog-cat-eyebrow{
      display:inline-flex;
      align-items:center;
      gap:8px;
      border:1px solid rgba(200,168,107,.56);
      background:rgba(200,168,107,.18);
      border-radius:999px;
      padding:8px 14px;
      font-weight:800;
      font-size:.78rem;
      margin-bottom:12px;
      letter-spacing:.08em;
      text-transform:uppercase;
      color:#faecd1;
    }

    .blog-cat-title{
      font-size:clamp(2.3rem,4.2vw,3.6rem);
      line-height:1.04;
      margin:0 0 12px;
      font-weight:700;
      letter-spacing:-.4px;
      font-family:Georgia,"Times New Roman",serif;
      text-wrap:balance;
    }

    .blog-cat-desc{
      margin:0;
      color:rgba(255,255,255,.92);
      max-width:780px;
      line-height:1.86;
      font-size:1.03rem;
    }

    .blog-grid{
      display:grid;
      grid-template-columns:repeat(auto-fill,minmax(300px,1fr));
      gap:24px;
    }

    .blog-card{
      background:var(--vnv-surface);
      border:1px solid var(--vnv-border);
      border-radius:var(--vnv-radius-lg);
      overflow:hidden;
      box-shadow:var(--vnv-shadow);
      transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease;
      position:relative;
    }

    .blog-card::after{
      content:"";
      position:absolute;
      inset:0;
      border:1px solid rgba(200,168,107,.22);
      border-radius:inherit;
      opacity:0;
      pointer-events:none;
      transition:.25s ease;
    }

    .blog-card:hover{
      transform:translateY(-7px);
      box-shadow:0 28px 54px rgba(18,13,8,.19);
      border-color:#dcc7a0;
    }

    .blog-card:hover::after{ opacity:1; }

    .blog-card a{ text-decoration:none; color:inherit; display:block; }

    .blog-card img{
      width:100%;
      height:220px;
      object-fit:cover;
      transition:transform .4s ease, filter .3s ease;
      filter:saturate(1.03);
    }

    .blog-card:hover img{ transform:scale(1.05); filter:saturate(1.12); }

    .blog-card-body{ padding:20px 20px 22px; }

    .blog-card-title{
      font-size:1.2rem;
      font-weight:700;
      line-height:1.3;
      color:var(--vnv-text);
      margin-bottom:11px;
      font-family:Georgia,"Times New Roman",serif;
    }

    .blog-card-excerpt{
      color:var(--vnv-muted);
      font-size:.94rem;
      line-height:1.74;
      margin-bottom:16px;
      display:-webkit-box;
      -webkit-line-clamp:3;
      -webkit-box-orient:vertical;
      overflow:hidden;
    }

    .blog-card-cta{
      display:inline-flex;
      align-items:center;
      gap:8px;
      font-size:.8rem;
      font-weight:800;
      color:#7e5f2d;
      letter-spacing:.07em;
      text-transform:uppercase;
    }

    .blog-card-cta::after{ content:"→"; }

    .blog-empty{
      text-align:center;
      background:var(--vnv-surface);
      border:1px dashed #cbb79a;
      border-radius:var(--vnv-radius-lg);
      padding:44px 22px;
      color:var(--vnv-muted);
      box-shadow:var(--vnv-shadow);
    }

    .blog-empty strong{
      display:block;
      color:var(--vnv-text);
      margin-bottom:8px;
      font-family:Georgia,"Times New Roman",serif;
      font-size:1.2rem;
    }

    @media (max-width:768px){
      .blog-cat-shell{ padding:52px 0 60px; }
      .blog-cat-hero{ border-radius:22px; padding:28px 20px; }
      .blog-grid{ grid-template-columns:1fr; gap:18px; }
    }
</style>

<section class="blog-cat-shell">
    <div class="container">
        <div class="blog-cat-hero">
            <div class="blog-cat-eyebrow">Blog Category</div>
            <h1 class="blog-cat-title">{{ category.name }}</h1>
            {% if category.description %}
                <p class="blog-cat-desc">{{ category.description }}</p>
            {% endif %}
        </div>

        {% if posts|length > 0 %}
            <div class="blog-grid">
                {% for post in posts %}
                    <div class="blog-card">
                        <a href="{{ path((post.main_route ?: ('/' ~ post.slug ~ '/'))|trim('/')) }}">
                            {% if post.featured_image_url %}
                                <img src="{{ post.featured_image_url }}" alt="{{ post.title }}">
                            {% endif %}

                            <div class="blog-card-body">
                                <div class="blog-card-title">{{ post.title }}</div>

                                {% if post.excerpt %}
                                    <div class="blog-card-excerpt">
                                        {{ post.excerpt|slice(0, 120) }}...
                                    </div>
                                {% endif %}
                                <span class="blog-card-cta">Read article</span>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="blog-empty">
                <strong>No articles found yet</strong>
                No articles found in this category yet.
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}