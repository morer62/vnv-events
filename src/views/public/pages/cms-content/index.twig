{% extends "templates/base.twig" %}

{% block title %}
    {{ page.meta_title ?: page.title ~ ' | VNV Events' }}
{% endblock %}

{% block meta_description %}
    {{ page.meta_description ?: page.excerpt ?: 'VNV Events page' }}
{% endblock %}

{% block meta_keywords %}
    {{ page.meta_keywords ?: 'VNV Events, South Florida events' }}
{% endblock %}

{% block canonical %}
    {{ page.canonical_url ?: ('https://vnvevents.com' ~ route.route) }}
{% endblock %}

{% block og_title %}
    {{ page.og_title ?: page.meta_title ?: page.title }}
{% endblock %}

{% block og_description %}
    {{ page.og_description ?: page.meta_description ?: page.excerpt ?: 'VNV Events page' }}
{% endblock %}

{% block og_url %}
    {{ page.canonical_url ?: ('https://vnvevents.com' ~ route.route) }}
{% endblock %}

{% block og_image %}
    {{ page.featured_image_url ?: asset_for('assets/images/planner-hub-logo-negative.png') }}
{% endblock %}

{% block body %}
    {% include "templates/layout/publicHeaderVnv.html.twig" %}
    <section class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <nav class="mb-4 small text-muted" aria-label="Breadcrumb">
                    <a href="{{ path('') }}" class="text-decoration-none">Home</a>
                    <span class="mx-2">/</span>
                    <span>{{ page.title }}</span>
                </nav>

                {% if page.featured_image_url %}
                    <div class="mb-4">
                        <img
                            src="{{ page.featured_image_url }}"
                            alt="{{ page.title }}"
                            class="img-fluid rounded-4 w-100"
                            style="max-height: 420px; object-fit: cover;"
                        >
                    </div>
                {% endif %}

                <header class="mb-4">
                    <h1 class="display-5 fw-bold mb-3">{{ page.title }}</h1>

                    {% if page.excerpt %}
                        <p class="lead text-muted mb-0">{{ page.excerpt }}</p>
                    {% endif %}
                </header>

                {% set template_key = page.template_key|default('default') %}

                {% if page.body_html %}
                    <div class="cms-public-body cms-preview-template-{{ template_key }}">
                        {{ page.body_html|raw }}
                    </div>
                {% elseif page.body %}
                    <div class="cms-public-body cms-preview-template-{{ template_key }}">
                        {{ page.body|raw }}
                    </div>
                {% elseif content_json.hero or content_json.blocks %}
                    <div class="cms-public-body cms-preview-template-{{ template_key }}">
                        {% if content_json.hero %}
                            <section class="mb-4">
                                {% if content_json.hero.title %}
                                    <h2>{{ content_json.hero.title }}</h2>
                                {% endif %}
                                {% if content_json.hero.subtitle %}
                                    <p>{{ content_json.hero.subtitle }}</p>
                                {% endif %}
                            </section>
                        {% endif %}

                        {% if content_json.blocks %}
                            {% for block in content_json.blocks %}
                                <section class="mb-4">
                                    {% if block.title %}
                                        <h3>{{ block.title }}</h3>
                                    {% endif %}
                                    {% if block.content %}
                                        <div>{{ block.content|raw }}</div>
                                    {% endif %}
                                </section>
                            {% endfor %}
                        {% endif %}
                    </div>
                {% else %}
                    <div class="alert alert-light border">
                        This page has no public body content yet.
                    </div>
                {% endif %}

                {% if internal_links is defined and internal_links is not empty %}
                    <nav class="mt-5 d-flex flex-wrap gap-2" aria-label="Related VNV Events links">
                        {% for link in internal_links %}
                            <a class="btn btn-outline-dark btn-sm" href="{{ link.url }}">{{ link.label }}</a>
                        {% endfor %}
                    </nav>
                {% endif %}
            </div>
        </div>
    </section>

    {% if page.custom_head %}
        {{ page.custom_head|raw }}
    {% endif %}
    {% include "templates/components/publicEventRequestModal.html.twig" %}
    {% include "templates/layout/publicFooterVnv.html.twig" %}
{% endblock %}

{% block styles %}
    {{ parent() }}
    <style>
        .cms-public-body .cms-block-media-text {
            display: block;
        }

        .cms-public-body .cms-media-text-grid {
            display: grid;
            gap: 1.5rem;
        }

        .cms-public-body .cms-media-text-row {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 1.5rem;
            align-items: center;
        }

        .cms-public-body .cms-image-copy h3 {
            margin-top: 0;
        }

        .cms-public-body .cms-image-copy p {
            color: inherit;
            font-size: 1rem;
            line-height: 1.75;
        }

        .cms-public-body .cms-image-copy ul {
            margin: 1rem 0 0;
            padding-left: 1.15rem;
        }

        .cms-public-body .cms-image-copy li {
            margin-bottom: .45rem;
            line-height: 1.6;
        }

        .cms-public-body .cms-media-text-row figure {
            margin: 0;
        }

        .cms-public-body .cms-image-generated img,
        .cms-public-body .cms-image-placeholder img {
            width: 100%;
            height: auto;
            aspect-ratio: 4 / 3;
            object-fit: cover;
            display: block;
            border-radius: 18px;
        }

        .cms-public-body .cms-image-generated figcaption,
        .cms-public-body .cms-image-placeholder figcaption {
            margin-top: .45rem;
            font-size: .82rem;
            color: #6b6358;
        }

        @media (max-width: 760px) {
            .cms-public-body .cms-media-text-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
    {% if page.custom_css %}
        <style>
            {{ page.custom_css|raw }}
        </style>
    {% endif %}
    {% if page.template_css_text %}
        <style>
            {{ page.template_css_text|raw }}
        </style>
    {% endif %}
{% endblock %}
