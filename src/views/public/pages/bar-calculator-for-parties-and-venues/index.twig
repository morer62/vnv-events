{% extends "templates/base.twig" %}

{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;0,900;1,700;1,900&display=swap" rel="stylesheet">

<style>
:root{
    --vnv-primary:#5EC6C4;
    --vnv-primary-dark:#4aa8a6;
    --vnv-gold:#c5a059;
    --vnv-gold-gradient:linear-gradient(135deg,#bf953f 0%,#fcf6ba 45%,#b38728 100%);
    --vnv-dark-deep:#0a0c0c;
    --vnv-dark-soft:#141818;
    --vnv-dark-card:#1b2021;
    --vnv-light:#ffffff;
    --vnv-marble:#f4f7f8;
    --vnv-text-dark:#11181a;
    --vnv-text-light:#f3f5f6;
    --vnv-text-muted:rgba(255,255,255,.72);
    --vnv-text-muted-soft:rgba(255,255,255,.58);
    --vnv-border:rgba(255,255,255,.08);
    --vnv-shadow:0 25px 70px rgba(0,0,0,.14);
    --success:#26c281;
    --warning:#f4b740;
    --danger:#ff5f6d;
}

html { scroll-behavior:smooth; }

body{
    background:var(--vnv-dark-deep);
    color:var(--vnv-text-light);
    font-family:'Plus Jakarta Sans',sans-serif;
    line-height:1.8;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
}

h1,h2,h3,h4,h5,.luxury-font{
    font-family:'Playfair Display',serif;
}

.text-vnv{ color:var(--vnv-primary)!important; }

.text-gold{
    background:var(--vnv-gold-gradient);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
}

.vnv-btn{
    padding:18px 30px;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:2px;
    transition:all .35s ease;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    text-decoration:none;
    border:none;
    cursor:pointer;
    font-size:.78rem;
    border-radius:999px;
}

.btn-gold-vnv{
    background:var(--vnv-gold-gradient);
    color:#000!important;
}
.btn-gold-vnv:hover{
    transform:translateY(-3px);
    box-shadow:0 20px 40px rgba(197,160,89,.22);
}

.btn-outline-vnv{
    border:2px solid var(--vnv-primary);
    color:var(--vnv-primary)!important;
    background:transparent;
}
.btn-outline-vnv:hover{
    background:var(--vnv-primary);
    color:#fff!important;
}

.section-vnv{
    padding:120px 0;
    position:relative;
}

.vnv-badge{
    display:inline-flex;
    align-items:center;
    gap:10px;
    padding:10px 18px;
    border-radius:999px;
    background:rgba(94,198,196,.1);
    color:var(--vnv-primary);
    font-size:.74rem;
    letter-spacing:2px;
    font-weight:800;
    text-transform:uppercase;
}

.hero-tool{
    position:relative;
    min-height:82vh;
    display:flex;
    align-items:center;
    overflow:hidden;
    background:
        linear-gradient(90deg, rgba(10,12,12,.90) 0%, rgba(10,12,12,.66) 44%, rgba(10,12,12,.38) 100%),
        url('{{ asset_for('assets/images/tool-staff-calculator-hero.jpg') }}') center/cover no-repeat;
}

.hero-tool::after{
    content:"";
    position:absolute;
    inset:0;
    background:
        radial-gradient(circle at top right, rgba(94,198,196,.16), transparent 28%),
        radial-gradient(circle at bottom left, rgba(197,160,89,.10), transparent 24%);
    pointer-events:none;
}

.hero-tool-inner{
    position:relative;
    z-index:2;
    width:100%;
}

.hero-tool h1{
    font-size:clamp(3rem,6vw,5.4rem);
    line-height:1.02;
    margin:20px 0 28px;
    max-width:980px;
}

.hero-tool p.hero-copy{
    font-size:1.08rem;
    color:var(--vnv-text-muted);
    max-width:840px;
    margin-bottom:22px;
}

.hero-cta-row{
    display:flex;
    flex-wrap:wrap;
    gap:16px;
    margin-top:24px;
}

.section-white{
    background:var(--vnv-marble);
    color:var(--vnv-text-dark);
}

.tool-shell{
    background:linear-gradient(145deg, #151a1b 0%, #0c0f10 100%);
    border-radius:34px;
    border:1px solid rgba(255,255,255,.06);
    box-shadow:0 26px 80px rgba(0,0,0,.22);
    overflow:hidden;
}

.tool-topbar{
    padding:18px 22px;
    background:#0c0f10;
    border-bottom:1px solid rgba(255,255,255,.06);
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:16px;
    flex-wrap:wrap;
}

.tool-topbar-left{
    display:flex;
    align-items:center;
    gap:14px;
}

.tool-topbar-icon{
    width:46px;
    height:46px;
    border-radius:14px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(94,198,196,.12);
    color:var(--vnv-primary);
    font-size:1.15rem;
}

.tool-topbar-title{
    color:#fff;
    font-weight:800;
    font-size:1rem;
    line-height:1.2;
}

.tool-topbar-sub{
    color:var(--vnv-text-muted-soft);
    font-size:.8rem;
    font-weight:700;
}

.tool-topbar-note{
    color:rgba(255,255,255,.62);
    font-size:.88rem;
    font-weight:700;
}

.tool-body{
    padding:28px;
}

.tool-grid{
    display:grid;
    grid-template-columns: 460px 1fr;
    gap:24px;
    align-items:start;
}

.tool-panel{
    background:#f7f9fa;
    border:1px solid rgba(17,24,26,.08);
    border-radius:26px;
    padding:22px;
    box-shadow:0 18px 50px rgba(0,0,0,.06);
    color:#122022;
}

.tool-panel h3{
    font-family:'Plus Jakarta Sans',sans-serif;
    margin:0 0 18px;
    font-size:1.05rem;
    font-weight:800;
    color:#122022;
    letter-spacing:.3px;
}

.tool-field{
    margin-bottom:16px;
}

.tool-field label{
    display:block;
    font-size:.84rem;
    font-weight:800;
    color:#2c3a3d;
    margin-bottom:8px;
    text-transform:uppercase;
    letter-spacing:1px;
}

.tool-field input,
.tool-field select{
    width:100%;
    border:1px solid rgba(17,24,26,.12);
    background:#fff;
    border-radius:14px;
    outline:none;
    padding:14px 14px;
    font-size:1rem;
    color:#122022;
    font-family:'Plus Jakarta Sans',sans-serif;
}

.tool-inline-2{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
}

.tool-inline-3{
    display:grid;
    grid-template-columns:1fr 1fr 1fr;
    gap:14px;
}

.option-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:12px;
    margin-top:6px;
}

.option-pill{
    position:relative;
    display:flex;
    align-items:flex-start;
    gap:10px;
    padding:14px 14px;
    border:1px solid rgba(17,24,26,.10);
    background:#fff;
    border-radius:16px;
    cursor:pointer;
    transition:all .22s ease;
}

.option-pill:hover{
    transform:translateY(-1px);
    box-shadow:0 10px 28px rgba(0,0,0,.05);
}

.option-pill input{
    margin-top:3px;
    transform:scale(1.1);
}

.option-pill strong{
    display:block;
    font-size:.9rem;
    color:#122022;
    line-height:1.2;
}

.option-pill span{
    display:block;
    font-size:.78rem;
    color:#58686b;
    line-height:1.4;
    margin-top:4px;
}

.tool-actions{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
    margin-top:10px;
}

.tool-btn{
    border:none;
    outline:none;
    cursor:pointer;
    border-radius:14px;
    padding:14px 16px;
    font-weight:800;
    font-size:.88rem;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    transition:all .25s ease;
}

.tool-btn.primary{
    background:linear-gradient(135deg, #c0006b 0%, #e00087 100%);
    color:#fff;
}

.tool-btn.secondary{
    background:#11181a;
    color:#fff;
}

.tool-btn:hover{
    transform:translateY(-2px);
}

.tool-helper{
    margin-top:16px;
    background:#fff;
    border:1px solid rgba(17,24,26,.08);
    border-radius:18px;
    padding:16px;
    font-size:.92rem;
    color:#4e5c5f;
    line-height:1.65;
}

.tool-results{
    display:grid;
    gap:22px;
}

.result-card{
    background:linear-gradient(145deg, rgba(28,34,35,0.96) 0%, rgba(15,18,19,0.98) 100%);
    border:1px solid rgba(255,255,255,.06);
    border-radius:26px;
    padding:24px;
    box-shadow:0 24px 60px rgba(0,0,0,.18);
}

.result-card h3{
    font-size:1.45rem;
    color:#fff;
    margin:0 0 14px;
}

.result-card p{
    color:var(--vnv-text-muted);
    margin:0 0 14px;
}

.result-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:14px;
    margin-top:14px;
}

.result-stat{
    background:rgba(255,255,255,.04);
    border:1px solid rgba(255,255,255,.06);
    border-radius:18px;
    padding:16px 14px;
}

.result-stat-label{
    color:rgba(255,255,255,.58);
    font-size:.72rem;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:1.4px;
    margin-bottom:6px;
}

.result-stat-value{
    color:#fff;
    font-size:1.32rem;
    font-weight:800;
    line-height:1.2;
}

.breakdown-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:14px;
    margin-top:14px;
}

.breakdown-card{
    background:rgba(255,255,255,.04);
    border:1px solid rgba(255,255,255,.06);
    border-radius:18px;
    padding:16px 14px;
}

.breakdown-card h4{
    font-family:'Plus Jakarta Sans',sans-serif;
    color:#fff;
    margin:0 0 8px;
    font-size:1rem;
    font-weight:800;
}

.breakdown-card p{
    margin:0;
    color:var(--vnv-text-muted);
    font-size:.92rem;
    line-height:1.6;
}

.total-highlight{
    margin-top:18px;
    background:linear-gradient(135deg, rgba(197,160,89,.16) 0%, rgba(94,198,196,.12) 100%);
    border:1px solid rgba(197,160,89,.22);
    border-radius:22px;
    padding:18px;
}

.total-highlight .label{
    color:rgba(255,255,255,.64);
    font-size:.76rem;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:1.5px;
    margin-bottom:6px;
}

.total-highlight .value{
    color:#fff;
    font-size:2.1rem;
    font-weight:900;
    line-height:1.1;
}

.alert-box{
    margin-top:16px;
    border-radius:18px;
    padding:16px;
    font-size:.95rem;
    line-height:1.65;
    border:1px solid transparent;
}

.alert-box.safe{
    background:rgba(38,194,129,.12);
    border-color:rgba(38,194,129,.22);
    color:#d8fff0;
}

.alert-box.warn{
    background:rgba(244,183,64,.12);
    border-color:rgba(244,183,64,.22);
    color:#fff4d8;
}

.alert-box.danger{
    background:rgba(255,95,109,.12);
    border-color:rgba(255,95,109,.22);
    color:#ffe1e4;
}

.muted-note{
    margin-top:16px;
    color:rgba(255,255,255,.52);
    font-size:.84rem;
    line-height:1.6;
}

.empty-state{
    min-height:420px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:30px;
    background:linear-gradient(145deg, rgba(28,34,35,0.96) 0%, rgba(15,18,19,0.98) 100%);
    border:1px solid rgba(255,255,255,.06);
    border-radius:26px;
    color:var(--vnv-text-muted);
}

.empty-state-inner{
    max-width:420px;
}

.empty-state-icon{
    width:72px;
    height:72px;
    margin:0 auto 18px;
    border-radius:22px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(94,198,196,.10);
    color:var(--vnv-primary);
    font-size:1.5rem;
}

@media (max-width: 1199px){
    .tool-grid{
        grid-template-columns:1fr;
    }
}

@media (max-width: 767px){
    .section-vnv{
        padding:90px 0;
    }

    .hero-tool h1{
        font-size:2.7rem;
    }

    .vnv-btn{
        width:100%;
        padding:18px 24px;
        letter-spacing:2px;
    }

    .hero-cta-row{
        flex-direction:column;
    }

    .tool-body{
        padding:16px;
    }

    .tool-inline-2,
    .tool-inline-3,
    .option-grid,
    .result-grid,
    .breakdown-grid{
        grid-template-columns:1fr;
    }

    .tool-panel,
    .result-card{
        padding:18px;
    }
}
</style>
{% endblock %}

{% block body %}

{% include "templates/layout/publicHeaderVnv.html.twig" %}

<section class="hero-tool">
    <div class="container hero-tool-inner">
        <span class="vnv-badge">Free Event Planning Tool</span>

        <h1>Bartender & Server <span class="text-gold">Calculator</span></h1>

        <p class="hero-copy">
            Estimate bartenders, servers, barbacks and bar stations for weddings, private parties, cocktail receptions and corporate events. Plan staffing with a more realistic service standard instead of a flat one-size-fits-all guess.
        </p>

        <div class="hero-cta-row">
            <a href="#staff-tool" class="vnv-btn btn-gold-vnv">Use the Calculator</a>
            <a href="#" data-vnv-open-request class="vnv-btn btn-outline-vnv">Need Staffing Help?</a>
        </div>
    </div>
</section>

<section class="section-vnv section-white" id="staff-tool">
    <div class="container">
        <div class="tool-shell">
            <div class="tool-topbar">
                <div class="tool-topbar-left">
                    <div class="tool-topbar-icon"><i class="fa-solid fa-martini-glass-citrus"></i></div>
                    <div>
                        <div class="tool-topbar-title">Bartender and Server Requirement Calculator</div>
                        <div class="tool-topbar-sub">Estimate service staff based on bar complexity and food style</div>
                    </div>
                </div>

                <div class="tool-topbar-note">
                    Better for weddings, cocktail hours, private parties and catered social events
                </div>
            </div>

            <div class="tool-body">
                <div class="tool-grid">
                    <div class="tool-panel">
                        <h3>Plan Your Staffing</h3>

                        <div class="tool-inline-2">
                            <div class="tool-field">
                                <label for="guest-count">Number of guests</label>
                                <input type="number" id="guest-count" min="1" step="1" placeholder="e.g. 100">
                            </div>

                            <div class="tool-field">
                                <label for="event-style">Event style</label>
                                <select id="event-style">
                                    <option value="wedding" selected>Wedding Reception</option>
                                    <option value="cocktail">Cocktail Reception</option>
                                    <option value="social">Birthday / Social Event</option>
                                    <option value="corporate">Corporate Event</option>
                                    <option value="casual">Casual Gathering</option>
                                </select>
                            </div>
                        </div>

                        <div class="tool-inline-3">
                            <div class="tool-field">
                                <label for="bar-type">Bar type</label>
                                <select id="bar-type">
                                    <option value="beer-wine">Beer & Wine</option>
                                    <option value="standard" selected>Standard Full Bar</option>
                                    <option value="premium">Premium / Cocktails</option>
                                </select>
                            </div>

                            <div class="tool-field">
                                <label for="food-service">Food service</label>
                                <select id="food-service">
                                    <option value="none">No Food Service</option>
                                    <option value="buffet" selected>Buffet / Stations</option>
                                    <option value="passed">Passed Hors d'Oeuvres</option>
                                    <option value="plated">Plated Dinner</option>
                                </select>
                            </div>

                            <div class="tool-field">
                                <label for="service-level">Service level</label>
                                <select id="service-level">
                                    <option value="efficient">Efficient</option>
                                    <option value="balanced" selected>Balanced</option>
                                    <option value="premium">Premium</option>
                                </select>
                            </div>
                        </div>

                        <div class="option-grid">
                            <label class="option-pill">
                                <input type="checkbox" id="peak-rush" checked>
                                <div>
                                    <strong>Strong Arrival Rush</strong>
                                    <span>Use for weddings or events where many guests hit the bar at once.</span>
                                </div>
                            </label>

                            <label class="option-pill">
                                <input type="checkbox" id="signature-cocktails">
                                <div>
                                    <strong>Signature Cocktails</strong>
                                    <span>Tightens the bartender ratio because drinks take longer to build.</span>
                                </div>
                            </label>

                            <label class="option-pill">
                                <input type="checkbox" id="heavy-clearing" checked>
                                <div>
                                    <strong>Active Clearing / Resetting</strong>
                                    <span>Useful when servers are also bussing, resetting and managing tables.</span>
                                </div>
                            </label>

                            <label class="option-pill">
                                <input type="checkbox" id="multiple-bars">
                                <div>
                                    <strong>Multiple Bar Locations</strong>
                                    <span>Helpful when service is split across separate bar points.</span>
                                </div>
                            </label>
                        </div>

                        <div class="tool-actions">
                            <button type="button" class="tool-btn primary" id="calculate-btn">
                                <i class="fa-solid fa-calculator"></i>
                                Calculate
                            </button>

                            <button type="button" class="tool-btn secondary" id="reset-btn">
                                <i class="fa-solid fa-rotate-left"></i>
                                Reset
                            </button>
                        </div>

                        <div class="tool-helper">
                            This version uses more realistic staffing logic. Bar staffing changes with drink complexity and rush moments, while server counts change a lot depending on whether you are plating food, clearing tables or mostly supporting buffet flow.
                        </div>
                    </div>

                    <div class="tool-results" id="tool-results">
                        <div class="empty-state">
                            <div class="empty-state-inner">
                                <div class="empty-state-icon"><i class="fa-solid fa-user-group"></i></div>
                                <h3 style="font-size:1.7rem; color:#fff; margin-bottom:10px;">Your staffing recommendation will appear here</h3>
                                <p style="margin:0;">
                                    Enter your guest count, bar type and food style to estimate bartenders, servers and support staff.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{% include "templates/components/publicEventRequestModal.html.twig" with {
    request_form_action: "/api/public/event-request"
} %}

{% include "templates/layout/publicFooterVnv.html.twig" %}

{% endblock %}

{% block scripts %}
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@type":"WebApplication",
  "name":"Bartender and Server Calculator",
  "applicationCategory":"BusinessApplication",
  "operatingSystem":"Web",
  "description":"A free web-based event staffing calculator that estimates bartenders, servers, barbacks and drink stations for catered events.",
  "offers":{
    "@type":"Offer",
    "price":"0",
    "priceCurrency":"USD"
  }
}
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const guestCount = document.getElementById('guest-count');
    const eventStyle = document.getElementById('event-style');
    const barType = document.getElementById('bar-type');
    const foodService = document.getElementById('food-service');
    const serviceLevel = document.getElementById('service-level');

    const peakRush = document.getElementById('peak-rush');
    const signatureCocktails = document.getElementById('signature-cocktails');
    const heavyClearing = document.getElementById('heavy-clearing');
    const multipleBars = document.getElementById('multiple-bars');

    const calculateBtn = document.getElementById('calculate-btn');
    const resetBtn = document.getElementById('reset-btn');
    const resultsWrap = document.getElementById('tool-results');

    function renderEmpty() {
        resultsWrap.innerHTML = `
            <div class="empty-state">
                <div class="empty-state-inner">
                    <div class="empty-state-icon"><i class="fa-solid fa-user-group"></i></div>
                    <h3 style="font-size:1.7rem; color:#fff; margin-bottom:10px;">Your staffing recommendation will appear here</h3>
                    <p style="margin:0;">
                        Enter your guest count and service style to see a practical staffing recommendation.
                    </p>
                </div>
            </div>
        `;
    }

    function formatNumber(value) {
        return new Intl.NumberFormat('en-US').format(Math.round(value));
    }

    function getBartenderRatio() {
        let ratio;

        switch (barType.value) {
            case 'beer-wine':
                ratio = 75;
                break;
            case 'premium':
                ratio = 35;
                break;
            default:
                ratio = 50;
                break;
        }

        if (signatureCocktails.checked) ratio -= 5;
        if (peakRush.checked) ratio -= 5;

        if (serviceLevel.value === 'efficient') ratio += 10;
        if (serviceLevel.value === 'premium') ratio -= 5;

        if (eventStyle.value === 'wedding') ratio -= 5;
        if (eventStyle.value === 'casual') ratio += 5;

        ratio = Math.max(25, ratio);

        return ratio;
    }

    function getServerRatio() {
        let ratio;

        switch (foodService.value) {
            case 'plated':
                ratio = 12;
                break;
            case 'passed':
                ratio = 20;
                break;
            case 'buffet':
                ratio = 25;
                break;
            default:
                ratio = 30;
                break;
        }

        if (heavyClearing.checked) ratio -= 3;
        if (serviceLevel.value === 'efficient') ratio += 3;
        if (serviceLevel.value === 'premium') ratio -= 2;
        if (eventStyle.value === 'wedding' && foodService.value !== 'none') ratio -= 1;

        ratio = Math.max(8, ratio);

        return ratio;
    }

    function getBarStations(guests, bartenders) {
        let stations = Math.ceil(guests / 100);

        if (multipleBars.checked) {
            stations = Math.max(stations, 2);
        }

        if (bartenders >= 4) {
            stations = Math.max(stations, 2);
        }

        if (bartenders >= 6) {
            stations = Math.max(stations, 3);
        }

        return stations;
    }

    function getBarbacks(bartenders) {
        if (bartenders <= 2) return 0;
        if (bartenders <= 5) return 1;
        return Math.ceil(bartenders / 3);
    }

    function getServiceRead(bartenders, servers) {
        if (bartenders <= 1 && servers <= 2) {
            return {
                type: 'warn',
                title: 'Lean staffing',
                copy: 'This can work for smaller or more casual events, but it leaves less room for surges, delays or high-touch service.'
            };
        }

        if (bartenders >= 4 || servers >= 8) {
            return {
                type: 'safe',
                title: 'Robust coverage',
                copy: 'This should support stronger flow, shorter waits and a more forgiving service pace for a larger or more demanding event.'
            };
        }

        return {
            type: 'safe',
            title: 'Balanced service range',
            copy: 'This is usually a practical middle ground for guest experience, cost control and manageable service flow.'
        };
    }

    function getNotes(guests, bartenders, servers, barbacks, stations) {
        const notes = [];

        if (peakRush.checked) {
            notes.push('Because many guests may hit the bar at once, the calculator tightened the bartender ratio to reduce opening-line congestion.');
        }

        if (signatureCocktails.checked) {
            notes.push('Signature cocktails slow service speed, so the bartender recommendation was increased to reflect longer build times.');
        }

        if (foodService.value === 'plated') {
            notes.push('Plated dinner requires the tightest server ratio because timing, temperature and synchronized delivery matter much more.');
        } else if (foodService.value === 'buffet') {
            notes.push('Buffet service needs fewer servers than plated dinner, but still needs hands for replenishment, clearing and guest support.');
        } else if (foodService.value === 'passed') {
            notes.push('Passed hors d’oeuvres usually need active floor coverage, so server counts stay tighter than a no-food event.');
        }

        if (barbacks > 0) {
            notes.push('A barback was added because once bartender counts grow, support for ice, trash, restock and glass flow becomes more important.');
        }

        if (stations > 1) {
            notes.push('More than one bar station was recommended to help split traffic and reduce guest clustering.');
        }

        if (guests >= 150) {
            notes.push('At higher guest counts, room layout and distance between bar, kitchen and tables can matter almost as much as the raw staffing count.');
        }

        if (notes.length === 0) {
            notes.push('This estimate is a solid planning baseline, but final staffing should still reflect venue layout, timeline peaks and whether bussing is handled by the same team.');
        }

        return notes;
    }

    function calculateEstimate() {
        const guests = parseFloat(guestCount.value || '0');

        if (guests <= 0) {
            renderEmpty();
            return;
        }

        const bartenderRatio = getBartenderRatio();
        const serverRatio = getServerRatio();

        const bartenders = Math.ceil(guests / bartenderRatio);
        const servers = foodService.value === 'none' ? Math.ceil(guests / serverRatio) : Math.ceil(guests / serverRatio);
        const barbacks = getBarbacks(bartenders);
        const stations = getBarStations(guests, bartenders);
        const serviceRead = getServiceRead(bartenders, servers);
        const notes = getNotes(guests, bartenders, servers, barbacks, stations);

        const summaryLine = [
            eventStyle.options[eventStyle.selectedIndex].text,
            barType.options[barType.selectedIndex].text,
            foodService.options[foodService.selectedIndex].text,
            serviceLevel.options[serviceLevel.selectedIndex].text
        ].join(' · ');

        const notesHtml = notes.map(note => `<p style="margin:0 0 12px;">${note}</p>`).join('');

        resultsWrap.innerHTML = `
            <div class="result-card">
                <h3>Recommended Staffing</h3>
                <p>${summaryLine}</p>

                <div class="result-grid">
                    <div class="result-stat">
                        <div class="result-stat-label">Bartenders</div>
                        <div class="result-stat-value">${formatNumber(bartenders)}</div>
                    </div>
                    <div class="result-stat">
                        <div class="result-stat-label">Servers</div>
                        <div class="result-stat-value">${formatNumber(servers)}</div>
                    </div>
                    <div class="result-stat">
                        <div class="result-stat-label">Barbacks</div>
                        <div class="result-stat-value">${formatNumber(barbacks)}</div>
                    </div>
                </div>

                <div class="total-highlight">
                    <div class="label">Suggested bar setup</div>
                    <div class="value">${formatNumber(stations)} bar station${stations > 1 ? 's' : ''}</div>
                </div>
            </div>

            <div class="result-card">
                <h3>How The Ratios Landed</h3>

                <div class="breakdown-grid">
                    <div class="breakdown-card">
                        <h4>Bartender Ratio Used</h4>
                        <p>1 bartender per <strong>${formatNumber(bartenderRatio)}</strong> guests based on bar complexity and rush conditions.</p>
                    </div>

                    <div class="breakdown-card">
                        <h4>Server Ratio Used</h4>
                        <p>1 server per <strong>${formatNumber(serverRatio)}</strong> guests based on the selected food service style.</p>
                    </div>

                    <div class="breakdown-card">
                        <h4>Bar Station Planning</h4>
                        <p><strong>${formatNumber(stations)}</strong> station${stations > 1 ? 's were' : ' was'} suggested to reduce crowding and keep service spread practical.</p>
                    </div>

                    <div class="breakdown-card">
                        <h4>Support Staff</h4>
                        <p><strong>${formatNumber(barbacks)}</strong> barback${barbacks !== 1 ? 's' : ''} added for bar support and restocking.</p>
                    </div>
                </div>
            </div>

            <div class="result-card">
                <h3>Service Read</h3>

                <div class="alert-box ${serviceRead.type}">
                    <strong>${serviceRead.title}.</strong> ${serviceRead.copy}
                </div>

                <div class="muted-note">
                    This is a planning guide, not a staffing contract. Final counts can still shift depending on venue layout, timeline compression, tray pass expectations, bussing responsibility and whether support staff are shared across teams.
                </div>
            </div>

            <div class="result-card">
                <h3>Planner Notes</h3>
                ${notesHtml}
            </div>
        `;
    }

    function applyDefaults() {
        switch (eventStyle.value) {
            case 'wedding':
                barType.value = 'standard';
                foodService.value = 'buffet';
                serviceLevel.value = 'balanced';
                peakRush.checked = true;
                signatureCocktails.checked = false;
                heavyClearing.checked = true;
                multipleBars.checked = false;
                break;

            case 'cocktail':
                barType.value = 'premium';
                foodService.value = 'passed';
                serviceLevel.value = 'balanced';
                peakRush.checked = true;
                signatureCocktails.checked = true;
                heavyClearing.checked = true;
                multipleBars.checked = false;
                break;

            case 'social':
                barType.value = 'standard';
                foodService.value = 'buffet';
                serviceLevel.value = 'balanced';
                peakRush.checked = false;
                signatureCocktails.checked = false;
                heavyClearing.checked = true;
                multipleBars.checked = false;
                break;

            case 'corporate':
                barType.value = 'beer-wine';
                foodService.value = 'buffet';
                serviceLevel.value = 'balanced';
                peakRush.checked = true;
                signatureCocktails.checked = false;
                heavyClearing.checked = true;
                multipleBars.checked = true;
                break;

            case 'casual':
                barType.value = 'beer-wine';
                foodService.value = 'none';
                serviceLevel.value = 'efficient';
                peakRush.checked = false;
                signatureCocktails.checked = false;
                heavyClearing.checked = false;
                multipleBars.checked = false;
                break;
        }
    }

    eventStyle.addEventListener('change', applyDefaults);

    calculateBtn.addEventListener('click', calculateEstimate);

    resetBtn.addEventListener('click', function () {
        guestCount.value = '';
        eventStyle.value = 'wedding';
        applyDefaults();
        renderEmpty();
    });

    applyDefaults();
    renderEmpty();
});
</script>
{% endblock %}