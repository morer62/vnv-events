    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-top: 28px;
}

.faq-page-btn {
    min-width: 42px;
    min-height: 42px;
    border: 1px solid rgba(12, 22, 24, .14);
    border-radius: 999px;
    background: #fff;
