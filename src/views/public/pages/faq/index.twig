    color: #fff;
}

.faq-page-btn:disabled {
    cursor: not-allowed;
    opacity: .42;
}

.faq-cta {
    padding: 70px 0 86px;
    background: #0a1011;
    color: #fff;
}

.faq-cta__box {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, .1);
    background:
        radial-gradient(circle at 8% 15%, rgba(69, 227, 207, .18), transparent 22rem),
        linear-gradient(135deg, #121a1b, #0a1011);
    padding: 34px;
}

.faq-cta h2 {
    margin: 0 0 10px;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(34px, 4vw, 56px);
    line-height: 1;
}

.faq-cta p {
    max-width: 780px;
    margin: 0;
    color: rgba(255, 255, 255, .72);
    font-size: 16px;
    line-height: 1.8;
}

@media (max-width: 980px) {
    .faq-hero__grid,
    .faq-heading,
    .faq-cta__box {
        grid-template-columns: 1fr;
    }

    .faq-visual {
        min-height: 460px;
    }
}

@media (max-width: 700px) {
    .faq-wrap {
        width: min(100% - 28px, 1220px);
    }

    .faq-hero {
        padding-top: 50px;
    }

    .faq-search-row {
        grid-template-columns: 1fr;
    }

    .faq-visual__panel {
        grid-template-columns: 1fr;
    }

    .faq-question {
        grid-template-columns: minmax(0, 1fr) auto;
    }

    .faq-question strong {
        display: none;
    }

    .faq-answer {
        padding-left: 22px;
    }

    .faq-category {
        margin-left: 22px;
    }
}
</style>
{% endblock %}

{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}

<main class="faq-page">
    <section class="faq-hero">
        <div class="faq-wrap">
            <div class="faq-hero__grid">
                <div>
                    <span class="faq-kicker">South Florida event answers</span>
                    <h1>Planning, catering and production <span>FAQ</span></h1>
                    <p class="faq-lede">
                        A central VNV Events knowledge page for the questions clients, search engines and AI assistants ask before a South Florida event: pricing, service areas, catering stations, contracts, staffing, decor, DJ, rentals and venue logistics.
                    </p>
                    <div class="faq-hero__actions">
                        <a class="faq-btn faq-btn--gold" href="#faq-search">Search questions</a>
                        <a class="faq-btn faq-btn--ghost" href="#" data-vnv-open-request>Start a request</a>
                    </div>
                </div>

                <div class="faq-visual" aria-label="VNV Events catering and event production">
                    <div class="faq-visual__panel">
                        <div class="faq-stat">
                            <strong>{{ faqs|length }}</strong>
                            <span>VNV-specific answers</span>
                        </div>
                        <div class="faq-stat">
                            <strong>3</strong>
                            <span>South Florida counties</span>
                        </div>
                        <div class="faq-stat">
                            <strong>9</strong>
                            <span>Core service lines</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="faq-search-band" id="faq-search">
        <div class="faq-wrap">
            <div class="faq-search-shell">
                <div class="faq-search-row">
                    <input class="faq-search" type="search" id="faqSearch" placeholder="Search catering cost, coordinator, bartender, rentals, contract..." aria-label="Search VNV Events FAQ">
                    <div class="faq-count">
                        <strong id="faqVisibleCount">{{ faqs|length }}</strong> matching questions
                        <span class="faq-page-status" id="faqPageStatus">Showing 1-20</span>
                    </div>
                </div>
                <div class="faq-chips" aria-label="FAQ shortcuts">
                    <button class="faq-chip is-active" type="button" data-category="">All</button>
                    <button class="faq-chip" type="button" data-category="Catering">Catering</button>
                    <button class="faq-chip" type="button" data-category="Planning">Planning</button>
                    <button class="faq-chip" type="button" data-category="Contract">Contract</button>
                    <button class="faq-chip" type="button" data-category="DJ">DJ</button>
                    <button class="faq-chip" type="button" data-category="Decoration">Decoration</button>
                    <button class="faq-chip" type="button" data-category="Client Portal">Client Portal</button>
                </div>
            </div>
        </div>
    </section>

    <section class="faq-section">
        <div class="faq-wrap">
            <div class="faq-heading">
                <div>
                    <span class="faq-pill">Built from VNV services</span>
                    <h2>Real answers clients can use.</h2>
                </div>
                <p>
                    Pricing references are examples from the current VNV store and public service pages. Final event pricing always follows the approved written proposal, venue logistics, timing and guest count.
                </p>
            </div>

            <div class="faq-grid" id="faqList">
                {% for faq in faqs %}
                    <article class="faq-item{% if loop.first %} is-open{% endif %}" data-faq-item data-category="{{ faq.category|default('Planning')|e('html_attr') }}" data-search="{{ (faq.category|default('Planning') ~ ' ' ~ faq.question ~ ' ' ~ faq.answer)|lower|e('html_attr') }}"{% if loop.index > 20 %} style="display:none"{% endif %}>
                        <button class="faq-question" type="button" aria-expanded="{{ loop.first ? 'true' : 'false' }}">
                            <strong>{{ "%02d"|format(loop.index) }}</strong>
                            <span>{{ faq.question }}</span>
                            <b class="faq-toggle" aria-hidden="true">{{ loop.first ? '-' : '+' }}</b>
                        </button>
                        <span class="faq-category">{{ faq.category|default('Planning') }}</span>
                        <div class="faq-answer">
                            {{ faq.answer }}
                        </div>
                    </article>
                {% endfor %}
            </div>

            <div class="faq-empty" id="faqEmpty">No matching VNV FAQ found. Try a service, price, contract term or event type.</div>
            <div class="faq-pagination" id="faqPagination" aria-label="FAQ pagination"></div>
        </div>
    </section>

    <section class="faq-cta">
        <div class="faq-wrap">
            <div class="faq-cta__box">
                <div>
                    <h2>Need the exact number for your event?</h2>
                    <p>
                        Send the date, city, venue, guest count and services you need. VNV will turn the FAQ into an actual event scope for catering, planning, decor, staffing, DJ, rentals or production.
                    </p>
                </div>
                <a class="faq-btn faq-btn--gold" href="#" data-vnv-open-request>New request</a>
            </div>
        </div>
    </section>
</main>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const search = document.getElementById('faqSearch');
    const items = Array.from(document.querySelectorAll('[data-faq-item]'));
    const visibleCount = document.getElementById('faqVisibleCount');
    const empty = document.getElementById('faqEmpty');
    const chips = Array.from(document.querySelectorAll('.faq-chip'));
    const pagination = document.getElementById('faqPagination');
    const pageStatus = document.getElementById('faqPageStatus');
    const pageSize = 20;
    let activeCategory = '';
    let currentPage = 1;

    const getMatches = function () {
        const query = search.value || '';
        const normalized = (query || '').trim().toLowerCase();
        return items.filter(function (item) {
            const haystack = item.getAttribute('data-search') || '';
            const category = item.getAttribute('data-category') || '';
            const categoryMatches = activeCategory === '' || category === activeCategory;
            const searchMatches = normalized === '' || normalized.split(/\s+/).every(function (part) {
                return haystack.includes(part);
            });
            return categoryMatches && searchMatches;
        });
    };

    const renderPagination = function (totalPages) {
        pagination.innerHTML = '';
        if (totalPages <= 1) {
            return;
        }

        const addButton = function (label, page, disabled, active) {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'faq-page-btn' + (active ? ' is-active' : '');
            button.textContent = label;
            button.disabled = disabled;
            button.addEventListener('click', function () {
                currentPage = page;
                render();
                document.getElementById('faq-search').scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
            pagination.appendChild(button);
        };

        addButton('Prev', Math.max(1, currentPage - 1), currentPage === 1, false);

        for (let page = 1; page <= totalPages; page += 1) {
            if (
                page === 1 ||
                page === totalPages ||
                Math.abs(page - currentPage) <= 1
            ) {
                addButton(String(page), page, false, page === currentPage);
            } else if (
                page === currentPage - 2 ||
                page === currentPage + 2
            ) {
                const spacer = document.createElement('span');
                spacer.className = 'faq-page-btn';
                spacer.textContent = '...';
                pagination.appendChild(spacer);
            }
        }

        addButton('Next', Math.min(totalPages, currentPage + 1), currentPage === totalPages, false);
    };

    const render = function () {
        const matches = getMatches();
        const totalPages = Math.max(1, Math.ceil(matches.length / pageSize));
        if (currentPage > totalPages) {
            currentPage = totalPages;
        }

        const start = (currentPage - 1) * pageSize;
        const end = start + pageSize;
        const pageItems = new Set(matches.slice(start, end));

        items.forEach(function (item) {
            item.style.display = pageItems.has(item) ? '' : 'none';
        });

        visibleCount.textContent = String(matches.length);
        if (matches.length === 0) {
            pageStatus.textContent = 'Showing 0';
        } else {
            pageStatus.textContent = `Showing ${start + 1}-${Math.min(end, matches.length)} of ${matches.length}`;
        }
        empty.classList.toggle('is-visible', matches.length === 0);
        renderPagination(totalPages);
    };

    items.forEach(function (item) {
        const button = item.querySelector('.faq-question');
        const toggle = item.querySelector('.faq-toggle');
        button.addEventListener('click', function () {
            const open = item.classList.toggle('is-open');
            button.setAttribute('aria-expanded', open ? 'true' : 'false');
            toggle.textContent = open ? '-' : '+';
        });
    });

    search.addEventListener('input', function () {
        currentPage = 1;
        render();
    });

    chips.forEach(function (chip) {
        chip.addEventListener('click', function () {
            chips.forEach(function (entry) { entry.classList.remove('is-active'); });
            chip.classList.add('is-active');
            activeCategory = chip.dataset.category || '';
            currentPage = 1;
            render();
        });
    });

    render();
});
</script>

