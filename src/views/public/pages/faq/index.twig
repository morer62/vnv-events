<style>
:root {
    --faq-ink: #0a1011;
    --faq-panel: #111819;
    --faq-muted: #617174;
    --faq-line: rgba(12, 22, 24, .12);
    --faq-soft: #f4f7f7;
    --faq-teal: #45e3cf;
    --faq-teal-dark: #087267;
    --faq-gold: #d8ad45;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background:
        radial-gradient(circle at 8% 18%, rgba(69, 227, 207, .14), transparent 25rem),
        radial-gradient(circle at 88% 12%, rgba(216, 173, 69, .16), transparent 25rem),
        linear-gradient(180deg, #eef4f4 0%, #ffffff 52%, #0a1011 100%);
    color: var(--faq-ink);
    font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    overflow-x: hidden;
}

.faq-page {
    min-height: 100vh;
}

.faq-wrap {
    width: min(1220px, calc(100% - 40px));
    margin: 0 auto;
}

.faq-hero {
    padding: 78px 0 50px;
}

.faq-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(380px, 1.08fr);
    gap: 34px;
    align-items: stretch;
}

.faq-kicker,
.faq-pill {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid rgba(69, 227, 207, .24);
    background: rgba(69, 227, 207, .12);
    color: var(--faq-teal-dark);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .14em;
    line-height: 1;
    padding: 11px 15px;
    text-transform: uppercase;
}

.faq-hero h1 {
    max-width: 720px;
    margin: 20px 0 18px;
    color: #101717;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(48px, 7vw, 88px);
    font-weight: 800;
    line-height: .92;
}

.faq-hero h1 span {
    color: var(--faq-gold);
    font-style: italic;
}

.faq-lede {
    max-width: 660px;
    margin: 0;
    color: #405154;
    font-size: 18px;
    line-height: 1.75;
}

.faq-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
}

.faq-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border-radius: 999px;
    border: 1px solid transparent;
    background: var(--faq-ink);
    color: #fff;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: .08em;
    padding: 0 20px;
    text-decoration: none;
    text-transform: uppercase;
}

.faq-btn--gold {
    background: linear-gradient(135deg, #f1da86, var(--faq-gold));
    color: #101717;
}

.faq-btn--ghost {
    background: rgba(255, 255, 255, .64);
    border-color: rgba(12, 22, 24, .16);
    color: #101717;
}

.faq-visual {
    min-height: 560px;
    border-radius: 34px;
    overflow: hidden;
    position: relative;
    background:
        linear-gradient(180deg, rgba(10, 16, 17, .12), rgba(10, 16, 17, .56) 58%, rgba(10, 16, 17, .88)),
        linear-gradient(90deg, rgba(10, 16, 17, .32), rgba(10, 16, 17, .06) 48%, rgba(10, 16, 17, .26)),
        url("{{ path('/assets/images/faq-event-answers-hero.png') }}") center / cover;
    box-shadow: 0 32px 80px rgba(8, 25, 25, .22);
}

.faq-visual__panel {
    position: absolute;
    left: 28px;
    right: 28px;
    bottom: 28px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
}

.faq-stat {
    min-height: 118px;
    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, .14);
    background: rgba(10, 16, 17, .78);
    color: #fff;
    padding: 18px;
    backdrop-filter: blur(12px);
}

.faq-stat strong {
    display: block;
    color: var(--faq-teal);
    font-size: 28px;
    font-weight: 900;
}

.faq-stat span {
    display: block;
    margin-top: 8px;
    color: rgba(255, 255, 255, .74);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: .08em;
    line-height: 1.5;
    text-transform: uppercase;
}

.faq-search-band {
    padding: 0 0 48px;
}

.faq-search-shell {
    border-radius: 26px;
    background: rgba(255, 255, 255, .86);
    border: 1px solid rgba(12, 22, 24, .08);
    box-shadow: 0 28px 80px rgba(14, 31, 34, .12);
    padding: 22px;
}

.faq-search-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px;
    align-items: center;
}

.faq-search {
    width: 100%;
    min-height: 62px;
    border-radius: 999px;
    border: 1px solid rgba(12, 22, 24, .16);
    background: #fff;
    color: #111819;
    font-size: 18px;
    font-weight: 700;
    outline: none;
    padding: 0 22px;
}

.faq-search:focus {
    border-color: rgba(8, 114, 103, .65);
    box-shadow: 0 0 0 4px rgba(69, 227, 207, .14);
}

.faq-count {
    white-space: nowrap;
    color: var(--faq-muted);
    font-size: 14px;
    font-weight: 800;
}

.faq-count strong {
    color: var(--faq-ink);
}

.faq-page-status {
    display: block;
    margin-top: 4px;
    color: var(--faq-muted);
    font-size: 12px;
    font-weight: 800;
}

.faq-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 16px;
}

.faq-chip {
    border: 1px solid rgba(12, 22, 24, .12);
