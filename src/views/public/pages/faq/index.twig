    font-size: 15px;
    line-height: 1.8;
    padding: 0 22px 22px 72px;
}

.faq-item.is-open .faq-answer {
    display: block;
}

.faq-empty {
    display: none;
    border: 1px dashed rgba(8, 114, 103, .36);
    border-radius: 22px;
    background: rgba(255, 255, 255, .7);
    color: #415154;
    font-weight: 800;
    padding: 28px;
    text-align: center;
}

.faq-empty.is-visible {
