{% block scripts %}
<script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Interactive Event Space Planner for Layout Design",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "description": "A free web-based event space planner that helps users design event layouts, place tables and chairs, test room dimensions and export layout drafts.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
}
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const PIXELS_PER_FT = 24;
    const MIN_ZOOM = 0.35;
    const MAX_ZOOM = 2.2;

    const stage = document.getElementById('canvas-stage');
    const scrollWrap = document.getElementById('canvas-scroll');
    const roomWidthInput = document.getElementById('room-width');
    const roomHeightInput = document.getElementById('room-height');
    const roomPreset = document.getElementById('room-preset');
    const roomSummary = document.getElementById('room-summary');
    const canvasLabel = document.getElementById('canvas-label');
    const emptyState = document.getElementById('canvas-empty-state');
    const sidebar = document.getElementById('tool-sidebar');

    const setRoomBtn = document.getElementById('set-room-btn');
    const zoomInBtn = document.getElementById('zoom-in-btn');
    const zoomOutBtn = document.getElementById('zoom-out-btn');
    const fitScreenBtn = document.getElementById('fit-screen-btn');
    const clearRoomBtn = document.getElementById('clear-room-btn');
    const exportBtn = document.getElementById('export-btn');
    const mobilePaletteToggle = document.getElementById('mobile-palette-toggle');
    const mobilePaletteToggleHeader = document.getElementById('mobile-palette-toggle-header');

    let currentZoom = 1;
    let selectedItem = null;
    let itemCounter = 0;

    const itemTypes = {
        'round-table': { widthFt: 5, heightFt: 5, label: 'Round Table', round: true, icon: '○' },
        'rect-table': { widthFt: 6, heightFt: 3, label: 'Rect Table', round: false, icon: '▭' },
        'chair': { widthFt: 2, heightFt: 2, label: 'Chair', round: false, icon: 'Chair' },
        'stage': { widthFt: 10, heightFt: 4, label: 'Stage', round: false, icon: 'Stage' },
        'cocktail-table': { widthFt: 3, heightFt: 3, label: 'Cocktail', round: true, icon: 'Cocktail' },
        'bar': { widthFt: 8, heightFt: 3, label: 'Bar', round: false, icon: 'Bar' },
        'photobooth': { widthFt: 6, heightFt: 4, label: 'Photo Booth', round: false, icon: 'Photo' },
        'altar': { widthFt: 8, heightFt: 6, label: 'Altar', round: false, icon: 'Altar' },
        'text-block': { widthFt: 8, heightFt: 3, label: '', round: false, icon: 'Text' }
    };

    function clamp(value, min, max) {
        return Math.min(max, Math.max(min, value));
    }

    function snap(value) {
        return Math.round(value / 10) * 10;
    }

    function updateEmptyState() {
        const hasItems = !!stage.querySelector('.canvas-item');
        emptyState.classList.toggle('hidden', hasItems);
    }

    function updateRoomLabels() {
        const w = parseInt(roomWidthInput.value || '20', 10);
        const h = parseInt(roomHeightInput.value || '20', 10);
        roomSummary.textContent = `Room: ${w}ft × ${h}ft`;
        canvasLabel.textContent = `${w}ft × ${h}ft Room`;
    }

    function setRoomSize() {
        const widthFt = Math.max(5, parseInt(roomWidthInput.value || '20', 10));
        const heightFt = Math.max(5, parseInt(roomHeightInput.value || '20', 10));

        roomWidthInput.value = widthFt;
        roomHeightInput.value = heightFt;

        stage.style.width = (widthFt * PIXELS_PER_FT) + 'px';
        stage.style.height = (heightFt * PIXELS_PER_FT) + 'px';

        updateRoomLabels();
        fitCanvasToView();
    }

    function setZoom(zoom) {
        currentZoom = clamp(zoom, MIN_ZOOM, MAX_ZOOM);
        stage.style.transform = `scale(${currentZoom})`;
    }

    function fitCanvasToView() {
        const wrapWidth = scrollWrap.clientWidth - 20;
        const wrapHeight = scrollWrap.clientHeight - 20;
        const stageWidth = stage.offsetWidth;
        const stageHeight = stage.offsetHeight;

        const zoomX = wrapWidth / stageWidth;
        const zoomY = wrapHeight / stageHeight;
        const fitZoom = clamp(Math.min(zoomX, zoomY, 1), MIN_ZOOM, MAX_ZOOM);

        setZoom(fitZoom);

        requestAnimationFrame(() => {
            const scaledWidth = stage.offsetWidth * currentZoom;
            const scaledHeight = stage.offsetHeight * currentZoom;
            scrollWrap.scrollLeft = Math.max(0, (scaledWidth - scrollWrap.clientWidth) / 2);
            scrollWrap.scrollTop = Math.max(0, (scaledHeight - scrollWrap.clientHeight) / 2);
        });
    }

    function deselectAll() {
        stage.querySelectorAll('.canvas-item.selected').forEach(el => el.classList.remove('selected'));
        selectedItem = null;
    }

    function selectItem(item) {
        deselectAll();
        selectedItem = item;
        item.classList.add('selected');
    }

    function createMiniToolButton(iconClass, title, onClick) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'item-mini-btn';
        btn.title = title;
        btn.innerHTML = `<i class="${iconClass}"></i>`;
        btn.addEventListener('click', function(e) {
            e.stopPropagation();
            onClick();
        });
        return btn;
    }

    function duplicateItem(item) {
        const cloneType = item.dataset.type;
        const x = parseFloat(item.style.left || '0') + 20;
        const y = parseFloat(item.style.top || '0') + 20;
        const newItem = addItem(cloneType, x, y);

        newItem.style.width = item.style.width;
        newItem.style.height = item.style.height;
        newItem.dataset.rotation = item.dataset.rotation || '0';
        newItem.style.transform = `rotate(${newItem.dataset.rotation}deg)`;

        const originalTextarea = item.querySelector('textarea');
        const newTextarea = newItem.querySelector('textarea');

        if (originalTextarea && newTextarea) {
            newTextarea.value = originalTextarea.value;
        }

        updateEmptyState();
        selectItem(newItem);
    }

    function rotateItem(item) {
        const currentRotation = parseInt(item.dataset.rotation || '0', 10);
        const nextRotation = (currentRotation + 90) % 360;
        item.dataset.rotation = nextRotation;
        item.style.transform = `rotate(${nextRotation}deg)`;
    }

    function removeItem(item) {
        if (selectedItem === item) {
            selectedItem = null;
        }
        item.remove();
        updateEmptyState();
    }

    function attachDragAndResize(item) {
        let mode = null;
        let startX = 0;
        let startY = 0;
        let startLeft = 0;
        let startTop = 0;
        let startWidth = 0;
        let startHeight = 0;

        item.addEventListener('pointerdown', function(e) {
            const target = e.target;

            if (target.tagName === 'TEXTAREA') {
                selectItem(item);
                return;
            }

            if (target.classList.contains('resize-handle')) {
                mode = 'resize';
            } else {
                mode = 'drag';
            }

            selectItem(item);

            startX = e.clientX;
            startY = e.clientY;
            startLeft = parseFloat(item.style.left || '0');
            startTop = parseFloat(item.style.top || '0');
            startWidth = item.offsetWidth;
            startHeight = item.offsetHeight;

            item.setPointerCapture(e.pointerId);
            e.preventDefault();
        });

        item.addEventListener('pointermove', function(e) {
            if (!mode) return;

            const dx = (e.clientX - startX) / currentZoom;
            const dy = (e.clientY - startY) / currentZoom;

            if (mode === 'drag') {
                let newLeft = snap(startLeft + dx);
                let newTop = snap(startTop + dy);

                const maxLeft = Math.max(0, stage.offsetWidth - item.offsetWidth);
                const maxTop = Math.max(0, stage.offsetHeight - item.offsetHeight);

                newLeft = clamp(newLeft, 0, maxLeft);
                newTop = clamp(newTop, 0, maxTop);

                item.style.left = newLeft + 'px';
                item.style.top = newTop + 'px';
            }

            if (mode === 'resize') {
                const minW = 40;
                const minH = 40;
                const maxW = stage.offsetWidth - parseFloat(item.style.left || '0');
                const maxH = stage.offsetHeight - parseFloat(item.style.top || '0');

                const newWidth = clamp(snap(startWidth + dx), minW, maxW);
                const newHeight = clamp(snap(startHeight + dy), minH, maxH);

                item.style.width = newWidth + 'px';
                item.style.height = newHeight + 'px';
            }
        });

        function endPointer() {
            mode = null;
        }

        item.addEventListener('pointerup', endPointer);
        item.addEventListener('pointercancel', endPointer);
    }

    function addItem(type, x = null, y = null) {
        const config = itemTypes[type];
        if (!config) return null;

        itemCounter += 1;

        const item = document.createElement('div');
        item.className = 'canvas-item';
        if (config.round) item.classList.add('round');
        if (type === 'text-block') item.classList.add('text-block');

        const widthPx = config.widthFt * PIXELS_PER_FT;
        const heightPx = config.heightFt * PIXELS_PER_FT;

        item.style.width = widthPx + 'px';
        item.style.height = heightPx + 'px';

        const defaultX = Math.max(10, ((stage.offsetWidth - widthPx) / 2) + ((itemCounter % 4) * 14));
        const defaultY = Math.max(10, ((stage.offsetHeight - heightPx) / 2) + ((itemCounter % 4) * 14));

        item.style.left = (x !== null ? snap(x) : snap(defaultX)) + 'px';
        item.style.top = (y !== null ? snap(y) : snap(defaultY)) + 'px';
        item.dataset.type = type;
        item.dataset.rotation = '0';
        item.style.transform = 'rotate(0deg)';

        const topTools = document.createElement('div');
        topTools.className = 'item-top-tools';

        topTools.appendChild(createMiniToolButton('fa-solid fa-copy', 'Duplicate', function() {
            duplicateItem(item);
        }));

        topTools.appendChild(createMiniToolButton('fa-solid fa-rotate-right', 'Rotate', function() {
            rotateItem(item);
        }));

        topTools.appendChild(createMiniToolButton('fa-solid fa-trash', 'Delete', function() {
            removeItem(item);
        }));

        item.appendChild(topTools);

        if (type === 'text-block') {
            const textarea = document.createElement('textarea');
            textarea.placeholder = 'Write here...';
            textarea.value = 'Text';
            item.appendChild(textarea);

            const resizeHandle = document.createElement('div');
            resizeHandle.className = 'resize-handle';
            item.appendChild(resizeHandle);
        } else {
            const label = document.createElement('div');
            label.className = 'item-label';
            label.textContent = config.label;
            item.appendChild(label);

            const resizeHandle = document.createElement('div');
            resizeHandle.className = 'resize-handle';
            item.appendChild(resizeHandle);
        }

        item.addEventListener('click', function(e) {
            if (e.target.classList.contains('item-mini-btn')) return;
            selectItem(item);
        });

        attachDragAndResize(item);
        stage.appendChild(item);
        updateEmptyState();
        selectItem(item);
        return item;
    }

    document.querySelectorAll('[data-add-type]').forEach(btn => {
        btn.addEventListener('click', function() {
            addItem(btn.dataset.addType);
            if (window.innerWidth <= 991) {
                sidebar.classList.remove('is-open');
            }
        });
    });

    roomPreset.addEventListener('change', function() {
        if (!roomPreset.value) return;
        const [w, h] = roomPreset.value.split('x');
        roomWidthInput.value = w;
        roomHeightInput.value = h;
        setRoomSize();
    });

    setRoomBtn.addEventListener('click', setRoomSize);

    zoomInBtn.addEventListener('click', function() {
        setZoom(currentZoom + 0.1);
    });

    zoomOutBtn.addEventListener('click', function() {
        setZoom(currentZoom - 0.1);
    });

    fitScreenBtn.addEventListener('click', fitCanvasToView);

    clearRoomBtn.addEventListener('click', function() {
        if (!confirm('Do you want to clear the current layout?')) return;
        stage.querySelectorAll('.canvas-item').forEach(el => el.remove());
        deselectAll();
        updateEmptyState();
    });

    exportBtn.addEventListener('click', function() {
        deselectAll();

        const previousTransform = stage.style.transform;
        stage.style.transform = 'scale(1)';

        html2canvas(stage, {
            backgroundColor: '#f9fbfb',
            scale: 2
        }).then(canvas => {
            const link = document.createElement('a');
            link.download = 'event-layout.png';
            link.href = canvas.toDataURL('image/png');
            link.click();
            stage.style.transform = previousTransform;
        }).catch(() => {
            stage.style.transform = previousTransform;
        });
    });

    function toggleSidebar() {
        sidebar.classList.toggle('is-open');
    }

    mobilePaletteToggle.addEventListener('click', toggleSidebar);
    mobilePaletteToggleHeader.addEventListener('click', toggleSidebar);

    document.addEventListener('click', function(e) {
        if (!e.target.closest('.canvas-item') && !e.target.closest('.tool-sidebar') && !e.target.closest('#mobile-palette-toggle') && !e.target.closest('#mobile-palette-toggle-header')) {
            deselectAll();
        }
    });

    setRoomSize();

    setTimeout(() => {
        fitCanvasToView();
    }, 120);
});
</script>
{% endblock %}