{% block styles %}
<style>
:root{--ink:#0a0c0c;--card:#151a1b;--mint:#5ec6c4;--gold:#c5a059;--paper:#f4f7f8}
html,body{width:100%;max-width:100%;overflow-x:hidden}.cs-wrap{max-width:100%}.cs-hero h1,.cs-heading h2,.cs-card h2,.cs-corporate h2{overflow-wrap:anywhere}
*{box-sizing:border-box}body{margin:0;background:var(--ink);color:#fff;font-family:"Trebuchet MS","Segoe UI",sans-serif;line-height:1.65}.cs-wrap{width:min(1160px,calc(100% - 32px));margin:auto}.cs-hero{min-height:78vh;display:grid;align-items:center;padding:130px 0 90px;background:linear-gradient(90deg,rgba(6,9,9,.94),rgba(6,9,9,.62)),url('{{ asset_for('assets/images/service_photos/crepes_station_1_lite.webp') }}') center/cover}.cs-eyebrow{display:inline-block;color:var(--mint);font-weight:900;letter-spacing:.14em;text-transform:uppercase;font-size:.76rem}.cs-hero h1,.cs-heading h2,.cs-card h2,.cs-corporate h2{font-family:Georgia,serif}.cs-hero h1{font-size:clamp(2.7rem,7vw,5.5rem);line-height:1.02;max-width:900px;margin:18px 0}.cs-hero p{max-width:720px;font-size:1.12rem;color:rgba(255,255,255,.78)}.cs-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.cs-btn{display:inline-flex;padding:14px 22px;border-radius:999px;text-decoration:none;font-weight:900;letter-spacing:.04em;background:var(--gold);color:#111}.cs-btn.alt{background:transparent;color:var(--mint);border:2px solid var(--mint)}.cs-section{padding:100px 0}.cs-section.light{background:var(--paper);color:#121819}.cs-heading{max-width:780px;margin-bottom:42px}.cs-heading h2{font-size:clamp(2rem,5vw,3.8rem);line-height:1.08;margin:10px 0}.cs-heading p{color:#526063}.cs-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.cs-card{background:#fff;border:1px solid #dae2e3;border-radius:26px;overflow:hidden;box-shadow:0 18px 50px rgba(0,0,0,.08)}.cs-card img{width:100%;height:290px;object-fit:cover;display:block}.cs-card-body{padding:28px}.cs-rank{display:flex;justify-content:space-between;gap:12px;color:#526063;font-size:.85rem;text-transform:uppercase;letter-spacing:.08em;font-weight:800}.cs-price{color:#087e79}.cs-card h2{font-size:2rem;margin:10px 0}.cs-card ul{padding-left:20px;color:#465456}.cs-card .cs-actions{margin-top:20px}.cs-card .cs-btn{font-size:.8rem;padding:11px 17px}.cs-card .cs-btn.alt{color:#087e79;border-color:#087e79}.cs-corporate{background:linear-gradient(135deg,#151a1b,#20292a);border:1px solid rgba(94,198,196,.22);border-radius:32px;padding:clamp(28px,6vw,60px)}.cs-corporate h2{font-size:clamp(2.2rem,5vw,4rem);margin:12px 0}.cs-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:30px}.cs-option{background:rgba(255,255,255,.06);padding:24px;border-radius:20px}.cs-option strong{display:block;color:var(--mint);font-size:1.35rem}.cs-note{font-size:.86rem;color:#637174;margin-top:26px}.cs-faq details{background:#fff;border:1px solid #dce3e4;border-radius:16px;padding:18px 22px;margin:12px 0}.cs-faq summary{font-weight:900;cursor:pointer}.cs-faq p{color:#526063}.cs-bottom{text-align:center;background:radial-gradient(circle at top,#233334,#0a0c0c);padding:90px 16px}.cs-bottom h2{font-family:Georgia,serif;font-size:clamp(2.2rem,5vw,4rem);margin:0 auto 14px;max-width:800px}.cs-bottom p{color:rgba(255,255,255,.72)}
@media(max-width:760px){.cs-grid,.cs-options{grid-template-columns:1fr}.cs-card img{height:230px}.cs-section{padding:75px 0}.cs-btn{width:100%;justify-content:center}}
</style>
{% endblock %}

{% block body %}
{% include "templates/layout/publicHeaderVnv.html.twig" %}
<main>
<section class="cs-hero"><div class="cs-wrap">
  <span class="cs-eyebrow">VNV Gourmet · South Florida</span>
  <h1>Live catering stations that turn dinner into part of the event</h1>
  <p>Our most requested stations are already a VNV tradition across South Florida: fresh food, guest-facing chefs and a polished setup that works for private celebrations, weddings and company events.</p>
  <div class="cs-actions"><a class="cs-btn" href="#favorites">Compare our favorites</a><a class="cs-btn alt" href="{{ path('/store-categories/') }}">Browse the full catalog</a></div>
</div></section>

<section class="cs-section light" id="favorites"><div class="cs-wrap">
  <div class="cs-heading"><span class="cs-eyebrow">Most booked</span><h2>Six proven catering choices, ranked by demand</h2><p>Start with the atmosphere you want and compare the inclusions. Prices shown are current starting prices; guest count, selections, service time and upgrades determine the final proposal.</p></div>
  <div class="cs-grid">
    {% set stations = [
      {rank:'01',name:'Crepes Station',price:'From $19 per guest · min. 25',image:'assets/images/service_photos/crepes_station_1_lite.webp',alt:'Live crepe catering station by VNV Events',copy:'Our most visual guest experience: sweet and savory crepes prepared fresh while guests choose their fillings.',points:['Three sweet and three savory filling choices','Elegant buffet décor adapted to the event','Two hours of interactive live-chef service'],page:'/crepes-catering-south-florida/',url:'https://vnvevents.com/product/crepes-station-1999-per-guest-25-guest-minimum-buffet-style/'},
      {rank:'02',name:'Pasta Station',price:'From $19 per guest · min. 25',image:'assets/images/service_photos/pasta_station_1.webp',alt:'Live pasta catering station in South Florida',copy:'A flexible crowd favorite with the comfort of pasta and the energy of a live, customizable station.',points:['Choose three pasta varieties and three sauces','Two protein selections plus fresh ingredients','Two hours of live-chef service and buffet setup'],page:'/pasta-station-catering-south-florida/',url:'https://vnvevents.com/product/pasta-station/'},
      {rank:'03',name:'Pizza Station',price:'From $19 per guest · min. 25',image:'assets/images/service_photos/pizza_station_lite.webp',alt:'Fresh pizza station for events by VNV Events',copy:'Fresh pizza made on-site with choices guests understand immediately—ideal for social, school and corporate events.',points:['Choice of crust and two sauces','Up to three standard toppings','Two-hour service with live chefs'],page:'/pizza-station-catering-south-florida/',url:'https://vnvevents.com/product/pizza-station/'},
      {rank:'04',name:'Paella Station',price:'From $19 per guest · min. 25',image:'assets/images/service_photos/paella_station_lite.webp',alt:'Live paella catering station in South Florida',copy:'A colorful Spanish-inspired centerpiece cooked live, with aroma and presentation that become part of the celebration.',points:['Seafood, chicken or vegetarian direction','Themed buffet presentation','Two hours of live-chef service'],page:'/paella-catering-south-florida/',url:'https://vnvevents.com/product/paella-tapas-station-from-27-77-per-guest-min-25/'},
      {rank:'05',name:'Taco Station',price:'From $19 per guest · min. 25',image:'assets/images/service_photos/tacos.webp',alt:'Live taco bar catering in South Florida',copy:'A fast, social taco and burrito bar built for customization, generous flavor and easy guest flow.',points:['Choose two proteins','Choose three sides and toppings','Two hours of fresh on-site preparation'],page:'/taco-station-catering-south-florida/',url:'https://vnvevents.com/product/taco-station/'}
    ] %}
    {% for station in stations %}<article class="cs-card"><img loading="lazy" decoding="async" src="{{ asset_for(station.image) }}" alt="{{ station.alt }}"><div class="cs-card-body"><div class="cs-rank"><span>Favorite {{ station.rank }}</span><span class="cs-price">{{ station.price }}</span></div><h2>{{ station.name }}</h2><p>{{ station.copy }}</p><ul>{% for point in station.points %}<li>{{ point }}</li>{% endfor %}</ul><div class="cs-actions"><a class="cs-btn" href="{{ path(station.page) }}">Explore service</a><a class="cs-btn alt" href="{{ station.url }}">Menu &amp; price</a></div></div></article>{% endfor %}
  </div>
</div></section>

<section class="cs-section"><div class="cs-wrap"><div class="cs-corporate">
  <span class="cs-eyebrow">Favorite 06 · Corporate catering</span><h2>Feed the team without slowing down the day</h2><p>Choose a staffed food-station experience for company celebrations, or individualized meal boxes for meetings, training days and recurring office service.</p>
  <div class="cs-options"><div class="cs-option"><strong>Food stations from $17 p/p</strong><p>For 50 or more guests. Choose pasta, paella, pizza, brunch or Mexican service with a professional buffet setup and one hour of chef service.</p></div><div class="cs-option"><strong>Meal boxes from $12.50 p/p</strong><p>Ready-to-distribute breakfast or lunch boxes with a customizable menu. Add an optional warming station for $120 when the selected menu benefits from heated holding.</p></div></div>
  <div class="cs-actions"><a class="cs-btn" href="{{ path('/corporate-catering-south-florida/') }}">Explore corporate catering</a><a class="cs-btn alt" href="https://vnvevents.com/product/corporate-team-appreciation-catering-22-5-p-p-min-50">Menu &amp; price</a></div>
  <p class="cs-note">Availability, delivery, taxes, staffing, equipment, dietary accommodations and final menu selections are confirmed in the proposal. Notify our team about allergies before booking.</p>
</div></div></section>

<section class="cs-section light"><div class="cs-wrap cs-faq"><div class="cs-heading"><span class="cs-eyebrow">Before you book</span><h2>Common catering questions</h2></div>
  <details><summary>What does “from $19 per guest” mean?</summary><p>It is the current base price published for each featured live station. Optional appetizers, desserts, premium toppings, added service time, delivery and other event needs can change the total.</p></details>
  <details><summary>Can VNV accommodate dietary needs?</summary><p>Menus can often be adjusted for vegetarian, vegan, gluten-sensitive or other requirements. Tell us about allergies and restrictions before the menu is confirmed; accommodations depend on the station and cross-contact requirements.</p></details>
  <details><summary>Where does VNV provide catering?</summary><p>VNV Events serves Miami-Dade, Broward and Palm Beach, subject to date, venue access and delivery logistics.</p></details>
</div></section>

<section class="cs-bottom" id="request"><h2>Choose the station. We will help connect the rest.</h2><p>Catering, staffing, rentals, entertainment and event production through one South Florida team.</p><div class="cs-actions" style="justify-content:center"><a class="cs-btn" href="#" data-vnv-open-request>Start a catering request</a><a class="cs-btn alt" href="tel:+13052045427">Call (305) 204-5427</a></div></section>
</main>
{% include "templates/components/publicEventRequestModal.html.twig" with {
    request_form_action: "/api/public/event-request"
} %}
{% include "templates/layout/publicFooterVnv.html.twig" %}
{% endblock %}

{% block scripts %}
<script>
(function () {
    let mapsLoading = false;
    function loadMapsOnce() {
        if (mapsLoading || window.google?.maps) return;
        mapsLoading = true;
        const script = document.createElement('script');
        script.src = 'https://maps.googleapis.com/maps/api/js?key={{ GOOGLE_MAPS_API_KEY }}&libraries=places&callback=initPublicEventRequestMap';
        script.async = true;
        script.defer = true;
        document.head.appendChild(script);
    }
    document.addEventListener('click', function (event) {
        if (event.target.closest('[data-vnv-open-request]')) loadMapsOnce();
    }, { passive: true });
})();
</script>
{% endblock %}
