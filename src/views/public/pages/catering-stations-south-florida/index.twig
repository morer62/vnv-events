{% extends "templates/base.twig" %}

{% set show_whatsapp = true %}
{% set defer_public_third_party = true %}
{% set skip_public_gtm_initial = true %}

{% block title %}Live Catering Stations in South Florida | From $19 | VNV Events{% endblock %}
{% block meta_description %}Compare VNV Events' most requested live catering stations in South Florida: crepes, pasta, pizza, paella and tacos from $19 per guest, plus corporate catering and meal boxes.{% endblock %}
{% block meta_keywords %}live catering stations South Florida, catering stations Miami, catering Broward, crepe station, pasta station, pizza station, paella catering, taco station, corporate catering, boxed lunches{% endblock %}
{% block canonical %}https://vnvevents.com/catering-stations-south-florida/{% endblock %}

{% block head %}
<link rel="preload" as="image" href="{{ asset_for('assets/images/service_photos/crepes_station_1_lite.webp') }}" fetchpriority="high">
<script type="application/ld+json">
{
  "@context":"https://schema.org",
  "@graph":[
