{% extends "templates/base.twig" %}
{% set show_whatsapp = false %}
{% set defer_public_third_party = true %}
{% set skip_public_gtm_initial = true %}

{% block title %}Live Catering Stations in South Florida | VNV Events{% endblock %}
{% block meta_description %}Compare VNV Events' priority catering services in South Florida: Pasta, Appetizers, Crepes and Taco, with current base prices and minimums.{% endblock %}
{% block meta_keywords %}live catering stations South Florida, appetizer catering Miami, pasta station Broward, crepe station, taco station Palm Beach{% endblock %}
{% block canonical %}https://vnvevents.com/catering-stations-south-florida/{% endblock %}
{% block head %}
<link rel="preload" as="image" href="{{ asset_for('assets/images/service_photos/pasta_station_1.webp') }}" fetchpriority="high">
<script type="application/ld+json">{{ comparison_schema|json_encode|raw }}</script>
{% endblock %}

{% block styles %}
<style>
:root{--ink:#0a0c0c;--mint:#5ec6c4;--gold:#c5a059;--paper:#f4f7f8}*{box-sizing:border-box}html,body{max-width:100%;overflow-x:hidden}body{margin:0;background:var(--ink);color:#fff;font-family:"Trebuchet MS","Segoe UI",sans-serif;line-height:1.65}.cs-wrap{width:min(1160px,calc(100% - 32px));margin:auto}.cs-hero{min-height:72vh;display:grid;align-items:center;padding:130px 0 86px;background:linear-gradient(90deg,rgba(6,9,9,.95),rgba(6,9,9,.58)),url('{{ asset_for('assets/images/service_photos/pasta_station_1.webp') }}') center/cover}.cs-eyebrow{color:var(--mint);font-size:.76rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.cs-hero h1,.cs-heading h2,.cs-card h2,.cs-corporate h2{font-family:Georgia,serif;overflow-wrap:anywhere}.cs-hero h1{font-size:clamp(2.7rem,7vw,5.4rem);line-height:1.02;max-width:920px;margin:16px 0}.cs-hero p{max-width:760px;font-size:1.12rem;color:rgba(255,255,255,.8)}.cs-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}.cs-btn{min-height:46px;display:inline-flex;align-items:center;justify-content:center;padding:12px 20px;border-radius:999px;text-decoration:none;font-weight:900;background:var(--gold);color:#111}.cs-btn.alt{background:transparent;color:var(--mint);border:2px solid var(--mint)}.cs-section{padding:88px 0}.cs-light{background:var(--paper);color:#121819}.cs-heading{max-width:800px;margin-bottom:38px}.cs-heading h2{font-size:clamp(2.1rem,5vw,3.8rem);line-height:1.08;margin:10px 0}.cs-heading p,.cs-card p{color:#526063}.cs-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.cs-card{background:#fff;border:1px solid #dae2e3;border-radius:26px;overflow:hidden;box-shadow:0 18px 50px rgba(0,0,0,.08)}.cs-card img{width:100%;height:280px;object-fit:cover;display:block}.cs-card-body{padding:27px}.cs-rank{display:flex;justify-content:space-between;gap:14px;color:#526063;font-size:.82rem;text-transform:uppercase;font-weight:900}.cs-price{color:#087e79;text-align:right}.cs-card h2{font-size:2rem;margin:10px 0}.cs-corporate{background:linear-gradient(135deg,#151a1b,#20292a);border:1px solid rgba(94,198,196,.22);border-radius:30px;padding:clamp(28px,6vw,56px)}.cs-corporate h2{font-size:clamp(2.2rem,5vw,3.8rem);margin:10px 0}.cs-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:28px}.cs-option{background:rgba(255,255,255,.06);padding:23px;border-radius:18px}.cs-option strong{display:block;color:var(--mint);font-size:1.25rem}.cs-more{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.cs-more a{color:var(--mint);border:1px solid var(--mint);border-radius:999px;padding:9px 14px;text-decoration:none;font-weight:800}.cs-bottom{text-align:center;padding:82px 16px}.cs-bottom h2{font:clamp(2.2rem,5vw,4rem)/1.08 Georgia,serif;max-width:820px;margin:0 auto 14px}.cs-bottom p{color:rgba(255,255,255,.75)}
@media(max-width:760px){.cs-grid,.cs-options{grid-template-columns:1fr}.cs-card img{height:230px}.cs-section{padding:68px 0}.cs-btn{width:100%}.cs-rank{display:block}.cs-price{display:block;text-align:left;margin-top:5px}.cs-hero{min-height:auto;padding:110px 0 65px}}
</style>
{% endblock %}

{% block body %}
{% if not ads_mode %}{% include "templates/layout/publicHeaderVnv.html.twig" %}{% endif %}
<main>
<section class="cs-hero"><div class="cs-wrap"><span class="cs-eyebrow">VNV Gourmet · South Florida</span><h1>Compare the four catering experiences built for this campaign</h1><p>Pasta, Appetizers, Crepes and Taco each have a dedicated landing, a current base price from the VNV Store and a short path to request availability.</p><div class="cs-actions"><a class="cs-btn" href="#priorities">Compare services</a><a class="cs-btn alt" href="tel:+13052045427">Call VNV</a></div></div></section>

<section class="cs-section cs-light" id="priorities"><div class="cs-wrap"><div class="cs-heading"><span class="cs-eyebrow">Campaign priorities</span><h2>Four clear choices</h2><p>Add-ons and combinations are excluded from every From price shown here.</p></div><div class="cs-grid">
{% for station in gourmet_catalog %}<article class="cs-card"><img loading="lazy" decoding="async" src="{{ asset_for(station.image) }}" alt="{{ station.name }} by VNV Events" width="700" height="520"><div class="cs-card-body"><div class="cs-rank"><span>Priority {{ '%02d'|format(loop.index) }}</span><span class="cs-price">{{ station.price }} · {{ station.minimum }}</span></div><h2>{{ station.name }}</h2><p>{{ station.summary }}</p><div class="cs-actions"><a class="cs-btn" href="{{ path(station.landing_url) }}">Explore service</a><a class="cs-btn alt" style="color:#087e79;border-color:#087e79" href="{{ station.product_url }}">Menu &amp; options</a></div></div></article>{% endfor %}
</div></div></section>

<section class="cs-section"><div class="cs-wrap"><div class="cs-corporate"><span class="cs-eyebrow">Corporate &amp; holiday occasion</span><h2>Use the same four services for company events</h2><p>Corporate is an occasion, not a fifth campaign product. VNV can build a proposal around Pasta, Appetizers, Crepes or Taco without inventing a combo price.</p><div class="cs-options"><div class="cs-option"><strong>{{ corporate_overview.station_price }} per guest</strong><p>Published corporate station format for 50 or more guests.</p></div><div class="cs-option"><strong>{{ corporate_overview.meal_box_price }}</strong><p>A separate breakfast or lunch format, not the price of a live station.</p></div></div><div class="cs-actions"><a class="cs-btn" href="{{ path(corporate_overview.landing_url) }}">Corporate options</a></div></div>
<div class="cs-more"><a href="{{ path('/pizza-station-catering-south-florida/') }}">More stations: Pizza</a><a href="{{ path('/paella-catering-south-florida/') }}">Paella</a><a href="{{ path('/shawarma-station-catering-south-florida/') }}">Shawarma</a><a href="{{ path('/store-categories/') }}">Full catalog</a></div></div></section>

<section class="cs-bottom"><h2>Choose a service and request availability</h2><p>Each service page includes Call, WhatsApp and a one-step quote form.</p><div class="cs-actions" style="justify-content:center"><a class="cs-btn" href="{{ path('/pasta-station-catering-south-florida/') }}#quote">Start with Pasta</a><a class="cs-btn alt" href="{{ path('/appetizer-catering-south-florida/') }}#quote">Start with Appetizers</a></div></section>
</main>
{% if not ads_mode %}{% include "templates/layout/publicFooterVnv.html.twig" %}{% endif %}
{% endblock %}
