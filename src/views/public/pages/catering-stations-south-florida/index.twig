{% extends "templates/base.twig" %}
{% set show_whatsapp = false %}
{% set defer_public_third_party = true %}
{% set skip_public_gtm_initial = true %}

{% block title %}Live Catering Stations in South Florida | VNV Events{% endblock %}
{% block meta_description %}Compare VNV Events' priority catering services in South Florida: Pasta, Appetizers, Crepes and Taco, with current base prices and minimums.{% endblock %}
{% block meta_keywords %}live catering stations South Florida, appetizer catering Miami, pasta station Broward, crepe station, taco station Palm Beach{% endblock %}
{% block canonical %}https://vnvevents.com/catering-stations-south-florida/{% endblock %}
{% block head %}
<link rel="preload" as="image" href="{{ asset_for('assets/images/service_photos/pasta_station_1.webp') }}" fetchpriority="high">
<script type="application/ld+json">{{ comparison_schema|json_encode|raw }}</script>
{% endblock %}

{% block styles %}
<style>
:root{--ink:#0a0c0c;--mint:#5ec6c4;--gold:#c5a059;--paper:#f4f7f8;--bar-space:86px}*{box-sizing:border-box}html,body{max-width:100%;overflow-x:hidden}body{margin:0;background:var(--ink);color:#fff;font-family:"Trebuchet MS","Segoe UI",sans-serif;line-height:1.65}.cs-wrap{width:min(1160px,calc(100% - 32px));margin:auto}.cs-hero{min-height:72vh;display:grid;align-items:center;padding:130px 0 86px;background:linear-gradient(90deg,rgba(6,9,9,.95),rgba(6,9,9,.58)),url('{{ asset_for('assets/images/service_photos/pasta_station_1.webp') }}') center/cover}.cs-eyebrow{color:var(--mint);font-size:.76rem;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.cs-hero h1,.cs-heading h2,.cs-card h2,.cs-corporate h2{font-family:Georgia,serif;overflow-wrap:anywhere}.cs-hero h1{font-size:clamp(2.7rem,7vw,5.4rem);line-height:1.02;max-width:920px;margin:16px 0}.cs-hero p{max-width:760px;font-size:1.12rem;color:rgba(255,255,255,.8)}.cs-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}.cs-btn{min-height:48px;display:inline-flex;align-items:center;justify-content:center;padding:12px 20px;border-radius:999px;border:0;text-decoration:none;font:inherit;font-weight:900;background:var(--gold);color:#111;cursor:pointer}.cs-btn.alt{background:transparent;color:var(--mint);border:2px solid var(--mint)}.cs-btn.dark{background:#087e79;color:#fff}.cs-btn:focus-visible,.cs-input:focus-visible{outline:3px solid #111;outline-offset:3px}.cs-section{padding:88px 0}.cs-light{background:var(--paper);color:#121819}.cs-heading{max-width:800px;margin-bottom:38px}.cs-heading h2{font-size:clamp(2.1rem,5vw,3.8rem);line-height:1.08;margin:10px 0}.cs-heading p,.cs-card p{color:#526063}.cs-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.cs-card{background:#fff;border:1px solid #dae2e3;border-radius:26px;overflow:hidden;box-shadow:0 18px 50px rgba(0,0,0,.08)}.cs-card img{width:100%;height:280px;object-fit:cover;display:block}.cs-card-body{padding:27px}.cs-rank{display:flex;justify-content:space-between;gap:14px;color:#526063;font-size:.82rem;text-transform:uppercase;font-weight:900}.cs-price{color:#087e79;text-align:right}.cs-card h2{font-size:2rem;margin:10px 0}.cs-corporate{background:linear-gradient(135deg,#151a1b,#20292a);border:1px solid rgba(94,198,196,.22);border-radius:30px;padding:clamp(28px,6vw,56px)}.cs-corporate h2{font-size:clamp(2.2rem,5vw,3.8rem);margin:10px 0}.cs-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:28px}.cs-option{background:rgba(255,255,255,.06);padding:23px;border-radius:18px}.cs-option strong{display:block;color:var(--mint);font-size:1.25rem}.cs-more{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.cs-more a{color:var(--mint);border:1px solid var(--mint);border-radius:999px;padding:9px 14px;text-decoration:none;font-weight:800}.cs-bottom{text-align:center;padding:82px 16px}.cs-bottom h2{font:clamp(2.2rem,5vw,4rem)/1.08 Georgia,serif;max-width:820px;margin:0 auto 14px}.cs-bottom p{color:rgba(255,255,255,.75)}.cs-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;padding:clamp(24px,5vw,44px);border-radius:28px;background:#fff;border:1px solid #dde4e5;box-shadow:0 18px 55px rgba(0,0,0,.08)}.cs-field label{display:block;font-weight:900;margin-bottom:6px}.cs-field.full{grid-column:1/-1}.cs-input{width:100%;min-height:48px;border:1px solid #829699;border-radius:12px;padding:11px 13px;background:#fff;color:#111;font:inherit}.cs-help{font-size:.88rem;color:#536164}.cs-notice{padding:15px 18px;border-radius:12px;margin-bottom:22px;background:#e5f5ef;color:#17513d}.cs-notice.error{background:#fde8e8;color:#741b1b}.cs-honeypot{position:absolute!important;left:-9999px!important}.cs-mobile-bar{display:none}
@media(max-width:760px){body.cs-ads{padding-bottom:calc(var(--bar-space) + env(safe-area-inset-bottom))}.cs-grid,.cs-options,.cs-form{grid-template-columns:1fr}.cs-field.full{grid-column:auto}.cs-card img{height:230px}.cs-section{padding:68px 0}.cs-btn{width:100%}.cs-rank{display:block}.cs-price{display:block;text-align:left;margin-top:5px}.cs-hero{min-height:auto;padding:62px 0 96px}.cs-hero h1{font-size:clamp(2.15rem,10.5vw,3.8rem);margin:8px 0 10px}.cs-hero .cs-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px}.cs-hero .cs-actions .cs-btn{width:auto;min-height:48px;padding:9px 5px;font-size:.82rem}.cs-mobile-bar{position:fixed;display:grid;grid-template-columns:1fr 1fr;left:0;right:0;bottom:0;z-index:1000;padding:8px 10px calc(8px + env(safe-area-inset-bottom));background:#0c1112;border-top:1px solid rgba(255,255,255,.15);gap:8px}.cs-mobile-bar a{min-height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;text-decoration:none;font-weight:900}.cs-mobile-call{background:#fff;color:#111}.cs-mobile-wa{background:#1f9d64;color:#fff}}
</style>
{% endblock %}

{% block body %}
{% if not ads_mode %}{% include "templates/layout/publicHeaderVnv.html.twig" %}{% endif %}
<main>
<section class="cs-hero"><div class="cs-wrap"><span class="cs-eyebrow">VNV Gourmet · South Florida</span><h1>Compare the four catering experiences built for this campaign</h1><p>Pasta, Appetizers, Crepes and Taco each have a dedicated landing, a current base price from the VNV Store and a short path to request availability.</p><div class="cs-actions"><a class="cs-btn" href="#priorities">Compare services</a><a class="cs-btn alt" href="tel:{{ phone_number }}" data-cs-call>Call VNV</a>{% if ads_mode %}<a class="cs-btn dark" href="https://wa.me/{{ whatsapp_number }}" target="_blank" rel="noopener" data-cs-whatsapp>WhatsApp</a><a class="cs-btn alt" href="#quote">Get a quote</a>{% endif %}</div></div></section>

<section class="cs-section cs-light" id="priorities"><div class="cs-wrap"><div class="cs-heading"><span class="cs-eyebrow">Campaign priorities</span><h2>Four clear choices</h2><p>Add-ons and combinations are excluded from every From price shown here.</p></div><div class="cs-grid">
{% for station in gourmet_catalog %}<article class="cs-card" data-station-card="{{ station.key }}" data-price="{{ station.price }}"><img loading="lazy" decoding="async" src="{{ asset_for(station.image) }}" alt="{{ station.name }} by VNV Events" width="700" height="520"><div class="cs-card-body"><div class="cs-rank"><span>Priority {{ '%02d'|format(loop.index) }}</span><span class="cs-price">{{ station.price }} · {{ station.minimum }}</span></div><h2>{{ station.name }}</h2><p>{{ station.summary }}</p><div class="cs-actions"><a class="cs-btn" href="{{ path(station.landing_url) }}">Explore service</a>{% if not ads_mode %}<a class="cs-btn alt" style="color:#087e79;border-color:#087e79" href="{{ station.product_url }}">Menu &amp; options</a>{% endif %}</div></div></article>{% endfor %}
</div></div></section>

<section class="cs-section"><div class="cs-wrap"><div class="cs-corporate"><span class="cs-eyebrow">Corporate &amp; holiday occasion</span><h2>Use the same four services for company events</h2><p>Corporate is an occasion, not a fifth campaign product. VNV can build a proposal around Pasta, Appetizers, Crepes or Taco without inventing a combo price.</p><div class="cs-options"><div class="cs-option"><strong>{{ corporate_overview.station_price }} per guest</strong><p>Published corporate station format for 50 or more guests.</p></div>{% if corporate_overview.meal_box_price %}<div class="cs-option"><strong>{{ corporate_overview.meal_box_price }}</strong><p>A separate breakfast or lunch format, not the price of a live station.</p></div>{% endif %}</div><div class="cs-actions"><a class="cs-btn" href="{{ path(corporate_overview.landing_url) }}">Corporate options</a></div></div>
{% if not ads_mode %}<div class="cs-more"><a href="{{ path('/pizza-station-catering-south-florida/') }}">More stations: Pizza</a><a href="{{ path('/paella-catering-south-florida/') }}">Paella</a><a href="{{ path('/shawarma-station-catering-south-florida/') }}">Shawarma</a><a href="{{ path('/store-categories/') }}">Full catalog</a></div>{% endif %}</div></section>

{% if ads_mode %}
<section class="cs-section cs-light" id="quote"><div class="cs-wrap"><div class="cs-heading"><span class="cs-eyebrow">Quick quote request</span><h2>Check availability in one step</h2><p>Choose a station or select “Not sure yet.” Phone or email is required.</p></div>
{% if landing_notice.message|default('') %}<div class="cs-notice {{ landing_notice.type == 'error' ? 'error' : '' }}" role="status" aria-live="polite">{{ landing_notice.message }}</div>{% endif %}
<form class="cs-form" method="post" action="{{ path('/api/public/gourmet-lead') }}" data-cs-form>
  <input type="hidden" name="csrf_token" value="{{ get_csrf() }}">
  <input type="hidden" name="service_name" value="Not sure yet" data-cs-service-name>
  <input type="hidden" name="landing_url" value="/catering-stations-south-florida/">
  <input type="hidden" name="ref_code" value="{{ ref_code }}">
  <input type="hidden" name="vnv_test" value="{{ is_test ? '1' : '0' }}">
  {% for key in ['gclid','gbraid','wbraid','utm_source','utm_medium','utm_campaign','utm_term','utm_content'] %}<input type="hidden" name="{{ key }}" value="" data-cs-attribution="{{ key }}">{% endfor %}
  <div class="cs-honeypot" aria-hidden="true"><label>Website<input type="text" name="company_website" tabindex="-1" autocomplete="off"></label></div>
  <div class="cs-field full"><label for="cs-service">Service</label><select class="cs-input" id="cs-service" name="service" required><option value="not-sure-yet" data-price="Compare current station prices">Not sure yet</option>{% for station in gourmet_catalog %}<option value="{{ station.key }}" data-name="{{ station.name }}" data-price="{{ station.price }}">{{ station.name }} · {{ station.price }}</option>{% endfor %}</select></div>
  <div class="cs-field"><label for="cs-date">Event date</label><input class="cs-input" id="cs-date" name="event_date" type="date" min="{{ minimum_event_date }}" required></div>
  <div class="cs-field"><label for="cs-guests">Guests</label><select class="cs-input" id="cs-guests" name="guest_bucket" required><option value="">Choose a range</option><option value="25-40">25–40</option><option value="41-75">41–75</option><option value="76-150">76–150</option><option value="150+">150+</option><option value="fewer-than-25">Fewer than 25</option></select></div>
  <div class="cs-field"><label for="cs-zip">Event ZIP</label><input class="cs-input" id="cs-zip" name="zip" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" required></div>
  <div class="cs-field"><label for="cs-name">Name <span class="cs-help">(optional)</span></label><input class="cs-input" id="cs-name" name="full_name" autocomplete="name"></div>
  <div class="cs-field"><label for="cs-phone">Phone</label><input class="cs-input" id="cs-phone" name="phone" type="tel" autocomplete="tel"></div>
  <div class="cs-field"><label for="cs-email">Email</label><input class="cs-input" id="cs-email" name="email" type="email" autocomplete="email"></div>
  <div class="cs-field full"><p class="cs-help">For groups under 25, we will also show Gourmet To Go as an alternative; your request is still saved.</p><button class="cs-btn dark" type="submit">Send request</button></div>
</form></div></section>
{% endif %}

<section class="cs-bottom"><h2>Choose a service and request availability</h2><p>Each service page includes Call, WhatsApp and a one-step quote form.</p><div class="cs-actions" style="justify-content:center"><a class="cs-btn" href="{{ path('/pasta-station-catering-south-florida/') }}#quote">Start with Pasta</a><a class="cs-btn alt" href="{{ path('/appetizer-catering-south-florida/') }}#quote">Start with Appetizers</a></div></section>
</main>
{% if not ads_mode %}{% include "templates/layout/publicFooterVnv.html.twig" %}{% endif %}
{% if ads_mode %}<div class="cs-mobile-bar" aria-label="Quick contact"><a class="cs-mobile-call" href="tel:{{ phone_number }}" data-cs-call>Call</a><a class="cs-mobile-wa" href="https://wa.me/{{ whatsapp_number }}" target="_blank" rel="noopener" data-cs-whatsapp>WhatsApp</a></div>{% endif %}
{% endblock %}

{% block scripts %}
{% if ads_mode %}
<script>
(function(){
  document.body.classList.add('cs-ads');
  const keys=['gclid','gbraid','wbraid','utm_source','utm_medium','utm_campaign','utm_term','utm_content'];
  const q=new URLSearchParams(location.search),maxAge=7776000,secure=location.protocol==='https:'?'; Secure':'';
  if(q.get('gclid')||q.get('gbraid')||q.get('wbraid')||(q.get('utm_source')||'').toLowerCase()==='google'){document.cookie='vnv_ads_session=1; Path=/; SameSite=Lax'+secure;}
  keys.forEach(function(key){const incoming=q.get(key);if(incoming){document.cookie='vnv_'+key+'='+encodeURIComponent(incoming)+'; Max-Age='+maxAge+'; Path=/; SameSite=Lax'+secure;}const match=document.cookie.match(new RegExp('(?:^|; )vnv_'+key+'=([^;]*)'));const value=incoming||(match?decodeURIComponent(match[1]):'');document.querySelectorAll('[data-cs-attribution="'+key+'"]').forEach(input=>input.value=value);});
  const form=document.querySelector('[data-cs-form]'),service=document.getElementById('cs-service'),date=document.getElementById('cs-date'),guests=document.getElementById('cs-guests'),zip=document.getElementById('cs-zip'),serviceName=form?.querySelector('[data-cs-service-name]');
  function selected(){const option=service?.options[service.selectedIndex];return{name:option?.dataset.name||option?.textContent?.split(' · ')[0]||'Not sure yet',price:option?.dataset.price||'Compare current station prices',key:service?.value||'not-sure-yet'};}
  function sync(){if(serviceName)serviceName.value=selected().name;}
  function push(event){window.dataLayer=window.dataLayer||[];window.dataLayer.push({event:event,service:selected().key,ref_code:'{{ ref_code|e('js') }}'});}
  function waUrl(){const item=selected();const message=['Hi VNV Events, I am comparing '+item.name+'.','Visible price: '+item.price,'Event date: '+(date?.value||'Not provided'),'Guests: '+(guests?.options[guests.selectedIndex]?.text||'Not provided'),'ZIP: '+(zip?.value||'Not provided'),'Reference: {{ ref_code|e('js') }}'].join('\n');return 'https://wa.me/{{ whatsapp_number|e('js') }}?text='+encodeURIComponent(message);}
  service?.addEventListener('change',sync);sync();
  document.querySelectorAll('[data-cs-call]').forEach(a=>a.addEventListener('click',()=>push('call_click')));
  document.querySelectorAll('[data-cs-whatsapp]').forEach(function(a){a.addEventListener('click',function(){a.href=waUrl();push('whatsapp_click');const payload={csrf_token:form?.querySelector('[name=csrf_token]')?.value||'',service:selected().key,landing_url:location.pathname,ref_code:'{{ ref_code|e('js') }}',vnv_test:form?.vnv_test?.value||'0'};keys.forEach(k=>payload[k]=form?.querySelector('[name='+k+']')?.value||'');navigator.sendBeacon('{{ path('/api/public/gourmet-track') }}',new Blob([JSON.stringify(payload)],{type:'application/json'}));});});
  form?.addEventListener('submit',function(event){sync();const phone=form.phone.value.replace(/\D/g,''),email=form.email.value.trim();if(phone.length<10&&!email){event.preventDefault();alert('Please enter a phone number or email address.');return;}push('generate_lead');});
})();
</script>
{% endif %}
{% endblock %}
