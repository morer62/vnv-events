<section class="section-vnv section-white">
    <div class="container">
        <div class="process-wrap">
            <div class="process-image-stack">
                <img src="{{ asset_for('assets/images/planner3.jpg') }}" alt="Planning process by VNV Events">
                <img src="{{ asset_for('assets/images/planner4.jpg') }}" alt="Wedding coordination by VNV Events">
            </div>

            <div class="process-panel">
                <span class="vnv-badge">How This Works</span>
                <h3>A more realistic planning structure for South Florida events.</h3>
