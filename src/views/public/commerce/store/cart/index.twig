{% extends "templates/base.twig" %}

{% set show_whatsapp = true %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
<style>
:root{
    --gourmet-primary:#f59e0b;
    --gourmet-primary-dark:#d97706;
    --gourmet-accent:#fb923c;
    --gourmet-cream:#fff8ef;
    --gourmet-soft:#fff3df;
    --gourmet-dark:#1f1307;
    --gourmet-text:#2d241c;
    --gourmet-muted:#6f6255;
    --gourmet-border:#ecd9bf;
    --gourmet-success:#16a34a;
    --gourmet-danger:#dc2626;
    --gourmet-shadow:0 18px 44px rgba(79,43,8,.10);
}

body{
    color:var(--gourmet-text);
    background:#fffaf4;
}

.cart-wrap{
    max-width:1240px;
    margin:0 auto;
    padding:2rem 1rem 4rem;
}

.cart-header{
    background:linear-gradient(135deg,#fff6e8 0%, #fffdf8 100%);
    border:1px solid var(--gourmet-border);
    border-radius:28px;
    padding:2rem 1.5rem;
    box-shadow:var(--gourmet-shadow);
    margin-bottom:1.5rem;
}

.cart-title{
    font-family:'Poppins', sans-serif;
    font-weight:900;
    font-size:clamp(2rem,4vw,3rem);
    line-height:1.05;
    color:var(--gourmet-dark);
    margin-bottom:.75rem;
}

.cart-subtitle{
    color:var(--gourmet-muted);
    line-height:1.8;
    max-width:820px;
    margin:0;
}

.cart-shell{
    display:grid;
    grid-template-columns:1.2fr .8fr;
    gap:1.2rem;
}

.cart-card{
    background:#fff;
    border:1px solid #efdec5;
    border-radius:26px;
    box-shadow:var(--gourmet-shadow);
    overflow:hidden;
}

.cart-card-body{
    padding:1.5rem;
}

.cart-section-title{
    font-size:1.35rem;
    font-weight:900;
    color:var(--gourmet-dark);
    margin-bottom:1rem;
}

.cart-empty{
    text-align:center;
    padding:3rem 1rem;
    color:var(--gourmet-muted);
    border:1px dashed #ead6b9;
    border-radius:18px;
    background:#fffdf9;
}

.cart-items{
    display:flex;
    flex-direction:column;
    gap:1rem;
}

.cart-item{
    display:grid;
    grid-template-columns:90px 1fr auto;
    gap:1rem;
    align-items:center;
    border:1px solid #efdec7;
    border-radius:20px;
    padding:1rem;
    background:#fffdf9;
}

.cart-item-image{
    width:90px;
    height:90px;
    object-fit:cover;
    border-radius:16px;
    background:#f6f6f6;
}

.cart-item-title{
    font-weight:900;
    color:var(--gourmet-dark);
    margin-bottom:.25rem;
}

.cart-item-desc{
    color:var(--gourmet-muted);
    line-height:1.6;
    font-size:.94rem;
    margin-bottom:.5rem;
}

.cart-item-price{
    font-weight:900;
    color:var(--gourmet-primary-dark);
}

.cart-item-actions{
    display:flex;
    flex-direction:column;
    align-items:flex-end;
    gap:.65rem;
}

.qty-box{
    display:flex;
    align-items:center;
    gap:.5rem;
}

.qty-btn{
    width:34px;
    height:34px;
    border-radius:50%;
    border:1px solid #e9d3ad;
    background:#fff8ec;
    color:#7b4700;
    font-weight:900;
    cursor:pointer;
}

.qty-value{
    min-width:24px;
    text-align:center;
    font-weight:900;
    color:var(--gourmet-dark);
}

.remove-btn{
    border:none;
    background:#fff0f0;
    color:#b42318;
    border:1px solid #f4c7c7;
    padding:.5rem .85rem;
    border-radius:999px;
    font-weight:800;
    cursor:pointer;
}

.summary-box{
    background:linear-gradient(135deg,#fff5e6, #fffdf9);
    border:1px solid #efd4a9;
    border-radius:22px;
    padding:1rem;
    margin-bottom:1rem;
}

.summary-row{
    display:flex;
    justify-content:space-between;
    gap:1rem;
    padding:.45rem 0;
    color:#4f463d;
}

.summary-row.discount{
    color:#166534;
    font-weight:800;
}

.summary-row.total{
    border-top:1px dashed #ebd6b2;
    margin-top:.35rem;
    padding-top:.9rem;
    font-weight:900;
    color:var(--gourmet-dark);
    font-size:1.05rem;
}

.coupon-inline{
    margin-top:.85rem;
    padding-top:.85rem;
    border-top:1px dashed #ebd6b2;
}

.coupon-inline-row{
    display:grid;
    grid-template-columns:1fr auto;
    gap:.6rem;
    align-items:center;
}

.coupon-applied-note{
    margin-top:.55rem;
    color:#166534;
    font-size:.88rem;
    font-weight:800;
    display:none;
}

.coupon-applied-note.pending{
    color:#8b4f00;
    display:block;
}

.coupon-applied-note.show{
    display:block;
}

.field{
    margin-bottom:1rem;
}

.field label{
    display:block;
    font-weight:800;
    margin-bottom:.45rem;
    color:#4d3c28;
}

.field input{
    width:100%;
    border:1px solid #e9d7bd;
    border-radius:14px;
    padding:.95rem 1rem;
    background:#fffdfa;
    color:#2d241c;
    outline:none;
}

.field input:focus{
    border-color:#f59e0b;
    box-shadow:0 0 0 4px rgba(245,158,11,.10);
    background:#fff;
}

.btn-main{
    background:linear-gradient(135deg,var(--gourmet-primary),var(--gourmet-accent));
    color:#23160a !important;
    padding:1rem 1.75rem;
    font-size:1rem;
    border-radius:999px;
    text-decoration:none;
    font-weight:900;
    display:inline-flex;
    gap:.55rem;
    align-items:center;
    justify-content:center;
    border:none;
    box-shadow:0 12px 28px rgba(245,158,11,.28);
    transition:all .22s ease;
    width:100%;
}

.btn-light{
    padding:.95rem 1.4rem;
    font-size:1rem;
    border-radius:999px;
    font-weight:800;
    border:1.2px solid #f1d1a3;
    color:var(--gourmet-dark) !important;
    background:#fff;
    text-decoration:none;
    display:inline-flex;
    align-items:center;
    gap:.45rem;
    justify-content:center;
    width:100%;
}

.cart-note{
    color:var(--gourmet-muted);
    font-size:.92rem;
    line-height:1.7;
    margin-top:.75rem;
}

.cart-membership-box{
    border:1px solid #efd4a9;
    background:linear-gradient(135deg,#fffaf2, #fffdf9);
    border-radius:22px;
    padding:1rem;
    margin-bottom:1rem;
}

.cart-membership-top{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:1rem;
    margin-bottom:.75rem;
}

.cart-membership-title{
    font-weight:900;
    color:var(--gourmet-dark);
    margin-bottom:.2rem;
}

.cart-membership-copy{
    color:var(--gourmet-muted);
    line-height:1.65;
    font-size:.94rem;
    margin:0;
}

.membership-status{
    display:inline-flex;
    align-items:center;
    gap:.45rem;
    padding:.45rem .75rem;
    border-radius:999px;
    font-size:.82rem;
    font-weight:900;
    background:#ecfdf3;
    color:#166534;
    border:1px solid #bbf7d0;
    white-space:nowrap;
}

.membership-status.off{
    background:#f8fafc;
    color:#475569;
    border:1px solid #cbd5e1;
}

.membership-switch-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:1rem;
    flex-wrap:wrap;
}

.membership-switch-label{
    font-weight:800;
    color:#4d3c28;
}

.switch{
    position:relative;
    display:inline-block;
    width:62px;
    height:34px;
}

.switch input{
    opacity:0;
    width:0;
    height:0;
}

.slider{
    position:absolute;
    inset:0;
    cursor:pointer;
    background:#d6d3d1;
    transition:.22s;
    border-radius:999px;
}

.slider:before{
    position:absolute;
    content:"";
    height:26px;
    width:26px;
    left:4px;
    top:4px;
    background:white;
    transition:.22s;
    border-radius:50%;
    box-shadow:0 4px 10px rgba(0,0,0,.12);
}

.switch input:checked + .slider{
    background:linear-gradient(135deg,var(--gourmet-primary),var(--gourmet-accent));
}

.switch input:checked + .slider:before{
    transform:translateX(28px);
}

.alert-box{
    border-radius:16px;
    padding:1rem 1rem;
    font-weight:800;
    margin-bottom:1rem;
    display:none;
}

.alert-error{
    background:#fff1f2;
    border:1px solid #fecdd3;
    color:#be123c;
}

.alert-success{
    background:#ecfdf3;
    border:1px solid #bbf7d0;
    color:#166534;
}

@media (max-width: 991px){
    .cart-shell{
        grid-template-columns:1fr;
    }
}

@media (max-width: 768px){
    .cart-item{
        grid-template-columns:1fr;
    }

    .cart-item-actions{
        align-items:flex-start;
    }

    .cart-membership-top,
    .membership-switch-row{
        flex-direction:column;
        align-items:flex-start;
    }

    .coupon-inline-row{
        grid-template-columns:1fr;
    }
}
</style>
{% endblock %}

{% block body %}
<main class="cart-wrap">
    <section class="cart-header">
        <h1 class="cart-title">Your meal cart</h1>
        <p class="cart-subtitle">
            Review your selected meals, update quantities, and continue to checkout. Membership is enabled by default, but you can turn it off here.
        </p>
    </section>

    <section class="cart-shell">
        <div class="cart-card">
            <div class="cart-card-body">
                <h2 class="cart-section-title">Selected meals</h2>

                <div class="alert-box alert-error" id="cartErrorBox"></div>
                <div class="alert-box alert-success" id="cartSuccessBox"></div>

                <div id="cartItemsWrap"></div>

                <div class="cart-note">
                    You need at least <strong>5 meals</strong> in the cart to continue. You can mix different meals in any quantity.
                </div>
            </div>
        </div>

        <div class="cart-card">
            <div class="cart-card-body">
                <h2 class="cart-section-title">Checkout summary</h2>

                <div class="summary-box">
                    <div class="summary-row">
                        <span>Meals selected</span>
                        <strong id="summaryMealsCount">0</strong>
                    </div>
                    <div class="summary-row">
                        <span>Membership</span>
                        <strong id="summaryPricingMode">ON</strong>
                    </div>
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <strong id="summarySubtotal">$0.00</strong>
                    </div>
                    <div class="summary-row discount" id="summaryDiscountRow" style="display:none;">
                        <span>Coupon discount</span>
                        <strong id="summaryDiscount">-$0.00</strong>
                    </div>
                    <div class="summary-row total">
                        <span>Total</span>
                        <strong id="summaryTotal">$0.00</strong>
                    </div>

                    <div class="coupon-inline">
                        <label for="cart_coupon_code" style="display:block;font-weight:800;margin-bottom:.45rem;color:#4d3c28;">
                            Coupon code
                        </label>

                        <div class="coupon-inline-row">
                            <input type="text" id="cart_coupon_code" placeholder="Enter coupon code">
                            <button type="button" class="btn btn-outline-dark" id="applyCouponBtnCart">Apply</button>
                        </div>

                        <div class="coupon-applied-note" id="couponAppliedNote"></div>
                    </div>
                </div>

                <div class="cart-membership-box">
                    <div class="cart-membership-top">
                        <div>
                            <div class="cart-membership-title">Weekly membership</div>
                            <p class="cart-membership-copy">
                                Leave this on if you want this cart to become a recurring membership after checkout.
                            </p>
                        </div>

                        <span class="membership-status" id="membershipStatusBadge">ACTIVE</span>
                    </div>

                    <div class="membership-switch-row">
                        <div class="membership-switch-label">Enable membership</div>

                        <label class="switch">
                            <input type="checkbox" id="membership_enabled" checked>
                            <span class="slider"></span>
                        </label>
                    </div>
                </div>

                <div class="field">
                    <label for="cart_guest_name">Full name</label>
                    <input type="text" id="cart_guest_name" placeholder="Your full name">
                </div>

                <div class="field">
                    <label for="cart_guest_email">Email</label>
                    <input type="email" id="cart_guest_email" placeholder="you@example.com">
                </div>

                <div class="field">
                    <label for="cart_guest_phone">Phone</label>
                    <input type="text" id="cart_guest_phone" placeholder="(305) 000-0000" inputmode="tel" autocomplete="tel">
                </div>

                <button type="button" class="btn-main" id="saveCartBtn">
                    <i class="fa-solid fa-arrow-right"></i> Continue to checkout
                </button>

                <a href="{{ path('/meal-plans') }}" class="btn-light mt-3">
                    <i class="fa-solid fa-arrow-left"></i> Back to meal plans
                </a>
            </div>
        </div>
    </section>
</main>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const CHECKOUT_KEY = 'vnv_gourmet_checkout_selection';
    const DRAFT_KEY = 'vnv_gourmet_cart_draft';
    const SESSION_KEY = 'vnv_gourmet_cart_session_token';

    const cartWrap = document.getElementById('cartItemsWrap');
    const errorBox = document.getElementById('cartErrorBox');
    const successBox = document.getElementById('cartSuccessBox');

    const summaryMealsCount = document.getElementById('summaryMealsCount');
    const summaryPricingMode = document.getElementById('summaryPricingMode');
    const summarySubtotal = document.getElementById('summarySubtotal');
    const summaryDiscountRow = document.getElementById('summaryDiscountRow');
    const summaryDiscount = document.getElementById('summaryDiscount');
    const summaryTotal = document.getElementById('summaryTotal');
    const couponAppliedNote = document.getElementById('couponAppliedNote');

    const membershipEnabledInput = document.getElementById('membership_enabled');
    const membershipStatusBadge = document.getElementById('membershipStatusBadge');
    const saveCartBtn = document.getElementById('saveCartBtn');
    const guestNameInput = document.getElementById('cart_guest_name');
    const guestEmailInput = document.getElementById('cart_guest_email');
    const guestPhoneInput = document.getElementById('cart_guest_phone');
    const couponCodeInput = document.getElementById('cart_coupon_code');
    const applyCouponBtnCart = document.getElementById('applyCouponBtnCart');

    let state = {
        audience: '',
        mealStyle: '',
        items: [],
        membershipEnabled: true,
        pricingMode: 'SUBSCRIPTION',
        guestName: '',
        guestEmail: '',
        guestPhone: '',
        couponCode: '',
        discount: 0
    };

    function showError(message) {
        errorBox.textContent = message;
        errorBox.style.display = 'block';
        successBox.style.display = 'none';
    }

    function showSuccess(message) {
        successBox.textContent = message;
        successBox.style.display = 'block';
        errorBox.style.display = 'none';
    }

    function hideMessages() {
        errorBox.style.display = 'none';
        successBox.style.display = 'none';
    }

    function formatUSPhoneDisplay(value) {
        const digits = String(value || '').replace(/\D/g, '').slice(0, 10);
        const area = digits.slice(0, 3);
        const exch = digits.slice(3, 6);
        const line = digits.slice(6, 10);

        if (!digits) return '';
        if (digits.length < 4) return `(${area}`;
        if (digits.length < 7) return `(${area}) ${exch}`;
        return `(${area}) ${exch}-${line}`;
    }

    function syncPricingMode() {
        state.pricingMode = state.membershipEnabled ? 'SUBSCRIPTION' : 'PAYG';
    }

    function loadSelection() {
        try {
            const raw = localStorage.getItem(CHECKOUT_KEY);
            if (!raw) {
                return false;
            }

            const selection = JSON.parse(raw);

            state.audience = selection.audience || '';
            state.mealStyle = selection.meal_style || '';
            state.items = Array.isArray(selection.items) ? selection.items : [];
            state.membershipEnabled = typeof selection.membership_enabled === 'boolean'
                ? selection.membership_enabled
                : true;
            state.guestName = selection.guest_name || '';
            state.guestEmail = selection.guest_email || '';
            state.guestPhone = selection.guest_phone || '';
            state.couponCode = selection.coupon_code || '';
            state.discount = Number(selection.discount || 0);

            syncPricingMode();

            return state.items.length > 0;
        } catch (e) {
            return false;
        }
    }

    function persistSelection() {
        const totals = computeTotals();

        localStorage.setItem(CHECKOUT_KEY, JSON.stringify({
            source: 'cart',
            audience: state.audience,
            meal_style: state.mealStyle,
            membership_enabled: state.membershipEnabled,
            pricing_mode: state.pricingMode,
            guest_name: state.guestName,
            guest_email: state.guestEmail,
            guest_phone: state.guestPhone,
            coupon_code: state.couponCode,
            discount: Number(state.discount || 0),
            total_meals: totals.meals,
            subtotal: totals.subtotal,
            total: totals.total,
            items: state.items,
            saved_at: new Date().toISOString()
        }));

        const quantities = {};
        state.items.forEach(item => {
            quantities[item.id] = item.quantity;
        });

        localStorage.setItem(DRAFT_KEY, JSON.stringify({
            audience: state.audience,
            mealStyle: state.mealStyle,
            quantities: quantities
        }));
    }

    function getUnitPrice(item) {
        return Number(item.price || 0);
    }

    function computeTotals() {
        let meals = 0;
        let subtotal = 0;

        state.items.forEach(item => {
            const qty = parseInt(item.quantity || 0, 10);
            const unitPrice = getUnitPrice(item);

            meals += qty;
            subtotal += qty * unitPrice;
        });

        subtotal = Number(subtotal.toFixed(2));
        const discount = Number(state.discount || 0);
        const total = Number(Math.max(0, subtotal - discount).toFixed(2));

        return {
            meals,
            subtotal,
            discount,
            total
        };
    }

    function markCouponForReapply() {
        if (state.couponCode) {
            state.discount = 0;
            renderSummary();
            persistSelection();
        }
    }

    function renderSummary() {
        const totals = computeTotals();

        summaryMealsCount.textContent = totals.meals;
        summaryPricingMode.textContent = state.membershipEnabled ? 'ON' : 'OFF';
        summarySubtotal.textContent = `$${totals.subtotal.toFixed(2)}`;
        summaryTotal.textContent = `$${totals.total.toFixed(2)}`;

        membershipStatusBadge.textContent = state.membershipEnabled ? 'ACTIVE' : 'DISABLED';
        membershipStatusBadge.classList.toggle('off', !state.membershipEnabled);
        membershipEnabledInput.checked = !!state.membershipEnabled;

        if (totals.discount > 0) {
            summaryDiscountRow.style.display = 'flex';
            summaryDiscount.textContent = `-$${totals.discount.toFixed(2)}`;
        } else {
            summaryDiscountRow.style.display = 'none';
            summaryDiscount.textContent = '-$0.00';
        }

        couponAppliedNote.classList.remove('show', 'pending');
        couponAppliedNote.textContent = '';

        if (state.couponCode && totals.discount > 0) {
            couponAppliedNote.textContent = `Coupon "${state.couponCode}" applied successfully.`;
            couponAppliedNote.classList.add('show');
        } else if (state.couponCode && totals.discount === 0) {
            couponAppliedNote.textContent = 'Coupon entered. Tap Apply to refresh the total.';
            couponAppliedNote.classList.add('pending');
        }
    }

    function renderItems() {
        if (!state.items.length) {
            cartWrap.innerHTML = `
                <div class="cart-empty">
                    Your cart is empty. Please go back and choose your meals first.
                </div>
            `;
            renderSummary();
            return;
        }

        cartWrap.innerHTML = `
            <div class="cart-items">
                ${state.items.map(item => `
                    <div class="cart-item">
                        ${
                            item.main_image
                                ? `<img src="${item.main_image}" alt="${item.name}" class="cart-item-image">`
                                : `<div class="cart-item-image d-flex align-items-center justify-content-center text-muted">No image</div>`
                        }

                        <div>
                            <div class="cart-item-title">${item.name}</div>
                            <div class="cart-item-desc">${item.short_description || 'Chef-prepared meal option.'}</div>
                            <div class="cart-item-price">$${getUnitPrice(item).toFixed(2)} each</div>
                        </div>

                        <div class="cart-item-actions">
                            <div class="qty-box">
                                <button type="button" class="qty-btn" data-action="minus" data-id="${item.id}">−</button>
                                <span class="qty-value">${item.quantity}</span>
                                <button type="button" class="qty-btn" data-action="plus" data-id="${item.id}">+</button>
                            </div>

                            <button type="button" class="remove-btn" data-action="remove" data-id="${item.id}">
                                Remove
                            </button>
                        </div>
                    </div>
                `).join('')}
            </div>
        `;

        renderSummary();
    }

    function findItem(id) {
        return state.items.find(item => parseInt(item.id, 10) === parseInt(id, 10));
    }

    cartWrap.addEventListener('click', function (e) {
        const btn = e.target.closest('[data-action]');
        if (!btn) return;

        const action = btn.dataset.action;
        const id = parseInt(btn.dataset.id, 10);
        const item = findItem(id);

        if (!item) return;

        let currentQty = parseInt(item.quantity || 0, 10);
        const stockQty = parseInt(item.stock_quantity || 0, 10);

        if (action === 'plus') {
            if (stockQty === 0 || currentQty < stockQty) {
                currentQty++;
            }
        }

        if (action === 'minus') {
            currentQty = Math.max(0, currentQty - 1);
        }

        if (action === 'remove') {
            currentQty = 0;
        }

        item.quantity = currentQty;
        state.items = state.items.filter(product => parseInt(product.quantity || 0, 10) > 0);

        markCouponForReapply();
        persistSelection();
        renderItems();
        hideMessages();
    });

    membershipEnabledInput.addEventListener('change', function () {
        state.membershipEnabled = !!this.checked;
        syncPricingMode();
        markCouponForReapply();
        persistSelection();
        renderSummary();
        hideMessages();
    });

    if (guestPhoneInput) {
        guestPhoneInput.addEventListener('input', () => {
            const formatted = formatUSPhoneDisplay(guestPhoneInput.value);
            if (guestPhoneInput.value !== formatted) {
                guestPhoneInput.value = formatted;
            }
        });
    }

    [guestNameInput, guestEmailInput, guestPhoneInput, couponCodeInput].forEach((input) => {
        if (!input) return;
        input.addEventListener('input', function () {
            state.guestName = (guestNameInput?.value || '').trim();
            state.guestEmail = (guestEmailInput?.value || '').trim();
            state.guestPhone = (guestPhoneInput?.value || '').trim();
            state.couponCode = (couponCodeInput?.value || '').trim();

            if (input === couponCodeInput) {
                state.discount = 0;
                renderSummary();
            }

            persistSelection();
            hideMessages();
        });
    });

    function buildPayload() {
        const sessionToken = localStorage.getItem(SESSION_KEY) || '';

        return {
            audience: state.audience,
            meal_style: state.mealStyle,
            guest_name: state.guestName || '',
            guest_email: state.guestEmail || '',
            guest_phone: state.guestPhone || '',
            city: '',
            coupon_code: state.couponCode || '',
            membership_enabled: state.membershipEnabled,
            pricing_mode: state.pricingMode,
            session_token: sessionToken,
            items: state.items.map(item => ({
                id_product: item.id,
                quantity: item.quantity
            }))
        };
    }

    async function saveCart(options = {}) {
        const {
            redirectToCheckout = false,
            requireEmail = true,
            actionType = 'checkout'
        } = options;

        hideMessages();

        const totals = computeTotals();

        if (totals.meals < 5) {
            showError('You need at least 5 meals to continue.');
            return;
        }

        if (requireEmail && !state.guestEmail) {
            showError('Email is required to continue.');
            return;
        }

        const payload = buildPayload();
        const targetBtn = actionType === 'coupon' ? applyCouponBtnCart : saveCartBtn;
        const originalHtml = targetBtn.innerHTML;

        targetBtn.disabled = true;
        targetBtn.innerHTML = actionType === 'coupon'
            ? 'Applying...'
            : '<i class="fa-solid fa-spinner fa-spin"></i> Saving cart...';

        try {
            const response = await fetch('{{ path("store/cart") }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(payload)
            });

            const data = await response.json();

            if (!data.success) {
                showError(data.message || 'Could not save cart.');
                return;
            }

            localStorage.setItem(SESSION_KEY, data.session_token);
            state.discount = Number(data.discount || 0);
            state.couponCode = data.coupon_code || state.couponCode || '';

            if (couponCodeInput) {
                couponCodeInput.value = state.couponCode;
            }

            persistSelection();
            renderSummary();

            if (redirectToCheckout) {
                showSuccess('Cart saved successfully. Redirecting to checkout...');
                setTimeout(() => {
                    window.location.href = data.redirect || '/store/checkout';
                }, 700);
            } else {
                showSuccess(state.couponCode ? 'Coupon applied successfully.' : 'Cart updated.');
            }
        } catch (e) {
            showError('An unexpected error occurred while saving the cart.');
        } finally {
            targetBtn.disabled = false;
            targetBtn.innerHTML = originalHtml;
        }
    }

    saveCartBtn.addEventListener('click', async function () {
        await saveCart({
            redirectToCheckout: true,
            requireEmail: true,
            actionType: 'checkout'
        });
    });

    if (applyCouponBtnCart) {
        applyCouponBtnCart.addEventListener('click', async function () {
            await saveCart({
                redirectToCheckout: false,
                requireEmail: false,
                actionType: 'coupon'
            });
        });
    }

    (function init() {
        const hasSelection = loadSelection();

        if (!hasSelection) {
            cartWrap.innerHTML = `
                <div class="cart-empty">
                    Your cart is empty. Please start by selecting your meals.
                </div>
            `;
            renderSummary();
            return;
        }

        membershipEnabledInput.checked = !!state.membershipEnabled;
        if (guestNameInput) guestNameInput.value = state.guestName || '';
        if (guestEmailInput) guestEmailInput.value = state.guestEmail || '';
        if (guestPhoneInput) guestPhoneInput.value = formatUSPhoneDisplay(state.guestPhone || '');
        if (couponCodeInput) couponCodeInput.value = state.couponCode || '';
        renderItems();
    })();
});
</script>
{% endblock %}