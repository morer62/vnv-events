{% extends "templates/base.twig" %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
<style>
:root{
    --store-primary:#111827;
    --store-accent:#1f2937;
    --store-soft:#f8fafc;
    --store-muted:#6b7280;
    --store-border:#e5e7eb;
    --store-success:#16a34a;
    --store-danger:#dc2626;
    --store-shadow:0 18px 44px rgba(15,23,42,.08);
}

body{
    color:#111827;
    background:#f8fafc;
}

.cart-wrap{
    max-width:1240px;
    margin:0 auto;
    padding:2rem 1rem 4rem;
}

.cart-header{
    background:linear-gradient(135deg,#ffffff 0%, #f8fafc 100%);
    border:1px solid var(--store-border);
    border-radius:28px;
    padding:2rem 1.5rem;
    box-shadow:var(--store-shadow);
    margin-bottom:1.5rem;
}

.cart-title{
    font-family:'Poppins', sans-serif;
    font-weight:900;
    font-size:clamp(2rem,4vw,3rem);
    line-height:1.05;
    color:#111827;
    margin-bottom:.75rem;
}

.cart-subtitle{
    color:var(--store-muted);
    line-height:1.8;
    max-width:820px;
    margin:0;
}

.cart-shell{
    display:grid;
    grid-template-columns:1.2fr .8fr;
    gap:1.2rem;
}

.cart-card{
    background:#fff;
    border:1px solid var(--store-border);
    border-radius:26px;
    box-shadow:var(--store-shadow);
    overflow:hidden;
}

.cart-card-body{
    padding:1.5rem;
}

.cart-section-title{
    font-size:1.35rem;
    font-weight:900;
    color:#111827;
    margin-bottom:1rem;
}

.cart-empty{
    text-align:center;
    padding:3rem 1rem;
    color:var(--store-muted);
    border:1px dashed #d1d5db;
    border-radius:18px;
    background:#fcfcfd;
}

.cart-items{
    display:flex;
    flex-direction:column;
    gap:1rem;
}

.cart-item{
    display:grid;
    grid-template-columns:90px 1fr auto;
    gap:1rem;
    align-items:center;
    border:1px solid var(--store-border);
    border-radius:20px;
    padding:1rem;
    background:#fcfcfd;
}

.cart-item-image{
    width:90px;
    height:90px;
    object-fit:cover;
    border-radius:16px;
    background:#f3f4f6;
}

.cart-item-title{
    font-weight:900;
    color:#111827;
    margin-bottom:.25rem;
}

.cart-item-desc{
    color:var(--store-muted);
    line-height:1.6;
    font-size:.94rem;
    margin-bottom:.5rem;
}

.cart-item-meta{
    display:flex;
    flex-wrap:wrap;
    gap:.45rem;
    margin-bottom:.45rem;
}

.cart-item-chip{
    display:inline-flex;
    align-items:center;
    padding:.38rem .7rem;
    border-radius:999px;
    background:#f3f4f6;
    border:1px solid var(--store-border);
    color:#374151;
    font-size:.76rem;
    font-weight:800;
}

.cart-item-price{
    font-weight:900;
    color:#111827;
}

.cart-item-actions{
    display:flex;
    flex-direction:column;
    align-items:flex-end;
    gap:.65rem;
}

.qty-box{
    display:flex;
    align-items:center;
    gap:.5rem;
}

.qty-btn{
    width:34px;
    height:34px;
    border-radius:50%;
    border:1px solid #d1d5db;
    background:#fff;
    color:#111827;
    font-weight:900;
    cursor:pointer;
}

.qty-value{
    min-width:24px;
    text-align:center;
    font-weight:900;
    color:#111827;
}

.remove-btn{
    border:none;
    background:#fff0f0;
    color:#b42318;
    border:1px solid #f4c7c7;
    padding:.5rem .85rem;
    border-radius:999px;
    font-weight:800;
    cursor:pointer;
}

.summary-box{
    background:linear-gradient(135deg,#ffffff, #f8fafc);
    border:1px solid var(--store-border);
    border-radius:22px;
    padding:1rem;
    margin-bottom:1rem;
}

.summary-row{
    display:flex;
    justify-content:space-between;
    gap:1rem;
    padding:.45rem 0;
    color:#4b5563;
}

.summary-row.discount{
    color:#166534;
    font-weight:800;
}

.summary-row.total{
    border-top:1px dashed #d1d5db;
    margin-top:.35rem;
    padding-top:.9rem;
    font-weight:900;
    color:#111827;
    font-size:1.05rem;
}

.coupon-inline{
    margin-top:.85rem;
    padding-top:.85rem;
    border-top:1px dashed #d1d5db;
}

.coupon-inline-row{
    display:grid;
    grid-template-columns:1fr auto;
    gap:.6rem;
    align-items:center;
}

.coupon-applied-note{
    margin-top:.55rem;
    color:#166534;
    font-size:.88rem;
    font-weight:800;
    display:none;
}

.coupon-applied-note.pending{
    color:#92400e;
    display:block;
}

.coupon-applied-note.show{
    display:block;
}

.field{
    margin-bottom:1rem;
}

.field label{
    display:block;
    font-weight:800;
    margin-bottom:.45rem;
    color:#374151;
}

.field input{
    width:100%;
    border:1px solid #d1d5db;
    border-radius:14px;
    padding:.95rem 1rem;
    background:#fff;
    color:#111827;
    outline:none;
}

.field input:focus{
    border-color:#111827;
    box-shadow:0 0 0 4px rgba(17,24,39,.08);
    background:#fff;
}

.btn-main{
    background:#111827;
    color:#fff !important;
    padding:1rem 1.75rem;
    font-size:1rem;
    border-radius:999px;
    text-decoration:none;
    font-weight:900;
    display:inline-flex;
    gap:.55rem;
    align-items:center;
    justify-content:center;
    border:none;
    box-shadow:0 12px 28px rgba(17,24,39,.18);
    transition:all .22s ease;
    width:100%;
}

.btn-light{
    padding:.95rem 1.4rem;
    font-size:1rem;
    border-radius:999px;
    font-weight:800;
    border:1.2px solid #d1d5db;
    color:#111827 !important;
    background:#fff;
    text-decoration:none;
    display:inline-flex;
    align-items:center;
    gap:.45rem;
    justify-content:center;
    width:100%;
}

.cart-note{
    color:var(--store-muted);
    font-size:.92rem;
    line-height:1.7;
    margin-top:.75rem;
}

.alert-box{
    border-radius:16px;
    padding:1rem 1rem;
    font-weight:800;
    margin-bottom:1rem;
    display:none;
}

.alert-error{
    background:#fff1f2;
    border:1px solid #fecdd3;
    color:#be123c;
}

.alert-success{
    background:#ecfdf3;
    border:1px solid #bbf7d0;
    color:#166534;
}

@media (max-width: 991px){
    .cart-shell{
        grid-template-columns:1fr;
    }
}

@media (max-width: 768px){
    .cart-item{
        grid-template-columns:1fr;
    }

    .cart-item-actions{
        align-items:flex-start;
    }

    .coupon-inline-row{
        grid-template-columns:1fr;
    }
}
</style>
{% endblock %}

{% block body %}
<main class="cart-wrap">
    <section class="cart-header">
        <h1 class="cart-title">Your cart</h1>
        <p class="cart-subtitle">
            Review selected products, update quantities, and continue to checkout.
        </p>
    </section>

    <section class="cart-shell">
        <div class="cart-card">
            <div class="cart-card-body">
                <h2 class="cart-section-title">Selected items</h2>

                <div class="alert-box alert-error" id="cartErrorBox"></div>
                <div class="alert-box alert-success" id="cartSuccessBox"></div>

                <div id="cartItemsWrap"></div>

                <div class="cart-note">
                    Update quantities, remove items, or continue when everything looks right.
                </div>
            </div>
        </div>

        <div class="cart-card">
            <div class="cart-card-body">
                <h2 class="cart-section-title">Checkout summary</h2>

                <div class="summary-box">
                    <div class="summary-row">
                        <span>Items</span>
                        <strong id="summaryItemsCount">0</strong>
                    </div>
                    <div class="summary-row">
                        <span>Quantity total</span>
                        <strong id="summaryQuantityTotal">0</strong>
                    </div>
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <strong id="summarySubtotal">$0.00</strong>
                    </div>
                    <div class="summary-row discount" id="summaryDiscountRow" style="display:none;">
                        <span>Coupon discount</span>
                        <strong id="summaryDiscount">-$0.00</strong>
                    </div>
                    <div class="summary-row total">
                        <span>Total</span>
                        <strong id="summaryTotal">$0.00</strong>
                    </div>

                    <div class="coupon-inline">
                        <label for="cart_coupon_code" style="display:block;font-weight:800;margin-bottom:.45rem;color:#374151;">
                            Coupon code
                        </label>

                        <div class="coupon-inline-row">
                            <input type="text" id="cart_coupon_code" placeholder="Enter coupon code">
                            <button type="button" class="btn btn-outline-dark" id="applyCouponBtnCart">Apply</button>
                        </div>

                        <div class="coupon-applied-note" id="couponAppliedNote"></div>
                    </div>
                </div>

                <div class="field">
                    <label for="cart_guest_name">Full name</label>
                    <input type="text" id="cart_guest_name" placeholder="Your full name">
                </div>

                <div class="field">
                    <label for="cart_guest_email">Email</label>
                    <input type="email" id="cart_guest_email" placeholder="you@example.com">
                </div>

                <div class="field">
                    <label for="cart_guest_phone">Phone</label>
                    <input type="text" id="cart_guest_phone" placeholder="(305) 000-0000" inputmode="tel" autocomplete="tel">
                </div>

                <button type="button" class="btn-main" id="saveCartBtn">
                    <i class="fa-solid fa-arrow-right"></i> Continue to checkout
                </button>

                <a href="{{ path('/store') }}" class="btn-light mt-3">
                    <i class="fa-solid fa-arrow-left"></i> Back to store
                </a>
            </div>
        </div>
    </section>
</main>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const CART_KEY = 'store_cart_selection';
    const SESSION_KEY = 'store_cart_session_token';

    const cartWrap = document.getElementById('cartItemsWrap');
    const errorBox = document.getElementById('cartErrorBox');
    const successBox = document.getElementById('cartSuccessBox');

    const summaryItemsCount = document.getElementById('summaryItemsCount');
    const summaryQuantityTotal = document.getElementById('summaryQuantityTotal');
    const summarySubtotal = document.getElementById('summarySubtotal');
    const summaryDiscountRow = document.getElementById('summaryDiscountRow');
    const summaryDiscount = document.getElementById('summaryDiscount');
    const summaryTotal = document.getElementById('summaryTotal');
    const couponAppliedNote = document.getElementById('couponAppliedNote');

    const saveCartBtn = document.getElementById('saveCartBtn');
    const guestNameInput = document.getElementById('cart_guest_name');
    const guestEmailInput = document.getElementById('cart_guest_email');
    const guestPhoneInput = document.getElementById('cart_guest_phone');
    const couponCodeInput = document.getElementById('cart_coupon_code');
    const applyCouponBtnCart = document.getElementById('applyCouponBtnCart');

    let state = {
        items: [],
        guestName: '',
        guestEmail: '',
        guestPhone: '',
        couponCode: '',
        discount: 0
    };

    function showError(message) {
        errorBox.textContent = message;
        errorBox.style.display = 'block';
        successBox.style.display = 'none';
    }

    function showSuccess(message) {
        successBox.textContent = message;
        successBox.style.display = 'block';
        errorBox.style.display = 'none';
    }

    function hideMessages() {
        errorBox.style.display = 'none';
        successBox.style.display = 'none';
    }

    function toInt(value, fallback) {
        const n = parseInt(value, 10);
        return Number.isFinite(n) ? n : fallback;
    }

    function toFloat(value, fallback) {
        const n = parseFloat(value);
        return Number.isFinite(n) ? n : fallback;
    }

    function formatUSPhoneDisplay(value) {
        const digits = String(value || '').replace(/\D/g, '').slice(0, 10);
        const area = digits.slice(0, 3);
        const exch = digits.slice(3, 6);
        const line = digits.slice(6, 10);

        if (!digits) return '';
        if (digits.length < 4) return `(${area}`;
        if (digits.length < 7) return `(${area}) ${exch}`;
        return `(${area}) ${exch}-${line}`;
    }

    function loadSelection() {
        try {
            const raw = localStorage.getItem(CART_KEY);
            if (!raw) {
                return false;
            }

            const selection = JSON.parse(raw);

            state.items = Array.isArray(selection.items) ? selection.items : [];
            state.guestName = selection.guest_name || '';
            state.guestEmail = selection.guest_email || '';
            state.guestPhone = selection.guest_phone || '';
            state.couponCode = selection.coupon_code || '';
            state.discount = Number(selection.discount || 0);

            return state.items.length > 0;
        } catch (e) {
            return false;
        }
    }

    function persistSelection() {
        const totals = computeTotals();

        localStorage.setItem(CART_KEY, JSON.stringify({
            source: 'cart',
            pricing_mode: 'PAYG',
            guest_name: state.guestName,
            guest_email: state.guestEmail,
            guest_phone: state.guestPhone,
            coupon_code: state.couponCode,
            discount: Number(state.discount || 0),
            items_count: totals.itemsCount,
            quantity_total: totals.quantityTotal,
            subtotal: totals.subtotal,
            total: totals.total,
            items: state.items,
            saved_at: new Date().toISOString()
        }));
    }

    function computeTotals() {
        let quantityTotal = 0;
        let subtotal = 0;

        state.items.forEach(item => {
            const qty = Math.max(0, toInt(item.quantity || 0, 0));
            const unitPrice = toFloat(item.unit_price || item.price || 0, 0);

            quantityTotal += qty;
            subtotal += qty * unitPrice;
            item.line_total = Number((qty * unitPrice).toFixed(2));
        });

        subtotal = Number(subtotal.toFixed(2));
        const discount = Number(state.discount || 0);
        const total = Number(Math.max(0, subtotal - discount).toFixed(2));

        return {
            itemsCount: state.items.length,
            quantityTotal,
            subtotal,
            discount,
            total
        };
    }

    function markCouponForReapply() {
        if (state.couponCode) {
            state.discount = 0;
            renderSummary();
            persistSelection();
        }
    }

    function renderSummary() {
        const totals = computeTotals();

        summaryItemsCount.textContent = totals.itemsCount;
        summaryQuantityTotal.textContent = totals.quantityTotal;
        summarySubtotal.textContent = `$${totals.subtotal.toFixed(2)}`;
        summaryTotal.textContent = `$${totals.total.toFixed(2)}`;

        if (totals.discount > 0) {
            summaryDiscountRow.style.display = 'flex';
            summaryDiscount.textContent = `-$${totals.discount.toFixed(2)}`;
        } else {
            summaryDiscountRow.style.display = 'none';
            summaryDiscount.textContent = '-$0.00';
        }

        couponAppliedNote.classList.remove('show', 'pending');
        couponAppliedNote.textContent = '';

        if (state.couponCode && totals.discount > 0) {
            couponAppliedNote.textContent = `Coupon "${state.couponCode}" applied successfully.`;
            couponAppliedNote.classList.add('show');
        } else if (state.couponCode && totals.discount === 0) {
            couponAppliedNote.textContent = 'Coupon entered. Tap Apply to refresh the total.';
            couponAppliedNote.classList.add('pending');
        }
    }

    function renderItems() {
        if (!state.items.length) {
            cartWrap.innerHTML = `
                <div class="cart-empty">
                    Your cart is empty. Please start by selecting products.
                </div>
            `;
            renderSummary();
            return;
        }

        cartWrap.innerHTML = `
            <div class="cart-items">
                ${state.items.map((item, idx) => `
                    <div class="cart-item">
                        ${
                            item.main_image
                                ? `<img src="${item.main_image}" alt="${item.product_name || item.name || ''}" class="cart-item-image">`
                                : `<div class="cart-item-image d-flex align-items-center justify-content-center text-muted">No image</div>`
                        }

                        <div>
                            <div class="cart-item-title">${item.product_name || item.name || 'Product'}</div>
                            <div class="cart-item-desc">${item.short_description || 'Selected store item.'}</div>

                            <div class="cart-item-meta">
                                ${item.variation_name ? `<span class="cart-item-chip">${item.variation_name}</span>` : ''}
                                ${(Array.isArray(item.variation_options) ? item.variation_options : []).map(opt => `
                                    <span class="cart-item-chip">${opt.attribute_name}: ${opt.attribute_value}</span>
                                `).join('')}
                            </div>

                            <div class="cart-item-price">$${toFloat(item.unit_price || item.price || 0, 0).toFixed(2)} each</div>
                        </div>

                        <div class="cart-item-actions">
                            <div class="qty-box">
                                <button type="button" class="qty-btn" data-action="minus" data-index="${idx}">−</button>
                                <span class="qty-value">${item.quantity}</span>
                                <button type="button" class="qty-btn" data-action="plus" data-index="${idx}">+</button>
                            </div>

                            <button type="button" class="remove-btn" data-action="remove" data-index="${idx}">
                                Remove
                            </button>
                        </div>
                    </div>
                `).join('')}
            </div>
        `;

        renderSummary();
    }

    cartWrap.addEventListener('click', function (e) {
        const btn = e.target.closest('[data-action]');
        if (!btn) return;

        const action = btn.dataset.action;
        const index = parseInt(btn.dataset.index, 10);
        const item = state.items[index];

        if (!item) return;

        let currentQty = parseInt(item.quantity || 0, 10);
        const stockQty = parseInt(item.stock_quantity || 0, 10);
        const minQty = Math.max(1, parseInt(item.min_purchase_qty || 1, 10));
        const maxQty = item.max_purchase_qty !== null && item.max_purchase_qty !== undefined && item.max_purchase_qty !== ''
            ? Math.max(1, parseInt(item.max_purchase_qty, 10))
            : null;

        if (action === 'plus') {
            currentQty++;
            if (stockQty > 0) {
                currentQty = Math.min(currentQty, stockQty);
            }
            if (maxQty !== null) {
                currentQty = Math.min(currentQty, maxQty);
            }
        }

        if (action === 'minus') {
            currentQty = Math.max(0, currentQty - 1);
            if (currentQty > 0) {
                currentQty = Math.max(currentQty, minQty);
            }
        }

        if (action === 'remove') {
            currentQty = 0;
        }

        item.quantity = currentQty;
        state.items = state.items.filter(product => parseInt(product.quantity || 0, 10) > 0);

        markCouponForReapply();
        persistSelection();
        renderItems();
        hideMessages();
    });

    if (guestPhoneInput) {
        guestPhoneInput.addEventListener('input', () => {
            const formatted = formatUSPhoneDisplay(guestPhoneInput.value);
            if (guestPhoneInput.value !== formatted) {
                guestPhoneInput.value = formatted;
            }
        });
    }

    [guestNameInput, guestEmailInput, guestPhoneInput, couponCodeInput].forEach((input) => {
        if (!input) return;
        input.addEventListener('input', function () {
            state.guestName = (guestNameInput?.value || '').trim();
            state.guestEmail = (guestEmailInput?.value || '').trim();
            state.guestPhone = (guestPhoneInput?.value || '').trim();
            state.couponCode = (couponCodeInput?.value || '').trim();

            if (input === couponCodeInput) {
                state.discount = 0;
                renderSummary();
            }

            persistSelection();
            hideMessages();
        });
    });

    function buildPayload() {
        const sessionToken = localStorage.getItem(SESSION_KEY) || '';

        return {
            guest_name: state.guestName || '',
            guest_email: state.guestEmail || '',
            guest_phone: state.guestPhone || '',
            city: '',
            coupon_code: state.couponCode || '',
            pricing_mode: 'PAYG',
            session_token: sessionToken,
            items: state.items.map(item => ({
                id_product: item.id_product || item.id,
                id_product_variation: item.id_product_variation || null,
                quantity: item.quantity
            }))
        };
    }

    async function saveCart(options = {}) {
        const {
            redirectToCheckout = false,
            requireEmail = true,
            actionType = 'checkout'
        } = options;

        hideMessages();

        if (!state.items.length) {
            showError('Your cart is empty.');
            return;
        }

        if (requireEmail && !state.guestEmail) {
            showError('Email is required to continue.');
            return;
        }

        const payload = buildPayload();
        const targetBtn = actionType === 'coupon' ? applyCouponBtnCart : saveCartBtn;
        const originalHtml = targetBtn.innerHTML;

        targetBtn.disabled = true;
        targetBtn.innerHTML = actionType === 'coupon'
            ? 'Applying...'
            : '<i class="fa-solid fa-spinner fa-spin"></i> Saving cart...';

        try {
            const response = await fetch('{{ path("store/cart") }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(payload)
            });

            const data = await response.json();

            if (!data.success) {
                showError(data.message || 'Could not save cart.');
                return;
            }

            localStorage.setItem(SESSION_KEY, data.session_token);
            state.discount = Number(data.discount || 0);
            state.couponCode = data.coupon_code || state.couponCode || '';

            if (couponCodeInput) {
                couponCodeInput.value = state.couponCode;
            }

            persistSelection();
            renderSummary();

            if (redirectToCheckout) {
                showSuccess('Cart saved successfully. Redirecting to checkout...');
                setTimeout(() => {
                    window.location.href = data.redirect || '/store/checkout';
                }, 700);
            } else {
                showSuccess(state.couponCode ? 'Coupon applied successfully.' : 'Cart updated.');
            }
        } catch (e) {
            showError('An unexpected error occurred while saving the cart.');
        } finally {
            targetBtn.disabled = false;
            targetBtn.innerHTML = originalHtml;
        }
    }

    saveCartBtn.addEventListener('click', async function () {
        await saveCart({
            redirectToCheckout: true,
            requireEmail: true,
            actionType: 'checkout'
        });
    });

    if (applyCouponBtnCart) {
        applyCouponBtnCart.addEventListener('click', async function () {
            await saveCart({
                redirectToCheckout: false,
                requireEmail: false,
                actionType: 'coupon'
            });
        });
    }

    (function init() {
        const hasSelection = loadSelection();

        if (!hasSelection) {
            cartWrap.innerHTML = `
                <div class="cart-empty">
                    Your cart is empty. Please start by selecting products.
                </div>
            `;
            renderSummary();
            return;
        }

        if (guestNameInput) guestNameInput.value = state.guestName || '';
        if (guestEmailInput) guestEmailInput.value = state.guestEmail || '';
        if (guestPhoneInput) guestPhoneInput.value = formatUSPhoneDisplay(state.guestPhone || '');
        if (couponCodeInput) couponCodeInput.value = state.couponCode || '';
        renderItems();
    })();
});
</script>
{% endblock %}