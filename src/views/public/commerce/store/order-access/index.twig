{% extends "templates/base.twig" %}

{% block styles %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
<style>
:root{
    --store-primary:#111827;
    --store-accent:#1f2937;
    --store-soft:#f8fafc;
    --store-muted:#6b7280;
    --store-border:#e5e7eb;
    --store-success:#16a34a;
    --store-danger:#dc2626;
    --store-shadow:0 18px 44px rgba(15,23,42,.08);
}

body{
    color:#111827;
    background:#f8fafc;
}

.order-wrap{
    max-width:1240px;
    margin:0 auto;
    padding:2rem 1rem 4rem;
}

.order-header{
    background:linear-gradient(135deg,#ffffff 0%, #f8fafc 100%);
    border:1px solid var(--store-border);
    border-radius:28px;
    padding:2rem 1.5rem;
    box-shadow:var(--store-shadow);
    margin-bottom:1.5rem;
}

.order-title{
    font-family:'Poppins', sans-serif;
    font-weight:900;
    font-size:clamp(2rem,4vw,3rem);
    line-height:1.05;
    color:#111827;
    margin-bottom:.75rem;
}

.order-subtitle{
    color:var(--store-muted);
    line-height:1.8;
    max-width:820px;
    margin:0;
}

.order-shell{
    display:grid;
    grid-template-columns:1fr .95fr;
    gap:1.2rem;
}

.order-card{
    background:#fff;
    border:1px solid var(--store-border);
    border-radius:26px;
    box-shadow:var(--store-shadow);
    overflow:hidden;
}

.order-card-body{
    padding:1.5rem;
}

.order-section-title{
    font-size:1.35rem;
    font-weight:900;
    color:#111827;
    margin-bottom:1rem;
}

.status-badge{
    display:inline-flex;
    align-items:center;
    gap:.5rem;
    border-radius:999px;
    padding:.6rem 1rem;
    font-size:.92rem;
    font-weight:900;
}

.status-paid{
    background:#ecfdf3;
    color:#166534;
    border:1px solid #bbf7d0;
}

.status-pending{
    background:#fff7ed;
    color:#9a3412;
    border:1px solid #fed7aa;
}

.status-failed{
    background:#fff1f2;
    color:#be123c;
    border:1px solid #fecdd3;
}

.status-refunded{
    background:#f5f3ff;
    color:#6d28d9;
    border:1px solid #ddd6fe;
}

.info-grid{
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:1rem;
}

.info-box{
    border:1px solid var(--store-border);
    border-radius:18px;
    padding:1rem;
    background:#fcfcfd;
}

.info-label{
    font-size:.85rem;
    color:var(--store-muted);
    margin-bottom:.25rem;
}

.info-value{
    font-weight:900;
    color:#111827;
    word-break:break-word;
}

.order-items{
    display:flex;
    flex-direction:column;
    gap:1rem;
}

.order-item{
    display:grid;
    grid-template-columns:80px 1fr auto;
    gap:1rem;
    align-items:center;
    border:1px solid var(--store-border);
    border-radius:18px;
    padding:1rem;
    background:#fcfcfd;
}

.order-item-image{
    width:80px;
    height:80px;
    object-fit:cover;
    border-radius:14px;
    background:#f6f6f6;
}

.order-item-title{
    font-weight:900;
    color:#111827;
    margin-bottom:.2rem;
}

.order-item-meta{
    color:var(--store-muted);
    font-size:.94rem;
    line-height:1.6;
}

.order-item-chip{
    display:inline-flex;
    align-items:center;
    padding:.38rem .7rem;
    border-radius:999px;
    background:#f3f4f6;
    border:1px solid var(--store-border);
    color:#374151;
    font-size:.76rem;
    font-weight:800;
    margin:0 .35rem .35rem 0;
}

.order-item-total{
    font-weight:900;
    color:#111827;
}

.summary-box{
    background:linear-gradient(135deg,#ffffff, #f8fafc);
    border:1px solid var(--store-border);
    border-radius:22px;
    padding:1rem;
    margin-bottom:1rem;
}

.summary-row{
    display:flex;
    justify-content:space-between;
    gap:1rem;
    padding:.5rem 0;
    color:#4b5563;
}

.summary-row.discount{
    color:#166534;
    font-weight:800;
}

.summary-row.total{
    border-top:1px dashed #d1d5db;
    margin-top:.35rem;
    padding-top:.95rem;
    font-weight:900;
    color:#111827;
    font-size:1.05rem;
}

.notice-box{
    border-radius:20px;
    padding:1rem 1.1rem;
    margin-bottom:1rem;
    line-height:1.7;
}

.notice-success{
    background:#ecfdf3;
    border:1px solid #bbf7d0;
    color:#166534;
}

.notice-soft{
    background:#f8fafc;
    border:1px solid #e2e8f0;
    color:#475569;
}

.btn-main{
    background:#111827;
    color:#fff !important;
    padding:1rem 1.75rem;
    font-size:1rem;
    border-radius:999px;
    text-decoration:none;
    font-weight:900;
    display:inline-flex;
    gap:.55rem;
    align-items:center;
    justify-content:center;
    border:none;
    box-shadow:0 12px 28px rgba(17,24,39,.18);
    transition:all .22s ease;
}

.btn-light{
    padding:.95rem 1.4rem;
    font-size:1rem;
    border-radius:999px;
    font-weight:800;
    border:1.2px solid #d1d5db;
    color:#111827 !important;
    background:#fff;
    text-decoration:none;
    display:inline-flex;
    align-items:center;
    gap:.45rem;
    justify-content:center;
}

.cta-stack{
    display:flex;
    flex-wrap:wrap;
    gap:.75rem;
}

@media (max-width: 991px){
    .order-shell{
        grid-template-columns:1fr;
    }
}

@media (max-width: 768px){
    .info-grid{
        grid-template-columns:1fr;
    }

    .order-item{
        grid-template-columns:1fr;
    }

    .cta-stack{
        flex-direction:column;
    }

    .btn-main,
    .btn-light{
        width:100%;
        justify-content:center;
    }
}
</style>
{% endblock %}

{% block body %}
<main class="order-wrap">
    {% if not order %}
        <section class="order-header">
            <h1 class="order-title">Order not found</h1>
            <p class="order-subtitle">{{ errorMessage ?: 'This order link is unavailable or has expired.' }}</p>
            <div class="cta-stack mt-4">
                <a href="{{ path('store') }}" class="btn-light">
                    <i class="fa-solid fa-store"></i> Continue Shopping
                </a>
                <a href="{{ path('') }}" class="btn-light">
                    <i class="fa-solid fa-house"></i> Back to Home
                </a>
            </div>
        </section>
    {% else %}
    <section class="order-header">
        <h1 class="order-title">Your order is confirmed</h1>
        <p class="order-subtitle">
            Review your order details, payment status, purchased items, and saved customer information below.
        </p>
    </section>

    <section class="order-shell">
        <div class="order-card">
            <div class="order-card-body">
                <h2 class="order-section-title">Order details</h2>

                {% if order.payment_status == 'PAID' %}
                    <div class="notice-box notice-success">
                        <strong>Payment completed successfully.</strong> Your order has been recorded and is now part of your store order history.
                    </div>
                {% endif %}

                <div class="info-grid mb-4">
                    <div class="info-box">
                        <div class="info-label">Order ID</div>
                        <div class="info-value">#{{ order.id }}</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Payment status</div>
                        <div class="info-value">
                            {% if order.payment_status == 'PAID' %}
                                <span class="status-badge status-paid"><i class="fa-solid fa-circle-check"></i> PAID</span>
                            {% elseif order.payment_status == 'FAILED' %}
                                <span class="status-badge status-failed"><i class="fa-solid fa-circle-xmark"></i> FAILED</span>
                            {% elseif order.payment_status == 'REFUNDED' %}
                                <span class="status-badge status-refunded"><i class="fa-solid fa-rotate-left"></i> REFUNDED</span>
                            {% else %}
                                <span class="status-badge status-pending"><i class="fa-solid fa-clock"></i> PENDING</span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Customer name</div>
                        <div class="info-value">{{ order.guest_name ?: '—' }}</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Email</div>
                        <div class="info-value">{{ order.guest_email ?: '—' }}</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Phone</div>
                        <div class="info-value">{{ order.guest_phone ?: '—' }}</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Area / city</div>
                        <div class="info-value">{{ order.city ?: '—' }}</div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Billing address</div>
                        <div class="info-value">
                            {% if order.billing_address_1 %}
                                {{ order.billing_address_1 }}
                                {% if order.billing_address_2 %}<br>{{ order.billing_address_2 }}{% endif %}
                                {% if order.billing_city or order.billing_state or order.billing_zip %}
                                    <br>{{ order.billing_city }}{% if order.billing_city and order.billing_state %}, {% endif %}{{ order.billing_state }} {{ order.billing_zip }}
                                {% endif %}
                            {% else %}
                                —
                            {% endif %}
                        </div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Shipping address</div>
                        <div class="info-value">
                            {% if order.shipping_address_1 %}
                                {{ order.shipping_address_1 }}
                                {% if order.shipping_address_2 %}<br>{{ order.shipping_address_2 }}{% endif %}
                                {% if order.shipping_city or order.shipping_state or order.shipping_zip %}
                                    <br>{{ order.shipping_city }}{% if order.shipping_city and order.shipping_state %}, {% endif %}{{ order.shipping_state }} {{ order.shipping_zip }}
                                {% endif %}
                            {% else %}
                                —
                            {% endif %}
                        </div>
                    </div>
                </div>

                <h2 class="order-section-title">Items purchased</h2>

                <div class="order-items">
                    {% for item in order.items %}
                        <div class="order-item">
                            {% if item.main_image %}
                                <img src="{{ item.main_image }}" alt="{{ item.product_name_snapshot }}" class="order-item-image">
                            {% else %}
                                <div class="order-item-image d-flex align-items-center justify-content-center text-muted">No image</div>
                            {% endif %}

                            <div>
                                <div class="order-item-title">{{ item.product_name_snapshot }}</div>

                                <div class="order-item-meta">
                                    {% if item.variation_name_snapshot %}
                                        <div><strong>{{ item.variation_name_snapshot }}</strong></div>
                                    {% endif %}

                                    {% if item.variation_options %}
                                        {% set variation_options = item.variation_options %}
                                        {% if variation_options %}
                                            <div class="mt-1">
                                                {% for opt in variation_options %}
                                                    <span class="order-item-chip">{{ opt.attribute_name }}: {{ opt.attribute_value }}</span>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    {% endif %}

                                    <div class="mt-1">
                                        {{ item.quantity }} × ${{ item.unit_price|number_format(2, '.', ',') }}
                                    </div>
                                </div>
                            </div>

                            <div class="order-item-total">
                                ${{ item.line_total|number_format(2, '.', ',') }}
                            </div>
                        </div>
                    {% else %}
                        <div class="notice-box notice-soft">
                            No order items found.
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="order-card">
            <div class="order-card-body">
                <h2 class="order-section-title">Summary</h2>

                <div class="summary-box">
                    <div class="summary-row">
                        <span>Items</span>
                        <strong>{{ order.items_count }}</strong>
                    </div>
                    <div class="summary-row">
                        <span>Quantity total</span>
                        <strong>{{ order.meals_count }}</strong>
                    </div>
                    <div class="summary-row">
                        <span>Pricing mode</span>
                        <strong>{{ order.pricing_mode }}</strong>
                    </div>
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <strong>${{ order.subtotal|number_format(2, '.', ',') }}</strong>
                    </div>
                    {% if order.discount > 0 %}
                        <div class="summary-row discount">
                            <span>Discount</span>
                            <strong>-${{ order.discount|number_format(2, '.', ',') }}</strong>
                        </div>
                    {% endif %}
                    <div class="summary-row total">
                        <span>Total</span>
                        <strong>${{ order.total|number_format(2, '.', ',') }}</strong>
                    </div>
                </div>

                {% if existingUser %}
                    <div class="notice-box notice-success">
                        <strong>Your customer account already exists.</strong>
                        You can log in with <strong>{{ order.guest_email }}</strong> to review your order history and account details.
                    </div>
                {% else %}
                    <div class="notice-box notice-soft">
                        If you created an account during checkout, use your email to access future order information.
                    </div>
                {% endif %}

                <div class="cta-stack">
                    {% if existingUser %}
                        <a href="{{ path('login') }}" class="btn-main">
                            <i class="fa-solid fa-right-to-bracket"></i> Login
                        </a>
                    {% endif %}

                    <a href="{{ path('store') }}" class="btn-light">
                        <i class="fa-solid fa-store"></i> Continue Shopping
                    </a>

                    <a href="{{ path('') }}" class="btn-light">
                        <i class="fa-solid fa-house"></i> Back to Home
                    </a>
                </div>
            </div>
        </div>
    </section>
    {% endif %}
</main>
{% endblock %}
