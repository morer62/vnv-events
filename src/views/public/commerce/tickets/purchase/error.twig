{% extends 'templates/base.twig' %}

{% block title %}Payment Error{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body text-center">
                    <div class="mb-4">
                        <i class="fa-solid fa-exclamation-triangle text-danger" style="font-size: 4rem;"></i>
                    </div>
                    
                    <h2 class="card-title text-danger mb-3">❌ Payment Error</h2>
                    
                    <div class="alert alert-danger">
                        <h5>Payment Failed</h5>
                        <p class="mb-0">{{ error }}</p>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a href="javascript:history.back()" class="btn btn-primary">
                            <i class="fa-solid fa-arrow-left"></i> Go Back
                        </a>
                        <a href="{{ base_url }}/search" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-search"></i> Browse Events
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
