<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#071b17">
    <title>{{ venueEvent.name }} Tickets · VNV Events</title>
    <link rel="icon" href="{{ asset_for('template/img/icons/icon-48x48.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
    <script src="https://js.stripe.com/v3/"></script>
    <style>
        :root{--ink:#071b17;--forest:#0b4c3f;--teal:#118b77;--mint:#55ddbf;--cream:#f5f2e9;--gold:#d8ad3d;--line:#dce7e2;--muted:#667a73}*{box-sizing:border-box}body{margin:0;background:linear-gradient(180deg,#071b17 0 390px,#f4f7f5 390px);color:var(--ink);font-family:"DM Sans",sans-serif}.ticket-page{width:min(1180px,calc(100% - 32px));margin:0 auto;padding:24px 0 64px}.brand-bar{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:8px 0 24px;color:#fff}.brand-bar img{width:138px;height:auto;filter:brightness(0) invert(1)}.secure-note{display:flex;align-items:center;gap:9px;color:rgba(255,255,255,.72);font-size:.86rem}.event-hero{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(280px,.55fr);min-height:310px;overflow:hidden;border:1px solid rgba(255,255,255,.12);border-radius:30px;background:linear-gradient(125deg,rgba(7,27,23,.98),rgba(13,84,69,.9)),url('{{ venueEvent.image|default(asset_for("assets/images/vnv-core-brunch-mansion-hero.png")) }}') center/cover;box-shadow:0 28px 80px rgba(0,0,0,.22)}.hero-copy{display:flex;flex-direction:column;justify-content:flex-end;padding:40px;color:#fff}.eyebrow{display:inline-flex;align-self:flex-start;align-items:center;gap:8px;padding:8px 12px;border:1px solid rgba(89,231,201,.32);border-radius:999px;color:#78eed5;background:rgba(64,211,182,.1);font-size:.74rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.hero-copy h1{max-width:760px;margin:15px 0 12px;font-family:"Playfair Display",serif;font-size:clamp(2.2rem,5vw,4.7rem);line-height:.98}.hero-copy p{max-width:670px;margin:0;color:rgba(255,255,255,.75);font-size:1rem;line-height:1.65}.event-facts{display:grid;align-content:end;gap:12px;padding:28px;background:rgba(255,255,255,.08);backdrop-filter:blur(12px);color:#fff}.event-fact{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid rgba(255,255,255,.13)}.event-fact:last-child{border:0}.event-fact i{width:20px;color:var(--mint);margin-top:3px}.event-fact span{display:block;color:rgba(255,255,255,.62);font-size:.72rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.event-fact strong{display:block;margin-top:3px}.checkout-grid{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:20px;margin-top:22px}.panel{padding:26px;border:1px solid var(--line);border-radius:24px;background:#fff;box-shadow:0 18px 50px rgba(12,52,44,.07)}.panel h2{margin:0;font-size:1.35rem}.panel-intro{margin:6px 0 22px;color:var(--muted)}.sales-stage{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:17px;padding:14px 16px;border-radius:16px;background:#e6f8f3;color:#0a6657}.sales-stage span{font-size:.82rem}.sales-stage strong{display:block}.stage-discount{padding:6px 9px;border-radius:999px;background:#0b705f;color:#fff;font-size:.74rem;font-weight:800}.ticket-option{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px;align-items:center;padding:19px 0;border-bottom:1px solid #e9efec}.ticket-option:last-child{border-bottom:0}.ticket-option h3{margin:0;font-size:1.05rem}.ticket-option p{margin:5px 0 0;color:var(--muted);font-size:.9rem;line-height:1.5}.ticket-price{display:block;margin-top:8px;color:#086e5e;font-size:1.18rem;font-weight:850}.ticket-price s{margin-right:6px;color:#8e9995;font-size:.82rem;font-weight:500}.qty-control{display:flex;align-items:center;gap:4px;padding:5px;border:1px solid #cedbd6;border-radius:999px;background:#f8fbfa}.qty-control button{width:34px;height:34px;border:0;border-radius:50%;background:#e2f4ef;color:#086a5a;font-size:1rem;font-weight:800;cursor:pointer}.qty-control input{width:38px;border:0;background:transparent;text-align:center;font:800 1rem "DM Sans";outline:0}.buyer-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:.8rem;font-weight:800}.field input{width:100%;min-height:48px;padding:12px 14px;border:1px solid #cfdcd7;border-radius:13px;font:500 .95rem "DM Sans";outline:none}.field input:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(17,139,119,.1)}.payment-card{position:sticky;top:20px}.order-lines{display:grid;gap:10px;margin:19px 0}.order-line{display:flex;justify-content:space-between;gap:15px;color:var(--muted)}.order-line strong{color:var(--ink)}.order-total{display:flex;justify-content:space-between;gap:15px;padding:17px 0;border-top:1px solid var(--line);font-size:1.2rem;font-weight:900}.stripe-shell{min-height:50px;margin:8px 0 10px;padding:15px;border:1px solid #cfdcd7;border-radius:13px;background:#fff}.card-errors{min-height:22px;color:#b42318;font-size:.82rem}.purchase-button{width:100%;min-height:52px;border:0;border-radius:999px;background:linear-gradient(135deg,#0a6c5b,#11a188);color:#fff;font:800 .97rem "DM Sans";cursor:pointer;box-shadow:0 13px 30px rgba(11,112,94,.23)}.purchase-button:disabled{cursor:wait;opacity:.65}.trust-list{display:grid;gap:9px;margin-top:17px;color:var(--muted);font-size:.82rem}.trust-list div{display:flex;align-items:center;gap:8px}.trust-list i{color:#0a7b68}.empty-selection{color:var(--muted);font-size:.9rem}.powered{margin-top:28px;text-align:center;color:#788982;font-size:.8rem}@media(max-width:860px){body{background:linear-gradient(180deg,#071b17 0 510px,#f4f7f5 510px)}.event-hero,.checkout-grid{grid-template-columns:1fr}.event-facts{grid-template-columns:1fr 1fr}.payment-card{position:static}}@media(max-width:560px){.ticket-page{width:min(100% - 20px,1180px);padding-top:12px}.brand-bar img{width:112px}.secure-note span{display:none}.event-hero{border-radius:22px}.hero-copy{padding:28px 20px}.event-facts{grid-template-columns:1fr;padding:18px 20px}.panel{padding:21px 17px;border-radius:20px}.ticket-option{grid-template-columns:1fr}.qty-control{justify-self:start}.buyer-grid{grid-template-columns:1fr}.field.full{grid-column:auto}}
    </style>
</head>
<body>
<main class="ticket-page">
    <header class="brand-bar"><a href="{{ path('') }}" aria-label="VNV Events home"><img src="{{ asset_for('assets/images/vnv-logo.webp') }}" alt="VNV Events"></a><div class="secure-note"><i class="fa-solid fa-lock"></i><span>Secure ticket checkout</span></div></header>
    <section class="event-hero">
        <div class="hero-copy"><span class="eyebrow"><i class="fa-solid fa-ticket"></i> Official VNV ticketing</span><h1>{{ venueEvent.name }}</h1><p>{{ venueEvent.description|default('Reserve your place and keep every ticket ready in your VNV account.') }}</p></div>
        <div class="event-facts"><div class="event-fact"><i class="fa-regular fa-calendar"></i><div><span>Date</span><strong>{{ venueEvent.start_date|date('l, F j, Y') }}</strong></div></div>{% if venueEvent.start_date %}<div class="event-fact"><i class="fa-regular fa-clock"></i><div><span>Time</span><strong>{{ venueEvent.start_date|date('g:i A') }}</strong></div></div>{% endif %}{% if venueEvent.location or venueEvent.venue_location %}<div class="event-fact"><i class="fa-solid fa-location-dot"></i><div><span>Location</span><strong>{{ venueEvent.location|default(venueEvent.venue_location) }}</strong></div></div>{% endif %}</div>
    </section>
    <form id="ticket-checkout" class="checkout-grid" method="post" action="{{ path('tickets/purchase') }}">
        <div>
            <section class="panel"><h2>Choose your tickets</h2><p class="panel-intro">Select the quantity for each ticket type.</p>{% if currentStage %}<div class="sales-stage"><div><span>Current sales stage</span><strong>{{ currentStage.name }}</strong></div>{% if currentStage.discount_percentage > 0 %}<span class="stage-discount">{{ currentStage.discount_percentage|number_format(0) }}% off</span>{% endif %}</div>{% endif %}<div id="ticket-options">{% for ticket in ticketTypes %}{% set discount = currentStage ? currentStage.discount_percentage|default(0) : 0 %}{% set finalPrice = ticket.price * (1 - discount / 100) %}<article class="ticket-option" data-ticket-id="{{ ticket.id }}" data-ticket-name="{{ ticket.name|e('html_attr') }}" data-ticket-price="{{ finalPrice }}"><div><h3>{{ ticket.name }}</h3>{% if ticket.description %}<p>{{ ticket.description }}</p>{% endif %}<span class="ticket-price">{% if discount > 0 %}<s>${{ ticket.price|number_format(2) }}</s>{% endif %}${{ finalPrice|number_format(2) }}</span></div><div class="qty-control" aria-label="Quantity for {{ ticket.name }}"><button type="button" data-change="-1" aria-label="Decrease">−</button><input class="ticket-quantity" type="number" min="0" max="10" value="0" inputmode="numeric" aria-label="{{ ticket.name }} quantity"><button type="button" data-change="1" aria-label="Increase">+</button></div></article>{% endfor %}</div></section>
            <section class="panel mt-3" style="margin-top:20px"><h2>Ticket holder</h2><p class="panel-intro">We will send the receipt and ticket details to this email.</p><div class="buyer-grid"><div class="field"><label for="buyer-name">Full name</label><input id="buyer-name" autocomplete="name" required value="{{ user.name|default('') }}"></div><div class="field"><label for="buyer-email">Email</label><input id="buyer-email" type="email" autocomplete="email" required value="{{ user.email|default('') }}"></div><div class="field full"><label for="buyer-phone">Phone <span style="font-weight:500;color:#788982">(optional)</span></label><input id="buyer-phone" type="tel" autocomplete="tel"></div></div></section>
        </div>
        <aside class="panel payment-card"><h2>Order summary</h2><div id="order-lines" class="order-lines"><p class="empty-selection">Choose at least one ticket to continue.</p></div><div class="order-total"><span>Total</span><span id="order-total">$0.00</span></div><label style="font-size:.8rem;font-weight:800" for="card-element">Card details</label><div id="card-element" class="stripe-shell"></div><div id="card-errors" class="card-errors" role="alert"></div><button id="purchase-button" class="purchase-button" type="submit" disabled><i class="fa-solid fa-lock"></i> Complete secure purchase</button><div class="trust-list"><div><i class="fa-solid fa-shield-halved"></i> Payment details are encrypted by Stripe.</div><div><i class="fa-solid fa-envelope"></i> Confirmation is sent immediately after payment.</div><div><i class="fa-solid fa-mobile-screen"></i> Tickets remain available in your VNV account.</div></div></aside>
        <input type="hidden" name="event_id" value="{{ venueEvent.id }}"><input type="hidden" name="tickets" id="tickets-json"><input type="hidden" name="buyer_info" id="buyer-json"><input type="hidden" name="customer_token" id="customer-token">
    </form>
    <p class="powered">VNV Events · South Florida event experiences</p>
</main>
<script>
(() => {
    const form = document.getElementById('ticket-checkout');
    const options = Array.from(document.querySelectorAll('.ticket-option'));
    const lines = document.getElementById('order-lines');
    const totalNode = document.getElementById('order-total');
    const submit = document.getElementById('purchase-button');
    const errors = document.getElementById('card-errors');
    const stripe = Stripe('{{ stripe_key|e('js') }}');
    const elements = stripe.elements({fonts:[{cssSrc:'https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&display=swap'}]});
    const card = elements.create('card',{style:{base:{fontFamily:'DM Sans, sans-serif',fontSize:'16px',color:'#071b17','::placeholder':{color:'#8b9a95'}},invalid:{color:'#b42318'}}});
    card.mount('#card-element');
    card.on('change', event => { errors.textContent = event.error ? event.error.message : ''; });
    const selected = () => { const result = {}; options.forEach(option => { const qty = Math.max(0, Math.min(10, parseInt(option.querySelector('.ticket-quantity').value || '0',10))); option.querySelector('.ticket-quantity').value = qty; if(qty) result[option.dataset.ticketId] = qty; }); return result; };
    const refresh = () => { const quantities = selected(); let total = 0; let html = ''; options.forEach(option => { const qty = quantities[option.dataset.ticketId] || 0; if(!qty) return; const subtotal = Number(option.dataset.ticketPrice) * qty; total += subtotal; html += `<div class="order-line"><span>${qty} × ${option.dataset.ticketName}</span><strong>$${subtotal.toFixed(2)}</strong></div>`; }); lines.innerHTML = html || '<p class="empty-selection">Choose at least one ticket to continue.</p>'; totalNode.textContent = `$${total.toFixed(2)}`; submit.disabled = total <= 0; };
    document.querySelectorAll('[data-change]').forEach(button => button.addEventListener('click', () => { const input = button.parentElement.querySelector('.ticket-quantity'); input.value = Math.max(0, Math.min(10, Number(input.value || 0) + Number(button.dataset.change))); refresh(); }));
    document.querySelectorAll('.ticket-quantity').forEach(input => input.addEventListener('input', refresh));
    form.addEventListener('submit', async event => { event.preventDefault(); const tickets = selected(); if(!Object.keys(tickets).length){ errors.textContent = 'Choose at least one ticket.'; return; } if(!form.reportValidity()) return; submit.disabled = true; submit.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Securing tickets…'; errors.textContent = ''; const result = await stripe.createToken(card); if(result.error){ errors.textContent = result.error.message; submit.disabled = false; submit.innerHTML = '<i class="fa-solid fa-lock"></i> Complete secure purchase'; return; } document.getElementById('tickets-json').value = JSON.stringify(tickets); document.getElementById('buyer-json').value = JSON.stringify({name:document.getElementById('buyer-name').value.trim(),email:document.getElementById('buyer-email').value.trim(),phone:document.getElementById('buyer-phone').value.trim()}); document.getElementById('customer-token').value = result.token.id; form.submit(); });
    refresh();
})();
</script>
</body>
</html>
