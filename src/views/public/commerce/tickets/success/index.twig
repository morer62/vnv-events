<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tickets Purchased Successfully - VNV Events</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="{{ asset_for('template/img/icons/icon-48x48.png') }}">
    <link rel="shortcut icon" type="image/png" href="{{ asset_for('template/img/icons/icon-48x48.png') }}">
    
    <!-- CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body text-center">
                        <div class="mb-4">
                            <i class="fa-solid fa-check-circle text-success" style="font-size: 4rem;"></i>
                        </div>
                        
                        <h2 class="card-title text-success mb-3">🎫 Tickets Purchased Successfully!</h2>
                        
                        <div class="alert alert-success">
                            <h5>Thank you for your purchase!</h5>
                            <p class="mb-0">Your tickets for <strong>{{ event_name }}</strong> have been purchased successfully.</p>
                            {% if current_stage %}
                                <div class="mt-2">
                                    <small class="text-muted">
                                        <i class="fa-solid fa-tag me-1"></i>
                                        Purchased during: <strong>{{ current_stage.name }}</strong>
                                        {% if current_stage.discount_percentage > 0 %}
                                            <span class="badge bg-success ms-1">{{ current_stage.discount_percentage }}% OFF</span>
                                        {% endif %}
                                    </small>
                                </div>
                            {% endif %}
                        </div>

                        {% if ticket_codes|length == 0 %}
                        <div class="alert alert-warning">
                            <h5>⚠️ No Ticket Data Found</h5>
                            <p class="mb-0">It seems you accessed this page directly. Please complete a ticket purchase to see your tickets here.</p>
                        </div>
                        {% endif %}

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6 class="card-title">Total Amount</h6>
                                        <h4 class="text-primary">${{ total_amount|number_format(2) }}</h4>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h6 class="card-title">Tickets Purchased</h6>
                                        <h4 class="text-success">{{ ticket_codes|length }}</h4>
                                    </div>
                                </div>
                            </div>
                        </div>

                            {% if ticket_codes|length > 0 %}
                            <div class="mb-4">
                                <h5>Your Ticket Codes:</h5>
                                <div class="alert alert-info">
                                    {% for ticket in ticket_codes %}
                                        <div class="mb-3 p-3 border rounded bg-white">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <strong class="text-primary">{{ ticket.code }}</strong>
                                                    <br>
                                                    <small class="text-muted">
                                                        <i class="fa-solid fa-ticket"></i> {{ ticket.ticket_type }}
                                                    </small>
                                                </div>
                                                <div class="text-end">
                                                    {% if current_stage and current_stage.discount_percentage > 0 %}
                                                        <div class="text-decoration-line-through text-muted small">${{ ticket.original_price|number_format(2) }}</div>
                                                        <div class="text-success fw-bold">${{ ticket.price|number_format(2) }}</div>
                                                        <small class="badge bg-success">{{ current_stage.discount_percentage }}% OFF</small>
                                                    {% else %}
                                                        <div class="text-primary fw-bold">${{ ticket.price|number_format(2) }}</div>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                                <p class="text-muted">
                                    <i class="fa-solid fa-info-circle"></i>
                                    Please save these ticket codes. You'll need them for event entry.
                                </p>
                            </div>
                            {% endif %}

                        <div class="mb-4">
                            <h6>What's Next?</h6>
                            <ul class="list-unstyled text-start">
                                <li><i class="fa-solid fa-envelope text-primary"></i> Check your email for confirmation details</li>
                                <li><i class="fa-solid fa-ticket text-success"></i> Save your ticket codes in a safe place</li>
                                <li><i class="fa-solid fa-calendar text-info"></i> Mark the event date on your calendar</li>
                                <li><i class="fa-solid fa-qrcode text-warning"></i> Present your ticket codes at the event entrance</li>
                            </ul>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <a href="{{ base_url }}/panel" class="btn btn-primary">
                                <i class="fa-solid fa-user"></i> Go to Dashboard
                            </a>
                            <a href="{{ base_url }}/search/venue/main" class="btn btn-outline-secondary">
                                <i class="fa-solid fa-search"></i> Browse More Events
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
    .card {
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        border: none;
    }

    .alert {
        border: none;
        border-radius: 10px;
    }

    .btn {
        border-radius: 8px;
        padding: 10px 20px;
    }

    .fa-check-circle {
        animation: bounce 2s infinite;
    }

    @keyframes bounce {
        0%, 20%, 50%, 80%, 100% {
            transform: translateY(0);
        }
        40% {
            transform: translateY(-10px);
        }
        60% {
            transform: translateY(-5px);
        }
    }
    </style>
</body>
</html>
