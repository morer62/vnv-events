<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><meta name="theme-color" content="#071b17"><title>Tickets confirmed · VNV Events</title>
<link rel="icon" href="{{ asset_for('template/img/icons/icon-48x48.png') }}"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet"><link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
<style>*{box-sizing:border-box}body{margin:0;background:#f2f6f4;color:#0a211c;font-family:"DM Sans",sans-serif}.success-shell{width:min(920px,calc(100% - 28px));margin:0 auto;padding:28px 0 60px}.success-card{overflow:hidden;border:1px solid #d9e6e1;border-radius:30px;background:#fff;box-shadow:0 26px 75px rgba(9,50,42,.12)}.success-hero{padding:42px 36px;color:#fff;background:linear-gradient(125deg,#071b17,#0c715f);text-align:center}.success-mark{display:inline-flex;align-items:center;justify-content:center;width:76px;height:76px;border-radius:50%;background:#58e0c2;color:#06231d;font-size:2rem;box-shadow:0 0 0 12px rgba(88,224,194,.12)}.success-hero h1{margin:24px 0 8px;font-family:"Playfair Display",serif;font-size:clamp(2rem,5vw,3.5rem)}.success-hero p{margin:0;color:rgba(255,255,255,.76)}.success-body{padding:32px}.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:26px}.summary-box{padding:19px;border:1px solid #dce8e3;border-radius:18px;background:#f7faf9}.summary-box span{display:block;color:#6e7e78;font-size:.75rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.summary-box strong{display:block;margin-top:5px;color:#086d5d;font-size:1.55rem}.ticket-list{display:grid;gap:12px}.ticket-code{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:18px;border:1px solid #d9e6e1;border-radius:18px}.ticket-code code{display:block;margin-bottom:5px;color:#075f51;font-size:1rem;font-weight:800}.ticket-code small{color:#6c7d77}.ticket-price{text-align:right;font-weight:850}.ticket-price s{display:block;color:#8a9893;font-size:.78rem;font-weight:500}.next-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:26px 0}.next-step{padding:16px;border-radius:16px;background:#edf8f5;color:#40554f;font-size:.84rem}.next-step i{display:block;margin-bottom:8px;color:#087563;font-size:1.15rem}.actions{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:46px;padding:11px 18px;border-radius:999px;text-decoration:none;font-weight:850}.btn-primary{background:#0a715f;color:#fff}.btn-soft{border:1px solid #cadbd5;background:#fff;color:#173c34}@media(max-width:620px){.success-hero,.success-body{padding:28px 19px}.summary-grid,.next-steps{grid-template-columns:1fr}.ticket-code{align-items:flex-start;flex-direction:column}.ticket-price{text-align:left}.actions .btn{width:100%}}</style>
</head>
<body><main class="success-shell"><article class="success-card"><header class="success-hero"><span class="success-mark"><i class="fa-solid fa-check"></i></span><h1>Your tickets are confirmed.</h1><p>Thank you for joining {{ event_name }}. A confirmation has been sent to your email.</p></header><div class="success-body"><section class="summary-grid"><div class="summary-box"><span>Total paid</span><strong>${{ total_amount|number_format(2) }}</strong></div><div class="summary-box"><span>Tickets</span><strong>{{ ticket_codes|length }}</strong></div></section>{% if current_stage %}<p style="color:#61746d"><i class="fa-solid fa-tag" style="color:#087563"></i> Purchased during <strong>{{ current_stage.name }}</strong>{% if current_stage.discount_percentage > 0 %} with {{ current_stage.discount_percentage|number_format(0) }}% savings{% endif %}.</p>{% endif %}{% if ticket_codes|length > 0 %}<section><h2 style="font-size:1.25rem">Ticket details</h2><div class="ticket-list">{% for ticket in ticket_codes %}<div class="ticket-code"><div><code>{{ ticket.code }}</code><small><i class="fa-solid fa-ticket"></i> {{ ticket.ticket_type }}</small></div><div class="ticket-price">{% if ticket.original_price is defined and ticket.original_price > ticket.price %}<s>${{ ticket.original_price|number_format(2) }}</s>{% endif %}${{ ticket.price|number_format(2) }}</div></div>{% endfor %}</div></section>{% endif %}<section class="next-steps"><div class="next-step"><i class="fa-solid fa-envelope"></i>Check your email for the complete confirmation.</div><div class="next-step"><i class="fa-solid fa-mobile-screen"></i>Keep your ticket available on your phone.</div><div class="next-step"><i class="fa-solid fa-qrcode"></i>Present the code at event entrance.</div></section><div class="actions"><a class="btn btn-primary" href="{{ base_url }}/panel/tickets"><i class="fa-solid fa-ticket"></i> View my tickets</a><a class="btn btn-soft" href="{{ base_url }}"><i class="fa-solid fa-house"></i> VNV Events home</a></div></div></article></main></body>
</html>
