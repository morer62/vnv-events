{% extends 'templates/base.twig' %}

{% set status = proposal.status|default('NOT_STARTED') %}
{% set status_labels = {
    'NOT_STARTED': 'Not started',
    'DRAFT': 'Ready for your approval',
    'PENDING_APPROVAL': 'Ready for your approval',
    'APPROVED': 'Approved and signed',
    'CHANGES_REQUESTED': 'Changes requested'
} %}
{% set has_details = proposal and proposal.current_revision_id %}
{% set status_display = has_details ? status_labels[status]|default(status) : 'No details yet' %}

{% block title %}Secure Menu / Proposal | VNV Events{% endblock %}
{% block meta %}<meta name="robots" content="noindex,nofollow,noarchive">{% endblock %}

{% block styles %}
<style>
    :root { --proposal-ink:#12384b; --proposal-teal:#159b98; --proposal-line:#d8e4e8; }
    body { background:linear-gradient(145deg,#edf6f7 0%,#fff 45%,#edf4f6 100%); color:var(--proposal-ink); min-height:100vh; }
    .public-proposal-shell { width:min(1040px,calc(100% - 28px)); margin:clamp(24px,6vw,72px) auto; }
    .public-proposal-brand { display:flex; justify-content:space-between; align-items:center; gap:20px; margin-bottom:22px; }
    .public-proposal-brand img { width:170px; max-width:45vw; height:auto; }
    .public-proposal-status { display:inline-flex; align-items:center; min-height:38px; padding:8px 14px; border-radius:999px; background:#fff1c8; color:#735200; font-weight:800; border:1px solid #f2d98c; }
    .public-proposal-status--approved { background:#ddf5e8; color:#0e6338; border-color:#b7dfc9; }
    .public-proposal-status--changes { background:#ffe8e8; color:#812828; border-color:#efc2c2; }
    .public-proposal-heading { display:flex; justify-content:space-between; align-items:flex-start; gap:20px; flex-wrap:wrap; margin-bottom:24px; }
    .public-proposal-heading h1 { font-size:clamp(1.8rem,5vw,3rem); line-height:1.05; margin:4px 0 10px; }
    .public-proposal-kicker { color:var(--proposal-teal); text-transform:uppercase; letter-spacing:.12em; font-size:.78rem; font-weight:900; }
    .public-proposal-card { background:#fff; border:1px solid var(--proposal-line); border-radius:20px; box-shadow:0 18px 50px rgba(18,56,75,.09); overflow:hidden; }
    .public-proposal-document { padding:clamp(22px,6vw,64px); font:17px/1.68 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; color:#172a34; min-height:280px; }
    .public-proposal-document h2 { font-size:1.9rem; margin:1.4rem 0 .7rem; }
    .public-proposal-document h3 { font-size:1.35rem; margin:1.2rem 0 .55rem; }
    .public-proposal-document p { margin:0 0 1rem; }
    .public-proposal-document small { display:block; color:#5f6f78; font-size:.82em; line-height:1.55; }
    .public-proposal-document ul,.public-proposal-document ol { padding-left:1.7rem; margin:0 0 1rem; }
    .public-proposal-document img { display:block; max-width:100%; height:auto; margin:1rem auto; border-radius:12px; }
    .proposal-page-break { border-top:2px dashed #8ca3af; margin:2rem 0; height:0; }
    .public-proposal-panel { background:#f4fbfa; border:1px solid #cce4e1; border-radius:18px; padding:clamp(18px,4vw,30px); margin-top:22px; }
    .public-proposal-panel label { font-weight:700; }
    .public-proposal-button { border:0; border-radius:10px; background:var(--proposal-teal); color:#fff; font-weight:800; padding:12px 20px; min-height:48px; }
    .public-proposal-button--danger { background:#fff; border:1px solid #c74a4a; color:#9b2c2c; }
    .public-proposal-notice { background:#fff; border:1px solid var(--proposal-line); border-radius:16px; padding:20px; }
    .proposal-signature-preview { min-height:140px; border:2px dashed #8aa7b1; border-radius:14px; background:#fff; display:flex; align-items:center; justify-content:center; padding:16px; text-align:center; overflow:hidden; }
    .proposal-signature-preview__typed { font-family:'Brush Script MT','Segoe Script',cursive; font-size:clamp(2.35rem,8vw,3.8rem); line-height:1.1; color:var(--proposal-ink); overflow-wrap:anywhere; }
    .proposal-signature-preview__image { display:block; max-width:100%; max-height:170px; object-fit:contain; }
    .proposal-signature-preview__placeholder { color:#7a8b94; font-style:italic; }
    .form-control { min-height:48px; }
    @media(max-width:640px){
        .public-proposal-brand { align-items:flex-start; }
        .public-proposal-heading { display:block; }
        .public-proposal-status { margin-top:8px; }
        .public-proposal-document { font-size:16px; padding:20px; }
    }
    @media print {
        body { background:#fff; }
        .public-proposal-shell { width:100%; margin:0; }
        .public-proposal-panel,.public-proposal-status { display:none; }
        .public-proposal-card { border:0; box-shadow:none; }
    }
</style>
{% endblock %}

{% block body %}
<main class="public-proposal-shell">
    <div class="public-proposal-brand">
        <img src="{{ asset_for('assets/images/planner-hub-logo-positive.png') }}" alt="VNV Events">
        <div class="small text-end">Secure client review<br><strong>Order VNV-341{{ order.id }}</strong></div>
    </div>

    <header class="public-proposal-heading">
        <div>
            <div class="public-proposal-kicker">Menu / Proposal</div>
            <h1>Review your event proposal</h1>
            <div>Event {{ order.event_date|date('F j, Y') }}{% if guest_count %} · {{ guest_count }} guests{% endif %}</div>
        </div>
        <span class="public-proposal-status {{ status == 'APPROVED' ? 'public-proposal-status--approved' : (status == 'CHANGES_REQUESTED' ? 'public-proposal-status--changes' : '') }}">{{ status_display }}</span>
    </header>

    {% if not proposal or not proposal.current_revision_id or status == 'CHANGES_REQUESTED' %}
        <div class="public-proposal-notice">
            <h2 class="h4">No details yet.</h2>
            <p class="mb-0">This secure link remains active. Please return when VNV Events confirms that your proposal is ready.</p>
        </div>
    {% else %}
        <article class="public-proposal-card" aria-label="Current menu or proposal">
            <div class="public-proposal-document">{{ proposal.content_html|raw }}</div>
        </article>
    {% endif %}

    {% if status in ['DRAFT', 'PENDING_APPROVAL'] %}
        <form method="post" enctype="multipart/form-data" class="public-proposal-panel" id="publicProposalApprovalForm">
            <input type="hidden" name="token" value="{{ token }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="action" value="approve">
            <input type="hidden" name="user_local_timestamp" id="proposalLocalTimestamp">
            <h2 class="h4">Approve and sign this proposal</h2>
            <p>Your signature creates a dated PDF copy of the approved menu / proposal.</p>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label" for="typedInitials">Type your signature or initials</label><input id="typedInitials" name="typed_initials" class="form-control" maxlength="30" autocomplete="off" placeholder="Your name or initials"></div>
                <div class="col-md-6"><label class="form-label" for="signatureImage">Or upload signature image</label><input id="signatureImage" type="file" name="signature_image" class="form-control" accept="image/jpeg,image/png,image/webp"></div>
            </div>
            <div class="mt-3">
                <label class="form-label">Signature preview</label>
                <div class="proposal-signature-preview" id="proposalSignaturePreview" aria-live="polite">
                    <span class="proposal-signature-preview__placeholder" id="proposalSignaturePlaceholder">Your signature will appear here.</span>
                    <span class="proposal-signature-preview__typed d-none" id="proposalTypedSignature"></span>
                    <img class="proposal-signature-preview__image d-none" id="proposalImageSignature" alt="Uploaded signature preview">
                </div>
                <div class="small text-muted mt-2" id="proposalSignatureMethod">Type a signature or choose an image before signing.</div>
            </div>
            <button class="public-proposal-button mt-3" id="proposalSignButton" disabled>Approve and sign proposal</button>
        </form>
    {% endif %}

    {% if status == 'APPROVED' %}
        <section class="public-proposal-panel">
            <h2 class="h4">Approved proposal</h2>
            <p>This is the current approved and signed proposal.</p>
            {% if proposal.current_signed_pdf_path %}<p><a class="public-proposal-button d-inline-block text-decoration-none" href="{{ proposal.current_signed_pdf_path }}" target="_blank" rel="noopener">Open signed PDF</a></p>{% endif %}
            <p>If a correction is needed, enter the reason below. The replacement will become the only active client version.</p>
            <form method="post" class="row g-2 align-items-end">
                <input type="hidden" name="token" value="{{ token }}">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <input type="hidden" name="action" value="revoke">
                <div class="col-md-9"><label class="form-label" for="revokeReason">Reason for reopening</label><input id="revokeReason" name="reason" class="form-control" required minlength="5" maxlength="500"></div>
                <div class="col-md-3"><button class="public-proposal-button public-proposal-button--danger w-100">Reopen approval</button></div>
            </form>
        </section>
    {% endif %}

</main>
{% endblock %}

{% block scripts %}
<script>
(() => {
    const timestamp = document.getElementById('proposalLocalTimestamp');
    if (timestamp) timestamp.value = new Date().toISOString().slice(0,19).replace('T',' ');
    const typedSignature = document.getElementById('typedInitials');
    const signatureFile = document.getElementById('signatureImage');
    const typedPreview = document.getElementById('proposalTypedSignature');
    const imagePreview = document.getElementById('proposalImageSignature');
    const signaturePlaceholder = document.getElementById('proposalSignaturePlaceholder');
    const signatureMethod = document.getElementById('proposalSignatureMethod');
    const signButton = document.getElementById('proposalSignButton');
    const updateSignaturePreview = () => {
        const typedValue = typedSignature?.value.trim() || '';
        const file = signatureFile?.files?.[0] || null;
        if (file && imagePreview) {
            const reader = new FileReader();
            reader.addEventListener('load', () => {
                imagePreview.src = String(reader.result || '');
                imagePreview.classList.remove('d-none');
                typedPreview?.classList.add('d-none');
                signaturePlaceholder?.classList.add('d-none');
            });
            reader.readAsDataURL(file);
            if (signatureMethod) signatureMethod.textContent = 'The uploaded image will be used as your signature.';
        } else if (typedValue && typedPreview) {
            typedPreview.textContent = typedValue;
            typedPreview.classList.remove('d-none');
            imagePreview?.classList.add('d-none');
            imagePreview?.removeAttribute('src');
            signaturePlaceholder?.classList.add('d-none');
            if (signatureMethod) signatureMethod.textContent = 'The handwritten-style preview above will be used as your signature.';
        } else {
            typedPreview?.classList.add('d-none');
            imagePreview?.classList.add('d-none');
            imagePreview?.removeAttribute('src');
            signaturePlaceholder?.classList.remove('d-none');
            if (signatureMethod) signatureMethod.textContent = 'Type a signature or choose an image before signing.';
        }
        if (signButton) signButton.disabled = !typedValue && !file;
    };
    typedSignature?.addEventListener('input', updateSignaturePreview);
    signatureFile?.addEventListener('change', updateSignaturePreview);
    updateSignaturePreview();
})();
</script>
{% endblock %}
