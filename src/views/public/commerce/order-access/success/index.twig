{% extends "templates/base.twig" %}

{% block body %}
<main class="text-center my-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-5">
                        <div class="mb-4">
                            <div class="rounded-circle bg-success d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="white" class="bi bi-check-lg" viewBox="0 0 16 16">
                                    <path d="M12.736 3.97a.733.733 0 0 1 1.047 0c.286.289.29.756.01 1.05L7.88 12.01a.733.733 0 0 1-1.065.02L3.217 8.384a.757.757 0 0 1 0-1.06.733.733 0 0 1 1.047 0l3.052 3.093 5.4-6.425a.247.247 0 0 1 .02-.022Z"/>
                                </svg>
                            </div>
                        </div>
                        
                        <h1 class="text-success mb-3">Payment Successful!</h1>
                        <p class="lead text-muted mb-4">Thank you! Your payment has been received and processed successfully.</p>
                        
                        <div class="alert alert-success mb-4" role="alert">
                            <strong>✓ Order Fully Paid</strong><br>
                            Your event order has been completed and confirmed.
                        </div>

                        {% if show_tip_option %}
                        <div class="card bg-light border-0 mb-4">
                            <div class="card-body p-4">
                                <h5 class="mb-3">💝 Add a Tip? (Optional)</h5>
                                <p class="text-muted small mb-3">Your order is fully paid. If you'd like to show appreciation for the service, you can add an optional tip.</p>
                                
                                <button type="button" class="btn btn-outline-success btn-lg" data-bs-toggle="modal" data-bs-target="#tipModal">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-heart-fill me-2" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd" d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314z"/>
                                    </svg>
                                    Add Tip
                                </button>
                            </div>
                        </div>
                        {% endif %}

                        <a href="{{ path('order-access', { token: token }) }}" class="btn btn-primary btn-lg px-5">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-house-fill me-2" viewBox="0 0 16 16">
                                <path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L8 2.207l6.646 6.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.707 1.5Z"/>
                                <path d="m8 3.293 6 6V13.5a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 13.5V9.293l6-6Z"/>
                            </svg>
                            Return to Order
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

{% if show_tip_option %}
<div class="modal fade" id="tipModal" tabindex="-1" aria-labelledby="tipModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="tipModalLabel">💝 Add a Tip</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info mb-4">
                    <small><strong>Note:</strong> Your order is fully paid. This is an optional gratuity to show your appreciation.</small>
                </div>

                <form id="tipForm">
                    <input type="hidden" name="token" value="{{ token }}">
                    <input type="hidden" name="order_id" value="{{ order.id }}">
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold">Choose Tip Amount:</label>
                        
                        <div class="btn-group w-100 mb-3" role="group">
                            {% for tip in suggested_tips %}
                            <input type="radio" class="btn-check" name="tip_type" id="tip{{ tip.id }}" value="percentage" data-percentage="{{ tip.percentage }}">
                            <label class="btn btn-outline-primary" for="tip{{ tip.id }}">{{ tip.percentage }}%</label>
                            {% endfor %}
                            <input type="radio" class="btn-check" name="tip_type" id="tipCustom" value="custom" checked>
                            <label class="btn btn-outline-primary" for="tipCustom">Custom</label>
                        </div>
                    </div>

                    <div class="mb-4" id="customTipSection">
                        <label class="form-label">Enter Tip Amount:</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control" id="tipAmount" name="tip_amount" step="0.01" min="1" placeholder="0.00" required>
                        </div>
                        <small class="text-muted">Order total: ${{ order_total|number_format(2) }}</small>
                    </div>

                    <div class="mb-4" id="cardSection">
                        <label class="form-label fw-bold">Card Information</label>
                        <div id="square-card-container" class="border rounded p-3" style="min-height: 150px;"></div>
                        <div id="square-card-errors" class="text-danger mt-2" role="alert"></div>
                    </div>
                    
                    <input type="hidden" name="customer_token" id="square-customer-token">
                    <input type="hidden" name="customer_email" id="square-customer-email" value="{{ client_email|e('html_attr') }}">

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success btn-lg" id="submitTipBtn">
                            <span id="btnText">💝 Pay Tip</span>
                            <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                        </button>
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">No Thanks</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript" src="https://{{ square_environment == 'production' ? 'web' : 'sandbox.web' }}.squarecdn.com/v1/square.js"></script>
<script>
    (async function () {
        try {
            const squareApplicationId = "{{ square_application_id|e('js') }}";
            const squareLocationId = "{{ square_location_id|e('js') }}";
            
            if (!squareApplicationId || !squareLocationId) {
                console.error('Square credentials not configured');
                document.getElementById('square-card-errors').textContent = 'Payment system not configured. Please contact support.';
                return;
            }

            const payments = Square.payments(squareApplicationId, squareLocationId);
            const card = await payments.card();
            await card.attach('#square-card-container');

            const form = document.getElementById('tipForm');
            const submitBtn = document.getElementById('submitTipBtn');
            const btnText = document.getElementById('btnText');
            const btnSpinner = document.getElementById('btnSpinner');
            const errorDiv = document.getElementById('square-card-errors');
            const tokenInput = document.getElementById('square-customer-token');
            const emailInput = document.getElementById('square-customer-email');
            const tipAmountInput = document.getElementById('tipAmount');
            const orderTotal = {{ order_total }};

            // Obtener email del cliente desde la orden (si está disponible)
            // Por ahora, dejamos que el usuario lo ingrese si es necesario
            // O podemos obtenerlo del token/orden en el backend

            const tipRadios = document.querySelectorAll('input[name="tip_type"]');
            
            tipRadios.forEach(radio => {
                radio.addEventListener('change', function() {
                    if (this.value === 'percentage') {
                        const percentage = parseFloat(this.dataset.percentage);
                        const tipAmount = (orderTotal * percentage / 100).toFixed(2);
                        tipAmountInput.value = tipAmount;
                    } else {
                        tipAmountInput.value = '';
                        tipAmountInput.focus();
                    }
                });
            });

            form.addEventListener('submit', async function(event) {
                event.preventDefault();
                
                submitBtn.disabled = true;
                btnText.classList.add('d-none');
                btnSpinner.classList.remove('d-none');
                errorDiv.textContent = '';

                const tipAmount = parseFloat(tipAmountInput.value);
                
                if (!tipAmount || tipAmount < 1) {
                    alert('Please enter a valid tip amount');
                    submitBtn.disabled = false;
                    btnText.classList.remove('d-none');
                    btnSpinner.classList.add('d-none');
                    return;
                }

                try {
                    const tokenResult = await card.tokenize();
                    if (tokenResult.status === 'OK') {
                        tokenInput.value = tokenResult.token;
                        
                        const formData = new FormData(form);
                        formData.append('customer_token', tokenResult.token);
                        formData.append('customer_email', emailInput.value || '{{ client_email|e('js') }}');
                        formData.append('tip_amount', tipAmount);

                        const tipUrl = '{{ base_url }}/order-access/tip';
                        
                        const response = await fetch(tipUrl, {
                            method: 'POST',
                            body: formData
                        });

                        const responseText = await response.text();
                        let result;
                        try {
                            result = JSON.parse(responseText);
                        } catch (e) {
                            console.error('Invalid JSON response:', responseText);
                            alert('Server error. Please try again.');
                            submitBtn.disabled = false;
                            btnText.classList.remove('d-none');
                            btnSpinner.classList.add('d-none');
                            return;
                        }

                        if (result.success) {
                            window.location.href = '{{ base_url }}/order-access?token={{ token }}&tip_success=1';
                        } else {
                            alert('Error processing tip: ' + (result.error || 'Unknown error'));
                            submitBtn.disabled = false;
                            btnText.classList.remove('d-none');
                            btnSpinner.classList.add('d-none');
                        }
                    } else {
                        let errorMessage = 'Payment failed. Please try again.';
                        if (tokenResult.errors && tokenResult.errors.length > 0) {
                            errorMessage = tokenResult.errors[0].detail || errorMessage;
                        }
                        errorDiv.textContent = errorMessage;
                        submitBtn.disabled = false;
                        btnText.classList.remove('d-none');
                        btnSpinner.classList.add('d-none');
                    }
                } catch (err) {
                    errorDiv.textContent = 'Error: ' + err.message;
                    submitBtn.disabled = false;
                    btnText.classList.remove('d-none');
                    btnSpinner.classList.add('d-none');
                }
            });
        } catch (err) {
            console.error('Square initialization error:', err);
            document.getElementById('square-card-errors').textContent = 'Failed to initialize payment system. Please refresh the page.';
        }
    })();

    document.addEventListener('DOMContentLoaded', function() {
        const tipModal = new bootstrap.Modal(document.getElementById('tipModal'));
        tipModal.show();
    });

    document.addEventListener('DOMContentLoaded', function() {
        const tipModal = new bootstrap.Modal(document.getElementById('tipModal'));
        tipModal.show();
    });
</script>
{% endif %}

{% endblock %}
