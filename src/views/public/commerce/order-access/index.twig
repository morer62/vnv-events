{% endblock %}

{% block scripts %}
	{% if isPaymentReady and activeProvider and paymentStatus != "complete" and not is_event_past %}
		{% if activeProvider.provider_type == 'stripe' and stripe_publishable_key %}
	<script src="https://js.stripe.com/v3/"></script>
		{% elseif activeProvider.provider_type == 'square' %}
	<script type="text/javascript" src="https://{{ square_environment == 'production' ? 'web' : 'sandbox.web' }}.squarecdn.com/v1/square.js"></script>
		{% elseif activeProvider.provider_type == 'paypal' and paypal_client_id %}
	<script src="https://www.paypal.com/sdk/js?client-id={{ paypal_client_id|e('html_attr') }}&currency={{ activeProvider.currency|default('USD') }}&intent=capture"></script>
		{% endif %}
	{% endif %}
	{{ processingModalScript|raw }}
	<script>
		function renderSignature() {
			const initials = document.getElementById("typed_initials");
			const box = document.getElementById("signatureBox");
			if (initials && box) box.textContent = initials.value || "{{ trans('planner_hub.your_signature_will_appear')|e('js') }}";
			toggleContractSubmit();
		}
		function toggleContractSubmit() {
			const consent = document.getElementById("eSignConsent");
			const signBtn = document.getElementById("signButton");
			const consentContainer = document.getElementById("consentCheckboxContainer");
			const hasInitials = document.getElementById("typed_initials") && document.getElementById("typed_initials").value.trim().length > 0;
			const hasFile = document.querySelector('input[name="signature_image"]') && document.querySelector('input[name="signature_image"]').files.length > 0;
			
			if (signBtn && consentContainer) {
				const isValid = consent && consent.checked && (hasInitials || hasFile);
				
				// Update button visual state
				if (isValid) {
					signBtn.classList.remove('btn-secondary');
					signBtn.classList.add('btn-success');
					signBtn.style.opacity = '1';
					signBtn.style.cursor = 'pointer';
				} else {
					signBtn.classList.remove('btn-success');
					signBtn.classList.add('btn-secondary');
					signBtn.style.opacity = '0.6';
					signBtn.style.cursor = 'not-allowed';
				}
				
				// Update container border
				if (consent && !consent.checked) {
					consentContainer.classList.remove('border-danger', 'bg-danger-light', 'border-success');
					consentContainer.classList.add('border-secondary');
				} else {
					consentContainer.classList.remove('border-danger', 'bg-danger-light', 'border-secondary');
					consentContainer.classList.add('border-success');
				}
			}
		}
		
		// Handle form submit and show feedback if validation fails
		document.addEventListener('DOMContentLoaded', function() {
			const form = document.getElementById('contractForm');
			const signBtn = document.getElementById("signButton");
			const consent = document.getElementById("eSignConsent");
			const consentAlert = document.getElementById("consentAlert");
			const consentContainer = document.getElementById("consentCheckboxContainer");
			
			if (form && signBtn && consent) {
				form.addEventListener('submit', function(e) {
					if (form.dataset.submitting === '1') {
						e.preventDefault();
						e.stopPropagation();
						return false;
					}

					const hasInitials = document.getElementById("typed_initials") && document.getElementById("typed_initials").value.trim().length > 0;
					const hasFile = document.querySelector('input[name="signature_image"]') && document.querySelector('input[name="signature_image"]').files.length > 0;
					const isValid = consent.checked && (hasInitials || hasFile);
					
					if (!isValid) {
						e.preventDefault();
						e.stopPropagation();
						
						// Show alert
						if (consentAlert) {
							consentAlert.style.display = 'block';
							setTimeout(() => {
								consentAlert.style.display = 'none';
							}, 5000);
						}
						
						// Highlight container
						if (consentContainer) {
							consentContainer.classList.remove('border-secondary');
							consentContainer.classList.add('border-danger', 'bg-danger-light');
							consentContainer.style.animation = 'shake 0.5s';
							
							setTimeout(() => {
								consentContainer.style.animation = '';
							}, 500);
						}
						
						// Scroll to checkbox and focus
						setTimeout(() => {
							consent.scrollIntoView({ behavior: 'smooth', block: 'center' });
							setTimeout(() => {
								consent.focus();
								consent.style.outline = '3px solid #0d6efd';
								consent.style.outlineOffset = '3px';
								
								const label = document.querySelector('label[for="eSignConsent"]');
								if (label) {
									label.style.outline = '2px solid #0d6efd';
									label.style.outlineOffset = '2px';
								}
								
								setTimeout(() => {
									consent.style.outline = '';
									consent.style.outlineOffset = '';
									if (label) {
										label.style.outline = '';
										label.style.outlineOffset = '';
									}
								}, 3000);
							}, 300);
						}, 100);
						
						return false;
					}

					form.dataset.submitting = '1';
					signBtn.disabled = true;
					signBtn.innerHTML = '{{ trans('planner_hub.processing')|e('js') }}';
					signBtn.style.opacity = '0.6';
					signBtn.style.cursor = 'wait';

					if (window.VnvProcessingModal) {
						window.VnvProcessingModal.show('orderAccessProcessingModal', {
							title: '{{ trans('planner_hub.signing_contract')|e('js') }}',
							message: '{{ trans('planner_hub.saving_signature')|e('js') }}'
						});
					}
				});
				
				// Also handle button click for visual feedback
				signBtn.addEventListener('click', function(e) {
					if (form.dataset.submitting === '1') {
						e.preventDefault();
						e.stopPropagation();
						return false;
					}

					const hasInitials = document.getElementById("typed_initials") && document.getElementById("typed_initials").value.trim().length > 0;
					const hasFile = document.querySelector('input[name="signature_image"]') && document.querySelector('input[name="signature_image"]').files.length > 0;
					const isValid = consent.checked && (hasInitials || hasFile);
					
					if (!isValid) {
						// Show alert
						if (consentAlert) {
							consentAlert.style.display = 'block';
							setTimeout(() => {
								consentAlert.style.display = 'none';
							}, 5000);
						}
						
						// Highlight container
						if (consentContainer) {
							consentContainer.classList.remove('border-secondary');
							consentContainer.classList.add('border-danger', 'bg-danger-light');
							consentContainer.style.animation = 'shake 0.5s';
							
							setTimeout(() => {
								consentContainer.style.animation = '';
							}, 500);
						}
						
						// Scroll to checkbox and focus
						setTimeout(() => {
							consent.scrollIntoView({ behavior: 'smooth', block: 'center' });
							setTimeout(() => {
								consent.focus();
								consent.style.outline = '3px solid #0d6efd';
								consent.style.outlineOffset = '3px';
								
								const label = document.querySelector('label[for="eSignConsent"]');
								if (label) {
									label.style.outline = '2px solid #0d6efd';
									label.style.outlineOffset = '2px';
								}
								
								setTimeout(() => {
									consent.style.outline = '';
									consent.style.outlineOffset = '';
									if (label) {
										label.style.outline = '';
										label.style.outlineOffset = '';
									}
								}, 3000);
							}, 300);
						}, 100);
					}
				});
			}
		});

		function renderAcceptanceSignature() {
			const initials = document.getElementById("acceptance_typed_initials").value;
			const box = document.getElementById("acceptanceSignatureBox");
			const placeholder = box ? box.getAttribute('data-signature-placeholder') || "{{ trans('planner_hub.signature_will_appear')|e('js') }}" : "{{ trans('planner_hub.signature_will_appear')|e('js') }}";
			box.textContent = initials || placeholder;
		}

		// Prevenir clics mÃºltiples en botones
		document.addEventListener('DOMContentLoaded', function() {
			const eSignConsent = document.getElementById('eSignConsent');
			if (eSignConsent) {
				eSignConsent.addEventListener('change', toggleContractSubmit);
			}
			document.querySelector('input[name="signature_image"]')?.addEventListener('change', toggleContractSubmit);
			const acceptanceForm = document.querySelector('#acceptanceForm');
			if (acceptanceForm) {
				acceptanceForm.addEventListener('submit', function(e) {
					const submitButton = acceptanceForm.querySelector('button[type="submit"]');
					if (submitButton && !submitButton.disabled) {
						submitButton.disabled = true;
						submitButton.innerHTML = '{{ trans('planner_hub.processing')|e('js') }}';
						submitButton.style.opacity = '0.6';
						window.VnvProcessingModal.show('orderAccessProcessingModal', {
							title: '{{ trans('planner_hub.saving_acceptance')|e('js') }}',
							message: '{{ trans('planner_hub.saving_signed_receipt')|e('js') }}'
						});
					}
				});
			}

			// Para el formulario de DocuSign
			const docusignForm = document.querySelector('#docusignForm');
			if (docusignForm) {
				docusignForm.addEventListener('submit', function(e) {
					const submitButton = docusignForm.querySelector('button[type="submit"]');
					if (submitButton && !submitButton.disabled) {
						submitButton.disabled = true;
						submitButton.innerHTML = 'Redirecting to DocuSign...';
						submitButton.style.opacity = '0.6';

						window.VnvProcessingModal.show('orderAccessProcessingModal', {
							title: 'Preparing DocuSign...',
							message: 'We are redirecting you to DocuSign. Please wait.'
						});
					}
				});
			}
		});

		// Capturar hora local del usuario al cargar la pÃ¡gina
		document.addEventListener('DOMContentLoaded', function() {
			const now = new Date();
			const timestamp = now.getFullYear() + '-' + 
				String(now.getMonth() + 1).padStart(2, '0') + '-' + 
				String(now.getDate()).padStart(2, '0') + ' ' + 
				String(now.getHours()).padStart(2, '0') + ':' + 
				String(now.getMinutes()).padStart(2, '0') + ':' + 
				String(now.getSeconds()).padStart(2, '0');
			
			const timestampField = document.getElementById('userLocalTimestamp');
			if (timestampField) {
				timestampField.value = timestamp;
			}
			const acceptanceTimestampField = document.getElementById('acceptanceUserLocalTimestamp');
			if (acceptanceTimestampField) {
				acceptanceTimestampField.value = timestamp;
			}

			const timestampFieldDocuSign = document.getElementById('userLocalTimestampDocuSign');
			if (timestampFieldDocuSign) {
				timestampFieldDocuSign.value = timestamp;
				console.log('DocuSign signing - User local timestamp captured:', timestamp);
			}

			const billingAddressInput = document.getElementById('payment-billing-address');
			const billingZipInput = document.getElementById('payment-billing-zip');
			const syncBillingZipFromAddress = () => {
				if (!billingAddressInput || !billingZipInput || billingZipInput.value.trim() !== '') return;
				const address = billingAddressInput.value || '';
				const usZipMatch = address.match(/\b\d{5}(?:-\d{4})?\b/);
				if (usZipMatch) {
					billingZipInput.value = usZipMatch[0];
				}
			};
			if (billingAddressInput && billingZipInput) {
				billingAddressInput.addEventListener('input', function () {
					billingZipInput.value = '';
					syncBillingZipFromAddress();
				});
				billingAddressInput.addEventListener('change', syncBillingZipFromAddress);
				billingAddressInput.addEventListener('vnv:place-selected', function (event) {
					const components = event.detail?.place?.address_components || [];
					const zipComponent = components.find((component) => component.types && component.types.includes('postal_code'));
					if (zipComponent) {
						billingZipInput.value = zipComponent.long_name || zipComponent.short_name || '';
					}
					syncBillingZipFromAddress();
				});
				syncBillingZipFromAddress();
			}
		});

		{% if isPaymentReady and activeProvider and paymentStatus != "complete" and not is_event_past %}
		window.VnvOrderAccessPayment = (function() {
			const processingHtml = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Procesando...';

			function getForm() {
				return document.getElementById('payment-form-element');
			}

			function getPayButton() {
				return document.getElementById('payment-pay-button');
			}

			function setProcessingState(isProcessing) {
				const payButton = getPayButton();
				if (!payButton) return;
				if (!payButton.dataset.defaultHtml) {
					payButton.dataset.defaultHtml = payButton.innerHTML;
				}
				payButton.disabled = isProcessing;
				payButton.innerHTML = isProcessing ? processingHtml : payButton.dataset.defaultHtml;
				payButton.style.opacity = isProcessing ? '0.65' : '';
				payButton.style.cursor = isProcessing ? 'wait' : '';
			}

			function begin() {
				const form = getForm();
				if (!form) return true;
				if (form.dataset.paymentSubmitting === '1') {
					return false;
				}
				form.dataset.paymentSubmitting = '1';
				setProcessingState(true);
				return true;
			}

			function reset() {
				const form = getForm();
				if (form) {
					form.dataset.paymentSubmitting = '0';
				}
				setProcessingState(false);
			}

			return { begin, reset };
		})();

		{% if activeProvider.provider_type == 'stripe' and stripe_publishable_key %}
		// Stripe
		(function() {
			const stripe = Stripe("{{ stripe_publishable_key|e('js') }}");
			const elements = stripe.elements();
			const cardElement = elements.create('card', { style: { base: { fontSize: '16px' } } });
			cardElement.mount('#payment-card-container');

			const form = document.getElementById('payment-form-element');
			const payButton = document.getElementById('payment-pay-button');
			const errorDiv = document.getElementById('payment-card-errors');
			const tokenInput = document.getElementById('payment-customer-token');
			const tokenTypeInput = document.getElementById('payment-token-type');

			form.addEventListener('submit', async function(event) {
				if (tokenTypeInput && tokenTypeInput.value === 'stored_card') {
					return;
				}
				event.preventDefault();
				if (!window.VnvOrderAccessPayment.begin()) {
					return;
				}
				errorDiv.textContent = '';
				window.VnvProcessingModal.show('orderAccessProcessingModal', { title: '{{ trans('planner_hub.processing_payment')|e('js') }}', message: '{{ trans('planner_hub.confirming_payment')|e('js') }}' });

				const { token, error } = await stripe.createToken(cardElement);
				if (error) {
					errorDiv.textContent = error.message || '{{ trans('planner_hub.payment_failed_try_again')|e('js') }}';
					window.VnvOrderAccessPayment.reset();
					window.VnvProcessingModal.hide('orderAccessProcessingModal');
					return;
				}
				tokenInput.value = token.id;
				form.submit();
			});
		})();
		{% elseif activeProvider.provider_type == 'square' %}
		// Square Web Payments SDK
		(async function() {
			try {
				const squareApplicationId = "{{ square_application_id|e('js') }}";
				const squareLocationId = "{{ square_location_id|e('js') }}";
				if (!squareApplicationId || !squareLocationId) {
					document.getElementById('payment-card-errors').textContent = '{{ trans('planner_hub.square_credentials_not_configured')|e('js') }}';
					return;
				}
				const payments = Square.payments(squareApplicationId, squareLocationId);
				const card = await payments.card();
				await card.attach('#payment-card-container');

				const form = document.getElementById('payment-form-element');
				const payButton = document.getElementById('payment-pay-button');
				const errorDiv = document.getElementById('payment-card-errors');
				const tokenInput = document.getElementById('payment-customer-token');
				const tokenTypeInput = document.getElementById('payment-token-type');

				form.addEventListener('submit', async function(event) {
					if (tokenTypeInput && tokenTypeInput.value === 'stored_card') {
						return;
					}
					event.preventDefault();
					if (!window.VnvOrderAccessPayment.begin()) {
						return;
					}
					errorDiv.textContent = '';
					window.VnvProcessingModal.show('orderAccessProcessingModal', { title: '{{ trans('planner_hub.processing_payment')|e('js') }}', message: '{{ trans('planner_hub.confirming_payment')|e('js') }}' });

					try {
						const tokenResult = await card.tokenize();
						if (tokenResult.status === 'OK') {
							tokenInput.value = tokenResult.token;
							form.submit();
						} else {
							errorDiv.textContent = (tokenResult.errors && tokenResult.errors[0]) ? tokenResult.errors[0].detail : '{{ trans('planner_hub.payment_failed_try_again')|e('js') }}';
							window.VnvOrderAccessPayment.reset();
							window.VnvProcessingModal.hide('orderAccessProcessingModal');
						}
					} catch (error) {
						errorDiv.textContent = '{{ trans('planner_hub.error_occurred_try_again')|e('js') }}';
						window.VnvOrderAccessPayment.reset();
						window.VnvProcessingModal.hide('orderAccessProcessingModal');
					}
				});
			} catch (error) {
				document.getElementById('payment-card-errors').textContent = '{{ trans('planner_hub.unable_load_payment_form')|e('js') }}';
			}
		})();
		{% elseif activeProvider.provider_type == 'paypal' and paypal_client_id %}
		// PayPal
		(function() {
			const form = document.getElementById('payment-form-element');
			const tokenInput = document.getElementById('payment-customer-token');
			const emailInput = document.getElementById('payment-customer-email');
			const paymentType = '{% if payment_type == "split" and paymentStatus == "pending_first" %}first{% elseif payment_type == "split" and paymentStatus == "pending_second" %}second{% else %}full{% endif %}';
			const token = '{{ token|e('js') }}';
			const createOrderUrl = '{{ base_url|e('js') }}/order-access/paypal-create-order';

			paypal.Buttons({
				createOrder: function() {
					return fetch(createOrderUrl, {
						method: 'POST',
						headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
						body: 'token=' + encodeURIComponent(token) + '&payment_type=' + encodeURIComponent(paymentType)
					}).then(function(r) { return r.json(); }).then(function(data) {
						if (data.success && data.orderId) return data.orderId;
						throw new Error(data.error || '{{ trans('planner_hub.could_not_create_order')|e('js') }}');
					});
				},
				onApprove: function(data) {
					if (window.VnvOrderAccessPayment && !window.VnvOrderAccessPayment.begin()) {
						return;
					}
					tokenInput.value = data.orderID;
					form.submit();
				},
				onError: function(err) {
					console.error('PayPal error:', err);
					var errDiv = document.getElementById('payment-card-errors');
					if (errDiv) errDiv.textContent = err.message || '{{ trans('planner_hub.payment_failed_try_again')|e('js') }}';
				}
			}).render('#paypal-button-container');
		})();
		{% endif %}
		{% endif %}
	</script>
{% endblock %}



