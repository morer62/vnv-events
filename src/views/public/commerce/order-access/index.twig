{% endblock %}

{% block scripts %}
	{% if isSquareReady and paymentStatus != "complete" %}
	<script type="text/javascript" src="https://{{ square_environment == 'production' ? 'web' : 'sandbox.web' }}.squarecdn.com/v1/square.js"></script>
	{% endif %}
	{{ processingModalScript|raw }}
	<script>
		function renderSignature() {
			const initials = document.getElementById("typed_initials").value;
			const box = document.getElementById("signatureBox");
			box.textContent = initials || "Your Signature";
		}

		// Prevenir clics múltiples en botones
		document.addEventListener('DOMContentLoaded', function() {
			// Para el formulario de firma simple
			const form = document.querySelector('#contractForm');
			if (form) {
				form.addEventListener('submit', function(e) {
					const submitButton = form.querySelector('button[type="submit"]');
					if (submitButton && !submitButton.disabled) {
						submitButton.disabled = true;
						submitButton.innerHTML = '⏳ Processing...';
						submitButton.style.opacity = '0.6';

						window.VnvProcessingModal.show('orderAccessProcessingModal', {
							title: 'Signing contract...',
							message: 'We are saving your signature. Please wait.'
						});
					}
				});
			}

			// Para el formulario de DocuSign
			const docusignForm = document.querySelector('#docusignForm');
			if (docusignForm) {
				docusignForm.addEventListener('submit', function(e) {
					const submitButton = docusignForm.querySelector('button[type="submit"]');
					if (submitButton && !submitButton.disabled) {
						submitButton.disabled = true;
						submitButton.innerHTML = '⏳ Redirecting to DocuSign...';
						submitButton.style.opacity = '0.6';

						window.VnvProcessingModal.show('orderAccessProcessingModal', {
							title: 'Preparing DocuSign...',
							message: 'We are redirecting you to DocuSign. Please wait.'
						});
					}
				});
			}
		});

		// Capturar hora local del usuario al cargar la página
		document.addEventListener('DOMContentLoaded', function() {
			const now = new Date();
			const timestamp = now.getFullYear() + '-' + 
				String(now.getMonth() + 1).padStart(2, '0') + '-' + 
				String(now.getDate()).padStart(2, '0') + ' ' + 
				String(now.getHours()).padStart(2, '0') + ':' + 
				String(now.getMinutes()).padStart(2, '0') + ':' + 
				String(now.getSeconds()).padStart(2, '0');
			
			const timestampField = document.getElementById('userLocalTimestamp');
			if (timestampField) {
				timestampField.value = timestamp;
				console.log('Contract signing - User local timestamp captured:', timestamp);
			}

			const timestampFieldDocuSign = document.getElementById('userLocalTimestampDocuSign');
			if (timestampFieldDocuSign) {
				timestampFieldDocuSign.value = timestamp;
				console.log('DocuSign signing - User local timestamp captured:', timestamp);
			}
		});

		{% if isSquareReady and paymentStatus != "complete" %}
		// Square Web Payments SDK
		(async function() {
			try {
				const squareApplicationId = "{{ square_application_id|e('js') }}";
				const squareLocationId = "{{ square_location_id|e('js') }}";
				
				if (!squareApplicationId || !squareLocationId) {
					console.error('Square credentials not configured');
					return;
				}

				const payments = Square.payments(squareApplicationId, squareLocationId);
				const card = await payments.card();
				await card.attach('#square-card-container');

				const form = document.getElementById('square-payment-form-element');
				const payButton = document.getElementById('square-pay-button');
				const errorDiv = document.getElementById('square-card-errors');
				const tokenInput = document.getElementById('square-customer-token');

				form.addEventListener('submit', async function(event) {
					event.preventDefault();
					
					payButton.disabled = true;
					payButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';
					errorDiv.textContent = '';

					window.VnvProcessingModal.show('orderAccessProcessingModal', {
						title: 'Processing payment...',
						message: 'We are confirming your payment. Please wait.'
					});

					try {
						const tokenResult = await card.tokenize();
						if (tokenResult.status === 'OK') {
							tokenInput.value = tokenResult.token;
							form.submit();
						} else {
							let errorMessage = 'Payment failed. Please try again.';
							if (tokenResult.errors && tokenResult.errors.length > 0) {
								errorMessage = tokenResult.errors[0].detail || errorMessage;
							}
							errorDiv.textContent = errorMessage;
							payButton.disabled = false;
							payButton.innerHTML = '<i class="bi bi-credit-card me-2"></i>Pay Now';
							window.VnvProcessingModal.hide('orderAccessProcessingModal');
						}
					} catch (error) {
						console.error('Square payment error:', error);
						errorDiv.textContent = 'An error occurred processing your payment. Please try again.';
						payButton.disabled = false;
						payButton.innerHTML = '<i class="bi bi-credit-card me-2"></i>Pay Now';
						window.VnvProcessingModal.hide('orderAccessProcessingModal');
					}
				});
			} catch (error) {
				console.error('Error initializing Square:', error);
				document.getElementById('square-card-errors').textContent = 'Unable to load payment form. Please refresh the page.';
			}
		})();
		{% endif %}
	</script>
{% endblock %}
