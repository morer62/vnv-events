						{% elseif payment_type == "one" and paymentStatus == "pending_first" %}
							<div class="text-center mb-4">
								<h5 class="mb-3">{{ trans('planner_hub.pay_full_amount') }}</h5>
								<p class="text-muted mb-2">{{ trans('planner_hub.amount') }}</p>
								<p class="mb-0"><strong class="fs-3">{{ currency_code|default('USD') }} {{ total | number_format(2) }}</strong></p>
							</div>
						{% endif %}

						<form id="payment-form-element" method="POST" action="{% if payment_type == 'split' and paymentStatus == 'pending_first' %}{{ path('order-access/first/', { token: token }) }}{% elseif payment_type == 'split' and paymentStatus == 'pending_second' %}{{ path('order-access/second/', { token: token }) }}{% else %}{{ path('order-access/full/', { token: token }) }}{% endif %}">
							<input type="hidden" name="token" value="{{ token }}">
							<input type="hidden" name="customer_token" id="payment-customer-token">

							<div class="mb-3">
								<label class="form-label fw-bold">{{ trans('planner_hub.your_email') }}</label>
								<input type="email" name="customer_email" id="payment-customer-email" class="form-control form-control-lg" required>
							</div>

							<div class="mb-3">
								<label class="form-label fw-bold">{{ trans('planner_hub.billing_address') }}</label>
								<input
									type="text"
