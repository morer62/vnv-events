{% extends 'templates/base.twig' %}

{% block styles %}
<style>
    .error-container {
        max-width: 600px;
        margin: 50px auto;
        padding: 2rem;
        text-align: center;
    }
    .error-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        padding: 2rem;
    }
    .error-icon {
        font-size: 4rem;
        color: #dc3545;
        margin-bottom: 1rem;
    }
    .error-message {
        font-size: 1.2rem;
        color: #333;
        margin-bottom: 2rem;
    }
    .btn-back {
        background: #007bff;
        color: white;
        padding: 0.75rem 2rem;
        border-radius: 8px;
        text-decoration: none;
        display: inline-block;
    }
    .btn-back:hover {
        background: #0056b3;
        color: white;
    }
</style>
{% endblock %}

{% block body %}
<div class="error-container">
    <div class="error-card">
        <div class="error-icon">⚠️</div>
        <h2>{{ trans('planner_hub.payment_error') }}</h2>
        <div class="error-message">
            {{ error|default(trans('planner_hub.error_processing_payment')) }}
        </div>
        <a href="javascript:history.back()" class="btn-back">{{ trans('planner_hub.go_back') }}</a>
    </div>
</div>
{% endblock %}


