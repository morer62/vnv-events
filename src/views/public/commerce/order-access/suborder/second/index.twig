{% extends 'templates/base.twig' %}

{% block styles %}
    {% include 'public/commerce/order-access/_modern_skin.twig' %}
{% endblock %}

{% block styles %}
<style>
    .payment-container {
        max-width: 600px;
        margin: 0 auto;
        padding: 2rem;
    }
    .payment-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        padding: 2rem;
        margin-bottom: 2rem;
    }
    .payment-header {
        text-align: center;
        margin-bottom: 2rem;
    }
    .payment-amount {
        font-size: 2.5rem;
        font-weight: bold;
        color: #007bff;
        margin: 1rem 0;
    }
    .suborder-badge {
        background: linear-gradient(45deg, #007bff, #6610f2);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: bold;
        display: inline-block;
        margin-bottom: 1rem;
    }
    .payment-form {
        margin-top: 2rem;
    }
    .payment-button {
        width: 100%;
        padding: 1rem;
        font-size: 1.1rem;
        font-weight: bold;
        border: none;
        border-radius: 8px;
        background: linear-gradient(45deg, #28a745, #20c997);
        color: white;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    .payment-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
    }
    .payment-button:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }
    #payment-request-button {
        width: 100%;
        min-height: 48px;
        display: none;
    }
    #payment-request-button > div,
    #payment-request-button iframe {
        width: 100%;
    }
    .error-message {
        color: #dc3545;
        background: #f8d7da;
        border: 1px solid #f5c6cb;
        border-radius: 4px;
        padding: 0.75rem;
        margin: 1rem 0;
        display: none;
    }
    .success-message {
        color: #155724;
        background: #d4edda;
        border: 1px solid #c3e6cb;
        border-radius: 4px;
        padding: 0.75rem;
        margin: 1rem 0;
        display: none;
    }
</style>
{% endblock %}

{% block body %}
<div class="payment-container">
    <div class="payment-card">
        <div class="payment-header">
            <div class="suborder-badge">ðŸ“‹ {{ trans('planner_hub.suborder_payment') }}</div>
            <h2>ðŸ’³ {{ trans('planner_hub.second_payment') }}</h2>
            {% if suborder.status_workflow %}
            <div class="mb-2">
                {% if suborder.status_workflow == 'INVOICE_DRAFT' %}
                    <span class="badge bg-warning text-dark">ðŸ“ {{ trans('planner_hub.pending_signature') }}</span>
                {% elseif suborder.status_workflow == 'INVOICE_READY' %}
                    <span class="badge bg-secondary">{{ trans('planner_hub.signed_payment_pending') }}</span>
                {% elseif suborder.status_workflow == 'INVOICE_PARTIAL' %}
                    <span class="badge bg-info text-dark">{{ trans('planner_hub.partial_payment') }}</span>
                {% elseif suborder.status_workflow == 'INVOICE_PAID' %}
                    <span class="badge bg-success">{{ trans('planner_hub.fully_paid') }}</span>
                {% endif %}
            </div>
            {% endif %}
            <div class="payment-amount">{{ currency_code|default('USD') }} {{ second_payment_amount | number_format(2) }}</div>
            <p class="text-muted">{{ trans('planner_hub.suborder_id_label') }} #{{ suborder.id }} - {{ trans('planner_hub.parent_order_label') }} VNV-341{{ parentOrder.id }}</p>
        </div>

        <div class="alert alert-info">
            <h5>ðŸ“‹ {{ trans('planner_hub.payment_details') }}</h5>
            <p><strong>{{ trans('planner_hub.parent_order_label') }}</strong> VNV-341{{ parentOrder.id }}</p>
            <p><strong>{{ trans('planner_hub.suborder_id_label') }}</strong> #{{ suborder.id }}</p>
            <p><strong>{{ trans('planner_hub.event_date_label') }}</strong> {{ parentOrder.event_date|date("F j, Y") }}</p>
            <p><strong>{{ trans('planner_hub.payment_type_label') }}</strong> {{ trans('planner_hub.second_installment_percent', {'percent': suborder.payment_split_percent_2}) }}</p>
        </div>


        <form id="payment-form" class="payment-form" method="POST">
            <input type="hidden" name="token" value="{{ token }}">
            <input type="hidden" name="customer_token" id="payment-customer-token">
            
            <div class="mb-3">
                <label for="customer_email" class="form-label">{{ trans('planner_hub.your_email') }}</label>
                <input type="email" name="customer_email" id="customer_email" class="form-control form-control-lg" required>
            </div>
            <div class="mb-3">
                <label for="billing_address" class="form-label">{{ trans('planner_hub.billing_address') }}</label>
                <input type="text"
                       name="billing_address"
                       id="billing_address"
                       class="form-control form-control-lg"
                       data-places
                       placeholder="{{ trans('planner_hub.billing_address_placeholder') }}"
                       required>
            </div>
            {% include 'public/commerce/order-access/_saved_payment_methods.twig' %}

            <input type="hidden" name="billing_zip" id="billing_zip" value="">
            
            <div class="mb-3" id="card-section" {% if active_provider_type == 'paypal' %}style="display:none;"{% endif %}>
                <label for="square-card-container" class="form-label">{{ trans('planner_hub.card_information') }}</label>
                <div id="square-card-container" class="border rounded p-3" style="min-height: 150px;"></div>
                <div id="payment-card-errors" class="text-danger mt-2"></div>
            </div>
            {% if active_provider_type == 'paypal' and paypal_client_id %}
            <div class="mb-4" id="paypal-button-container"></div>
            {% endif %}

            <button type="submit" id="submit-button" class="payment-button" {% if active_provider_type == 'paypal' %}style="display:none;"{% endif %}>
                ðŸ’³ {{ trans('planner_hub.pay_now') }} {{ currency_code|default('USD') }} {{ second_payment_amount | number_format(2) }}
            </button>
        </form>

        <div id="success-message" class="success-message">
            {{ trans('planner_hub.payment_successful_redirecting') }}
        </div>

        <div class="text-center mt-3">
            <a href="{{ path('order-access/suborder?token=' ~ token) }}" class="btn btn-outline-secondary">
                {{ trans('planner_hub.back_to_suborder') }}
            </a>
        </div>
    </div>
</div>

{{ processingModal|raw }}

{% if active_provider_type == 'paypal' and paypal_client_id %}
<script src="https://www.paypal.com/sdk/js?client-id={{ paypal_client_id|e('html_attr') }}&currency={{ currency_code|default('USD') }}&intent=capture"></script>
{% elseif active_provider_type == 'stripe' %}
<script src="https://js.stripe.com/v3/"></script>
{% else %}
<script type="text/javascript" src="https://{{ square_environment == 'production' ? 'web' : 'sandbox.web' }}.squarecdn.com/v1/square.js"></script>
{% endif %}
{{ processingModalScript|raw }}
<script>
    (async function () {
        const form = document.getElementById('payment-form');
        const submitButton = document.getElementById('submit-button');
        const errorDiv = document.getElementById('payment-card-errors');
        const tokenInput = document.getElementById('payment-customer-token');
        const zipInput = document.getElementById('billing_zip');
        const originalButtonText = submitButton ? submitButton.textContent : '';
        const token = '{{ token|e('js') }}';
        const savedMethodSelect = document.getElementById('saved-payment-method-id');
        const newMethodOptions = document.getElementById('new-payment-method-options');
        function usingSavedMethod() { return savedMethodSelect && savedMethodSelect.value; }
        function syncSavedMethodState() {
            if (!savedMethodSelect) return;
            const useSaved = usingSavedMethod();
            const cardSection = document.getElementById('card-section');
            if (cardSection) cardSection.style.display = useSaved ? 'none' : '';
            if (newMethodOptions) newMethodOptions.style.display = useSaved ? 'none' : '';
            if (zipInput) zipInput.required = !useSaved;
        }
        if (savedMethodSelect) savedMethodSelect.addEventListener('change', syncSavedMethodState);
        syncSavedMethodState();

        function setProcessingState(isProcessing) {
            if (submitButton) { submitButton.disabled = isProcessing; submitButton.textContent = isProcessing ? 'â³ Processing...' : originalButtonText; }
            if (isProcessing) window.VnvProcessingModal.show('orderAccessProcessingModal', { title: 'Processing payment...', message: 'We are confirming your payment. Please wait.' });
            else window.VnvProcessingModal.hide('orderAccessProcessingModal');
        }

        {% if active_provider_type == 'paypal' and paypal_client_id %}
        var createOrderUrl = '{{ base_url|e('js') }}/order-access/suborder/paypal-create-order';
        paypal.Buttons({
            createOrder: function() {
                return fetch(createOrderUrl, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'token=' + encodeURIComponent(token) + '&payment_type=second' })
                    .then(function(r) { return r.json(); }).then(function(data) { if (data.success && data.orderId) return data.orderId; throw new Error(data.error || '{{ trans('planner_hub.could_not_create_order')|e('js') }}'); });
            },
            onApprove: function(data) {
                var emailEl = document.getElementById('customer_email');
                if (!emailEl || !emailEl.value || !emailEl.value.trim()) {
                    if (errorDiv) errorDiv.textContent = '{{ trans('planner_hub.please_enter_email')|e('js') }}';
                    return;
                }
                tokenInput.value = data.orderID;
                form.submit();
            },
            onError: function(err) { if (errorDiv) errorDiv.textContent = err.message || '{{ trans('planner_hub.payment_failed')|e('js') }}'; }
        }).render('#paypal-button-container');
        return;
        {% endif %}

        {% if active_provider_type == 'stripe' %}
        try {
            const stripePublishableKey = "{{ stripe_publishable_key|default('')|e('js') }}";
            if (!stripePublishableKey) {
                if (errorDiv) errorDiv.textContent = '{{ trans('planner_hub.payment_system_not_configured_contact')|e('js') }}';
                return;
            }
            const stripe = Stripe(stripePublishableKey);
            const elements = stripe.elements();
            const card = elements.create('card', { style: { base: { fontSize: '16px' } } });
            card.mount('#square-card-container');

            form.addEventListener('submit', async function(event) {
                event.preventDefault();
                if (usingSavedMethod()) { setProcessingState(true); errorDiv.textContent = ''; tokenInput.value = ''; form.submit(); return; }
                setProcessingState(true);
                errorDiv.textContent = '';
                const result = await stripe.createToken(card);
                if (result.error) {
                    errorDiv.textContent = result.error.message;
                    setProcessingState(false);
                    return;
                }
                tokenInput.value = result.token.id;
                form.submit();
            });
        } catch (error) {
            if (errorDiv) errorDiv.textContent = '{{ trans('planner_hub.unable_load_payment_form')|e('js') }}';
        }
        return;
        {% endif %}

        try {
            const squareApplicationId = "{{ square_application_id|e('js') }}";
            const squareLocationId = "{{ square_location_id|e('js') }}";
            if (!squareApplicationId || !squareLocationId) {
                if (errorDiv) errorDiv.textContent = 'Payment system not configured. Please contact support.';
                return;
            }
            const payments = Square.payments(squareApplicationId, squareLocationId);
            const card = await payments.card();
            await card.attach('#square-card-container');

            form.addEventListener('submit', async function(event) {
                event.preventDefault();
                setProcessingState(true);
                errorDiv.textContent = '';
                if (usingSavedMethod()) { tokenInput.value = ''; form.submit(); return; }
                try {
                    const tokenResult = await card.tokenize();
                    if (tokenResult.status === 'OK') {
                        tokenInput.value = tokenResult.token;
                        form.submit();
                    } else {
                        errorDiv.textContent = (tokenResult.errors && tokenResult.errors[0]) ? tokenResult.errors[0].detail : '{{ trans('planner_hub.payment_failed_try_again')|e('js') }}';
                        setProcessingState(false);
                    }
                } catch (error) {
                    errorDiv.textContent = '{{ trans('planner_hub.error_occurred_try_again')|e('js') }}';
                    setProcessingState(false);
                }
            });
        } catch (error) {
            if (errorDiv) errorDiv.textContent = '{{ trans('planner_hub.unable_load_payment_form')|e('js') }}';
        }
    })();
</script>
{% endblock %}

