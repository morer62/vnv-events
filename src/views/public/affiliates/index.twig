<!-- ===== Calculator logic ===== -->
<script>
(function(){
  const $ = (id)=>document.getElementById(id);
  const subs  = $('aff-subs-month');
  const comm  = $('aff-comm');
  const price = $('aff-price');
  const ret   = $('aff-retention');
  const xText = $('x-month');

  const out = { m1:$('m1'), m3:$('m3'), m6:$('m6'), m12:$('m12') };

  function fmt(n){ return '$' + (Math.round(n*100)/100).toLocaleString(); }

  /* Monthly stacked payout:
     active(M) = n * sum_{k=0}^{M-1} r^k
  */
  function stackedPayout(n,p,c,r,m){
    const active = (r === 1) ? n * m : n * ((1 - Math.pow(r, m)) / (1 - r));
    return active * p * c;
  }

  function calc(){
    const n = parseFloat(subs.value || 0);
    const p = parseFloat(price.value || 0);
    const c = (parseFloat(comm.value || 0) / 100);
    const r = (parseFloat(ret.value || 100) / 100);

    xText.innerText = isNaN(n)?0:n;

    out.m1.innerText  = fmt(stackedPayout(n,p,c,r,1));
    out.m3.innerText  = fmt(stackedPayout(n,p,c,r,3));
    out.m6.innerText  = fmt(stackedPayout(n,p,c,r,6));
    out.m12.innerText = fmt(stackedPayout(n,p,c,r,12));
  }

  ['input','change'].forEach(ev=>{
    subs.addEventListener(ev, calc);
    comm.addEventListener(ev, calc);
    price.addEventListener(ev, calc);
    ret.addEventListener(ev, calc);
  });

  // toggle advanced
  document.getElementById('toggle-adv').addEventListener('click', function(e){
    e.preventDefault();
    const adv = document.getElementById('adv-block');
    adv.style.display = (adv.style.display === 'none' || adv.style.display === '') ? 'block' : 'none';
  });

  calc();
})();
</script>

<!-- ===== Affiliate intent setter (robust) ===== -->
<script>
/* Writes redirect_after_auth every time a CTA is pressed.
   Reads redirect from data-redirect OR from ?redirect= in href. */
(function(){
  const KEY     = 'redirect_after_auth';
  const DEFAULT = '/panel/planner-hub-sync';
  const MAX_AGE = 60 * 60 * 24 * 30; // 30 days

  function setIntent(val){
    const v = val || DEFAULT;
    try { localStorage.setItem(KEY, v); } catch(e){}
    document.cookie = KEY + '=' + encodeURIComponent(v) +
      '; path=/; max-age=' + MAX_AGE + '; SameSite=Lax';
  }

  function extractRedirect(el){
    const ds = el.getAttribute('data-redirect');
    if (ds) return ds;
    try {
      const href = el.getAttribute('href') || '';
      const u = new URL(href, location.origin);
      return u.searchParams.get('redirect') || '';
    } catch(e){ return ''; }
  }

  function bind(el){
    const dest = extractRedirect(el) || DEFAULT;
    const handler = () => setIntent(dest);
    // Pointerdown ensures we set the cookie before navigation
    el.addEventListener('pointerdown', handler, { capture:true });
    el.addEventListener('click',       handler, { capture:true });
    el.addEventListener('auxclick',    handler, { capture:true }); // middle-click
    el.addEventListener('keydown', (e)=>{
      if (e.key === 'Enter' || e.keyCode === 13) handler();
    }, { capture:true });
  }

  document.querySelectorAll('a.activate-aff, a[data-redirect]').forEach(bind);
})();
</script>

