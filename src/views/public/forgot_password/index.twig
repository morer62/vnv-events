{% extends "templates/base.twig" %}

{% block body %}

<main class="d-flex w-100">
    <div class="container d-flex flex-column">
        <div class="row min-vh-100 align-items-start align-items-md-center">
            <div class="col-sm-10 col-md-8 col-lg-6 col-xl-5 mx-auto">

                <div class="text-center mt-4 mb-3">
                    <img src="{{ asset_for('assets/images/planner-hub-logo-negative.png') }}" width="200px"><br><br>
                    <p class="lead">Reset your password</p>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body p-4">
                        <form method="post" id="forgotForm">
                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input class="form-control form-control-lg" type="email" name="email" placeholder="Enter your email" required />
                            </div>
                            <div class="d-grid gap-2 mt-3">
                                <button type="submit" id="submitBtn" class="btn btn-lg btn-dark">
                                    Send Reset Link
                                </button>
                            </div>
                        </form>

                        <div class="text-center mt-3">
                            <a href="{{ path('login') }}">Back to Sign in</a>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-3 mb-4">
                    <small>Don't have an account? <a href="{{ path('signup') }}">Sign up</a></small>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Social Account Modal -->
<div class="modal fade" id="socialAccountModal" tabindex="-1" aria-labelledby="socialAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title text-center w-100" id="socialAccountModalLabel">
                    {% if social_account_type == 'google' %}
                        <img src="{{ asset_for('assets/images/google-icon.svg') }}" width="40" height="40" class="me-2">
                        Google Account Detected
                    {% elseif social_account_type == 'apple' %}
                        <img src="{{ asset_for('assets/images/apple-icon.svg') }}" width="40" height="40" class="me-2">
                        Apple Account Detected
                    {% else %}
                        <i class="fas fa-user-circle text-primary me-2"></i>
                        Social Account Detected
                    {% endif %}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div class="mb-3">
                    {% if social_account_type == 'google' %}
                        <img src="{{ asset_for('assets/images/google-icon.svg') }}" width="60" height="60" class="mb-3">
                    {% elseif social_account_type == 'apple' %}
                        <img src="{{ asset_for('assets/images/apple-icon.svg') }}" width="60" height="60" class="mb-3">
                    {% else %}
                        <i class="fas fa-user-circle text-primary" style="font-size: 4rem;"></i>
                    {% endif %}
                </div>
                <h6 class="mb-3">
                    {% if social_account_type == 'google' %}
                        This email is registered with Google
                    {% elseif social_account_type == 'apple' %}
                        This email is registered with Apple
                    {% else %}
                        This email is registered with a social account
                    {% endif %}
                </h6>
                <p class="text-muted mb-4">
                    {% if social_account_type == 'google' %}
                        Password recovery is not available for Google accounts. Please sign in using your Google account or contact support if you need assistance.
                    {% elseif social_account_type == 'apple' %}
                        Password recovery is not available for Apple accounts. Please sign in using your Apple account or contact support if you need assistance.
                    {% else %}
                        Password recovery is not available for social accounts. Please sign in using your social account or contact support if you need assistance.
                    {% endif %}
                </p>
                <div class="d-grid gap-2">
                    <a href="{{ path('login') }}" class="btn btn-primary">
                        <i class="fas fa-sign-in-alt me-2"></i>
                        Sign in
                    </a>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("forgotForm");
    const btn = document.getElementById("submitBtn");

    form.addEventListener("submit", function () {
        btn.disabled = true;
        btn.innerHTML = "Sending…";
    });

    {% if show_social_modal %}
        const modal = new bootstrap.Modal(document.getElementById('socialAccountModal'));
        modal.show();
    {% endif %}
});
</script>

{% endblock %}
