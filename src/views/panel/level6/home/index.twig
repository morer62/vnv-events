{% extends 'templates/base.admin.twig' %}

{% block body %}
<main class="container mt-5" style="max-width:900px;">
    <section class="text-center mb-5">
        <h1 class="fw-bold mb-3">🎯 Marketing Tools Access</h1>
        <p class="text-muted fs-5">
            Welcome! This profile is focused on the marketing toolkit. Go straight to the tools or access the private CMS workspace.
        </p>
    </section>

    <div class="row g-4">

        <!-- MARK TOOLS -->
        <div class="col-md-6">
            <section class="card shadow-sm border-0 h-100">
                <div class="card-body p-5 text-center">
                    <img src="{{ asset_for('assets/images/icons_website/icon_3.png') }}" alt="Mark Tools" class="mb-4" style="height:120px;">
                    <h2 class="fw-bold mb-3">Mark Tools</h2>
                    <p class="text-muted mb-4">
                        Access text humanizer, voice generator and lead finder—everything you need to support marketing campaigns.
                    </p>
                    <a href="{{ path('panel/mark-tools') }}" class="btn btn-success btn-lg fw-bold px-5">
                        Open Mark Tools
                    </a>
                </div>
            </section>
        </div>

        <!-- CMS -->
        <div class="col-md-6">
            <section class="card shadow-sm border-0 h-100">
                <div class="card-body p-5 text-center">
                    <img src="{{ asset_for('assets/images/icons_website/icon_4.png') }}" alt="CMS Builder" class="mb-4" style="height:120px;">
                    <h2 class="fw-bold mb-3">Private CMS</h2>
                    <p class="text-muted mb-4">
                        Create blog posts, pages, routes, metadata and SEO-driven content from your private content manager.
                    </p>
                    <a href="{{ path('panel/cms') }}" class="btn btn-dark btn-lg fw-bold px-5">
                        Open CMS
                    </a>
                </div>
            </section>
        </div>

    </div>
</main>
{% endblock %}