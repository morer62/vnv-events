{% extends 'templates/base.admin.twig' %}

{% block body %}
<style>
    .lvl6-wrap{
        max-width:1200px;
        margin:0 auto;
        padding:32px 20px 50px;
    }

    .lvl6-hero{
        margin-bottom:32px;
    }

    .lvl6-title{
        font-size:2.2rem;
        font-weight:800;
        color:#111827;
        margin-bottom:10px;
    }

    .lvl6-subtitle{
        color:#6b7280;
        font-size:1rem;
        max-width:820px;
        margin:0;
    }

    .lvl6-grid{
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
        gap:22px;
    }

    .lvl6-card{
        background:#fff;
        border:1px solid #e5e7eb;
        border-radius:22px;
        padding:24px;
        box-shadow:0 10px 28px rgba(0,0,0,.05);
        display:flex;
        flex-direction:column;
        min-height:250px;
    }

    .lvl6-icon{
        width:58px;
        height:58px;
        border-radius:16px;
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:1.5rem;
        margin-bottom:16px;
        font-weight:700;
    }

    .lvl6-icon.cms{background:#ecfeff;color:#0f766e;}
    .lvl6-icon.blog{background:#eef2ff;color:#4338ca;}
    .lvl6-icon.locations{background:#ecfdf5;color:#059669;}
    .lvl6-icon.tools{background:#fff7ed;color:#c2410c;}

    .lvl6-card-title{
        font-size:1.18rem;
        font-weight:800;
        color:#111827;
        margin-bottom:10px;
    }

    .lvl6-card-text{
        color:#6b7280;
        line-height:1.65;
        margin-bottom:20px;
    }

    .lvl6-actions{
        display:flex;
        gap:10px;
        flex-wrap:wrap;
        margin-top:auto;
    }

    .lvl6-btn{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        padding:10px 16px;
        border-radius:12px;
        text-decoration:none;
        font-weight:700;
        font-size:.92rem;
        transition:.2s ease;
        border:none;
        cursor:pointer;
    }

    .lvl6-btn-dark{
        background:#111827;
        color:#fff;
    }

    .lvl6-btn-dark:hover{
        background:#000;
        color:#fff;
    }

    .lvl6-btn-light{
        background:#f3f4f6;
        color:#111827;
    }

    .lvl6-btn-light:hover{
        background:#e5e7eb;
        color:#111827;
    }

    @media (max-width:768px){
        .lvl6-wrap{
            padding:22px 14px 40px;
        }

        .lvl6-title{
            font-size:1.75rem;
        }
    }
</style>

<div class="lvl6-wrap">
    <div class="lvl6-hero">
        <h1 class="lvl6-title">VNV Events Content & Marketing Hub</h1>
        <p class="lvl6-subtitle">
            Manage your public content, blog structure, location pages and marketing tools from one place.
            This workspace is designed for SEO, landing pages, editorial content and publishing control.
        </p>
    </div>

    <div class="lvl6-grid">
        <div class="lvl6-card">
            <div class="lvl6-icon cms">🧩</div>
            <div class="lvl6-card-title">CMS Workspace</div>
            <div class="lvl6-card-text">
                Access the main CMS dashboard for pages, templates, blog categories, blog posts and location content.
            </div>
            <div class="lvl6-actions">
                <a href="{{ path('panel/cms') }}" class="lvl6-btn lvl6-btn-dark">Open CMS</a>
            </div>
        </div>

        <div class="lvl6-card">
            <div class="lvl6-icon blog">✍️</div>
            <div class="lvl6-card-title">Blog Manager</div>
            <div class="lvl6-card-text">
                Create blog categories, publish articles, manage SEO metadata and organize editorial routes.
            </div>
            <div class="lvl6-actions">
                <a href="{{ path('panel/cms/blog/blog-posts') }}" class="lvl6-btn lvl6-btn-dark">Open Blog Posts</a>
                <a href="{{ path('panel/cms/blog/blog-categories') }}" class="lvl6-btn lvl6-btn-light">Categories</a>
            </div>
        </div>

        <div class="lvl6-card">
            <div class="lvl6-icon locations">📍</div>
            <div class="lvl6-card-title">Location Pages</div>
            <div class="lvl6-card-text">
                Manage SEO location landing pages like Sunrise, Davie and Broward-focused city pages.
            </div>
            <div class="lvl6-actions">
                <a href="{{ path('panel/cms/location-pages') }}" class="lvl6-btn lvl6-btn-dark">Open Locations</a>
            </div>
        </div>

        <div class="lvl6-card">
            <div class="lvl6-icon tools">🚀</div>
            <div class="lvl6-card-title">Mark Tools</div>
            <div class="lvl6-card-text">
                Use the private marketing tools area for voice, text, lead and campaign support workflows.
            </div>
            <div class="lvl6-actions">
                <a href="{{ path('panel/mark-tools') }}" class="lvl6-btn lvl6-btn-dark">Open Mark Tools</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}