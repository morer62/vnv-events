{% extends 'templates/base.admin.twig' %}

{% block style %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/trumbowyg@2.27.3/dist/ui/trumbowyg.min.css">
<style>
    .lp-builder-card{border:1px solid #e5e7eb;border-radius:12px;background:#fff;}
    .lp-builder-toolbar{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:.8rem;}
    .lp-builder-block{border:1px solid #dbe4ea;border-radius:10px;padding:12px;background:#f8fbfc;}
    .lp-builder-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.6rem;}
    .lp-builder-small{font-size:.8rem;color:#6b7280;}
    @media (max-width: 768px){.lp-builder-grid{grid-template-columns:1fr;}}
</style>
{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="h3 mb-4">Create Location Page</h1>

    <form method="post" class="card shadow-lg border-0 p-4">
        <div class="row">
            <div class="col-md-8 mb-3">
                <label class="form-label">Title *</label>
                <input type="text" name="title" class="form-control" required placeholder="Event Venues in Sunrise, FL">
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Slug *</label>
                <input type="text" name="slug" class="form-control" required placeholder="sunrise">
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Category</label>
                <input type="text" name="category" class="form-control" value="location">
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Template Key</label>
                <select name="template_key" class="form-select" id="template-key-select">
                    <option value="location-home-luxe" selected>Home Luxe (recommended)</option>
                    <option value="location-default">Location Default</option>
                    <option value="location-corporate">Corporate Minimal</option>
                </select>
            </div>

            <div class="col-12 mb-3">
                <div class="lp-builder-card p-3">
                    <h5 class="mb-2">Wedding Glamour Design Controls</h5>
                    <p class="text-muted mb-3">Edit your visual style directly here. This `Custom CSS` is applied on the public location page.</p>
                    <label class="form-label">Custom CSS</label>
                    <textarea name="custom_css" class="form-control" rows="8" placeholder="Paste your custom styles..."></textarea>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="DRAFT">Draft</option>
                    <option value="PUBLISHED">Published</option>
                </select>
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">City</label>
                <input type="text" name="city" class="form-control" placeholder="Sunrise">
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">County</label>
                <input type="text" name="county" class="form-control" placeholder="Broward County">
            </div>

            <div class="col-md-4 mb-3">
                <label class="form-label">State</label>
                <input type="text" name="state" class="form-control" value="Florida">
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Hero Title</label>
                <input type="text" name="hero_title" class="form-control">
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Hero Image URL</label>
                <input type="text" name="hero_image" class="form-control" placeholder="https://...">
            </div>

            <div class="col-12 mb-3">
                <label class="form-label">Hero Subtitle</label>
                <textarea name="hero_subtitle" class="form-control" rows="2"></textarea>
            </div>

            <div class="col-12 mb-3">
                <label class="form-label">Excerpt</label>
                <textarea name="excerpt" class="form-control" rows="2"></textarea>
            </div>

            <div class="col-12 mb-3">
                <label class="form-label">Main Content</label>
                <textarea name="content_long" id="content-editor" class="form-control" rows="10"></textarea>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Primary Keyword</label>
                <input type="text" name="primary_keyword" class="form-control">
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Secondary Keywords</label>
                <input type="text" name="secondary_keywords" class="form-control">
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Meta Title</label>
                <input type="text" name="meta_title" class="form-control">
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Meta Keywords</label>
                <input type="text" name="meta_keywords" class="form-control">
            </div>

            <div class="col-12 mb-3">
                <label class="form-label">Meta Description</label>
                <textarea name="meta_description" class="form-control" rows="2"></textarea>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">OG Title</label>
                <input type="text" name="og_title" class="form-control">
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">OG Image</label>
                <input type="text" name="og_image" class="form-control" placeholder="https://...">
            </div>

            <div class="col-12 mb-3">
                <label class="form-label">OG Description</label>
                <textarea name="og_description" class="form-control" rows="2"></textarea>
            </div>

            <div class="col-12 mb-3">
                <label class="form-label">Canonical URL</label>
                <input type="text" name="canonical_url" class="form-control" placeholder="https://vnvevents.com/sunrise">
            </div>

            <div class="col-12 mb-3">
                <label class="form-label">FAQ JSON</label>
                <textarea name="faq_json" class="form-control" rows="6" placeholder='[{"question":"...","answer":"..."}]'></textarea>
            </div>

            <div class="col-12 mb-3">
                <label class="form-label">Dynamic Blocks JSON</label>
                <div class="lp-builder-card p-3">
                    <div class="lp-builder-toolbar">
                        <button type="button" class="btn btn-sm btn-outline-primary" data-add-block="text">+ Text</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-add-block="images">+ Images</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-add-block="info">+ Info</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-add-block="testimonials">+ Testimonials</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-add-block="links">+ Links</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-add-block="map">+ Map</button>
                    </div>
                    <div id="dynamicBlocksBuilder" class="d-flex flex-column gap-2"></div>
                    <div class="lp-builder-small mt-2">You can reorder, edit and remove blocks. JSON is generated automatically.</div>
                </div>
                <textarea name="dynamic_blocks_json" id="dynamicBlocksJson" class="form-control mt-2" rows="6" placeholder='[{"type":"text","title":"...","content":"..."}]'></textarea>
            </div>

            <div class="col-12 mb-3">
                <label class="form-label">Schema JSON</label>
                <textarea name="schema_json" class="form-control" rows="6"></textarea>
            </div>

            <div class="col-12 mb-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="is_indexable" id="is_indexable" checked>
                    <label class="form-check-label" for="is_indexable">
                        Allow search engines to index this page
                    </label>
                </div>
            </div>

            <div class="col-12 d-flex gap-2">
                <a href="{{ path('panel/cms/location-pages') }}" class="btn btn-outline-secondary">Back</a>
                <button type="submit" class="btn btn-success">Create Page</button>
            </div>
        </div>
    </form>
</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/trumbowyg@2.27.3/dist/trumbowyg.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    $('#content-editor').trumbowyg();

    const titleInput = document.querySelector('[name="title"]');
    const slugInput = document.querySelector('[name="slug"]');

    if (titleInput && slugInput) {
        titleInput.addEventListener('input', function () {
            if (slugInput.dataset.edited === '1') return;

            slugInput.value = titleInput.value
                .toLowerCase()
                .trim()
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/^-+|-+$/g, '');
        });

        slugInput.addEventListener('input', function () {
            slugInput.dataset.edited = '1';
        });
    }

    const templateSelect = document.getElementById('template-key-select');
    const blocksContainer = document.getElementById('dynamicBlocksBuilder');
    const blocksJsonInput = document.getElementById('dynamicBlocksJson');
    const customCssInput = document.querySelector('[name="custom_css"]');
    const heroTitleInput = document.querySelector('[name="hero_title"]');
    const heroSubtitleInput = document.querySelector('[name="hero_subtitle"]');
    const excerptInput = document.querySelector('[name="excerpt"]');
    const contentLongInput = document.querySelector('[name="content_long"]');
    const googleMapsApiKey = '{{ env.GOOGLE_MAPS_API_KEY|default("") }}';

    const DEFAULT_TEMPLATE_CSS = {
        'location-home-luxe': `@import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=Playfair+Display:wght@600;700;800&display=swap');
:root{
  --vnv-primary:#5EC6C4;
  --vnv-primary-dark:#49acab;
  --vnv-luxe-gold:#c5a059;
  --vnv-luxe-gold-soft:#f0d4a0;
  --vnv-gold-gradient:linear-gradient(135deg,#bf953f 0%,#fcf6ba 45%,#b38728 100%);
  --vnv-luxe-dark:#0b0f11;
  --vnv-luxe-dark-soft:#151c20;
  --vnv-luxe-light:#f8fafb;
  --vnv-luxe-text:#d3dbe1;
}
body{font-family:'Manrope',system-ui,-apple-system,'Segoe UI',sans-serif;background:var(--vnv-luxe-dark);color:var(--vnv-luxe-light);}
h1,h2,h3,h4,.lp-title,.luxe-title{font-family:'Playfair Display','Times New Roman',serif;letter-spacing:.01em;}
p,li,span{color:var(--vnv-luxe-text);}
.lp-hero::after{background:radial-gradient(circle at top right, rgba(94,198,196,.22), transparent 36%);}
.lp-badge{background:rgba(94,198,196,.14)!important;color:var(--vnv-primary)!important;border:1px solid rgba(94,198,196,.36);}
.lp-title{text-shadow:0 6px 26px rgba(0,0,0,.38);}
.lp-card{border:1px solid rgba(197,160,89,.26)!important;border-radius:20px;background:linear-gradient(160deg,#ffffff,#fbfbfd);box-shadow:0 18px 38px rgba(8,11,13,.12);}
.lp-card:hover{transform:translateY(-4px);box-shadow:0 24px 48px rgba(8,11,13,.18)!important;border-color:rgba(197,160,89,.45)!important;}
.lp-img{cursor:zoom-in;}
.lp-testimonial-item{
  border:1px solid rgba(197,160,89,.34);
  border-radius:18px;
  padding:18px;
  background:linear-gradient(145deg,rgba(197,160,89,.14),rgba(94,198,196,.08));
}
.luxe-title,.lp-block-title{color:var(--vnv-luxe-gold);letter-spacing:.02em;}`
    };

    function blockTemplate(type, payload) {
        return `
            <div class="lp-builder-block" data-block>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong>${type.toUpperCase()}</strong>
                    <div class="d-flex gap-1">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-move="up">↑</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-move="down">↓</button>
                        <button type="button" class="btn btn-sm btn-outline-danger" data-remove>×</button>
                    </div>
                </div>
                <div class="lp-builder-grid">
                    <div><label class="form-label">Type</label><input class="form-control" data-field="type" value="${type}" readonly></div>
                    <div><label class="form-label">Title</label><input class="form-control" data-field="title" value="${payload.title || ''}"></div>
                    <div style="grid-column:1 / -1;"><label class="form-label">Content</label><textarea class="form-control" data-field="content" rows="2">${payload.content || ''}</textarea></div>
                    <div><label class="form-label">Address</label><input class="form-control" data-field="address" value="${payload.address || ''}"></div>
                    <div><label class="form-label">Latitude</label><input class="form-control" data-field="lat" value="${payload.lat || ''}"></div>
                    <div><label class="form-label">Longitude</label><input class="form-control" data-field="lng" value="${payload.lng || ''}"></div>
                    <div><label class="form-label">Image URL</label><input class="form-control" data-field="image_url" value="${payload.image_url || ''}"></div>
                    <div><label class="form-label">Columns</label><input class="form-control" data-field="columns" value="${payload.columns || 3}"></div>
                    <div><label class="form-label">Items JSON</label><textarea class="form-control" data-field="items" rows="2">${payload.items ? JSON.stringify(payload.items) : ''}</textarea></div>
                    <div><label class="form-label">Links JSON</label><textarea class="form-control" data-field="links" rows="2">${payload.links ? JSON.stringify(payload.links) : ''}</textarea></div>
                    <div><label class="form-label">Images JSON</label><textarea class="form-control" data-field="images" rows="2">${payload.images ? JSON.stringify(payload.images) : ''}</textarea></div>
                </div>
            </div>
        `;
    }

    function addBlock(type, payload = {}) {
        const div = document.createElement('div');
        div.innerHTML = blockTemplate(type, payload);
        blocksContainer.appendChild(div.firstElementChild);
        syncBlocks();
    }

    function parseJsonField(raw) {
        const text = String(raw || '').trim();
        if (!text) return [];
        try { return JSON.parse(text); } catch (e) { return []; }
    }

    function syncBlocks() {
        const blocks = Array.from(blocksContainer.querySelectorAll('[data-block]')).map(function (el) {
            const out = {};
            el.querySelectorAll('[data-field]').forEach(function (f) { out[f.dataset.field] = f.value; });
            out.columns = parseInt(out.columns || '3', 10) || 3;
            if (out.items) out.items = parseJsonField(out.items);
            if (out.links) out.links = parseJsonField(out.links);
            if (out.images) out.images = parseJsonField(out.images);
            if (out.lat !== '') out.lat = parseFloat(out.lat) || '';
            if (out.lng !== '') out.lng = parseFloat(out.lng) || '';
            return out;
        });
        blocksJsonInput.value = JSON.stringify(blocks, null, 2);
    }

    function applyTemplateCssIfEmpty() {
        if (!customCssInput) return;
        const key = templateSelect ? templateSelect.value : '';
        const css = DEFAULT_TEMPLATE_CSS[key] || '';
        if (customCssInput.value.trim() === '' && css) {
            customCssInput.value = css;
        }
    }

    function fillLuxeCopyIfEmpty() {
        if (templateSelect.value !== 'location-home-luxe') return;
        if (heroTitleInput && !heroTitleInput.value.trim()) {
            heroTitleInput.value = 'High-level Event Planner Agency in Alameda, Florida';
        }
        if (heroSubtitleInput && !heroSubtitleInput.value.trim()) {
            heroSubtitleInput.value = 'The event you imagine, brought to life with premium planning, production and elevated guest experiences.';
        }
        if (excerptInput && !excerptInput.value.trim()) {
            excerptInput.value = 'Luxury wedding, social and corporate event planning in Alameda, Florida.';
        }
        if (contentLongInput && !contentLongInput.value.trim()) {
            contentLongInput.value = '<h2>We Are Ready to Craft Your Next Unforgettable Experience</h2><p>At VNV Events, we specialize in creating high-end social and corporate experiences with elegant design, premium service, and flawless execution.</p><h3>What We Offer in This Location</h3><ul><li>Full Event Planning and Coordination</li><li>Luxury Wedding Planning</li><li>Corporate Event Production</li><li>Decor, Floral Design, and Styling</li><li>DJ, Entertainment, and Multimedia Services</li></ul>';
        }
    }

    function initMapAutocompleteInBuilder() {
        if (!window.google || !google.maps || !google.maps.places) return;
        const mapBlocks = Array.from(blocksContainer.querySelectorAll('[data-block]')).filter(function (block) {
            const typeInput = block.querySelector('[data-field="type"]');
            return typeInput && typeInput.value === 'map';
        });

        mapBlocks.forEach(function (block) {
            const addressInput = block.querySelector('[data-field="address"]');
            const latInput = block.querySelector('[data-field="lat"]');
            const lngInput = block.querySelector('[data-field="lng"]');
            if (!addressInput || addressInput.dataset.mapAutocompleteReady === '1') return;

            const autocomplete = new google.maps.places.Autocomplete(addressInput, {
                fields: ['formatted_address', 'geometry'],
                types: ['geocode']
            });
            autocomplete.addListener('place_changed', function () {
                const place = autocomplete.getPlace();
                if (!place || !place.geometry || !place.geometry.location) return;
                if (place.formatted_address) addressInput.value = place.formatted_address;
                if (latInput) latInput.value = String(place.geometry.location.lat());
                if (lngInput) lngInput.value = String(place.geometry.location.lng());
                syncBlocks();
            });

            addressInput.dataset.mapAutocompleteReady = '1';
        });
    }

    function loadGoogleMapsIfNeeded() {
        if (!googleMapsApiKey) return;
        if (window.google && window.google.maps && window.google.maps.places) {
            initMapAutocompleteInBuilder();
            return;
        }
        if (document.getElementById('vnv-admin-maps-js')) return;
        const script = document.createElement('script');
        script.id = 'vnv-admin-maps-js';
        script.src = `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(googleMapsApiKey)}&libraries=places`;
        script.async = true;
        script.defer = true;
        script.onload = initMapAutocompleteInBuilder;
        document.head.appendChild(script);
    }

    document.querySelectorAll('[data-add-block]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            addBlock(btn.dataset.addBlock, {});
            initMapAutocompleteInBuilder();
        });
    });

    blocksContainer.addEventListener('input', syncBlocks);
    blocksContainer.addEventListener('click', function (event) {
        const block = event.target.closest('[data-block]');
        if (!block) return;
        if (event.target.closest('[data-remove]')) {
            block.remove();
            syncBlocks();
            return;
        }
        const moveBtn = event.target.closest('[data-move]');
        if (!moveBtn) return;
        if (moveBtn.dataset.move === 'up' && block.previousElementSibling) {
            blocksContainer.insertBefore(block, block.previousElementSibling);
        }
        if (moveBtn.dataset.move === 'down' && block.nextElementSibling) {
            blocksContainer.insertBefore(block.nextElementSibling, block);
        }
        syncBlocks();
    });

    templateSelect.addEventListener('change', function () {
        applyTemplateCssIfEmpty();
        if (blocksContainer.children.length > 0) return;
        if (templateSelect.value === 'location-home-luxe') {
            addBlock('info', { title: 'Quick Information', items: [{ label: 'Phone', value: '+1 305-204-5427' }, { label: 'Email', value: 'info@vnvevents.com' }, { label: 'Hours', value: 'Mon - Fri 10 AM - 5 PM' }] });
            addBlock('images', { title: 'Gallery', columns: 3, images: [] });
            addBlock('testimonials', { title: 'What Clients Say', enabled: true, items: [{ quote: 'VNV Events made our wedding weekend feel like a luxury production.', name: 'Sofia M.', role: 'Bride' }, { quote: 'Every detail felt intentional and elegant from start to finish.', name: 'Carla R.', role: 'Corporate Client' }] });
            addBlock('map', { title: 'Address', address: '10258 NW 47th St, Sunrise, FL 33351' });
            initMapAutocompleteInBuilder();
        }
        fillLuxeCopyIfEmpty();
    });

    blocksJsonInput.addEventListener('input', function () {
        // allow manual JSON edits
    });

    applyTemplateCssIfEmpty();
    fillLuxeCopyIfEmpty();
    loadGoogleMapsIfNeeded();
});
</script>
{% endblock %}