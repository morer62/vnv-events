{% extends "templates/base.admin.twig" %}

{% block body %}
<style>
    .cms-wrap{
        padding:24px;
        max-width:1100px;
    }

    .cms-header{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:16px;
        margin-bottom:24px;
        flex-wrap:wrap;
    }

    .cms-title{
        font-size:2rem;
        font-weight:800;
        color:#111827;
        margin:0 0 6px 0;
    }

    .cms-subtitle{
        color:#6b7280;
        font-size:.96rem;
        margin:0;
    }

    .cms-card{
        background:#fff;
        border:1px solid #e5e7eb;
        border-radius:20px;
        padding:24px;
        box-shadow:0 10px 30px rgba(0,0,0,.05);
    }

    .cms-grid{
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:18px;
    }

    .cms-field{
        margin-bottom:18px;
    }

    .cms-field.full{
        grid-column:1 / -1;
    }

    .cms-label{
        display:block;
        font-size:.92rem;
        font-weight:700;
        color:#111827;
        margin-bottom:8px;
    }

    .cms-input,
    .cms-textarea{
        width:100%;
        border:1px solid #d1d5db;
        border-radius:14px;
        padding:12px 14px;
        font-size:.95rem;
        color:#111827;
        background:#fff;
        outline:none;
        transition:.2s ease;
        box-sizing:border-box;
        font-family:inherit;
    }

    .cms-input:focus,
    .cms-textarea:focus{
        border-color:#111827;
        box-shadow:0 0 0 3px rgba(17,24,39,.08);
    }

    .cms-textarea{
        min-height:130px;
        resize:vertical;
    }

    .cms-textarea.code{
        min-height:420px;
        font-family:Consolas, Monaco, monospace;
        font-size:.9rem;
        line-height:1.6;
        white-space:pre;
    }

    .cms-help{
        margin-top:6px;
        font-size:.84rem;
        color:#6b7280;
    }

    .cms-check{
        display:flex;
        align-items:center;
        gap:10px;
        padding:12px 14px;
        border:1px solid #e5e7eb;
        border-radius:14px;
        background:#f9fafb;
    }

    .cms-actions{
        display:flex;
        gap:12px;
        flex-wrap:wrap;
        margin-top:10px;
    }

    .cms-btn{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        padding:10px 16px;
        border-radius:12px;
        text-decoration:none;
        font-weight:700;
        font-size:.92rem;
        transition:.2s ease;
        border:none;
        cursor:pointer;
    }

    .cms-btn-primary{
        background:#111827;
        color:#fff;
    }

    .cms-btn-primary:hover{
        background:#000;
        color:#fff;
    }

    .cms-btn-light{
        background:#f3f4f6;
        color:#111827;
    }

    .cms-btn-light:hover{
        background:#e5e7eb;
        color:#111827;
    }

    .cms-alert{
        margin-bottom:18px;
        background:#fef2f2;
        border:1px solid #fecaca;
        color:#991b1b;
        border-radius:16px;
        padding:14px 16px;
    }

    .cms-alert ul{
        margin:0;
        padding-left:18px;
    }

    @media (max-width:768px){
        .cms-wrap{
            padding:16px;
        }

        .cms-grid{
            grid-template-columns:1fr;
        }

        .cms-title{
            font-size:1.55rem;
        }
    }
</style>

<div class="cms-wrap">
    <div class="cms-header">
        <div>
            <h1 class="cms-title">Create Template</h1>
            <p class="cms-subtitle">
                Save a reusable Twig structure that can later be copied into CMS pages.
            </p>
        </div>

        <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <a href="{{ path('panel/cms/templates') }}" class="cms-btn cms-btn-light">← Back to Templates</a>
        </div>
    </div>

    <div class="cms-card">
        {% if errors and errors|length > 0 %}
            <div class="cms-alert">
                <ul>
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <form method="POST">
            <div class="cms-grid">
                <div class="cms-field">
                    <label class="cms-label">Name *</label>
                    <input
                        type="text"
                        name="name"
                        class="cms-input"
                        value="{{ old.name }}"
                        placeholder="Example: Legal Page Template"
                        required
                    >
                </div>

                <div class="cms-field">
                    <label class="cms-label">Slug</label>
                    <input
                        type="text"
                        name="slug"
                        class="cms-input"
                        value="{{ old.slug }}"
                        placeholder="Example: legal-page-template"
                    >
                    <div class="cms-help">
                        If left empty, it will be generated automatically from the name.
                    </div>
                </div>

                <div class="cms-field full">
                    <label class="cms-label">Description</label>
                    <textarea
                        name="description"
                        class="cms-textarea"
                        placeholder="Optional internal description for this template."
                    >{{ old.description }}</textarea>
                </div>

                <div class="cms-field full">
                    <label class="cms-label">Template Source *</label>
                    <textarea
                        name="template_source"
                        class="cms-textarea code"
                        placeholder="Write your Twig template here..."
                        required
                    >{{ old.template_source }}</textarea>
                    <div class="cms-help">
                        This is the reusable Twig structure that will later be copied or adapted for CMS pages.
                    </div>
                </div>

                <div class="cms-field full">
                    <label class="cms-label">Status</label>
                    <label class="cms-check">
                        <input
                            type="checkbox"
                            name="is_active"
                            value="1"
                            {% if old.is_active %}checked{% endif %}
                        >
                        <span>Active template</span>
                    </label>
                </div>
            </div>

            <div class="cms-actions">
                <button type="submit" class="cms-btn cms-btn-primary">Save Template</button>
                <a href="{{ path('panel/cms/templates') }}" class="cms-btn cms-btn-light">Cancel</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}