<article class="ticket-card {{ used ? 'is-used' : '' }}">
    <div class="ticket-card-body">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
            <h3>{{ ticket.event_name }}</h3>
            <span class="event-badge {{ used ? 'dark' : '' }}">{{ used ? 'Used' : (ticket.payment_status|title) }}</span>
        </div>

        <div class="ticket-meta">
            {% if ticket.event_date %}<div><i class="fa-solid fa-calendar me-2"></i>{{ ticket.event_date|date('M j, Y g:i A') }}</div>{% endif %}
            {% if ticket.event_location %}<div><i class="fa-solid fa-location-dot me-2"></i>{{ ticket.event_location }}</div>{% endif %}
        </div>

        <div class="ticket-line">
            <span>Type</span>
            <strong>{{ ticket.ticket_type_name }}</strong>
        </div>
        {% if ticket.sales_stage_name %}
            <div class="ticket-line">
                <span>Stage</span>
                <strong>{{ ticket.sales_stage_name }}</strong>
            </div>
        {% endif %}
        <div class="ticket-line">
            <span>Quantity</span>
            <strong>{{ ticket.quantity }}</strong>
        </div>
        <div class="ticket-line">
            <span>Total</span>
            <strong>${{ ticket.total_amount|number_format(2) }}</strong>
        </div>
        {% if ticket.sold_at %}
            <div class="ticket-line">
                <span>Purchased</span>
                <strong>{{ ticket.sold_at|date('M j, Y') }}</strong>
            </div>
        {% endif %}

        {% if ticket.ticket_codes %}
            <div class="mt-3">
                {% for code in ticket.ticket_codes %}
                    <div class="ticket-code">
                        <code>{{ code }}</code>
                        <div class="d-inline-flex gap-2">
                            <button class="btn-vnv-soft copy-btn" type="button" data-code="{{ code }}" title="Copy code">
                                <i class="fa-solid fa-copy"></i>
                            </button>
                            <button class="btn-vnv-soft qr-btn" type="button" data-ticket-id="{{ ticket.id }}" data-code-index="{{ loop.index0 }}" title="View QR">
                                <i class="fa-solid fa-qrcode"></i>
                            </button>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <div class="d-grid mt-3">
            <button class="{{ used ? 'btn-vnv-soft' : 'btn-vnv-dark' }} download-btn" type="button" data-ticket-id="{{ ticket.id }}" data-code-index="0">
                <i class="fa-solid fa-download"></i> Download ticket
            </button>
        </div>
    </div>
</article>
