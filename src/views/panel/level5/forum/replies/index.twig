{% extends 'templates/base.admin.twig' %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">My Forum Replies</h1>
            <div class="text-muted">Public VNV Events community replies you have posted.</div>
        </div>
        <a href="{{ path('forums') }}" class="btn btn-outline-primary" target="_blank">Open Forums</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Thread</th>
                        <th>My Reply</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th class="text-end">Link</th>
                    </tr>
                </thead>
                <tbody>
                    {% for reply in replies %}
                        <tr>
                            <td>
                                <strong>{{ reply.topic_title }}</strong>
                                <div class="small text-muted">{{ reply.category_name }}</div>
                            </td>
                            <td style="max-width:520px;">{{ reply.content|e|slice(0, 180) }}{% if reply.content|length > 180 %}...{% endif %}</td>
                            <td>
                                <span class="badge {% if reply.status|default('APPROVED') == 'APPROVED' %}bg-success{% elseif reply.status|default('PENDING') == 'PENDING' %}bg-warning text-dark{% else %}bg-secondary{% endif %}">
                                    {{ reply.status|default(reply.is_approved ? 'APPROVED' : 'PENDING') }}
                                </span>
                            </td>
                            <td>{{ reply.created_at|date('M d, Y') }}</td>
                            <td class="text-end">
                                {% if reply.topic_status|default('PUBLISHED') == 'PUBLISHED' %}
                                    <a href="{{ path('forums/' ~ reply.topic_slug ~ '/') }}" class="btn btn-sm btn-outline-primary" target="_blank">View</a>
                                {% else %}
                                    <span class="text-muted small">Thread not public</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">You have not posted any forum replies yet.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
