{% extends 'templates/base.admin.twig' %}{% block body %}<main class="container py-4" style="max-width:1000px"><small class="text-uppercase fw-bold text-success">VNV Rewards</small><h1 class="fw-bold">Your rewards</h1><div class="row g-3 my-3"><div class="col-md-4"><div class="card vnv-panel-card h-100"><div class="card-body"><small>Available</small><h2>{{ balance.available_points|number_format(2) }} pts</h2><strong>${{ balance.available_value|number_format(2) }}</strong></div></div></div><div class="col-md-4"><div class="card vnv-panel-card h-100"><div class="card-body"><small>Pending</small><h2>{{ balance.pending_points|number_format(2) }} pts</h2><strong>${{ balance.pending_value|number_format(2) }}</strong></div></div></div><div class="col-md-4"><div class="card vnv-panel-card h-100"><div class="card-body"><small>Lifetime redeemed</small><h2>{{ balance.lifetime_redeemed|number_format(2) }} pts</h2></div></div></div></div><section class="card vnv-panel-card"><div class="card-body"><h2 class="h5 fw-bold">Reward history</h2><div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Description</th><th>Points</th><th>Status</th></tr></thead><tbody>{% for row in history %}<tr><td>{{ row.created_at|date('M j, Y') }}</td><td>{{ row.description }}</td><td>{{ row.points>0?'+':'' }}{{ row.points|number_format(2) }}</td><td>{{ row.status|title }}</td></tr>{% else %}<tr><td colspan="4">No rewards yet. Fully paid eligible purchases will appear here.</td></tr>{% endfor %}</tbody></table></div></div></section></main>{% endblock %}
