{% extends 'templates/base.admin.twig' %}

{% block body %}
<main class="nutrition-advisor-page mt-4 container pb-5">

  <style>
    :root{
      --gourmet-primary:#f59e0b;
      --gourmet-primary-dark:#d97706;
      --gourmet-accent:#fb923c;
      --gourmet-cream:#fff8ef;
      --gourmet-soft:#fff3df;
      --gourmet-dark:#1f1307;
      --gourmet-text:#2d241c;
      --gourmet-muted:#6f6255;
      --gourmet-border:#ecd9bf;
      --gourmet-shadow:0 18px 44px rgba(79,43,8,.10);
      --gourmet-success:#16a34a;
      --gourmet-success-bg:#eefbf1;
      --gourmet-info:#0ea5e9;
      --gourmet-danger:#dc2626;
    }

    .nutrition-advisor-page{
      color:var(--gourmet-text);
    }

    .na-hero{
      position:relative;
      overflow:hidden;
      border-radius:28px;
      padding:2rem 1.8rem;
      color:#fff;
      background:
        radial-gradient(900px 420px at 0% 0%, rgba(245,158,11,.16), transparent 60%),
        linear-gradient(135deg, #251508 0%, #1f1307 55%, #361a06 100%);
      box-shadow:0 22px 54px rgba(0,0,0,.16);
      margin-bottom:2rem;
    }

    .na-hero:after{
      content:"";
      position:absolute;
      right:-70px;
      top:-70px;
      width:220px;
      height:220px;
      background:radial-gradient(circle, rgba(255,209,138,.16) 0%, rgba(255,209,138,0) 70%);
      pointer-events:none;
    }

    .na-hero > *{
      position:relative;
      z-index:2;
    }

    .na-badge{
      display:inline-flex;
      align-items:center;
      gap:.45rem;
      border-radius:999px;
      padding:.55rem .9rem;
      font-size:.9rem;
      font-weight:800;
      background:rgba(255,255,255,.08);
      border:1px solid rgba(255,255,255,.18);
      color:#fff;
      margin-bottom:1rem;
    }

    .na-hero h1{
      font-size:clamp(2rem,4vw,3.05rem);
      line-height:1.05;
      font-weight:900;
      letter-spacing:-1px;
      margin-bottom:.8rem;
      max-width:860px;
    }

    .na-hero h1 .warm{
      color:#ffd18a;
    }

    .na-hero p{
      max-width:780px;
      color:#f4e4cb;
      line-height:1.72;
      font-size:1rem;
      margin-bottom:1rem;
    }

    .na-layout{
      display:grid;
      grid-template-columns: 420px 1fr;
      gap:1.2rem;
      align-items:start;
    }

    .na-card{
      background:#fff;
      padding:1.4rem 1.2rem;
      border-radius:22px;
      box-shadow:var(--gourmet-shadow);
      border:1px solid rgba(94,55,15,.06);
      margin-bottom:1rem;
    }

    .na-card h2,
    .na-card h3{
      color:var(--gourmet-dark);
      font-weight:900;
      margin-bottom:.85rem;
    }

    .na-label{
      display:block;
      font-weight:800;
      color:#4d3c28;
      margin-bottom:.45rem;
    }

    .na-field{
      margin-bottom:1rem;
    }

    .na-input,
    .na-select{
      width:100%;
      border:1px solid #e9d7bd;
      border-radius:14px;
      padding:.95rem 1rem;
      background:#fffdfa;
      color:#2d241c;
      outline:none;
    }

    .na-input:focus,
    .na-select:focus{
      border-color:#f59e0b;
      box-shadow:0 0 0 4px rgba(245,158,11,.10);
      background:#fff;
    }

    .na-grid-2{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:.85rem;
    }

    .na-grid-3{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:.85rem;
    }

    .na-submit{
      width:100%;
      background:linear-gradient(135deg,var(--gourmet-primary),var(--gourmet-accent));
      color:#23160a !important;
      padding:1rem 1.55rem;
      font-size:1rem;
      border-radius:999px;
      text-decoration:none;
      font-weight:800;
      display:inline-flex;
      gap:.55rem;
      align-items:center;
      justify-content:center;
      border:none;
      box-shadow:0 12px 28px rgba(245,158,11,.28);
      transition:all .22s ease;
    }

    .na-submit:hover{
      transform:translateY(-2px);
      background:linear-gradient(135deg,var(--gourmet-primary-dark),var(--gourmet-accent));
    }

    .na-muted{
      color:var(--gourmet-muted);
      line-height:1.7;
    }

    .na-disclaimer{
      border-radius:18px;
      background:#fff8ee;
      border:1px solid #f0d8b4;
      padding:1rem;
      color:#7a5b35;
      font-size:.93rem;
      line-height:1.7;
      margin-top:1rem;
    }

    .na-results-top{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:1rem;
      margin-bottom:1rem;
    }

    .na-stat{
      background:linear-gradient(135deg,#fff5e6,#fffdf9);
      border:1px solid #efd4a9;
      border-radius:20px;
      padding:1rem;
      text-align:center;
    }

    .na-stat strong{
      display:block;
      font-size:1.8rem;
      color:var(--gourmet-primary-dark);
      line-height:1.1;
      margin-bottom:.35rem;
    }

    .na-stat span{
      color:var(--gourmet-muted);
      font-weight:800;
      font-size:.92rem;
    }

    .na-section-title{
      font-weight:900;
      font-size:1.3rem;
      color:var(--gourmet-dark);
      margin-bottom:.75rem;
    }

    .na-highlight{
      color:var(--gourmet-primary-dark);
    }

    .na-tip-list{
      display:grid;
      gap:.75rem;
    }

    .na-tip{
      background:#fffdf9;
      border:1px solid #ead8bf;
      border-radius:16px;
      padding:.95rem 1rem;
      color:var(--gourmet-text);
      line-height:1.7;
    }

    .na-tip strong{
      color:var(--gourmet-dark);
    }

    .na-food-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:1rem;
    }

    .na-food-box{
      background:#fffdf9;
      border:1px solid #ead8bf;
      border-radius:18px;
      padding:1rem;
    }

    .na-food-box h4{
      font-size:1.05rem;
      font-weight:900;
      color:var(--gourmet-dark);
      margin-bottom:.7rem;
    }

    .na-food-box ul{
      margin:0;
      padding-left:1rem;
      color:var(--gourmet-muted);
      line-height:1.8;
    }

    .na-food-box li + li{
      margin-top:.2rem;
    }

    .na-tabs{
      display:flex;
      flex-wrap:wrap;
      gap:.6rem;
      margin-bottom:1rem;
    }

    .na-tab-btn{
      border:none;
      background:#fff4e2;
      border:1px solid #f0d8b4;
      color:#8b4f00;
      padding:.72rem 1rem;
      border-radius:999px;
      font-weight:800;
      cursor:pointer;
    }

    .na-tab-btn.active{
      background:linear-gradient(135deg,var(--gourmet-primary),var(--gourmet-accent));
      color:#23160a;
      border-color:transparent;
    }

    .na-tab-panel{
      display:none;
    }

    .na-tab-panel.active{
      display:block;
    }

    .na-copy-box{
      background:#fffdf9;
      border:1px dashed #e4cfae;
      border-radius:18px;
      padding:1rem;
      margin-top:1rem;
    }

    .na-copy-output{
      width:100%;
      min-height:260px;
      border:none;
      outline:none;
      resize:vertical;
      background:transparent;
      color:#3b3128;
      line-height:1.7;
    }

    .na-copy-actions{
      display:flex;
      gap:.75rem;
      flex-wrap:wrap;
      margin-top:.85rem;
    }

    .na-soft-btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:.45rem;
      padding:.9rem 1.1rem;
      border-radius:999px;
      font-weight:800;
      text-decoration:none;
      background:#fff6e8;
      color:#8b4f00;
      border:1px solid #f1d4a3;
      cursor:pointer;
    }

    .na-soft-btn:hover{
      background:#ffefcf;
    }

    .na-main-btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:.45rem;
      padding:.95rem 1.2rem;
      border-radius:999px;
      font-weight:800;
      text-decoration:none;
      background:linear-gradient(135deg,var(--gourmet-primary),var(--gourmet-accent));
      color:#23160a !important;
      border:none;
      cursor:pointer;
      box-shadow:0 12px 28px rgba(245,158,11,.28);
    }

    .na-fast-grid{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:1rem;
    }

    .na-fast-box{
      background:#fffdf9;
      border:1px solid #ead8bf;
      border-radius:18px;
      padding:1rem;
    }

    .na-fast-box h5{
      font-weight:900;
      color:var(--gourmet-dark);
      margin-bottom:.45rem;
    }

    .na-fast-box p{
      color:var(--gourmet-muted);
      line-height:1.7;
      margin-bottom:0;
      font-size:.95rem;
    }

    .na-warning{
      margin-top:1rem;
      background:#fff4f4;
      border:1px solid #f5c2c7;
      color:#8a2432;
      border-radius:18px;
      padding:1rem;
      line-height:1.7;
    }

    .na-success{
      background:#eefbf1;
      border:1px solid #bde5c8;
      color:#166534;
      border-radius:16px;
      padding:.85rem 1rem;
      margin-top:.75rem;
      display:none;
    }

    .na-protein-builder{
      margin-top:1.2rem;
      padding:1rem;
      border-radius:20px;
      border:1px solid #ead8bf;
      background:linear-gradient(135deg,#fffaf1,#fffdf9);
    }

    .na-protein-builder h4{
      font-size:1.05rem;
      font-weight:900;
      color:var(--gourmet-dark);
      margin-bottom:.35rem;
    }

    .na-protein-builder p{
      color:var(--gourmet-muted);
      margin-bottom:1rem;
      line-height:1.7;
    }

    .na-protein-items{
      display:grid;
      gap:.75rem;
    }

    .na-protein-item{
      display:grid;
      grid-template-columns:minmax(0,1fr) 100px;
      gap:.8rem;
      align-items:center;
      background:#fff;
      border:1px solid #ead8bf;
      border-radius:16px;
      padding:.9rem 1rem;
    }

    .na-protein-item-title{
      font-weight:900;
      color:var(--gourmet-dark);
      margin-bottom:.15rem;
    }

    .na-protein-item-meta{
      font-size:.92rem;
      color:var(--gourmet-muted);
      line-height:1.6;
    }

    .na-protein-qty{
      width:100%;
      border:1px solid #e9d7bd;
      border-radius:12px;
      padding:.75rem .85rem;
      background:#fffdfa;
      outline:none;
      text-align:center;
      font-weight:800;
      color:#2d241c;
    }

    .na-protein-summary{
      margin-top:1rem;
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:.75rem;
    }

    .na-protein-summary-box{
      border-radius:16px;
      border:1px solid #ead8bf;
      background:#fff;
      padding:.9rem 1rem;
      text-align:center;
    }

    .na-protein-summary-box strong{
      display:block;
      font-size:1.3rem;
      font-weight:900;
      color:var(--gourmet-dark);
      margin-bottom:.2rem;
    }

    .na-protein-summary-box span{
      color:var(--gourmet-muted);
      font-size:.9rem;
      font-weight:800;
    }

    .na-protein-goal-box{
      margin-top:1rem;
      border-radius:18px;
      padding:1rem;
      border:1px solid #f0d8b4;
      background:#fff8ee;
      color:#7a5b35;
      line-height:1.7;
      font-weight:700;
    }

    .na-protein-goal-box.success{
      border-color:#bde5c8;
      background:var(--gourmet-success-bg);
      color:#166534;
    }

    .na-helper-note{
      margin-top:.8rem;
      font-size:.92rem;
      color:var(--gourmet-muted);
      line-height:1.7;
    }

    @media (max-width: 1199px){
      .na-layout{
        grid-template-columns:1fr;
      }
    }

    @media (max-width: 991px){
      .na-results-top,
      .na-food-grid,
      .na-fast-grid,
      .na-protein-summary{
        grid-template-columns:1fr 1fr;
      }
    }

    @media (max-width: 768px){
      .na-grid-2,
      .na-grid-3,
      .na-results-top,
      .na-food-grid,
      .na-fast-grid,
      .na-protein-summary{
        grid-template-columns:1fr;
      }

      .na-protein-item{
        grid-template-columns:1fr;
      }
    }
  </style>

  <section class="na-hero">
    <span class="na-badge">
      <i class="fa-solid fa-heart-pulse"></i> Avomeal Nutrition Advisor
    </span>

    <h1>
      <span style="color:#fff">Welcome{% if user.name is defined and user.name %}, {{ user.name }}{% endif %}.</span>
      <span class="warm">Build a smarter health routine with real-life guidance.</span>
    </h1>

    <p>
      Get a friendlier daily plan for calories, protein, hydration, fiber, sugar awareness, energy, caffeine, meal timing and fasting guidance — all in one place.
    </p>
  </section>

  <section class="na-layout">
    <div>
      <div class="na-card">
        <h2>Start your plan</h2>
        <p class="na-muted">
          Fill this out once and we’ll build a practical nutrition guide around your goal.
        </p>

        <form id="nutritionAdvisorForm">
          <div class="na-grid-2">
            <div class="na-field">
              <label class="na-label" for="na_gender">Gender</label>
              <select id="na_gender" class="na-select" required>
                <option value="">Select</option>
                <option value="male">Male</option>
                <option value="female">Female</option>
              </select>
            </div>

            <div class="na-field">
              <label class="na-label" for="na_age">Age</label>
              <input id="na_age" type="number" class="na-input" min="14" max="100" placeholder="e.g. 34" required>
            </div>
          </div>

          <div class="na-grid-3">
            <div class="na-field">
              <label class="na-label" for="na_height_ft">Height (ft)</label>
              <input id="na_height_ft" type="number" class="na-input" min="3" max="8" placeholder="e.g. 5" required>
            </div>

            <div class="na-field">
              <label class="na-label" for="na_height_in">Height (in)</label>
              <input id="na_height_in" type="number" class="na-input" min="0" max="11" placeholder="e.g. 10" required>
            </div>

            <div class="na-field">
              <label class="na-label" for="na_weight_lb">Weight (lb)</label>
              <input id="na_weight_lb" type="number" class="na-input" min="80" max="550" step="0.1" placeholder="e.g. 172" required>
            </div>
          </div>

          <div class="na-grid-2">
            <div class="na-field">
              <label class="na-label" for="na_goal">Main goal</label>
              <select id="na_goal" class="na-select" required>
                <option value="">Select</option>
                <option value="fat_loss">Lose fat</option>
                <option value="maintain">Maintain weight</option>
                <option value="muscle_gain">Gain muscle</option>
                <option value="recomp">Body recomposition</option>
                <option value="healthy_lifestyle">Healthy lifestyle</option>
                <option value="more_energy">More energy</option>
              </select>
            </div>

            <div class="na-field">
              <label class="na-label" for="na_activity">Activity level</label>
              <select id="na_activity" class="na-select" required>
                <option value="">Select</option>
                <option value="sedentary">Sedentary</option>
                <option value="light">Light</option>
                <option value="moderate">Moderate</option>
                <option value="active">Active</option>
                <option value="very_active">Very active</option>
              </select>
            </div>
          </div>

          <div class="na-grid-2">
            <div class="na-field">
              <label class="na-label" for="na_goal_weight_lb">Goal weight (lb, optional)</label>
              <input id="na_goal_weight_lb" type="number" class="na-input" min="80" max="550" step="0.1" placeholder="Optional">
            </div>

            <div class="na-field">
              <label class="na-label" for="na_sleep_hour">Usual bedtime (optional)</label>
              <input id="na_sleep_hour" type="time" class="na-input">
            </div>
          </div>

          <button type="submit" class="na-submit">
            <i class="fa-solid fa-wand-magic-sparkles"></i> Build My Plan
          </button>
        </form>

        <div class="na-disclaimer">
          <strong>Friendly note:</strong> this is general wellness guidance. It is not medical care, diagnosis, or treatment. If you are pregnant, have diabetes, kidney disease, an eating disorder history, or use medication that affects appetite, blood pressure, or glucose, use extra caution and ask your clinician before making major changes.
        </div>
      </div>
    </div>

    <div>
      <div class="na-card" id="naResultsCard">
        <div class="na-results-top">
          <div class="na-stat">
            <strong id="resCalories">—</strong>
            <span>Daily calories</span>
          </div>
          <div class="na-stat">
            <strong id="resProtein">—</strong>
            <span>Protein target</span>
          </div>
          <div class="na-stat">
            <strong id="resWater">—</strong>
            <span>Water target</span>
          </div>
          <div class="na-stat">
            <strong id="resFiber">—</strong>
            <span>Fiber target</span>
          </div>
        </div>

        <div class="na-tabs">
          <button type="button" class="na-tab-btn active" data-tab="overview">Overview</button>
          <button type="button" class="na-tab-btn" data-tab="protein">Protein</button>
          <button type="button" class="na-tab-btn" data-tab="energy">Energy & Sugar</button>
          <button type="button" class="na-tab-btn" data-tab="caffeine">Caffeine</button>
          <button type="button" class="na-tab-btn" data-tab="fasting">Fasting</button>
          <button type="button" class="na-tab-btn" data-tab="plan">Copy Plan</button>
        </div>

        <div class="na-tab-panel active" data-panel="overview">
          <h3 class="na-section-title">Your <span class="na-highlight">strategy</span></h3>
          <div class="na-tip-list" id="overviewTips">
            <div class="na-tip">Fill in your information to generate a personalized plan.</div>
          </div>

          <div class="na-food-grid mt-4">
            <div class="na-food-box">
              <h4>Easy protein ideas</h4>
              <ul>
                <li>2 eggs = about 12g protein</li>
                <li>Chicken breast, 4 oz cooked = about 35g protein</li>
                <li>Turkey breast, 4 oz cooked = about 34g protein</li>
                <li>1 tuna can (5 oz drained) = about 30g protein</li>
                <li>Greek yogurt, 1 cup = about 20g protein</li>
                <li>Cottage cheese, 1 cup = about 25g protein</li>
                <li>Tofu, 6 oz = about 18g protein</li>
                <li>Soy protein powder, 1 scoop = about 20g protein</li>
                <li>Beans + rice, 1 combined cup = about 10g protein</li>
                <li>Lentils, 1 cup cooked = about 18g protein</li>
              </ul>
            </div>

            <div class="na-food-box">
              <h4>Easy fiber ideas</h4>
              <ul>
                <li>Oats, 1 cup cooked = about 4g fiber</li>
                <li>Berries, 1 cup = about 6–8g fiber</li>
                <li>Apple, 1 medium = about 4g fiber</li>
                <li>Pear, 1 medium = about 5–6g fiber</li>
                <li>Beans, 1 cup cooked = about 12–15g fiber</li>
                <li>Lentils, 1 cup cooked = about 15g fiber</li>
                <li>Avocado, 1 medium = about 10g fiber</li>
                <li>Vegetables, 1–2 cups = varies</li>
                <li>Chia seeds, 2 tbsp = about 10g fiber</li>
                <li>Whole grains, 1 serving = varies</li>
              </ul>
            </div>
          </div>

          <div class="na-food-grid mt-3">
            <div class="na-food-box">
              <h4>Hydration tips</h4>
              <ul>
                <li>Start the day with water</li>
                <li>Keep a bottle nearby</li>
                <li>Drink more if you sweat a lot</li>
                <li>Don’t wait until you feel very thirsty</li>
              </ul>
            </div>

            <div class="na-food-box">
              <h4>Flavor without overdoing sugar</h4>
              <ul>
                <li>Greek yogurt + a little honey or sugar if needed</li>
                <li>Cinnamon, berries or cocoa</li>
                <li>Fruit paired with protein</li>
                <li>Choose sweetness on purpose, not by habit</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="na-tab-panel" data-panel="protein">
          <h3 class="na-section-title">Protein <span class="na-highlight">planner</span></h3>
          <div class="na-tip-list" id="proteinTips"></div>

          <div class="na-protein-builder">
            <h4>Build your daily protein target</h4>
            <p>
              Pick how many standard portions you expect to eat today. We’ll total your protein and tell you if you already hit your goal.
            </p>

            <div class="na-protein-items" id="proteinBuilderItems"></div>

            <div class="na-protein-summary">
              <div class="na-protein-summary-box">
                <strong id="proteinBuilderTarget">—</strong>
                <span>Target protein</span>
              </div>
              <div class="na-protein-summary-box">
                <strong id="proteinBuilderCurrent">0g</strong>
                <span>Planned protein</span>
              </div>
              <div class="na-protein-summary-box">
                <strong id="proteinBuilderRemaining">—</strong>
                <span>Remaining</span>
              </div>
            </div>

            <div class="na-protein-goal-box" id="proteinGoalMessage">
              Build your plan above and we’ll show how close you are to your daily protein target.
            </div>

            <div class="na-helper-note">
              Example: 2 eggs + 8 oz chicken + 2 scoops soy protein + 1 tuna can. This makes it easier for your client to think in real portions, not just abstract grams.
            </div>
          </div>
        </div>

        <div class="na-tab-panel" data-panel="energy">
          <h3 class="na-section-title">Energy, sugar and <span class="na-highlight">stability</span></h3>
          <div class="na-tip-list" id="energyTips"></div>
        </div>

        <div class="na-tab-panel" data-panel="caffeine">
          <h3 class="na-section-title">Caffeine <span class="na-highlight">guide</span></h3>
          <div class="na-tip-list" id="caffeineTips"></div>
        </div>

        <div class="na-tab-panel" data-panel="fasting">
          <h3 class="na-section-title">Intermittent fasting <span class="na-highlight">guide</span></h3>

          <div class="na-fast-grid">
            <div class="na-fast-box">
              <h5>12 hours</h5>
              <p>A simple overnight fast. Often the easiest starting point for routine and digestion.</p>
            </div>
            <div class="na-fast-box">
              <h5>14 hours</h5>
              <p>A moderate extension of overnight fasting that some people find easier than jumping directly to 16.</p>
            </div>
            <div class="na-fast-box">
              <h5>16 hours</h5>
              <p>The most common time-restricted eating setup. Useful for structure, but not required for fat loss.</p>
            </div>
            <div class="na-fast-box">
              <h5>18 hours</h5>
              <p>More restrictive. Better for experienced users who tolerate fasting well and still hit nutrition targets.</p>
            </div>
            <div class="na-fast-box">
              <h5>24 hours</h5>
              <p>Advanced and not necessary for most people. Can be hard to sustain and may reduce training quality or overeating control later.</p>
            </div>
            <div class="na-fast-box">
              <h5>36 hours</h5>
              <p>Very aggressive. Not something to normalize casually. Recovery, hunger, medication and health context matter a lot here.</p>
            </div>
          </div>

          <div class="na-tip-list mt-4">
            <div class="na-tip"><strong>What fasting can help with:</strong> routine, fewer eating decisions, some people’s appetite control, and a cleaner eating window.</div>
            <div class="na-tip"><strong>What fasting does not replace:</strong> calorie balance, enough protein, enough fiber, hydration, and food quality.</div>
            <div class="na-tip"><strong>Best practical rule:</strong> if fasting makes you binge later, feel weak, or miss your protein goal, it may not be the right tool for you.</div>
          </div>

          <div class="na-warning">
            <strong>Use extra caution:</strong> avoid fasting or get professional guidance first if you are pregnant, breastfeeding, underweight, have a history of eating disorders, diabetes, frequent dizziness, or use medication that affects blood sugar.
          </div>
        </div>

        <div class="na-tab-panel" data-panel="plan">
          <h3 class="na-section-title">Copy your <span class="na-highlight">daily plan</span></h3>

          <div class="na-copy-box">
            <textarea id="copyPlanOutput" class="na-copy-output" readonly>Fill in your information and your plan will appear here.</textarea>
          </div>

          <div class="na-copy-actions">
            <button type="button" class="na-soft-btn" id="copyPlanBtn">
              <i class="fa-solid fa-copy"></i> Copy to Notes
            </button>

            <a href="{{ path('/meal-plans') }}" class="na-main-btn">
              <i class="fa-solid fa-cart-shopping"></i> View Suggested Meals
            </a>
          </div>

          <div class="na-success" id="copySuccessBox">
            Your plan was copied. Paste it into your notes and use it as your daily routine.
          </div>
        </div>
      </div>
    </div>
  </section>

</main>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const form = document.getElementById('nutritionAdvisorForm');

  const resCalories = document.getElementById('resCalories');
  const resProtein = document.getElementById('resProtein');
  const resWater = document.getElementById('resWater');
  const resFiber = document.getElementById('resFiber');

  const overviewTips = document.getElementById('overviewTips');
  const proteinTips = document.getElementById('proteinTips');
  const energyTips = document.getElementById('energyTips');
  const caffeineTips = document.getElementById('caffeineTips');
  const copyPlanOutput = document.getElementById('copyPlanOutput');
  const copyPlanBtn = document.getElementById('copyPlanBtn');
  const copySuccessBox = document.getElementById('copySuccessBox');

  const proteinBuilderItems = document.getElementById('proteinBuilderItems');
  const proteinBuilderTarget = document.getElementById('proteinBuilderTarget');
  const proteinBuilderCurrent = document.getElementById('proteinBuilderCurrent');
  const proteinBuilderRemaining = document.getElementById('proteinBuilderRemaining');
  const proteinGoalMessage = document.getElementById('proteinGoalMessage');

  const tabButtons = document.querySelectorAll('.na-tab-btn');
  const tabPanels = document.querySelectorAll('.na-tab-panel');

  let currentPlanData = null;

  const proteinFoods = [
    {
      key: 'eggs',
      title: 'Eggs',
      portionLabel: '1 egg',
      proteinPerPortion: 6
    },
    {
      key: 'chicken',
      title: 'Chicken breast',
      portionLabel: '4 oz cooked',
      proteinPerPortion: 35
    },
    {
      key: 'turkey',
      title: 'Turkey breast',
      portionLabel: '4 oz cooked',
      proteinPerPortion: 34
    },
    {
      key: 'tuna',
      title: 'Tuna can',
      portionLabel: '1 can (5 oz drained)',
      proteinPerPortion: 30
    },
    {
      key: 'greek_yogurt',
      title: 'Greek yogurt',
      portionLabel: '1 cup',
      proteinPerPortion: 20
    },
    {
      key: 'cottage_cheese',
      title: 'Cottage cheese',
      portionLabel: '1 cup',
      proteinPerPortion: 25
    },
    {
      key: 'tofu',
      title: 'Tofu',
      portionLabel: '6 oz',
      proteinPerPortion: 18
    },
    {
      key: 'soy_protein',
      title: 'Soy protein powder',
      portionLabel: '1 scoop',
      proteinPerPortion: 20
    },
    {
      key: 'beans_rice',
      title: 'Beans + rice',
      portionLabel: '1 combined cup',
      proteinPerPortion: 10
    },
    {
      key: 'lentils',
      title: 'Lentils',
      portionLabel: '1 cup cooked',
      proteinPerPortion: 18
    }
  ];

  tabButtons.forEach(btn => {
    btn.addEventListener('click', function () {
      const target = this.dataset.tab;
      tabButtons.forEach(b => b.classList.remove('active'));
      tabPanels.forEach(p => p.classList.remove('active'));
      this.classList.add('active');
      const panel = document.querySelector(`.na-tab-panel[data-panel="${target}"]`);
      if (panel) panel.classList.add('active');
    });
  });

  function round(value) {
    return Math.round(value);
  }

  function poundsToKg(lb) {
    return lb * 0.45359237;
  }

  function feetInchesToCm(feet, inches) {
    return ((feet * 12) + inches) * 2.54;
  }

  function formatHeight(feet, inches) {
    return `${feet}'${inches}"`;
  }

  function activityFactor(level) {
    switch (level) {
      case 'sedentary': return 1.2;
      case 'light': return 1.375;
      case 'moderate': return 1.55;
      case 'active': return 1.725;
      case 'very_active': return 1.9;
      default: return 1.2;
    }
  }

  function getGoalTitle(goal) {
    switch (goal) {
      case 'fat_loss': return 'Fat loss';
      case 'maintain': return 'Maintenance';
      case 'muscle_gain': return 'Muscle gain';
      case 'recomp': return 'Body recomposition';
      case 'healthy_lifestyle': return 'Healthy lifestyle';
      case 'more_energy': return 'More energy';
      default: return 'General wellness';
    }
  }

  function getProteinFactor(goal, age) {
    let factor = 1.6;

    switch (goal) {
      case 'fat_loss':
        factor = 2.0;
        break;
      case 'maintain':
        factor = 1.7;
        break;
      case 'muscle_gain':
        factor = 2.1;
        break;
      case 'recomp':
        factor = 2.0;
        break;
      case 'healthy_lifestyle':
        factor = 1.6;
        break;
      case 'more_energy':
        factor = 1.7;
        break;
    }

    if (age >= 50) {
      factor += 0.2;
    }

    return factor;
  }

  function calculateCalories(gender, age, heightCm, weightKg, goal, activity) {
    let bmr = 0;

    if (gender === 'male') {
      bmr = (10 * weightKg) + (6.25 * heightCm) - (5 * age) + 5;
    } else {
      bmr = (10 * weightKg) + (6.25 * heightCm) - (5 * age) - 161;
    }

    const maintenance = bmr * activityFactor(activity);
    let target = maintenance;

    switch (goal) {
      case 'fat_loss':
        target = maintenance - 400;
        break;
      case 'muscle_gain':
        target = maintenance + 300;
        break;
      case 'recomp':
        target = maintenance - 150;
        break;
      case 'healthy_lifestyle':
        target = maintenance;
        break;
      case 'more_energy':
        target = maintenance;
        break;
      default:
        target = maintenance;
    }

    if (target < 1200) target = 1200;

    return {
      maintenance: round(maintenance),
      target: round(target)
    };
  }

  function buildOverviewTips(data) {
    const tips = [];

    tips.push(`Your estimated maintenance intake is about <strong>${data.maintenance} kcal/day</strong>, and your suggested daily target for <strong>${data.goalTitle}</strong> is <strong>${data.targetCalories} kcal/day</strong>.`);
    tips.push(`You entered <strong>${data.heightText}</strong> and <strong>${data.weightLb} lb</strong>, so everything below is now calculated with U.S.-friendly measurements in mind.`);

    if (data.goal === 'fat_loss') {
      tips.push(`<strong>Fat loss rule:</strong> only a real calorie deficit drives body-fat loss. Protein, fiber and routine make that deficit easier to sustain.`);
      tips.push(`<strong>Hunger control:</strong> hitting your protein goal early in the day can help with satiety and reduce random cravings later.`);
      tips.push(`<strong>Practical focus:</strong> drink more calories less often, build meals around protein first, and walk when possible.`);
    }

    if (data.goal === 'muscle_gain') {
      tips.push(`<strong>Muscle gain rule:</strong> you need enough calories, enough protein and progressive training. More food alone is not the goal — better recovery and stimulus are.`);
      tips.push(`<strong>Meal structure:</strong> spreading protein across the day usually works better than trying to hit it all at once.`);
    }

    if (data.goal === 'maintain') {
      tips.push(`<strong>Maintenance goal:</strong> aim for consistency, stable meal structure and enough protein so your routine feels sustainable, not exhausting.`);
    }

    if (data.goal === 'recomp') {
      tips.push(`<strong>Recomposition:</strong> think high protein, better food quality, smart training and patience. Progress is often slower but cleaner.`);
    }

    if (data.goal === 'healthy_lifestyle') {
      tips.push(`<strong>Healthy lifestyle:</strong> your best result comes from eating in a way you can repeat. Routine beats perfection.`);
    }

    if (data.goal === 'more_energy') {
      tips.push(`<strong>More energy:</strong> many people feel better with steadier meals, enough water, enough protein and less dependence on sugar spikes or excessive caffeine.`);
    }

    if (data.age >= 50) {
      tips.push(`<strong>Age matters:</strong> preserving muscle becomes more important over time, so protein consistency and some kind of resistance work become even more valuable.`);
    }

    return tips;
  }

  function buildProteinTips(data) {
    const tips = [];

    tips.push(`<strong>Your protein target:</strong> about <strong>${data.proteinGrams}g per day</strong>.`);
    tips.push(`<strong>Simple structure:</strong> try to split protein across 3–4 eating moments instead of leaving it all for dinner.`);
    tips.push(`<strong>Easy examples with standard portions:</strong> 1 egg = 6g, 4 oz chicken breast = 35g, 1 tuna can = 30g, 1 cup Greek yogurt = 20g, 1 scoop soy protein = 20g.`);
    tips.push(`<strong>Helpful reminder:</strong> protein supports satiety. Many people find that when protein is too low, cravings and anxiety around food get worse.`);
    tips.push(`<strong>Taste tip:</strong> Greek yogurt can be made easier to enjoy with berries, cinnamon, cocoa, or even a little sugar if that helps consistency without turning it into dessert overload.`);

    if (data.goal === 'fat_loss') {
      tips.push(`<strong>For fat loss:</strong> protein is one of your best tools for feeling fuller while protecting lean mass during a deficit.`);
    }

    if (data.goal === 'muscle_gain' || data.goal === 'recomp') {
      tips.push(`<strong>For muscle-focused goals:</strong> your training quality matters, but your body also needs repeated protein exposure across the week to recover well.`);
    }

    if (data.age >= 50) {
      tips.push(`<strong>For older adults:</strong> getting enough protein regularly becomes especially important for muscle retention and function.`);
    }

    return tips;
  }

  function buildEnergyTips(data) {
    const tips = [];

    tips.push(`<strong>Sugar awareness:</strong> fast sugar can raise energy quickly, but for many people it is followed by a drop in alertness, more hunger, or sleepiness later.`);
    tips.push(`<strong>Better stability:</strong> meals built around protein + fiber usually feel steadier than meals based mostly on refined carbs or sweets.`);
    tips.push(`<strong>Added sugar ceiling:</strong> a practical upper limit is about <strong>${data.addedSugarCapGrams}g/day</strong> for your calorie level, and often less feels better in real life.`);
    tips.push(`<strong>Fiber target:</strong> try to reach <strong>${data.fiberGrams}g/day</strong> with oats, beans, lentils, fruit, vegetables, chia and whole grains.`);
    tips.push(`<strong>Hydration target:</strong> aim for about <strong>${data.waterLiters} L/day</strong>, which is about <strong>${data.waterOz} fl oz/day</strong>.`);

    if (data.goal === 'more_energy') {
      tips.push(`<strong>Energy goal:</strong> your best play is steady meals, hydration, protein, and less reliance on sugar spikes to “save” a tired day.`);
    }

    return tips;
  }

  function buildCaffeineTips(data) {
    const tips = [];

    tips.push(`<strong>General limit:</strong> for most healthy adults, staying at or below <strong>400 mg/day</strong> is a common upper guideline.`);
    tips.push(`<strong>Better use:</strong> caffeine works best as a focus tool, not as a replacement for sleep, food quality or hydration.`);
    tips.push(`<strong>Cutoff rule:</strong> many people do better stopping caffeine about <strong>6–8 hours before bed</strong>.`);
    tips.push(`<strong>If you feel anxious or wired:</strong> try reducing total dose, spacing it earlier, and not stacking coffee on top of poor sleep and low food intake.`);

    if (data.sleepTimeText) {
      tips.push(`<strong>Your bedtime note:</strong> if you usually sleep around <strong>${data.sleepTimeText}</strong>, try making your last strong caffeine earlier in the day.`);
    }

    return tips;
  }

  function getProteinBuilderBreakdown() {
    return proteinFoods
      .map(food => {
        const input = document.querySelector(`.na-protein-qty[data-food="${food.key}"]`);
        const qty = input ? parseFloat(input.value || '0') : 0;
        const protein = qty * food.proteinPerPortion;

        return {
          title: food.title,
          qty,
          portionLabel: food.portionLabel,
          protein
        };
      })
      .filter(item => item.qty > 0);
  }

  function buildCopyPlan(data) {
    const mealTimingLine = data.sleepTimeText
      ? `Last meal idea: try to finish your last bigger meal about 2–3 hours before bed when possible.`
      : `Last meal idea: try not to leave your heaviest meal too close to bedtime if digestion or sleep suffers.`;

    const proteinBreakdown = getProteinBuilderBreakdown();
    const proteinLines = proteinBreakdown.length
      ? proteinBreakdown.map(item => `- ${item.qty} x ${item.title} (${item.portionLabel}) = ${round(item.protein)} g protein`).join('\n')
      : `- No custom protein portions selected yet`;

    return [
      `My Avomeal Daily Plan`,
      ``,
      `Goal: ${data.goalTitle}`,
      `Height: ${data.heightText}`,
      `Current weight: ${data.weightLb} lb`,
      `${data.goalWeightLb ? `Goal weight: ${data.goalWeightLb} lb` : `Goal weight: not specified`}`,
      `Calories: ${data.targetCalories} kcal/day`,
      `Protein: ${data.proteinGrams} g/day`,
      `Water: ${data.waterLiters} L/day (${data.waterOz} fl oz/day)`,
      `Fiber: ${data.fiberGrams} g/day`,
      `Added sugar awareness: try to stay under about ${data.addedSugarCapGrams} g/day, and often less feels better.`,
      `Caffeine: keep it moderate and preferably under 400 mg/day.`,
      ``,
      `Main focus today:`,
      `- Hit protein first`,
      `- Build meals around protein + fiber`,
      `- Drink water early in the day`,
      `- Don’t rely on sugar spikes for energy`,
      `- ${mealTimingLine}`,
      ``,
      `My protein plan today:`,
      proteinLines,
      ``,
      `Helpful standard portions:`,
      `- 1 egg = 6g protein`,
      `- 4 oz chicken breast = 35g protein`,
      `- 1 tuna can = 30g protein`,
      `- 1 cup Greek yogurt = 20g protein`,
      `- 1 scoop soy protein = 20g protein`,
      ``,
      `Reminder: consistency beats perfection.`
    ].join('\n');
  }

  function renderTipList(container, items) {
    container.innerHTML = items.map(item => `<div class="na-tip">${item}</div>`).join('');
  }

  function renderProteinBuilder() {
    proteinBuilderItems.innerHTML = proteinFoods.map(food => `
      <div class="na-protein-item">
        <div>
          <div class="na-protein-item-title">${food.title}</div>
          <div class="na-protein-item-meta">${food.portionLabel} = about ${food.proteinPerPortion}g protein</div>
        </div>
        <div>
          <input
            type="number"
            min="0"
            step="1"
            value="0"
            class="na-protein-qty"
            data-food="${food.key}"
          >
        </div>
      </div>
    `).join('');

    document.querySelectorAll('.na-protein-qty').forEach(input => {
      input.addEventListener('input', updateProteinBuilder);
    });
  }

  function updateProteinBuilder() {
    const target = currentPlanData ? currentPlanData.proteinGrams : 0;

    let totalProtein = 0;

    proteinFoods.forEach(food => {
      const input = document.querySelector(`.na-protein-qty[data-food="${food.key}"]`);
      const qty = input ? parseFloat(input.value || '0') : 0;
      totalProtein += qty * food.proteinPerPortion;
    });

    totalProtein = round(totalProtein);
    const remaining = Math.max(target - totalProtein, 0);

    proteinBuilderTarget.textContent = target ? `${target}g` : '—';
    proteinBuilderCurrent.textContent = `${totalProtein}g`;
    proteinBuilderRemaining.textContent = target ? `${remaining}g` : '—';

    if (!target) {
      proteinGoalMessage.classList.remove('success');
      proteinGoalMessage.textContent = 'Build your plan above and we’ll show how close you are to your daily protein target.';
      return;
    }

    if (totalProtein >= target) {
      proteinGoalMessage.classList.add('success');
      proteinGoalMessage.innerHTML = `<strong>You already reached your daily protein goal.</strong> Great job — your current protein plan is at <strong>${totalProtein}g</strong>, which meets or exceeds your target of <strong>${target}g</strong>.`;
    } else {
      proteinGoalMessage.classList.remove('success');
      proteinGoalMessage.innerHTML = `You are at <strong>${totalProtein}g</strong> so far. You still need about <strong>${remaining}g</strong> to reach your daily protein goal of <strong>${target}g</strong>.`;
    }

    if (currentPlanData) {
      copyPlanOutput.value = buildCopyPlan(currentPlanData);
    }
  }

  renderProteinBuilder();
  updateProteinBuilder();

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    copySuccessBox.style.display = 'none';

    const gender = document.getElementById('na_gender').value;
    const age = parseInt(document.getElementById('na_age').value || '0', 10);

    const heightFt = parseInt(document.getElementById('na_height_ft').value || '0', 10);
    const heightIn = parseInt(document.getElementById('na_height_in').value || '0', 10);
    const weightLb = parseFloat(document.getElementById('na_weight_lb').value || '0');

    const goal = document.getElementById('na_goal').value;
    const activity = document.getElementById('na_activity').value;
    const goalWeightLb = parseFloat(document.getElementById('na_goal_weight_lb').value || '0');
    const sleepTime = document.getElementById('na_sleep_hour').value || '';

    if (!gender || !age || !heightFt && heightFt !== 0 || heightIn < 0 || !weightLb || !goal || !activity) {
      return;
    }

    if (heightIn > 11) {
      return;
    }

    const heightCm = feetInchesToCm(heightFt, heightIn);
    const weightKg = poundsToKg(weightLb);
    const goalWeightKg = goalWeightLb ? poundsToKg(goalWeightLb) : 0;

    const calories = calculateCalories(gender, age, heightCm, weightKg, goal, activity);
    const proteinFactor = getProteinFactor(goal, age);
    const proteinGrams = round(weightKg * proteinFactor);
    const waterLiters = (Math.round((weightKg * 0.033) * 10) / 10).toFixed(1);
    const waterOz = round(parseFloat(waterLiters) * 33.814);
    const fiberGrams = round((calories.target / 1000) * 14);
    const addedSugarCapGrams = round((calories.target * 0.10) / 4);
    const goalTitle = getGoalTitle(goal);

    const data = {
      gender,
      age,
      heightFt,
      heightIn,
      heightCm,
      heightText: formatHeight(heightFt, heightIn),
      weightLb: round(weightLb),
      weightKg,
      goal,
      goalTitle,
      activity,
      goalWeightLb: goalWeightLb ? round(goalWeightLb) : 0,
      goalWeightKg,
      maintenance: calories.maintenance,
      targetCalories: calories.target,
      proteinGrams,
      waterLiters,
      waterOz,
      fiberGrams,
      addedSugarCapGrams,
      sleepTimeText: sleepTime || ''
    };

    currentPlanData = data;

    resCalories.textContent = `${data.targetCalories}`;
    resProtein.textContent = `${data.proteinGrams}g`;
    resWater.textContent = `${data.waterOz} oz`;
    resFiber.textContent = `${data.fiberGrams}g`;

    renderTipList(overviewTips, buildOverviewTips(data));
    renderTipList(proteinTips, buildProteinTips(data));
    renderTipList(energyTips, buildEnergyTips(data));
    renderTipList(caffeineTips, buildCaffeineTips(data));

    copyPlanOutput.value = buildCopyPlan(data);
    updateProteinBuilder();

    document.getElementById('naResultsCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  copyPlanBtn.addEventListener('click', async function () {
    copySuccessBox.style.display = 'none';

    try {
      await navigator.clipboard.writeText(copyPlanOutput.value);
      copySuccessBox.style.display = 'block';
    } catch (e) {
      copyPlanOutput.select();
      document.execCommand('copy');
      copySuccessBox.style.display = 'block';
    }
  });
});
</script>
{% endblock %}
