{% extends 'templates/base.admin.twig' %}

{% set show_whatsapp = true %}

{% block body %}
<main class="vnv-client-home mt-4 container pb-5">

  <style>
    :root{
      --vnv-primary:#5EC6C4;
      --vnv-primary-dark:#49acab;
      --vnv-gold:#D4A84F;
      --vnv-gold-soft:rgba(212,168,79,.14);
      --vnv-black:#0B0B0C;
      --vnv-black-soft:#111214;
      --vnv-black-card:#15181a;
      --vnv-border:rgba(255,255,255,.08);
      --vnv-text:#F6F1E8;
      --vnv-text-muted:#B5ADA3;
      --vnv-light-card:#F7F3ED;
      --vnv-shadow:0 20px 54px rgba(0,0,0,.16);
      --vnv-shadow-soft:0 18px 42px rgba(0,0,0,.10);
    }

    .vnv-client-home{
      color:var(--vnv-text);
    }

    .vnv-badge{
      display:inline-flex;
      align-items:center;
      gap:.5rem;
      border-radius:999px;
      padding:.58rem .95rem;
      font-size:.82rem;
      font-weight:900;
      letter-spacing:1.2px;
      text-transform:uppercase;
      background:rgba(94,198,196,.12);
      border:1px solid rgba(94,198,196,.22);
      color:var(--vnv-primary);
    }

    .vnv-hero{
      position:relative;
      overflow:hidden;
      border-radius:30px;
      padding:2rem 1.8rem;
      color:#fff;
      background:
        radial-gradient(900px 420px at 0% 0%, rgba(94,198,196,.16), transparent 60%),
        radial-gradient(260px 260px at 100% 0%, rgba(212,168,79,.12), transparent 72%),
        linear-gradient(135deg, #0B0B0C 0%, #111214 55%, #191c1f 100%);
      box-shadow:var(--vnv-shadow);
      margin-bottom:2rem;
    }

    .vnv-hero:after{
      content:"";
      position:absolute;
      right:-70px;
      top:-70px;
      width:220px;
      height:220px;
      background:radial-gradient(circle, rgba(255,255,255,.08) 0%, rgba(255,255,255,0) 70%);
      pointer-events:none;
    }

    .vnv-hero > *{
      position:relative;
      z-index:2;
    }

    .vnv-hero-logo{
      max-width:92px;
      margin:1rem 0 .95rem;
      filter:drop-shadow(0 8px 20px rgba(0,0,0,.20));
    }

    .vnv-hero h1{
      font-size:clamp(2rem,4vw,3.05rem);
      line-height:1.04;
      font-weight:900;
      letter-spacing:-1px;
      margin-bottom:.8rem;
      max-width:860px;
    }

    .vnv-hero h1 .gold{
      color:var(--vnv-gold);
    }

    .vnv-hero p{
      max-width:760px;
      color:#ddd5ca;
      line-height:1.76;
      font-size:1rem;
      margin-bottom:1.2rem;
    }

    .vnv-hero-actions{
      display:flex;
      flex-wrap:wrap;
      gap:.85rem;
      margin-top:1rem;
    }

    .btn-vnv-main{
      background:linear-gradient(135deg, #DDB45D 0%, #D4A84F 50%, #e5c277 100%);
      color:#081011 !important;
      padding:1rem 1.55rem;
      font-size:1rem;
      border-radius:999px;
      text-decoration:none;
      font-weight:900;
      display:inline-flex;
      gap:.55rem;
      align-items:center;
      justify-content:center;
      border:none;
      box-shadow:0 12px 28px rgba(212,168,79,.25);
      transition:all .22s ease;
    }

    .btn-vnv-main:hover{
      transform:translateY(-2px);
    }

    .btn-vnv-light{
      padding:.92rem 1.25rem;
      font-size:1rem;
      border-radius:999px;
      font-weight:800;
      border:1.2px solid rgba(255,255,255,.18);
      color:#fff !important;
      background:rgba(255,255,255,.07);
      text-decoration:none;
      display:inline-flex;
      align-items:center;
      gap:.45rem;
      justify-content:center;
      backdrop-filter:blur(6px);
      transition:all .2s ease;
    }

    .btn-vnv-light:hover{
      background:rgba(255,255,255,.14);
      transform:translateY(-1px);
    }

    .vnv-section-head{
      margin-bottom:1.15rem;
    }

    .vnv-title{
      font-weight:900;
      font-size:clamp(1.6rem,3vw,2.3rem);
      line-height:1.12;
      letter-spacing:-.5px;
      margin-bottom:.5rem;
      color:#15181a;
    }

    .vnv-title .highlight{
      color:#247170;
    }

    .vnv-subtitle{
      color:#69787b;
      font-size:1rem;
      line-height:1.75;
      margin-bottom:0;
      max-width:760px;
    }

    .vnv-main-card{
      background:#fff;
      padding:1.8rem 1.35rem;
      border-radius:24px;
      box-shadow:var(--vnv-shadow-soft);
      border:1px solid rgba(17,24,26,.06);
      height:100%;
      transition:all .22s ease;
      text-align:center;
    }

    .vnv-main-card:hover{
      transform:translateY(-4px);
      box-shadow:0 24px 54px rgba(0,0,0,.10);
    }

    .vnv-main-card i.big-icon{
      font-size:2rem;
      color:#247170;
      margin-bottom:.95rem;
    }

    .vnv-main-card h3{
      font-size:1.24rem;
      font-weight:900;
      margin-bottom:.65rem;
      color:#141a1b;
    }

    .vnv-main-card p{
      color:#6b7a7d;
      line-height:1.68;
      margin-bottom:1rem;
    }

    .vnv-link-btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:.45rem;
      padding:.82rem 1.15rem;
      border-radius:999px;
      font-weight:900;
      text-decoration:none;
      background:#eef8f8;
      color:#1f6e6d;
      border:1px solid #d7ecec;
      transition:all .2s ease;
    }

    .vnv-link-btn:hover{
      background:#def3f2;
      color:#145958;
      transform:translateY(-1px);
    }

    .vnv-mini-row{
      display:grid;
      grid-template-columns:repeat(5, 1fr);
      gap:1rem;
      margin-top:1.2rem;
    }

    .vnv-mini-card{
      background:#14181a;
      border:1px solid rgba(255,255,255,.08);
      border-radius:22px;
      padding:1.1rem .9rem;
      text-align:center;
      text-decoration:none;
      color:#fff !important;
      transition:all .22s ease;
      box-shadow:0 14px 34px rgba(0,0,0,.10);
    }

    .vnv-mini-card:hover{
      transform:translateY(-3px);
      border-color:rgba(94,198,196,.22);
    }

    .vnv-mini-card i{
      font-size:1.25rem;
      color:var(--vnv-gold);
      margin-bottom:.7rem;
      display:block;
    }

    .vnv-mini-card span{
      display:block;
      font-size:.95rem;
      font-weight:800;
      line-height:1.4;
      color:#f6f1e8;
    }

    .vnv-contact-row{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:1rem;
      margin-top:1.4rem;
    }

    .vnv-contact-card{
      background:#14181a;
      border:1px solid rgba(255,255,255,.08);
      border-radius:24px;
      padding:1.2rem 1rem;
      color:#fff;
      text-decoration:none !important;
      box-shadow:0 14px 34px rgba(0,0,0,.10);
      transition:all .22s ease;
    }

    .vnv-contact-card:hover{
      transform:translateY(-3px);
      border-color:rgba(212,168,79,.24);
      color:#fff;
    }

    .vnv-contact-badge{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:.45rem .8rem;
      border-radius:999px;
      background:var(--vnv-gold-soft);
      color:var(--vnv-gold);
      font-size:.72rem;
      font-weight:900;
      letter-spacing:1px;
      margin-bottom:.8rem;
    }

    .vnv-contact-card h3{
      font-size:1.2rem;
      font-weight:900;
      margin-bottom:.35rem;
      color:#fff;
    }

    .vnv-contact-card p{
      margin:0;
      color:#d2cbc0;
      line-height:1.65;
      font-size:.94rem;
    }

    .vnv-final{
      margin-top:2rem;
      background:linear-gradient(135deg,#121516 0%, #1b2022 100%);
      color:#fff;
      border-radius:26px;
      padding:2rem 1.3rem;
      box-shadow:0 20px 50px rgba(0,0,0,.16);
      text-align:center;
    }

    .vnv-final p{
      max-width:720px;
      margin:0 auto 1.2rem;
      color:#d5cec3;
      font-size:1rem;
      line-height:1.75;
    }

    @media (max-width: 991px){
      .vnv-mini-row{
        grid-template-columns:repeat(2,1fr);
      }

      .vnv-contact-row{
        grid-template-columns:1fr;
      }
    }

    @media (max-width: 768px){
      .vnv-hero{
        padding:1.4rem 1.05rem;
        border-radius:22px;
      }

      .vnv-main-card,
      .vnv-final,
      .vnv-mini-card,
      .vnv-contact-card{
        border-radius:20px;
      }

      .vnv-hero-actions{
        flex-direction:column;
      }

      .btn-vnv-main,
      .btn-vnv-light{
        width:100%;
      }

      .vnv-mini-row{
        grid-template-columns:1fr 1fr;
      }
    }

    .vnv-hero h1{
  font-size:clamp(2rem,4vw,3.15rem);
  line-height:1.04;
  font-weight:900;
  letter-spacing:-1px;
  margin-bottom:.8rem;
  max-width:860px;
  color:#fff; /* 🔥 ESTE ES EL FIX */
}
  </style>

  <section class="vnv-hero">
    <span class="vnv-badge">
      <i class="fa-solid fa-gem"></i> VNV Client
    </span>

    <div>
      <img src="{{ asset_for('assets/images/planner-hub-logo-positive.png') }}" class="vnv-hero-logo" alt="VNV Events Logo">
    </div>

    <h1>
      Welcome back{% if user.name is defined and user.name %}, {{ user.name }}{% endif %}. <span class="gold">A more beautiful way to plan your experience.</span>
    </h1>

    <p>
      Review your active orders first, then explore sessions, event request tools and direct support in one polished VNV client experience.
    </p>

    <div class="vnv-hero-actions">
      <a href="{{ path('panel/planner-hub/orders/orders') }}" class="btn-vnv-main">
        <i class="fa-solid fa-file-invoice"></i> View Orders
      </a>

      <a href="{{ path('search/multimedia-sessions/main') }}" class="btn-vnv-light">
        <i class="fa-solid fa-music"></i> Music Sessions
      </a>
    </div>
  </section>

  <section>
    <div class="vnv-section-head">
      <h2 class="vnv-title">
        What matters <span class="highlight">most</span>
      </h2>
      <p class="vnv-subtitle">
        Your key client areas, prioritized around the new VNV client flow.
      </p>
    </div>

    <div class="row g-4">
      <div class="col-md-4">
        <div class="vnv-main-card">
          <i class="fa-solid fa-file-lines big-icon"></i>
          <h3>Pending Orders</h3>
          <p>
            Review your active or upcoming event orders first, along with the details that matter most right now.
          </p>
          <a href="{{ path('panel/planner-hub/orders/orders') }}" class="vnv-link-btn">
            View Orders <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>

      <div class="col-md-4">
        <div class="vnv-main-card">
          <i class="fa-solid fa-headphones big-icon"></i>
          <h3>Music Sessions</h3>
          <p>
            Open your VNV music sessions and enjoy curated content designed to complement the brand experience.
          </p>
          <a href="{{ path('search/multimedia-sessions/main') }}" class="vnv-link-btn">
            Open Sessions <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>

      <div class="col-md-4">
        <div class="vnv-main-card">
          <i class="fa-solid fa-wand-magic-sparkles big-icon"></i>
          <h3>Plan Your Event</h3>
          <p>
            Start a new request and send us the essentials quickly so the team can guide your next event with more precision.
          </p>
          <a href="#" data-vnv-open-request class="vnv-link-btn">
            Start Planning <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-5">
    <div class="vnv-section-head">
      <h2 class="vnv-title">
        Visit, call or <span class="highlight">explore</span>
      </h2>
      <p class="vnv-subtitle">
        Use our planning tools, visit the office or reach us directly whenever you need support.
      </p>
    </div>

    <div class="vnv-mini-row">
      <a href="{{ path('panel/planning-tools') }}" class="vnv-mini-card">
        <i class="fa-solid fa-compass-drafting"></i>
        <span>Planner Tools</span>
      </a>

      <a href="https://maps.google.com/?q=10258+NW+47th+St,+Sunrise,+FL+33351" class="vnv-mini-card">
        <i class="fa-solid fa-location-dot"></i>
        <span>Visit Our Office</span>
      </a>

      <a href="tel:+13052045427" class="vnv-mini-card">
        <i class="fa-solid fa-phone"></i>
        <span>Call Us</span>
      </a>

      <a href="{{ path('panel/chat') }}" class="vnv-mini-card">
        <i class="fa-solid fa-comments"></i>
        <span>Chat</span>
      </a>

      <a href="{{ path('panel/settings') }}" class="vnv-mini-card">
        <i class="fa-solid fa-sliders"></i>
        <span>Settings</span>
      </a>
    </div>

    <div class="vnv-contact-row">
      <a href="https://maps.google.com/?q=10258+NW+47th+St,+Sunrise,+FL+33351" class="vnv-contact-card">
        <span class="vnv-contact-badge">Visit Us</span>
        <h3>10258 NW 47th St</h3>
        <p>Sunrise, FL 33351</p>
      </a>

      <a href="tel:+13052045427" class="vnv-contact-card">
        <span class="vnv-contact-badge">Call Us</span>
        <h3>+1 305-204-5427</h3>
        <p>Tap to call directly and speak with the team.</p>
      </a>
    </div>
  </section>

  <section class="vnv-final">
    <h2 class="vnv-title" style="color:#fff;">
      Need a new quote or event plan?
    </h2>
    <p>
      Start a new request here, visit our Sunrise office, or call us directly for more personalized help with your next event.
    </p>

    <div class="d-flex flex-wrap gap-3 justify-content-center">
      <a href="#" data-vnv-open-request class="btn-vnv-main">
        <i class="fa-solid fa-wand-magic-sparkles"></i> Plan Your Event
      </a>

      <a href="tel:+13052045427" class="btn-vnv-light">
        <i class="fa-solid fa-phone"></i> Call +1 305-204-5427
      </a>
    </div>
  </section>

</main>
{% endblock %}