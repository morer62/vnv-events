{% extends 'templates/base.admin.twig' %}

{% set show_whatsapp = true %}

{% block body %}
<main class="vnv-client-home container-fluid py-4">
  <style>
    .vnv-client-home {
      --vnv-teal: #45e3cf;
      --vnv-teal-dark: #087267;
      --vnv-gold: #d8ad45;
      --vnv-ink: #0b1012;
      --vnv-panel: #12191b;
      --vnv-muted: #627174;
      --vnv-line: rgba(13, 24, 27, .12);
      color: #0f1719;
    }

    .vnv-shell {
      max-width: 1280px;
      margin: 0 auto;
    }

    .vnv-client-hero {
      position: relative;
      overflow: hidden;
      border-radius: 28px;
      background:
        linear-gradient(110deg, rgba(8, 13, 15, .96), rgba(8, 13, 15, .78)),
        url("{{ path('/assets/images/vnv-core-brunch-mansion-hero.png') }}") center 44% / cover;
      color: #fff;
      padding: 34px;
      box-shadow: 0 28px 70px rgba(7, 15, 18, .18);
    }

    .vnv-client-hero h1 {
      max-width: 820px;
      margin: 16px 0 12px;
      color: #fff !important;
      font-size: clamp(32px, 4vw, 58px);
      font-weight: 900;
      line-height: 1;
      letter-spacing: 0;
      text-shadow: 0 10px 32px rgba(0, 0, 0, .38);
    }

    .vnv-client-hero p {
      max-width: 760px;
      margin: 0;
      color: rgba(255, 255, 255, .76);
      font-size: 16px;
      line-height: 1.8;
    }

    .vnv-kicker {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid rgba(69, 227, 207, .24);
      border-radius: 999px;
      background: rgba(69, 227, 207, .12);
      color: var(--vnv-teal);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: .12em;
      line-height: 1;
      padding: 10px 14px;
      text-transform: uppercase;
    }

    .vnv-hero-actions,
    .vnv-card-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 24px;
    }

    .vnv-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 46px;
      border-radius: 999px;
      border: 1px solid transparent;
      font-size: 13px;
      font-weight: 900;
      letter-spacing: .06em;
      padding: 0 18px;
      text-decoration: none;
      text-transform: uppercase;
    }

    .vnv-btn-primary {
      background: linear-gradient(135deg, #f1da86, var(--vnv-gold));
      color: #0b1012 !important;
    }

    .vnv-btn-ghost {
      border-color: rgba(255, 255, 255, .2);
      background: rgba(255, 255, 255, .08);
      color: #fff !important;
    }

    .vnv-section {
      margin-top: 28px;
    }

    .vnv-event-access {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 22px;
      align-items: center;
      margin-top: 20px;
      padding: 22px;
      border: 1px solid rgba(69, 227, 207, .38);
      border-radius: 22px;
      background: linear-gradient(135deg, #effdfa, #fff9e9);
      box-shadow: 0 18px 50px rgba(14, 31, 34, .08);
    }

    .vnv-event-access h2 { margin: 0 0 6px; font-size: 22px; font-weight: 900; }
    .vnv-event-access p { margin: 0; color: var(--vnv-muted); }
    .vnv-code-form { display: flex; gap: 10px; align-items: center; }
    .vnv-code-input {
      width: 150px;
      min-height: 50px;
      border: 2px solid #087267;
      border-radius: 14px;
      background: #fff;
      color: #101718;
      font-size: 22px;
      font-weight: 900;
      letter-spacing: .18em;
      text-align: center;
    }

    .vnv-section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 16px;
    }

    .vnv-section-head h2 {
      margin: 0;
      color: #101718;
      font-size: clamp(24px, 3vw, 38px);
      font-weight: 900;
      letter-spacing: 0;
    }

    .vnv-section-head p {
      margin: 6px 0 0;
      color: var(--vnv-muted);
      line-height: 1.7;
    }

    .vnv-stat-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
      margin-top: 24px;
    }

    .vnv-stat {
      display: block;
      border: 1px solid rgba(255, 255, 255, .1);
      border-radius: 20px;
      background: rgba(10, 16, 17, .78);
      padding: 18px;
      backdrop-filter: blur(10px);
      color: inherit;
      text-decoration: none;
      transition: transform .18s ease, border-color .18s ease;
    }

    .vnv-stat:hover {
      border-color: rgba(69, 227, 207, .36);
      color: inherit;
      transform: translateY(-2px);
    }

    .vnv-stat strong {
      display: block;
      color: var(--vnv-teal);
      font-size: 28px;
      font-weight: 900;
      line-height: 1;
    }

    .vnv-stat span {
      display: block;
      margin-top: 8px;
      color: rgba(255, 255, 255, .72);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .vnv-action-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .vnv-action-card,
    .vnv-nav-card,
    .vnv-list-card,
    .vnv-session-card {
      border: 1px solid var(--vnv-line);
      border-radius: 22px;
      background: rgba(255, 255, 255, .94);
      box-shadow: 0 18px 50px rgba(14, 31, 34, .08);
      overflow: hidden;
    }

    .vnv-action-card {
      padding: 20px;
    }

    .vnv-action-card.is-hot {
      border-color: rgba(216, 173, 69, .35);
      background: linear-gradient(145deg, #fff, #fff8e7);
    }

    .vnv-action-icon {
      width: 44px;
      height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
      background: rgba(69, 227, 207, .14);
      color: var(--vnv-teal-dark);
      font-size: 18px;
      margin-bottom: 16px;
    }

    .vnv-action-card h3,
    .vnv-nav-card h3,
    .vnv-session-card h3 {
      margin: 0 0 8px;
      color: #101718;
      font-size: 18px;
      font-weight: 900;
      line-height: 1.25;
    }

    .vnv-action-card p,
    .vnv-nav-card p,
    .vnv-session-card p {
      color: var(--vnv-muted);
      line-height: 1.65;
      margin: 0 0 14px;
    }

    .vnv-nav-card p,
    .vnv-section-head p,
    .vnv-client-hero p,
    .vnv-session-panel p {
      display: none;
    }

    .vnv-inline-link {
      color: var(--vnv-teal-dark);
      font-weight: 900;
      text-decoration: none;
    }

    .vnv-nav-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
    }

    .vnv-nav-card {
      display: block;
      padding: 18px;
      color: inherit;
      min-height: 132px;
      text-decoration: none;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .vnv-nav-card-button {
      width: 100%;
      text-align: left;
      border: 1px solid var(--vnv-line);
      cursor: pointer;
    }

    .vnv-nav-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 24px 58px rgba(14, 31, 34, .12);
      color: inherit;
    }

    .vnv-nav-card i {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 42px;
      height: 42px;
      margin-bottom: 14px;
      border-radius: 999px;
      background: #101718;
      color: var(--vnv-gold);
    }

    .vnv-two-col {
      display: grid;
      grid-template-columns: minmax(0, 1.12fr) minmax(320px, .88fr);
      gap: 18px;
      align-items: start;
    }

    .vnv-list-card {
      padding: 0;
    }

    .vnv-list-card__head {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: center;
      border-bottom: 1px solid var(--vnv-line);
      padding: 18px 20px;
    }

    .vnv-list-card__head h3 {
      margin: 0;
      font-size: 18px;
      font-weight: 900;
    }

    .vnv-list-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 16px;
      align-items: center;
      border-bottom: 1px solid rgba(13, 24, 27, .08);
      padding: 16px 20px;
    }

    .vnv-list-row:last-child {
      border-bottom: 0;
    }

    .vnv-list-row strong {
      display: block;
      color: #101718;
      font-weight: 900;
      line-height: 1.3;
    }

    .vnv-list-row span {
      display: block;
      margin-top: 4px;
      color: var(--vnv-muted);
      font-size: 13px;
      line-height: 1.4;
    }

    .vnv-balance {
      color: #9b6c00;
      font-weight: 900;
      white-space: nowrap;
    }

    .vnv-empty {
      padding: 22px;
      color: var(--vnv-muted);
      line-height: 1.7;
      text-align: center;
    }

    .vnv-session-panel {
      border-radius: 24px;
      background:
        linear-gradient(120deg, rgba(7, 12, 14, .94), rgba(7, 12, 14, .76)),
        url("{{ path('/assets/images/faq-event-answers-hero.png') }}") center / cover;
      color: #fff;
      padding: 22px;
      box-shadow: 0 22px 58px rgba(7, 15, 18, .16);
    }

    .vnv-session-panel h2 {
      margin: 12px 0 8px;
      color: #fff;
      font-size: clamp(28px, 3vw, 42px);
      font-weight: 900;
      line-height: 1;
    }

    .vnv-session-panel p {
      color: rgba(255, 255, 255, .74);
      line-height: 1.75;
    }

    .vnv-session-list {
      display: grid;
      gap: 10px;
      margin-top: 18px;
    }

    .vnv-session-item {
      border: 1px solid rgba(255, 255, 255, .12);
      border-radius: 16px;
      background: rgba(255, 255, 255, .08);
      padding: 14px;
      backdrop-filter: blur(8px);
    }

    .vnv-session-item strong {
      display: block;
      color: #fff;
      line-height: 1.35;
    }

    .vnv-session-item span {
      display: block;
      margin-top: 4px;
      color: var(--vnv-teal);
      font-size: 12px;
      font-weight: 900;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    @media (max-width: 1100px) {
      .vnv-action-grid,
      .vnv-nav-grid,
      .vnv-stat-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .vnv-two-col {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 700px) {
      .vnv-client-hero {
        padding: 24px 18px;
      }

      .vnv-action-grid,
      .vnv-nav-grid,
      .vnv-stat-grid {
        grid-template-columns: 1fr;
      }

      .vnv-section-head {
        display: block;
      }

      .vnv-list-row {
        grid-template-columns: 1fr;
      }

      .vnv-event-access { grid-template-columns: 1fr; }
      .vnv-code-form { align-items: stretch; flex-direction: column; }
      .vnv-code-input { width: 100%; }
    }
  </style>

  <div class="vnv-shell">
    <section class="vnv-client-hero">
      <span class="vnv-kicker"><i class="fa-solid fa-gem"></i> VNV Client Portal</span>
      <h1>Welcome back{% if user.name is defined and user.name %}, {{ user.name }}{% endif %}. Your event life, organized.</h1>
      <div class="vnv-hero-actions">
        <a class="vnv-btn vnv-btn-primary" href="{{ path('panel/planner-hub/orders/orders') }}">
          <i class="fa-solid fa-file-invoice"></i> Open Orders
        </a>
        <a class="vnv-btn vnv-btn-ghost" href="{{ path('panel/music-sessions') }}">
          <i class="fa-solid fa-music"></i> Music Sessions
        </a>
        <a class="vnv-btn vnv-btn-ghost" href="#" data-vnv-open-request>
          <i class="fa-solid fa-plus"></i> New Request
        </a>
      </div>

      <div class="vnv-stat-grid">
        <a class="vnv-stat" href="{{ path('panel/planner-hub/orders/orders') }}">
          <strong>{{ stats.orders }}</strong>
          <span>Event orders</span>
        </a>
        <a class="vnv-stat" href="{{ path('panel/planner-hub/orders/orders') }}">
          <strong>{{ stats.pending_payments }}</strong>
          <span>Payment alerts</span>
        </a>
        <a class="vnv-stat" href="{{ path('panel/planner-hub/orders/orders') }}">
          <strong>{{ stats.pending_signatures }}</strong>
          <span>Signature alerts</span>
        </a>
        <a class="vnv-stat" href="{{ path('panel/tickets') }}">
          <strong>{{ stats.active_tickets }}</strong>
          <span>Active tickets</span>
        </a>
      </div>
    </section>

    <section class="vnv-event-access" aria-labelledby="event-code-title">
      <div>
        <h2 id="event-code-title"><i class="fa-solid fa-microphone-lines"></i> Enter your private event</h2>
        <p>Enter the 5-digit code shared by VNV Events to request songs, join karaoke and upload photos.</p>
      </div>
      <form class="vnv-code-form" method="post" action="{{ path('panel/event-execution') }}">
        <input type="hidden" name="action" value="join">
        <label class="visually-hidden" for="home-event-code">5-digit event code</label>
        <input id="home-event-code" class="vnv-code-input" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{5}" minlength="5" maxlength="5" placeholder="00000" aria-describedby="event-code-title" required>
        <button class="vnv-btn vnv-btn-primary" type="submit"><i class="fa-solid fa-arrow-right-to-bracket"></i> Enter Event</button>
      </form>
    </section>

    <section class="vnv-section" id="vnv-actions">
      <div class="vnv-section-head">
        <div>
          <h2>Action Center</h2>
          <p>Items that may need attention before your event moves forward.</p>
        </div>
        <a class="vnv-inline-link" href="{{ path('panel/planner-hub/orders/orders') }}">View all orders</a>
      </div>

      <div class="vnv-action-grid">
        <article class="vnv-action-card{% if stats.pending_payments > 0 %} is-hot{% endif %}">
          <div class="vnv-action-icon"><i class="fa-solid fa-credit-card"></i></div>
          <h3>{{ stats.pending_payments }} payment item{{ stats.pending_payments == 1 ? '' : 's' }}</h3>
          {% if stats.pending_payments > 0 %}<div class="vnv-balance">${{ stats.balance_due|number_format(2) }}</div>{% endif %}
          <a class="vnv-inline-link" href="{{ path('panel/planner-hub/orders/orders') }}">Review payment links</a>
        </article>

        <article class="vnv-action-card{% if stats.pending_signatures > 0 %} is-hot{% endif %}">
          <div class="vnv-action-icon"><i class="fa-solid fa-signature"></i></div>
          <h3>{{ stats.pending_signatures }} signature item{{ stats.pending_signatures == 1 ? '' : 's' }}</h3>
          <a class="vnv-inline-link" href="{{ path('panel/planner-hub/orders/orders') }}">Open contracts</a>
        </article>

        <article class="vnv-action-card">
          <div class="vnv-action-icon"><i class="fa-solid fa-calendar-day"></i></div>
          <h3>{{ stats.upcoming_events }} upcoming event{{ stats.upcoming_events == 1 ? '' : 's' }}</h3>
          <a class="vnv-inline-link" href="{{ path('panel/planner-hub/orders/calendar') }}">Open calendar</a>
        </article>
      </div>
    </section>

    <section class="vnv-section">
      <div class="vnv-section-head">
        <div>
          <h2>Main Navigation</h2>
          <p>Primary client areas for a VNV Events customer.</p>
        </div>
      </div>

      <div class="vnv-nav-grid">
        <a class="vnv-nav-card" href="{{ path('panel/event-execution') }}">
          <i class="fa-solid fa-microphone-lines"></i>
          <h3>Event Area</h3>
        </a>
        <a class="vnv-nav-card" href="{{ path('panel/planner-hub/orders/orders') }}">
          <i class="fa-solid fa-file-lines"></i>
          <h3>Orders</h3>
        </a>

        <a class="vnv-nav-card" href="{{ path('panel/tickets') }}">
          <i class="fa-solid fa-ticket"></i>
          <h3>Tickets</h3>
        </a>

        <a class="vnv-nav-card" href="{{ path('panel/payment-methods') }}">
          <i class="fa-solid fa-wallet"></i>
          <h3>Payment Methods</h3>
        </a>
      </div>
    </section>

    <section class="vnv-section vnv-two-col">
      <div class="vnv-list-card">
        <div class="vnv-list-card__head">
          <h3>Upcoming Events</h3>
          <a class="vnv-inline-link" href="{{ path('panel/planner-hub/orders/calendar') }}">Calendar</a>
        </div>

        {% for order in upcomingEvents %}
          <div class="vnv-list-row">
            <div>
              <strong>VNV-341{{ order.id }}</strong>
              <span>
                {{ order.event_date|date('M j, Y') }}
                {% if order.start_time %} · {{ order.start_time|date('g:i A') }}{% endif %}
                {% if order.address %} · {{ order.address }}{% endif %}
              </span>
            </div>
            <div class="d-flex flex-wrap gap-2"><a class="vnv-inline-link" href="{{ path('panel/event-execution') }}?order_id={{ order.id }}">Event Area</a><a class="vnv-inline-link" href="{{ path('panel/planner-hub/orders/orders/suborders') }}?id={{ order.id }}">Details</a></div>
          </div>
        {% else %}
          <div class="vnv-empty">No upcoming event orders are visible yet.</div>
        {% endfor %}
      </div>

      <div class="vnv-list-card">
        <div class="vnv-list-card__head">
          <h3>Pending Items</h3>
          <a class="vnv-inline-link" href="{{ path('panel/planner-hub/orders/orders') }}">Orders</a>
        </div>

        {% for order in pendingSignatures %}
          <div class="vnv-list-row">
            <div>
              <strong>Signature pending · VNV-341{{ order.id }}</strong>
              <span>{{ order.event_date|date('M j, Y') }} · Contract/acceptance review may be required.</span>
            </div>
            <a class="vnv-inline-link" href="{{ order.action_url }}" target="_blank" rel="noopener">Open</a>
          </div>
        {% endfor %}

        {% for order in pendingPayments %}
          <div class="vnv-list-row">
            <div>
              <strong>Payment pending · VNV-341{{ order.id }}</strong>
              <span>{{ order.event_date|date('M j, Y') }}</span>
            </div>
            <span class="vnv-balance">${{ order.balance_due|number_format(2) }}</span>
          </div>
        {% endfor %}

        {% if pendingSignatures|length == 0 and pendingPayments|length == 0 %}
          <div class="vnv-empty">No payment or signature alerts are visible right now.</div>
        {% endif %}
      </div>
    </section>

    <section class="vnv-section" id="vnv-sessions-preview">
      <div class="vnv-session-panel">
        <span class="vnv-kicker"><i class="fa-solid fa-music"></i> Music Experience</span>
        <h2>VNV Sessions preview</h2>
        <div class="vnv-session-list">
          {% for session in musicSessions %}
            <div class="vnv-session-item">
              <strong>{{ session.title }}</strong>
              <span>{{ session.platform|default('session') }}{% if session.category_name %} · {{ session.category_name }}{% endif %}</span>
            </div>
          {% else %}
            <div class="vnv-session-item">
              <strong>VNV Sessions</strong>
              <span>Music content will appear here once published</span>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <section class="vnv-section">
      <div class="vnv-section-head">
        <div>
          <h2>Account & Support</h2>
          <p>Keep your account ready for smoother payments and communication.</p>
        </div>
      </div>

      <div class="vnv-nav-grid">
        <a class="vnv-nav-card" href="{{ path('panel/chat') }}">
          <i class="fa-solid fa-comments"></i>
          <h3>Messages</h3>
        </a>

        <a class="vnv-nav-card" href="{{ path('panel/billing') }}">
          <i class="fa-solid fa-location-dot"></i>
          <h3>Billing Details</h3>
        </a>

        <a class="vnv-nav-card" href="{{ path('panel/settings') }}">
          <i class="fa-solid fa-sliders"></i>
          <h3>Settings</h3>
        </a>

        <a class="vnv-nav-card" href="#" data-vnv-open-request>
          <i class="fa-solid fa-wand-magic-sparkles"></i>
          <h3>New Request</h3>
        </a>

        {% if canSwitchToTeam %}
          <form method="post" action="{{ path('panel/home') }}">
            <input type="hidden" name="level" value="4">
            <button type="submit" class="vnv-nav-card vnv-nav-card-button">
              <i class="fa-solid fa-user-gear"></i>
              <h3>Team View</h3>
            </button>
          </form>
        {% endif %}
      </div>
    </section>
  </div>
</main>
{% endblock %}

{% block aside %}
  {{ parent() }}
  {% include "templates/components/publicEventRequestModal.html.twig" with {
    request_form_action: "/api/public/event-request",
    request_form_source: "level5_dashboard"
  } %}
{% endblock %}
