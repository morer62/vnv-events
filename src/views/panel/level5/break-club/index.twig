{% extends 'templates/base.admin.twig' %}

{% block body %}
<section class="container py-4 club-member" aria-labelledby="club-name">
  <style>
    .club-member{max-width:1020px;color:#24352c}.club-member .club-header{padding:clamp(1.5rem,4vw,3rem);border-radius:1rem;color:#fff;background-color:#203d34;background-image:linear-gradient(90deg,rgba(20,48,39,.96),rgba(23,54,45,.63)),url("{{ asset_for('assets/break-club/hero-poster.webp') }}");background-position:center;background-size:cover}.club-header h1{color:#fff;max-width:19ch}.club-member h2,.club-member h3{color:#203d34}.club-member .event-meta{color:#42534c}.club-member .event-row+.event-row{border-top:1px solid #d7ded9;margin-top:1.2rem;padding-top:1.2rem}.club-member .btn{min-height:44px}.club-member form{margin-bottom:0}.club-member .ticket-status{color:#234635;font-weight:650}
  </style>
  <a href="{{ path('panel/home') }}">← Client Home</a>
  <header class="club-header mt-2 mb-4">
    <h1 id="club-name"><img width="310" height="67" style="max-width:100%;height:auto" src="{{ asset_for('assets/break-club/club-logo.svg') }}" alt="Mommy &amp; Daddy Break Club"></h1>
    <p class="mb-0">Your priority invitations and tickets for mornings together in South Florida.</p>
  </header>
  {% if notice %}<div class="alert alert-{{ notice.type }}" role="status">{{ notice.text }}</div>{% endif %}
  {% if not member %}
    <div class="card"><div class="card-body">
      <h2 class="h4">Connect your membership</h2>
      <p>If you joined the list with {{ user.email }}, request the verification link to see your invitations here.</p>
      <form method="post"><input type="hidden" name="action" value="claim"><input type="hidden" name="csrf_token" value="{{ token }}">
        <button class="btn btn-primary" type="submit">Email me a verification link</button>
      </form>
      <p class="mt-3 mb-0">New to the club? <a href="{{ path('vnv-events-productions/mommy-and-daddy-break') }}">Join the free priority list</a>.</p>
    </div></div>
  {% else %}
    <div class="row g-3">
      <div class="col-lg-8"><section class="card"><div class="card-body">
        <h2 class="h4 mb-3">Events &amp; invitations</h2>
        {% for event in events %}
          <article class="event-row">
            <h3 class="h5">{{ event.title }}</h3>
            <p class="event-meta mb-1">{{ event.starts_at|date('l, F j, Y · g:i a') }} ET · {{ event.location }}</p>
            <p class="mb-2">${{ (event.price_cents / 100)|number_format(2) }} per person</p>
            {% if event.registration_status == 'PAID' %}<p class="ticket-status mb-1">Tickets paid</p>
              <span>{{ member.name }}{% if event.principal_checked_at %} · Checked in{% endif %}</span>
              {% if event.party_size == 2 %}<br><span>{{ event.companion_name|default(member.companion_name) }}{% if event.companion_checked_at %} · Checked in{% endif %}</span>{% endif %}
            {% elseif event.registration_status in ['REFUNDED','PARTIALLY_REFUNDED'] %}
              <p class="ticket-status mb-0">{{ event.registration_status == 'REFUNDED' ? 'Refunded' : 'Partially refunded' }}</p>
            {% elseif event.registration_status == 'INVITED' and member.status == 'ACTIVE' %}
              <form method="post"><input type="hidden" name="csrf_token" value="{{ token }}"><input type="hidden" name="action" value="checkout"><input type="hidden" name="event_id" value="{{ event.id }}">
                {% set quantity = event.party_size|default(member.party_size) %}<button class="btn btn-primary" type="submit">Get {{ quantity }} {{ quantity == 1 ? 'ticket' : 'tickets' }} · ${{ (quantity * event.price_cents / 100)|number_format(2) }}</button></form>
            {% else %}<p class="event-meta mb-0">Priority invitations are sent by email.</p>{% endif %}
          </article>
        {% else %}
          <p class="mb-0">No events have been announced yet.{% if member.status == 'ACTIVE' %} Your first invitation will arrive at {{ member.email }}.{% endif %}</p>
        {% endfor %}
      </div></section></div>
      <div class="col-lg-4"><section class="card"><div class="card-body">
        <h2 class="h4">Your membership</h2>
        <p class="mb-1"><strong>{{ member.name }}</strong></p>
        <p class="mb-2 text-break">{{ member.email }}<br>{{ member.phone }}</p>
        <p>Requested places · {{ member.party_size }}{% if member.party_size == 2 %}<br>Guest · {{ member.companion_name }}{% endif %}</p>
        <p class="mb-1">Membership is free. Tickets are purchased per event.</p>
        {% if member.status == 'ACTIVE' %}
        <details class="mt-3"><summary>Invitation preferences</summary>
          <form method="post" class="mt-2"><input type="hidden" name="csrf_token" value="{{ token }}"><input type="hidden" name="action" value="unsubscribe">
            <button class="btn btn-outline-secondary btn-sm" type="submit">Unsubscribe from event invitations</button></form>
        </details>
        {% else %}<p class="mt-3 mb-0">Invitations · {{ member.status|lower|capitalize }}</p>{% endif %}
      </div></section></div>
    </div>
  {% endif %}
</section>
{% endblock %}
