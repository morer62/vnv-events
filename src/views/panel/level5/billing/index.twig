{% extends 'templates/base.admin.twig' %}

{% block body %}
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('panel/home') }}">Client Home</a></li>
        <li class="breadcrumb-item"><a href="{{ path('panel/payment-methods') }}">Payment Methods</a></li>
        <li class="breadcrumb-item active" aria-current="page">Billing Details</li>
    </ol>
</nav>

<h1 class="h4 mb-4">Billing Information</h1>

<form method="post" class="card p-4 shadow-sm border-0 rounded-4">
    <div class="mb-3">
        <label for="billing_address_1" class="form-label">Address</label>
        <input type="text" id="billing_address_1" name="billing_address_1" class="form-control"
               value="{{ billing.billing_address_1 ?? '' }}">
    </div>

    <div class="mb-3">
        <label for="billing_city" class="form-label">City</label>
        <input type="text" id="billing_city" name="billing_city" class="form-control"
               value="{{ billing.billing_city ?? '' }}">
    </div>

    <div class="mb-3">
        <label for="billing_state" class="form-label">State</label>
        <input type="text" id="billing_state" name="billing_state" class="form-control"
               value="{{ billing.billing_state ?? '' }}">
    </div>

    <div class="mb-3">
        <label for="billing_zip" class="form-label">ZIP Code</label>
        <input type="text" id="billing_zip" name="billing_zip" class="form-control"
               value="{{ billing.billing_zip ?? '' }}">
    </div>

    <div class="d-flex flex-wrap gap-2 justify-content-between">
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('panel/payment-methods') }}" class="btn btn-outline-secondary">Back to Payment Methods</a>
            <a href="{{ path('panel/cards') }}" class="btn btn-outline-secondary">Manage Cards</a>
        </div>
        <button type="submit" class="btn btn-primary">Save Billing Info</button>
    </div>
</form>
{% endblock %}
