{% if frogIsReviewer %}
<style>.frog-concierge{display:flex;align-items:center;gap:14px;background:linear-gradient(135deg,#effbf7,#fff8e8);border:1px solid #cfe9df;border-radius:20px;padding:14px 18px;margin-bottom:18px;color:#173631;box-shadow:0 10px 28px rgba(22,47,44,.08)}.frog-sprite{flex:0 0 62px;width:62px;max-width:100%;height:auto;aspect-ratio:3/5;background-image:url('{{ asset_for('assets/images/automation/vnv-frog-concierge-sprite.png') }}');background-size:800% auto;background-repeat:no-repeat;background-position-y:center}.frog-sprite.coffee{background-position-x:14.285%}.frog-sprite.glasses{background-position-x:28.57%}.frog-sprite.sad{background-position-x:42.855%}.frog-sprite.halloween{background-position-x:57.14%}.frog-sprite.reindeer{background-position-x:71.425%}.frog-sprite.cupid{background-position-x:85.71%}.frog-sprite.easter{background-position-x:100%}.frog-concierge h2{font-size:1rem;margin:0 0 3px;color:#173631}.frog-concierge p{margin:0;color:#527069;font-size:.88rem}.frog-concierge .btn{white-space:nowrap}@media(max-width:600px){.frog-concierge{align-items:flex-start;flex-wrap:wrap}.frog-sprite{flex-basis:54px;width:54px}}</style>
<section class="frog-concierge" aria-label="Recomendaciones de Mochi">
 <div class="frog-sprite {{ frogState.state|default(frogReviewCount > 0 ? 'coffee' : 'sad') }}" role="img" aria-label="Mochi, la ranita asistente de VNV"></div>
 <div class="flex-grow-1"><h2>¡Hola, Oriana! Mochi ya revisó el día.</h2><p>{{ frogState.rhyme|default('Con calma y alegría, organizamos muy bien el día.') }}</p></div>
 <a class="btn btn-sm btn-dark" href="{{ path('panel/planner-hub/settings/automation') }}#recommendations">{{ frogReviewCount > 0 ? 'Revisar tareas' : 'Hablar con Mochi' }}</a>
</section>
{% endif %}
