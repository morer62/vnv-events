{% if frogIsReviewer %}
<style>.frog-concierge{display:flex;align-items:center;gap:16px;background:linear-gradient(135deg,#effbf7,#fff8e8);border:1px solid #cfe9df;border-radius:20px;padding:14px 18px;margin-bottom:18px;color:#173631;box-shadow:0 10px 28px rgba(22,47,44,.08)}.frog-concierge .flex-grow-1{min-width:0}.frog-sprite{flex:0 0 62px;width:62px;max-width:100%;height:auto;aspect-ratio:3/5;background-image:url('{{ asset_for('assets/images/automation/vnv-frog-concierge-sprite.png') }}');background-size:800% auto;background-repeat:no-repeat;background-position-y:center}.frog-sprite.coffee{background-position-x:14.285%}.frog-sprite.glasses{background-position-x:28.57%}.frog-sprite.sad{background-position-x:42.855%}.frog-sprite.halloween{background-position-x:57.14%}.frog-sprite.reindeer{background-position-x:71.425%}.frog-sprite.cupid{background-position-x:85.71%}.frog-sprite.easter{background-position-x:100%}.frog-sprite[class*="halloween-"]{height:100px;aspect-ratio:3/5;background-image:url('{{ asset_for('assets/images/automation/vnv-frog-halloween-week-v1.png') }}');background-size:700% auto}.frog-sprite.halloween-vampire{background-position-x:0}.frog-sprite.halloween-hirax{background-position-x:16.666%}.frog-sprite.halloween-pikachu{background-position-x:33.333%}.frog-sprite.halloween-witch{background-position-x:50%}.frog-sprite.halloween-ghost{background-position-x:66.666%}.frog-sprite.halloween-pumpkin{background-position-x:83.333%}.frog-sprite.halloween-skeleton{background-position-x:100%}.frog-concierge h2{font-size:1.04rem;font-weight:800;line-height:1.38;margin:0;color:#173631;text-wrap:balance}.frog-concierge .btn{white-space:nowrap}.frog-concierge.halloween-week{background:linear-gradient(135deg,#1c1030,#4d1f58 58%,#f68b2b);border-color:#7e5296;box-shadow:0 12px 32px rgba(55,24,76,.24)}.frog-concierge.halloween-week h2{color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.35)}.frog-concierge.halloween-week .btn{background:#ffb347;border-color:#ffb347;color:#25102f;font-weight:800}@media(max-width:600px){.frog-concierge{align-items:center;gap:12px;flex-wrap:wrap;padding:13px 14px}.frog-sprite{flex-basis:52px;width:52px}.frog-sprite[class*="halloween-"]{height:88px}.frog-concierge h2{font-size:.98rem}.frog-concierge .btn{width:calc(100% - 64px);margin-left:64px}}
</style>
<section class="frog-concierge {{ frogState.theme|default('default') == 'halloween' ? 'halloween-week' : '' }}" aria-label="Recomendaciones de Mochi">
 <div class="frog-sprite {{ frogState.state|default(frogReviewCount > 0 ? 'coffee' : 'sad') }}" role="img" aria-label="Mochi, la ranita asistente de VNV"></div>
 <div class="flex-grow-1"><h2>{{ frogState.rhyme|default('Mary y Oriana unen talento y dulzura; juntas hacen de cada evento una hermosura.') }}</h2></div>
 <a class="btn btn-sm btn-dark" href="{{ path('panel/planner-hub/settings/automation') }}#recommendations">{{ frogReviewCount > 0 ? 'Revisar tareas' : 'Hablar con Mochi' }}</a>
</section>
{% endif %}
