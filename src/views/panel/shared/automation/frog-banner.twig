{% if frogIsReviewer %}
<style>.frog-concierge{display:flex;align-items:center;gap:16px;background:linear-gradient(135deg,#effbf7,#fff8e8);border:1px solid #cfe9df;border-radius:20px;padding:14px 18px;margin-bottom:18px;color:#173631;box-shadow:0 10px 28px rgba(22,47,44,.08)}.frog-concierge .flex-grow-1{min-width:0}.frog-sprite{flex:0 0 62px;width:62px;max-width:100%;height:auto;aspect-ratio:3/5;background-image:url('{{ asset_for('assets/images/automation/vnv-frog-concierge-sprite.png') }}');background-size:800% auto;background-repeat:no-repeat;background-position-y:center}.frog-sprite.coffee{background-position-x:14.285%}.frog-sprite.glasses{background-position-x:28.57%}.frog-sprite.sad{background-position-x:42.855%}.frog-sprite.halloween{background-position-x:57.14%}.frog-sprite.reindeer{background-position-x:71.425%}.frog-sprite.cupid{background-position-x:85.71%}.frog-sprite.easter{background-position-x:100%}.frog-concierge h2{font-size:1.04rem;font-weight:800;line-height:1.38;margin:0;color:#173631;text-wrap:balance}.frog-concierge .btn{white-space:nowrap}@media(max-width:600px){.frog-concierge{align-items:center;gap:12px;flex-wrap:wrap;padding:13px 14px}.frog-sprite{flex-basis:52px;width:52px}.frog-concierge h2{font-size:.98rem}.frog-concierge .btn{width:calc(100% - 64px);margin-left:64px}}
</style>
<section class="frog-concierge" aria-label="Recomendaciones de Mochi">
 <div class="frog-sprite {{ frogState.state|default(frogReviewCount > 0 ? 'coffee' : 'sad') }}" role="img" aria-label="Mochi, la ranita asistente de VNV"></div>
 <div class="flex-grow-1"><h2>{{ frogState.rhyme|default('Mary guía con ternura y Oriana asiste con dulzura; juntas hacen de cada evento una hermosura.') }}</h2></div>
 <a class="btn btn-sm btn-dark" href="{{ path('panel/planner-hub/settings/automation') }}#recommendations">{{ frogReviewCount > 0 ? 'Revisar tareas' : 'Hablar con Mochi' }}</a>
</section>
{% endif %}
