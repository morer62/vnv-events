{% if frogIsReviewer %}
<style>.frog-concierge{display:flex;align-items:center;gap:14px;background:linear-gradient(135deg,#effbf7,#fff8e8);border:1px solid #cfe9df;border-radius:20px;padding:14px 18px;margin-bottom:18px;color:#173631;box-shadow:0 10px 28px rgba(22,47,44,.08)}.frog-sprite{flex:0 0 70px;width:70px;height:70px;background-image:url('{{ asset_for('assets/images/automation/vnv-frog-concierge-sprite.png') }}');background-size:800% 100%;background-repeat:no-repeat}.frog-sprite.coffee{background-position:14.285% 0}.frog-sprite.glasses{background-position:28.57% 0}.frog-sprite.sad{background-position:42.855% 0}.frog-sprite.halloween{background-position:57.14% 0}.frog-sprite.reindeer{background-position:71.425% 0}.frog-sprite.cupid{background-position:85.71% 0}.frog-sprite.easter{background-position:100% 0}.frog-concierge h2{font-size:1rem;margin:0 0 3px;color:#173631}.frog-concierge p{margin:0;color:#527069;font-size:.88rem}.frog-concierge .btn{white-space:nowrap}@media(max-width:600px){.frog-concierge{align-items:flex-start}.frog-sprite{flex-basis:58px;width:58px;height:58px}.frog-concierge{flex-wrap:wrap}}</style>
<section class="frog-concierge" aria-label="VNV concierge recommendations">
 <div class="frog-sprite {{ frogState.state|default(frogReviewCount > 0 ? 'coffee' : 'sad') }}" role="img" aria-label="Mochi, the VNV frog concierge"></div>
 <div class="flex-grow-1"><h2>{{ frogState.greeting|default('') ?: (frogReviewCount > 0 ? 'Hi Oriana! Mochi reviewed today’s follow-ups.' : 'Mochi is waiting for the next review together.') }}</h2><p>{{ frogReviewCount > 0 ? frogReviewCount ~ ' recommendations need your human context before anything is sent.' : 'There are no client messages waiting for approval right now.' }}</p></div>
 <a class="btn btn-sm btn-dark" href="{{ path('panel/planner-hub/settings/automation') }}#recommendations">{{ frogReviewCount > 0 ? 'Review recommendations' : 'Open concierge' }}</a>
</section>
{% endif %}
