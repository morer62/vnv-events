{% extends 'templates/base.admin.twig' %}

{% block style %}
<style>
    .membership-header {
        background-color: #e3f2fd;
        padding: 1.5rem;
        border-radius: 1rem;
        text-align: center;
        margin-bottom: 2rem;
    }

    .membership-header h2 {
        margin-bottom: 0.5rem;
    }

    .plan-card {
        border: 1px solid #ccc;
        border-radius: 1rem;
        padding: 2rem;
        text-align: center;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .plan-price {
        font-size: 2rem;
        font-weight: bold;
        margin-bottom: 0.5rem;
    }

    .plan-btn {
        font-size: 1.1rem;
        font-weight: 500;
        padding: 0.6rem 1.5rem;
        border-radius: 8px;
        margin-top: auto;
    }

    .plan-btn-monthly {
        border: 2px solid #0d6efd;
        color: #0d6efd;
        background: white;
    }

    .plan-btn-quarterly {
        border: 2px solid #16a34a;
        background-color: #16a34a;
        color: white;
    }

    .plan-btn-annual {
        border: 2px solid #d97706;
        background-color: #d97706;
        color: white;
    }

    .plan-btn:hover {
        opacity: 0.9;
    }

    .badge-popular {
        background: #dcfce7;
        color: #166534;
        padding: .35rem .75rem;
        font-size: .8rem;
        border-radius: 20px;
        font-weight: 700;
        display: inline-block;
        margin-bottom: .5rem;
    }

    @media (min-width: 768px) {
        .plans-grid {
            display: flex;
            gap: 2rem;
            justify-content: center;
        }
    }
</style>
{% endblock %}

{% block body %}
<main>
    <section class="membership-header">
        <div class="bg-light rounded p-4 my-4 text-center">
            <h2 class="mb-4">Unlock exclusive tools to grow your event business</h2>
            <div class="d-flex flex-column align-items-start mx-auto" style="max-width: 520px;">
                <div class="d-flex align-items-center mb-2">
                    <span class="text-success me-2">✅</span>
                    <span>Client & lead management (CRM)</span>
                </div>
                <div class="d-flex align-items-center mb-2">
                    <span class="text-success me-2">✅</span>
                    <span>Team assignments and task tracking</span>
                </div>
                <div class="d-flex align-items-center mb-2">
                    <span class="text-success me-2">✅</span>
                    <span>Inventory & services organizer</span>
                </div>
                <div class="d-flex align-items-center mb-2">
                    <span class="text-success me-2">✅</span>
                    <span>Automated client communication tools</span>
                </div>
                {% if isVenue %}
                    <div class="d-flex align-items-start bg-success bg-opacity-10 border border-success rounded p-3 mt-3 w-100">
                        <div class="me-3 fs-3">🏷️</div>
                        <div>
                            <strong class="text-success">Exclusive for Venue Owners:</strong><br>
                            Promote your venue at a special rate:
                            <span class="text-decoration-line-through text-danger">${{ venuePrice|number_format(2) }}</span>
                            <span class="fw-bold fs-5 text-dark ms-2">${{ venuePriceDiscount|number_format(2) }}</span> / month
                            with your active membership.
                        </div>
                    </div>
                {% elseif isVendor %}
                    <div class="d-flex align-items-start bg-info bg-opacity-10 border border-info rounded p-3 mt-3 w-100">
                        <div class="me-3 fs-3">🏷️</div>
                        <div>
                            <strong class="text-info">Exclusive for Vendors:</strong><br>
                            Promote your service at a discounted rate:
                            <span class="text-decoration-line-through text-danger">${{ vendorPrice|number_format(2) }}</span>
                            <span class="fw-bold fs-5 text-dark ms-2">${{ vendorPriceDiscount|number_format(2) }}</span> / month
                            with your active membership.<br>
                            <small class="text-muted">
                                (Save ${{ (vendorPrice - vendorPriceDiscount)|number_format(2) }})
                            </small>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </section>

    <div class="row g-4 mt-4 justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="plan-card">
                <div>
                    <h5 class="fw-bold text-muted">Monthly Membership</h5>
                    <h2 class="plan-price">${{ monthly_price }}</h2>
                    <p class="text-muted">Renews every 30 days</p>
                </div>
                <form method="post">
                    <input type="hidden" name="plan" value="monthly" />
                    <button class="btn plan-btn plan-btn-monthly w-100" type="submit" onclick="showLoader(this)">
                        Pay ${{ monthly_price }}
                    </button>
                </form>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="plan-card border-success" style="border-width: 2px !important;">
                <div>
                    <span class="badge-popular">Most Popular</span>
                    <h5 class="fw-bold text-muted">Quarterly Membership</h5>
                    <h2 class="plan-price">${{ quarterly_price }}</h2>
                    <p class="text-muted">≈ ${{ (quarterly_price / 3) | number_format(2) }}/month</p>
                </div>
                <form method="post">
                    <input type="hidden" name="plan" value="quarterly" />
                    <button class="btn plan-btn plan-btn-quarterly w-100" type="submit" onclick="showLoader(this)">
                        Pay ${{ quarterly_price }}
                    </button>
                </form>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="plan-card">
                <div>
                    <h5 class="fw-bold text-muted">Annual Membership</h5>
                    <h2 class="plan-price">${{ annual_price }}</h2>
                    <p class="text-muted">≈ ${{ (annual_price / 12) | number_format(2) }}/month</p>
                </div>
                <form method="post">
                    <input type="hidden" name="plan" value="annual" />
                    <button class="btn plan-btn plan-btn-annual w-100" type="submit" onclick="showLoader(this)">
                        Pay ${{ annual_price }}
                    </button>
                </form>
            </div>
        </div>
    </div>
</main>
{% endblock %}

{% block scripts %}
<script>
    function showLoader(button) {
        button.disabled = true;
        button.innerHTML = 'Processing...';
        button.form.submit();
    }
</script>
{% endblock %}
