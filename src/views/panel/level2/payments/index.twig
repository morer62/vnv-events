{% extends 'templates/base.admin.twig' %}

{% block body %}
<main class="container-fluid">
    <h1 class="h3 mb-4">💳 Payment History</h1>

    <div class="card">
        <div class="card-body">
            {% if payments is empty %}
                <div class="alert alert-info">No payment history found.</div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-bordered table-striped text-center" style="min-width: 900px;">
                        <thead>
                            <tr>
                                <th>Payment Date</th>
                                <th>Concept</th>
                                <th>Status</th>
                                <th>Detail</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for payment in payments %}
                                <tr>
                                    <td>{{ payment.payment_date ? payment.payment_date|date("l, M j, Y") : '—' }}</td>
                                    <td>
                                        {% if payment.concept == 'Venue' %}
                                            🏛 Venue
                                        {% elseif payment.concept == 'Membership' %}
                                            🎟 Membership
                                        {% elseif payment.concept == 'Service' %}
                                            🧩 Service
                                        {% else %}
                                            {{ payment.concept }}
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if payment.status == 'ACTIVE' %}
                                            <span class="badge bg-success">Active</span>
                                        {% elseif payment.status == 'PENDING' %}
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        {% else %}
                                            <span class="badge bg-danger">Expired</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <a href="{{ path('panel/payments/details') }}?id={{ payment.id }}" class="btn btn-sm btn-outline-primary">🔍 View</a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</main>
{% endblock %}
