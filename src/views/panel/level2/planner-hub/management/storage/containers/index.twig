{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}
{% block body %}

    <main>
        <h1 class="h3 mb-4">📦 My Containers</h1>

        {{ macros.breadcrumb2() }}

        <section class="card">
            <div class="card-body">

                <a class="btn btn-primary mb-3" href="{{ path('panel/planner-hub/management/storage/containers/create') }}">
                    <i class="align-middle" data-feather="plus"></i>Add a new container
                </a>

                <div class="table-responsive">
                    <table class="table table-bordered text-center align-middle" style="min-width: 500px;">
                        <thead>
                            <tr>
                                <th>Container</th>
                                <th>Actions</th>
                                <th>QR Tag</th>

                            </tr>
                        </thead>
                        <tbody>
                            {% for container in containers %}
                                <tr>
                                    <td>{{ container.name }}</td>
                                    <td class="d-flex justify-content-center gap-2">
                                        <a href="{{ path(current_location ~ '/items', { container_id: container.id}) }}" class="btn btn-primary">
                                           <i class="align-middle" data-feather="list"></i> View Items
                                        </a>

                                        <a href="{{ path(current_location ~ '/edit', { id: container.id }) }}" class="btn btn-warning">
                                            <i class="align-middle" data-feather="edit-2"></i> Edit
                                        </a>

                                        {{ macros.delete_form(container.id) }}
                                    </td>
                                    <td>
                                         

                                        <button class="btn btn-outline-secondary" onclick="showPrintTagModal('{{ container.name }}', '{{ path('panel/planner-hub/team/storage/containers/items', { container_id: container.id }) }}', {{ container.id }})">
                                            🖨️ Print Tag
                                        </button>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="2" class="text-muted">No containers were found.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>



<div id="tagModal" class="modal fade" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Print Container Tag</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body text-center" id="tagContentToPrint">
        <h2 id="containerTitle" class="mb-3"></h2>
        <center><div id="qrcode" style="margin: auto;"></div></center>
        <p id="containerUrl" class="mt-3 text-muted small"></p>
        
        <p id="currentDate" class="mt-2 text-muted small"></p>
        
        <div class="mt-3">
          <input type="checkbox" id="showItemsCheckbox" class="form-check-input">
          <label for="showItemsCheckbox" class="form-check-label ms-2">Include items list</label>
        </div>
        
        <div id="itemsList" class="mt-3" style="display: none;">
          <hr>
          <h5>Items in this container:</h5>
          <div id="itemsContent" class="d-flex justify-content-center"></div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button class="btn btn-primary" onclick="printTag()">🖨️ Print</button>
      </div>
    </div>
  </div>
</div>

<style>
    .modal-items-table {
        border-collapse: collapse;
        margin: 0 auto;
    }
    
    .modal-items-table th,
    .modal-items-table td {
        border: 1px solid #333;
        padding: 8px;
        text-align: center;
    }
    
    .modal-items-table th {
        background-color: #f5f5f5;
        font-weight: bold;
    }
</style>

{% endblock %}



{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>

<script>
  function showPrintTagModal(name, url, containerId) {
    document.getElementById('containerTitle').innerText = name;
    document.getElementById('containerUrl').innerText = url;
    document.getElementById('qrcode').innerHTML = '';

    


    new QRCode(document.getElementById("qrcode"), {
      text: url,
      width: 100,
      height: 100
    });

    
    loadContainerItems(containerId);

    
    const checkbox = document.getElementById('showItemsCheckbox');
    const itemsList = document.getElementById('itemsList');
    
    checkbox.onchange = function() {
      itemsList.style.display = this.checked ? 'block' : 'none';
    };

    
    checkbox.checked = false;
    itemsList.style.display = 'none';

    new bootstrap.Modal(document.getElementById('tagModal')).show();
  }

  
  async function loadContainerItems(containerId) {
    try {
      const response = await fetch(`{{ path('panel/planner-hub/management/storage/containers/items') }}?container_id=${containerId}`);
      const html = await response.text();
      
      
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      const rows = doc.querySelectorAll('tbody tr');
      
      let itemsHtml = `
        <table class="modal-items-table">
          <thead>
            <tr>
              <th>Item Name</th>
              <th>Quantity</th>
            </tr>
          </thead>
          <tbody>
      `;
      let printItemsHtml = `
        <table class="items-table">
          <thead>
            <tr>
              <th>Item Name</th>
              <th>Quantity</th>
            </tr>
          </thead>
          <tbody>
      `;
      
      let hasItems = false;
      rows.forEach(row => {
        const cells = row.querySelectorAll('td');
        if (cells.length >= 3 && !cells[0].textContent.includes('No items')) {
          const name = cells[0].textContent.trim();
          const quantity = cells[1].textContent.trim();
          itemsHtml += `
            <tr>
              <td>${name}</td>
              <td>${quantity}</td>
            </tr>
          `;
          printItemsHtml += `
            <tr>
              <td>${name}</td>
              <td>${quantity}</td>
            </tr>
          `;
          hasItems = true;
        }
      });
      
      itemsHtml += `
          </tbody>
        </table>
      `;
      printItemsHtml += `
          </tbody>
        </table>
      `;
      
      if (!hasItems) {
        itemsHtml = '<p class="text-muted">No items in this container</p>';
        printItemsHtml = '<p class="text-muted">No items in this container</p>';
      }
      
      document.getElementById('itemsContent').innerHTML = itemsHtml;
      window.containerPrintItems = printItemsHtml;
    } catch (error) {
      console.error('Error loading items:', error);
      document.getElementById('itemsContent').innerHTML = '<p class="text-muted">Error loading items</p>';
    }
  }

function printTag() {
  const title = document.getElementById('containerTitle').innerText;
  const qrCanvas = document.querySelector('#qrcode canvas');
  const qrImage = qrCanvas.toDataURL("image/png");
  const showItems = document.getElementById('showItemsCheckbox').checked;
  const printItemsContent = window.containerPrintItems || '';
  const dateText = document.getElementById('currentDate').innerText;

  
  const printWindow = window.open('', '_blank', 'width=800,height=600');
  
  let printContent = `
    <!DOCTYPE html>
    <html>
    <head>
      <title>Etiqueta de Contenedor - ${title}</title>
      <style>
        body {
          font-family: Arial, sans-serif;
          margin: 0;
          padding: 20px;
          text-align: center;
          background: white;
        }
        
        .container-title {
          font-size: 3rem;
          font-weight: bold;
          line-height: 1;
          margin: 20px 0 30px 0;
          color: #000;
          word-break: break-all;
        }
        
        .qr-section {
          margin: 20px 0;
        }
        
        .qr-image {
          width: 100px;
          height: 100px;
          border: 1px solid #ccc;
        }
        
        .date-info {
          font-size: 1rem;
          color: #666;
          margin: 10px 0;
        }
        
        .items-section {
          margin-top: 30px;
          text-align: left;
          max-width: 500px;
          margin-left: auto;
          margin-right: auto;
        }
        
        .items-title {
          text-align: center;
          font-size: 1.2rem;
          margin-bottom: 15px;
          color: #000;
        }
        
        .items-content {
          font-size: 1.2rem;
          line-height: 1.3;
        }
        
        .items-table {
          width: 100%;
          border-collapse: collapse;
          margin-top: 10px;
        }
        
        .items-table th,
        .items-table td {
          border: 1px solid #333;
          padding: 8px;
          text-align: center;
        }
        
        .items-table th {
          background-color: #f5f5f5;
          font-weight: bold;
        }
        
        @media print {
          body { margin: 0; padding: 10px; }
          .container-title { page-break-inside: avoid; }
        }
      </style>
    </head>
    <body>
      <div class="container-title">${title}</div>
      
      <div class="qr-section">
        <img src="${qrImage}" class="qr-image" alt="QR Code">
    </div>
      
      <div class="date-info">${dateText}</div>
  `;

  
  if (showItems && printItemsContent.trim()) {
    printContent += `
      <div class="items-section">
        <h3 class="items-title">Items in this container:</h3>
        <div class="items-content">
          ${printItemsContent}
        </div>
      </div>
    `;
  }

  printContent += `
    </body>
    </html>
  `;

  printWindow.document.write(printContent);
  printWindow.document.close();
  
  
  printWindow.onload = function() {
  setTimeout(() => {
      printWindow.print();
      printWindow.close();
    }, 500);
  };
}

</script>
{% endblock %}
