{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<h2 class="mb-4">💰 Received Payments</h2>
{{ macros.breadcrumb2() }}

{% if account %}
    <div class="alert alert-info">
        <strong>Square Status:</strong> ✅ Account ID: <code>{{ account.square_account_id }}</code><br>
        <strong>Charges Enabled:</strong> {{ account.is_verified ? 'Yes' : 'No' }}<br>
        <strong>Details Submitted:</strong> {{ account.onboarded_at ? 'Yes' : 'No' }}
    </div>
{% else %}
    <div class="alert alert-warning">
        ⚠️ You don't have a Square account connected yet.
        <br><br>
        <a href="{{ path('panel/planner-hub/management/payments/') }}" class="btn btn-primary">
            👉 Connect Square Account
        </a>
    </div>
{% endif %}


<section class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped text-center align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Order</th>
                        <th>Amount</th>
                        <th>Refunded Amount</th>
                        <th>Method</th>
                        <th>Square Payment ID</th>
                        <th>Paid At</th>
                        <th>PDF</th>
                        <th>Refund</th>
                    </tr>
                </thead>
                <tbody>
                    {% for p in payments %}
                        <tr>
                            <td>{{ loop.index }}</td>
                            <td>#{{ p.id_order }}</td>
                            <td>${{ p.amount }}</td>
                            <td>${{ p.refunded_amount ?? 0 }}</td>
                            <td>{{ p.method|capitalize }}</td>
                            <td>
                                {% if p.stripe_charge_id %}
                                    <code>{{ p.stripe_charge_id }}</code>
                                {% else %}
                                    <span class="text-muted">Manual</span>
                                {% endif %}
                            </td>
                            <td>{{ p.paid_at|date("Y-m-d H:i") }}</td>
                            <td>
                                {% if p.id_order and p.entry_type == 'payment' %}
                                    <a href="{{ path('panel/planner-hub/management/orders/orders/payments/pdf') }}?payment_id={{ p.id }}&order_id={{ p.id_order }}" 
                                       class="btn btn-sm btn-outline-primary" 
                                       target="_blank"
                                       data-bs-toggle="tooltip"
                                       data-bs-title="Download Payment Receipt PDF">
                                        📄 PDF
                                    </a>
                                {% elseif p.id_order and p.entry_type == 'advance' %}
                                    <a href="{{ path('panel/planner-hub/management/orders/orders/payments/pdf') }}?advance_id={{ p.id }}&order_id={{ p.id_order }}" 
                                       class="btn btn-sm btn-outline-primary" 
                                       target="_blank"
                                       data-bs-toggle="tooltip"
                                       data-bs-title="Download Advance Receipt PDF">
                                        📄 PDF
                                    </a>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                          <td>
                            {% if p.stripe_charge_id and p.refunded_amount < p.amount %}
                                <form method="post" class="d-flex gap-1 justify-content-center" onsubmit="return confirmRefund(this);">
                                    <input type="hidden" name="charge_id" value="{{ p.stripe_charge_id }}">

                                    <input
                                        type="number"
                                        name="refund_amount"
                                        min="0"
                                        max="{{ p.amount - p.refunded_amount }}"
                                        step="0.01"
                                        class="form-control form-control-sm"
                                        placeholder="Amount"
                                        value="0"
                                        data-bs-toggle="tooltip"
                                        data-bs-title="Leave at 0 to refund the full amount"
                                    >

                                    <button
                                        class="btn btn-sm btn-outline-warning"
                                        data-bs-toggle="tooltip"
                                        data-bs-title="Refund"
                                    >
                                        ↩ Refund
                                    </button>

                                </form>
                            {% elseif p.refunded_amount == p.amount or p.refunded_amount > p.amount %}
                                <span class="text-danger">Refunded {{ p.refunded_at|date("Y-m-d H:i") }}</span>
                            {% else %}
                                —
                            {% endif %}
                        </td>

                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="text-muted">No payments received yet.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
    </div>
</section>
{% endblock %}

{% block scripts %}
<script>
function confirmRefund(form) {
    const amount = form.querySelector('input[name="refund_amount"]').value;

    if (parseFloat(amount) === 0 || isNaN(parseFloat(amount))) {
        return confirm(`⚠️ Are you sure you want to refund the full amount? This action cannot be undone.`);
    }

    return confirm(`⚠️ Are you sure you want to refund $${parseFloat(amount).toFixed(2)}? This action cannot be undone.`);
}
</script>
{% endblock %}

