{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}

    <h1 class="h3 mb-4">
        <i data-feather="plus"></i> Create Service
    </h1>

    {{ macros.breadcrumb2() }}

    <section class="card">
        <div class="card-body">
            <form method="POST">
                <div class="mb-3">
                    <label class="form-label">Service Name</label>
                    <input type="text" name="name" class="form-control" required maxlength="50">
                </div>

                <div class="mb-3">
                    <label class="form-label">Short Description</label> 
                    <input type="text"  name="description" class="form-control"  maxlength="100" required >
                </div>

                <div class="mb-3">
                    <label class="form-label">Extrernal URL</label> <small> (More Details or promotions you want to add))</small>
                    <input type="text"  name="description_url" class="form-control"  maxlength="200"  >
                </div>

                <div class="mb-3">
                    <label class="form-label">Variable Price</label>
                    <div class="form-check">
                        <input type="checkbox" name="is_variable" id="is_variable" class="form-check-input" value="YES">
                        <label class="form-check-label" for="is_variable">
                            This service has variable pricing (price will be set per order)
                        </label>
                    </div>
                </div>

                <div class="mb-3" id="price_field">
                    <label class="form-label">Price ($)</label>
                    <input type="number" name="price" step="0.01" class="form-control" value="0.00" required>
                    <small class="text-muted">Leave as 0.00 if using variable pricing</small>
                </div>

                <div>
                    <button class="btn btn-primary">💾 Save Service</button>
                    {{ macros.back_btn(title="Cancel") }}
                </div>
            </form>
        </div>
    </section>

    <script>
        // Función para manejar la visibilidad del campo de precio
        function togglePriceField() {
            const isVariable = document.getElementById('is_variable');
            const priceField = document.getElementById('price_field');
            const priceInput = priceField.querySelector('input[name="price"]');
            
            if (isVariable.checked) {
                priceInput.value = '0.00';
                priceInput.readOnly = true;
                priceField.style.display = 'none';
            } else {
                priceInput.value = '';
                priceInput.readOnly = false;
                priceField.style.display = 'block';
            }
        }

        // Event listener para cambios en el checkbox
        document.getElementById('is_variable').addEventListener('change', togglePriceField);
        
        // Ejecutar al cargar la página para establecer el estado inicial
        document.addEventListener('DOMContentLoaded', togglePriceField);
    </script>
{% endblock %}