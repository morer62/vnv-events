{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
    <main>
        <h1 class="h3 mb-3">
            Create Category
        </h1>

        {{ macros.breadcrumb2() }}

        <form method="post" class="card">
            <div class="card-body">

                <div class="mb-3">
                    <label for="name" class="form-label">Category Name</label>
                    <input type="text" class="form-control" name="name" id="name" placeholder="Enter category name" required>
                </div>

                <button type="submit" class="btn btn-primary">💾 Save</button>
                <a href="{{ path('panel/planner-hub/management/crm/categories/home') }}" class="btn btn-danger">
                    <i data-feather="arrow-left" ></i> Cancel
                </a>
            </div>
        </form>
    </main>
{% endblock %}
