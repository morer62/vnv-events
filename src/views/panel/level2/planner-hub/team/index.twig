{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<main class="mt-4">
  <div class="container">

    <h2 class="mb-4 text-center">Team Members Workspace</h2>

    {{ macros.breadcrumb2() }}

    <div class="row g-4">

      <!-- Assigned Tasks -->
      <div class="col-md-6">
        <div class="p-4 bg-white rounded-4 shadow-sm h-100 text-center">
          <img src="{{ asset_for('assets/images/icons_website/icon_3.png') }}" alt="Orders" class="mb-3" style="height: 90px;">
          <h5 class="fw-bold mb-2">📦 Assigned Tasks</h5>
          <p class="text-muted small mb-3">Track event orders and assigned resources.</p>
          {% if user.level not in [2,3] %}
            <a href="{{ path('panel/planner-hub/team/orders/orders') }}" class="btn btn-success btn-lg fw-bold px-4">View Orders</a>
          {% endif %}
        </div>
      </div>

      <!-- Time & Payments -->
      <div class="col-md-6">
        <div class="p-4 bg-white rounded-4 shadow-sm h-100 text-center">
          <img src="{{ asset_for('assets/images/icons_website/icon_7.png') }}" alt="Payroll" class="mb-3" style="height: 90px;">
          <h5 class="fw-bold mb-2">⏱️ Time & Payments</h5>
          <p class="text-muted small mb-3">Track your time, manage payments & compensation.</p>
          {% if user.level not in [2,3] %}
            <a href="{{ path('panel/planner-hub/team/payroll') }}" class="btn btn-success btn-lg fw-bold px-4">Go to Payroll</a>
          {% endif %}
        </div>
      </div>

      <!-- Internal Chat -->
      <div class="col-md-6">
        <div class="p-4 bg-white rounded-4 shadow-sm h-100 text-center">
          <img src="{{ asset_for('assets/images/icons_website/icon_8.png') }}" alt="Chat" class="mb-3" style="height: 90px;">
          <h5 class="fw-bold mb-2">💬 Internal Chat</h5>
          <p class="text-muted small mb-3">Talk to clients and team members.</p>
          {% if user.level not in [2,3] %}
            <a href="{{ path('panel/planner-hub/team/chat') }}" class="btn btn-success btn-lg fw-bold px-4">Start Chat</a>
          {% endif %}
        </div>
      </div>

      <!-- Inventory Search -->
      <div class="col-md-6">
        <div class="p-4 bg-white rounded-4 shadow-sm h-100 text-center">
          <img src="{{ asset_for('assets/images/icons_website/icon_1.png') }}" alt="Inventory" class="mb-3" style="height: 90px;">
          <h5 class="fw-bold mb-2">🔍 Inventory Search</h5>
          <p class="text-muted small mb-3">Check items and manage containers.</p>
          {% if user.level not in [2,3] %}
            <a href="{{ path('panel/planner-hub/team/storage') }}" class="btn btn-success btn-lg fw-bold px-4">View Inventory</a>
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</main>
{% endblock %}
