{% extends "templates/base.admin.twig" %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
    <h1 class="h3 mb-4">📦 Storage Items</h1>
    {{ macros.breadcrumb2() }}

    <section class="card">
        <div class="card-body">

            <!--
            <a href="{{ path(current_location ~ '/create', { container: containerId }) }}" class="btn btn-primary mb-3">
                <i class="align-middle" data-feather="plus"></i> Add New Item
            </a>
            -->

             <h1>{{ container.name }}</h1>

             {% if container.img_reference %}
                    <p>
                        <a href="#" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#imgModal">
                            📷 Click to see reference image
                        </a>
                    </p>

                    <!-- Modal -->
                    <div class="modal fade" id="imgModal" tabindex="-1" aria-labelledby="imgModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-lg">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="imgModalLabel">Reference Image - {{ container.name }}</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body text-center">
                                    <img src="{{ asset_for(container.img_reference) }}" alt="Reference Image" class="img-fluid"> 
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}

             
             
             <hr>

            <div class="table-responsive">
                <table class="table table-bordered table-striped text-center align-middle" style="min-width: 600px;">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Quantity</th>
                            <th>Container Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in items %}
                            <tr>
                                <td>{{ item.name }}</td>
                                <td>{{ item.quantity }}</td>
                                <td>{{ container.name }}</td>
                                <!--
                                <td>
                                    <a href="{{ path(current_location ~ '/edit', { container: containerId, item: item.id }) }}" class="btn btn-primary">Edit</a>
                                </td>
                                <td>
                                    {{ macros.delete_form(item.id) }}
                                </td>
                                -->
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-muted">No items were found.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>

{% endblock %}
