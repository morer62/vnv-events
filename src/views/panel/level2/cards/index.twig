{% extends 'templates/base.admin.twig' %}

{% block body %}
<section class="p-5 rounded-4 shadow-sm mb-5 text-white" style="background: linear-gradient(135deg, #00b894, #00cec9);">
    <h2 class="fw-bold mb-2">Manage Your Venue</h2>
    <p class="fs-5 mb-3">Update your profile and attract more clients</p>
    <a href="{{ path('panel/venues/home') }}" class="btn btn-light btn-lg fw-bold px-4">Go to Venue</a>
</section>
<h1 class="h3 mb-4">Update Your Payment Method to Activate Your Profile & Memberships</h1>

<a href="{{ path('panel/billing') }}" class="btn btn-outline-primary mb-4">
    Update Billing Information
</a>

<div class="row">
    <div class="col-md-6">
        <form id="card-form">
            <div class="card">
                <div class="card-body">
                    <div id="card-element" class="form-control mb-3 py-3"></div>
                    <div id="card-errors" class="text-danger mb-2"></div>
                    <button class="btn btn-dark w-100" id="submit-card" type="submit">
                        Add Card
                    </button>
                    <div id="loading-text" class="text-center text-muted mt-2" style="display:none;">
                        Processing card, please wait...
                    </div>
                </div>
            </div>
        </form>
    </div>

    <div class="col-md-6">
        <h5>Saved Cards</h5>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Brand</th>
                    <th>Last 4</th>
                    <th>Exp</th>
                    <th>Main</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for card in cards %}
                    <tr>
                        <td>{{ card.brand }}</td>
                        <td>**** **** **** {{ card.last4 }}</td>
                        <td>{{ card.exp }}</td>
                        <td>{% if card.main_card == 'yes' %}Yes{% endif %}</td>
                        <td>
                            {% if card.main_card != 'yes' %}
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="set_main" value="{{ card.id }}">
                                    <button type="submit" class="btn btn-sm btn-outline-success">Make Main</button>
                                </form>
                            {% endif %}
                            <form method="post" class="d-inline">
                                <input type="hidden" name="delete_card" value="{{ card.id }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="text-center">No cards saved.</td></tr>
                {% endfor %}
            </tbody>
        </table>

        <h5 class="mt-4">Cards Saved From Public Payments</h5>
        <p class="text-muted small mb-2">Cards used on public payment links appear here when they were saved for future authorized charges.</p>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Business</th>
                    <th>Brand</th>
                    <th>Last 4</th>
                    <th>Exp</th>
                    <th>Default</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for method in client_payment_methods %}
                    <tr>
                        <td>#{{ method.id_user_business }}</td>
                        <td>{{ method.brand ?: method.payment_provider|capitalize }}</td>
                        <td>**** **** **** {{ method.last4 ?: '----' }}</td>
                        <td>
                            {% if method.exp_month and method.exp_year %}
                                {{ method.exp_month }}/{{ method.exp_year }}
                            {% else %}
                                -
                            {% endif %}
                        </td>
                        <td>{% if method.is_default %}Yes{% endif %}</td>
                        <td>
                            <form method="post" class="d-inline">
                                <input type="hidden" name="delete_client_payment_method" value="{{ method.id }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-center">No public payment cards saved.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="profileSuggestModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="profileSuggestTitle">Create your venue profile</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        Your payment method was saved successfully. Would you like to create your venue profile now to activate your visibility?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Later</button>
        <a id="profileSuggestGo" href="#" class="btn btn-primary">Go now</a>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script src="https://js.stripe.com/v3/"></script>
<script>
    const stripe = Stripe("{{ stripe_key }}");
    const elements = stripe.elements();
    const card = elements.create("card");
    card.mount("#card-element");

    document.getElementById("card-form").addEventListener("submit", async (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById("submit-card");
        const loadingText = document.getElementById("loading-text");
        submitBtn.disabled = true;
        loadingText.style.display = "block";

        const { token, error } = await stripe.createToken(card);
        if (error) {
            document.getElementById("card-errors").textContent = error.message;
            submitBtn.disabled = false;
            loadingText.style.display = "none";
        } else {
            const cardInfo = {
                brand: token.card.brand,
                last4: token.card.last4,
                exp: token.card.exp_month + "/" + token.card.exp_year
            };

            const formData = new FormData();
            formData.append("token", token.id);
            formData.append("card_info", JSON.stringify(cardInfo));

            const res = await fetch(location.href, {
                method: "POST",
                body: formData
            });

            const result = await res.json();
            if (result.success) {
                if (result.needs_profile) {
                    document.getElementById('profileSuggestTitle').textContent = result.next_title || 'Create your venue profile';
                    document.getElementById('profileSuggestGo').setAttribute('href', result.next_url || '#');
                    const modal = new bootstrap.Modal(document.getElementById('profileSuggestModal'));
                    modal.show();
                    submitBtn.disabled = false;
                    loadingText.style.display = "none";
                } else {
                    window.location.reload();
                }
            } else {
                document.getElementById("card-errors").textContent = result.message || "Something went wrong.";
                submitBtn.disabled = false;
                loadingText.style.display = "none";
            }
        }
    });
</script>
{% endblock %}
