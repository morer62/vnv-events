{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block style %}
	<style>
		.dropdown-menu {
			position: absolute !important;
			z-index: 1060 !important;
		}
		.table-responsive {
			position: relative;
			overflow: visible !important;
		}
		.modal {
			z-index: 1070 !important;
		}
		.status-badge {
			font-size: 0.875rem;
			padding: 0.375rem 0.75rem;
		}
		.btn-group-status .btn {
			margin-right: 0.5rem;
			margin-bottom: 0.5rem;
		}
		.notes-form {
			min-width: 300px;
		}
		.actions-cell {
			position: static !important;
		}
		.dropdown {
			position: static !important;
		}
		.table-container {
			position: relative;
		}
	</style>
{% endblock %}

{% block body %}

	<main>
		<h1 class="h3 mb-3">Venues</h1>

		<nav aria-label="breadcrumb">
			<ol class="breadcrumb">
				<li class="breadcrumb-item">
					<a href="{{ app_url }}/panel/home">Home</a>
				</li>
				<li class="breadcrumb-item active" aria-current="page">Venues /Requests</li>
			</ol>
		</nav>

		<section class="card">
			<div class="card-body">
				<div class="d-flex flex-wrap mb-3 btn-group-status">
					{% for status in statuses %}
						<a href="{{ app_url }}/panel/venues/requests?status={{ status }}" class="btn btn-outline-primary {% if status == statusPage %}active{% endif %}">
							{{ status | upper }}
							{% if status == statusPage %}
								<span class="badge bg-white text-primary ms-1">{{ requests|length }}</span>
							{% endif %}
						</a>
					{% endfor %}
				</div>

				<div class="table-container">
					<div class="table-responsive">
						{% if requests|length > 0 %}
							<table class="table table-striped table-bordered text-center">
								<thead class="table-dark">
									<tr>
										<th>Id</th>
										<th>Name</th>
										<th>Email</th>
										<th>Phone</th>
										<th>Profile Type</th>
										<th>Profile Name</th>
										<th>Profile Address</th>
										<th>Status</th>
										<th>Created At</th>
										<th class="actions-cell">Actions</th>
									</tr>
								</thead>
								<tbody>
									{% for request in requests %}
										<tr>
											<td>{{ request.id }}</td>
											<td>{{ request.client_name }}</td>
											<td>
												<a href="mailto:{{ request.client_email }}" class="text-decoration-none">
													{{ request.client_email }}
												</a>
											</td>
											<td>
												<a href="tel:{{ request.client_phone }}" class="text-decoration-none">
													{{ request.client_phone }}
												</a>
											</td>
											<td>
												<span class="badge bg-info">{{ request.profile_cat | upper }}</span>
											</td>
											<td>{{ request.profile_name }}</td>
											<td>{{ request.profile_address ?? 'N/A' }}</td>
											<td>
												<span class="badge status-badge bg-{% if request.status == 'completed' %}success{% elseif request.status == 'pending' %}warning{% elseif request.status == 'contacted' %}info{% else %}secondary{% endif %}">
													{{ request.status | upper }}
												</span>
											</td>
											<td>{{ request.created_at }}</td>
											<td class="actions-cell">
												<div class="dropdown">
													<button class="btn btn-secondary btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false">
														Actions
														{{ macros.icon('more-horizontal') }}
													</button>
													<ul class="dropdown-menu dropdown-menu-end">
														<li>
															<form method="post" class="notes-form">
																{{ macros.csrf() }}
																<input type="hidden" name="id" value="{{ request.id }}"/>
																<div class="px-3 py-2">
																	<label class="form-label small fw-bold">Admin Notes:</label>
																	<textarea name="notes" placeholder="Add notes..." class="form-control form-control-sm mb-2" rows="3">{{ request.notes ?? '' }}</textarea>
																	<button type="submit" class="btn btn-sm btn-primary w-100">
																		{{ macros.icon('save') }}
																		Save Notes
																	</button>
																</div>
															</form>
														</li>

														<li><hr class="dropdown-divider"></li>

														<li>
															<a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#detailsModal{{ request.id }}">
																{{ macros.icon('eye') }}
																View Details
															</a>
														</li>
														<li>
															<a class="dropdown-item" href="mailto:{{ request.client_email }}">
																{{ macros.icon('mail') }}
																Send Email
															</a>
														</li>
														<li>
															<a class="dropdown-item" href="tel:{{ request.client_phone }}">
																{{ macros.icon('phone') }}
																Call Client
															</a>
														</li>

														<li><hr class="dropdown-divider"></li>
														<li class="px-3 py-1">
															<small class="text-muted fw-bold">Change Status:</small>
														</li>

														{% for status in statuses %}
															{% if status != request.status %}
																<li>
																	<form method="post" class="d-inline">
																		{{ macros.csrf() }}
																		<input type="hidden" name="id" value="{{ request.id }}"/>
																		<input type="hidden" name="status" value="{{ status }}"/>
																		<button type="submit" class="dropdown-item">
																			{% if status == 'pending' %}
																				{{ macros.icon('clock') }}
																			{% elseif status == 'contacted' %}
																				{{ macros.icon('phone-call') }}
																			{% elseif status == 'completed' %}
																				{{ macros.icon('check-circle') }}
																			{% elseif status == 'cancelled' %}
																				{{ macros.icon('x-circle') }}
																			{% endif %}
																			Set to
																			{{ status | title }}
																		</button>
																	</form>
																</li>
															{% endif %}
														{% endfor %}
													</ul>
												</div>
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						{% else %}
							<div class="text-center py-5">
								<div class="mb-3">
									{{ macros.icon('inbox', 'text-muted', 48) }}
								</div>
								<h5 class="text-muted">No
									{{ statusPage | title }}
									Requests</h5>
								<p class="text-muted">There are currently no requests with "{{ statusPage }}" status.</p>
								{% if statusPage != 'pending' %}
									<a href="{{ app_url }}/panel/venues?status=pending" class="btn btn-primary">
										View Pending Requests
									</a>
								{% endif %}
							</div>
						{% endif %}
					</div>
				</div>
			</div>
		</section>
	</main>

	{% for request in requests %}
		<div class="modal fade" id="detailsModal{{ request.id }}" tabindex="-1" aria-labelledby="detailsModalLabel{{ request.id }}" aria-hidden="true">
			<div class="modal-dialog modal-xl">
				<div class="modal-content">
					<div class="modal-header bg-primary text-white">
						<h5 class="modal-title" id="detailsModalLabel{{ request.id }}">
							{{ macros.icon('user') }}
							Venue Request Details -
							{{ request.client_name }}
						</h5>
						<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="modal-body">
						<div class="row">
							<div class="col-md-6">
								<h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
									{{ macros.icon('user') }}
									Client Information
								</h6>
								<table class="table table-sm table-striped">
									<tr>
										<td class="fw-bold" style="width: 30%;">ID:</td>
										<td>{{ request.id }}</td>
									</tr>
									<tr>
										<td class="fw-bold">Name:</td>
										<td>{{ request.client_name }}</td>
									</tr>
									<tr>
										<td class="fw-bold">Email:</td>
										<td>
											<a href="mailto:{{ request.client_email }}" class="text-decoration-none">
												{{ request.client_email }}
											</a>
										</td>
									</tr>
									<tr>
										<td class="fw-bold">Phone:</td>
										<td>
											<a href="tel:{{ request.client_phone }}" class="text-decoration-none">
												{{ request.client_phone }}
											</a>
										</td>
									</tr>
									<tr>
										<td class="fw-bold">Address:</td>
										<td>{{ request.client_address ?? 'N/A' }}</td>
									</tr>
								</table>
							</div>

							<div class="col-md-6">
								<h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
									{{ macros.icon('tag') }}
									Profile & Status
								</h6>
								<table class="table table-sm table-striped">
									<tr>
										<td class="fw-bold" style="width: 30%;">Profile Category:</td>
										<td>
											<span class="badge bg-info">{{ request.profile_cat | upper }}</span>
										</td>
									</tr>
									<tr>
										<td class="fw-bold">Profile ID:</td>
										<td>{{ request.profile_id ?? 'N/A' }}</td>
									</tr>
									<tr>
										<td class="fw-bold">Profile Name:</td>
										<td>{{ request.profile_name ?? 'N/A' }}</td>
									</tr>
									<tr>
										<td class="fw-bold">Profile Address:</td>
										<td>{{ request.profile_address ?? 'N/A' }}</td>
									</tr>
									<tr>
										<td class="fw-bold">Status:</td>
										<td>
											<span class="badge status-badge bg-{% if request.status == 'completed' %}success{% elseif request.status == 'pending' %}warning{% elseif request.status == 'contacted' %}info{% else %}secondary{% endif %}">
												{{ request.status | upper }}
											</span>
										</td>
									</tr>
									<tr>
										<td class="fw-bold">Created At:</td>
										<td>{{ request.created_at }}</td>
									</tr>
								</table>
							</div>
						</div>

						<div class="row mt-4">
							<div class="col-12">
								<h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
									{{ macros.icon('calendar') }}
									Event Information
								</h6>
								<div class="row">
									<div class="col-md-6">
										<table class="table table-sm table-striped">
											<tr>
												<td class="fw-bold" style="width: 40%;">Event Date:</td>
												<td>{{ request.event_date ?? 'N/A' }}</td>
											</tr>
											<tr>
												<td class="fw-bold">Event Time:</td>
												<td>{{ request.event_time ?? 'N/A' }}</td>
											</tr>
											<tr>
												<td class="fw-bold">Event Duration:</td>
												<td>{{ request.event_duration ?? 'N/A' }}</td>
											</tr>
										</table>
									</div>
									<div class="col-md-6">
										<table class="table table-sm table-striped">
											<tr>
												<td class="fw-bold" style="width: 40%;">Event Type:</td>
												<td>{{ request.event_type ?? 'N/A' }}</td>
											</tr>
											<tr>
												<td class="fw-bold">Number of Guests:</td>
												<td>{{ request.guests ?? 'N/A' }}</td>
											</tr>
											<tr>
												<td class="fw-bold">Budget:</td>
												<td>
													{% if request.budget %}
														<span class="text-success fw-bold">
															${{ request.budget | number_format(2) }}
														</span>
													{% else %}
														N/A
													{% endif %}
												</td>
											</tr>
										</table>
									</div>
								</div>
							</div>
						</div>

						{% if request.details %}
							<div class="row mt-4">
								<div class="col-12">
									<h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
										{{ macros.icon('file-text') }}
										Event Details
									</h6>
									<div class="bg-light p-3 rounded border">
										{{ request.details | nl2br }}
									</div>
								</div>
							</div>
						{% endif %}

						{% if request.notes %}
							<div class="row mt-4">
								<div class="col-12">
									<h6 class="fw-bold text-primary border-bottom pb-2 mb-3">
										{{ macros.icon('sticky-note') }}
										Admin Notes
									</h6>
									<div class="bg-warning bg-opacity-10 p-3 rounded border-start border-warning border-4">
										{{ request.notes | nl2br }}
									</div>
								</div>
							</div>
						{% endif %}
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
							{{ macros.icon('x') }}
							Close
						</button>
						<a href="mailto:{{ request.client_email }}" class="btn btn-primary">
							{{ macros.icon('mail') }}
							Send Email
						</a>
						<a href="tel:{{ request.client_phone }}" class="btn btn-success">
							{{ macros.icon('phone') }}
							Call Client
						</a>
					</div>
				</div>
			</div>
		</div>
	{% endfor %}

{% endblock %}
