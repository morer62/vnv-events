{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<main>
    <h1 class="h3 mb-3 text-center">Venue Listing & Promotion</h1>

    <nav aria-label="breadcrumb" class="text-center">
        <ol class="breadcrumb justify-content-center">
            <li class="breadcrumb-item"><a href="{{ path('panel/home') }}">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">My Venues</li>
        </ol>
    </nav>

    <div class="alert alert-info alert-dismissible fade show text-center" role="alert">
        📢 Your service will be promoted across our associated listings, helping boost your online visibility through active campaigns.<br><br>
            📢 Negative reviews are reviewed to prevent false claims and protect your reputation. We take real issues seriously, but don't worry — our goal is always fairness. 
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>

    <section class="card w-100 shadow-lg">
        <div class="card-body">
            {% if canCreateVenue %}
            <a class="btn btn-secondary mb-3" href="{{ path('panel/venues/create') }}">Add</a> 
            {% else %}
            <div class="alert alert-warning mb-3">
                <strong>Venue Limit Reached:</strong> You can only have one venue. To create a new one, please delete your existing venue first.
            </div>
            {% endif %} 
            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle text-center" style="min-width: 768px;">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Address</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Payment Status</th>
                                <th>Expiration date</th>
                            <th>Client Requests</th> 
                            <th>More & Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for venue in venues %}
                            <tr>
                                <td style="min-width: 160px;">{{ venue.name }}</td>
                                <td style="min-width: 240px;">{{ venue.address }}</td>
                                <td style="min-width: 160px;">
                                    {{
                                        categories
                                        | filter(c => c.id == venue.category_id)
                                        | first.name
                                    }}
                                </td>
                                <td style="min-width: 160px;">
                                    {{ venue.status }}
                                    {% if venue.status == "APPROVED" and venue.sync_origins is defined and venue.sync_origins|length > 0 %}
                                        <hr>
                                        <button class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#syncModal{{ venue.id }}">🌐 View Listings</button>
                                    {% endif %}
                                    {% if venue.status == "APPROVED" %}
                                    <hr> 
                                    <a href="{{ path('/search/venue/details?id=' ~ venue.id) }}">Public Profile</a>
                                {% endif %}
                                </td>
                                <td style="min-width: 160px;">
                                    {% if venue.status == "APPROVED" %}
                                        {% if hasVenueDiscount or venue.payment_status == "PAID" %}
                                            <small class="text-muted d-block fst-italic mt-1">
                                                ✅ Covered by Membership
                                            </small>
                                        {% else %}
                                            <span class="badge bg-danger">❌ Not Paid</span><br>
                                            <a href="{{ path('panel/membership/pay') }}" class="btn btn-sm btn-warning mt-2">Pay Membership</a>
                                        {% endif %}
                                    {% else %}
                                        <small class="text-muted d-block fst-italic">
                                            Under review — ${{ hasVenueDiscount ? VENUE_PAYMENT_AMOUNT_WITH_MEMBERSHIP_DISCOUNT : VENUE_PAYMENT_AMOUNT }}/mo subscription will activate upon approval.
                                        </small>
                                    {% endif %}
                                </td>
            <td style="min-width: 240px;">{{ venue.expiration_date }}</td>
                                <td style="min-width: 140px;">
                                    {% set count = venue.request_count ?? 0 %}
                                    {% if count > 0 %}
                                        <a href="{{ path('panel/venues/requests?id=' ~ venue.id) }}" class="btn btn-sm btn-outline-primary">
                                            {{ count }} Request{{ count > 1 ? 's' : '' }}
                                        </a>
                                    {% else %}
                                        <span class="text-muted">0</span>
                                    {% endif %}
                                </td>

                         
                                <td style="min-width: 160px;">
                                    <div class="dropdown">
                                        <button class="btn btn-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            More {{ macros.icon('more-horizontal') }}
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item" href="{{ path('panel/events/home?id=' ~ venue.id) }}">Add Events</a></li>
                                            <li><a class="dropdown-item" href="{{ path('panel/venue-promotions/home?id=' ~ venue.id) }}">Add Packages & Promos</a></li>
                                            <li><a class="dropdown-item" href="{{ path('panel/venue-photos/home?id=' ~ venue.id) }}">Add Photos</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li><a class="dropdown-item" href="{{ path('panel/venues/edit?id=' ~ venue.id) }}">Edit Venue</a></li>
                                            <li>
                                                <form method="post" form-delete>
                                                    <input type="hidden" name="action" value="delete" />
                                                    <input type="hidden" name="id" value="{{ venue.id }}">
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>

                            {% if venue.sync_origins is defined and venue.sync_origins|length > 0 %}
                                <div class="modal fade" id="syncModal{{ venue.id }}" tabindex="-1" aria-labelledby="syncModalLabel{{ venue.id }}" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-lg">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="syncModalLabel{{ venue.id }}">🌐 Listings for {{ venue.name }}</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <ul class="list-group">
                                                    {% for origin in venue.sync_origins %}
                                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                                            <span>
                                                                <strong>{{ origin.origin }}</strong>
                                                                <br>
                                                                <small class="text-muted">{{ origin.url }}</small>
                                                            </span>
                                                            <a href="{{ origin.url }}" target="_blank" class="btn btn-sm btn-outline-primary">Visit</a>
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</main>
{% endblock %}
