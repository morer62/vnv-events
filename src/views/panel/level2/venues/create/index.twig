{% extends 'templates/base.admin.twig' %}

{% block style %}
    <style>
    .disabled-input {
    background-color: #f1f1f1 !important;
    cursor: not-allowed;
    opacity: 0.7;
    }
    </style>
    <!-- CSS del editor -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/trumbowyg@2.27.3/dist/ui/trumbowyg.min.css">

{% endblock %}

{% block body %}
<div class="container-fluid h-100 d-flex flex-column justify-content-center p-3">
    <div class="text-center mb-4">
        <img src="{{ asset_for('assets/images/vnv-logo.webp') }}" alt="Logo" width="180px">
        <h1 class="h3 mt-3">Venue Details</h1>
    </div>

    {% if message %}
    <div class="alert alert-danger alert-dismissible fade show text-center" role="alert">
        {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
{% endif %}




    <form method="post" enctype="multipart/form-data" id="venueForm" class="card shadow-lg p-4 w-100">
        {# STEP 1 - General Info #}
        <div id="step-1" class="venue-step">
            <h4 class="mb-3">Step 1: General Information</h4>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Venue Name</label>
                    <input class="form-control" name="name" required type="text" maxlength="120"/>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Category</label>
                    <select class="form-select" name="category_id" required>
                        <option value="">Select a category</option>
                        {% for cat in categories %}
                            <option value="{{ cat.id }}">{{ cat.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 mb-3">
                    <label class="form-label">Additional categories (optional)</label>
                    <div class="border rounded p-2" style="max-height: 220px; overflow:auto;">
                        {% for cat in categories %}
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="extra_categories[]" value="{{ cat.id }}" id="cat-{{ cat.id }}">
                                <label class="form-check-label" for="cat-{{ cat.id }}">{{ cat.name }}</label>
                            </div>
                        {% endfor %}
                    </div>
                    <small class="text-muted">Check all that apply. The main category won't be duplicated.</small>
                </div>
                <div class="col-12 mb-3">
                    <label class="form-label">Description</label> 
                    <textarea class="form-control" name="description" id="description-editor" required></textarea>


                </div>
                <div class="col-12 mb-3">
                    <label class="form-label">Address</label>
                    <input id="autocomplete-address" placeholder="Enter your address" class="form-control" name="address" required data-places />
                </div>
            </div>
        </div>

     
        {# STEP 2 - Contact #}
        <div id="step-2" class="venue-step d-none">
            <h4 class="mb-3">Step 2: Contact and Social Links</h4>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Phone Number</label>
                    <input class="form-control" name="phone_number" type="text" data-phone required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Email</label>
                    <input class="form-control" name="email" type="text"  maxlength="120" required placeholder="example@email.com" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Website</label>
                    <input class="form-control" name="website" type="url"  maxlength="120" placeholder="https://yourwebsite.com" />
                    <small class="text-muted">Include the full link like <code>https://yourwebsite.com</code></small>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Instagram</label>
                    <input class="form-control" name="instagram" type="url" placeholder="https://instagram.com/yourprofile" />
                    <small class="text-muted">e.g. <code>https://instagram.com/yourprofile</code></small>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Facebook</label>
                    <input class="form-control" name="facebook" type="url" placeholder="https://facebook.com/yourpage" />
                    <small class="text-muted">e.g. <code>https://facebook.com/yourpage</code></small>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Twitter</label>
                    <input class="form-control" name="twitter" type="url" placeholder="https://twitter.com/yourhandle" />
                    <small class="text-muted">e.g. <code>https://twitter.com/yourhandle</code></small>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Yelp</label>
                    <input class="form-control" name="yelp" type="url" placeholder="https://yelp.com/biz/yourlisting" />
                    <small class="text-muted">e.g. <code>https://yelp.com/biz/yourlisting</code></small>
                </div>
            </div>
        </div>


        {# STEP 3 - Legal Info #}
        <div id="step-3" class="venue-step d-none">
            <h4 class="mb-3">Step 3: Business Information</h4>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Business Legal Name</label>
                    <input class="form-control" name="business_name" type="text" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">EIN (Tax ID)</label>
                    <input class="form-control" name="ein" type="text" required />
                </div>
            </div>
        </div>

        {# STEP 4 - Features & Amenities #}
        <div id="step-4" class="venue-step d-none">
            <h4 class="mb-3">Step 4: Features & Amenities</h4>
            <div class="row">
                <div class="col-md-6 mb-3">
                    
                        <label class="form-label">Guest Capacity</label>
                        <div class="input-group">
                            <span class="input-group-text">Up to</span>
                            <input class="form-control" name="capacity" type="number" min="1" placeholder="Enter number of guests">
                            <span class="input-group-text">guests</span>
                        </div>
                     
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Base Price ($)</label>
                    <input type="range" name="price" class="form-range" min="0" max="10000" step="50" id="priceRange" oninput="priceOutput.value = '$' + priceRange.value">
                    <output id="priceOutput">$0</output>
                </div>

                <div class="col-12 mb-3">
                    <label class="form-label">Included Services</label>
                    {% set inclusions = ['All-inclusive: Full food, beverage, rentals', 'Raw space: Only the space', 'Select services: Some basic add-ons'] %}
                    {% for item in inclusions %}
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="services[]" value="{{ item }}">
                        <label class="form-check-label">{{ item }}</label>
                    </div>
                    {% endfor %}
                </div>

                <div class="col-12 mb-3">
                    <label class="form-label">Indoor/Outdoor Type</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="indoor_outdoor_type" value="outdoor" id="outdoor">
                        <label class="form-check-label" for="outdoor">Open-air outdoor space</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="indoor_outdoor_type" value="indoor" id="indoor">
                        <label class="form-check-label" for="indoor">Fully enclosed indoor venue</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="indoor_outdoor_type" value="covered" id="covered">
                        <label class="form-check-label" for="covered">Partially covered outdoor areas</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="indoor_outdoor_type" value="covered" id="covered">
                        <label class="form-check-label" for="indoor_and_outdoor">Indoor and Outdoor Areas</label>
                    </div>
                    
                    
                </div>


                <div class="col-12 mb-3">
                    <label class="form-label">Amenities</label>
                    {% set amenities = [
                        'Bar services', 'Catering services', 'Clean up', 'Dance floor', 'Dressing room / bridal suite',
                        'Event coordinator', 'Event rentals', 'Event staff', 'Liability insurance',
                        'Lighting/sound', 'On-site accommodations', 'Pet friendly', 'Service staff',
                        'Set up', 'Transportation', 'Wedding cake services', 'Wheelchair accessible', 'Wifi'
                    ] %}
                    <div class="row">
                        {% for item in amenities %}
                        <div class="col-md-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="amenities[]" value="{{ item }}">
                                <label class="form-check-label">{{ item }}</label>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        {# STEP 5 - Weekly Availability #}
        <div id="step-5" class="venue-step d-none">
            <h4 class="mb-3">Step 5: Weekly Availability</h4>
            <p>Set the working hours for each day of the week:</p>
            <div class="row">
                {% set days = {
                    'mon': 'Monday',
                    'tue': 'Tuesday',
                    'wed': 'Wednesday',
                    'thu': 'Thursday',
                    'fri': 'Friday',
                    'sat': 'Saturday',
                    'sun': 'Sunday'
                } %}

                {% for key, label in days %}
                <div class="col-md-6 mb-3">
                    <label class="form-label">{{ label }}</label>
                    <div class="input-group">
                    <input type="time" class="form-control time-input" name="availability[{{ key }}][from]" id="from-{{ key }}">
                    <span class="input-group-text">to</span>
                    <input type="time" class="form-control time-input" name="availability[{{ key }}][to]" id="to-{{ key }}">
                    </div>
                    <div class="form-check mt-2">
                    <input type="checkbox" class="form-check-input" id="closed-{{ key }}" name="availability[{{ key }}][closed]" onchange="toggleDayAvailability('{{ key }}')">
                    <label class="form-check-label text-danger">Closed</label>
                    </div>
                </div>
                {% endfor %}
            </div>
            </div>



        <div class="d-flex justify-content-between mt-4">
            <button type="button" class="btn btn-secondary" onclick="previousStep()">Back</button>
            <button type="button" class="btn btn-primary" onclick="nextStep()">Next</button>
            <button type="submit" class="btn btn-success d-none" id="submitBtn">Create Venue</button>
        </div>
    </form>
</div>



 <!-- JS del editor -->
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/trumbowyg@2.27.3/dist/trumbowyg.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        $('#description-editor').trumbowyg();

        showStep(currentStep);

        const days = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];
        days.forEach(toggleDayAvailability);
    });
</script>


<script>
    let currentStep = 1;
    function showStep(step) {
        document.querySelectorAll('.venue-step').forEach((el, index) => {
            el.classList.toggle('d-none', index !== step - 1);
        });
        document.getElementById('submitBtn').classList.toggle('d-none', step !== 5); 
        document.querySelector('button.btn-primary').classList.toggle('d-none', step === 5);

    }

    function toggleDayAvailability(day) {
        const isClosed = document.getElementById(`closed-${day}`).checked;
        const fromInput = document.getElementById(`from-${day}`);
        const toInput = document.getElementById(`to-${day}`);

        fromInput.disabled = isClosed;
        toInput.disabled = isClosed;

        fromInput.classList.toggle('disabled-input', isClosed);
        toInput.classList.toggle('disabled-input', isClosed);
        }

        document.addEventListener('DOMContentLoaded', function () {
        const days = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];
        days.forEach(toggleDayAvailability);
        });
    
    function validateCurrentStep() {
        const currentStepForm = document.querySelector(`#step-${currentStep}`);
        const requiredFields = currentStepForm.querySelectorAll('[required]');
            for (const field of requiredFields) {
                if (!field.value || (field.tagName === 'SELECT' && field.selectedIndex === 0)) {
                    alert(`Please fill out the field: ${field.name.replace(/_/g, ' ')}`);
                    field.focus();
                    return false;
                }
            }
            return true;
    }


    function nextStep() {
    if (!validateCurrentStep()) return;
        if (currentStep < 5) {
            currentStep++;
            showStep(currentStep);
        }
    }


    function previousStep() {
        if (currentStep > 1) {
            currentStep--;
            showStep(currentStep);
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        showStep(currentStep);
    });



    document.getElementById('venueForm').addEventListener('submit', function (e) {
        const form = this;
        const invalid = form.querySelector(':invalid');

        const mainCat = document.querySelector('select[name="category_id"]').value;
        const extraChecks = document.querySelectorAll('input[name="extra_categories[]"]');
        if (extraChecks.length > 0 && mainCat) {
            extraChecks.forEach(chk => {
                if (chk.value === mainCat && chk.checked) {
                    chk.checked = false;
                }
            });
        }

        if (invalid) {
            e.preventDefault();

            const stepWithError = invalid.closest('.venue-step');
            if (stepWithError) {
                const stepId = stepWithError.id;
                const stepNum = parseInt(stepId.replace('step-', ''));
                if (!isNaN(stepNum)) {
                    currentStep = stepNum;
                    showStep(currentStep);
                    invalid.focus();
                }
            }
        }
    });
 


   

 
    

</script>
{% endblock %}
