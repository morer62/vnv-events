{% extends 'templates/base.admin.twig' %}

{% block body %}
<div class="container-fluid py-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h1 class="h4 mb-2">👥 Guest List - {{ event.event_name }}</h1>
                    <p class="text-muted mb-0">
                        <i class="bi bi-calendar"></i> {{ event.event_date|date('F j, Y') }} at {{ event.event_time|date('g:i A') }}
                    </p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="{{ path('panel/event-invitations') }}" class="btn btn-outline-secondary shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Back to Events
                    </a>
                    <a href="{{ path('panel/event-invitations/guests/export') }}?id={{ event.id }}" class="btn btn-info text-white shadow-sm">
                        <i class="bi bi-download me-1"></i> Export
                    </a>
                    <button class="btn btn-success shadow-sm" data-bs-toggle="modal" data-bs-target="#addGuestModal">
                        <i class="bi bi-person-plus me-1"></i> Add Guest
                    </button>
                    <button class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#importModal">
                        <i class="bi bi-file-earmark-excel me-1"></i> Import
                    </button>
                </div>
            </div>
        </div>
    </div>

    {% if message %}
    <div class="alert alert-{{ message.type|default('success') }} alert-dismissible fade show" role="alert">
        {{ message.message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    {% endif %}

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-2">Total Invited</h6>
                    <h2 class="mb-0">{{ stats.total_invited }}</h2>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm bg-white text-white">
                <div class="card-body text-center">
                    <h6 class="opacity-75 mb-2">Confirmed</h6>
                    <h2 class="mb-0">{{ stats.total_confirmed }}</h2>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card border-0  bg-white text-white">
                <div class="card-body text-center">
                    <h6 class="opacity-75 mb-2">Total Attending</h6>
                    <h2 class="mb-0">{{ stats.total_attending }}</h2>
                    <small class="opacity-50 text-black">+{{ stats.total_plus_ones }} plus ones</small>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-2">Response Rate</h6>
                    <h2 class="mb-0">{{ stats.response_rate }}%</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs and Actions Bar -->
    <div class="card mb-4 shadow-sm border-0">
        <div class="card-body p-0">
            <!-- Tabs -->
            <div class="border-bottom p-3">
                <ul class="nav nav-tabs border-0 mb-0" id="guestTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="pending-tab" data-bs-toggle="tab" data-bs-target="#pending" type="button" role="tab">
                            📤 Not Sent ({{ guests|filter(g => g.invitation_sent == 0)|length }})
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="sent-tab" data-bs-toggle="tab" data-bs-target="#sent" type="button" role="tab">
                            ✅ Sent ({{ guests|filter(g => g.invitation_sent == 1)|length }})
                        </button>
                    </li>
                </ul>
            </div>
            
            <!-- Search and Actions -->
            <div class="p-3">
                <div class="row align-items-center g-3">
                    <!-- Search -->
                    <div class="col-lg-6">
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" 
                                   class="form-control" 
                                   id="searchInput" 
                                   placeholder="Search by name or email..."
                                   onkeyup="filterGuests()">
                            <button class="btn btn-outline-secondary" type="button" onclick="clearSearch()">
                                <i class="bi bi-x-circle"></i> Clear
                            </button>
                        </div>
                    </div>
                    
                    <!-- Actions -->
                    <div class="col-lg-6">
                        <form method="post" id="bulkActionForm" class="m-0">
                            <input type="hidden" name="event_id" value="{{ event.id }}">
                            <div class="d-flex align-items-center justify-content-end gap-3">
                                <span class="text-muted small">
                                    <strong class="text-dark"><span id="selectedCount">0</span></strong> selected
                                </span>
                                <button type="button" class="btn btn-primary shadow-sm" onclick="sendInvitations()">
                                    <i class="bi bi-envelope-fill me-1"></i> Send Invitations
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab Content -->
    <div class="tab-content" id="guestTabContent">
        <!-- Not Sent Tab -->
        <div class="tab-pane fade show active" id="pending" role="tabpanel">
            {% set pendingGuests = guests|filter(g => g.invitation_sent == 0) %}
            <div class="card shadow-sm">
                <div class="card-body">
                    {% if pendingGuests|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th width="50">
                                <input type="checkbox" id="selectAll" onchange="toggleSelectAll()">
                            </th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Group</th>
                            <th>Invitation</th>
                            <th>RSVP</th>
                            <th>Plus Ones</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for guest in pendingGuests %}
                        <tr>
                            <td>
                                <input type="checkbox" class="guest-checkbox" value="{{ guest.id }}" onchange="updateSelectedCount()">
                            </td>
                            <td>
                                <strong>{{ guest.first_name }} {{ guest.last_name }}</strong>
                            </td>
                            <td>{{ guest.email }}</td>
                            <td>{{ guest.phone ?? '-' }}</td>
                            <td>
                                <span class="badge bg-secondary">{{ guest.guest_group ?? 'General' }}</span>
                            </td>
                            <td>
                                {% if guest.invitation_sent %}
                                    <i class="bi bi-check-circle text-success"></i> Sent
                                    {% if guest.invitation_opened %}
                                        <br><small class="text-muted">Opened</small>
                                    {% endif %}
                                {% else %}
                                    <i class="bi bi-x-circle text-danger"></i> Not sent
                                {% endif %}
                            </td>
                            <td>
                                {% if guest.rsvp_status == 'confirmed' %}
                                    <span class="badge bg-success">Confirmed</span>
                                {% elseif guest.rsvp_status == 'declined' %}
                                    <span class="badge bg-danger">Declined</span>
                                {% elseif guest.rsvp_status == 'tentative' %}
                                    <span class="badge bg-warning">Tentative</span>
                                {% else %}
                                    <span class="badge bg-secondary">Pending</span>
                                {% endif %}
                            </td>
                            <td>{{ guest.plus_ones }}</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-info text-white shadow" onclick="viewGuest({{ guest.id }})" title="View Details">
                                        <i class="bi bi-eye-fill me-1"></i> View
                                    </button>
                                    <button class="btn btn-sm btn-danger shadow" onclick="deleteGuest({{ guest.id }})" title="Delete">
                                        <i class="bi bi-trash-fill me-1"></i> Delete
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <div class="text-center py-5">
                <i class="bi bi-envelope-x" style="font-size: 4rem; color: #ccc;"></i>
                <h4 class="mt-3">No pending invitations</h4>
                <p class="text-muted">All invitations have been sent!</p>
            </div>
            {% endif %}
                </div>
            </div>
        </div>

        <!-- Sent Tab -->
        <div class="tab-pane fade" id="sent" role="tabpanel">
            {% set sentGuests = guests|filter(g => g.invitation_sent == 1) %}
            <div class="card shadow-sm">
                <div class="card-body">
                    {% if sentGuests|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Phone</th>
                                    <th>Group</th>
                                    <th>Opened</th>
                                    <th>RSVP</th>
                                    <th>Plus Ones</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for guest in sentGuests %}
                                <tr>
                                    <td>
                                        <strong>{{ guest.first_name }} {{ guest.last_name }}</strong>
                                    </td>
                                    <td>{{ guest.email }}</td>
                                    <td>{{ guest.phone ?? '-' }}</td>
                                    <td>
                                        <span class="badge bg-secondary">{{ guest.guest_group ?? 'General' }}</span>
                                    </td>
                                    <td>
                                        {% if guest.invitation_opened %}
                                            <span class="badge bg-success"><i class="bi bi-envelope-open-fill"></i> Yes</span>
                                        {% else %}
                                            <span class="badge bg-warning"><i class="bi bi-envelope-fill"></i> No</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if guest.rsvp_status == 'confirmed' %}
                                            <span class="badge bg-success">✅ Confirmed</span>
                                        {% elseif guest.rsvp_status == 'declined' %}
                                            <span class="badge bg-danger">❌ Declined</span>
                                        {% elseif guest.rsvp_status == 'tentative' %}
                                            <span class="badge bg-warning">⏳ Tentative</span>
                                        {% else %}
                                            <span class="badge bg-secondary">⏱️ Pending</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if guest.plus_ones > 0 %}
                                            <span class="badge bg-primary">+{{ guest.plus_ones }}</span>
                                        {% else %}
                                            -
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-sm btn-info text-white shadow" onclick="viewGuest({{ guest.id }})" title="View Details">
                                                <i class="bi bi-eye-fill me-1"></i> View
                                            </button>
                                            <button class="btn btn-sm btn-danger shadow" onclick="deleteGuest({{ guest.id }})" title="Delete">
                                                <i class="bi bi-trash-fill me-1"></i> Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <div class="text-center py-5">
                        <i class="bi bi-envelope-check" style="font-size: 4rem; color: #ccc;"></i>
                        <h4 class="mt-3">No sent invitations yet</h4>
                        <p class="text-muted">Select guests from "Not Sent" tab to send invitations</p>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Guest Modal -->
<div class="modal fade" id="addGuestModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Add Guest</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="action" value="add_guest">
                    <input type="hidden" name="event_id" value="{{ event.id }}">
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">First Name *</label>
                            <input type="text" name="first_name" class="form-control" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Last Name *</label>
                            <input type="text" name="last_name" class="form-control" required>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label">Email *</label>
                            <input type="email" name="email" class="form-control" required>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label">Phone</label>
                            <input type="tel" name="phone" class="form-control" data-phone>
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label">Guest Group</label>
                            <select name="guest_group" class="form-select">
                                <option value="">Select group</option>
                                <option value="family">Family</option>
                                <option value="friends">Friends</option>
                                <option value="coworkers">Coworkers</option>
                                <option value="vip">VIP</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Guest</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Guest Details Modal -->
<div class="modal fade" id="guestDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">👤 Guest Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="guestDetailsContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-3">Loading...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Import Excel Modal -->
<div class="modal fade" id="importModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" enctype="multipart/form-data">
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-file-earmark-excel me-2"></i>Import Guests from Excel</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="action" value="import_excel">
                    <input type="hidden" name="event_id" value="{{ event.id }}">
                    
                    <div class="alert alert-success">
                        <h6>📊 Easy 3-Step Process:</h6>
                        <ol class="mb-0">
                            <li><strong>Download</strong> the Excel template (empty file with headers)</li>
                            <li><strong>Fill</strong> in your guests in Excel (one per row)</li>
                            <li><strong>Upload</strong> the Excel file (.xlsx) back here</li>
                        </ol>
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold">Step 1: Download Template</label>
                        <div class="d-grid">
                            <button type="button" class="btn btn-success btn-lg shadow" onclick="downloadExcelTemplate()">
                                <i class="bi bi-file-earmark-excel me-2"></i> Download Excel Template
                            </button>
                        </div>
                        <small class="text-muted">📄 Empty Excel file ready to fill</small>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Step 2: Upload Your Excel File</label>
                        <input type="file" name="excel_file" class="form-control form-control-lg" accept=".xlsx,.xls" required>
                        <small class="text-muted">📤 Upload the filled Excel file (.xlsx or .xls)</small>
                    </div>

                    <div class="alert alert-warning">
                        <small><strong>💡 Tip:</strong> Only <strong>Email</strong> column is required. Leave other columns empty if you don't have that information.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success shadow">
                        <i class="bi bi-upload me-1"></i> Import Guests
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function updateSelectedCount() {
    const checked = document.querySelectorAll('.guest-checkbox:checked').length;
    document.getElementById('selectedCount').textContent = checked;
}

function toggleSelectAll() {
    const selectAll = document.getElementById('selectAll').checked;
    const activeTab = document.querySelector('.tab-pane.active');
    activeTab.querySelectorAll('.guest-checkbox').forEach(cb => {
        cb.checked = selectAll;
    });
    updateSelectedCount();
}

function toggleSelectAllTab(checkbox) {
    const activeTab = checkbox.closest('.tab-pane');
    activeTab.querySelectorAll('.guest-checkbox').forEach(cb => {
        cb.checked = checkbox.checked;
    });
    updateSelectedCount();
}

function sendInvitations() {
    const selected = Array.from(document.querySelectorAll('.guest-checkbox:checked')).map(cb => cb.value);
    if (selected.length === 0) {
        alert('Please select at least one guest');
        return;
    }
    
    if (confirm(`Send invitations to ${selected.length} guest(s)?`)) {
        const form = document.getElementById('bulkActionForm');
        form.action = '';
        
        // Add hidden inputs for selected guests
        selected.forEach(id => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'guest_ids[]';
            input.value = id;
            form.appendChild(input);
        });
        
        const actionInput = document.createElement('input');
        actionInput.type = 'hidden';
        actionInput.name = 'action';
        actionInput.value = 'send_invitations';
        form.appendChild(actionInput);
        
        form.submit();
    }
}

function deleteGuest(guestId) {
    if (confirm('Are you sure you want to delete this guest?')) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.innerHTML = `
            <input type="hidden" name="action" value="delete_guest">
            <input type="hidden" name="event_id" value="{{ event.id }}">
            <input type="hidden" name="guest_id" value="${guestId}">
        `;
        document.body.appendChild(form);
        form.submit();
    }
}

function downloadExcelTemplate() {
    window.location.href = '{{ path("panel/event-invitations/guests/download-template") }}?event_id={{ event.id }}';
    
    setTimeout(() => {
        const modal = new bootstrap.Modal(document.getElementById('importModal'));
        const alert = document.createElement('div');
        alert.className = 'alert alert-info alert-dismissible fade show mt-3';
        alert.innerHTML = `
            <strong>📥 Template Downloaded!</strong><br>
            1. Open the Excel file<br>
            2. Fill in your guests (columns are labeled)<br>
            3. Save and upload below
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        document.querySelector('#importModal .modal-body').insertBefore(alert, document.querySelector('#importModal .modal-body').firstChild);
    }, 1000);
}

function viewGuest(guestId) {
    const guestsList = {{ guests|json_encode|raw }};
    const guest = guestsList.find((g) => g.id == guestId);
    
    if (!guest) {
        alert('Guest not found');
        return;
    }
    
    let plusOnesNames = [];
    try {
        plusOnesNames = guest.plus_ones_names ? JSON.parse(guest.plus_ones_names) : [];
    } catch(e) {
        plusOnesNames = [];
    }
    
    const content = `
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="text-muted small">First Name</label>
                <div class="fw-bold">${guest.first_name}</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="text-muted small">Last Name</label>
                <div class="fw-bold">${guest.last_name}</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="text-muted small">Email</label>
                <div>${guest.email}</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="text-muted small">Phone</label>
                <div>${guest.phone || '-'}</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="text-muted small">Group</label>
                <div><span class="badge bg-secondary">${guest.guest_group || 'General'}</span></div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="text-muted small">Table Number</label>
                <div>${guest.table_number || 'Not assigned'}</div>
            </div>
        </div>
        <hr>
        <h6 class="mb-3">📨 Invitation Status</h6>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="text-muted small">Invitation Sent</label>
                <div>${guest.invitation_sent ? '✅ Yes - ' + (guest.invitation_sent_at || '') : '❌ No'}</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="text-muted small">Invitation Opened</label>
                <div>${guest.invitation_opened ? '✅ Yes - ' + (guest.invitation_opened_at || '') : '❌ No'}</div>
            </div>
        </div>
        <hr>
        <h6 class="mb-3">💬 RSVP Response</h6>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="text-muted small">Status</label>
                <div>
                    ${guest.rsvp_status == 'confirmed' ? '<span class="badge bg-success">✅ Confirmed</span>' : 
                      guest.rsvp_status == 'declined' ? '<span class="badge bg-danger">❌ Declined</span>' :
                      guest.rsvp_status == 'tentative' ? '<span class="badge bg-warning">⏳ Tentative</span>' :
                      '<span class="badge bg-secondary">⏱️ Pending</span>'}
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="text-muted small">Response Date</label>
                <div>${guest.rsvp_date || '-'}</div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="text-muted small">Plus Ones</label>
                <div>${guest.plus_ones > 0 ? '<span class="badge bg-primary">+' + guest.plus_ones + '</span>' : 'None'}</div>
            </div>
            ${plusOnesNames.length > 0 ? `
            <div class="col-12 mb-3">
                <label class="text-muted small">Plus One Names</label>
                <ul class="mb-0">${plusOnesNames.map(name => '<li>' + name + '</li>').join('')}</ul>
            </div>` : ''}
            ${guest.meal_preference ? `
            <div class="col-md-6 mb-3">
                <label class="text-muted small">Meal Preference</label>
                <div>${guest.meal_preference}</div>
            </div>` : ''}
            ${guest.dietary_restrictions ? `
            <div class="col-12 mb-3">
                <label class="text-muted small">Dietary Restrictions</label>
                <div class="alert alert-warning mb-0">${guest.dietary_restrictions}</div>
            </div>` : ''}
            ${guest.special_notes ? `
            <div class="col-12 mb-3">
                <label class="text-muted small">Special Notes</label>
                <div class="alert alert-info mb-0">${guest.special_notes}</div>
            </div>` : ''}
            ${guest.decline_reason ? `
            <div class="col-12 mb-3">
                <label class="text-muted small">Decline Reason</label>
                <div class="alert alert-danger mb-0">${guest.decline_reason}</div>
            </div>` : ''}
        </div>
    `;
    
    document.getElementById('guestDetailsContent').innerHTML = content;
    
    const modal = new bootstrap.Modal(document.getElementById('guestDetailsModal'));
    modal.show();
}

// Search and filter functionality
function filterGuests() {
    const searchTerm = document.getElementById('searchInput').value.toLowerCase();
    const activeTab = document.querySelector('#guestTabs .nav-link.active').id;
    const isPendingTab = activeTab === 'pending-tab';
    const tableSelector = isPendingTab ? '#pending tbody tr' : '#sent tbody tr';
    const rows = document.querySelectorAll(tableSelector);
    
    let visibleCount = 0;
    rows.forEach(row => {
        const name = row.querySelector('td:nth-child(2)')?.textContent.toLowerCase() || '';
        const email = row.querySelector('td:nth-child(3)')?.textContent.toLowerCase() || '';
        
        if (name.includes(searchTerm) || email.includes(searchTerm)) {
            row.style.display = '';
            visibleCount++;
        } else {
            row.style.display = 'none';
        }
    });
    
    // Update empty message if no results
    const activePane = isPendingTab ? document.getElementById('pending') : document.getElementById('sent');
    const noResultsMsg = activePane.querySelector('.no-results-message');
    if (noResultsMsg) {
        noResultsMsg.remove();
    }
    
    if (visibleCount === 0 && searchTerm !== '') {
        const emptyDiv = document.createElement('div');
        emptyDiv.className = 'text-center py-5 no-results-message';
        emptyDiv.innerHTML = '<i class="bi bi-search display-4 text-muted"></i><p class="text-muted mt-3">No guests found matching "<strong>' + searchTerm + '</strong>"</p>';
        activePane.querySelector('.card-body').appendChild(emptyDiv);
    }
}

function clearSearch() {
    document.getElementById('searchInput').value = '';
    const noResultsMsg = document.querySelectorAll('.no-results-message');
    noResultsMsg.forEach(msg => msg.remove());
    const rows = document.querySelectorAll('#pending tbody tr, #sent tbody tr');
    rows.forEach(row => row.style.display = '');
}

// Reset search when switching tabs
document.querySelectorAll('#guestTabs .nav-link').forEach(tab => {
    tab.addEventListener('click', function() {
        clearSearch();
    });
});
</script>
{% endblock %}

