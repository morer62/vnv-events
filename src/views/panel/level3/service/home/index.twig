{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<main class="container-fluid h-100 d-flex flex-column justify-content-center p-3">
    <h1 class="h3 mb-3 text-center">My Services</h1>

    <nav aria-label="breadcrumb" class="text-center">
        <ol class="breadcrumb justify-content-center">
            <li class="breadcrumb-item"><a href="{{ path('panel/home') }}">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">My Services</li>

        </ol>
    </nav>

    
        <div class="alert alert-info alert-dismissible fade show text-center" role="alert"> 
            📢 Your service will be promoted across our associated listings, helping boost your online visibility through active campaigns.<br><br>
            📢 Negative reviews are reviewed to prevent false claims and protect your reputation. We take real issues seriously, but don't worry — our goal is always fairness.
            </strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

    <section class="card w-100 shadow-lg">
        <div class="card-body">
            {% if canCreateService %}
            <a class="btn btn-secondary mb-3" href="{{ path('panel/service/create') }}">Add</a>
            {% else %}
            <div class="alert alert-warning mb-3">
                <strong>Service Limit Reached:</strong> You can only have one service. To create a new one, please delete your existing service first.
            </div>
            {% endif %}
            <div> 
                <div class="table-responsive">
                    <table class="table table-striped table-bordered align-middle text-center" style="min-width: 768px;">
                    <thead>
                    <tr>
                        
                        <th>Name</th>
                        <th>Address</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th>Expiration date</th>
                        <th>Client Requests</th> {# NUEVA COLUMNA #}
                        <th>More & Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for service in services %}
                    
                        <tr>
                             
                            <td style="min-width: 160px;">{{ service.name }}</td>
                            <td style="min-width: 160px;">{{ service.address }}</td>
                            <td style="min-width: 160px;">
                                {{
                                    categories
                                    | filter(c => c.id == service.category_id)
                                    | first.service_category
                                }}
                            </td>
                            <td style="min-width: 160px;">
                                {{ service.status }}
                                {% if service.status == "APPROVED" %}
                                    <hr> 
                                    <a href="{{ path('/search/vendors/details?id=' ~ service.id) }}">Public Profile</a>
                                {% endif %}
                            </td>
                            <td style="min-width: 160px;">
                                {% if service.status == "APPROVED" %}
                                    {% if hasServiceDiscount or service.payment_status == "PAID" %}
                                        <span class="text-muted d-block fst-italic">✅ Covered by Membership</span>
                                    {% else %}
                                        <span class="badge bg-danger">❌ Not Paid</span><br>
                                        <a href="{{ path('panel/membership/pay') }}" class="btn btn-sm btn-warning mt-2">Pay Membership</a>
                                    {% endif %}
                                {% else %}
                                    <span class="text-muted d-block fst-italic">Under review – Payment of ${{ SERVICE_PAYMENT_AMOUNT_PER_ZIP }}/mowill be enabled upon approval.</span>
                                {% endif %}
                            </td>
                               <td style="min-width: 160px;">{{ service.expiration_date }}</td>
                            <td style="min-width: 140px;">
                                {% set count = service.request_count ?? 0 %}
                                {% if count > 0 %}
                                    <a href="{{ path('panel/service/requests?id=' ~ service.id) }}" class="btn btn-sm btn-outline-primary">
                                        {{ count }} Request{{ count > 1 ? 's' : '' }}
                                    </a>
                                {% else %}
                                    <span class="text-muted">0</span>
                                {% endif %}
                            </td>
 
                            <td style="min-width: 160px;">
                                <div class="dropdown">
                                    <button class="btn btn-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        More {{ macros.icon('more-horizontal') }}
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="{{ path('panel/service-events/home?id=' ~ service.id) }}">View Events</a></li>
                                        <li><a class="dropdown-item" href="{{ path('panel/service-promotions/home?id=' ~ service.id) }}">View Promotions</a></li>
                                        <li><a class="dropdown-item" href="{{ path('panel/service-photos/home?id=' ~ service.id) }}">View Photos</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="{{ path('panel/service/edit?id=' ~ service.id) }}">Edit this service</a></li>
                                        <li>
                                            <form method="post" form-delete>
                                                <input type="hidden" name="action" value="delete" />
                                                <input type="hidden" name="id" value="{{ service.id }}">
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    </section>
</main>
{% endblock %}
