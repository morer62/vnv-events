{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}
{% block body %}

    <h1 class="h3 mb-4">Add New Item</h1>

    {{ macros.breadcrumb2() }}

    <section class="card">
        <div class="card-body">
            <form method="post">

                <div class="mb-3">
                    <label class="form-label">Item Name</label>
                    <input type="text" name="name" class="form-control" placeholder="e.g., White Flowers" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Quantity</label>
                    <input type="number" name="quantity" class="form-control" min="1" placeholder="e.g., 50" required>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary">Save Item</button>
                    <a href="{{ path('panel/planner-hub/management/storage/containers/items?container_id=' ~ container_id) }}" class="btn btn-danger">Cancel</a>
                </div>
            </form>
        </div>
    </section>
{% endblock %}
