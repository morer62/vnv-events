{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
	<h2 class="h3 mb-4">🛠 Workflow Status for Order #vnv-341{{ order.id }}</h2>
	{{ macros.breadcrumb2() }}

	<div class="mb-4">
		<p>
			<strong>🔗 Contract link:</strong>
			<a href="{{ path('/order-access?token=' ~ contract_token) }}" target="_blank">

				Sign Contract
			</a>
		</p>
		{% if order.payment_type == 'two_steps' %}
			<p>
				<strong>💳 Payment link:</strong>
				<a href="{{ path('/order-access?token=' ~ contract_token ~ '#payment') }}" target="_blank">

					Pay Online
				</a>
			</p>
		{% endif %}
	</div>


	<form method="post" enctype="multipart/form-data" class="card mb-4">
		<div class="card-body row g-3">
			<input type="hidden" name="id_order" value="{{ order.id|e }}">

			<div class="col-md-6">
				<label class="form-label">New Status</label>
				<select name="status" class="form-select" required>
					<option value="">Select status...</option>
					<option value="INVOICE_DRAFT">Invoice - Pending Signature</option>
					<option value="INVOICE_READY">Invoice - Signed</option>
					<option value="INVOICE_PARTIAL">Invoice Paid - Partial</option>
					<option value="INVOICE_PAID">Invoice Paid - Full</option>
					<option value="INVOICE_EXPIRED">Invoice Expired</option>
				</select>
			</div>

			<div class="col-md-6">
				<label class="form-label">Upload File (optional)</label>
				<input type="file" name="file" class="form-control" accept=".pdf,.doc,.docx,.jpg,.png">

			</div>

			<div class="col-md-12">
				<label class="form-label">Notes</label>
				<input type="text" name="note" class="form-control" rows="3" placeholder="Please add details about this change..." required>
			</div>

			<div class="col-12 text-end">
				<button class="btn btn-primary">💾 Save Status</button>
			</div>
		</div>
	</form>

	<h5 class="mb-3">📜 Status History</h5>

	<div class="table-responsive">
		<table class="table table-bordered text-center align-middle" style="min-width: 768px;">
			<thead class="table-dark">
				<tr>
					<th style="min-width: 180px;">Status</th>
					<th style="min-width: 250px;">Note</th>
					<th style="min-width: 150px;">File</th>
					<th style="min-width: 120px;">By</th>
					<th style="min-width: 180px;">Activity</th>
				</tr>
			</thead>
			<tbody>
				{% for h in history %}
					<tr>
						<td>
							<span class="badge bg-secondary" style="min-width: 160px; display: inline-block;">
								{% if h.status == 'INVOICE_DRAFT' %}
									Signature Pending
								{% elseif h.status == 'INVOICE_READY' %}
									Signed – Payment Pending
								{% elseif h.status == 'INVOICE_PARTIAL' %}
									First Payment Completed
								{% elseif h.status == 'INVOICE_PAID' %}
									Fully Paid
								{% elseif h.status == 'INVOICE_EXPIRED' %}
									Expired
								{% else %}
									{{ h.status }}
								{% endif %}
							</span>
						</td>
						<td>{{ h.note }}</td>
						<td>
							{% if h.file_path %}

								<a href="{{ h.file_path }}" class="btn btn-sm btn-outline-primary" target="_blank">👁 Preview</a>
								{% set download_url = h.file_path|replace({'/upload/': '/upload/fl_attachment/'}) %}
								<a href="{{ download_url }}" class="btn btn-sm btn-outline-dark">⬇ Download</a>
							{% else %}
								-
							{% endif %}
						</td>
						<td>#{{ h.created_by }}</td>
						<td>

							{{ h.created_at|date("D, M jS, Y - h:i A") }}


							{% if loop.last and history|length > 1 %}
								<br><hr>
								<form method="post" class="d-inline-block ms-2">
									<input type="hidden" name="undo_last_status" value="{{ h.id }}">
									<input type="hidden" name="id_order" value="{{ order.id }}">
									<button class="btn btn-sm btn-outline-danger" title="Undo last status" onclick="return confirm('Undo last status update?')">
										⏪ Undo
									</button>
								</form>
							{% endif %}
						</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="5">No history found for this order.</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>

{% endblock %}
