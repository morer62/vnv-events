    }
    
    function getClientEmailFromTable(clientId) {
        // First try to get from clients data (more reliable)
        {% for client in clients %}
            if ('{{ client.id }}' === clientId) {
                return '{{ client.email }}';
            }
        {% endfor %}
        
        // If not found in clients data, try to find in table rows
        const rows = document.querySelectorAll('tbody tr');
        for (let row of rows) {
            // Look for the button that opened this modal to get the correct row
            const emailButtons = row.querySelectorAll('button[onclick*="openEmailModal"]');
            for (let button of emailButtons) {
                const onclickAttr = button.getAttribute('onclick');
                if (onclickAttr && onclickAttr.includes(`'${clientId}'`)) {
                    // Found the correct row, now get the email from this row
                    const clientCell = row.querySelector('td:nth-child(2)');
                    if (clientCell) {
                        const emailMatch = clientCell.textContent.match(/[\w\.-]+@[\w\.-]+\.\w+/);
                        if (emailMatch) {
                            return emailMatch[0];
                        }
                    }
                }
            }
        }
        
        return '';
    }
    
    // Handle subject selection change
    document.getElementById('emailSubject').addEventListener('change', function() {
        const customDiv = document.getElementById('customSubjectDiv');
        if (this.value === 'custom') {
            customDiv.style.display = 'block';
            document.getElementById('customSubject').required = true;
        } else {
            customDiv.style.display = 'none';
            document.getElementById('customSubject').required = false;
        }
    });
    
    async function sendEmail() {
        const form = document.getElementById('emailForm');
        const formData = new FormData(form);
        
        // Validate form
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }
        
        // Get subject
        let subject = formData.get('subject');
        if (subject === 'custom') {
            subject = formData.get('custom_subject');
            if (!subject) {
                alert('Please enter a custom subject');
                return;
            }
            // Add VNV-Events to custom subject if not already present
            if (!subject.includes('VNV-Events')) {
                subject = 'VNV-Events - ' + subject;
            }
        } else {
            // For predefined subjects, get the display text and add VNV-Events
            const subjectSelect = document.getElementById('emailSubject');
            const selectedOption = subjectSelect.options[subjectSelect.selectedIndex];
            subject = selectedOption.text;
        }
        
        // Get body
        const body = formData.get('body');
        if (!body.trim()) {
            alert('Please enter a message body');
            return;
        }
        
        // Show loading state
        const sendBtn = document.querySelector('#emailModal .btn-primary');
        const spinner = document.getElementById('sendEmailSpinner');
        const text = document.getElementById('sendEmailText');
        
        spinner.classList.remove('d-none');
        text.textContent = 'Sending...';
        sendBtn.disabled = true;
        
        try {
            const requestData = {
                order_id: parseInt(formData.get('order_id')),
                client_id: parseInt(formData.get('client_id')),
                subject: subject,
                body: body
            };
            
            console.log('Sending email data:', requestData);
            
            const response = await fetch('{{ path(current_location ~ "/send-email") }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(requestData)
            });
            
            const result = await response.json();
            console.log('Email response:', result);
            
            if (result.success) {
                showToast('Email sent successfully!', 'success');
                const modal = bootstrap.Modal.getInstance(document.getElementById('emailModal'));
                modal.hide();
            } else {
                throw new Error(result.message || 'Failed to send email');
            }
            
        } catch (error) {
            console.error('Email error:', error);
            showToast('Error sending email: ' + error.message, 'error');
        } finally {
            // Reset button state
            spinner.classList.add('d-none');
            text.textContent = '📧 Send Email';
            sendBtn.disabled = false;
        }
    }

    // Add Advance Modal Functions
    async function openAddAdvanceModal(orderId, statusWorkflow) {
        document.getElementById('advanceOrderId').value = orderId;
        document.getElementById('advanceAmount').value = '';
        document.getElementById('advanceNote').value = '';
        document.getElementById('remainingBalance').textContent = '0.00';
        
        const url = '{{ path('/panel/planner-hub/management/orders/orders/get-order-balance') }}?id=' + orderId;
        console.log('Fetching balance from:', url);
        
        try {
            const response = await fetch(url);
            console.log('Response status:', response.status);
            
            if (!response.ok) {
                throw new Error('HTTP error! status: ' + response.status);
            }
            
            const data = await response.json();
            console.log('Balance data:', data);
            
            if (data.success) {
                const remaining = parseFloat(data.remaining_balance || 0);
                document.getElementById('remainingBalance').textContent = remaining.toFixed(2);
                document.getElementById('advanceAmount').setAttribute('max', remaining);
                console.log('Remaining balance set to:', remaining);
            } else {
                console.error('Error from server:', data.error);
                document.getElementById('remainingBalance').textContent = 'Error';
            }
        } catch (error) {
            console.error('Error fetching balance:', error);
            document.getElementById('remainingBalance').textContent = 'Error';
        }
        
        const modal = new bootstrap.Modal(document.getElementById('addAdvanceModal'));
        modal.show();
    }
</script>
