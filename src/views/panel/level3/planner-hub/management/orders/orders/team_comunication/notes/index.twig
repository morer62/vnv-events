{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}

<style>
.fixed-textarea {
  min-height: 160px;
  max-height: 400px;
  resize: none;
  overflow-y: auto; 
  line-height: 2;
  font-size: 13px;
}
</style>

<h1 class="h3 mb-4">📝 Service Notes for Order VNV-341{{ order_id }}</h1>
 
 {# Back según convención al listado de órdenes #}
  <a href="{{ path('panel/planner-hub/management/orders/orders/team_comunication') }}?id={{ order_id }}" class="btn btn-outline-secondary mb-3">  
    ← Back to Team Area
  </a>


<form method="post">
  <input type="hidden" name="order_id" value="{{ order_id }}">

  <div class="card mb-4">
    <div class="card-header bg-primary text-white">
      <h4 class="mb-0">📋 Main Order #{{ order_id }} - Service Notes</h4>
    </div>
    <div class="card-body">
      {% for service in services %}
        <div class="card mb-3">
          <div class="card-header fw-bold bg-light">{{ service.name }}</div>
          <div class="card-body">
            <input type="hidden" name="assigned_id[{{ service.id_assigned }}]" value="{{ service.id_assigned }}">
            <input type="hidden" name="note_source[{{ service.id_assigned }}]" value="main_order">
            <div class="mb-3">
              <label class="form-label">Custom notes for this service</label>
              <textarea name="notes[{{ service.id_assigned }}]"
                        class="form-control fixed-textarea"
                        maxlength="1200"
                        id="notes-{{ service.id_assigned }}">{{ service.notes }}</textarea>
            </div>

            <div class="row">
              <div class="col-md-4 mb-2">
                <label class="form-label">🛠️ Install Time</label>
                <input type="time" name="install_time[{{ service.id_assigned }}]" value="{{ service.install_time }}" class="form-control">
              </div>
              <div class="col-md-4 mb-2">
                <label class="form-label">🎬 Execution Time</label>
                <input type="time" name="execution_time[{{ service.id_assigned }}]" value="{{ service.execution_time }}" class="form-control">
              </div>
              <div class="col-md-4 mb-2">
                <label class="form-label">📦 Breakdown Time</label>
                <input type="time" name="breakdown_time[{{ service.id_assigned }}]" value="{{ service.breakdown_time }}" class="form-control">
              </div>
            </div>

            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="manual[]" value="{{ service.id_assigned }}" id="manualCheck{{ service.id_assigned }}"
                {% if service.has_manual_entry %}checked{% endif %}>
              <label class="form-check-label" for="manualCheck{{ service.id_assigned }}">
                🖊️ This service should include space for handwritten instructions.
              </label>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  {% if suborderServices|length > 0 %}
    {% for suborder in suborders %}
      <div class="card mb-4">
        <div class="card-header bg-info text-white">
          <h4 class="mb-0">📦 Sub-Order #{{ suborder.id }} - Service Notes</h4>
        </div>
        <div class="card-body">
          {% for service in suborderServices %}
            {% if service.suborder_id == suborder.id %}
              <div class="card mb-3">
                <div class="card-header fw-bold bg-light">{{ service.name }}</div>
                <div class="card-body">
                  <input type="hidden" name="assigned_id[{{ service.id_assigned }}]" value="{{ service.id_assigned }}">
                  <input type="hidden" name="note_source[{{ service.id_assigned }}]" value="suborder">
                  <input type="hidden" name="suborder_id[{{ service.id_assigned }}]" value="{{ suborder.id }}">
                  <div class="mb-3">
                    <label class="form-label">Custom notes for this service</label>
                    <textarea name="notes[{{ service.id_assigned }}]"
                              class="form-control fixed-textarea"
                              maxlength="1200"
                              id="notes-sub-{{ suborder.id }}-{{ service.id_assigned }}">{{ service.notes }}</textarea>
                  </div>

                  <div class="row">
                    <div class="col-md-4 mb-2">
                      <label class="form-label">🛠️ Install Time</label>
                      <input type="time" name="install_time[{{ service.id_assigned }}]" value="{{ service.install_time }}" class="form-control">
                    </div>
                    <div class="col-md-4 mb-2">
                      <label class="form-label">🎬 Execution Time</label>
                      <input type="time" name="execution_time[{{ service.id_assigned }}]" value="{{ service.execution_time }}" class="form-control">
                    </div>
                    <div class="col-md-4 mb-2">
                      <label class="form-label">📦 Breakdown Time</label>
                      <input type="time" name="breakdown_time[{{ service.id_assigned }}]" value="{{ service.breakdown_time }}" class="form-control">
                    </div>
                  </div>

                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="manual[]" value="{{ service.id_assigned }}" id="manualCheckSub{{ suborder.id }}-{{ service.id_assigned }}"
                      {% if service.has_manual_entry %}checked{% endif %}>
                    <label class="form-check-label" for="manualCheckSub{{ suborder.id }}-{{ service.id_assigned }}">
                      🖊️ This service should include space for handwritten instructions.
                    </label>
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  {% endif %}

  <button class="btn btn-success">
    <i data-feather="save"></i> Save Comments
  </button>
</form>

<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('textarea[name^="notes["]').forEach(textarea => {
    if (textarea.hasAttribute('data-payroll-notes')) {
      return;
    }
    
    textarea.addEventListener('input', function() {
      this.style.height = 'auto';
      const newHeight = this.scrollHeight;
      const maxHeight = 400;
      
      if (newHeight <= maxHeight) {
        this.style.height = newHeight + 'px';
      } else {
        this.style.height = maxHeight + 'px';
      }
    });
  });
});
</script>

{% endblock %}
