{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<h1 class="h3 mb-4">🛒 Shopping List for Sub-Order #{{ id }}</h1>

<a href="{{ path('panel/planner-hub/management/orders/orders/suborders/team_comunication') }}?id={{ id }}" class="btn btn-outline-secondary mb-3">  
  ← Back to Team Area
</a>

<div class="alert alert-info mb-4">
  <h5>📋 Sub-Order Information</h5>
  <p><strong>Sub-Order ID:</strong> Sub-{{ suborder.id }}</p>
  <p><strong>Parent Order:</strong> VNV 341{{ order.id }}</p>
  <p><strong>Event Date:</strong> {{ order.event_date|date("l, M j, Y") }}</p>
  <p><strong>Time:</strong> {{ order.start_time|date("g:i A") }} - {{ order.end_time|date("g:i A") }}</p>
</div>

<form method="post">
    <input type="hidden" name="suborder_id" value="{{ id }}">

    {% for service in services %}
        <div class="card mb-4">
            <div class="card-header fw-bold">🧩 {{ service.name }}</div>
            <div class="card-body" id="shopping-{{ service.id_service }}">
                {% for item in service.items %}
                    <div class="border p-2 mb-3 position-relative">
                        <input type="text" maxlength="40" name="shopping[{{ service.id_service }}][{{ loop.index0 }}][item]" value="{{ item.item }}" class="form-control mb-2" placeholder="Item name">
                        <input type="text" maxlength="10" name="shopping[{{ service.id_service }}][{{ loop.index0 }}][quantity]" value="{{ item.quantity }}" class="form-control mb-2" placeholder="Quantity (optional)">
                        <textarea maxlength="40" name="shopping[{{ service.id_service }}][{{ loop.index0 }}][notes]" class="form-control mb-2" placeholder="Notes">{{ item.notes }}</textarea>
                        <button type="button" class="btn-close position-absolute end-0 top-0 m-3" onclick="this.parentNode.remove()"></button>
                    </div>
                {% endfor %}
                <button type="button" class="btn btn-outline-secondary" onclick="addItem({{ service.id_service }})">➕ Add Item</button>
            </div>
        </div>
    {% endfor %}

    <button class="btn btn-success">
        <i data-feather="save"></i> Save Shopping List
    </button>
</form>

<script>
function addItem(serviceId) {
    const container = document.getElementById(`shopping-${serviceId}`);
    const existing = container.querySelectorAll('[name^="shopping[' + serviceId + ']"]');
    const currentIndex = Math.floor(existing.length / 3);

    const div = document.createElement('div');
    div.className = "border p-2 mb-3 position-relative";
    div.innerHTML = `
        <input type="text" maxlength="40" name="shopping[${serviceId}][${currentIndex}][item]" class="form-control mb-2" placeholder="Item name">
        <input type="text" maxlength="10" name="shopping[${serviceId}][${currentIndex}][quantity]" class="form-control mb-2" placeholder="Quantity (optional)">
        <textarea maxlength="40" name="shopping[${serviceId}][${currentIndex}][notes]" class="form-control mb-2" placeholder="Notes"></textarea>
        <button type="button" class="btn-close position-absolute end-0 top-0 m-3" onclick="this.parentNode.remove()"></button>
    `;
    container.insertBefore(div, container.lastElementChild);
}
</script>
{% endblock %}
