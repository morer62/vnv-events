<style>
.step-item {
padding: 1rem 0.5rem;
border-radius: 8px;
transition: all 0.2s ease;
cursor: pointer;
border: 1px solid transparent;
}

.step-item:hover {
background-color: #f8f9fa;
}

.step-item.active {
background-color: #0d6efd;
color: white;
border-color: #0d6efd;
}

.step-item.completed {
background-color: #198754;
color: white;
border-color: #198754;
}

.step-number {
width: 30px;
height: 30px;
border-radius: 50%;
background-color: #e9ecef;
display: flex;
align-items: center;
justify-content: center;
font-weight: bold;
font-size: 0.9rem;
margin: 0 auto 0.5rem;
transition: all 0.2s ease;
}

.step-item.active .step-number,
.step-item.completed .step-number {
background-color: rgba(255, 255, 255, 0.2);
}

.step-title {
font-weight: 500;
font-size: 0.9rem;
}

</style>

<script>
// Show/hide digital link section based on event type
document.querySelectorAll('input[name="event_type"]').forEach(radio => {
radio.addEventListener('change', function() {
const digitalSection = document.getElementById('digital-link-section');
digitalSection.style.display = this.value === 'digital' ? 'block' : 'none';
});
});

// Edit ticket type functions
function editTicketType(id, name, description, price) {
document.getElementById('edit_ticket_type_id').value = id;
document.getElementById('edit_ticket_name').value = name;
document.getElementById('edit_ticket_description').value = description;
document.getElementById('edit_ticket_price').value = price;

new bootstrap.Modal(document.getElementById('editTicketTypeModal')).show();
}

// Edit sales stage functions
function editSalesStage(id, name, description, startDate, endDate, discount) {
document.getElementById('edit_stage_id').value = id;
document.getElementById('edit_stage_name').value = name;
document.getElementById('edit_stage_description').value = description;
document.getElementById('edit_stage_start_date').value = startDate.replace(' ', 'T').substring(0, 16);
document.getElementById('edit_stage_end_date').value = endDate.replace(' ', 'T').substring(0, 16);
document.getElementById('edit_stage_discount').value = discount;

new bootstrap.Modal(document.getElementById('editSalesStageModal')).show();
}

// QR Scanner functionality
let qrScanner = null;

document.getElementById('qrScannerModal').addEventListener('shown.bs.modal', function () {
    // Initialize QR scanner when modal opens
    if (typeof Html5QrcodeScanner !== 'undefined') {
        qrScanner = new Html5QrcodeScanner("qr-reader", {
            qrbox: { width: 250, height: 250 },
            fps: 20
        });
        
        qrScanner.render(onScanSuccess, onScanFailure);
    }
});

document.getElementById('qrScannerModal').addEventListener('hidden.bs.modal', function () {
    // Clean up scanner when modal closes
    if (qrScanner) {
        qrScanner.clear();
        qrScanner = null;
    }
});

function onScanSuccess(decodedText, decodedResult) {
    // Stop the scanner to prevent multiple reads
    if (qrScanner) {
        qrScanner.clear();
        qrScanner = null;
    }
    
    // Show processing indicator
    const qrReader = document.getElementById('qr-reader');
    qrReader.innerHTML = '<div class="text-center p-4"><i class="fa-solid fa-spinner fa-spin text-success fs-3"></i><br><small class="text-muted">Processing QR code...</small></div>';
    
    // Fill the manual input with scanned code
    document.getElementById('manualQrCode').value = decodedText;
    
    // Auto-submit the form
    document.getElementById('manualQrForm').submit();
}

function onScanFailure(error) {
    // Handle scan failure silently
}
</script>

<!-- QR Scanner Library -->
<script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

