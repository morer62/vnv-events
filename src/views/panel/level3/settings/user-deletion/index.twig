
{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<h1 class="h4 mb-4">🗑️ Account Deletion Request</h1>

{{ macros.breadcrumb2() }}

{% if request %}
    {% set now = "now"|date("U") %}
    {% set deletionDate = request.deletion_date|date("U") %}
    {% set daysRemaining = ((deletionDate - now) / 86400)|round(0, 'ceil') %}

    <div class="alert alert-warning">
        You requested to delete your account on <strong>{{ request.deletion_request|date('F j, Y') }}</strong>.<br>
        Your data will be permanently removed on <strong>{{ request.deletion_date|date('F j, Y') }}</strong>.<br>
        {% if daysRemaining > 0 %}
            <strong>{{ daysRemaining }} day{{ daysRemaining == 1 ? '' : 's' }} remaining</strong> to reverse this decision.<br>
        {% else %}
            <strong>This account is pending final deletion.</strong><br>
        {% endif %}
        Status: 
        <strong>
            {{ request.deletion_status == 'DONE_FULL' 
                ? 'Full Deletion (all data will be removed)' 
                : 'Partial Deletion (data will be preserved)' 
            }}
        </strong>
    </div>

    {% if daysRemaining > 0 %}
        <form method="post" class="mt-3">
            <input type="hidden" name="cancel_deletion" value="yes">
            <button class="btn btn-outline-secondary">
                <i data-feather="x-circle"></i> Cancel Deletion Request
            </button>
        </form>
    {% endif %}
{% else %}
    <form method="post" onsubmit="return confirm('Are you sure you want to delete your account?.')">
        <input type="hidden" name="confirm_delete" value="yes">
        
        <p>
            You can choose to delete your account entirely or keep your data for future reactivation.
        </p>

        <div class="mb-3">
            <label class="form-label">Select deletion type:</label>
            <select name="deletion_status" class="form-select" required>
                <option value="">-- Choose an option --</option>
                <option value="DONE_FULL">🗑️ Delete my account and all associated data</option>
                <option value="DONE_PARTIAL">📦 Delete my account but keep my data for future reactivation</option>
            </select>
        </div>

        <button class="btn btn-danger">
            <i data-feather="trash-2"></i> Request Account Deletion
        </button>
    </form>
{% endif %}

{% endblock %}
