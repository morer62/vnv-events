{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<main class="container py-4">
  <h2 class="mb-3 text-center">Client Requests for This Service</h2>

  <a href="{{ app_url }}/panel/services" class="btn btn-secondary mb-3">
    {{ macros.icon('arrow-left') }} Back to Services
  </a>

  <div class="table-responsive">
    <table class="table table-bordered align-middle text-center">
      <thead class="table-dark">
        <tr>
          <th>Event Date</th>
          <th>Client</th>
          <th>Event Type</th>
          <th>Guests</th>
          <th>Budget</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% if requests|length > 0 %}
          {% for r in requests %}
            <tr>
              <td>{{ r.event_date ? r.event_date|date("M j, Y") : 'N/A' }}</td>
              <td>
                <strong>{{ r.client_name }}</strong><br>
                <a href="mailto:{{ r.client_email }}">{{ r.client_email }}</a><br>
                <a href="tel:{{ r.client_phone }}">{{ r.client_phone }}</a>
              </td>
              <td>{{ r.event_type ?? 'N/A' }}</td>
              <td>{{ r.guests ?? 'N/A' }}</td>
              <td>{{ r.budget ? "$" ~ r.budget|number_format(2) : 'N/A' }}</td>
              <td>
                <form method="post" action="{{ app_url }}/panel/service/requests?id={{ service_id }}" class="d-inline">
                  {{ macros.csrf() }}
                  <input type="hidden" name="action" value="update_status">
                  <input type="hidden" name="request_id" value="{{ r.id }}">
                  <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="PENDING" {% if r.status == 'PENDING' %}selected{% endif %}>Pending</option>
                    <option value="CONTACTED" {% if r.status == 'CONTACTED' %}selected{% endif %}>Contacted</option>
                    <option value="COMPLETED" {% if r.status == 'COMPLETED' %}selected{% endif %}>Completed</option>
                    <option value="CANCELLED" {% if r.status == 'CANCELLED' %}selected{% endif %}>Cancelled</option>
                  </select>
                </form>
              </td>
              <td>
                <div class="btn-group" role="group">
                  {% if r.details %}
                    <button class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#details{{ r.id }}">
                      {{ macros.icon('eye') }} View
                    </button>
                  {% endif %}
                  
                  <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#emailModal{{ r.id }}">
                    {{ macros.icon('mail') }} Email
                  </button>
                </div>
              </td>
            </tr>

            {# Modal para ver detalles #}
            {% if r.details %}
            <div class="modal fade" id="details{{ r.id }}" tabindex="-1">
              <div class="modal-dialog">
                <div class="modal-content">
                  <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Request Details</h5>
                    <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                  </div>
                  <div class="modal-body">
                    <div class="mb-3">
                      <h6>Client Message:</h6>
                      <p>{{ r.details }}</p>
                    </div>
                    {% if r.notes %}
                      <div class="mb-3">
                        <h6>Your Notes:</h6>
                        <p>{{ r.notes }}</p>
                      </div>
                    {% endif %}
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                  </div>
                </div>
              </div>
            </div>
            {% endif %}

            {# Modal para enviar correo #}
            <div class="modal fade" id="emailModal{{ r.id }}" tabindex="-1">
              <div class="modal-dialog modal-lg">
                <div class="modal-content">
                  <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">
                      {{ macros.icon('mail') }} Send Email to {{ r.client_name }}
                    </h5>
                    <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                  </div>
                  <form method="post" action="{{ app_url }}/panel/service/requests?id={{ service_id }}">
                    <div class="modal-body">
                      {{ macros.csrf() }}
                      <input type="hidden" name="action" value="send_email">
                      <input type="hidden" name="request_id" value="{{ r.id }}">
                      
                      <div class="row mb-3">
                        <div class="col-md-6">
                          <label class="form-label"><strong>To:</strong></label>
                          <p class="form-control-plaintext">{{ r.client_email }}</p>
                        </div>
                        <div class="col-md-6">
                          <label class="form-label"><strong>Client:</strong></label>
                          <p class="form-control-plaintext">{{ r.client_name }}</p>
                        </div>
                      </div>

                      <div class="mb-3">
                        <label for="emailSubject{{ r.id }}" class="form-label">Subject *</label>
                        <input type="text" 
                               class="form-control" 
                               id="emailSubject{{ r.id }}" 
                               name="email_subject" 
                               value="Re: Your event inquiry - {{ r.event_type ?? 'Event' }}" 
                               required>
                      </div>

                      <div class="mb-3">
                        <label for="emailMessage{{ r.id }}" class="form-label">Message *</label>
                        <textarea class="form-control" 
                                  id="emailMessage{{ r.id }}" 
                                  name="email_message" 
                                  rows="8" 
                                  required 
                                  placeholder="Write your message here..."></textarea>
                      </div>

                      <div class="alert alert-info">
                        <small>
                          {{ macros.icon('info-circle') }}
                          <strong>Información del evento:</strong><br>
                          Fecha: {{ r.event_date ? r.event_date|date("M j, Y") : 'No especificada' }} | 
                          Invitados: {{ r.guests ?? 'No especificado' }} | 
                          Presupuesto: {{ r.budget ? "$" ~ r.budget|number_format(2) : 'No especificado' }}
                        </small>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                      <button type="submit" class="btn btn-success">
                        {{ macros.icon('send') }} Send Email
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            </div>

          {% endfor %}
        {% else %}
          <tr>
            <td colspan="7" class="text-center py-5">
              <div class="mb-3">
                {{ macros.icon('inbox', 'text-muted', 48) }}
              </div>
              <h5 class="text-muted">No Requests Found</h5>
              <p class="text-muted">There are currently no requests for this service.</p>
            </td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
</main>

<script>
// Auto-resize textareas
document.addEventListener('DOMContentLoaded', function() {
    const textareas = document.querySelectorAll('textarea[name="email_message"]');
    textareas.forEach(function(textarea) {
        textarea.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = (this.scrollHeight) + 'px';
        });
    });
});
</script>

{% endblock %}