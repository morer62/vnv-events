{% extends 'templates/base.admin.twig' %}

{% block style %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/trumbowyg@2.27.3/dist/ui/trumbowyg.min.css">
{% endblock %}

{% block body %}
<div>
    <h1 class="h3 text-center mb-4">Create New Service</h1>

    <div class="alert alert-info alert-dismissible fade show text-center" role="alert">
        The monthly cost per service is <strong>$ {{ env.SERVICE_PAYMENT_AMOUNT }}</strong>. You will not be charged unless your profile is approved.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>

    <!-- Paso 1: Categoría -->
    <section id="step-1">
        <select class="form-select mb-3" name="category_id" id="service-category" required>
            <option value="">Select a category</option>
            {% for c in categories %}
                <option value="{{ c.id }}">{{ c.service_category }}</option>
            {% endfor %}
        </select>
        <button type="button" class="btn btn-primary w-100" id="to-step-2">Continue</button>
    </section>

    <!-- Paso 2: Detalles -->
    <section id="step-2" style="display:none;">
        <form method="post" class="card shadow-lg p-4" id="service-form">
            <input type="hidden" name="category_id" id="final-category">
            <div class="row">
                <div class="col-12 mb-3">
                    <label class="form-label">Additional categories (optional)</label>
                    <div class="border rounded p-2" style="max-height: 220px; overflow:auto;">
                        {% for c in categories %}
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="extra_categories[]" value="{{ c.id }}" id="cat-{{ c.id }}">
                                <label class="form-check-label" for="cat-{{ c.id }}">{{ c.service_category }}</label>
                            </div>
                        {% endfor %}
                    </div>
                    <small class="text-muted">Check all that apply. The main category won’t be duplicated.</small>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Profile Name</label>
                    <input name="name" class="form-control" required placeholder="e.g. DJ Mike Entertainment" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Phone Number</label>
                    <input name="phone_number" class="form-control" data-phone placeholder="e.g. (305) 123-4567" />
                </div>
                <div class="col-12 mb-3">
                    <label class="form-label">Biography</label>
                    <textarea class="form-control" name="description" id="description-editor" placeholder="Tell us what makes your service special..." required></textarea>
                </div>
                <div class="col-12 mb-3">
                    <label class="form-label">Address</label>
                    <input name="address" data-places class="form-control" required placeholder="Start typing and select from the list..." />
                    <small class="text-danger">Example: 123 Main St, Miami, FL</small>
                </div>
                <div class="col-md-6 mb-3">
                    <label>Email</label>
                    <input name="email" class="form-control" placeholder="e.g. contact@yourservice.com" />
                </div>
                <div class="col-md-6 mb-3">
                    <label>Website</label>
                    <input name="website" class="form-control" placeholder="e.g. https://yourservice.com" />
                </div>
                <div class="col-md-6 mb-3">
                    <label>Instagram</label>
                    <input name="instagram" class="form-control" placeholder="e.g. @yourprofile" />
                </div>
                <div class="col-md-6 mb-3">
                    <label>Facebook</label>
                    <input name="facebook" class="form-control" placeholder="e.g. facebook.com/yourpage" />
                </div>
                <div class="col-md-6 mb-3">
                    <label>Twitter</label>
                    <input name="twitter" class="form-control" placeholder="e.g. @yourhandle" />
                </div>
                <div class="col-md-6 mb-3">
                    <label>Yelp</label>
                    <input name="yelp" class="form-control" placeholder="e.g. yelp.com/biz/yourbiz" />
                </div>

                <button type="button" class="btn btn-outline-secondary w-100 mb-2" id="back-step-1">Back</button>
                <button type="submit" class="btn btn-success w-100">Submit Service</button>
            </div>
        </form>
    </section>
</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/trumbowyg@2.27.3/dist/trumbowyg.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', () => {
    $('#description-editor').trumbowyg();

    document.getElementById('to-step-2').onclick = () => {
        const cat = document.getElementById('service-category').value;
        if (!cat) return alert("Please select a category.");
        document.getElementById('final-category').value = cat;
        document.getElementById('step-1').style.display = 'none';
        document.getElementById('step-2').style.display = 'block';
    };

    document.getElementById('back-step-1').onclick = () => {
        document.getElementById('step-1').style.display = 'block';
        document.getElementById('step-2').style.display = 'none';
    };

    const addressInput = document.querySelector('[name="address"]');
    const autocomplete = new google.maps.places.Autocomplete(addressInput, {
        types: ['address'],
        componentRestrictions: { country: 'us' }
    });

    autocomplete.addListener("place_changed", () => {
        const place = autocomplete.getPlace();
        addressInput.dataset.lat = place.geometry?.location?.lat() || "";
        addressInput.dataset.lng = place.geometry?.location?.lng() || "";
    });

    document.getElementById("service-form").addEventListener("submit", function(e) {
        const requiredFields = ["name", "description", "address"];
        for (const field of requiredFields) {
            const input = document.querySelector(`[name='${field}']`);
            if (!input.value.trim()) {
                alert(`${field} is required.`);
                input.focus();
                e.preventDefault();
                return;
            }
        }

        // Asegurar que la categoría principal no quede duplicada en extra_categories
        const mainCat = document.getElementById('final-category').value;
        const extraChecks = document.querySelectorAll('input[name="extra_categories[]"]');
        extraChecks.forEach(chk => {
            if (chk.value === mainCat && chk.checked) {
                chk.checked = false;
            }
        });

        if (!addressInput.dataset.lat || !addressInput.dataset.lng) {
            alert("Please select a valid address from suggestions.");
            addressInput.focus();
            e.preventDefault();
        }
    });
});
</script>
{% endblock %}
