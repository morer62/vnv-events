{% extends 'templates/base.admin.twig' %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 mb-1">Store Subscriptions</h1>
            <p class="text-muted mb-0">Manage weekly subscriptions and trigger manual renewals.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            {% if subscriptions|length > 0 %}
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Customer</th>
                                <th>Frequency</th>
                                <th>Meals</th>
                                <th>Price / Meal</th>
                                <th>Total / Renewal</th>
                                <th>Status</th>
                                <th>Next Charge</th>
                                <th>Last Charge</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for s in subscriptions %}
                                {% set totalRenewal = (s.price_per_meal|default(0) * s.meals_count|default(0)) %}
                                <tr>
                                    <td>#{{ s.id }}</td>
                                    <td>
                                        <strong>{{ s.full_name ?: '—' }}</strong>
                                        <div class="small text-muted">{{ s.email ?: '—' }}</div>
                                    </td>
                                    <td>{{ s.frequency }}</td>
                                    <td>{{ s.meals_count }}</td>
                                    <td>${{ s.price_per_meal|number_format(2, '.', ',') }}</td>
                                    <td>${{ totalRenewal|number_format(2, '.', ',') }}</td>
                                    <td>
                                        {% if s.status == 'ACTIVE' %}
                                            <span class="badge bg-success">ACTIVE</span>
                                        {% elseif s.status == 'PAUSED' %}
                                            <span class="badge bg-warning text-dark">PAUSED</span>
                                        {% elseif s.status == 'CANCELLED' %}
                                            <span class="badge bg-danger">CANCELLED</span>
                                        {% elseif s.status == 'EXPIRED' %}
                                            <span class="badge bg-secondary">EXPIRED</span>
                                        {% else %}
                                            <span class="badge bg-secondary">{{ s.status }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if s.next_charge_date %}
                                            {{ s.next_charge_date|date('M j, Y') }}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if s.last_charge_date %}
                                            {{ s.last_charge_date|date('M j, Y') }}
                                        {% else %}
                                            —
                                        {% endif %}
                                    </td>
                                    <td class="text-end">
                                        {% if s.status == 'ACTIVE' %}
                                            <form method="post" class="d-inline">
                                                <input type="hidden" name="action" value="renew_now">
                                                <input type="hidden" name="subscription_id" value="{{ s.id }}">
                                                <button
                                                    type="submit"
                                                    class="btn btn-sm btn-primary"
                                                    onclick="return confirm('Charge this subscription now and create a renewal order?');"
                                                >
                                                    Renew now
                                                </button>
                                            </form>
                                        {% else %}
                                            <span class="text-muted small">Unavailable</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <h5 class="mb-2">No subscriptions found</h5>
                    <p class="text-muted mb-0">When customers buy with Weekly Subscription, records will appear here.</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
