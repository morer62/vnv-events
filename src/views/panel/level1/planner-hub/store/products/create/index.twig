{% extends 'templates/base.admin.twig' %}

{% block style %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/trumbowyg@2.27.3/dist/ui/trumbowyg.min.css">
<style>
    .store-attribute-box {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 14px;
        background: #fff;
        height: 100%;
    }

    .store-attribute-box h6 {
        margin-bottom: 12px;
    }

    .store-preview-image {
        width: 110px;
        height: 110px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #dee2e6;
        display: none;
        margin-top: 10px;
    }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 mb-1">Create Store Product</h1>
            <p class="text-muted mb-0">Create a product with categories, attributes, stock and image.</p>
        </div>
        <a href="/panel/planner-hub/store/products/home" class="btn btn-outline-secondary">
            ← Back to Products
        </a>
    </div>

    <form method="post" enctype="multipart/form-data" class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="row">
                <div class="col-12">
                    <h5 class="mb-3">Basic Information</h5>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Product Name</label>
                    <input type="text" name="name" class="form-control" required placeholder="e.g. Performance T-Shirt">
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">SKU</label>
                    <input type="text" name="sku" class="form-control" placeholder="e.g. SHIRT-001">
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Slug (optional)</label>
                    <input type="text" name="slug" class="form-control" placeholder="day-coordinator-service-packages-premium">
                    <small class="text-muted">If empty, it will be generated from product name.</small>
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select">
                        <option value="ACTIVE" selected>ACTIVE</option>
                        <option value="INACTIVE">INACTIVE</option>
                        <option value="DRAFT">DRAFT</option>
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Short Description</label>
                    <input type="text" name="short_description" class="form-control" placeholder="Short summary for cards and listings">
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Main Image</label>
                    <input type="file" name="main_image" class="form-control" accept="image/*" required id="main-image-input">
                    <img id="main-image-preview" class="store-preview-image" alt="Preview">
                </div>

                <div class="col-12 mb-3">
                    <label class="form-label">Full Description</label>
                    <textarea name="description" id="description-editor" class="form-control" rows="6" placeholder="Describe your product..." required></textarea>
                </div>

                <div class="col-12 mt-2">
                    <h5 class="mb-3">Pricing & Inventory</h5>
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Price</label>
                    <input type="number" step="0.01" min="0.01" name="price" class="form-control" required placeholder="0.00">
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Promo Price</label>
                    <input type="number" step="0.01" min="0" name="promo_price" class="form-control" placeholder="0.00">
                </div>

                <div class="col-md-2 mb-3">
                    <label class="form-label">Stock</label>
                    <input type="number" min="0" name="stock_quantity" class="form-control" value="0" required>
                </div>

                <div class="col-md-2 mb-3">
                    <label class="form-label">Min Qty</label>
                    <input type="number" min="1" name="min_purchase_qty" class="form-control" value="1" required>
                </div>

                <div class="col-md-2 mb-3">
                    <label class="form-label">Max Qty</label>
                    <input type="number" min="1" name="max_purchase_qty" class="form-control" placeholder="Optional">
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check mt-4 pt-2">
                        <input class="form-check-input" type="checkbox" name="is_public" id="is_public" checked>
                        <label class="form-check-label" for="is_public">
                            Public product
                        </label>
                    </div>
                </div>

                <div class="col-md-3 mb-3">
                    <div class="form-check mt-4 pt-2">
                        <input class="form-check-input" type="checkbox" name="is_featured" id="is_featured">
                        <label class="form-check-label" for="is_featured">
                            Featured product
                        </label>
                    </div>
                </div>

                <div class="col-12 mt-2">
                    <h5 class="mb-3">Categories</h5>
                </div>

                <div class="col-12 mb-4">
                    <div class="row">
                        {% for c in categories %}
                            <div class="col-md-4 mb-2">
                                <div class="form-check border rounded p-3">
                                    <input class="form-check-input" type="checkbox" name="category_ids[]" value="{{ c.id }}" id="cat-{{ c.id }}">
                                    <label class="form-check-label ms-1" for="cat-{{ c.id }}">
                                        <strong>{{ c.name }}</strong>
                                        {% if c.description %}
                                            <div class="small text-muted">{{ c.description }}</div>
                                        {% endif %}
                                    </label>
                                </div>
                            </div>
                        {% else %}
                            <div class="col-12">
                                <div class="alert alert-warning mb-0">
                                    No active categories available yet.
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="col-12 mt-2">
                    <h5 class="mb-3">Attributes</h5>
                </div>

                <div class="col-12 mb-4">
                    <div class="row">
                        {% for attribute in attributes %}
                            <div class="col-lg-4 col-md-6 mb-3">
                                <div class="store-attribute-box">
                                    <h6>{{ attribute.name }}</h6>

                                    {% if attribute.values|length > 0 %}
                                        {% for value in attribute.values %}
                                            <div class="form-check mb-2">
                                                <input
                                                    class="form-check-input"
                                                    type="checkbox"
                                                    name="attribute_values[{{ attribute.id }}][]"
                                                    value="{{ value.id }}"
                                                    id="attr-{{ attribute.id }}-value-{{ value.id }}"
                                                >
                                                <label class="form-check-label" for="attr-{{ attribute.id }}-value-{{ value.id }}">
                                                    {{ value.value }}
                                                </label>
                                            </div>
                                        {% endfor %}
                                    {% else %}
                                        <p class="text-muted small mb-0">No values available for this attribute.</p>
                                    {% endif %}
                                </div>
                            </div>
                        {% else %}
                            <div class="col-12">
                                <div class="alert alert-warning mb-0">
                                    No active attributes available yet.
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>


                <div class="col-12 mt-2">
    <h5 class="mb-3">Recommended For</h5>
        </div>

        <div class="col-md-6 mb-4">
            <div class="store-attribute-box">
                <h6>Audience Type</h6>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="audiences[]" value="professional" id="aud-professional">
                    <label class="form-check-label" for="aud-professional">
                        Busy Professional
                    </label>
                </div>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="audiences[]" value="healthy_active" id="aud-healthy-active">
                    <label class="form-check-label" for="aud-healthy-active">
                        Healthy / Active Lifestyle
                    </label>
                </div>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="audiences[]" value="family_kids" id="aud-family-kids">
                    <label class="form-check-label" for="aud-family-kids">
                        Family / Kids
                    </label>
                </div>

                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" name="audiences[]" value="corporate" id="aud-corporate">
                    <label class="form-check-label" for="aud-corporate">
                        Corporate
                    </label>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="store-attribute-box">
                <h6>Meal Style</h6>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="meal_styles[]" value="balanced" id="style-balanced">
                    <label class="form-check-label" for="style-balanced">
                        Balanced Meals
                    </label>
                </div>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="meal_styles[]" value="vegetarian" id="style-vegetarian">
                    <label class="form-check-label" for="style-vegetarian">
                        Vegetarian
                    </label>
                </div>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="meal_styles[]" value="family_friendly" id="style-family-friendly">
                    <label class="form-check-label" for="style-family-friendly">
                        Family-Friendly
                    </label>
                </div>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="meal_styles[]" value="protein_focused" id="style-protein-focused">
                    <label class="form-check-label" for="style-protein-focused">
                        Protein-Focused
                    </label>
                </div>

                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" name="meal_styles[]" value="corporate_lunch" id="style-corporate-lunch">
                    <label class="form-check-label" for="style-corporate-lunch">
                        Corporate Lunch
                    </label>
                </div>
            </div>
        </div>

                <div class="col-12 mt-2">
                    <h5 class="mb-3">Nutrition Information (Optional)</h5>
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Calories</label>
                    <input type="number" min="0" name="calories" class="form-control" placeholder="e.g. 350">
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Protein</label>
                    <input type="number" step="0.01" min="0" name="protein" class="form-control" placeholder="e.g. 25">
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Carbohydrates</label>
                    <input type="number" step="0.01" min="0" name="carbohydrates" class="form-control" placeholder="e.g. 40">
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Fat</label>
                    <input type="number" step="0.01" min="0" name="fat" class="form-control" placeholder="e.g. 12">
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Fiber</label>
                    <input type="number" step="0.01" min="0" name="fiber" class="form-control" placeholder="e.g. 8">
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Sugar</label>
                    <input type="number" step="0.01" min="0" name="sugar" class="form-control" placeholder="e.g. 5">
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Sodium</label>
                    <input type="number" step="0.01" min="0" name="sodium" class="form-control" placeholder="e.g. 420">
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Serving Size</label>
                    <input type="text" name="serving_size" class="form-control" placeholder="e.g. 1 bowl / 250g">
                </div>

                <div class="col-12 mb-3">
                    <label class="form-label">Ingredients</label>
                    <textarea name="ingredients" class="form-control" rows="3" placeholder="List ingredients..."></textarea>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap mt-3">
                <button type="submit" class="btn btn-success">
                    Save Product
                </button>
                <a href="/panel/planner-hub/store/products/home" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </div>
    </form>
</div>
{% endblock %}

{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/trumbowyg@2.27.3/dist/trumbowyg.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    $('#description-editor').trumbowyg();

    const input = document.getElementById('main-image-input');
    const preview = document.getElementById('main-image-preview');

    if (input) {
        input.addEventListener('change', function (e) {
            const file = e.target.files && e.target.files[0];
            if (!file) {
                preview.style.display = 'none';
                preview.src = '';
                return;
            }

            const reader = new FileReader();
            reader.onload = function (event) {
                preview.src = event.target.result;
                preview.style.display = 'block';
            };
            reader.readAsDataURL(file);
        });
    }
});
</script>
{% endblock %}