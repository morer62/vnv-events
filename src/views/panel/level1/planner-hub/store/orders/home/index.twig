{% extends 'templates/base.admin.twig' %}

{% block body %}
<div class="container-fluid vnv-page-shell store-orders-page">
    <div class="vnv-page-header">
        <div>
            <p class="vnv-kicker">VNV Store Operations</p>
            <h1>Store Orders</h1>
            <p>Weekly operations board: approve, prepare and assign kitchen or delivery work.</p>
        </div>
        <a href="{{ path('panel/planner-hub/store/carts/home') }}" class="btn vnv-btn-ghost">
            View Abandoned Carts
        </a>
    </div>

    <div class="card vnv-panel-card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">Week Start</label>
                    <input type="date" name="week_start" class="form-control" value="{{ filters.week_start }}">
                </div>

                <div class="col-md-2">
                    <label class="form-label">Week End</label>
                    <input type="date" name="week_end" class="form-control" value="{{ filters.week_end }}">
                </div>

                <div class="col-md-2">
                    <label class="form-label">Payment Status</label>
                    <select name="payment_status" class="form-select">
                        <option value="">All</option>
                        <option value="PENDING" {% if filters.payment_status == 'PENDING' %}selected{% endif %}>PENDING</option>
                        <option value="PAID" {% if filters.payment_status == 'PAID' %}selected{% endif %}>PAID</option>
                        <option value="FAILED" {% if filters.payment_status == 'FAILED' %}selected{% endif %}>FAILED</option>
                        <option value="REFUNDED" {% if filters.payment_status == 'REFUNDED' %}selected{% endif %}>REFUNDED</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Order Status</label>
                    <select name="status" class="form-select">
                        <option value="">All</option>
                        {% for value, label in orderStatusOptions %}
                            <option value="{{ value }}" {% if filters.status == value %}selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Customer Email</label>
                    <input type="text" name="email" class="form-control" value="{{ filters.email }}" placeholder="Search by email">
                </div>

                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card vnv-panel-card">
        <div class="card-body">
            {% if orders|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle vnv-table">
                        <thead>
                            <tr>
                                <th class="text-nowrap">ID</th>
                                <th class="text-nowrap">Date</th>
                                <th>Customer</th>
                                <th>Shipping Address</th>
                                <th class="text-nowrap">Pricing</th>
                                <th class="text-nowrap">Coupon</th>
                                <th class="text-nowrap">Details</th>
                                <th class="text-end text-nowrap">Meals</th>
                                <th class="text-end text-nowrap">Total</th>
                                <th class="text-nowrap">Payment</th>
                                <th class="text-nowrap">Status</th>
                                <th class="text-nowrap">Delivery</th>
                                <th class="text-nowrap">Requested for</th>
                                <th class="text-end text-nowrap">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for o in orders %}
                                <tr>
                                    <td class="text-muted">#{{ o.id }}</td>
                                    <td class="text-muted small text-nowrap">
                                        {{ o.created_at|date('M j, Y') }}<br>
                                        <span class="text-muted">{{ o.created_at|date('g:i A') }}</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">{{ o.guest_name ?: '—' }}</div>
                                        <div class="small text-muted">{{ o.guest_email ?: '—' }}</div>
                                    </td>
                                    <td class="small">{{ o.shipping_address_display ?: '—' }}</td>
                                    <td class="text-uppercase small text-muted">
                                        {{ o.pricing_mode ?: 'PAYG' }}
                                    </td>
                                    <td class="small">
                                        {% if o.coupon_code %}
                                            <span class="badge bg-info text-dark">{{ o.coupon_code }}</span>
                                            {% if (o.coupon_discount ?: 0) > 0 %}
                                                <div class="text-muted mt-1">- ${{ o.coupon_discount|number_format(2, '.', ',') }}</div>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </td>
                                    <td class="small text-nowrap">
                                        <strong>{{ o.delivery_timing == 'ASAP' ? 'ASAP' : 'Scheduled' }}</strong><br>
                                        <span class="text-muted">{{ (o.promised_delivery_at ?: o.requested_delivery_at) ? (o.promised_delivery_at ?: o.requested_delivery_at)|date('D, M j · g:i A') : 'Not set' }}</span>
                                    </td>
                                    <td class="text-center text-md-start">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary px-3"
                                                data-bs-toggle="modal"
                                                data-bs-target="#orderItemsModal"
                                                data-order-id="{{ o.id }}"
                                                data-order-date="{{ o.created_at|date('M j, Y g:i A') }}"
                                                data-order-customer="{{ o.guest_name ?: '—' }}"
                                                data-order-email="{{ o.guest_email ?: '—' }}"
                                                data-order-phone="{{ o.guest_phone ?: '—' }}"
                                                data-order-shipping="{{ o.shipping_address_display ?: '—' }}"
                                                data-order-status="{{ o.status }}"
                                                data-order-payment="{{ o.payment_status }}"
                                                data-order-coupon-code="{{ o.coupon_code ?: '' }}"
                                                data-order-coupon-discount="{{ (o.coupon_discount ?: 0)|number_format(2, '.', ',') }}"
                                                data-order-total="{{ o.total|number_format(2, '.', ',') }}"
                                                data-delivery-fee="{{ (o.delivery_fee ?: 0)|number_format(2, '.', '') }}"
                                                data-delivery-provider-cost="{{ (o.delivery_provider_cost ?: 0)|number_format(2, '.', '') }}"
                                                data-delivery-distance="{{ (o.delivery_distance_miles ?: 0)|number_format(2, '.', '') }}"
                                                data-delivery-source="{{ o.delivery_pricing_source ?: '—' }}"
                                                data-delivery-markup="{{ (o.delivery_markup_percent ?: 0)|number_format(2, '.', '') }}"
                                                data-delivery-refund-status="{{ o.delivery_refund_status ?: 'NONE' }}"
                                                data-delivery-refunded="{{ (o.delivery_refunded_amount ?: 0)|number_format(2, '.', '') }}"
                                                data-shipping-address1="{{ o.shipping_address_1|e('html_attr') }}" data-shipping-address2="{{ o.shipping_address_2|e('html_attr') }}" data-shipping-city="{{ o.shipping_city|e('html_attr') }}" data-shipping-state="{{ o.shipping_state|e('html_attr') }}" data-shipping-zip="{{ o.shipping_zip|e('html_attr') }}" data-shipping-instructions="{{ o.shipping_instructions|e('html_attr') }}" data-requested-delivery="{{ o.requested_delivery_at|e('html_attr') }}" data-operational-provider="{{ o.delivery_operational_provider|e('html_attr') }}" data-delivery-status="{{ o.delivery_status|default('SCHEDULED')|e('html_attr') }}"
                                                data-items="{{ o.items_modal_json|e('html_attr') }}">
                                            View details
                                        </button>
                                    </td>
                                    <td class="text-end">{{ o.meals_count }}</td>
                                    <td class="text-end">${{ o.total|number_format(2, '.', ',') }}</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            {% if o.payment_status == 'PAID' %}
                                                <span class="badge bg-success">PAID</span>
                                            {% elseif o.payment_status == 'FAILED' %}
                                                <span class="badge bg-danger">FAILED</span>
                                            {% elseif o.payment_status == 'REFUNDED' %}
                                                <span class="badge bg-secondary">REFUNDED</span>
                                            {% else %}
                                                <span class="badge bg-warning text-dark">PENDING</span>
                                            {% endif %}
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editPaymentModal"
                                                    data-order-id="{{ o.id }}"
                                                    data-payment-status="{{ o.payment_status }}">
                                                Edit
                                            </button>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge {{ o.status_badge_class }}">{{ o.status_label }}</span>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editStatusModal"
                                                    data-order-id="{{ o.id }}"
                                                    data-status="{{ o.status }}">
                                                Edit
                                            </button>
                                        </div>
                                    </td>
                                    <td class="small">
                                        <div><strong>Kitchen:</strong> {{ o.kitchen_assignee_name ?: 'Unassigned' }}</div>
                                        <div><strong>Delivery:</strong> {{ o.delivery_assignee_name ?: 'Unassigned' }}</div>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary mt-1"
                                                data-bs-toggle="modal"
                                                data-bs-target="#assignDeliveryModal"
                                                data-order-id="{{ o.id }}"
                                                data-kitchen-user-id="{{ o.kitchen_user_id }}"
                                                data-delivery-user-id="{{ o.delivery_user_id }}">
                                            Assign
                                        </button>
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ path('store/order-access?token=' ~ o.public_token) }}" target="_blank" class="btn btn-sm btn-outline-dark">
                                            View Public
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="vnv-empty-state text-center py-5">
                    <h5 class="mb-2">No store orders found</h5>
                    <p class="text-muted mb-0">There are no VNV store orders matching these filters.</p>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Order details modal -->
    <div class="modal fade" id="orderItemsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Order products</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#detailsPrep" type="button">Prep</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#detailsDelivery" type="button">Delivery</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#detailsClient" type="button">Client</button></li>
                    </ul>
                    <div class="tab-content border border-top-0 p-3">
                        <div class="tab-pane fade show active" id="detailsPrep">
                            <div class="small mb-2"><strong>Order #</strong> <span id="orderMetaId">—</span></div>
                            <div class="small mb-2"><strong>Date</strong> <span id="orderItemsDate"></span></div>
                            <div class="small mb-2"><strong>Status</strong> <span id="orderMetaStatus"></span></div>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle">
                                    <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th class="text-end">Qty</th>
                                        <th class="text-end">Unit price</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                    </thead>
                                    <tbody id="orderItemsTableBody">
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-3">No products found.</td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="detailsDelivery">
                            <div class="small mb-2"><strong>Shipping address:</strong> <span id="orderMetaShipping">—</span></div>
                            <div class="small mb-2"><strong>Payment:</strong> <span id="orderMetaPayment">—</span></div>
                            <div class="small mb-2"><strong>Coupon:</strong> <span id="orderMetaCoupon">—</span></div>
                            <div class="small mb-2"><strong>Total:</strong> $<span id="orderMetaTotal">0.00</span></div>
                            <hr><div class="row g-2"><div class="col-6"><strong>Customer charged</strong><div>$<span id="orderDeliveryFee">0.00</span></div></div><div class="col-6"><strong>Reference cost</strong><div>$<span id="orderDeliveryCost">0.00</span></div></div><div class="col-6"><strong>Distance</strong><div><span id="orderDeliveryDistance">0.00</span> mi</div></div><div class="col-6"><strong>Source / markup</strong><div><span id="orderDeliverySource">—</span> · <span id="orderDeliveryMarkup">0</span>%</div></div></div>
                            <div class="alert alert-light border mt-3">Refund: <strong id="orderDeliveryRefundStatus">NONE</strong> · $<span id="orderDeliveryRefunded">0.00</span></div>
                            <form method="post" class="border rounded p-3 mt-3"><input type="hidden" name="action" value="update_delivery_details"><input type="hidden" name="order_id" class="delivery-order-id"><h6>Delivery details</h6><div class="row g-2"><div class="col-12"><input class="form-control" name="shipping_address_1" id="deliveryAddress1" placeholder="Street address" required></div><div class="col-12"><input class="form-control" name="shipping_address_2" id="deliveryAddress2" placeholder="Unit / suite"></div><div class="col-sm-5"><input class="form-control" name="shipping_city" id="deliveryCity" placeholder="City" required></div><div class="col-sm-3"><input class="form-control" name="shipping_state" id="deliveryState" placeholder="State" required></div><div class="col-sm-4"><input class="form-control" name="shipping_zip" id="deliveryZip" placeholder="ZIP" required></div><div class="col-12"><input class="form-control" type="datetime-local" name="requested_delivery_at" id="deliveryRequestedAt" required></div><div class="col-sm-5"><select class="form-select" name="delivery_operational_provider" id="deliveryOperationalProvider"><option value="">Not assigned</option><option>Uber manually ordered</option><option>VNV Team</option><option>External Courier</option><option>Customer Pickup</option><option>Other</option></select></div><div class="col-sm-7"><input class="form-control" name="shipping_instructions" id="deliveryInstructions" placeholder="Delivery instructions"></div><div class="col-12"><label class="form-label">Delivery status</label><select class="form-select" name="delivery_status" id="deliveryStatus"><option value="SCHEDULED">Scheduled</option><option value="PREPARING">Preparing</option><option value="READY_FOR_DELIVERY">Ready for Delivery</option><option value="ASSIGNED">Assigned</option><option value="OUT_FOR_DELIVERY">Out for Delivery</option><option value="DELIVERED">Delivered</option><option value="CANCELLED">Cancelled</option></select></div></div><small class="d-block mt-2 text-muted">Changing address or time requests a new reference. Paid delivery fees remain locked.</small><button class="btn btn-outline-primary btn-sm mt-2">Save and recalculate</button></form>
                            <form method="post" class="border rounded p-3 mt-3"><input type="hidden" name="action" value="override_delivery_fee"><input type="hidden" name="order_id" class="delivery-order-id"><h6>Override Delivery Fee</h6><div class="row g-2"><div class="col-sm-4"><input class="form-control" type="number" min="0" step="0.01" name="override_fee" placeholder="New fee" required></div><div class="col-sm-8"><input class="form-control" name="override_reason" placeholder="Reason (required)" required></div></div><button class="btn btn-outline-primary btn-sm mt-2">Record override</button></form>
                            <form method="post" enctype="multipart/form-data" class="border rounded p-3 mt-3"><input type="hidden" name="action" value="record_delivery_refund"><input type="hidden" name="order_id" class="delivery-order-id"><h6>Manual Delivery Refund</h6><div class="row g-2"><div class="col-sm-4"><input class="form-control" type="number" min="0.01" step="0.01" name="refund_amount" placeholder="Amount" required></div><div class="col-sm-4"><select class="form-select" name="refund_method"><option value="ZELLE">Zelle</option><option value="CASH">Cash</option><option value="CHECK">Check</option><option value="MANUAL_SQUARE">Manual Square</option><option value="MANUAL_STRIPE">Manual Stripe</option><option value="OTHER">Other</option></select></div><div class="col-sm-4"><input class="form-control" type="date" name="refund_date" value="{{ 'now'|date('Y-m-d') }}" required></div><div class="col-12"><input class="form-control" name="refund_reference" placeholder="Reference"></div><div class="col-12"><textarea class="form-control" name="refund_note" placeholder="Internal note"></textarea></div><div class="col-12"><label class="form-label">Proof (JPG, PNG, WebP or PDF)</label><input class="form-control" type="file" name="refund_proof" accept="image/jpeg,image/png,image/webp,application/pdf"></div></div><button class="btn btn-outline-danger btn-sm mt-2">Record refund</button></form>
                        </div>
                        <div class="tab-pane fade" id="detailsClient">
                            <div class="small mb-2"><strong>Name:</strong> <span id="orderItemsCustomer">—</span></div>
                            <div class="small mb-2"><strong>Email:</strong> <span id="orderItemsEmail">—</span></div>
                            <div class="small"><strong>Phone:</strong> <span id="orderMetaPhone">—</span></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editPaymentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post">
                    <div class="modal-header">
                        <h5 class="modal-title">Update payment status</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="action" value="update_payment_status">
                        <input type="hidden" name="order_id" id="editPaymentOrderId">
                        <div class="mb-3">
                            <label class="form-label">Payment status</label>
                            <select name="payment_status" id="editPaymentSelect" class="form-select">
                                <option value="PENDING">PENDING</option>
                                <option value="PAID">PAID</option>
                                <option value="FAILED">FAILED</option>
                                <option value="REFUNDED">REFUNDED</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editStatusModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post">
                    <div class="modal-header">
                        <h5 class="modal-title">Update order status</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="action" value="update_status">
                        <input type="hidden" name="order_id" id="editStatusOrderId">
                        <div class="mb-3">
                            <label class="form-label">Order status</label>
                            <select name="status" id="editStatusSelect" class="form-select">
                                {% for value, label in orderStatusOptions %}
                                    <option value="{{ value }}">{{ label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="assignDeliveryModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post">
                    <div class="modal-header">
                        <h5 class="modal-title">Assign delivery</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="action" value="assign_delivery">
                        <input type="hidden" name="order_id" id="assignDeliveryOrderId">
                        <div class="mb-3">
                            <label class="form-label">Kitchen user</label>
                            <select class="form-select" name="kitchen_user_id" id="assignKitchenUserSelect">
                                <option value="">Unassigned</option>
                                {% for u in kitchenUsers %}
                                    <option value="{{ u.id_user }}">{{ (u.name ~ ' ' ~ u.lastname)|trim }}{% if u.email %} ({{ u.email }}){% endif %}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="mb-0">
                            <label class="form-label">Delivery user</label>
                            <select class="form-select" name="delivery_user_id" id="assignDeliveryUserSelect">
                                <option value="">Unassigned</option>
                                {% for u in deliveryUsers %}
                                    <option value="{{ u.id_user }}">{{ (u.name ~ ' ' ~ u.lastname)|trim }}{% if u.email %} ({{ u.email }}){% endif %}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modalEl = document.getElementById('orderItemsModal');
            if (modalEl) {
                modalEl.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    if (!button) return;

                    const customer = button.getAttribute('data-order-customer') || '—';
                    const email = button.getAttribute('data-order-email') || '—';
                    const phone = button.getAttribute('data-order-phone') || '—';
                    const date = button.getAttribute('data-order-date') || '';
                    const orderId = button.getAttribute('data-order-id') || '';
                    const shipping = button.getAttribute('data-order-shipping') || '—';
                    const orderStatus = button.getAttribute('data-order-status') || '—';
                    const payment = button.getAttribute('data-order-payment') || '—';
                    const couponCode = button.getAttribute('data-order-coupon-code') || '';
                    const couponDiscount = button.getAttribute('data-order-coupon-discount') || '0.00';
                    const total = button.getAttribute('data-order-total') || '0.00';
                    const itemsJson = button.getAttribute('data-items') || '[]';
                    document.getElementById('orderItemsCustomer').textContent = customer;
                    document.getElementById('orderItemsEmail').textContent = email;
                    document.getElementById('orderItemsDate').textContent = date;
                    document.getElementById('orderMetaPhone').textContent = phone;
                    document.getElementById('orderMetaId').textContent = orderId;
                    document.getElementById('orderMetaShipping').textContent = shipping;
                    document.getElementById('orderMetaStatus').textContent = orderStatus;
                    document.getElementById('orderMetaPayment').textContent = payment;
                    document.getElementById('orderMetaCoupon').textContent = couponCode ? (couponCode + ' (-$' + couponDiscount + ')') : '—';
                    document.getElementById('orderMetaTotal').textContent = total;
                    document.getElementById('orderDeliveryFee').textContent = button.dataset.deliveryFee || '0.00';
                    document.getElementById('orderDeliveryCost').textContent = button.dataset.deliveryProviderCost || '0.00';
                    document.getElementById('orderDeliveryDistance').textContent = button.dataset.deliveryDistance || '0.00';
                    document.getElementById('orderDeliverySource').textContent = (button.dataset.deliverySource || '—').replaceAll('_',' ');
                    document.getElementById('orderDeliveryMarkup').textContent = button.dataset.deliveryMarkup || '0';
                    document.getElementById('orderDeliveryRefundStatus').textContent = button.dataset.deliveryRefundStatus || 'NONE';
                    document.getElementById('orderDeliveryRefunded').textContent = button.dataset.deliveryRefunded || '0.00';
                    document.querySelectorAll('.delivery-order-id').forEach(input => input.value = orderId);
                    document.getElementById('deliveryAddress1').value = button.dataset.shippingAddress1 || '';
                    document.getElementById('deliveryAddress2').value = button.dataset.shippingAddress2 || '';
                    document.getElementById('deliveryCity').value = button.dataset.shippingCity || '';
                    document.getElementById('deliveryState').value = button.dataset.shippingState || '';
                    document.getElementById('deliveryZip').value = button.dataset.shippingZip || '';
                    document.getElementById('deliveryInstructions').value = button.dataset.shippingInstructions || '';
                    document.getElementById('deliveryRequestedAt').value = (button.dataset.requestedDelivery || '').replace(' ','T').slice(0,16);
                    document.getElementById('deliveryOperationalProvider').value = button.dataset.operationalProvider || '';
                    document.getElementById('deliveryStatus').value = button.dataset.deliveryStatus || 'SCHEDULED';

                    let items = [];
                    try {
                        items = JSON.parse(itemsJson);
                    } catch (e) {
                        items = [];
                    }

                    const tbody = document.getElementById('orderItemsTableBody');
                    tbody.innerHTML = '';

                    if (!items.length) {
                        const tr = document.createElement('tr');
                        const td = document.createElement('td');
                        td.colSpan = 4;
                        td.className = 'text-center text-muted py-3';
                        td.textContent = 'No products found.';
                        tr.appendChild(td);
                        tbody.appendChild(tr);
                        return;
                    }

                    items.forEach(function (item) {
                        const tr = document.createElement('tr');

                        const tdName = document.createElement('td');
                        tdName.textContent = item.name || '—';

                        const tdQty = document.createElement('td');
                        tdQty.className = 'text-end';
                        tdQty.textContent = item.quantity ?? 0;

                        const tdUnit = document.createElement('td');
                        tdUnit.className = 'text-end';
                        tdUnit.textContent = '$' + Number(item.unit_price ?? 0).toFixed(2);

                        const tdTotal = document.createElement('td');
                        tdTotal.className = 'text-end';
                        tdTotal.textContent = '$' + Number(item.line_total ?? 0).toFixed(2);

                        tr.appendChild(tdName);
                        tr.appendChild(tdQty);
                        tr.appendChild(tdUnit);
                        tr.appendChild(tdTotal);
                        tbody.appendChild(tr);
                    });
                });
            }

            const paymentModal = document.getElementById('editPaymentModal');
            if (paymentModal) {
                paymentModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    if (!button) return;
                    const orderId = button.getAttribute('data-order-id') || '';
                    const status = button.getAttribute('data-payment-status') || 'PENDING';
                    const idInput = document.getElementById('editPaymentOrderId');
                    const select = document.getElementById('editPaymentSelect');
                    if (idInput) idInput.value = orderId;
                    if (select) select.value = status || 'PENDING';
                });
            }

            const statusModal = document.getElementById('editStatusModal');
            if (statusModal) {
                statusModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    if (!button) return;
                    const orderId = button.getAttribute('data-order-id') || '';
                    const status = button.getAttribute('data-status') || 'NEW';
                    const idInput = document.getElementById('editStatusOrderId');
                    const select = document.getElementById('editStatusSelect');
                    if (idInput) idInput.value = orderId;
                    if (select) select.value = status || 'NEW';
                });
            }

            const assignDeliveryModal = document.getElementById('assignDeliveryModal');
            if (assignDeliveryModal) {
                assignDeliveryModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    if (!button) return;
                    const orderId = button.getAttribute('data-order-id') || '';
                    const kitchenId = button.getAttribute('data-kitchen-user-id') || '';
                    const deliveryId = button.getAttribute('data-delivery-user-id') || '';
                    const idInput = document.getElementById('assignDeliveryOrderId');
                    const kitchenSelect = document.getElementById('assignKitchenUserSelect');
                    const select = document.getElementById('assignDeliveryUserSelect');
                    if (idInput) idInput.value = orderId;
                    if (kitchenSelect) kitchenSelect.value = kitchenId;
                    if (select) select.value = deliveryId;
                });
            }

        });
    </script>
{% endblock %}
