{% extends 'templates/base.admin.twig' %}

{% block body %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 mb-1">Store Categories</h1>
            <p class="text-muted mb-0">Manage the categories used to organize your store products.</p>
        </div>
        <a href="{{ path('panel/planner-hub/store/categories/create') }}" class="btn btn-primary">
            + Create Category
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            {% if categories|length > 0 %}
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th style="min-width:70px;">ID</th>
                                <th style="min-width:220px;">Name</th>
                                <th>Description</th>
                                <th style="min-width:220px;">Public URL</th>
                                <th style="min-width:180px;">Icon</th>
                                <th style="min-width:120px;">Status</th>
                                <th style="min-width:180px;">Created</th>
                                <th style="min-width:180px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for c in categories %}
                                <tr>
                                    <td>#{{ c.id }}</td>
                                    <td>
                                        <strong>{{ c.name }}</strong>
                                        {% if c.slug %}
                                            <div class="small text-muted">{{ c.slug }}</div>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {{ c.description ?: '—' }}
                                    </td>
                                    <td>
                                        {% if c.slug %}
                                            <a href="{{ path('product-category/' ~ c.slug) }}" target="_blank">
                                                /product-category/{{ c.slug }}
                                            </a>
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if c.icon %}
                                            <code>{{ c.icon }}</code>
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if c.status == 'ACTIVE' %}
                                            <span class="badge bg-success">ACTIVE</span>
                                        {% else %}
                                            <span class="badge bg-secondary">INACTIVE</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {{ c.created_at ?: '—' }}
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2 flex-wrap justify-content-end">
                                            <a href="{{ path('panel/planner-hub/store/categories/edit') }}?id={{ c.id }}" class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>
                                            <a href="{{ path('panel/planner-hub/store/categories/delete') }}?id={{ c.id }}"
                                               class="btn btn-sm btn-outline-danger"
                                               onclick="return confirm('Are you sure you want to delete this category?');">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <h5 class="mb-2">No categories created yet</h5>
                    <p class="text-muted mb-3">Start by creating your first store category.</p>
                    <a href="{{ path('panel/planner-hub/store/categories/create') }}" class="btn btn-primary">
                        + Create Category
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}