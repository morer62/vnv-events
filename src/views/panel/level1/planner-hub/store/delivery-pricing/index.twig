{% extends 'templates/base.admin.twig' %}
{% block title %}Delivery Price Checker{% endblock %}
{% block body %}
<style>
.dp-page{--ink:#10222a;--teal:#0f766e;--mint:#2dd4bf;--gold:#d7a83f;max-width:1380px;margin:auto;color:var(--ink)}.dp-hero{background:linear-gradient(135deg,#102a32,#163f43);border-radius:24px;padding:28px;color:#fff;box-shadow:0 20px 44px #0f172a1c}.dp-hero h1{color:#fff!important;margin:4px 0}.dp-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(320px,.75fr);gap:20px;margin-top:20px}.dp-card{background:#fff;border:1px solid #dce7e8;border-radius:20px;padding:22px;box-shadow:0 12px 32px #0f172a0c}.dp-card h2{color:#10222a!important}.dp-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.dp-field{display:flex;flex-direction:column;gap:6px}.dp-field.full{grid-column:1/-1}.dp-field label{font-weight:800;color:#334155}.dp-field input,.dp-field select{border:1px solid #cbd5e1;border-radius:11px;padding:11px;background:#fff;color:#0f172a}.dp-btn{border:0;border-radius:12px;padding:11px 16px;background:var(--teal);color:#fff;font-weight:850}.dp-btn.secondary{background:#edf8f6;color:#0f5f59}.dp-result{background:#102a32;color:#fff}.dp-result h2,.dp-result strong{color:#fff!important}.dp-metrics{display:grid;grid-template-columns:1fr 1fr;gap:11px}.dp-metric{background:#ffffff10;border:1px solid #ffffff24;border-radius:14px;padding:13px}.dp-metric small{display:block;color:#b8d6d5}.dp-metric b{font-size:1.25rem;color:#fff}.dp-price{font-size:2.7rem;font-weight:950;color:#f2c35b}.dp-table{width:100%;border-collapse:collapse}.dp-table td,.dp-table th{padding:11px;border-bottom:1px solid #e2e8f0;text-align:left}.dp-source{display:inline-block;padding:5px 9px;border-radius:999px;background:#dff8f2;color:#075e58;font-weight:850;font-size:.75rem}@media(max-width:900px){.dp-grid{grid-template-columns:1fr}.dp-fields{grid-template-columns:1fr}.dp-field.full{grid-column:auto}.dp-metrics{grid-template-columns:1fr}}
</style>
<div class="container-fluid py-4 dp-page">
 <div class="dp-hero"><small>VNV GOURMET TO GO · OPERATIONS</small><h1>Delivery Price Checker</h1><p class="mb-0">Uber is used only as a live price reference. VNV sets and collects the customer delivery fee.</p></div>
 <div class="dp-grid">
  <section class="dp-card"><h2>Check delivery price</h2>
   <form method="post" class="dp-fields" id="priceForm"><input type="hidden" name="action" value="calculate"><input type="hidden" name="order_id" id="selectedOrderId">
    <div class="dp-field full"><label>From</label><input value="{{ settings.pickup_name }} — {{ settings.pickup_address_1 }}, {{ settings.pickup_city }}, {{ settings.pickup_state }} {{ settings.pickup_zip }}" disabled></div>
    <div class="dp-field"><label>Existing customer (optional)</label><select id="customerSelect"><option value="">Custom address</option>{% for customer in customers %}<option value="{{ customer.id }}">{{ customer.customer_name }} · {{ customer.email }}</option>{% endfor %}</select></div>
    <div class="dp-field"><label>Existing order (optional)</label><select id="orderSelect"><option value="">No order selected</option>{% for order in orders %}<option value="{{ order.id }}" data-address1="{{ order.shipping_address_1|e('html_attr') }}" data-address2="{{ order.shipping_address_2|e('html_attr') }}" data-city="{{ order.shipping_city|e('html_attr') }}" data-state="{{ order.shipping_state|e('html_attr') }}" data-zip="{{ order.shipping_zip|e('html_attr') }}" data-date="{{ order.requested_delivery_at|e('html_attr') }}">#{{ order.id }} · {{ order.guest_name ?: order.guest_email }}</option>{% endfor %}</select></div>
    <div class="dp-field full"><label>Street address</label><input name="address_1" id="address1" required autocomplete="street-address"></div><div class="dp-field full"><label>Unit / suite</label><input name="address_2" id="address2"></div>
    <div class="dp-field"><label>City</label><input name="city" id="city" required></div><div class="dp-field"><label>State</label><input name="state" id="state" value="FL" required></div><div class="dp-field"><label>ZIP</label><input name="zip" id="zip" required inputmode="numeric"></div><div class="dp-field"><label>Delivery date/time (optional)</label><input type="datetime-local" name="requested_delivery_at" id="requestedAt"></div>
    <div class="dp-field full"><button class="dp-btn" type="submit">Check Delivery Price</button></div>
   </form>
  </section>
  {% if quote %}<section class="dp-card dp-result"><small>RECOMMENDED CUSTOMER FEE</small><div class="dp-price">${{ quote.customer_fee|number_format(2) }}</div><span class="dp-source">{{ quote.pricing_source|replace({'_':' '}) }}</span><div class="dp-metrics mt-3"><div class="dp-metric"><small>Uber current estimate</small><b>${{ quote.provider_cost|number_format(2) }}</b></div><div class="dp-metric"><small>Historical peak</small><b>${{ quote.historical_peak_cost|number_format(2) }}</b></div><div class="dp-metric"><small>Distance</small><b>{{ quote.distance_miles|number_format(1) }} mi</b></div><div class="dp-metric"><small>Markup</small><b>{{ quote.markup_percent|number_format(1) }}%</b></div></div><p class="mt-3 mb-1"><strong>Pickup:</strong> {{ quote.pickup.name }}</p><p><strong>Destination:</strong> {{ quote.destination.formatted_address }}</p><small>Updated {{ quote.queried_at }} UTC{% if quote.cached %} · cached reference{% endif %}</small><button type="button" class="dp-btn secondary mt-3 w-100" id="copyPrice" data-price="{{ quote.customer_fee|number_format(2,'.','') }}">Copy Delivery Price</button></section>{% else %}<section class="dp-card"><h2>How pricing works</h2><p>We compare the current Uber reference with relevant historical peaks, apply the configured markup and minimum, then round the customer fee.</p><p class="mb-0"><strong>No delivery is created.</strong> VNV chooses the operational courier separately.</p></section>{% endif %}
 </div>
 <div class="dp-grid">
  <section class="dp-card"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h2 class="mb-0">Market references</h2><form method="post"><input type="hidden" name="action" value="refresh_all_zones"><button class="dp-btn" type="submit">Refresh Market References</button></form></div><div style="overflow:auto"><table class="dp-table"><thead><tr><th>Zone</th><th>Distance</th><th>Current</th><th>Peak</th><th>VNV fee</th><th>Updated</th><th></th></tr></thead><tbody>{% for zone in zones %}<tr><td><strong>{{ zone.zone_name }}</strong><br><small>{{ zone.zip_code }}</small></td><td>{{ zone.distance_miles is not null ? zone.distance_miles|number_format(1)~' mi' : '—' }}</td><td>{{ zone.provider_cost is not null ? '$'~zone.provider_cost|number_format(2) : '—' }}</td><td>{{ zone.historical_peak_cost is not null ? '$'~zone.historical_peak_cost|number_format(2) : '—' }}</td><td>{{ zone.customer_fee is not null ? '$'~zone.customer_fee|number_format(2) : '—' }}</td><td>{{ zone.queried_at ?: 'Never' }}</td><td><form method="post"><input type="hidden" name="action" value="refresh_zone"><input type="hidden" name="zone_id" value="{{ zone.id }}"><button class="dp-btn secondary">Refresh</button></form></td></tr>{% endfor %}</tbody></table></div></section>
  <section class="dp-card"><h2>Pricing settings</h2><form method="post" class="dp-fields"><input type="hidden" name="action" value="save_settings"><div class="dp-field"><label>Markup %</label><input type="number" step="0.1" min="0" max="100" name="delivery_markup_percent" value="{{ settings.delivery_markup_percent }}"></div><div class="dp-field"><label>Rounding</label><select name="delivery_rounding_increment"><option value="0" {{ settings.delivery_rounding_increment == 0 ? 'selected' : '' }}>None</option><option value="0.5" {{ settings.delivery_rounding_increment == 0.5 ? 'selected' : '' }}>$0.50</option><option value="1" {{ settings.delivery_rounding_increment == 1 ? 'selected' : '' }}>$1.00</option></select></div><div class="dp-field"><label>Minimum fee</label><input type="number" step="0.01" min="0" name="delivery_minimum_fee" value="{{ settings.delivery_minimum_fee }}"></div><div class="dp-field"><label>Maximum distance</label><input type="number" step="0.1" min="1" name="delivery_max_distance_miles" value="{{ settings.delivery_max_distance_miles }}"></div><div class="dp-field"><label>Cache minutes</label><input type="number" min="0" max="60" name="delivery_quote_cache_minutes" value="{{ settings.delivery_quote_cache_minutes }}"></div><div class="dp-field full"><h6>Default pickup location</h6></div><div class="dp-field"><label>Name</label><input name="pickup_name" value="{{ settings.pickup_name }}" required></div><div class="dp-field"><label>Street</label><input name="pickup_address_1" value="{{ settings.pickup_address_1 }}" required></div><div class="dp-field"><label>City</label><input name="pickup_city" value="{{ settings.pickup_city }}" required></div><div class="dp-field"><label>State</label><input name="pickup_state" value="{{ settings.pickup_state }}" required></div><div class="dp-field"><label>ZIP</label><input name="pickup_zip" value="{{ settings.pickup_zip }}" required></div><div class="dp-field"><label>Latitude</label><input type="number" step="0.0000001" name="pickup_latitude" value="{{ settings.pickup_latitude }}" required></div><div class="dp-field"><label>Longitude</label><input type="number" step="0.0000001" name="pickup_longitude" value="{{ settings.pickup_longitude }}" required></div><div class="dp-field full"><h6>Fallback distance fees</h6></div>{% for tier in tiers %}<div class="dp-field"><label>{{ tier.min_distance_miles|number_format(0) }}–{{ tier.max_distance_miles|number_format(0) }} miles</label><input type="number" step="0.01" min="0" name="tier_fee[{{ tier.id }}]" value="{{ tier.customer_fee }}"></div>{% endfor %}<div class="dp-field full"><label>Peak windows JSON</label><textarea name="delivery_peak_windows_json" rows="5" style="border:1px solid #cbd5e1;border-radius:11px;padding:11px">{{ settings.delivery_peak_windows_json }}</textarea></div><div class="dp-field full"><button class="dp-btn">Save settings</button></div></form></section>
 </div>
</div>
<script>
const settingsForm=document.querySelector('input[name="action"][value="save_settings"]')?.form;
if(settingsForm){const cacheField=settingsForm.querySelector('input[name="delivery_quote_cache_minutes"]')?.closest('.dp-field');if(cacheField){const frequency=document.createElement('div');frequency.className='dp-field';frequency.innerHTML='<label>Calibration frequency</label><select name="delivery_calibration_frequency"><option value="MANUAL">Manual</option><option value="WEEKLY">Weekly</option><option value="MONTHLY">Monthly</option></select>';cacheField.after(frequency);frequency.querySelector('select').value={{ settings.delivery_calibration_frequency|default('MANUAL')|json_encode|raw }};}}
const customerAddresses={{ customerAddresses|json_encode|raw }};const fill=a=>{if(!a)return;address1.value=a.address_1||'';address2.value=a.address_2||'';city.value=a.city||'';state.value=a.state||'FL';zip.value=a.zip||''};customerSelect.addEventListener('change',()=>fill(customerAddresses[customerSelect.value]));orderSelect.addEventListener('change',()=>{const o=orderSelect.selectedOptions[0];if(!o?.value)return;selectedOrderId.value=o.value;fill({address_1:o.dataset.address1,address_2:o.dataset.address2,city:o.dataset.city,state:o.dataset.state,zip:o.dataset.zip});if(o.dataset.date)requestedAt.value=o.dataset.date.replace(' ','T').slice(0,16)});document.getElementById('copyPrice')?.addEventListener('click',async e=>{await navigator.clipboard.writeText('Estimated Delivery: $'+e.currentTarget.dataset.price);e.currentTarget.textContent='Copied'});
</script>
{% endblock %}
