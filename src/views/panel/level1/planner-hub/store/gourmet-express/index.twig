{% extends 'templates/base.admin.twig' %}
{% block title %}VNV Gourmet Express Operations{% endblock %}
{% block body %}
<style>.ge{max-width:1380px;margin:auto;color:#142421}.ge-hero{background:linear-gradient(135deg,#102a25,#205d4b);color:#fff;border-radius:26px;padding:28px}.ge-hero h1{color:#fff!important}.ge-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:18px}.ge-card{background:#fff;border:1px solid #dbe8e3;border-radius:20px;padding:21px;box-shadow:0 12px 28px #163b2f10}.ge-card.wide{grid-column:span 2}.ge-fields{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.ge label{display:grid;gap:5px;font-weight:800}.ge input,.ge textarea{border:1px solid #cbdad4;border-radius:10px;padding:10px}.ge button{border:0;border-radius:11px;padding:11px 15px;background:#16745d;color:#fff;font-weight:900}.ge-kpi{font-size:2rem;font-weight:950;color:#175f4e}.ge-table{width:100%;border-collapse:collapse}.ge-table td,.ge-table th{padding:10px;border-bottom:1px solid #e6eeeb;text-align:left}.ge-warning{background:#fff8df;border-color:#eed58a}@media(max-width:900px){.ge-grid{grid-template-columns:1fr}.ge-card.wide{grid-column:auto}.ge-fields{grid-template-columns:1fr}}</style>
<div class="container-fluid py-4 ge"><section class="ge-hero"><small>VNV GOURMET EXPRESS · LEVEL 1</small><h1>Commercial & Operations Center</h1><p class="mb-0">Control availability, minimums, capacity, windows and fixed delivery pricing from one place.</p></section>
<div class="ge-grid"><section class="ge-card"><small>LAST 30 DAYS</small><div class="ge-kpi">{{ kpis.orders|default(0) }}</div><p>orders · ${{ kpis.revenue|default(0)|number_format(2) }} revenue</p><strong>Average order ${{ kpis.average_order|default(0)|number_format(2) }}</strong></section><section class="ge-card {{ drafts ? 'ge-warning' : '' }}"><small>VISUAL APPROVAL</small><div class="ge-kpi">{{ drafts }}</div><p>products remain in draft until their new food photography is approved.</p></section><section class="ge-card"><small>STORE STATUS</small><div class="ge-kpi">{{ settings.store_paused ? 'Closed' : 'Open' }}</div><form method="post"><input type="hidden" name="action" value="toggle_pause"><label><input type="checkbox" name="store_paused" value="1" {{ settings.store_paused ? 'checked' : '' }}> Close new carts and checkout</label><label>Message shown while open<textarea name="open_message">{{ settings.open_message|default('We are open and accepting VNV Gourmet Express orders.') }}</textarea></label><label>Message shown while closed<textarea name="pause_message">{{ settings.pause_message }}</textarea></label><label>Reopen automatically<input type="datetime-local" name="reopen_at" value="{{ settings.reopen_at ? settings.reopen_at|date('Y-m-d\\TH:i') : '' }}"></label><button>Update status</button></form></section>
<section class="ge-card wide"><h2>Commercial rules</h2><form method="post"><input type="hidden" name="action" value="save"><div class="ge-fields"><label>Pickup minimum<input type="number" step=".01" name="pickup_minimum" value="{{ settings.pickup_minimum }}"></label><label>Delivery minimum<input type="number" step=".01" name="delivery_minimum" value="{{ settings.delivery_minimum }}"></label><label>Default lead time (hours)<input type="number" name="minimum_order_notice_hours" value="{{ settings.minimum_order_notice_hours }}"></label><label>Daily capacity<input type="number" name="daily_capacity" value="{{ settings.daily_capacity }}"></label><label>Default window capacity<input type="number" name="window_capacity" value="{{ settings.window_capacity }}"></label><label>Full-service phone<input name="staff_phone" value="{{ settings.staff_phone }}"></label><label>WhatsApp number<input name="staff_whatsapp" value="{{ settings.staff_whatsapp }}"></label><label>Full-service URL<input name="staff_service_url" value="{{ settings.staff_service_url }}"></label><label><input type="checkbox" name="pickup_enabled" value="1" {{ settings.pickup_enabled|default(1) ? 'checked' : '' }}> Pickup enabled</label><label>Storefront hero image URL<input name="hero_image_url" value="{{ settings.hero_image_url }}"></label><label style="grid-column:1/-1">Pickup windows JSON<textarea name="pickup_windows_json" rows="3">{{ settings.pickup_windows_json }}</textarea></label><label style="grid-column:1/-1">Holiday deadlines JSON<textarea name="holiday_deadlines_json" rows="5">{{ settings.holiday_deadlines_json }}</textarea></label><label style="grid-column:1/-1">How food arrives<textarea name="food_arrival_policy" rows="3">{{ settings.food_arrival_policy }}</textarea></label><label style="grid-column:1/-1">Allergen policy<textarea name="allergen_policy" rows="3">{{ settings.allergen_policy }}</textarea></label><label style="grid-column:1/-1">Cancellation policy<textarea name="cancellation_policy" rows="3">{{ settings.cancellation_policy }}</textarea></label><label style="grid-column:1/-1">Global drop-off disclaimer<textarea name="dropoff_disclaimer" rows="4">{{ settings.dropoff_disclaimer }}</textarea></label></div><h3 class="mt-4">Fixed delivery zones</h3><table class="ge-table"><tr><th>Zone</th><th>Fee</th><th>Free at</th></tr>{% for zone in zones %}<tr><td>{{ zone.zone_name }}</td><td><input type="number" step=".01" name="zone_fee[{{ zone.id }}]" value="{{ zone.delivery_fee }}"></td><td><input type="number" step=".01" name="zone_free[{{ zone.id }}]" value="{{ zone.free_delivery_threshold }}"></td></tr>{% endfor %}</table><h3 class="mt-4">Delivery windows</h3><table class="ge-table"><tr><th>Window</th><th>Capacity</th></tr>{% for window in windows %}<tr><td>{{ window.label }}</td><td><input type="number" name="window_capacity_row[{{ window.id }}]" value="{{ window.capacity }}"></td></tr>{% endfor %}</table><button class="mt-3">Save commercial rules</button></form></section><section class="ge-card"><h2>Pricing policy</h2><p>Customers see only the fixed zone fee. Uber Direct remains an internal market-cost reference and never creates a dispatch.</p><a class="btn btn-outline-dark" href="{{ path('panel/planner-hub/store/delivery-pricing') }}">Open internal price checker</a></section></div></div>
<div class="container-fluid pb-4 ge"><section class="ge-card"><small>SAFE END-TO-END CHECKOUT</small><h2>Stripe purchase test</h2><p><strong>Current checkout:</strong> {{ activeProvider.provider_type|default('None')|title }} · {{ activeProvider.environment|default('not configured')|title }}</p><ol><li>Enable Stripe test mode.</li><li>Open the storefront in a private window and register a brand-new customer.</li><li>Add a main item, change quantities and add an extra.</li><li>The delivery address is validated and priced <strong>before</strong> Stripe can request payment.</li><li>Use test card <code>4242 4242 4242 4242</code>, any future date and any CVC.</li><li>Find the paid order in Level 1 and move it through preparation, delivery and received.</li><li>Restore Stripe production immediately.</li></ol><div class="d-flex flex-wrap gap-2">{% if stripeSandbox %}<form method="post"><input type="hidden" name="action" value="activate_stripe_environment"><input type="hidden" name="environment" value="sandbox"><label class="mb-2"><input type="checkbox" name="confirm_pending" value="1"> I checked for customers currently paying</label><button type="submit" class="btn btn-warning" onclick="return confirm('Temporarily route checkout to Stripe TEST mode? Do not enter real cards while it is active.')">Enable Stripe test mode</button></form>{% else %}<a class="btn btn-warning" href="{{ path('panel/planner-hub/settings/payment-providers') }}">Configure Stripe sandbox</a>{% endif %}{% if stripeProduction %}<form method="post"><input type="hidden" name="action" value="activate_stripe_environment"><input type="hidden" name="environment" value="production"><button type="submit" class="btn btn-success">Restore Stripe production</button></form>{% else %}<a class="btn btn-danger" href="{{ path('panel/planner-hub/settings/payment-providers') }}">Configure Stripe production</a>{% endif %}<a class="btn btn-outline-dark" target="_blank" rel="noopener" href="{{ path('gourmet-to-go') }}">Open storefront</a><a class="btn btn-outline-dark" href="{{ path('panel/planner-hub/store/orders/home') }}">Open Level 1 orders</a></div><p class="mt-3 mb-0 text-muted">Promotional graphics must not include prices or serving counts because both may change.</p></section></div>
{% endblock %}
