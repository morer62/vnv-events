{% extends 'templates/base.admin.twig' %}
{% block title %}VNV Gourmet Express Operations{% endblock %}
{% block body %}
<style>.ge{max-width:1380px;margin:auto;color:#142421}.ge-hero{background:linear-gradient(135deg,#102a25,#205d4b);color:#fff;border-radius:26px;padding:28px}.ge-hero h1{color:#fff!important}.ge-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:18px}.ge-card{background:#fff;border:1px solid #dbe8e3;border-radius:20px;padding:21px;box-shadow:0 12px 28px #163b2f10}.ge-card.wide{grid-column:span 2}.ge-fields{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.ge label{display:grid;gap:5px;font-weight:800}.ge input,.ge textarea{border:1px solid #cbdad4;border-radius:10px;padding:10px}.ge button{border:0;border-radius:11px;padding:11px 15px;background:#16745d;color:#fff;font-weight:900}.ge-kpi{font-size:2rem;font-weight:950;color:#175f4e}.ge-table{width:100%;border-collapse:collapse}.ge-table td,.ge-table th{padding:10px;border-bottom:1px solid #e6eeeb;text-align:left}.ge-warning{background:#fff8df;border-color:#eed58a}@media(max-width:900px){.ge-grid{grid-template-columns:1fr}.ge-card.wide{grid-column:auto}.ge-fields{grid-template-columns:1fr}}</style>
<div class="container-fluid py-4 ge"><section class="ge-hero"><small>VNV GOURMET EXPRESS · LEVEL 1</small><h1>Commercial & Operations Center</h1><p class="mb-0">Control availability, minimums, capacity, windows and fixed delivery pricing from one place.</p></section>
<div class="ge-grid"><section class="ge-card"><small>LAST 30 DAYS</small><div class="ge-kpi">{{ kpis.orders|default(0) }}</div><p>orders · ${{ kpis.revenue|default(0)|number_format(2) }} revenue</p><strong>Average order ${{ kpis.average_order|default(0)|number_format(2) }}</strong></section><section class="ge-card {{ drafts ? 'ge-warning' : '' }}"><small>VISUAL APPROVAL</small><div class="ge-kpi">{{ drafts }}</div><p>products remain in draft until their new food photography is approved.</p></section><section class="ge-card"><small>STORE STATUS</small><div class="ge-kpi">{{ settings.store_paused ? 'Paused' : 'Open' }}</div><form method="post"><input type="hidden" name="action" value="toggle_pause"><label><input type="checkbox" name="store_paused" value="1" {{ settings.store_paused ? 'checked' : '' }}> Pause new carts and checkout</label><label>Customer message<textarea name="pause_message">{{ settings.pause_message }}</textarea></label><label>Reopen automatically<input type="datetime-local" name="reopen_at" value="{{ settings.reopen_at ? settings.reopen_at|date('Y-m-d\\TH:i') : '' }}"></label><button>Update status</button></form></section>
<section class="ge-card wide"><h2>Commercial rules</h2><form method="post"><input type="hidden" name="action" value="save"><div class="ge-fields"><label>Pickup minimum<input type="number" step=".01" name="pickup_minimum" value="{{ settings.pickup_minimum }}"></label><label>Delivery minimum<input type="number" step=".01" name="delivery_minimum" value="{{ settings.delivery_minimum }}"></label><label>Default lead time (hours)<input type="number" name="minimum_order_notice_hours" value="{{ settings.minimum_order_notice_hours }}"></label><label>Daily capacity<input type="number" name="daily_capacity" value="{{ settings.daily_capacity }}"></label><label>Default window capacity<input type="number" name="window_capacity" value="{{ settings.window_capacity }}"></label></div><h3 class="mt-4">Fixed delivery zones</h3><table class="ge-table"><tr><th>Zone</th><th>Fee</th><th>Free at</th></tr>{% for zone in zones %}<tr><td>{{ zone.zone_name }}</td><td><input type="number" step=".01" name="zone_fee[{{ zone.id }}]" value="{{ zone.delivery_fee }}"></td><td><input type="number" step=".01" name="zone_free[{{ zone.id }}]" value="{{ zone.free_delivery_threshold }}"></td></tr>{% endfor %}</table><h3 class="mt-4">Delivery windows</h3><table class="ge-table"><tr><th>Window</th><th>Capacity</th></tr>{% for window in windows %}<tr><td>{{ window.label }}</td><td><input type="number" name="window_capacity_row[{{ window.id }}]" value="{{ window.capacity }}"></td></tr>{% endfor %}</table><button class="mt-3">Save commercial rules</button></form></section><section class="ge-card"><h2>Pricing policy</h2><p>Customers see only the fixed zone fee. Uber Direct remains an internal market-cost reference and never creates a dispatch.</p><a class="btn btn-outline-dark" href="{{ path('panel/planner-hub/store/delivery-pricing') }}">Open internal price checker</a></section></div></div>
{% endblock %}
