{% extends 'templates/base.admin.twig' %}

{% block body %}
<div class="container-fluid">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div>
                    <h1 class="h3 mb-1">Store Attributes</h1>
                    <p class="text-muted mb-0">Manage the attributes used by your store products.</p>
                </div>
                <a href="{{ path('panel/planner-hub/store/attributes/create') }}" class="btn btn-primary">
                    + Create Attribute
                </a>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a href="{{ path('panel/planner-hub/store/attributes/home') }}" class="btn btn-dark btn-sm">
                    Attributes
                </a>
               
                <a href="{{ path('panel/planner-hub/store/products/home') }}" class="btn btn-outline-secondary btn-sm">
                    Products
                </a>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            {% if attributes|length > 0 %}
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th style="min-width:70px;">ID</th>
                                <th style="min-width:240px;">Name</th>
                                <th style="min-width:140px;">Status</th>
                                <th style="min-width:180px;">Created</th>
                                <th style="min-width:220px;" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for a in attributes %}
                                <tr>
                                    <td>#{{ a.id }}</td>
                                    <td>
                                        <strong>{{ a.name }}</strong>
                                        {% if a.slug %}
                                            <div class="small text-muted">{{ a.slug }}</div>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if a.status == 'ACTIVE' %}
                                            <span class="badge bg-success">ACTIVE</span>
                                        {% else %}
                                            <span class="badge bg-secondary">INACTIVE</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ a.created_at ?: '—' }}</td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2 flex-wrap justify-content-end">
                                            <a href="{{ path('panel/planner-hub/store/attribute-values/home') }}?id_attribute={{ a.id }}" class="btn btn-sm btn-outline-dark">
                                                Values
                                            </a>
                                            <a href="{{ path('panel/planner-hub/store/attributes/edit') }}?id={{ a.id }}" class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>
                                            <a href="{{ path('panel/planner-hub/store/attributes/delete') }}?id={{ a.id }}"
                                               class="btn btn-sm btn-outline-danger"
                                               onclick="return confirm('Are you sure you want to delete this attribute?');">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <h5 class="mb-2">No attributes created yet</h5>
                    <p class="text-muted mb-3">Start by creating your first store attribute.</p>
                    <a href="{{ path('panel/planner-hub/store/attributes/create') }}" class="btn btn-primary">
                        + Create Attribute
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}