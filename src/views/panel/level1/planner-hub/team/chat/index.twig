{% extends 'templates/base.admin.twig' %}

{% block style %}
<style>
    :root {
        --chat-ink: #0e1b2a;
        --chat-muted: #667085;
        --chat-line: #dbe5ee;
        --chat-panel: #ffffff;
        --chat-bg: #eef5f3;
        --chat-green: #08796f;
        --chat-green-2: #11a796;
        --chat-lime: #d9f99d;
        --chat-navy: #102536;
        --chat-orange: #ffb020;
    }

    .ophyra-chat {
        height: calc(100vh - 190px);
        min-height: 620px;
        max-height: 860px;
        display: grid;
        grid-template-columns: 370px minmax(0, 1fr);
        border-radius: 30px;
        overflow: hidden;
        background:
            radial-gradient(circle at top left, rgba(17, 167, 150, 0.20), transparent 34%),
            linear-gradient(135deg, #f7fbf8 0%, #eef5f3 52%, #e8f0f8 100%);
        box-shadow: 0 28px 70px rgba(16, 37, 54, 0.14);
        border: 1px solid rgba(219, 229, 238, 0.95);
    }

    .chat-rail {
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(18px);
        border-right: 1px solid var(--chat-line);
        padding: 18px;
        overflow-y: auto;
        min-height: 0;
    }

    .chat-brand-card {
        border-radius: 26px;
        padding: 20px;
        background: linear-gradient(135deg, var(--chat-navy), #0a6c64);
        color: #fff;
        box-shadow: 0 20px 36px rgba(16, 37, 54, 0.18);
        margin-bottom: 18px;
    }

    .chat-brand-card small {
        display: block;
        opacity: 0.72;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-weight: 900;
        margin-bottom: 8px;
    }

    .chat-brand-card h2 {
        margin: 0;
        color: #fff;
        font-size: 1.45rem;
        font-weight: 950;
        letter-spacing: -0.03em;
    }

    .chat-search-wrap {
        position: sticky;
        top: 0;
        z-index: 2;
        padding-bottom: 12px;
        background: linear-gradient(180deg, rgba(255,255,255,0.96), rgba(255,255,255,0.82));
    }

    .chat-search {
        width: 100%;
        border: 1px solid var(--chat-line);
        border-radius: 999px;
        padding: 12px 15px;
        outline: none;
        background: #f8fafc;
        color: var(--chat-ink);
        font-weight: 700;
    }

    .chat-section-title {
        margin: 16px 4px 10px;
        color: #5d6b7b;
        font-size: 0.76rem;
        font-weight: 950;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .chat-card {
        display: grid;
        grid-template-columns: 46px 1fr auto;
        gap: 12px;
        align-items: center;
        margin-bottom: 10px;
        padding: 12px;
        border: 1px solid rgba(219, 229, 238, 0.95);
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.88);
        color: var(--chat-ink);
        text-decoration: none;
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease, background 0.18s ease;
    }

    .chat-card:hover,
    .chat-card.active {
        transform: translateY(-1px);
        border-color: rgba(17, 167, 150, 0.75);
        box-shadow: 0 16px 34px rgba(16, 37, 54, 0.10);
        background: #fff;
        color: var(--chat-ink);
    }

    .chat-card.active {
        background: linear-gradient(135deg, #f2fffb, #ffffff);
    }

    .chat-avatar {
        width: 46px;
        height: 46px;
        border-radius: 17px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, var(--chat-green), var(--chat-green-2));
        color: #fff;
        font-weight: 950;
        box-shadow: inset 0 -8px 18px rgba(0,0,0,0.12);
    }

    .chat-card.contact .chat-avatar {
        background: linear-gradient(135deg, #102536, #486581);
    }

    .chat-name {
        font-weight: 950;
        letter-spacing: -0.02em;
        line-height: 1.16;
    }

    .chat-company {
        display: inline-flex;
        width: fit-content;
        margin-top: 5px;
        padding: 3px 8px;
        border-radius: 999px;
        background: #e9fbf8;
        color: #067267;
        font-size: 0.72rem;
        font-weight: 950;
    }

    .chat-meta,
    .chat-preview {
        color: var(--chat-muted);
        font-size: 0.82rem;
        margin-top: 4px;
        word-break: break-word;
    }

    .chat-count {
        min-width: 24px;
        height: 24px;
        border-radius: 999px;
        display: grid;
        place-items: center;
        background: var(--chat-orange);
        color: #1f1300;
        font-size: 0.78rem;
        font-weight: 950;
    }

    .chat-stage {
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: 0;
        height: 100%;
        overflow: hidden;
    }

    .chat-topbar {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 20px 24px;
        background: rgba(255, 255, 255, 0.78);
        border-bottom: 1px solid rgba(219, 229, 238, 0.86);
        backdrop-filter: blur(18px);
    }

    .chat-topbar h3 {
        margin: 0;
        color: var(--chat-ink);
        font-size: 1.28rem;
        font-weight: 950;
        letter-spacing: -0.03em;
    }

    .chat-topbar p {
        margin: 4px 0 0;
        color: var(--chat-muted);
        font-size: 0.92rem;
    }

    .chat-status-pill {
        border-radius: 999px;
        padding: 8px 12px;
        background: #e8fff6;
        color: #067267;
        font-size: 0.78rem;
        font-weight: 950;
        white-space: nowrap;
    }

    .chat-messages {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        padding: 26px;
        display: flex;
        flex-direction: column;
        gap: 13px;
    }

    .chat-dayline {
        align-self: center;
        padding: 6px 12px;
        border-radius: 999px;
        background: rgba(255,255,255,0.78);
        color: #667085;
        font-size: 0.76rem;
        font-weight: 900;
    }

    .chat-bubble {
        flex: 0 0 auto;
        display: inline-block;
        width: fit-content;
        min-width: 0;
        max-width: min(360px, 52%);
        height: auto;
        min-height: 0;
        padding: 8px 11px;
        border-radius: 14px;
        box-shadow: 0 12px 28px rgba(16, 37, 54, 0.08);
        white-space: normal;
        word-break: break-word;
        line-height: 1.25;
        font-size: 0.96rem;
    }

    .chat-bubble.me {
        align-self: flex-end;
        margin-left: auto;
        background: linear-gradient(135deg, #08796f, #0e9487);
        color: #fff;
        border-bottom-right-radius: 5px;
    }

    .chat-bubble.them {
        align-self: flex-start;
        margin-right: auto;
        background: #ffffff;
        color: var(--chat-ink);
        border-bottom-left-radius: 5px;
    }

    .sender-info {
        font-size: 0.74rem;
        color: #64748b;
        margin-bottom: 5px;
        font-weight: 950;
    }

    .chat-bubble.me .timestamp {
        color: rgba(255, 255, 255, 0.75);
    }

    .chat-message-text {
        white-space: pre-wrap;
        word-break: break-word;
    }

    .timestamp {
        margin-top: 4px;
        text-align: right;
        color: #94a3b8;
        font-size: 0.68rem;
        font-weight: 800;
    }

    .chat-compose {
        flex: 0 0 auto;
        padding: 16px;
        background: rgba(255,255,255,0.86);
        border-top: 1px solid rgba(219, 229, 238, 0.86);
    }

    .chat-compose-inner {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 12px;
        padding: 8px;
        border-radius: 999px;
        background: #fff;
        border: 1px solid var(--chat-line);
        box-shadow: 0 14px 35px rgba(16, 37, 54, 0.08);
    }

    .chat-compose input[type="text"] {
        border: 0;
        outline: 0;
        min-width: 0;
        padding: 10px 14px;
        background: transparent;
        font-weight: 750;
    }

    .chat-compose button {
        border: 0;
        border-radius: 999px;
        padding: 0 22px;
        min-height: 44px;
        background: linear-gradient(135deg, var(--chat-green), var(--chat-green-2));
        color: #fff;
        font-weight: 950;
        box-shadow: 0 12px 24px rgba(8, 121, 111, 0.22);
    }

    .chat-empty {
        margin: auto;
        max-width: 520px;
        padding: 34px;
        text-align: center;
        color: var(--chat-muted);
    }

    .chat-empty h3 {
        margin: 0 0 8px;
        color: var(--chat-ink);
        font-weight: 950;
    }

    .chat-hidden {
        display: none !important;
    }

    .chat-back {
        display: none;
        align-items: center;
        gap: 7px;
        border: 0;
        border-radius: 999px;
        padding: 8px 12px;
        background: #eef7f5;
        color: var(--chat-green);
        font-weight: 950;
        text-decoration: none;
        white-space: nowrap;
    }

    .chat-back:hover {
        color: var(--chat-green);
        background: #dcf8f2;
    }

    @media (max-width: 940px) {
        .ophyra-chat {
            display: block;
            height: calc(100vh - 150px);
            min-height: 620px;
            max-height: none;
            border-radius: 24px;
        }

        .chat-rail {
            border-right: 0;
            border-bottom: 0;
            max-height: none;
            height: 100%;
            min-height: 0;
        }

        .chat-stage {
            min-height: 0;
            height: 100%;
        }

        .ophyra-chat.has-thread .chat-rail {
            display: none;
        }

        .ophyra-chat:not(.has-thread) .chat-stage {
            display: none;
        }

        .chat-back {
            display: inline-flex;
        }

        .chat-topbar {
            padding: 16px;
        }

        .chat-messages {
            padding: 18px;
        }

        .chat-bubble {
            max-width: 72%;
        }
    }

    @media (max-width: 520px) {
        .chat-rail,
        .chat-compose {
            padding: 12px;
        }

        .chat-brand-card {
            border-radius: 22px;
        }

        .chat-card {
            grid-template-columns: 42px 1fr auto;
            border-radius: 19px;
        }

        .chat-avatar {
            width: 42px;
            height: 42px;
            border-radius: 15px;
        }

        .chat-compose-inner {
            border-radius: 22px;
            grid-template-columns: 1fr;
        }

        .chat-compose button {
            width: 100%;
        }
    }
</style>
{% endblock %}

{% block body %}
{% set activePartnerId = thread ? (thread.id_user_1 == me.getId() ? thread.id_user_2 : thread.id_user_1) : null %}
{% set activePartnerName = thread ? (thread.id_user_1 == me.getId() ? thread.name2 : thread.name1) : null %}
{% set activePartnerEmail = thread ? (thread.id_user_1 == me.getId() ? thread.email2 : thread.email1) : null %}
{% set activeCompany = activePartnerId ? (contact_companies[activePartnerId] ?? '') : '' %}
{% set threadPartnerIds = [] %}
{% for existingThread in threads %}
    {% set existingPartnerId = existingThread.id_user_1 == me.getId() ? existingThread.id_user_2 : existingThread.id_user_1 %}
    {% set threadPartnerIds = threadPartnerIds|merge([existingPartnerId]) %}
{% endfor %}

<div class="ophyra-chat {{ thread ? 'has-thread' : 'is-inbox' }}" data-chat-root>
    <aside class="chat-rail">
        <div class="chat-brand-card">
            <small>{{ trans('messages_hub.kicker') }}</small>
            <h2>{{ trans('messages_hub.hero_title') }}</h2>
        </div>

        <div class="chat-search-wrap">
            <input class="chat-search" type="search" data-chat-search placeholder="{{ trans('messages_hub.search_placeholder') }}">
        </div>

        <div class="chat-section-title">{{ trans('messages_hub.conversations') }}</div>
        <div data-chat-list>
            {% if threads is empty %}
                <p class="text-muted px-1">{{ trans('messages_hub.no_conversations') }}</p>
            {% else %}
                {% for t in threads %}
                    {% set partnerId = t.id_user_1 == me.getId() ? t.id_user_2 : t.id_user_1 %}
                    {% set partnerName = t.id_user_1 == me.getId() ? t.name2 : t.name1 %}
                    {% set partnerEmail = t.id_user_1 == me.getId() ? t.email2 : t.email1 %}
                    {% set companyLabel = contact_companies[partnerId] ?? '' %}
                    {% set initials = (partnerName is not empty ? partnerName|first : 'U')|upper %}

                    <a href="?thread={{ t.id }}" class="chat-card thread {{ thread and thread.id == t.id ? 'active' }}" data-search-text="{{ (partnerName ~ ' ' ~ partnerEmail ~ ' ' ~ companyLabel ~ ' ' ~ (t.last_message ?? ''))|lower|e('html_attr') }}">
                        <div class="chat-avatar">{{ initials }}</div>
                        <div>
                            <div class="chat-name">{{ partnerName is not empty ? partnerName : trans('messages_hub.user_fallback') ~ ' ' ~ partnerId }}</div>
                            {% if companyLabel %}<div class="chat-company">{{ companyLabel }}</div>{% endif %}
                            <div class="chat-meta">{{ partnerEmail ?? '' }}</div>
                            {% if t.last_message %}<div class="chat-preview">{{ t.last_message|slice(0, 56) }}{% if t.last_message|length > 56 %}...{% endif %}</div>{% endif %}
                        </div>
                        {% if t.unread_count > 0 %}<div class="chat-count">{{ t.unread_count }}</div>{% endif %}
                    </a>
                {% endfor %}
            {% endif %}
        </div>

        {% if users is not empty %}
            <div class="chat-section-title">{{ trans('messages_hub.available_contacts') }}</div>
            <div data-chat-contacts>
                {% for u in users %}
                    {% if u.id != me.getId() and u.id not in threadPartnerIds %}
                        {% set companyLabel = contact_companies[u.id] ?? u.company_name ?? u.institution_name ?? '' %}
                        {% set fullName = ((u.name ?? '') ~ ' ' ~ (u.lastname ?? ''))|trim %}
                        {% set initials = (fullName is not empty ? fullName|first : 'U')|upper %}
                        <a href="?to={{ u.id }}" class="chat-card contact" data-search-text="{{ (fullName ~ ' ' ~ (u.email ?? '') ~ ' ' ~ companyLabel)|lower|e('html_attr') }}">
                            <div class="chat-avatar">{{ initials }}</div>
                            <div>
                                <div class="chat-name">{{ fullName ?: (trans('messages_hub.user_fallback') ~ ' ' ~ u.id) }}</div>
                                {% if companyLabel %}<div class="chat-company">{{ companyLabel }}</div>{% endif %}
                                <div class="chat-meta">{{ u.email ?? '' }}</div>
                            </div>
                            <div aria-hidden="true" style="color:#08796f;font-weight:950;">+</div>
                        </a>
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}
    </aside>

    <main class="chat-stage">
        {% if thread %}
            <header class="chat-topbar">
                <div>
                    <a class="chat-back mb-2" href="?" data-chat-back>{{ trans('messages_hub.back_to_chats') }}</a>
                    <h3>{{ activePartnerName is not empty ? activePartnerName : trans('messages_hub.user_fallback') ~ ' ' ~ activePartnerId }}</h3>
                    <p>{{ activePartnerEmail ?? '' }}{% if activeCompany %} · {{ activeCompany }}{% endif %}</p>
                </div>
                <div class="chat-status-pill">{{ trans('messages_hub.secure_thread') }}</div>
            </header>

            <section class="chat-messages" id="chatMessages" data-thread-id="{{ thread.id }}" data-me-id="{{ me.getId() }}">
                {% if messages is empty %}
                    <div class="chat-empty" data-empty-chat>
                        <h3>{{ trans('messages_hub.thread_ready') }}</h3>
                        <p>{{ trans('messages_hub.first_message') }}</p>
                    </div>
                {% else %}
                    {% for msg in messages %}
                        <article class="chat-bubble {{ msg.id_sender == me.getId() ? 'me' : 'them' }}">
                            {% if msg.id_sender != me.getId() %}
                                <div class="sender-info">{{ msg.sender_name ?? (trans('messages_hub.user_fallback') ~ ' ' ~ msg.id_sender) }} · {{ msg.sender_email ?? '' }}</div>
                            {% endif %}
                            <div class="chat-message-text">{{ msg.message }}</div>
                            <div class="timestamp">{{ msg.created_at|date("H:i") }}</div>
                        </article>
                    {% endfor %}
                {% endif %}
            </section>

            <form method="post" class="chat-compose" data-chat-form>
                <input type="hidden" name="to" value="{{ activePartnerId }}" />
                <div class="chat-compose-inner">
                    <input type="text" name="message" placeholder="{{ trans('messages_hub.write_placeholder') }}" autocomplete="off" required autofocus />
                    <button type="submit">{{ trans('messages_hub.send') }}</button>
                </div>
            </form>
        {% else %}
            <div class="chat-empty">
                <h3>{{ trans('messages_hub.select_conversation') }}</h3>
                <p>{{ trans('messages_hub.select_conversation_body') }}</p>
            </div>
        {% endif %}
    </main>
</div>
{% endblock %}

{% block scripts %}
<script>
(() => {
    const root = document.querySelector('[data-chat-root]');
    if (!root) return;

    const search = root.querySelector('[data-chat-search]');
    const messages = document.getElementById('chatMessages');
    const form = root.querySelector('[data-chat-form]');
    const meId = messages ? Number(messages.dataset.meId) : null;
    const threadId = messages ? messages.dataset.threadId : null;
    const chatI18n = {
        threadReady: "{{ trans('messages_hub.thread_ready')|e('js') }}",
        firstMessage: "{{ trans('messages_hub.first_message')|e('js') }}",
        userFallback: "{{ trans('messages_hub.user_fallback')|e('js') }}",
        sending: "{{ trans('messages_hub.sending')|e('js') }}",
        send: "{{ trans('messages_hub.send')|e('js') }}",
        requestFailed: "{{ trans('messages_hub.request_failed')|e('js') }}"
    };

    const scrollBottom = () => {
        if (messages) messages.scrollTop = messages.scrollHeight;
    };

    scrollBottom();

    if (search) {
        search.addEventListener('input', () => {
            const term = search.value.trim().toLowerCase();
            root.querySelectorAll('[data-search-text]').forEach(item => {
                const haystack = item.dataset.searchText || '';
                item.classList.toggle('chat-hidden', term !== '' && !haystack.includes(term));
            });
        });
    }

    const back = root.querySelector('[data-chat-back]');
    if (back) {
        back.addEventListener('click', (event) => {
            if (!window.matchMedia('(max-width: 940px)').matches) return;
            event.preventDefault();
            root.classList.remove('has-thread');
            root.classList.add('is-inbox');
            window.history.replaceState({}, '', window.location.pathname);
            const rail = root.querySelector('.chat-rail');
            if (rail) rail.scrollTop = 0;
        });
    }

    function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>'"]/g, char => ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            "'": '&#039;',
            '"': '&quot;'
        }[char]));
    }

    function renderMessages(items) {
        if (!messages || !Array.isArray(items)) return;
        messages.innerHTML = '';
        if (items.length === 0) {
            messages.innerHTML = `<div class="chat-empty" data-empty-chat><h3>${escapeHtml(chatI18n.threadReady)}</h3><p>${escapeHtml(chatI18n.firstMessage)}</p></div>`;
            return;
        }

        items.forEach(msg => {
            const mine = Number(msg.id_sender) === meId;
            const created = String(msg.created_at || '');
            const time = created.length >= 16 ? created.slice(11, 16) : '';
            const article = document.createElement('article');
            article.className = `chat-bubble ${mine ? 'me' : 'them'}`;
            article.innerHTML = `${mine ? '' : `<div class="sender-info">${escapeHtml(msg.sender_name || (chatI18n.userFallback + ' ' + msg.id_sender))} · ${escapeHtml(msg.sender_email || '')}</div>`}<div class="chat-message-text">${escapeHtml(msg.message)}</div><div class="timestamp">${escapeHtml(time)}</div>`;
            messages.appendChild(article);
        });
        scrollBottom();
    }

    function appendOwnMessage(message) {
        if (!messages) return;
        const empty = messages.querySelector('[data-empty-chat]');
        if (empty) empty.remove();

        const now = new Date();
        const time = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');
        const article = document.createElement('article');
        article.className = 'chat-bubble me';
        article.innerHTML = `<div class="chat-message-text">${escapeHtml(message)}</div><div class="timestamp">${escapeHtml(time)}</div>`;
        messages.appendChild(article);
        scrollBottom();
    }

    function apiBasePath() {
        const parts = window.location.pathname.split('/').filter(Boolean);
        if (parts.length && parts[0] !== 'panel' && parts[0] !== 'api') {
            return '/' + parts[0];
        }
        return '';
    }

    async function fetchJsonWithFallback(urls) {
        for (const url of urls) {
            try {
                const response = await fetch(url, {
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json', 'Cache-Control': 'no-cache' }
                });
                if (!response.ok) continue;
                const json = await response.json();
                if (json && json.success) return json;
            } catch (error) {
                // Try the next route shape.
            }
        }
        return null;
    }

    async function refreshMessages() {
        if (!threadId || !messages) return;
        const encodedThread = encodeURIComponent(threadId);
        const base = apiBasePath();
        const json = await fetchJsonWithFallback([
            `${base}/api/chat/messages?thread=${encodedThread}&_=${Date.now()}`,
            `${base}/api/chat/messages.php?thread=${encodedThread}&_=${Date.now()}`
        ]);
        if (json && json.success) renderMessages(json.data || []);
    }

    if (form) {
        form.addEventListener('submit', async (event) => {
            event.preventDefault();
            const input = form.querySelector('input[name="message"]');
            const toInput = form.querySelector('input[name="to"]');
            const button = form.querySelector('button[type="submit"]');
            const message = (input?.value || '').trim();
            const to = toInput?.value || '';
            if (!message || !to) return;

            if (button) {
                button.disabled = true;
                button.textContent = chatI18n.sending;
            }

            const payload = new FormData();
            payload.append('to', to);
            payload.append('message', message);

            try {
                const response = await fetch(window.location.href, {
                    method: 'POST',
                    body: payload,
                    credentials: 'same-origin',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!response.ok) throw new Error(chatI18n.requestFailed);
                input.value = '';
                appendOwnMessage(message);
                window.setTimeout(refreshMessages, 700);
            } catch (error) {
                form.submit();
                return;
            } finally {
                if (button) {
                    button.disabled = false;
                    button.textContent = chatI18n.send;
                }
            }
        });
    }

    if (threadId) {
        window.setInterval(refreshMessages, 1600);
    }
})();
</script>
{% endblock %}

