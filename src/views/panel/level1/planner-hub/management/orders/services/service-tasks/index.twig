{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %} 
  <h2 class="mb-4">📝 Tasks for Service: {{ service_name }}</h2>

  {{ macros.breadcrumb2() }}

  {# Mensajes flash si tu layout los muestra #}
  {% if app.message %}
    <div class="alert alert-info">{{ app.message }}</div>
  {% endif %}

  {# --- Formulario: Requirements del servicio --- #}
  <form method="post" class="card mb-4">
    <div class="card-body">
      <input type="hidden" name="service_id" value="{{ service_id }}">
      <input type="hidden" name="save_requirements" value="1">
      <label class="form-label fw-semibold">Requirements (notes for this service)</label>
      
      <textarea name="requirements" rows="5" class="form-control" placeholder="Write requirements for this service..."  value="{{ requirements|default('') }}" ></textarea>
      <div class="mt-3">
        <button class="btn btn-dark" type="submit">💾 Save requirements</button>
      </div>
    </div>
  </form>

  {# --- Formulario: Agregar nueva tarea --- #}
  <form method="post" class="card mb-4">
    <div class="card-body d-flex gap-2">
      <input type="hidden" name="service_id" value="{{ service_id }}">
      <input type="text" maxlength="60" name="task_name" class="form-control" placeholder="New task name..." required>
      <button class="btn btn-dark" type="submit">Add</button>
    </div>
  </form>

  <div class="table-responsive">
    <table class="table table-bordered text-center align-middle" style="min-width: 500px;">
      <thead>
        <tr>
          <th>Task</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for task in tasks %}
          <tr>
            <td>{{ task.task_name }}</td>
            <td class="d-flex justify-content-center gap-2">
              <a href="{{ path('panel/planner-hub/management/orders/services/service-tasks/edit', { id: task.id, service_id: service_id }) }}" class="btn btn-primary">✏️ Edit</a>
              <form method="post" class="d-inline-block" onsubmit="return confirm('Are you sure?')">
                <input type="hidden" name="delete_id" value="{{ task.id }}">
                <input type="hidden" name="service_id" value="{{ service_id }}">
                <button type="submit" class="btn btn-danger">🗑️ Delete</button>
              </form>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="2" class="text-muted">No tasks yet for this service.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endblock %}
