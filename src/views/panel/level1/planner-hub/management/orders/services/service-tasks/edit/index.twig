{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<h2 class="mb-4">✏️ Edit Task</h2>
 
 <a href="{{ path('panel/planner-hub/management/orders/services/service-tasks/', { service_id: service_id }) }}" class="btn btn-sm btn-light mb-3">← Back to Services</a>

<form method="post" class="card">
    <div class="card-body">
        <input type="hidden" name="id" value="{{ task.id }}">
        <input type="hidden" name="service_id" value="{{ service_id }}">

        <div class="mb-3">
            <label for="task_name" class="form-label">Task Name</label>
            <input type="text"  maxlength="60" name="task_name" id="task_name" class="form-control" value="{{ task.task_name }}" required>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-dark">💾 Save</button>
            <a href="{{ path('panel/planner-hub/management/orders/services/service-tasks/', { service_id: service_id }) }}" class="btn btn-danger">← Cancel</a>
        </div>
    </div>
</form>
{% endblock %}
