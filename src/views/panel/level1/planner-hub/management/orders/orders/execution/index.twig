{% extends 'templates/base.admin.twig' %}

{% block style %}
<style>
  .execution-hero{background:linear-gradient(135deg,#101827,#153b3a);color:#fff;border:0;border-radius:22px;overflow:hidden}.execution-kicker{color:#55dfc8;font-size:.75rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.execution-range{color:#d8eeea}.execution-tabs .nav-link{font-weight:700;color:#53606d}.execution-tabs .nav-link.active{color:#087267;border-bottom-color:#087267}.execution-card{border:1px solid #e2e8ec;border-radius:18px;box-shadow:0 10px 34px rgba(16,24,39,.06);overflow:hidden}.execution-table th{white-space:nowrap;font-size:.78rem;text-transform:uppercase;letter-spacing:.04em;color:#65727e;background:#f7f9fa}.execution-table td{vertical-align:middle}.execution-client{min-width:180px}.execution-address{min-width:240px}.execution-files{min-width:220px}.execution-file{display:flex;align-items:center;gap:6px;margin-bottom:5px}.execution-empty{padding:56px 20px;text-align:center;color:#65727e}.execution-time{white-space:nowrap;font-weight:700;color:#19252f}.paid-pill{display:inline-flex;align-items:center;gap:5px;border-radius:999px;background:#e6f7f1;color:#08745f;padding:5px 9px;font-size:.75rem;font-weight:800}@media(max-width:767px){.execution-filter .btn{width:100%}.execution-hero{border-radius:16px}}
</style>
{% endblock %}

{% block body %}
<section class="card execution-hero mb-4">
  <div class="card-body p-4 p-lg-5 d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
    <div><div class="execution-kicker">VNV event operations</div><h1 class="h2 mb-2">Weekly Execution</h1><p class="execution-range mb-0">Fully paid events from {{ startDate|date('M j, Y') }} through {{ endDate|date('M j, Y') }}, ordered by exact start time.</p></div>
    <span class="badge rounded-pill bg-light text-dark fs-6 px-3 py-2">{{ events|length }} ready event{{ events|length == 1 ? '' : 's' }}</span>
  </div>
</section>

<ul class="nav nav-tabs execution-tabs mb-4">
  <li class="nav-item"><a class="nav-link active" href="{{ path('panel/planner-hub/management/orders/orders/execution') }}">Execution</a></li>
  <li class="nav-item"><a class="nav-link" href="{{ path('panel/planner-hub/management/orders/orders') }}?tab=orders">Orders</a></li>
  <li class="nav-item"><a class="nav-link" href="{{ path('panel/planner-hub/management/orders/orders') }}?tab=estimates">Estimates</a></li>
</ul>

<div class="card execution-card mb-4"><div class="card-body">
  <div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn {{ weekPreset == 'previous' ? 'btn-dark' : 'btn-outline-secondary' }}" href="?week=previous">Previous week</a>
    <a class="btn {{ weekPreset == 'current' ? 'btn-dark' : 'btn-outline-secondary' }}" href="?week=current">Current week</a>
    <a class="btn {{ weekPreset == 'next' ? 'btn-dark' : 'btn-outline-secondary' }}" href="?week=next">Next week</a>
  </div>
  <form method="get" class="row g-2 execution-filter align-items-end">
    <div class="col-md-4"><label class="form-label">From</label><input class="form-control" type="date" name="start_date" value="{{ startDate }}" required></div>
    <div class="col-md-4"><label class="form-label">Through</label><input class="form-control" type="date" name="end_date" value="{{ endDate }}" required></div>
    <div class="col-md-4"><button class="btn btn-primary">Apply date range</button></div>
  </form>
</div></div>

<section class="card execution-card">
  <div class="table-responsive">
    <table class="table execution-table mb-0">
      <thead><tr><th>Client</th><th>Date</th><th>Start – End</th><th>Address / directions</th><th>Ready</th><th>Order access</th><th>Operations</th><th>Execution files</th></tr></thead>
      <tbody>
      {% for event in events %}
        <tr>
          <td class="execution-client"><strong>{{ event.client_name }}</strong><small class="d-block text-muted">VNV-341{{ event.id }}</small>{% if event.client_email %}<small class="d-block text-muted">{{ event.client_email }}</small>{% endif %}</td>
          <td><strong>{{ event.event_date|date('D, M j') }}</strong><small class="d-block text-muted">{{ event.event_date|date('Y') }}</small></td>
          <td class="execution-time">{{ event.start_time ? event.start_time|date('g:i A') : 'TBD' }}<span class="text-muted mx-1">–</span>{{ event.end_time ? event.end_time|date('g:i A') : 'TBD' }}</td>
          <td class="execution-address">{% if event.address %}<a href="https://www.google.com/maps/search/?api=1&query={{ event.address|url_encode }}" target="_blank" rel="noopener"><i data-feather="map-pin"></i> {{ event.address }}</a>{% else %}<span class="text-muted">Address pending</span>{% endif %}</td>
          <td><span class="paid-pill"><i data-feather="check-circle"></i> 100% paid</span><small class="d-block text-muted mt-1">${{ event.paid_total|number_format(2) }} / ${{ event.order_total|number_format(2) }}</small></td>
          <td><a class="btn btn-sm btn-outline-primary" href="{{ path('order-access') }}?token={{ event.contract_token|url_encode }}" target="_blank" rel="noopener">Payment & signature</a></td>
          <td><div class="d-grid gap-1"><a class="btn btn-sm btn-outline-dark" href="{{ path('panel/planner-hub/management/orders/orders/team_comunication') }}?id={{ event.id }}">Operational details</a><a class="btn btn-sm btn-outline-secondary" href="{{ path('panel/planner-hub/management/orders/orders/print') }}?id={{ event.id }}" target="_blank">Order details</a></div></td>
          <td class="execution-files">
            {% for file in event.execution_files %}<div class="execution-file"><i data-feather="paperclip"></i><a href="{{ file.file_path }}" target="_blank" rel="noopener">{{ file.title|default('Order file') }}</a></div>{% else %}<small class="text-muted d-block mb-2">No additional files.</small>{% endfor %}
            <button class="btn btn-sm btn-success" type="button" data-bs-toggle="modal" data-bs-target="#uploadExecutionFile" data-order-id="{{ event.id }}" data-order-label="VNV-341{{ event.id }}">Add file</button>
          </td>
        </tr>
      {% else %}
        <tr><td colspan="8" class="execution-empty"><i data-feather="calendar" style="width:38px;height:38px"></i><h3 class="h5 mt-3">No fully paid events in this range</h3><p class="mb-0">Events appear automatically once the complete order and its sub-orders are paid.</p></td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

<div class="modal fade" id="uploadExecutionFile" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered"><form class="modal-content" method="post" enctype="multipart/form-data">
    <div class="modal-header"><div><h2 class="modal-title h5 mb-0">Add execution file</h2><small class="text-muted" id="executionOrderLabel"></small></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body"><input type="hidden" name="action" value="upload_file"><input type="hidden" name="order_id" id="executionOrderId"><div class="mb-3"><label class="form-label">File name</label><input class="form-control" name="title" maxlength="160" required placeholder="Example: Final floor plan"></div><div><label class="form-label">File</label><input class="form-control" type="file" name="file" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.webp" required><small class="text-muted">PDF, Word or image; maximum 25 MB.</small></div></div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-success">Upload file</button></div>
  </form></div>
</div>
{% endblock %}

{% block script %}
<script>
document.getElementById('uploadExecutionFile')?.addEventListener('show.bs.modal', function (event) {
  const button = event.relatedTarget;
  document.getElementById('executionOrderId').value = button?.dataset.orderId || '';
  document.getElementById('executionOrderLabel').textContent = button?.dataset.orderLabel || '';
});
</script>
{% endblock %}
