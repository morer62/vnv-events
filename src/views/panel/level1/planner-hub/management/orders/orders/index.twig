            return;
        }

        if ($.fn.DataTable.isDataTable('#ordersTable')) {
            return;
        }
        
        ordersTable.find('tbody tr').each(function() {
            if ($(this).find('td[colspan]').length > 0) {
                $(this).remove();
            }
        });
        
        try {
            if (!window.ordersTableOriginalData) {
                window.ordersTableOriginalData = {};
            }
            
            ordersTable.find('tbody tr').each(function(rowIndex) {
                var $row = $(this);
                var rowData = [];
                
                $row.find('td').each(function(cellIndex) {
                    var $cell = $(this);
                    var originalHtml = $cell.html() || '';
                    rowData[cellIndex] = originalHtml;
                    $cell.attr('data-cell-index', cellIndex);
                    $cell.attr('data-row-index', rowIndex);
                    $cell.attr('data-original-html', originalHtml);
                });
                
