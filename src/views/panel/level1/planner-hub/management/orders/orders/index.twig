<script>
    async function copyPaymentLink(originalUrl) {
        try {
            const button = event.target;
            const originalText = button.innerHTML;
            
            button.innerHTML = '⏳ Copying...';
            button.disabled = true;
            
            await navigator.clipboard.writeText(originalUrl);
            
            button.innerHTML = '✅ Copied!';
            button.classList.remove('btn-outline-primary', 'btn-outline-success');
            button.classList.add('btn-success');
            
            setTimeout(() => {
                button.innerHTML = originalText;
                button.classList.remove('btn-success');
                button.classList.add(originalText.includes('Payment') ? 'btn-outline-primary' : 'btn-outline-success');
                button.disabled = false;
            }, 2000);
            
            showToast('Link copied to clipboard!', 'success');
        } catch (error) {
            const button = event.target;
            button.innerHTML = '❌ Error';
            button.classList.remove('btn-outline-primary', 'btn-outline-success');
            button.classList.add('btn-danger');
            
            setTimeout(() => {
                button.innerHTML = originalText;
                button.classList.remove('btn-danger');
                button.classList.add(originalText.includes('Payment') ? 'btn-outline-primary' : 'btn-outline-success');
                button.disabled = false;
            }, 2000);
            
            showToast('Error copying link. Please try again.', 'error');
        }
    }
    
    function showToast(message, type = 'info') {
        const toastContainer = document.getElementById('toast-container') || createToastContainer();
        
        const toast = document.createElement('div');
        toast.className = `toast align-items-center text-white bg-${type === 'success' ? 'success' : type === 'error' ? 'danger' : 'info'} border-0`;
        toast.setAttribute('role', 'alert');
        toast.setAttribute('aria-live', 'assertive');
        toast.setAttribute('aria-atomic', 'true');
        
        toast.innerHTML = `
            <div class="d-flex">
                <div class="toast-body">
                    ${message}
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        `;
        
        toastContainer.appendChild(toast);
        
        const bsToast = new bootstrap.Toast(toast);
        bsToast.show();
        
        toast.addEventListener('hidden.bs.toast', () => {
            toast.remove();
        });
    }
    
    function createToastContainer() {
        const container = document.createElement('div');
        container.id = 'toast-container';
        container.className = 'toast-container position-fixed top-0 end-0 p-3';
        container.style.zIndex = '9999';
        document.body.appendChild(container);
        return container;
    }

    document.addEventListener("DOMContentLoaded", function () {
        const tabs = document.querySelectorAll('[data-bs-toggle="tab"]');
        const tabContents = document.querySelectorAll('.tab-pane');
        
        tabs.forEach(tab => {
            tab.addEventListener('click', function(e) {
                e.preventDefault();
                
                tabs.forEach(t => {
                    t.classList.remove('active');
                    t.setAttribute('aria-selected', 'false');
                });
                
                tabContents.forEach(content => {
                    content.classList.remove('show', 'active');
                });
                
                this.classList.add('active');
                this.setAttribute('aria-selected', 'true');
                
                const targetId = this.getAttribute('data-bs-target');
                const targetContent = document.querySelector(targetId);
                if (targetContent) {
                    targetContent.classList.add('show', 'active');
                }
                
                const activeTabInput = document.getElementById('active-tab-input');
                if (this.id === 'orders-tab') {
                    activeTabInput.value = 'orders';
                } else if (this.id === 'estimates-tab') {
                    activeTabInput.value = 'estimates';
                }
            });
        });
        
        const ordersCount = {{ orders|length }};
        const estimatesCount = {{ estimates|length }};
        
        if (ordersCount > estimatesCount) {
            document.getElementById('orders-tab').classList.add('fw-bold');
        } else if (estimatesCount > ordersCount) {
            document.getElementById('estimates-tab').classList.add('fw-bold');
        }
        
        const urlParams = new URLSearchParams(window.location.search);
        const activeTab = urlParams.get('tab') || 'orders';
        
        if (activeTab === 'estimates') {
            document.getElementById('estimates-tab').classList.add('active');
            document.getElementById('estimates-tab').setAttribute('aria-selected', 'true');
            document.getElementById('orders-tab').classList.remove('active');
            document.getElementById('orders-tab').setAttribute('aria-selected', 'false');
            
            document.getElementById('estimates-content').classList.add('show', 'active');
            document.getElementById('orders-content').classList.remove('show', 'active');
            
            document.getElementById('active-tab-input').value = 'estimates';
        } else {
            document.getElementById('orders-tab').classList.add('active');
            document.getElementById('orders-tab').setAttribute('aria-selected', 'true');
            document.getElementById('estimates-tab').classList.remove('active');
            document.getElementById('estimates-tab').setAttribute('aria-selected', 'false');
            
            document.getElementById('orders-content').classList.add('show', 'active');
            document.getElementById('estimates-content').classList.remove('show', 'active');
            
            document.getElementById('active-tab-input').value = 'orders';
        }

        try {
            const qp = new URLSearchParams(window.location.search);
            if (qp.get('add_calendar') === '1') {
                const orderId = qp.get('order_id');
                const clientId = qp.get('client_id');
                if (orderId && clientId) {
                    const btn = document.querySelector(`button[onclick*="addToCalendar(${orderId}"]`);
                    if (btn) {
                        btn.click();
                    } else {
                        addToCalendar(parseInt(orderId, 10), clientId);
                    }
                }
            }
        } catch (e) {}

        setTimeout(function() {
            initializeDataTables();
        }, 300);

        const tabButtons = document.querySelectorAll('[data-bs-toggle="tab"]');
        tabButtons.forEach(button => {
            button.addEventListener('shown.bs.tab', function (e) {
                const targetId = e.target.getAttribute('data-bs-target');
                
                setTimeout(function() {
                    const $ = jQuery;
                    if (targetId === '#orders-content') {
                        if ($.fn.DataTable.isDataTable('#ordersTable')) {
                            const table = $('#ordersTable').DataTable();
                            table.columns.adjust().responsive.recalc();
                        } else {
                            initializeOrdersTable();
                        }
                    } else if (targetId === '#estimates-content') {
                        if ($.fn.DataTable.isDataTable('#estimatesTable')) {
                            const table = $('#estimatesTable').DataTable();
                            table.columns.adjust().responsive.recalc();
                        } else {
                            initializeEstimatesTable();
                        }
                    }
                }, 100);
            });
        });
    });

    function initializeDataTables() {
        initializeOrdersTable();
        initializeEstimatesTable();
    }

    function initializeOrdersTable() {
        if (typeof jQuery === 'undefined' || typeof jQuery.fn.dataTable === 'undefined') {
            setTimeout(initializeOrdersTable, 100);
