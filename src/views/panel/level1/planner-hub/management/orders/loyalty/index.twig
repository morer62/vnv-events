{% extends 'templates/base.admin.twig' %}
{% block body %}<main class="container-fluid py-4" style="max-width:1200px">
<div class="d-flex justify-content-between align-items-center mb-4"><div><small class="text-uppercase fw-bold text-success">Orders · Loyalty</small><h1 class="fw-bold mb-1">Rewards settings</h1><p class="text-muted mb-0">Values are stored per business and site. Existing ledger entries keep their original snapshots.</p></div><a class="btn btn-outline-dark" href="{{ path('panel/planner-hub/management/orders/orders/execution') }}">Back to Execution</a></div>
{% if message %}<div class="alert alert-{{ message.type=='error'?'danger':'success' }}">{{ message.message }}</div>{% endif %}
<div class="row g-4"><div class="col-lg-6"><section class="card vnv-panel-card"><div class="card-body"><h2 class="h5 fw-bold">Earning and value</h2><form method="post" class="row g-3"><input type="hidden" name="action" value="settings"><div class="col-md-4"><label class="form-label">Reward percent</label><div class="input-group"><input class="form-control" type="number" min="0" max="100" step="0.0001" name="reward_percent" value="{{ settings.reward_percent }}" required><span class="input-group-text">%</span></div></div><div class="col-md-4"><label class="form-label">Dollar value per point</label><div class="input-group"><span class="input-group-text">$</span><input class="form-control" type="number" min="0.0001" step="0.0001" name="point_value" value="{{ settings.point_value }}" required></div></div><div class="col-md-4"><label class="form-label">Release delay</label><div class="input-group"><input class="form-control" type="number" min="0" max="365" name="release_days" value="{{ settings.release_days }}" required><span class="input-group-text">days</span></div></div><div class="col-12"><button class="btn btn-success">Save rewards settings</button></div></form></div></section></div>
<div class="col-lg-6"><section class="card vnv-panel-card"><div class="card-body"><h2 class="h5 fw-bold">Customer ledger</h2><form method="get" class="d-flex gap-2"><input class="form-control" type="number" min="1" name="client_id" value="{{ client.id|default('') }}" placeholder="Customer user ID" required><button class="btn btn-dark">Open</button></form>{% if client %}<hr><strong>{{ client.name }} {{ client.lastname }}</strong><div class="row g-2 my-2"><div class="col"><div class="p-3 bg-light rounded"><b>{{ balance.available_points|number_format(2) }}</b><br><small>Available · ${{ balance.available_value|number_format(2) }}</small></div></div><div class="col"><div class="p-3 bg-light rounded"><b>{{ balance.pending_points|number_format(2) }}</b><br><small>Pending</small></div></div></div><form method="post" class="row g-2"><input type="hidden" name="action" value="adjust"><input type="hidden" name="client_id" value="{{ client.id }}"><div class="col-4"><input class="form-control" type="number" step="0.0001" name="points" placeholder="+ / - points" required></div><div class="col-5"><input class="form-control" name="reason" placeholder="Required reason" required></div><div class="col-3"><button class="btn btn-warning w-100">Adjust</button></div></form>{% endif %}</div></section></div></div>
{% if history|length %}<section class="card vnv-panel-card mt-4"><div class="card-body"><h2 class="h5 fw-bold">Audit history</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Date</th><th>Movement</th><th>Points</th><th>Value</th><th>Status</th><th>Description</th></tr></thead><tbody>{% for row in history %}<tr><td>{{ row.created_at|date('M j, Y g:i A') }}</td><td>{{ row.transaction_type }}</td><td>{{ row.points > 0?'+':'' }}{{ row.points|number_format(2) }}</td><td>${{ row.monetary_value|abs|number_format(2) }}</td><td><span class="badge text-bg-secondary">{{ row.status }}</span></td><td>{{ row.description }}</td></tr>{% endfor %}</tbody></table></div></div></section>{% endif %}</main>{% endblock %}
