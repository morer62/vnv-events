{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<main class="mt-4">
    <div class="container">

        <h1 class="h3">Order Menu</h1>
        {{ macros.breadcrumb2() }}

        {% if stripe_connected %}
            <p class="text-center mb-4">
                <a href="{{ path('panel/planner-hub/management/payments') }}" class="text-decoration-none" style="color: #28a745; font-weight: 600;">
                    💳 View your payment history
                </a>
            </p>
        {% endif %}

        <div class="d-flex justify-content-between mb-3">
            <a class="btn btn-dark" href="{{ path(current_location ~ '/orders/create') }}">
                <i data-feather="plus"></i> Create new estimate
            </a>
            <a class="btn btn-outline-secondary" href="{{ path('/panel/planner-hub/management/orders/orders/previous') }}">
                <i data-feather="clock"></i> Previous Orders
            </a>
        </div>


        <div class="row">
            <!-- Orders -->
            <div class="col-12 col-md-4 col-lg-3 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center py-4">
                        <h5 class="card-title mb-2 text-muted">Orders and Estimates</h5>
                        <p class="card-text small text-muted">Track event bookings, timelines, and resources in one place.</p>
                        <a href="{{ path('panel/planner-hub/management/orders/orders/') }}" class="btn btn-primary btn-sm mt-2">Go to Orders</a>
                    </div>
                </div>
            </div>

            <!-- Services -->
            <div class="col-12 col-md-4 col-lg-3 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center py-4">
                        <h5 class="card-title mb-2 text-muted">Your Services</h5>
                        <p class="card-text small text-muted">Create and manage services per event type and requirement.</p>
                        <a href="{{ path('panel/planner-hub/management/orders/services') }}" class="btn btn-primary btn-sm mt-2">Go to Services</a>
                    </div>
                </div>
            </div>

            <!-- Contracts -->
            <div class="col-12 col-md-4 col-lg-3 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center py-4">
                        <h5 class="card-title mb-2 text-muted">Contracts</h5>
                        <p class="card-text small text-muted">View, generate, and manage event-related contracts.</p>
                        <a href="{{ path('panel/planner-hub/management/orders/contracts') }}" class="btn btn-primary btn-sm mt-2">Go to Contracts</a>
                    </div>
                </div>
            </div>

            <!-- Tips -->
            <div class="col-12 col-md-4 col-lg-3 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center py-4">
                        <h5 class="card-title mb-2 text-muted">Tips</h5>
                        <p class="card-text small text-muted">Configure tip percentages for orders.</p>
                        <a href="{{ path('panel/planner-hub/management/orders/tips') }}" class="btn btn-primary btn-sm mt-2">Go to Tips</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
{% endblock %}
