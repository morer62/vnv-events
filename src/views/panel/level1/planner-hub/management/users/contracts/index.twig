{% extends 'templates/base.admin.twig' %}

{% set latest = latest_contract %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Employee Contract</h1>
        <div class="text-muted">{{ member.name }} {{ member.lastname }} - {{ member.email }}</div>
    </div>
    <a href="{{ path('panel/planner-hub/management/users') }}" class="btn btn-outline-secondary">Back</a>
</div>

<div class="alert alert-info">
    Employee contracts are separate from order contracts and service acceptance templates. Create employee templates here, then assign one for this team member to sign.
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header fw-bold">Current Status</div>
            <div class="card-body">
                {% if latest %}
                    <div class="mb-2">
                        <span class="badge bg-{{ latest.status in ['SIGNED','VALIDATED','MANUALLY_UPLOADED'] ? 'success' : (latest.status == 'REJECTED' ? 'danger' : 'warning') }}">
                            {{ latest.status }}
                        </span>
                    </div>
                    <div class="small text-muted">Updated: {{ latest.updated_at }}</div>
                    {% set pdf = latest.generated_pdf_path ?: latest.signed_file_path ?: latest.original_file_path %}
                    {% if pdf %}
                        <a href="{{ pdf }}" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary mt-3">View / Download PDF</a>
                    {% endif %}
                    {% if latest.status == 'SIGNED' %}
                        <form method="post" class="mt-3">
                            <input type="hidden" name="team_member_id" value="{{ member.id }}">
                            <input type="hidden" name="contract_id" value="{{ latest.id }}">
                            <input type="hidden" name="action" value="validate">
                            <button class="btn btn-success btn-sm">Validate Signed Contract</button>
                        </form>
                    {% endif %}
                {% else %}
                    <span class="badge bg-secondary">NOT_ASSIGNED</span>
                    <p class="text-muted mt-2 mb-0">Create or assign an employee contract template, or upload a signed PDF manually.</p>
                {% endif %}
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-bold">Manual Upload</div>
            <div class="card-body">
                <form method="post" enctype="multipart/form-data">
                    <input type="hidden" name="team_member_id" value="{{ member.id }}">
                    <input type="hidden" name="action" value="manual_upload">
                    <div class="mb-3">
                        <label class="form-label">Signed employee contract PDF</label>
                        <input type="file" name="signed_contract" class="form-control" accept="application/pdf,image/*" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea name="notes" class="form-control" rows="3"></textarea>
                    </div>
                    <button class="btn btn-primary">Upload and Validate</button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-bold">Contract History</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Status</th>
                            <th>Source</th>
                            <th>Signed</th>
                            <th>PDF</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for contract in contracts %}
                            {% set pdf = contract.generated_pdf_path ?: contract.signed_file_path ?: contract.original_file_path %}
                            <tr>
                                <td>{{ contract.id }}</td>
                                <td><span class="badge bg-secondary">{{ contract.status }}</span></td>
                                <td>{{ contract.source ?: '-' }}</td>
                                <td>{{ contract.signed_at ?: '-' }}</td>
                                <td>{% if pdf %}<a href="{{ pdf }}" target="_blank" rel="noopener">Open</a>{% else %}-{% endif %}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="text-muted text-center">No contracts yet.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        {% if not template_storage_ready %}
            <div class="alert alert-warning">
                Employee contract template storage is not ready. Apply <code>db/team_member_contract_templates_required.sql</code> before creating or assigning employee templates.
            </div>
        {% endif %}

        <div class="card mb-3">
            <div class="card-header fw-bold">Create Employee Contract Template</div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" name="team_member_id" value="{{ member.id }}">
                    <input type="hidden" name="action" value="create_template">
                    <div class="mb-3">
                        <label class="form-label">Template title</label>
                        <input type="text" name="template_title" class="form-control" placeholder="Employee agreement, staff policy, contractor terms..." required {% if not template_storage_ready %}disabled{% endif %}>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Employee contract content</label>
                        <textarea name="template_content" id="employee-contract-editor" class="form-control" rows="10" placeholder="Write the employee/team member contract here..." required {% if not template_storage_ready %}disabled{% endif %}></textarea>
                        <div class="form-text">This content is only for employee/team member agreements.</div>
                    </div>
                    <button class="btn btn-primary" {% if not template_storage_ready %}disabled{% endif %}>Save Employee Template</button>
                </form>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header fw-bold">Assign Employee Contract for Signature</div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" name="team_member_id" value="{{ member.id }}">
                    <input type="hidden" name="action" value="assign">
                    <div class="mb-3">
                        <label class="form-label">Employee contract template</label>
                        <select name="contract_template_id" class="form-select" required {% if not template_storage_ready or templates|length == 0 %}disabled{% endif %}>
                            <option value="">Select employee template</option>
                            {% for template in templates %}
                                <option value="{{ template.id }}">{{ template.title }}</option>
                            {% endfor %}
                        </select>
                        {% if templates|length == 0 %}
                            <div class="form-text">Create an employee template above before assigning a digital contract.</div>
                        {% endif %}
                    </div>
                    <button class="btn btn-success" {% if not template_storage_ready or templates|length == 0 %}disabled{% endif %}>Assign for Team Signature</button>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-bold">Employee Contract Templates</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Updated</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for template in templates %}
                            <tr>
                                <td>{{ template.title }}</td>
                                <td>{{ template.updated_at }}</td>
                                <td class="text-end">
                                    <form method="post" class="d-inline" onsubmit="return confirm('Archive this employee contract template?');">
                                        <input type="hidden" name="team_member_id" value="{{ member.id }}">
                                        <input type="hidden" name="action" value="archive_template">
                                        <input type="hidden" name="template_id" value="{{ template.id }}">
                                        <button class="btn btn-sm btn-outline-danger">Archive</button>
                                    </form>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="3" class="text-muted text-center">No employee contract templates yet.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
