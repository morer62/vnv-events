{% extends "templates/base.admin.twig" %}
{% import 'templates/macros.twig' as macros %}

{% block head %}
<style>
.form-control[readonly] {
    background-color: #f8f9fa;
    border-color: #dee2e6;
    color: #6c757d;
}
</style>
{% endblock %}

{% block body %}
<h1 class="h3 mb-4">✏️ Edit User</h1>
{{ macros.breadcrumb2() }}

<section class="card">
    <section class="card-body">
        <form method="post">
            <input type="hidden" name="id" value="{{ user_edit.id }}">

            {% if user_edit.level == 5 and user_edit.password_updated == 1 %}
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">First Name</label>
                        <input type="text" name="name" value="{{ user_edit.name }}" class="form-control" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Last Name</label>
                        <input type="text" name="lastname" value="{{ user_edit.lastname }}" class="form-control" required>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" value="{{ user_edit.email }}" class="form-control" readonly>
                        <small class="text-muted">Email cannot be changed</small>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" name="phone" value="{{ user_edit.phone }}" class="form-control">
                    </div>
                </div>
            {% elseif user_edit.password_updated == 0 %}
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">First Name</label>
                        <input type="text" name="name" value="{{ user_edit.name }}" class="form-control" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Last Name</label>
                        <input type="text" name="lastname" value="{{ user_edit.lastname }}" class="form-control" required>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" value="{{ user_edit.email }}" class="form-control" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Phone</label>
                        <input type="text" name="phone" value="{{ user_edit.phone }}" class="form-control">
                    </div>
                </div>
            {% endif %}

            {% if user_edit.level == 4 %}
            <div class="mb-3">
                <label class="form-label">💵 Hourly Rate (optional)</label>
                <input type="number" step="0.01" name="hourly_rate" value="{{ institution_hourly_rate }}" class="form-control" placeholder="e.g. 15.00">
            </div>

            <div class="mb-3">
                <label class="form-label">Assign Role</label>
                <select name="role_id" class="form-select">
                    <option value="">-- Select a Role --</option>
                    {% for role in roles %}
                        <option value="{{ role.id }}" {% if selected_role_id == role.id %}selected{% endif %}>
                            {{ role.name }}
                        </option>
                    {% endfor %}
                </select>
                <a href="/vnv-venue/panel/planner-hub/management/roles" class="btn btn-outline-primary btn-sm mt-2">
                    ➕ View or Edit Roles
                </a>
            </div>

            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" role="switch" id="is-event-manager" name="is_event_manager" value="1" {% if is_event_manager %}checked{% endif %}>
                <label class="form-check-label fw-bold" for="is-event-manager">Event Manager</label>
                <div class="form-text">Event Managers receive the availability reminder and can be selected as an event's Main Manager.</div>
            </div>

            <div class="mb-3">
                <label class="form-label">🛒 Store Team Role</label>
                <select name="store_team_role" class="form-select">
                    <option value="general" {% if store_team_role == 'general' %}selected{% endif %}>General</option>
                    <option value="kitchen" {% if store_team_role == 'kitchen' %}selected{% endif %}>Kitchen</option>
                    <option value="delivery" {% if store_team_role == 'delivery' %}selected{% endif %}>Delivery</option>
                </select>
                <small class="text-muted">This defines the operational dashboard for this team member inside the store workflow.</small>
            </div>

            <div class="mb-3">
                <label class="form-label">📝 Contract Details (optional)</label>
                <textarea name="contract_detail" class="form-control" rows="4" placeholder="Enter contract details, schedule, notes, etc.">{{ contract_detail }}</textarea>
            </div>
            {% endif %}

            <button type="submit" class="btn btn-primary">Update User</button>
            {{ macros.back_btn(title="Cancel") }}
        </form>

        {% if is_primary_company and user_edit.level == 4 %}
            <hr class="my-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <h5 class="mb-1">Convert to Client</h5>
                    <p class="text-muted mb-0">Transform this team member into a client record.</p>
                </div>
                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#convertToClientModal">
                    Convert to Client
                </button>
            </div>
        {% elseif is_primary_company and user_edit.level == 5 %}
            <hr class="my-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <h5 class="mb-1">Convert to Team Member</h5>
                    <p class="text-muted mb-0">Assign a role, hourly rate, contract details, and store workflow role to convert this client.</p>
                </div>
                <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#convertToMemberModal">
                    Convert to Team Member
                </button>
            </div>
        {% endif %}
    </section>
</section>

{% if is_primary_company and user_edit.level == 4 %}
<div class="modal fade" id="convertToClientModal" tabindex="-1" aria-labelledby="convertToClientLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="convertToClientLabel">Convert Team Member to Client</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post">
                <input type="hidden" name="id" value="{{ user_edit.id }}">
                <input type="hidden" name="form_type" value="convert_to_client">
                <div class="modal-body">
                    <p class="text-muted">You can optionally add this new client to your CRM.</p>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" value="1" name="add_to_crm" id="convert-add-to-crm">
                        <label class="form-check-label" for="convert-add-to-crm">
                            Add to CRM as a lead
                        </label>
                    </div>

                    <div id="convert-crm-details" style="display:none;">
                        <div class="mb-3">
                            <label class="form-label">Address (optional)</label>
                            <input type="text" name="crm_address" class="form-control" placeholder="Enter client address">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Category</label>
                            <select name="crm_category_id" id="convert-crm-category" class="form-select">
                                <option value="">Select a category</option>
                                {% for category in crm_categories %}
                                    <option value="{{ category.id }}">{{ category.name }}</option>
                                {% endfor %}
                                <option value="new">➕ Create new category</option>
                            </select>
                            <div class="alert alert-warning mt-2" role="alert" {% if crm_categories is not empty %}style="display:none;" data-role="no-categories-alert"{% endif %}>
                                No categories available. Choose "Create new category" to add one.
                            </div>
                        </div>
                        <div class="mb-3" id="convert-new-category-wrapper" style="display:none;">
                            <label class="form-label">New Category Name</label>
                            <input type="text" name="new_category_name" class="form-control" placeholder="Enter category name">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Convert to Client</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}

{% if is_primary_company and user_edit.level == 5 %}
<div class="modal fade" id="convertToMemberModal" tabindex="-1" aria-labelledby="convertToMemberLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="convertToMemberLabel">Convert Client to Team Member</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post">
                <input type="hidden" name="id" value="{{ user_edit.id }}">
                <input type="hidden" name="form_type" value="convert_to_member">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Assign Role <span class="text-danger">*</span></label>
                        <select name="convert_role_id" class="form-select" required>
                            <option value="">Select a role</option>
                            {% for role in roles %}
                                <option value="{{ role.id }}">{{ role.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Hourly Rate (optional)</label>
                        <input type="number" name="convert_hourly_rate" step="0.01" class="form-control" placeholder="e.g. 18.50">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">🛒 Store Team Role</label>
                        <select name="convert_store_team_role" class="form-select">
                            <option value="general">General</option>
                            <option value="kitchen">Kitchen</option>
                            <option value="delivery">Delivery</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contract Details (optional)</label>
                        <textarea name="convert_contract_detail" rows="4" class="form-control" placeholder="Enter contract details, schedule, notes, etc."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Convert to Team Member</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const crmCheckbox = document.getElementById('convert-add-to-crm');
    const crmDetails = document.getElementById('convert-crm-details');
    const crmCategorySelect = document.getElementById('convert-crm-category');
    const newCategoryWrapper = document.getElementById('convert-new-category-wrapper');
    const noCategoriesAlert = document.querySelector('[data-role="no-categories-alert"]');

    if (crmCheckbox) {
        crmCheckbox.addEventListener('change', function () {
            crmDetails.style.display = crmCheckbox.checked ? 'block' : 'none';
            if (!crmCheckbox.checked) {
                if (crmCategorySelect) {
                    crmCategorySelect.value = '';
                }
                if (newCategoryWrapper) {
                    newCategoryWrapper.style.display = 'none';
                }
            }
        });
    }

    if (crmCategorySelect) {
        const hasCategories = crmCategorySelect.querySelectorAll('option[value]:not([value=""]):not([value="new"])').length > 0;
        if (noCategoriesAlert && hasCategories) {
            noCategoriesAlert.style.display = 'none';
        }

        crmCategorySelect.addEventListener('change', function () {
            if (!newCategoryWrapper) {
                return;
            }
            newCategoryWrapper.style.display = crmCategorySelect.value === 'new' ? 'block' : 'none';
        });
    }
});
</script>
{% endblock %}
