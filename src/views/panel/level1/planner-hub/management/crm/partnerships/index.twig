{% extends 'templates/base.admin.twig' %}
{% block body %}
<style>
.commercial-pipeline .stat-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}.commercial-pipeline .stat-card{padding:18px;border:1px solid #dfe7e8;border-radius:16px;background:#fff}.commercial-pipeline .stat-card strong{display:block;font-size:1.6rem}.commercial-pipeline .filter-grid{display:grid;grid-template-columns:1fr 1fr 2fr auto;gap:12px}.commercial-pipeline .mobile-opps{display:none}.commercial-pipeline .overdue{box-shadow:inset 4px 0 #dc3545}.commercial-pipeline .finance-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.commercial-pipeline .finance-card{border:1px solid #dfe7e8;border-radius:18px;background:#fff;padding:20px}.commercial-pipeline .finance-card label{font-size:.82rem;font-weight:700;color:#536568;margin-bottom:4px}.commercial-pipeline .finance-card .form-control,.commercial-pipeline .finance-card .form-select{margin-bottom:10px}@media(max-width:1100px){.commercial-pipeline .finance-grid{grid-template-columns:1fr}}@media(max-width:900px){.commercial-pipeline .stat-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.commercial-pipeline .filter-grid{grid-template-columns:1fr}.commercial-pipeline .desktop-table{display:none}.commercial-pipeline .mobile-opps{display:grid;gap:14px}.commercial-pipeline .opp-card{padding:18px;border:1px solid #dfe7e8;border-radius:16px;background:#fff}.commercial-pipeline .opp-card dl{display:grid;grid-template-columns:100px 1fr;gap:6px 10px;margin:14px 0}.commercial-pipeline .opp-card dt{color:#677;font-size:.8rem}.commercial-pipeline .opp-card dd{margin:0;overflow-wrap:anywhere}}
</style>
<main class="mt-4 commercial-pipeline">
  <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4"><div><small class="text-uppercase fw-bold text-primary">CRM · Commercial programs</small><h1 class="h2 mb-1">Partnership Pipelines</h1><p class="text-muted mb-0">Nonprofit, corporate, sponsorship, activation and original-experience opportunities inside the existing VNV CRM.</p></div><div class="d-flex gap-2"><a class="btn btn-outline-primary" target="_blank" href="{{ path('nonprofit-partnerships') }}">Nonprofit page</a><a class="btn btn-outline-primary" target="_blank" href="{{ path('sponsor-activation-production') }}">Activation page</a></div></div>
  {% if load_error %}<div class="alert alert-warning">{{ load_error }}</div>{% endif %}

  {% set pipelineTotals = {} %}
  {% for count in dashboard.counts %}{% set pipelineTotals = pipelineTotals|merge({(count.pipeline): (pipelineTotals[count.pipeline]|default(0) + count.total)}) %}{% endfor %}
  <div class="stat-grid mb-4">
    {% for pipeline,label in {'NONPROFIT_APPLICATION':'Nonprofit','CORPORATE':'Corporate','SPONSORSHIP':'Sponsorship','ACTIVATION':'Activation','ORIGINAL_WAITLIST':'Original waitlist'} %}<div class="stat-card"><span class="text-muted small">{{ label }}</span><strong>{{ pipelineTotals[pipeline]|default(0) }}</strong></div>{% endfor %}
  </div>

  <form class="card card-body mb-4" method="get"><div class="filter-grid">
    <select class="form-select" name="pipeline"><option value="">All pipelines</option>{% for pipeline,label in {'NONPROFIT_APPLICATION':'Nonprofit','CORPORATE':'Corporate','SPONSORSHIP':'Sponsorship','ACTIVATION':'Activation','ORIGINAL_WAITLIST':'Original waitlist'} %}<option value="{{ pipeline }}" {% if filters.pipeline==pipeline %}selected{% endif %}>{{ label }}</option>{% endfor %}</select>
    <select class="form-select" name="stage"><option value="">All stages</option>{% set allStages=[] %}{% for stages in dashboard.stages %}{% for stage in stages %}{% if stage not in allStages %}{% set allStages=allStages|merge([stage]) %}{% endif %}{% endfor %}{% endfor %}{% for stage in allStages %}<option value="{{ stage }}" {% if filters.stage==stage %}selected{% endif %}>{{ stage|replace({'_':' '})|title }}</option>{% endfor %}</select>
    <input class="form-control" name="q" value="{{ filters.q }}" placeholder="Search organization, contact or email">
    <button class="btn btn-primary">Filter</button>
  </div></form>

  <div class="card desktop-table"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Opportunity</th><th>Pipeline</th><th>Contact</th><th>Event</th><th>Follow-up</th><th>Stage</th></tr></thead><tbody>
    {% for item in dashboard.items %}<tr class="{% if item.next_follow_up_at and item.next_follow_up_at|date('U') <= 'now'|date('U') %}overdue{% endif %}"><td><strong>#{{ item.id }} · {{ item.title }}</strong><br><small class="text-muted">{{ item.organization_name|default('Individual request') }}</small></td><td><span class="badge bg-light text-dark border">{{ item.pipeline|replace({'_':' '}) }}</span></td><td>{{ item.contact_name }}<br><a href="mailto:{{ item.email }}">{{ item.email }}</a><br><small>{{ item.phone }}</small></td><td>{{ item.event_name|default('—') }}{% if item.event_date %}<br><small>{{ item.event_date|date('M j, Y') }}</small>{% endif %}</td><td>{{ item.next_follow_up_at ? item.next_follow_up_at|date('M j, Y g:i A') : '—' }}</td><td><form method="post" class="d-flex gap-2"><input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="action" value="stage"><input type="hidden" name="opportunity_id" value="{{ item.id }}"><select class="form-select form-select-sm" name="stage">{% for stage in dashboard.stages[item.pipeline]|default([]) %}<option value="{{ stage }}" {% if item.stage==stage %}selected{% endif %}>{{ stage|replace({'_':' '})|title }}</option>{% endfor %}</select><button class="btn btn-sm btn-primary">Save</button></form></td></tr>{% else %}<tr><td colspan="6" class="text-center text-muted py-5">No partnership opportunities match these filters.</td></tr>{% endfor %}
  </tbody></table></div></div>

  <div class="mobile-opps">{% for item in dashboard.items %}<article class="opp-card {% if item.next_follow_up_at and item.next_follow_up_at|date('U') <= 'now'|date('U') %}overdue{% endif %}"><div class="d-flex justify-content-between gap-2"><strong>#{{ item.id }} · {{ item.title }}</strong><span class="badge bg-light text-dark border">{{ item.pipeline|replace({'_':' '}) }}</span></div><dl><dt>Contact</dt><dd>{{ item.contact_name }}<br>{{ item.email }}</dd><dt>Event</dt><dd>{{ item.event_name|default('—') }}</dd><dt>Follow-up</dt><dd>{{ item.next_follow_up_at ? item.next_follow_up_at|date('M j, Y g:i A') : '—' }}</dd></dl><form method="post" class="d-flex gap-2"><input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="action" value="stage"><input type="hidden" name="opportunity_id" value="{{ item.id }}"><select class="form-select" name="stage">{% for stage in dashboard.stages[item.pipeline]|default([]) %}<option value="{{ stage }}" {% if item.stage==stage %}selected{% endif %}>{{ stage|replace({'_':' '})|title }}</option>{% endfor %}</select><button class="btn btn-primary">Save</button></form></article>{% else %}<div class="alert alert-light border">No partnership opportunities match these filters.</div>{% endfor %}</div>

  {% if can_manage_finance %}
  <section class="mt-5" aria-labelledby="commercial-finance-title">
    <div class="mb-3"><small class="text-uppercase fw-bold text-primary">Direction only</small><h2 id="commercial-finance-title" class="h3 mb-1">Approvals &amp; finance controls</h2><p class="text-muted">These controls complement VNV invoices. They never publish internal percentages or margins on the public website.</p></div>
    <div class="finance-grid">
      <form method="post" class="finance-card"><input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="action" value="assign_owner"><h3 class="h5">Assign an opportunity</h3><label>Opportunity</label><select class="form-select" name="opportunity_id" required><option value="">Select</option>{% for item in dashboard.items %}<option value="{{ item.id }}">#{{ item.id }} · {{ item.title }}{% if item.assigned_owner_name %} · {{ item.assigned_owner_name }}{% endif %}</option>{% endfor %}</select><label>Active team member</label><select class="form-select" name="assigned_user_id" required><option value="">Select</option>{% for member in team_members %}<option value="{{ member.id }}">{{ member.name|default(member.email) }} · Level {{ member.level }}</option>{% endfor %}</select><p class="small text-muted">Team users see only opportunities explicitly assigned to their user account. Direction retains the complete pipeline.</p><button class="btn btn-primary w-100">Assign owner</button></form>
      <form method="post" class="finance-card"><input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="action" value="support_grant"><h3 class="h5">Approve nonprofit support</h3><label>Nonprofit opportunity</label><select class="form-select" name="opportunity_id" required><option value="">Select</option>{% for item in dashboard.items %}{% if item.pipeline=='NONPROFIT_APPLICATION' %}<option value="{{ item.id }}">#{{ item.id }} · {{ item.title }}</option>{% endif %}{% endfor %}</select><label>Consultation hours</label><input class="form-control" type="number" min="0" max="1000" step="0.25" name="consultation_hours" value="0"><label>Food/staff support % (max 60)</label><input class="form-control" type="number" min="0" max="60" step="0.01" name="discount_food_staff_percent" value="0"><label>Decor support % (max 80)</label><input class="form-control" type="number" min="0" max="80" step="0.01" name="discount_decor_percent" value="0"><label>Approved scope</label><textarea class="form-control" name="approved_scope" rows="3" required></textarea><button class="btn btn-primary w-100">Approve &amp; audit</button></form>
      <form method="post" class="finance-card"><input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="action" value="commission"><h3 class="h5">Record eligible collected fee</h3><label>Opportunity</label><select class="form-select" name="opportunity_id" required><option value="">Select</option>{% for item in dashboard.items %}{% if item.pipeline in ['CORPORATE','SPONSORSHIP','ORIGINAL_WAITLIST'] %}<option value="{{ item.id }}">#{{ item.id }} · {{ item.title }}</option>{% endif %}{% endfor %}</select><label>Source type</label><select class="form-select" name="source_type" required><option value="CORPORATE_FEE">Corporate fee</option><option value="SPONSORSHIP_FEE">Sponsorship fee</option><option value="ORIGINAL_CONTRIBUTION">Original positive contribution</option></select><label>Collected-payment reference</label><input class="form-control" name="source_reference" maxlength="191" required><label>Collected amount</label><input class="form-control" type="number" min="0.01" step="0.01" name="collected_amount" required><p class="small text-muted">Corporate and sponsorship fees split 35/30/35. Originals first create a 15% eligible pool, then split 35/30/35. Duplicate references are blocked.</p><button class="btn btn-primary w-100">Record pending approval</button></form>
      <form method="post" class="finance-card"><input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="action" value="link_invoice"><h3 class="h5">Link an existing VNV invoice</h3><label>Opportunity</label><select class="form-select" name="opportunity_id" required><option value="">Select</option>{% for item in dashboard.items %}<option value="{{ item.id }}">#{{ item.id }} · {{ item.title }}</option>{% endfor %}</select><label>Invoice ID</label><input class="form-control" type="number" min="1" name="invoice_id" required><p class="small text-muted">Create or edit the invoice in the existing Invoices module, then link it here. The original order and invoice history remain unchanged.</p><button class="btn btn-primary w-100">Link invoice</button></form>
    </div>

    <div class="row g-3 mt-2">
      <div class="col-xl-6"><div class="card h-100"><div class="card-header fw-bold">Approved nonprofit support plans</div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Opportunity</th><th>Hours</th><th>Food/staff</th><th>Decor</th></tr></thead><tbody>{% for grant in finance.grants %}<tr><td>#{{ grant.opportunity_id }} · {{ grant.title }}</td><td>{{ grant.consultation_hours|default(0) }}</td><td>{{ grant.discount_food_staff_percent|default(0) }}%</td><td>{{ grant.discount_decor_percent|default(0) }}%</td></tr>{% else %}<tr><td colspan="4" class="text-muted">No approved plans yet.</td></tr>{% endfor %}</tbody></table></div></div></div>
      <div class="col-xl-6"><div class="card h-100"><div class="card-header fw-bold">Commission controls</div><div class="table-responsive"><table class="table table-sm mb-0"><thead><tr><th>Opportunity</th><th>Type</th><th>Eligible</th><th>Status</th></tr></thead><tbody>{% for commission in finance.commissions %}<tr><td>#{{ commission.opportunity_id }} · {{ commission.title }}</td><td>{{ commission.source_type|replace({'_':' '})|title }}</td><td>${{ commission.eligible_collected_amount|number_format(2) }}</td><td>{{ commission.status|replace({'_':' '})|title }}{% if commission.status=='PENDING_APPROVAL' %}<form method="post" class="mt-1"><input type="hidden" name="_token" value="{{ csrf }}"><input type="hidden" name="action" value="approve_commission"><input type="hidden" name="commission_id" value="{{ commission.id }}"><button class="btn btn-sm btn-success">Approve</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="4" class="text-muted">No commission records yet.</td></tr>{% endfor %}</tbody></table></div></div></div>
    </div>
  </section>
  {% endif %}
</main>
{% endblock %}
