{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}
{% block body %}

    <main>
        <h1 class="h3 mb-4">📦 My Containers</h1>

        {{ macros.breadcrumb2() }}

        <section class="card">
            <div class="card-body">

                <a class="btn btn-primary mb-3" href="{{ path('panel/planner-hub/management/storage/containers/create') }}">
                    <i class="align-middle" data-feather="plus"></i>Add a new container
                </a>

                <div class="table-responsive">
                    <table class="table table-bordered text-center align-middle" style="min-width: 500px;">
                        <thead>
                            <tr>
                                <th>Container</th>
                                <th>Actions</th>
                                <th>QR Tag</th>

                            </tr>
                        </thead>
                        <tbody>
                            {% for container in containers %}
                                <tr>
                                    <td>{{ container.name }}</td>
                                    <td class="d-flex justify-content-center gap-2">
                                        <a href="{{ path(current_location ~ '/items', { container_id: container.id}) }}" class="btn btn-primary">
                                           <i class="align-middle" data-feather="list"></i> View Items
                                        </a>

                                        <a href="{{ path(current_location ~ '/edit', { id: container.id }) }}" class="btn btn-warning">
                                            <i class="align-middle" data-feather="edit-2"></i> Edit
                                        </a>

                                        {{ macros.delete_form(container.id) }}
                                    </td>
                                    <td>
                                         

                                        <button class="btn btn-outline-secondary" onclick="showPrintTagModal('{{ container.name }}', '{{ path('panel/planner-hub/team/storage/containers/items', { container_id: container.id }) }}', {{ container.id }})">
                                            🖨️ Print Tag
                                        </button>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="2" class="text-muted">No containers were found.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>



<div id="tagModal" class="modal fade" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Print Container Tag</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body tag-editor-layout">
        <aside class="tag-editor-controls" aria-label="Container tag design controls">
          <h6 class="tag-editor-heading">Customize label</h6>

          <label class="tag-control-label" for="tagTitleSize"><span>Title size</span><output id="tagTitleSizeValue" for="tagTitleSize">32 px</output></label>
          <input type="range" id="tagTitleSize" class="form-range" min="18" max="64" step="1" value="32">

          <label class="tag-control-label" for="tagQrSize"><span>QR size</span><output id="tagQrSizeValue" for="tagQrSize">160 px</output></label>
          <input type="range" id="tagQrSize" class="form-range" min="90" max="320" step="5" value="160">

          <label class="tag-control-label" for="tagTableWidth"><span>Items table width</span><output id="tagTableWidthValue" for="tagTableWidth">85%</output></label>
          <input type="range" id="tagTableWidth" class="form-range" min="45" max="100" step="5" value="85">

          <label class="tag-control-label" for="tagItemsSize"><span>Items text size</span><output id="tagItemsSizeValue" for="tagItemsSize">16 px</output></label>
          <input type="range" id="tagItemsSize" class="form-range" min="10" max="28" step="1" value="16">

          <fieldset class="tag-alignment-fieldset">
            <legend>Content alignment</legend>
            <div class="tag-alignment-buttons" role="group" aria-label="Content alignment">
              <button type="button" class="tag-alignment-button" data-tag-align="left" aria-pressed="false">Left</button>
              <button type="button" class="tag-alignment-button is-active" data-tag-align="center" aria-pressed="true">Center</button>
              <button type="button" class="tag-alignment-button" data-tag-align="right" aria-pressed="false">Right</button>
            </div>
          </fieldset>

          <div class="form-check tag-items-toggle">
            <input type="checkbox" id="showItemsCheckbox" class="form-check-input">
            <label for="showItemsCheckbox" class="form-check-label">Include items list</label>
          </div>

          <p class="tag-editor-note">The web address is stored only inside the QR code and is not printed as text.</p>
        </aside>

        <div class="tag-preview-stage">
          <div class="tag-preview-label">Print preview</div>
          <section id="tagContentToPrint" class="tag-label-preview" data-align="center" aria-label="Container tag preview">
            <h2 id="containerTitle" class="tag-container-title"></h2>
            <div class="tag-qr-holder"><div id="qrcode"></div></div>
            <div id="itemsList" class="tag-items-list" hidden>
              <h3 class="tag-items-title">Items in this container</h3>
              <div id="itemsContent" class="tag-items-content"></div>
            </div>
          </section>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button class="btn btn-primary" onclick="printTag()">Print label</button>
      </div>
    </div>
  </div>
</div>

<style>
    .tag-editor-layout {
        display: grid;
        grid-template-columns: minmax(250px, 320px) minmax(0, 1fr);
        gap: 24px;
        align-items: stretch;
        background: #f4f7f8;
    }

    .tag-editor-controls,
    .tag-preview-stage {
        border: 1px solid #dce4e7;
        border-radius: 16px;
        background: #fff;
    }

    .tag-editor-controls { padding: 20px; }
    .tag-editor-heading { margin: 0 0 18px; font-size: 1rem; font-weight: 700; color: #143f38; }
    .tag-control-label { display: flex; justify-content: space-between; gap: 12px; margin-top: 16px; font-size: .9rem; font-weight: 600; }
    .tag-control-label output { color: #0b7667; font-variant-numeric: tabular-nums; }
    .tag-alignment-fieldset { margin: 20px 0 0; padding: 0; border: 0; }
    .tag-alignment-fieldset legend { margin-bottom: 8px; font-size: .9rem; font-weight: 600; }
    .tag-alignment-buttons { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
    .tag-alignment-button { padding: 8px 6px; border: 1px solid #b8c8c5; border-radius: 9px; background: #fff; color: #23453f; font-size: .85rem; font-weight: 600; }
    .tag-alignment-button:hover,
    .tag-alignment-button.is-active { border-color: #087d6d; background: #087d6d; color: #fff; }
    .tag-items-toggle { margin-top: 22px; }
    .tag-editor-note { margin: 18px 0 0; padding: 11px 12px; border-radius: 10px; background: #edf7f5; color: #48645f; font-size: .8rem; line-height: 1.4; }
    .tag-preview-stage { min-width: 0; padding: 18px; overflow: auto; }
    .tag-preview-label { margin-bottom: 12px; color: #60716e; font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }

    .tag-label-preview {
        --tag-title-size: 32px;
        --tag-qr-size: 160px;
        --tag-table-width: 85%;
        --tag-items-size: 16px;
        box-sizing: border-box;
        width: 100%;
        min-height: 380px;
        padding: 30px;
        border: 1px dashed #9eaeab;
        border-radius: 12px;
        background: #fff;
        color: #000;
        text-align: center;
    }

    .tag-container-title { margin: 0 0 22px; color: #000; font-family: Arial, sans-serif; font-size: var(--tag-title-size); font-weight: 700; line-height: 1.12; overflow-wrap: anywhere; }
    .tag-qr-holder { display: flex; justify-content: center; width: 100%; }
    #qrcode,
    #qrcode canvas,
    #qrcode img,
    .tag-print-qr { width: var(--tag-qr-size) !important; height: var(--tag-qr-size) !important; }
    #qrcode canvas,
    #qrcode img,
    .tag-print-qr { display: block; max-width: none; image-rendering: pixelated; }
    .tag-items-list { width: var(--tag-table-width); margin-top: 28px; }
    .tag-items-list[hidden] { display: none !important; }
    .tag-items-title { margin: 0 0 10px; font-family: Arial, sans-serif; font-size: calc(var(--tag-items-size) * 1.15); font-weight: 700; }
    .tag-items-content { font-family: Arial, sans-serif; font-size: var(--tag-items-size); }

    .modal-items-table {
        width: 100%;
        border-collapse: collapse;
        color: #000;
    }
    
    .modal-items-table th,
    .modal-items-table td {
        border: 1px solid #333;
        padding: .5em .65em;
        text-align: inherit;
    }
    
    .modal-items-table th {
        background-color: #f5f5f5;
        font-weight: bold;
    }

    .tag-label-preview[data-align="left"] { text-align: left; }
    .tag-label-preview[data-align="left"] .tag-qr-holder { justify-content: flex-start; }
    .tag-label-preview[data-align="left"] .tag-items-list { margin-right: auto; margin-left: 0; }
    .tag-label-preview[data-align="center"] { text-align: center; }
    .tag-label-preview[data-align="center"] .tag-qr-holder { justify-content: center; }
    .tag-label-preview[data-align="center"] .tag-items-list { margin-right: auto; margin-left: auto; }
    .tag-label-preview[data-align="right"] { text-align: right; }
    .tag-label-preview[data-align="right"] .tag-qr-holder { justify-content: flex-end; }
    .tag-label-preview[data-align="right"] .tag-items-list { margin-right: 0; margin-left: auto; }

    @media (max-width: 767.98px) {
        .tag-editor-layout { grid-template-columns: 1fr; }
        .tag-label-preview { min-height: 320px; padding: 22px; }
    }
</style>

{% endblock %}



{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>

<script>
  const tagEditorState = {
    alignment: 'center'
  };

  const tagRangeControls = [
    { input: 'tagTitleSize', output: 'tagTitleSizeValue', property: '--tag-title-size', suffix: ' px', cssSuffix: 'px' },
    { input: 'tagQrSize', output: 'tagQrSizeValue', property: '--tag-qr-size', suffix: ' px', cssSuffix: 'px' },
    { input: 'tagTableWidth', output: 'tagTableWidthValue', property: '--tag-table-width', suffix: '%', cssSuffix: '%' },
    { input: 'tagItemsSize', output: 'tagItemsSizeValue', property: '--tag-items-size', suffix: ' px', cssSuffix: 'px' }
  ];

  function applyTagEditorSettings() {
    const preview = document.getElementById('tagContentToPrint');

    tagRangeControls.forEach(control => {
      const input = document.getElementById(control.input);
      document.getElementById(control.output).value = `${input.value}${control.suffix}`;
      preview.style.setProperty(control.property, `${input.value}${control.cssSuffix}`);
    });

    preview.dataset.align = tagEditorState.alignment;
  }

  function initializeTagEditorControls() {
    tagRangeControls.forEach(control => {
      document.getElementById(control.input).addEventListener('input', applyTagEditorSettings);
    });

    document.querySelectorAll('[data-tag-align]').forEach(button => {
      button.addEventListener('click', () => {
        tagEditorState.alignment = button.dataset.tagAlign;
        document.querySelectorAll('[data-tag-align]').forEach(candidate => {
          const active = candidate === button;
          candidate.classList.toggle('is-active', active);
          candidate.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        applyTagEditorSettings();
      });
    });

    document.getElementById('showItemsCheckbox').addEventListener('change', event => {
      document.getElementById('itemsList').hidden = !event.target.checked;
    });

    applyTagEditorSettings();
  }

  function showPrintTagModal(name, url, containerId) {
    document.getElementById('containerTitle').innerText = name;
    document.getElementById('qrcode').innerHTML = '';

    new QRCode(document.getElementById("qrcode"), {
      text: url,
      width: 320,
      height: 320,
      correctLevel: QRCode.CorrectLevel.H
    });

    loadContainerItems(containerId);
    const checkbox = document.getElementById('showItemsCheckbox');
    checkbox.checked = false;
    document.getElementById('itemsList').hidden = true;
    applyTagEditorSettings();

    new bootstrap.Modal(document.getElementById('tagModal')).show();
  }

  
  async function loadContainerItems(containerId) {
    try {
      document.getElementById('itemsContent').innerHTML = '<p class="text-muted">Loading items...</p>';
      const response = await fetch(`{{ path('panel/planner-hub/management/storage/containers/items') }}?container_id=${containerId}`);
      if (!response.ok) {
        throw new Error(`Items request failed with HTTP ${response.status}`);
      }
      const html = await response.text();
      
      
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      const rows = doc.querySelectorAll('tbody tr');
      
      let itemsHtml = `
        <table class="modal-items-table">
          <thead>
            <tr>
              <th>Item Name</th>
              <th>Quantity</th>
            </tr>
          </thead>
          <tbody>
      `;
      
      let hasItems = false;
      rows.forEach(row => {
        const cells = row.querySelectorAll('td');
        if (cells.length >= 3 && !cells[0].textContent.includes('No items')) {
          const name = cells[0].textContent.trim();
          const quantity = cells[1].textContent.trim();
          itemsHtml += `
            <tr>
              <td>${escapeTagHtml(name)}</td>
              <td>${escapeTagHtml(quantity)}</td>
            </tr>
          `;
          hasItems = true;
        }
      });
      
      itemsHtml += `
          </tbody>
        </table>
      `;
      
      if (!hasItems) {
        itemsHtml = '<p class="text-muted">No items in this container</p>';
      }
      
      document.getElementById('itemsContent').innerHTML = itemsHtml;
    } catch (error) {
      console.error('Error loading items:', error);
      document.getElementById('itemsContent').innerHTML = '<p class="text-muted">Error loading items</p>';
    }
  }

  function escapeTagHtml(value) {
    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

function printTag() {
  const sourcePreview = document.getElementById('tagContentToPrint');
  const qrCanvas = sourcePreview.querySelector('#qrcode canvas');
  const previewClone = sourcePreview.cloneNode(true);
  const clonedQr = previewClone.querySelector('#qrcode');

  if (!qrCanvas || !clonedQr) {
    window.alert('The QR code is still loading. Please try again.');
    return;
  }

  clonedQr.innerHTML = '';
  const qrImage = document.createElement('img');
  qrImage.className = 'tag-print-qr';
  qrImage.alt = 'Container QR code';
  qrImage.src = qrCanvas.toDataURL('image/png');
  clonedQr.appendChild(qrImage);

  const printWindow = window.open('', '_blank', 'width=900,height=700');
  if (!printWindow) {
    window.alert('The browser blocked the print window. Allow pop-ups and try again.');
    return;
  }

  const title = escapeTagHtml(document.getElementById('containerTitle').innerText);
  const printStyles = `
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; background: #fff; }
    body { padding: 10mm; font-family: Arial, sans-serif; }
    .tag-label-preview { width: 100%; min-height: 0; padding: 0; border: 0; border-radius: 0; background: #fff; color: #000; }
    .tag-container-title { margin: 0 0 22px; color: #000; font-size: var(--tag-title-size); font-weight: 700; line-height: 1.12; overflow-wrap: anywhere; }
    .tag-qr-holder { display: flex; width: 100%; }
    #qrcode, .tag-print-qr { width: var(--tag-qr-size) !important; height: var(--tag-qr-size) !important; }
    .tag-print-qr { display: block; max-width: none; image-rendering: pixelated; }
    .tag-items-list { width: var(--tag-table-width); margin-top: 28px; break-inside: avoid; }
    .tag-items-list[hidden] { display: none !important; }
    .tag-items-title { margin: 0 0 10px; font-size: calc(var(--tag-items-size) * 1.15); font-weight: 700; }
    .tag-items-content { font-size: var(--tag-items-size); }
    .modal-items-table { width: 100%; border-collapse: collapse; color: #000; }
    .modal-items-table th, .modal-items-table td { border: 1px solid #333; padding: .5em .65em; text-align: inherit; }
    .modal-items-table th { background: #f5f5f5; font-weight: 700; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    .tag-label-preview[data-align="left"] { text-align: left; }
    .tag-label-preview[data-align="left"] .tag-qr-holder { justify-content: flex-start; }
    .tag-label-preview[data-align="left"] .tag-items-list { margin-right: auto; margin-left: 0; }
    .tag-label-preview[data-align="center"] { text-align: center; }
    .tag-label-preview[data-align="center"] .tag-qr-holder { justify-content: center; }
    .tag-label-preview[data-align="center"] .tag-items-list { margin-right: auto; margin-left: auto; }
    .tag-label-preview[data-align="right"] { text-align: right; }
    .tag-label-preview[data-align="right"] .tag-qr-holder { justify-content: flex-end; }
    .tag-label-preview[data-align="right"] .tag-items-list { margin-right: 0; margin-left: auto; }
    @page { margin: 10mm; }
  `;

  printWindow.addEventListener('afterprint', () => printWindow.close(), { once: true });
  const triggerPrint = () => {
    window.setTimeout(() => {
      printWindow.focus();
      printWindow.print();
    }, 150);
  };

  printWindow.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>Container label - ${title}</title><style>${printStyles}</style></head><body>${previewClone.outerHTML}</body></html>`);
  printWindow.document.close();

  if (printWindow.document.readyState === 'complete') {
    triggerPrint();
  } else {
    printWindow.addEventListener('load', triggerPrint, { once: true });
  }
}

initializeTagEditorControls();

</script>
{% endblock %}
