{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}
{% block body %}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3"><div><h2 class="mb-1">Invoices</h2><p class="text-muted mb-0">Independent billing records generated from verified orders and payments.</p></div><form method="post" class="d-flex gap-2"><input class="form-control" type="number" min="1" name="order_id" placeholder="Order ID" required><button class="btn btn-primary text-nowrap">Create from order</button></form></div>
{{ macros.breadcrumb2() }}
<div class="alert alert-light border"><strong>No charges happen here.</strong> Invoice totals and payment history are read from the existing order, Square/Stripe transactions, and manual advances.</div>
<form class="card card-body mb-3" method="get"><div class="row g-2"><div class="col-md-3"><label class="form-label">Client</label><input class="form-control" name="client" value="{{ filters.client }}"></div><div class="col-md-2"><label class="form-label">Invoice number</label><input class="form-control" name="number" value="{{ filters.number }}" placeholder="INV-1205"></div><div class="col-md-2"><label class="form-label">Order</label><input class="form-control" name="order" value="{{ filters.order }}"></div><div class="col-md-2"><label class="form-label">Status</label><select class="form-select" name="status"><option value="">All</option>{% for s in ['DRAFT','UNPAID','PARTIALLY_PAID','PAID','REFUNDED','VOIDED'] %}<option value="{{ s }}" {% if filters.status==s %}selected{% endif %}>{{ s|replace({'_':' '})|title }}</option>{% endfor %}</select></div><div class="col-md-1"><label class="form-label">From</label><input class="form-control" type="date" name="from" value="{{ filters.from }}"></div><div class="col-md-1"><label class="form-label">To</label><input class="form-control" type="date" name="to" value="{{ filters.to }}"></div><div class="col-md-1 d-flex align-items-end"><button class="btn btn-outline-primary w-100">Filter</button></div></div></form>
<div class="card"><div class="card-body"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Invoice</th><th>Client</th><th>Order</th><th>Event</th><th>Status</th><th>Created</th><th></th></tr></thead><tbody>{% for invoice in invoices %}<tr><td><strong>{{ invoice.invoice_number }}</strong></td><td>{{ invoice.billing_name }}<br><small class="text-muted">{{ invoice.billing_email }}</small></td><td><a href="{{ path('panel/planner-hub/management/orders/orders/edit') }}?id={{ invoice.id_order }}">#{{ invoice.id_order }}</a></td><td>{{ invoice.event_date|date('M j, Y') }}<br><small class="text-muted">{{ invoice.address }}</small></td><td><span class="badge {% if invoice.status=='PAID' %}bg-success{% elseif invoice.status=='PARTIALLY_PAID' %}bg-warning text-dark{% elseif invoice.status in ['REFUNDED','VOIDED'] %}bg-secondary{% else %}bg-light text-dark border{% endif %}">{{ invoice.status|replace({'_':' '}) }}</span></td><td>{{ invoice.created_at|date('M j, Y g:i A') }}</td><td><a class="btn btn-sm btn-primary" href="{{ path('panel/planner-hub/management/invoices/view') }}?id={{ invoice.id }}">Open</a></td></tr>{% else %}<tr><td colspan="7" class="text-center py-5 text-muted">No invoices match these filters. Fully paid orders are added automatically; any order can also be added manually.</td></tr>{% endfor %}</tbody></table></div></div></div>
{% endblock %}
