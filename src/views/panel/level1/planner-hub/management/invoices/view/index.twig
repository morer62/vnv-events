{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
{% set invoice = data.invoice %}
{% set totals = data.totals %}
{% set order = data.order %}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <a href="{{ path('panel/planner-hub/management/invoices') }}" class="text-decoration-none">← Invoices</a>
        <h2 class="mb-1">{{ invoice.invoice_number }}</h2>
        <span class="badge {% if invoice.status == 'PAID' %}bg-success{% elseif invoice.status == 'PARTIALLY_PAID' %}bg-warning text-dark{% else %}bg-secondary{% endif %}">{{ invoice.status|replace({'_':' '}) }}</span>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a target="_blank" class="btn btn-primary" href="{{ path('panel/planner-hub/management/invoices/pdf') }}?id={{ invoice.id }}">Preview invoice</a>
        <a class="btn btn-outline-primary" href="{{ path('panel/planner-hub/management/invoices/pdf') }}?id={{ invoice.id }}&download=1">Download PDF</a>
        <a class="btn btn-outline-secondary" href="{{ path('panel/planner-hub/management/orders/orders/edit') }}?id={{ order.id }}">Order #{{ order.id }}</a>
    </div>
</div>

{{ macros.breadcrumb2() }}
<div class="alert alert-info">Invoice fields below are a billing snapshot. Editing them does not modify the order, its customer record, service prices, or any payment.</div>

<div class="row g-3">
    <div class="col-xl-8">
        <form method="post" class="card">
            <input type="hidden" name="action" value="save">
            <div class="card-body">
                <h5>Billing and contact snapshot</h5>
                <div class="row g-2">
                    <div class="col-md-6"><label class="form-label">Billing name</label><input class="form-control" name="billing_name" value="{{ invoice.billing_name }}"></div>
                    <div class="col-md-6"><label class="form-label">Email</label><input class="form-control" type="email" name="billing_email" value="{{ invoice.billing_email }}"></div>
                    <div class="col-md-4"><label class="form-label">Phone</label><input class="form-control" name="billing_phone" value="{{ invoice.billing_phone }}"></div>
                    <div class="col-md-8"><label class="form-label">Billing address</label><input class="form-control" name="billing_address" value="{{ invoice.billing_address }}"></div>
                    <div class="col-12"><label class="form-label">Internal / PO reference</label><input class="form-control" name="internal_reference" value="{{ invoice.internal_reference }}"></div>
                </div>
                <hr>
                <h5>Service descriptions</h5>
                {% for line in data.lines %}
                    <div class="mb-3">
                        <label class="form-label"><strong>{{ line.name }}</strong> · {{ line.quantity }} × ${{ line.unit_price_effective|number_format(2) }}</label>
                        <textarea class="form-control" name="line_description[{{ line.id }}]" rows="2">{{ line.invoice_description }}</textarea>
                    </div>
                {% endfor %}
                <label class="form-label">Invoice notes</label>
                <textarea class="form-control" name="invoice_notes" rows="3">{{ invoice.invoice_notes }}</textarea>
                <button class="btn btn-primary mt-3">Save invoice details</button>
            </div>
        </form>
    </div>

    <div class="col-xl-4">
        <div class="card mb-3">
            <div class="card-body">
                <h5>Financial summary</h5>
                <div class="d-flex justify-content-between"><span>Subtotal</span><strong>${{ totals.subtotal|number_format(2) }}</strong></div>
                <div class="d-flex justify-content-between"><span>Discount</span><strong>-${{ totals.discount|number_format(2) }}</strong></div>
                <div class="d-flex justify-content-between"><span>Sales Tax</span><strong>${{ totals.tax|number_format(2) }}</strong></div>
                <hr>
                <div class="d-flex justify-content-between fs-5"><span>Total</span><strong>${{ totals.total|number_format(2) }}</strong></div>
                <div class="d-flex justify-content-between text-success"><span>Net paid</span><strong>${{ totals.net_paid|number_format(2) }}</strong></div>
                <div class="d-flex justify-content-between"><span>Balance</span><strong>${{ totals.balance|number_format(2) }}</strong></div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h5>Invoice PDF</h5>
                <p class="small text-muted">Preview the invoice first. Previewing does not send an email or download a file.</p>
                <div class="d-grid gap-2 mb-3">
                    <a target="_blank" class="btn btn-primary" href="{{ path('panel/planner-hub/management/invoices/pdf') }}?id={{ invoice.id }}">Preview invoice</a>
                    <a class="btn btn-outline-primary" href="{{ path('panel/planner-hub/management/invoices/pdf') }}?id={{ invoice.id }}&download=1">Download PDF</a>
                </div>
                <hr>
                <form method="post">
                    <input type="hidden" name="action" value="email">
                    <label class="form-label">Send by email</label>
                    <input class="form-control mb-2" type="email" name="email_to" value="{{ invoice.billing_email }}" required>
                    <button class="btn btn-outline-secondary w-100">Send PDF by email</button>
                </form>
            </div>
        </div>

        {% if invoice.status != 'VOIDED' %}
            <form method="post" class="card border-danger">
                <input type="hidden" name="action" value="void">
                <div class="card-body">
                    <h5>Void invoice</h5>
                    <p class="small text-muted">Does not void the order or refund payments.</p>
                    <input class="form-control mb-2" name="void_reason" placeholder="Required reason" required>
                    <button class="btn btn-outline-danger w-100" onclick="return confirm('Void this invoice record?')">Void invoice</button>
                </div>
            </form>
        {% endif %}
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h5>Read-only payment history</h5>
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>Date</th><th>Method</th><th>Reference</th><th>Card</th><th>Paid</th><th>Refunded</th></tr></thead>
                <tbody>
                {% for payment in data.payments %}
                    <tr>
                        <td>{{ payment.paid_at|date('M j, Y g:i A') }}</td>
                        <td>{{ payment.method|title }}</td>
                        <td><code>{{ payment.reference_id ?: 'Manual' }}</code></td>
                        <td>{{ payment.card_brand }}{% if payment.card_last4 %} •••• {{ payment.card_last4 }}{% endif %}</td>
                        <td>${{ payment.amount|number_format(2) }}</td>
                        <td>{% if payment.refunded_amount > 0 %}-${{ payment.refunded_amount|number_format(2) }}{% else %}—{% endif %}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-muted">No payments recorded.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body">
        <h5>Immutable PDF versions</h5>
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>Version</th><th>Generated</th><th>Generated by</th><th>Sent</th></tr></thead>
                <tbody>
                {% for version in versions %}
                    <tr>
                        <td>v{{ version.version_number }}</td>
                        <td>{{ version.generated_at|date('M j, Y g:i A') }}</td>
                        <td>User #{{ version.generated_by }}</td>
                        <td>{% if version.sent_at %}{{ version.sent_at|date('M j, Y g:i A') }} to {{ version.sent_to }}{% else %}Not sent{% endif %}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="text-muted">No finalized PDF version yet.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
