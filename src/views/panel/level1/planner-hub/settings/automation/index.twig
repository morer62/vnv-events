{% extends 'templates/base.admin.twig' %}
{% block body %}
<style>
.mochi-app{--ink:#102520;--muted:#678078;--line:#dfe9e6;--soft:#f5f9f8;--brand:#0d7767;position:relative;max-width:1040px;margin:0 auto;color:var(--ink)}
.mochi-topbar{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;padding:10px 4px 14px;border-bottom:1px solid var(--line)}
.mochi-menu,.mochi-date-button{width:44px;height:44px;border:1px solid var(--line);border-radius:50%;background:#fff;color:var(--ink);display:grid;place-items:center}
.mochi-title{text-align:center;min-width:0}.mochi-title strong{display:block;font-size:1.05rem}.mochi-title small{display:block;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mochi-date-form{position:relative}.mochi-date-form input{position:absolute;inset:0;width:44px;height:44px;opacity:0;cursor:pointer}
.mochi-chat-shell{min-height:calc(100vh - 205px);display:grid;grid-template-rows:1fr auto;background:#fff}
.mochi-chat{height:calc(100vh - 330px);min-height:420px;overflow-y:auto;padding:22px max(12px,5vw);scrollbar-gutter:stable}
.mochi-empty{height:100%;display:grid;place-items:center;text-align:center;color:var(--muted)}.mochi-empty i{display:block;font-size:2rem;margin-bottom:12px;color:#9ab0aa}
.mochi-message{max-width:760px;padding:12px 15px;border-radius:18px;margin:0 auto 12px;white-space:pre-wrap;line-height:1.52}.mochi-message.agent{background:var(--soft);border:1px solid var(--line)}.mochi-message.human{background:#173631;color:#fff;margin-right:max(0px,calc((100% - 760px)/2));width:max-content;max-width:min(82%,760px)}.mochi-message.thinking{color:var(--muted);font-style:italic}.mochi-author{display:block;font-size:.74rem;font-weight:850;letter-spacing:.04em;text-transform:uppercase;margin-bottom:4px}.mochi-message.human .mochi-author{color:#aee7db}
.mochi-task-strip{max-width:760px;margin:0 auto 14px;padding:9px 12px;border:1px solid #bfe2d7;background:#edf9f5;border-radius:14px;color:#174c42;font-size:.86rem;font-weight:800}
.mochi-items{display:flex;overflow-x:auto;gap:10px;margin-top:10px;padding:2px 1px 8px;scroll-snap-type:x mandatory}.mochi-item{flex:0 0 min(100%,520px);scroll-snap-align:start;display:block;text-decoration:none;color:var(--ink);border:1px solid #d5e7e1;background:#fff;border-radius:14px;padding:12px}.mochi-item:hover{border-color:#45cdb5;color:var(--ink)}.mochi-item small{display:block;color:var(--muted)}
.mochi-list-controls{display:flex;align-items:center;justify-content:flex-end;gap:7px;margin-top:6px;color:var(--muted);font-size:.78rem}.mochi-list-controls button{border:1px solid var(--line);background:#fff;border-radius:999px;width:30px;height:30px}
.mochi-chips{display:flex;gap:7px;overflow-x:auto;margin-top:10px;padding-bottom:2px}.mochi-chip{flex:0 0 auto;border:1px solid #bcded3;background:#fff;color:#174c42;border-radius:999px;padding:7px 11px;font-weight:800;font-size:.8rem}.mochi-chip.primary{background:var(--brand);border-color:var(--brand);color:#fff}
.mochi-composer-wrap{position:sticky;bottom:0;background:linear-gradient(transparent,#fff 16%);padding:22px 10px 10px;z-index:5}.mochi-composer{max-width:800px;margin:auto;background:#f5f7f7;border:1px solid var(--line);border-radius:24px;padding:9px;box-shadow:0 10px 32px rgba(14,46,39,.12)}.mochi-compose-row{display:flex;gap:8px;align-items:flex-end}.mochi-composer textarea{border:0;background:transparent;box-shadow:none!important;min-height:48px;max-height:145px;resize:none;padding:12px 6px}.mochi-icon-button{width:44px;height:44px;flex:0 0 44px;border-radius:50%;border:0;background:#e5eeeb;color:var(--ink)}.mochi-send{background:var(--brand);color:#fff}.mochi-help{display:block;padding:3px 52px 0;color:var(--muted);font-size:.72rem}
.mochi-attachment{display:none;align-items:center;gap:9px;margin:6px 4px 2px;padding:8px;border-radius:13px;background:#ebf5f2}.mochi-attachment.visible{display:flex}.mochi-attachment-previews{display:flex;gap:5px;overflow-x:auto}.mochi-attachment img{width:44px;height:44px;object-fit:cover;border-radius:9px}.mochi-attachment span{flex:1;color:#45625a;font-size:.78rem}
.mochi-drawer-backdrop{position:fixed;inset:0;background:rgba(9,26,22,.34);z-index:1045;opacity:0;pointer-events:none;transition:.2s}.mochi-drawer{position:fixed;left:0;top:0;bottom:0;width:min(88vw,340px);z-index:1050;background:#fff;padding:18px;transform:translateX(-103%);transition:.22s;box-shadow:18px 0 45px rgba(4,25,20,.2);overflow-y:auto}.mochi-drawer.open{transform:none}.mochi-drawer-backdrop.open{opacity:1;pointer-events:auto}.mochi-drawer-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}.mochi-history{display:grid;gap:7px}.history-link{display:block;padding:11px 12px;border-radius:13px;text-decoration:none;color:var(--ink)}.history-link:hover,.history-link.active{background:#edf7f4}.history-link small{display:block;color:var(--muted)}
@media(max-width:767px){
 html.mochi-chat-page,body.mochi-chat-page{height:var(--mochi-visible-height,100dvh);min-height:0;overflow:hidden;overscroll-behavior:none}
 body.mochi-chat-page .wrapper{height:100%;min-height:0;overflow:hidden}
 body.mochi-chat-page .main{height:100%;min-height:0;overflow:hidden}
 body.mochi-chat-page .main>.navbar{flex:0 0 auto}
 body.mochi-chat-page .content{flex:1 1 auto;min-height:0;width:100%;max-width:100%;overflow:hidden;padding:0}
 body.mochi-chat-page #content{height:100%;min-height:0;overflow:hidden}
 body.mochi-chat-page footer.footer{display:none}
 .mochi-app{height:100%;min-height:0;max-width:none;margin:0;display:flex;flex-direction:column;overflow:hidden;background:#fff}
 .mochi-topbar{position:relative;z-index:10;flex:0 0 auto;min-height:64px;padding:8px 12px;background:rgba(255,255,255,.96);box-shadow:0 1px 12px rgba(14,46,39,.07);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
 .mochi-chat-shell{flex:1 1 auto;min-height:0;height:auto;display:flex;flex-direction:column;overflow:hidden}
 .mochi-chat{flex:1 1 auto;height:auto;min-height:0;overflow-y:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;padding:14px 10px 12px;scrollbar-gutter:auto;scroll-padding-bottom:16px}
 .mochi-message{border-radius:16px}
 .mochi-composer-wrap{position:relative;bottom:auto;flex:0 0 auto;padding:8px 7px max(7px,env(safe-area-inset-bottom));border-top:1px solid var(--line);background:#fff;z-index:20}
 .mochi-composer textarea{font-size:16px;line-height:1.35;-webkit-text-size-adjust:100%}
 .mochi-help{padding-inline:48px}.mochi-item{flex-basis:100%}
}
</style>

{% if schemaError %}<div class="alert alert-warning"><strong>Hace falta actualizar la base de datos.</strong> {{ schemaError }}</div>{% else %}
<main class="mochi-app">
 <header class="mochi-topbar">
  <button class="mochi-menu" id="mochi-history-open" type="button" aria-label="Abrir historial"><i class="fa-solid fa-bars"></i></button>
  <div class="mochi-title"><strong>Mochi</strong><small>{{ mochi.session.date_label|default(mochi.session.session_date) }} · una conversación por día</small></div>
  <form class="mochi-date-form" method="get" title="Cambiar fecha"><button class="mochi-date-button" type="button" aria-hidden="true"><i class="fa-regular fa-calendar"></i></button><input type="date" name="date" value="{{ mochi.session.session_date }}" aria-label="Abrir conversación de otra fecha"></form>
 </header>

 <section class="mochi-chat-shell">
  <div class="mochi-chat" id="mochi-chat" aria-live="polite">
   {% if mochi.estimate_workflow or mochi.service_workflow %}<div class="mochi-task-strip">{% if mochi.service_workflow %}Tarea activa: configurando servicio{% if mochi.service_workflow.current_service_id %} #{{ mochi.service_workflow.current_service_id }}{% endif %}{% elseif mochi.estimate_workflow.mode == 'MODIFY' %}Tarea activa: modificando Estimate{% if mochi.estimate_workflow.current_estimate_id %} #{{ mochi.estimate_workflow.current_estimate_id }}{% endif %}{% else %}Tarea activa: creando Estimate{% endif %}</div>{% endif %}
   {% for chat in mochi.messages %}
    <div class="mochi-message {{ chat.author_type == 'AGENT' ? 'agent' : 'human' }}"><span class="mochi-author">{{ chat.author_type == 'AGENT' ? 'Mochi' : 'Tú' }}</span>{{ chat.message }}{% if chat.author_type == 'AGENT' and chat.metadata_json %}{% set meta=chat.metadata_json|json_decode %}{% if meta.items %}<div class="mochi-items">{% for item in meta.items %}{% if item.kind == 'copy' %}<button class="mochi-item text-start" type="button" data-copy-url="{{ item.url }}"><strong>{{ item.title }}</strong><small>{{ item.meta }}</small><small>{{ item.detail }}</small></button>{% else %}<a class="mochi-item" href="{{ item.url starts with '/vnv-gourmet-express/product/' ? '/vnv-gourmet-express' : item.url }}"><strong>{{ item.title }}</strong><small>{{ item.meta }}</small><small>{{ item.detail }}</small>{% if item.flag %}<span class="badge bg-warning text-dark mt-1">{{ item.flag }}</span>{% endif %}</a>{% endif %}{% endfor %}</div>{% endif %}{% if meta.action_draft %}<div class="mochi-chips" data-action-draft="{{ meta.action_draft.id }}"><button class="mochi-chip primary mochi-confirm-action" type="button">Confirmar</button><button class="mochi-chip mochi-cancel-action" type="button">Cancelar</button></div>{% endif %}{% if meta.estimate_workflow.current_estimate_id %}<div class="mochi-chips"><button class="mochi-chip primary" type="button" data-prompt="Enviar estimate al cliente">Enviar al cliente</button><button class="mochi-chip" type="button" data-prompt="Crear otro estimate">Crear otro</button></div>{% endif %}{% endif %}</div>
   {% else %}<div class="mochi-empty" id="mochi-empty"><div><i class="fa-regular fa-comments"></i><strong>¿Qué necesitas resolver hoy?</strong><p class="mb-0 mt-2">Escribe naturalmente o adjunta una captura.</p></div></div>{% endfor %}
  </div>

  <div class="mochi-composer-wrap">
   <form method="post" enctype="multipart/form-data" class="mochi-composer" id="mochi-chat-form"><input type="hidden" name="action" value="ask_mochi"><input type="hidden" name="session_id" value="{{ mochi.session.id }}"><input type="file" name="screenshots[]" id="mochi-screenshot" accept="image/jpeg,image/png,image/webp" multiple hidden>
    <div class="mochi-compose-row"><button class="mochi-icon-button" id="mochi-attach" type="button" aria-label="Adjuntar capturas"><i class="fa-solid fa-plus"></i></button><textarea class="form-control" name="message" maxlength="6000" placeholder="Escribe a Mochi…"></textarea><button class="mochi-icon-button mochi-send" type="submit" aria-label="Enviar"><i class="fa-solid fa-arrow-up"></i></button></div>
    <div class="mochi-attachment" id="mochi-attachment"><div class="mochi-attachment-previews"></div><span><strong id="mochi-attachment-count">0 capturas</strong><br>Se leerán sin completar datos ausentes.</span><button class="btn btn-sm btn-outline-danger" id="mochi-remove-attachment" type="button" aria-label="Quitar capturas"><i class="fa-solid fa-xmark"></i></button></div>
    <small class="mochi-help">Hasta 5 capturas JPG, PNG o WebP.</small>
   </form>
  </div>
 </section>
</main>

<div class="mochi-drawer-backdrop" id="mochi-history-backdrop"></div>
<aside class="mochi-drawer" id="mochi-history-drawer" aria-label="Historial de conversaciones">
 <div class="mochi-drawer-head"><div><strong>Conversaciones</strong><small class="d-block text-muted">Una por cada día</small></div><button class="mochi-menu" id="mochi-history-close" type="button" aria-label="Cerrar historial"><i class="fa-solid fa-xmark"></i></button></div>
 <form class="mb-3" method="get"><label class="form-label small fw-bold" for="mochi-history-date">Abrir una fecha</label><input class="form-control" id="mochi-history-date" type="date" name="date" value="{{ mochi.session.session_date }}"></form>
 <nav class="mochi-history">{% for session in mochi.history %}<a class="history-link {{ session.id == mochi.session.id ? 'active' }}" href="?session={{ session.id }}"><strong>{{ session.date_label|default(session.session_date) }}</strong><small>{{ session.message_count }} mensajes</small></a>{% endfor %}</nav>
</aside>
{% endif %}

<script>
(()=>{
 const chat=document.getElementById('mochi-chat'),form=document.getElementById('mochi-chat-form');if(!chat||!form)return;
 const input=form.elements.message,send=form.querySelector('button[type="submit"]'),session=form.elements.session_id;
 const root=document.documentElement,body=document.body,mobile=window.matchMedia('(max-width:767px)');
 root.classList.add('mochi-chat-page');body.classList.add('mochi-chat-page');
 const viewportMeta=document.querySelector('meta[name="viewport"]');
 if(viewportMeta&&!viewportMeta.content.includes('interactive-widget'))viewportMeta.content+=', viewport-fit=cover, interactive-widget=resizes-content';
 const nearBottom=()=>chat.scrollHeight-chat.scrollTop-chat.clientHeight<120;
 const syncVisibleViewport=()=>{if(!mobile.matches){root.style.removeProperty('--mochi-visible-height');return}const keepBottom=document.activeElement===input||nearBottom();const height=Math.round(window.visualViewport?.height||window.innerHeight);root.style.setProperty('--mochi-visible-height',height+'px');if(keepBottom)requestAnimationFrame(()=>{chat.scrollTop=chat.scrollHeight})};
 window.visualViewport?.addEventListener('resize',syncVisibleViewport);window.visualViewport?.addEventListener('scroll',syncVisibleViewport);window.addEventListener('resize',syncVisibleViewport);window.addEventListener('orientationchange',syncVisibleViewport);mobile.addEventListener?.('change',syncVisibleViewport);input.addEventListener('focus',syncVisibleViewport);syncVisibleViewport();
 const drawer=document.getElementById('mochi-history-drawer'),backdrop=document.getElementById('mochi-history-backdrop');
 const setDrawer=open=>{drawer?.classList.toggle('open',open);backdrop?.classList.toggle('open',open);document.body.style.overflow=open?'hidden':''};
 document.getElementById('mochi-history-open')?.addEventListener('click',()=>setDrawer(true));document.getElementById('mochi-history-close')?.addEventListener('click',()=>setDrawer(false));backdrop?.addEventListener('click',()=>setDrawer(false));
 document.querySelectorAll('.mochi-date-form input,.mochi-drawer input[type="date"]').forEach(el=>el.addEventListener('change',()=>el.form.submit()));
 const resize=()=>{input.style.height='auto';input.style.height=Math.min(input.scrollHeight,145)+'px'};input.addEventListener('input',resize);
 const chipsFor=data=>{if(data?.estimate_workflow?.current_estimate_id)return[{label:'Enviar al cliente',prompt:'Enviar estimate al cliente',primary:true},{label:'Crear otro',prompt:'Crear otro estimate'}];if(data?.service_workflow?.current_service_id)return[{label:'Usarlo en un estimate',prompt:'Crear un estimate usando este servicio',primary:true},{label:'Crear otro servicio',prompt:'Crear otro servicio'}];if((data?.items||[]).length&&['collections','opportunities','requests','weekend_events','my_events'].includes(data.tool))return[{label:'Revisar uno por uno',prompt:'Revisemos estos resultados uno por uno',primary:true},{label:'Lo dejamos aquí',prompt:'Terminamos esta revisión'}];if((data?.items||[]).length&&data.tool==='catalog')return[{label:'Usar el primero',prompt:'Crea un estimate usando el primer servicio de la lista',primary:true}];return[]};
 const addChips=(row,chips)=>{if(!chips.length)return;const box=document.createElement('div');box.className='mochi-chips';chips.forEach((chip,index)=>{const b=document.createElement('button');b.type='button';b.className='mochi-chip'+(chip.primary||index===0?' primary':'');b.textContent=chip.label;b.dataset.prompt=chip.prompt;box.append(b)});row.append(box)};
 const enhanceList=list=>{if(list.dataset.enhanced)return;list.dataset.enhanced='1';const cards=[...list.children];if(cards.length<2)return;let index=0;const controls=document.createElement('div');controls.className='mochi-list-controls';const label=document.createElement('span');const previous=document.createElement('button'),next=document.createElement('button');previous.type=next.type='button';previous.innerHTML='<i class="fa-solid fa-chevron-left"></i>';next.innerHTML='<i class="fa-solid fa-chevron-right"></i>';const update=()=>{label.textContent=(index+1)+' de '+cards.length;previous.disabled=index===0;next.disabled=index===cards.length-1;cards[index].scrollIntoView({behavior:'smooth',block:'nearest',inline:'start'})};previous.onclick=()=>{index=Math.max(0,index-1);update()};next.onclick=()=>{index=Math.min(cards.length-1,index+1);update()};controls.append(label,previous,next);list.after(controls);update()};
 const add=(who,text,kind='',items=[],chips=[])=>{document.getElementById('mochi-empty')?.remove();const row=document.createElement('div');row.className='mochi-message '+kind;const author=document.createElement('span');author.className='mochi-author';author.textContent=who;row.append(author,document.createTextNode(text));if(items.length){const list=document.createElement('div');list.className='mochi-items';items.forEach(item=>{const card=document.createElement(item.kind==='copy'?'button':'a');card.className='mochi-item';if(item.kind==='copy'){card.type='button';card.dataset.copyUrl=item.url||''}else card.href=(item.url||'#').startsWith('/vnv-gourmet-express/product/')?'/vnv-gourmet-express':(item.url||'#');const title=document.createElement('strong'),meta=document.createElement('small'),detail=document.createElement('small');title.textContent=item.title||'';meta.textContent=item.meta||'';detail.textContent=item.detail||'';card.append(title,meta,detail);list.append(card)});row.append(list);setTimeout(()=>enhanceList(list),0)}addChips(row,chips);chat.append(row);chat.scrollTop=chat.scrollHeight;return row};
 document.querySelectorAll('.mochi-items').forEach(enhanceList);chat.scrollTop=chat.scrollHeight;
 document.addEventListener('click',event=>{const chip=event.target.closest('[data-prompt]');if(!chip)return;input.value=chip.dataset.prompt;resize();form.requestSubmit()});
 form.addEventListener('submit',async event=>{event.preventDefault();const message=input.value.trim();if(!message||send.disabled)return;const payload=new FormData(form);add('Tú',message,'human');input.value='';resize();send.disabled=true;const thinking=add('Mochi','Estoy revisándolo…','agent thinking');try{const response=await fetch(location.pathname,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'},body:payload,credentials:'same-origin'});const data=await response.json();thinking.remove();if(!response.ok||!data.ok)throw new Error(data.error||'No pude responder.');session.value=data.session_id;const row=add('Mochi',data.reply,'agent',data.items||[],chipsFor(data));if(data.action_draft){const controls=document.createElement('div');controls.className='mochi-chips';controls.dataset.actionDraft=data.action_draft.id;controls.innerHTML='<button class="mochi-chip primary mochi-confirm-action" type="button">Confirmar</button><button class="mochi-chip mochi-cancel-action" type="button">Cancelar</button>';row.append(controls)}}catch(error){thinking.remove();add('Mochi',error.message||'No pude completar la solicitud.','agent');input.value=message;resize()}finally{send.disabled=false;input.focus()}});
 chat.addEventListener('click',async event=>{const confirm=event.target.closest('.mochi-confirm-action'),cancel=event.target.closest('.mochi-cancel-action'),copy=event.target.closest('[data-copy-url]');if(copy){try{await navigator.clipboard.writeText(copy.dataset.copyUrl);copy.querySelector('strong').textContent='Enlace copiado ✓'}catch(_error){}return}if(!confirm&&!cancel)return;const controls=event.target.closest('[data-action-draft]');controls.querySelectorAll('button').forEach(button=>button.disabled=true);const body=new FormData();body.set('action',confirm?'confirm_mochi_action':'cancel_mochi_action');body.set('draft_id',controls.dataset.actionDraft);body.set('session_id',session.value);try{const response=await fetch(location.pathname,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'},body});const data=await response.json();if(!response.ok||!data.ok)throw new Error(data.error||'No pude completar la acción.');controls.remove();add('Mochi',data.reply,'agent',data.items||[],chipsFor(data))}catch(error){controls.querySelectorAll('button').forEach(button=>button.disabled=false);add('Mochi',error.message,'agent')}});
})();
</script>
<script>
(()=>{const form=document.getElementById('mochi-chat-form'),input=form?.elements.message,fileInput=document.getElementById('mochi-screenshot'),attachment=document.getElementById('mochi-attachment'),previews=attachment?.querySelector('.mochi-attachment-previews'),count=document.getElementById('mochi-attachment-count');if(!form||!input||!fileInput||!attachment||!previews||!count)return;let files=[],urls=[];const sync=()=>{const transfer=new DataTransfer();files.forEach(file=>transfer.items.add(file));fileInput.files=transfer.files;urls.forEach(URL.revokeObjectURL);urls=[];previews.replaceChildren();files.forEach(file=>{const image=document.createElement('img'),url=URL.createObjectURL(file);urls.push(url);image.src=url;image.alt=file.name;previews.append(image)});count.textContent=files.length+(files.length===1?' captura':' capturas');attachment.classList.toggle('visible',files.length>0)};const clear=()=>{files=[];sync()};const addFiles=incoming=>{for(const file of incoming){if(!['image/jpeg','image/png','image/webp'].includes(file.type)||file.size>8*1024*1024)continue;if(files.length>=5)break;files.push(file)}sync();if(files.length&&!input.value.trim())input.value='Analiza estas capturas y ayúdame con lo que muestran.'};document.getElementById('mochi-attach')?.addEventListener('click',()=>fileInput.click());document.getElementById('mochi-remove-attachment')?.addEventListener('click',clear);fileInput.addEventListener('change',()=>{files=[];addFiles([...fileInput.files])});input.addEventListener('paste',event=>{const pasted=[...event.clipboardData.items].filter(item=>item.type.startsWith('image/')).map(item=>item.getAsFile()).filter(Boolean);if(pasted.length){event.preventDefault();addFiles(pasted)}});form.addEventListener('submit',()=>{if(files.length)setTimeout(clear,0)})})();
</script>
{% endblock %}
