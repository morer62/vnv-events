{% extends 'templates/base.admin.twig' %}
{% block body %}
<style>
.auto-hero{background:linear-gradient(135deg,#10191d,#173631);color:#fff;border-radius:28px;padding:26px 30px;box-shadow:0 18px 42px rgba(8,26,24,.18)}.auto-hero h1{color:#fff}.auto-kicker{color:#55ead1;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.auto-card{background:#fff;border:1px solid #e4eceb;border-radius:22px;padding:22px;box-shadow:0 10px 28px rgba(22,47,44,.08)}.mochi-avatar{width:62px;max-width:100%;height:auto;aspect-ratio:3/5;background-image:url('{{ asset_for('assets/images/automation/vnv-frog-concierge-sprite.png') }}');background-size:800% auto;background-position:28.57% center;background-repeat:no-repeat}.mochi-chat{max-height:280px;overflow-y:auto;background:#f8fbfa;scrollbar-gutter:stable}.mochi-message{padding:10px 12px;border-radius:14px;margin-bottom:9px;background:#fff;border:1px solid #e5eeeb}.mochi-message.agent{background:#effbf7;border-color:#cfe9df}.review-list{max-height:560px;overflow-y:auto;padding-right:8px;scrollbar-gutter:stable}.review-item{background:#fcfdfd;border:1px solid #e3ece9!important}.review-copy{max-height:110px;overflow-y:auto;background:#f5f8f7;border-radius:12px;padding:10px}.task-count{background:#173631;color:#fff;border-radius:999px;padding:6px 12px;font-weight:700;font-size:.85rem}@media(max-width:767px){.auto-hero{padding:22px}.review-list{max-height:65vh}}
</style>
<div class="auto-hero mb-4"><span class="auto-kicker">Operaciones VNV</span><h1 class="mt-2 mb-2">Tu conversación con Mochi</h1><p class="mb-0">Mochi revisa el sistema; tú aportas el criterio humano antes de contactar a alguien.</p></div>
{% if schemaError %}
 <div class="alert alert-warning"><strong>Hace falta actualizar la base de datos.</strong> {{ schemaError }}</div>
{% else %}
 <section class="auto-card mb-4" id="conversation">
  <div class="d-flex align-items-center gap-3 mb-3"><div class="mochi-avatar" role="img" aria-label="Mochi, la ranita asistente de VNV"></div><div><h2 class="h4 mb-1">Habla con Mochi</h2><p class="text-muted mb-0">Cuéntale novedades, dudas o contexto importante de un cliente o evento.</p></div></div>
  <div class="mochi-chat border rounded-4 p-3 mb-3">
   {% for chat in mochiConversation %}<div class="mochi-message {{ chat.author_type == 'AGENT' ? 'agent' : 'human' }}"><strong>{{ chat.author_type == 'AGENT' ? 'Mochi' : 'Tú' }}:</strong> {{ chat.message }}</div>{% else %}<span class="text-muted">Todavía no hay conversación. Mochi está lista para ayudarte con VNV Events.</span>{% endfor %}
  </div>
  <form method="post" class="row g-2"><input type="hidden" name="action" value="ask_mochi"><div class="col-md-3"><input class="form-control" type="number" name="customer_id" min="1" placeholder="ID del cliente (opcional)"></div><div class="col-md-7"><input class="form-control" name="message" maxlength="1500" required placeholder="Escribe aquí como si hablaras con tu asistente…"></div><div class="col-md-2"><button class="btn btn-dark w-100">Enviar</button></div></form>
 </section>

 <section class="auto-card mb-4" id="recommendations">
  <div class="d-flex justify-content-between align-items-start gap-3 mb-3"><div><h2 class="h4 mb-1">Tareas por revisar</h2><p class="text-muted mb-0">Los mensajes para clientes permanecen en inglés y no se envían sin tu aprobación.</p></div><span class="task-count">{{ recommendations|length }} pendientes</span></div>
  <div class="review-list">
  {% for item in recommendations %}
   <form method="post" class="review-item rounded-4 p-3 mb-3"><input type="hidden" name="action" value="review"><input type="hidden" name="dedupe_key" value="{{ item.dedupe_key }}">
    <div class="row g-3"><div class="col-lg-7"><div class="d-flex flex-wrap align-items-center gap-2"><span class="badge bg-info text-dark">{{ item.message_type }}</span><strong>{{ item.name }} {{ item.lastname }}</strong><span class="small text-muted">{{ item.email }}</span></div><div class="small text-muted my-2">Canales: {{ item.channels }} · {{ item.created_at }} UTC</div><details><summary class="fw-semibold" style="cursor:pointer">Ver mensaje propuesto</summary><div class="review-copy small mt-2"><strong>{{ item.subject }}</strong><br>{{ item.body|striptags }}</div></details></div>
    <div class="col-lg-5"><label class="form-label">¿Qué debe saber Mochi?</label><textarea class="form-control mb-2" name="comment" rows="2" placeholder="Ejemplo: esperar hasta el viernes."></textarea><details><summary class="small text-muted" style="cursor:pointer">Guardar contexto para el futuro</summary><div class="row g-2 mt-1"><div class="col-5"><select class="form-select" name="memory_type"><option value="">No guardar</option><option value="FACT">Hecho</option><option value="PREFERENCE">Preferencia</option><option value="SENSITIVITY">Tema sensible</option><option value="INFERENCE">Posible inferencia</option></select></div><div class="col-7"><input class="form-control" name="memory" maxlength="1000" placeholder="Contexto que debe recordar"></div></div></details><div class="d-flex gap-2 mt-3"><button class="btn btn-success" name="decision" value="APPROVE">Aprobar</button><button class="btn btn-outline-danger" name="decision" value="REJECT">Descartar</button></div></div></div>
   </form>
  {% else %}<div class="text-muted py-3">Todo está revisado. Mochi puede disfrutar su café.</div>{% endfor %}
  </div>
 </section>
{% endif %}
{% endblock %}
