{% extends 'templates/base.admin.twig' %}
{% block body %}
<style>
.auto-hero{background:linear-gradient(135deg,#10191d,#173631);color:#fff;border-radius:28px;padding:30px;box-shadow:0 18px 42px rgba(8,26,24,.18)}.auto-hero h1{color:#fff}.auto-kicker{color:#55ead1;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.auto-card{background:#fff;border:1px solid #e4eceb;border-radius:22px;padding:24px;box-shadow:0 10px 28px rgba(22,47,44,.08)}.auto-stat strong{display:block;font-size:1.9rem;color:#0f3f38}.auto-switch{display:flex;justify-content:space-between;gap:16px;padding:14px 0;border-bottom:1px solid #edf2f1}.auto-switch:last-child{border-bottom:0}.auto-dot{width:10px;height:10px;border-radius:50%;display:inline-block;margin-right:7px}.auto-dot.ok{background:#15a97e}.auto-dot.warn{background:#e4ad42}.auto-dot.bad{background:#d95562}
</style>
<div class="auto-hero mb-4"><span class="auto-kicker">VNV Operations</span><h1 class="mt-2 mb-2">Automation &amp; Concierge</h1><p class="mb-0">A polite, auditable follow-up system for events, payments, team assignments and rewards.</p></div>
{% if schemaError %}<div class="alert alert-warning"><strong>Database migration required.</strong> {{ schemaError }}</div>{% else %}
<div class="row g-3 mb-4">
 <div class="col-md-3"><div class="auto-card auto-stat"><span>Master status</span><strong>{{ settings.master_enabled ? 'Running' : 'Paused' }}</strong><small>{{ settings.dry_run ? 'Simulation mode' : 'Live delivery' }}</small></div></div>
 <div class="col-md-3"><div class="auto-card auto-stat"><span>Pending</span><strong>{{ counts.PENDING|default(0) }}</strong><small>Queued deliveries</small></div></div>
 <div class="col-md-3"><div class="auto-card auto-stat"><span>Sent</span><strong>{{ counts.SENT|default(0) }}</strong><small>Successfully delivered</small></div></div>
 <div class="col-md-3"><div class="auto-card auto-stat"><span>Needs attention</span><strong>{{ counts.FAILED|default(0) }}</strong><small>Retried automatically</small></div></div>
</div>
<form method="post" class="auto-card mb-4"><input type="hidden" name="action" value="save">
 <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3"><div><h2 class="h4 mb-1">Control Center</h2><p class="text-muted mb-0">The master switch immediately pauses new decisions. Dry run records decisions without contacting anyone.</p></div><button class="btn btn-primary" type="submit">Save settings</button></div>
 <div class="row g-4">
  <div class="col-lg-6">
   {% for key,label,help in [
    ['master_enabled','Enable VNV Concierge','Allow the scheduler to evaluate and queue messages.'],
    ['dry_run','Simulation mode','No email, push or in-app notification is delivered.'],
    ['contract_reminders_enabled','Contract reminders','Gentle follow-up while a future contract remains unsigned.'],
    ['payment_reminders_enabled','Payment reminders','Follow-up for pending deposits and balances.'],
    ['team_reminders_enabled','Team event reminders','Notify assigned employees the day before and day of an event.'],
    ['rewards_messages_enabled','Rewards messages','Occasional notice when newly released points are available.'],
    ['ai_copy_enabled','AI-assisted copy','Reserved for constrained, fact-checked personalization.']
   ] %}<label class="auto-switch"><span><strong>{{ label }}</strong><small class="d-block text-muted">{{ help }}</small></span><input class="form-check-input" type="checkbox" name="{{ key }}" value="1" {{ attribute(settings,key) ? 'checked' : '' }}></label>{% endfor %}
  </div>
  <div class="col-lg-6"><div class="row g-3">
   <div class="col-12"><label class="form-label">Timezone</label><input class="form-control" name="timezone" value="{{ settings.timezone }}" required></div>
   <div class="col-6"><label class="form-label">Quiet hours start</label><input class="form-control" type="time" name="quiet_hours_start" value="{{ settings.quiet_hours_start|slice(0,5) }}"></div><div class="col-6"><label class="form-label">Quiet hours end</label><input class="form-control" type="time" name="quiet_hours_end" value="{{ settings.quiet_hours_end|slice(0,5) }}"></div>
   <div class="col-6"><label class="form-label">Daily user limit</label><input class="form-control" type="number" min="1" max="10" name="max_messages_per_user_day" value="{{ settings.max_messages_per_user_day }}"></div><div class="col-6"><label class="form-label">Weekly user limit</label><input class="form-control" type="number" min="1" max="20" name="max_messages_per_user_week" value="{{ settings.max_messages_per_user_week }}"></div>
   <div class="col-4"><label class="form-label">Contract cadence</label><input class="form-control" type="number" min="1" name="contract_cadence_days" value="{{ settings.contract_cadence_days }}"></div><div class="col-4"><label class="form-label">Payment cadence</label><input class="form-control" type="number" min="1" name="payment_cadence_days" value="{{ settings.payment_cadence_days }}"></div><div class="col-4"><label class="form-label">Rewards cadence</label><input class="form-control" type="number" min="7" name="rewards_cadence_days" value="{{ settings.rewards_cadence_days }}"></div>
   <div class="col-12"><label class="form-label">Optional current promotion</label><textarea class="form-control" name="promotion_note" rows="2" maxlength="500">{{ settings.promotion_note }}</textarea></div>
   <div class="col-12"><label class="form-label">Controlled test recipient</label><input class="form-control" type="email" name="test_recipient_email" value="{{ settings.test_recipient_email }}"></div>
  </div></div>
 </div>
</form>
<div class="auto-card mb-4"><div class="d-flex gap-2 flex-wrap align-items-end"><form method="post"><input type="hidden" name="action" value="run"><button class="btn btn-outline-primary">Run scheduler now</button></form><form method="post"><input type="hidden" name="action" value="deliver"><button class="btn btn-outline-success">Process outbox now</button></form><form method="post" class="d-flex gap-2"><input type="hidden" name="action" value="test"><input class="form-control" type="email" name="test_email" value="{{ settings.test_recipient_email }}" placeholder="Test email" required><button class="btn btn-dark">Queue safe test</button></form></div></div>
<div class="auto-card mb-4"><h2 class="h5">Execution health</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Job</th><th>Status</th><th>Scanned</th><th>Queued/Sent</th><th>Started UTC</th><th>Error</th></tr></thead><tbody>{% for run in runs %}<tr><td>{{ run.job_key }}</td><td><span class="auto-dot {{ run.status == 'SUCCESS' ? 'ok' : (run.status == 'FAILED' ? 'bad' : 'warn') }}"></span>{{ run.status }}</td><td>{{ run.scanned_count }}</td><td>{{ run.queued_count }}/{{ run.sent_count }}</td><td>{{ run.started_at }}</td><td class="small text-danger">{{ run.error_message }}</td></tr>{% else %}<tr><td colspan="6" class="text-muted">No executions yet.</td></tr>{% endfor %}</tbody></table></div></div>
<div class="auto-card"><h2 class="h5">Recent decisions and deliveries</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Type</th><th>Channel</th><th>Recipient</th><th>Status</th><th>Attempts</th><th>Created UTC</th></tr></thead><tbody>{% for item in outbox %}<tr><td>{{ item.message_type }}</td><td>{{ item.channel }}</td><td>{{ item.recipient }}</td><td>{{ item.status }}</td><td>{{ item.attempts }}</td><td>{{ item.created_at }}</td></tr>{% else %}<tr><td colspan="6" class="text-muted">The outbox is empty.</td></tr>{% endfor %}</tbody></table></div></div>
{% endif %}
{% endblock %}
