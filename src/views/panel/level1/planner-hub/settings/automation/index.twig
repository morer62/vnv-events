{% extends 'templates/base.admin.twig' %}
{% block body %}
<style>
.auto-hero{background:linear-gradient(135deg,#10191d,#173631);color:#fff;border-radius:28px;padding:22px 26px;box-shadow:0 18px 42px rgba(8,26,24,.18);display:flex;align-items:center;gap:18px}.auto-hero h1{color:#fff;font-size:clamp(1.65rem,3vw,2.35rem)}.auto-kicker{color:#55ead1;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.auto-card{background:#fff;border:1px solid #e4eceb;border-radius:22px;padding:22px;box-shadow:0 10px 28px rgba(22,47,44,.08)}.mochi-avatar{flex:0 0 62px;width:62px;height:auto;aspect-ratio:3/5;background:url('{{ asset_for('assets/images/automation/vnv-frog-concierge-sprite.png') }}') 28.57% center/800% auto no-repeat;transition:transform .2s ease,filter .2s ease}.mochi-avatar.thinking{animation:mochi-think 1.25s ease-in-out infinite;filter:drop-shadow(0 6px 10px rgba(85,234,209,.25))}.mochi-avatar.success{transform:translateY(-2px) scale(1.04)}.mochi-avatar.error{filter:saturate(.6)}@keyframes mochi-think{50%{transform:translateY(-3px) rotate(1.5deg)}}.mochi-tabs{display:flex;gap:8px;overflow-x:auto;padding:5px;background:#edf4f1;border-radius:16px;margin-bottom:18px}.mochi-tab{flex:1;min-width:max-content;border:0;background:transparent;color:#37534b;border-radius:12px;padding:10px 14px;font-weight:850}.mochi-tab.active{background:#173631;color:#fff;box-shadow:0 7px 18px rgba(23,54,49,.2)}.mochi-tab .count{display:inline-grid;place-items:center;min-width:22px;height:22px;border-radius:999px;background:#d8a845;color:#17130b;margin-left:5px;font-size:.75rem}.mochi-view[hidden]{display:none}.mochi-workflow{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;padding:10px 13px;border:1px solid #bfe2d7;background:#edf9f5;border-radius:14px;color:#174c42;font-weight:800}.mochi-workflow[hidden]{display:none}.mochi-chat{height:min(52vh,470px);min-height:310px;overflow-y:auto;background:#f8fbfa;scrollbar-gutter:stable;padding:14px}.mochi-message{padding:11px 13px;border-radius:15px;margin-bottom:10px;background:#fff;border:1px solid #e5eeeb;white-space:pre-wrap}.mochi-message.agent{background:#effbf7;border-color:#cfe9df}.mochi-message.thinking{color:#527069;font-style:italic}.mochi-items{display:grid;gap:8px;margin-top:10px}.mochi-item{display:block;text-decoration:none;color:#122521;border:1px solid #d5e7e1;background:#fff;border-radius:12px;padding:10px}.mochi-item:hover{border-color:#45cdb5;color:#122521}.mochi-item small{display:block;color:#60756f}.mochi-copy{margin-top:8px}.suggestions{display:flex;gap:8px;overflow-x:auto;margin:10px 0;padding-bottom:3px}.suggestion{flex:0 0 auto;border:1px solid #d7e8e3;background:#f4fbf8;border-radius:999px;padding:8px 12px;text-align:left;font-weight:750;font-size:.85rem}.suggestion:nth-child(-n+2){background:#173631;color:#fff;border-color:#173631}.suggestion small{display:none}.mochi-composer{position:sticky;bottom:0;background:#fff;padding-top:10px;z-index:2}.mochi-composer textarea{min-height:58px;max-height:130px;resize:none;overflow-y:auto}.mochi-history{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:8px;max-height:520px;overflow:auto}.history-link{display:block;padding:12px;border:1px solid #e2ebe8;border-radius:14px;text-decoration:none;color:#20332f}.history-link.active,.history-link:hover{background:#eef8f5;border-color:#bcded3}.review-list{max-height:560px;overflow-y:auto}.review-item{background:#fcfdfd;border:1px solid #e3ece9}.task-count{background:#173631;color:#fff;border-radius:999px;padding:6px 12px;font-weight:700;font-size:.85rem}@media(max-width:767px){.auto-hero{padding:18px;align-items:flex-start}.auto-card{padding:15px}.mochi-chat{height:48vh;min-height:270px}.mochi-composer{align-items:stretch}.mochi-composer textarea{min-height:54px}.mochi-composer button{padding-inline:13px!important}.suggestions{display:grid;grid-template-columns:1fr 1fr;overflow:visible}.suggestion{white-space:normal}}
.mochi-attachment{display:none;align-items:center;gap:10px;margin-top:8px;padding:9px 11px;border:1px solid #cfe3dd;background:#f3faf7;border-radius:13px}.mochi-attachment.visible{display:flex}.mochi-attachment-previews{display:flex;gap:6px;max-width:250px;overflow-x:auto}.mochi-attachment img{width:48px;height:48px;object-fit:cover;border-radius:9px;flex:0 0 48px}.mochi-attachment span{flex:1;color:#45625a;font-size:.82rem}.mochi-attach-button{width:46px;height:46px;flex:0 0 46px;border-radius:14px}.mochi-drop-active{outline:3px dashed #45cdb5;outline-offset:4px}
</style>
<div class="auto-hero mb-3"><div class="mochi-avatar" role="img" aria-label="Mochi"></div><div><span class="auto-kicker">Operaciones VNV</span><h1 class="mt-1 mb-1">Mochi</h1><p class="mb-0">Pregunta, revisa y actúa sin salir de la conversación.</p></div></div>
{% if schemaError %}<div class="alert alert-warning"><strong>Hace falta actualizar la base de datos.</strong> {{ schemaError }}</div>{% else %}
<nav class="mochi-tabs" aria-label="Secciones de Mochi"><button class="mochi-tab active" type="button" data-mochi-tab="conversation"><i class="fa-regular fa-comments"></i> Conversar</button>{% if isReviewer %}<button class="mochi-tab" type="button" data-mochi-tab="recommendations"><i class="fa-regular fa-circle-check"></i> Tareas <span class="count">{{ recommendations|length }}</span></button>{% endif %}<button class="mochi-tab" type="button" data-mochi-tab="history"><i class="fa-solid fa-clock-rotate-left"></i> Historial</button></nav>
<section class="auto-card mb-4 mochi-view" id="conversation" data-mochi-view="conversation">
 <div class="d-flex align-items-center justify-content-between gap-3 mb-3"><div><h2 class="h4 mb-1">Habla con Mochi</h2><p class="text-muted mb-0">{{ mochi.session.title }} · {{ mochi.session.session_date }}</p></div><button class="btn btn-outline-dark btn-sm" id="new-chat" type="button"><i class="fa-solid fa-plus"></i> Nueva</button></div>
 <div class="mochi-workflow" id="mochi-workflow" data-workflow-type="{{ mochi.service_workflow ? 'service' : 'estimate' }}" {% if not mochi.estimate_workflow and not mochi.service_workflow %}hidden{% endif %}><span id="mochi-workflow-label">{% if mochi.service_workflow %}Configurando servicio{% if mochi.service_workflow.current_service_id %} #{{ mochi.service_workflow.current_service_id }}{% endif %}{% elseif mochi.estimate_workflow.mode == 'MODIFY' %}Modificando Estimate{% if mochi.estimate_workflow.current_estimate_id %} #{{ mochi.estimate_workflow.current_estimate_id }}{% endif %}{% else %}Creando Estimate{% endif %}</span><span class="d-flex flex-wrap gap-1"><button class="btn btn-sm btn-success" type="button" id="send-estimate-workflow" {% if not mochi.estimate_workflow.current_estimate_id %}hidden{% endif %}>Enviar al cliente</button><button class="btn btn-sm btn-outline-dark" type="button" id="another-estimate-workflow" {% if not mochi.estimate_workflow.current_estimate_id %}hidden{% endif %}>Crear otro</button><button class="btn btn-sm btn-outline-danger" type="button" id="cancel-estimate-workflow">Cancelar</button></span></div>
 <div>
  <div class="mochi-chat border rounded-4" id="mochi-chat" aria-live="polite">
   {% for chat in mochi.messages %}<div class="mochi-message {{ chat.author_type == 'AGENT' ? 'agent' : 'human' }}"><strong>{{ chat.author_type == 'AGENT' ? 'Mochi' : 'Tú' }}:</strong> {{ chat.message }}{% if chat.author_type == 'AGENT' and chat.metadata_json %}{% set meta=chat.metadata_json|json_decode %}{% if meta.action_draft %}<div class="mt-2 d-flex gap-2" data-action-draft="{{ meta.action_draft.id }}"><button class="btn btn-sm btn-success mochi-confirm-action" type="button">Confirmar acción</button><button class="btn btn-sm btn-outline-secondary mochi-cancel-action" type="button">Cancelar</button></div>{% endif %}{% if meta.items %}<div class="mochi-items">{% for item in meta.items %}<a class="mochi-item" href="{{ item.url starts with '/vnv-gourmet-express/product/' ? '/vnv-gourmet-express' : item.url }}"><strong>{{ item.title }}</strong><small>{{ item.meta }}</small><small>{{ item.detail }}</small>{% if item.flag %}<span class="badge bg-warning text-dark mt-1">{{ item.flag }}</span>{% endif %}</a>{% endfor %}</div>{% endif %}{% endif %}</div>{% endfor %}
   {% if mochi.messages is empty %}<div id="mochi-empty"><p class="text-muted mb-2">¡Hola! ¿Qué revisamos hoy?</p><div class="suggestions">{% for suggestion in mochi.suggestions %}<button class="suggestion" type="button" data-prompt="{{ suggestion.prompt }}">{{ suggestion.title }}<small>{{ suggestion.prompt }}</small></button>{% endfor %}</div></div>{% endif %}
  </div>
  {% if mochi.messages is not empty %}<div class="suggestions" aria-label="Preguntas rápidas">{% for suggestion in mochi.suggestions|slice(0,4) %}<button class="suggestion" type="button" data-prompt="{{ suggestion.prompt }}">{{ suggestion.title }}</button>{% endfor %}</div>{% endif %}
  <form method="post" enctype="multipart/form-data" class="mochi-composer" id="mochi-chat-form"><input type="hidden" name="action" value="ask_mochi"><input type="hidden" name="session_id" value="{{ mochi.session.id }}"><input type="file" name="screenshots[]" id="mochi-screenshot" accept="image/jpeg,image/png,image/webp" multiple hidden><div class="d-flex gap-2 align-items-end"><button class="btn btn-outline-secondary mochi-attach-button" id="mochi-attach" type="button" title="Adjuntar o pegar capturas" aria-label="Adjuntar capturas"><i class="fa-solid fa-paperclip"></i></button><button class="btn btn-outline-secondary mochi-attach-button" id="mochi-voice" type="button" title="Dictar" aria-label="Dictar mensaje"><i class="fa-solid fa-microphone"></i></button><textarea class="form-control" name="message" maxlength="6000" placeholder="Pregúntale algo, dicta o pega una captura aquí…"></textarea><button class="btn btn-dark px-4" type="submit"><i class="fa-solid fa-paper-plane"></i><span class="visually-hidden"> Enviar</span></button></div><div class="mochi-attachment" id="mochi-attachment"><div class="mochi-attachment-previews" aria-label="Capturas adjuntas"></div><span><strong id="mochi-attachment-count">0 capturas</strong><br>Mochi interpretará el texto y el contexto al enviarlas.</span><button class="btn btn-sm btn-outline-danger" id="mochi-remove-attachment" type="button" aria-label="Quitar capturas"><i class="fa-solid fa-xmark"></i></button></div><small class="d-block text-muted mt-1">Puedes dictar, pegar o adjuntar hasta 5 capturas. JPG, PNG o WebP; máximo 8 MB cada una.</small></form>
 </div>
</section>
{% if isReviewer %}<section class="auto-card mb-4 mochi-view" id="recommendations" data-mochi-view="recommendations" hidden><div class="d-flex justify-content-between align-items-start gap-3 mb-3"><div><h2 class="h4 mb-1">Tareas por revisar</h2><p class="text-muted mb-0">Nada se envía sin aprobación humana.</p></div><span class="task-count">{{ recommendations|length }} pendientes</span></div><div class="review-list">{% for item in recommendations %}<form method="post" class="review-item rounded-4 p-3 mb-3"><input type="hidden" name="action" value="review"><input type="hidden" name="dedupe_key" value="{{ item.dedupe_key }}"><strong>{{ item.name }} {{ item.lastname }}</strong><p class="small mt-2">{{ item.body|striptags }}</p><textarea class="form-control mb-2" name="comment" rows="2" placeholder="Contexto para Mochi"></textarea><button class="btn btn-success" name="decision" value="APPROVE">Aprobar</button> <button class="btn btn-outline-danger" name="decision" value="REJECT">Descartar</button></form>{% else %}<p class="text-muted">Todo está revisado.</p>{% endfor %}</div></section>{% endif %}
<section class="auto-card mb-4 mochi-view" id="history" data-mochi-view="history" hidden><div class="d-flex justify-content-between align-items-center gap-3 mb-3"><div><h2 class="h4 mb-1">Historial</h2><p class="text-muted mb-0">Retoma cualquier conversación sin perder el contexto.</p></div><button class="btn btn-dark btn-sm" id="new-chat-history" type="button"><i class="fa-solid fa-plus"></i> Nueva</button></div><div class="mochi-history">{% for session in mochi.history %}<a class="history-link {{ session.id == mochi.session.id ? 'active' }}" href="?session={{ session.id }}#conversation"><strong>{{ session.title }}</strong><small class="d-block text-muted">{{ session.session_date }} · {{ session.message_count }} mensajes</small></a>{% endfor %}</div></section>
{% endif %}
<script>
(()=>{const tabs=[...document.querySelectorAll('[data-mochi-tab]')],views=[...document.querySelectorAll('[data-mochi-view]')];const show=name=>{if(!views.some(v=>v.dataset.mochiView===name))name='conversation';tabs.forEach(t=>t.classList.toggle('active',t.dataset.mochiTab===name));views.forEach(v=>v.hidden=v.dataset.mochiView!==name);history.replaceState(null,'','#'+name)};tabs.forEach(t=>t.addEventListener('click',()=>show(t.dataset.mochiTab)));show(location.hash.slice(1)||'conversation');const form=document.getElementById('mochi-chat-form'),chat=document.getElementById('mochi-chat');if(!form||!chat)return;const input=form.elements.message,button=form.querySelector('button[type="submit"]'),session=form.elements.session_id;const resize=()=>{input.style.height='auto';input.style.height=Math.min(input.scrollHeight,parseInt(getComputedStyle(input).maxHeight)||150)+'px'};input.addEventListener('input',resize);const add=(who,text,kind='',items=[])=>{document.getElementById('mochi-empty')?.remove();const row=document.createElement('div');row.className='mochi-message '+kind;const strong=document.createElement('strong');strong.textContent=who+': ';row.append(strong,document.createTextNode(text));if(items.length){const box=document.createElement('div');box.className='mochi-items';items.forEach(item=>{const a=document.createElement('a');a.className='mochi-item';a.href=(item.url||'#').startsWith('/vnv-gourmet-express/product/')?'/vnv-gourmet-express':(item.url||'#');const title=document.createElement('strong');title.textContent=item.title||'';const meta=document.createElement('small');meta.textContent=item.meta||'';const detail=document.createElement('small');detail.textContent=item.detail||'';a.append(title,meta,detail);if(item.flag){const flag=document.createElement('span');flag.className='badge bg-warning text-dark mt-1';flag.textContent=item.flag;a.append(flag)}box.append(a)});row.append(box)}chat.append(row);chat.scrollTop=chat.scrollHeight;return row};chat.scrollTop=chat.scrollHeight;document.querySelectorAll('[data-prompt]').forEach(el=>el.addEventListener('click',()=>{show('conversation');input.value=el.dataset.prompt;resize();form.requestSubmit()}));form.addEventListener('submit',async e=>{e.preventDefault();const message=input.value.trim();if(!message||button.disabled)return;const payload=new FormData(form);add('Tú',message,'human');input.value='';resize();button.disabled=true;const thinking=add('Mochi','Estoy consultando VNV…','agent thinking');try{const response=await fetch(location.pathname,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'},body:payload,credentials:'same-origin'});const data=await response.json();thinking.remove();if(!response.ok||!data.ok)throw new Error(data.error||'No pude responder.');session.value=data.session_id;const row=add('Mochi',data.reply,'agent',data.items||[]);if(data.action_draft){const controls=document.createElement('div');controls.className='mt-2 d-flex gap-2';controls.dataset.actionDraft=data.action_draft.id;controls.innerHTML='<button class="btn btn-sm btn-success mochi-confirm-action" type="button">Confirmar acción</button><button class="btn btn-sm btn-outline-secondary mochi-cancel-action" type="button">Cancelar</button>';row.append(controls)}}catch(error){thinking.remove();add('Mochi',error.message||'No pude recuperar esos datos ahora mismo.','agent');input.value=message;resize()}finally{button.disabled=false;input.focus()}});chat.addEventListener('click',async e=>{const confirm=e.target.closest('.mochi-confirm-action'),cancel=e.target.closest('.mochi-cancel-action');if(!confirm&&!cancel)return;const controls=e.target.closest('[data-action-draft]');confirm&&(confirm.disabled=true);cancel&&(cancel.disabled=true);const body=new FormData();body.set('action',confirm?'confirm_mochi_action':'cancel_mochi_action');body.set('draft_id',controls.dataset.actionDraft);body.set('session_id',session.value);try{const response=await fetch(location.pathname,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'},body});const data=await response.json();if(!response.ok||!data.ok)throw new Error(data.error||'No pude completar la acción.');controls.remove();add('Mochi',data.reply,'agent',data.items||[])}catch(error){confirm&&(confirm.disabled=false);cancel&&(cancel.disabled=false);add('Mochi',error.message,'agent')}});const newChat=async()=>{const body=new FormData();body.set('action','new_mochi_chat');const response=await fetch(location.pathname,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest'},body});const data=await response.json();if(data.ok)location.href='?session='+data.session.id+'#conversation'};document.getElementById('new-chat')?.addEventListener('click',newChat);document.getElementById('new-chat-history')?.addEventListener('click',newChat)})();
</script>
<script>
(()=>{const form=document.getElementById('mochi-chat-form'),input=form?.elements.message,fileInput=document.getElementById('mochi-screenshot'),attachment=document.getElementById('mochi-attachment'),previews=attachment?.querySelector('.mochi-attachment-previews'),count=document.getElementById('mochi-attachment-count');if(!form||!input||!fileInput||!attachment||!previews||!count)return;let files=[],previewUrls=[];const sync=()=>{const transfer=new DataTransfer();files.forEach(file=>transfer.items.add(file));fileInput.files=transfer.files;previewUrls.forEach(URL.revokeObjectURL);previewUrls=[];previews.replaceChildren();files.forEach(file=>{const img=document.createElement('img');const url=URL.createObjectURL(file);previewUrls.push(url);img.src=url;img.alt='Vista previa de '+file.name;previews.append(img)});count.textContent=files.length+(files.length===1?' captura':' capturas');attachment.classList.toggle('visible',files.length>0)};const clear=()=>{files=[];sync()};const showError=text=>{const chat=document.getElementById('mochi-chat'),row=document.createElement('div');row.className='mochi-message agent';row.textContent='Mochi: '+text;chat?.append(row);if(chat)chat.scrollTop=chat.scrollHeight};const addFiles=incoming=>{for(const file of incoming){if(!['image/jpeg','image/png','image/webp'].includes(file.type)){showError('Las capturas deben ser JPG, PNG o WebP.');continue}if(file.size>8*1024*1024){showError(file.name+' pesa más de 8 MB.');continue}if(files.length>=5){showError('Puedes adjuntar hasta 5 capturas por mensaje.');break}files.push(file)}sync();if(files.length&&!input.value.trim())input.value='Crea un estimate usando estas capturas.'};document.getElementById('mochi-attach')?.addEventListener('click',()=>fileInput.click());document.getElementById('mochi-remove-attachment')?.addEventListener('click',clear);fileInput.addEventListener('change',()=>{const selected=[...fileInput.files];files=[];addFiles(selected)});input.addEventListener('paste',event=>{const pasted=[...event.clipboardData.items].filter(item=>item.type.startsWith('image/')).map(item=>item.getAsFile()).filter(Boolean);if(pasted.length){event.preventDefault();addFiles(pasted)}});form.addEventListener('submit',()=>{if(files.length)setTimeout(clear,0)});})();
(()=>{const form=document.getElementById('mochi-chat-form'),input=form?.elements.message,avatar=document.querySelector('.mochi-avatar'),workflow=document.getElementById('mochi-workflow'),workflowLabel=document.getElementById('mochi-workflow-label'),sendButton=document.getElementById('send-estimate-workflow'),anotherButton=document.getElementById('another-estimate-workflow');if(!form||!input)return;const progress=['Un segundito 😊 Estoy organizando la información…','Revisando los datos actuales…','Consultando servicios, categorías y precios…','Preparando el borrador…','Generando el recurso solicitado…'];let timer=null,step=0;const observer=new MutationObserver(()=>{const thinking=document.querySelector('.mochi-message.thinking');if(thinking&&!timer){avatar?.classList.add('thinking');step=0;thinking.childNodes[thinking.childNodes.length-1].textContent=progress[0];timer=setInterval(()=>{const active=document.querySelector('.mochi-message.thinking');if(!active){clearInterval(timer);timer=null;avatar?.classList.remove('thinking');return}active.childNodes[active.childNodes.length-1].textContent=progress[Math.min(++step,progress.length-1)]},2200)}});observer.observe(document.getElementById('mochi-chat'),{childList:true,subtree:true});const originalFetch=window.fetch.bind(window);window.fetch=async(...args)=>{const response=await originalFetch(...args);try{const data=await response.clone().json();if(data?.estimate_workflow||data?.service_workflow||data?.copy_url)window.dispatchEvent(new CustomEvent('mochi:workflow',{detail:data}))}catch(_error){}return response};window.addEventListener('mochi:workflow',event=>{const data=event.detail,wf=data.estimate_workflow,sw=data.service_workflow;if(sw&&workflow&&workflowLabel){workflow.hidden=false;workflow.dataset.workflowType='service';workflowLabel.textContent='Configurando servicio'+(sw.current_service_id?' #'+sw.current_service_id:'');if(sendButton)sendButton.hidden=true;if(anotherButton)anotherButton.hidden=true}else if(wf&&workflow&&workflowLabel){workflow.hidden=false;workflow.dataset.workflowType='estimate';workflowLabel.textContent=(wf.mode==='MODIFY'?'Modificando Estimate':'Creando Estimate')+(wf.current_estimate_id?' #'+wf.current_estimate_id:'');if(sendButton)sendButton.hidden=!wf.current_estimate_id;if(anotherButton)anotherButton.hidden=!wf.current_estimate_id}if(data.copy_url){setTimeout(()=>{const messages=document.querySelectorAll('.mochi-message.agent'),row=messages[messages.length-1];if(!row||row.querySelector('.mochi-copy'))return;const button=document.createElement('button');button.type='button';button.className='btn btn-sm btn-outline-dark mochi-copy';button.textContent='Copiar enlace de pago';button.addEventListener('click',async()=>{await navigator.clipboard.writeText(data.copy_url);button.textContent='Enlace copiado ✓'});row.append(button)},0)}});const submitMessage=message=>{input.value=message;form.requestSubmit()};document.getElementById('cancel-estimate-workflow')?.addEventListener('click',()=>{const service=workflow?.dataset.workflowType==='service';if(confirm(service?'¿Cancelar este borrador de servicio?':'¿Cancelar este borrador de estimate?'))submitMessage(service?'Cancelar servicio':'Cancelar estimate')});sendButton?.addEventListener('click',()=>{if(confirm('¿Enviar este estimate al email del cliente?'))submitMessage('Enviar estimate al cliente')});anotherButton?.addEventListener('click',()=>submitMessage('Crear otro estimate'));const SpeechRecognition=window.SpeechRecognition||window.webkitSpeechRecognition,voice=document.getElementById('mochi-voice');if(voice&&SpeechRecognition){const recognition=new SpeechRecognition();recognition.lang='es-US';recognition.interimResults=false;recognition.onstart=()=>{voice.classList.add('btn-danger');voice.title='Escuchando…'};recognition.onend=()=>{voice.classList.remove('btn-danger');voice.title='Dictar'};recognition.onresult=e=>{input.value=(input.value+' '+e.results[0][0].transcript).trim();input.dispatchEvent(new Event('input'))};voice.addEventListener('click',()=>recognition.start())}else if(voice){voice.disabled=true;voice.title='El dictado no está disponible en este navegador'}})();
</script>
<script>
(()=>{document.getElementById('mochi-chat')?.addEventListener('click',async event=>{const card=event.target.closest('.mochi-item');if(!card||!card.querySelector('strong')?.textContent.toLowerCase().includes('copiar enlace'))return;event.preventDefault();const label=card.querySelector('strong');label.textContent='Enlace copiado ✓';try{await navigator.clipboard.writeText(card.href)}catch(_error){const field=document.createElement('textarea');field.value=card.href;field.style.position='fixed';field.style.opacity='0';document.body.append(field);field.select();document.execCommand('copy');field.remove()}})})();
</script>
{% endblock %}
