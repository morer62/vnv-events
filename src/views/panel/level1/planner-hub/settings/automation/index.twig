{% extends 'templates/base.admin.twig' %}
{% block body %}
<style>
.auto-hero{background:linear-gradient(135deg,#10191d,#173631);color:#fff;border-radius:28px;padding:26px 30px;box-shadow:0 18px 42px rgba(8,26,24,.18)}.auto-hero h1{color:#fff}.auto-kicker{color:#55ead1;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.auto-card{background:#fff;border:1px solid #e4eceb;border-radius:22px;padding:22px;box-shadow:0 10px 28px rgba(22,47,44,.08)}.mochi-shell{display:grid;grid-template-columns:minmax(0,1fr) 260px;gap:18px}.mochi-avatar{width:62px;height:auto;aspect-ratio:3/5;background:url('{{ asset_for('assets/images/automation/vnv-frog-concierge-sprite.png') }}') 28.57% center/800% auto no-repeat}.mochi-chat{height:min(48vh,430px);min-height:290px;overflow-y:auto;background:#f8fbfa;scrollbar-gutter:stable;padding:14px}.mochi-message{padding:11px 13px;border-radius:15px;margin-bottom:10px;background:#fff;border:1px solid #e5eeeb;white-space:pre-wrap}.mochi-message.agent{background:#effbf7;border-color:#cfe9df}.mochi-message.thinking{color:#527069;font-style:italic}.mochi-items{display:grid;gap:8px;margin-top:10px}.mochi-item{display:block;text-decoration:none;color:#122521;border:1px solid #d5e7e1;background:#fff;border-radius:12px;padding:10px}.mochi-item:hover{border-color:#45cdb5;color:#122521}.mochi-item small{display:block;color:#60756f}.suggestions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:12px 0}.suggestion{border:1px solid #d7e8e3;background:#f4fbf8;border-radius:15px;padding:12px;text-align:left;font-weight:700}.suggestion small{display:block;font-weight:400;color:#557069;margin-top:3px}.mochi-composer{position:sticky;bottom:0;background:#fff;padding-top:12px;z-index:2}.mochi-composer textarea{min-height:76px;max-height:150px;resize:none;overflow-y:auto}.mochi-history{max-height:430px;overflow:auto}.history-link{display:block;padding:10px;border-radius:12px;text-decoration:none;color:#20332f}.history-link.active,.history-link:hover{background:#eef8f5}.review-list{max-height:560px;overflow-y:auto}.review-item{background:#fcfdfd;border:1px solid #e3ece9}.task-count{background:#173631;color:#fff;border-radius:999px;padding:6px 12px;font-weight:700;font-size:.85rem}@media(max-width:767px){.auto-hero{padding:22px}.mochi-shell{grid-template-columns:1fr}.mochi-history-panel{order:-1}.mochi-history{max-height:150px}.mochi-chat{height:42vh;min-height:250px}.suggestions{grid-template-columns:1fr}.mochi-composer textarea{min-height:58px;max-height:120px;padding-bottom:env(safe-area-inset-bottom)}}
</style>
<div class="auto-hero mb-4"><span class="auto-kicker">Operaciones VNV</span><h1 class="mt-2 mb-2">Tu conversación con Mochi</h1><p class="mb-0">Datos reales, respuestas claras y una conversación nueva cada día.</p></div>
{% if schemaError %}<div class="alert alert-warning"><strong>Hace falta actualizar la base de datos.</strong> {{ schemaError }}</div>{% else %}
<section class="auto-card mb-4" id="conversation">
 <div class="d-flex align-items-center justify-content-between gap-3 mb-3"><div class="d-flex align-items-center gap-3"><div class="mochi-avatar" role="img" aria-label="Mochi"></div><div><h2 class="h4 mb-1">Habla con Mochi</h2><p class="text-muted mb-0">{{ mochi.session.title }} · {{ mochi.session.session_date }}</p></div></div><button class="btn btn-outline-dark btn-sm" id="new-chat" type="button">Nueva conversación</button></div>
 <div class="mochi-shell"><div>
  <div class="mochi-chat border rounded-4" id="mochi-chat" aria-live="polite">
   {% for chat in mochi.messages %}<div class="mochi-message {{ chat.author_type == 'AGENT' ? 'agent' : 'human' }}"><strong>{{ chat.author_type == 'AGENT' ? 'Mochi' : 'Tú' }}:</strong> {{ chat.message }}{% if chat.author_type == 'AGENT' and chat.metadata_json %}{% set meta=chat.metadata_json|json_decode %}{% if meta.action_draft %}<div class="mt-2 d-flex gap-2" data-action-draft="{{ meta.action_draft.id }}"><button class="btn btn-sm btn-success mochi-confirm-action" type="button">Confirmar acción</button><button class="btn btn-sm btn-outline-secondary mochi-cancel-action" type="button">Cancelar</button></div>{% endif %}{% if meta.items %}<div class="mochi-items">{% for item in meta.items %}<a class="mochi-item" href="{{ item.url starts with '/vnv-gourmet-express/product/' ? '/vnv-gourmet-express' : item.url }}"><strong>{{ item.title }}</strong><small>{{ item.meta }}</small><small>{{ item.detail }}</small>{% if item.flag %}<span class="badge bg-warning text-dark mt-1">{{ item.flag }}</span>{% endif %}</a>{% endfor %}</div>{% endif %}{% endif %}</div>{% endfor %}
   {% if mochi.messages is empty %}<div id="mochi-empty"><p class="text-muted mb-2">¡Hola! ¿Qué revisamos hoy?</p><div class="suggestions">{% for suggestion in mochi.suggestions %}<button class="suggestion" type="button" data-prompt="{{ suggestion.prompt }}">{{ suggestion.title }}<small>{{ suggestion.prompt }}</small></button>{% endfor %}</div></div>{% endif %}
  </div>
  <form method="post" class="mochi-composer d-flex gap-2" id="mochi-chat-form"><input type="hidden" name="action" value="ask_mochi"><input type="hidden" name="session_id" value="{{ mochi.session.id }}"><textarea class="form-control" name="message" maxlength="3000" required placeholder="Escribe tu pregunta sobre VNV Events…"></textarea><button class="btn btn-dark px-4 align-self-end" type="submit">Enviar</button></form>
 </div><aside class="mochi-history-panel"><h3 class="h6">Historial</h3><div class="mochi-history">{% for session in mochi.history %}<a class="history-link {{ session.id == mochi.session.id ? 'active' }}" href="?session={{ session.id }}"><strong>{{ session.title }}</strong><small class="d-block text-muted">{{ session.session_date }} · {{ session.message_count }} mensajes</small></a>{% endfor %}</div></aside></div>
</section>
{% if isReviewer %}<section class="auto-card mb-4" id="recommendations"><div class="d-flex justify-content-between align-items-start gap-3 mb-3"><div><h2 class="h4 mb-1">Tareas por revisar</h2><p class="text-muted mb-0">Nada se envía sin aprobación humana.</p></div><span class="task-count">{{ recommendations|length }} pendientes</span></div><div class="review-list">{% for item in recommendations %}<form method="post" class="review-item rounded-4 p-3 mb-3"><input type="hidden" name="action" value="review"><input type="hidden" name="dedupe_key" value="{{ item.dedupe_key }}"><strong>{{ item.name }} {{ item.lastname }}</strong><p class="small mt-2">{{ item.body|striptags }}</p><textarea class="form-control mb-2" name="comment" rows="2" placeholder="Contexto para Mochi"></textarea><button class="btn btn-success" name="decision" value="APPROVE">Aprobar</button> <button class="btn btn-outline-danger" name="decision" value="REJECT">Descartar</button></form>{% else %}<p class="text-muted">Todo está revisado.</p>{% endfor %}</div></section>{% endif %}
{% endif %}
<script>
(()=>{const form=document.getElementById('mochi-chat-form'),chat=document.getElementById('mochi-chat');if(!form||!chat)return;const input=form.elements.message,button=form.querySelector('button[type="submit"]'),session=form.elements.session_id;const resize=()=>{input.style.height='auto';input.style.height=Math.min(input.scrollHeight,parseInt(getComputedStyle(input).maxHeight)||150)+'px'};input.addEventListener('input',resize);const add=(who,text,kind='',items=[])=>{document.getElementById('mochi-empty')?.remove();const row=document.createElement('div');row.className='mochi-message '+kind;const strong=document.createElement('strong');strong.textContent=who+': ';row.append(strong,document.createTextNode(text));if(items.length){const box=document.createElement('div');box.className='mochi-items';items.forEach(item=>{const a=document.createElement('a');a.className='mochi-item';a.href=(item.url||'#').startsWith('/vnv-gourmet-express/product/')?'/vnv-gourmet-express':(item.url||'#');const title=document.createElement('strong');title.textContent=item.title||'';const meta=document.createElement('small');meta.textContent=item.meta||'';const detail=document.createElement('small');detail.textContent=item.detail||'';a.append(title,meta,detail);if(item.flag){const flag=document.createElement('span');flag.className='badge bg-warning text-dark mt-1';flag.textContent=item.flag;a.append(flag)}box.append(a)});row.append(box)}chat.append(row);chat.scrollTop=chat.scrollHeight;return row};chat.scrollTop=chat.scrollHeight;document.querySelectorAll('[data-prompt]').forEach(el=>el.addEventListener('click',()=>{input.value=el.dataset.prompt;resize();form.requestSubmit()}));form.addEventListener('submit',async e=>{e.preventDefault();const message=input.value.trim();if(!message||button.disabled)return;const payload=new FormData(form);add('Tú',message,'human');input.value='';resize();button.disabled=true;const thinking=add('Mochi','Estoy consultando VNV…','agent thinking');try{const response=await fetch(location.pathname,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'},body:payload,credentials:'same-origin'});const data=await response.json();thinking.remove();if(!response.ok||!data.ok)throw new Error(data.error||'No pude responder.');session.value=data.session_id;const row=add('Mochi',data.reply,'agent',data.items||[]);if(data.action_draft){const controls=document.createElement('div');controls.className='mt-2 d-flex gap-2';controls.dataset.actionDraft=data.action_draft.id;controls.innerHTML='<button class="btn btn-sm btn-success mochi-confirm-action" type="button">Confirmar acción</button><button class="btn btn-sm btn-outline-secondary mochi-cancel-action" type="button">Cancelar</button>';row.append(controls)}}catch(error){thinking.remove();add('Mochi',error.message||'No pude recuperar esos datos ahora mismo.','agent');input.value=message;resize()}finally{button.disabled=false;input.focus()}});chat.addEventListener('click',async e=>{const confirm=e.target.closest('.mochi-confirm-action'),cancel=e.target.closest('.mochi-cancel-action');if(!confirm&&!cancel)return;const controls=e.target.closest('[data-action-draft]');confirm&&(confirm.disabled=true);cancel&&(cancel.disabled=true);const body=new FormData();body.set('action',confirm?'confirm_mochi_action':'cancel_mochi_action');body.set('draft_id',controls.dataset.actionDraft);body.set('session_id',session.value);try{const response=await fetch(location.pathname,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'},body});const data=await response.json();if(!response.ok||!data.ok)throw new Error(data.error||'No pude completar la acción.');controls.remove();add('Mochi',data.reply,'agent',data.items||[])}catch(error){confirm&&(confirm.disabled=false);cancel&&(cancel.disabled=false);add('Mochi',error.message,'agent')}});document.getElementById('new-chat')?.addEventListener('click',async()=>{const body=new FormData();body.set('action','new_mochi_chat');const response=await fetch(location.pathname,{method:'POST',headers:{'X-Requested-With':'XMLHttpRequest'},body});const data=await response.json();if(data.ok)location.href='?session='+data.session.id});})();
</script>
{% endblock %}
