{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<main class="mt-4 container vnv-panel">
  {{ macros.breadcrumb2() }}

  <div class="vnv-page-header">
    <div>
      <p class="vnv-kicker">Operations</p>
      <h1>VNV Events Operations</h1>
      <p>Manage event orders, team work, payments, CRM, inventory and daily execution from one place.</p>
    </div>
  </div>

  {% if user.level in [1, 2, 3] %}
    <div class="alert alert-success text-center mb-4" role="alert">
      <a href="{{ path('panel/planner-hub/institution-profile') }}" class="fw-bold text-decoration-none">Edit your VNV Events business profile</a>
    </div>

    {% if isWeb %}
      <div class="alert alert-primary text-center mb-5" role="alert">
        <a href="{{ path('panel/planner-hub/management/payments/') }}" class="fw-bold text-decoration-none">Verify Stripe to receive credit card payments</a>
      </div>
    {% endif %}
  {% elseif user.level == 4 %}
    {% if isWeb %}
      <div class="alert alert-primary text-center mb-5" role="alert">
        <a href="{{ path('panel/planner-hub/team/payments') }}" class="fw-bold text-decoration-none">Verify Stripe to receive credit card payments</a>
      </div>
    {% endif %}
  {% endif %}

  <section class="vnv-grid vnv-grid-2">
    <div class="vnv-card text-center">
      <img src="{{ asset_for('assets/images/icons_website/icon_1.png') }}" alt="Team Area" class="mb-4" style="height: 110px;">
      <h2 class="h4 fw-bold mb-2">Team Area</h2>
      <p class="text-muted fs-6 mb-3">Track time, payroll, assignments and upcoming events.</p>
      <a href="{{ path('panel/planner-hub/team') }}" class="vnv-btn vnv-btn-primary">Access</a>
    </div>

    <div class="vnv-card text-center">
      <img src="{{ asset_for('assets/images/icons_website/icon_2.png') }}" alt="Management Area" class="mb-4" style="height: 110px;">
      <h2 class="h4 fw-bold mb-2">Management Area</h2>
      <p class="text-muted fs-6 mb-3">Create orders, assign team members, manage CRM and review operations.</p>
      <a href="{{ path('panel/planner-hub/management') }}" class="vnv-btn vnv-btn-secondary">Access</a>
    </div>
  </section>
</main>
{% endblock %}
