{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block style %}
    <style>
        .dropdown-menu {
            position: absolute !important;
            z-index: 1050 !important; /* Ensure dropdown appears above */
        }
        .table-responsive {
            position: relative;
        }
    </style>
{% endblock %}
{% block body %}

<main>

    <h1 class="h3 mb-3">Venues</h1>

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('panel/home') }}">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Venues</li>
        </ol>
    </nav>

    <section class="card">
        <div class="card-body">

            <div class="d-flex mb-3">
                {% for status in statuses %}
                    <a href="{{ path('panel/venues?status=' ~ status) }}"
                       class="btn btn-outline-primary {% if status == statusPage %}active{% endif %}"
                       style="margin-right: 1rem;">
                        {{ status | upper }}
                    </a>
                {% endfor %}
            </div>

            <div>
                <table class="table table-striped table-bordered text-center">
                    <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Address</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>More & Actions</th>
                    </tr>
                    </thead>

                    <tbody>
                    {% for venue in venues %}
                        <tr>
                            <td>{{ venue.id }}</td>
                            <td>{{ venue.name }}</td>
                            <td>{{ venue.address }}</td>
                            <td>
                                {{
                                    categories
                                    | filter(c => c.id == venue.category_id)
                                    | first.name
                                }}
                            </td>

                            <td>{{ venue.status }}</td>

                            <td class="position-relative">
                                <div class="dropdown">
                                    <button class="btn btn-secondary" type="button" data-bs-toggle="dropdown"
                                            aria-expanded="false" data-bs-display="static">
                                        More {{ macros.icon('more-horizontal') }}
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                         

                                        <li class="btn btn-link">
                                            <a href="{{ path('panel/venues/edit?id=' ~ venue.id) }}">Details</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               href="{{ path('panel/venue-events/home?id=' ~ venue.id) }}">View Events</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               href="{{ path('panel/venue-promotions/home?id=' ~ venue.id) }}">View Promotions</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                               href="{{ path('panel/venue-photos/home?id=' ~ venue.id) }}">View Photos</a>
                                        </li>

                                        {% for status in statuses %}
                                            {% if status != venue.status %}
                                                <li>
                                                    <form method="post">
                                                        {{ macros.csrf() }}

                                                        <input type="hidden" name="id" value="{{ venue.id }}"/>
                                                        <input type="hidden" name="status" value="{{ status }}"/>
                                                        <button type="submit" class="btn btn-link">
                                                            Set to {{ status | lower }}
                                                        </button>
                                                    </form>
                                                </li>
                                            {% endif %}
                                        {% endfor %}
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

        </div>
    </section>

</main>
{% endblock %}
