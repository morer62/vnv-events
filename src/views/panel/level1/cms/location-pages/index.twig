{% extends 'templates/base.admin.twig' %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Location Pages</h1>
            <p class="text-muted mb-0">Manage dynamic city/location pages for the public website.</p>
        </div>
        <a href="{{ path('panel/cms/location-pages/create') }}" class="btn btn-dark">
            + Create New Page
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            {% if pages is empty %}
                <div class="p-4 text-center text-muted">
                    No location pages found yet.
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Title</th>
                                <th>Slug</th>
                                <th>City</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Published</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for p in pages %}
                                <tr>
                                    <td>{{ p.id }}</td>
                                    <td>
                                        <strong>{{ p.title }}</strong>
                                        {% if p.primary_keyword %}
                                            <div class="small text-muted">{{ p.primary_keyword }}</div>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <code>/locations/{{ p.slug }}</code>
                                    </td>
                                    <td>{{ p.city ?: '-' }}</td>
                                    <td>{{ p.category ?: '-' }}</td>
                                    <td>
                                        {% if p.status == 'PUBLISHED' %}
                                            <span class="badge bg-success">Published</span>
                                        {% else %}
                                            <span class="badge bg-secondary">Draft</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ p.published_at ?: '-' }}</td>
                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2 flex-wrap">
                                            <a href="{{ path('locations/' ~ p.slug) }}" target="_blank" class="btn btn-sm btn-outline-dark">
                                                View
                                            </a>

                                            <a href="{{ path('panel/cms/location-pages/edit') }}?id={{ p.id }}" class="btn btn-sm btn-primary">
                                                Edit
                                            </a>

                                            <form method="post" class="d-inline" onsubmit="return confirm('Duplicate this location page?');">
                                                <input type="hidden" name="id" value="{{ p.id }}">
                                                <input type="hidden" name="action" value="duplicate">
                                                <button type="submit" class="btn btn-sm btn-info">
                                                    Duplicate
                                                </button>
                                            </form>

                                            {% if p.status == 'PUBLISHED' %}
                                                <form method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="{{ p.id }}">
                                                    <input type="hidden" name="action" value="draft">
                                                    <button type="submit" class="btn btn-sm btn-warning">
                                                        Draft
                                                    </button>
                                                </form>
                                            {% else %}
                                                <form method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="{{ p.id }}">
                                                    <input type="hidden" name="action" value="publish">
                                                    <button type="submit" class="btn btn-sm btn-success">
                                                        Publish
                                                    </button>
                                                </form>
                                            {% endif %}

                                            <form method="post" class="d-inline" onsubmit="return confirm('Delete this location page?');">
                                                <input type="hidden" name="id" value="{{ p.id }}">
                                                <input type="hidden" name="action" value="delete">
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
