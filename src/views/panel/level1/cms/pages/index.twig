{% extends "templates/base.admin.twig" %}

{% block body %}
<style>
    .cms-wrap{
        padding:24px;
    }

    .cms-header{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:16px;
        margin-bottom:24px;
        flex-wrap:wrap;
    }

    .cms-title{
        font-size:2rem;
        font-weight:800;
        color:#111827;
        margin:0 0 6px 0;
    }

    .cms-subtitle{
        color:#6b7280;
        font-size:.96rem;
        margin:0;
    }

    .cms-btn{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        padding:10px 16px;
        border-radius:12px;
        text-decoration:none;
        font-weight:700;
        font-size:.92rem;
        transition:.2s ease;
        border:none;
        cursor:pointer;
    }

    .cms-btn-primary{
        background:#111827;
        color:#fff;
    }

    .cms-btn-primary:hover{
        background:#000;
        color:#fff;
    }

    .cms-btn-light{
        background:#f3f4f6;
        color:#111827;
    }

    .cms-btn-light:hover{
        background:#e5e7eb;
        color:#111827;
    }

    .cms-card{
        background:#fff;
        border:1px solid #e5e7eb;
        border-radius:20px;
        padding:20px;
        box-shadow:0 10px 30px rgba(0,0,0,.05);
    }

    .cms-table-wrap{
        width:100%;
        overflow:auto;
    }

    .cms-table{
        width:100%;
        border-collapse:collapse;
        min-width:1180px;
    }

    .cms-table th{
        text-align:left;
        font-size:.85rem;
        color:#6b7280;
        font-weight:700;
        padding:14px 12px;
        border-bottom:1px solid #e5e7eb;
        white-space:nowrap;
    }

    .cms-table td{
        padding:16px 12px;
        border-bottom:1px solid #f1f5f9;
        vertical-align:top;
        color:#111827;
        font-size:.95rem;
    }

    .cms-table tr:last-child td{
        border-bottom:none;
    }

    .cms-slug{
        font-family:monospace;
        font-size:.92rem;
        color:#374151;
        background:#f9fafb;
        border:1px solid #e5e7eb;
        border-radius:10px;
        display:inline-block;
        padding:4px 8px;
    }

    .cms-path{
        font-family:monospace;
        font-size:.88rem;
        color:#1f2937;
        background:#f9fafb;
        border:1px solid #e5e7eb;
        border-radius:10px;
        display:inline-block;
        padding:5px 8px;
        word-break:break-all;
    }

    .cms-badge{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        padding:6px 10px;
        border-radius:999px;
        font-size:.8rem;
        font-weight:700;
        white-space:nowrap;
    }

    .cms-badge.published{
        background:#ecfdf5;
        color:#047857;
    }

    .cms-badge.draft{
        background:#fff7ed;
        color:#c2410c;
    }

    .cms-badge.preview{
        background:#eff6ff;
        color:#1d4ed8;
    }

    .cms-badge.generated{
        background:#f5f3ff;
        color:#6d28d9;
    }

    .cms-badge.archived{
        background:#f3f4f6;
        color:#4b5563;
    }

    .cms-muted{
        color:#6b7280;
    }

    .cms-actions{
        display:flex;
        gap:10px;
        flex-wrap:wrap;
    }

    .cms-empty{
        padding:28px;
        text-align:center;
        color:#6b7280;
    }

    .cms-empty strong{
        display:block;
        color:#111827;
        font-size:1.05rem;
        margin-bottom:8px;
    }

    .cms-filters{
        display:grid;
        grid-template-columns:repeat(4, minmax(160px, 1fr));
        gap:12px;
        margin-bottom:18px;
    }

    .cms-filter-field label{
        display:block;
        color:#6b7280;
        font-size:.78rem;
        font-weight:700;
        margin-bottom:6px;
        text-transform:uppercase;
    }

    .cms-filter-field input,
    .cms-filter-field select{
        width:100%;
        border:1px solid #d1d5db;
        border-radius:12px;
        padding:10px 12px;
        color:#111827;
        background:#fff;
        box-sizing:border-box;
    }

    @media (max-width:768px){
        .cms-wrap{
            padding:16px;
        }

        .cms-title{
            font-size:1.55rem;
        }

        .cms-filters{
            grid-template-columns:1fr;
        }
    }
</style>

<div class="cms-wrap">
    <div class="cms-header">
        <div>
            <h1 class="cms-title">Content</h1>
            <p class="cms-subtitle">
                Review pages, locations and blog articles from Ophyra Growth Hub in cms_contents.
            </p>
        </div>

        <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <a href="{{ path('panel/cms') }}" class="cms-btn cms-btn-light">← Back to CMS</a>
            <a href="{{ path('panel/cms/pages/create') }}" class="cms-btn cms-btn-primary">+ New Content</a>
        </div>
    </div>

    <div class="cms-card">
        <form method="GET" class="cms-filters">
            <div class="cms-filter-field">
                <label>Status</label>
                <select name="status">
                    <option value="">All</option>
                    {% for status in ['DRAFT', 'READY', 'PUBLISHED', 'ARCHIVED'] %}
                        <option value="{{ status }}" {% if filters.status == status %}selected{% endif %}>{{ status }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="cms-filter-field">
                <label>Type</label>
                <select name="content_type">
                    <option value="">All</option>
                    {% for type in contentTypes %}
                        <option value="{{ type }}" {% if filters.content_type == type %}selected{% endif %}>{{ type|replace({'_':' '})|title }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="cms-filter-field">
                <label>Search</label>
                <input type="search" name="q" value="{{ filters.q }}" placeholder="Title, slug or SEO">
            </div>

            <div class="cms-filter-field" style="align-self:end; display:flex; gap:10px;">
                <button type="submit" class="cms-btn cms-btn-primary">Filter</button>
                <a href="{{ path('panel/cms/pages') }}" class="cms-btn cms-btn-light">Reset</a>
            </div>
        </form>

        {% if pages|length > 0 %}
            <div class="cms-table-wrap">
                <table class="cms-table">
                    <thead>
                        <tr>
                            <th>Content</th>
                            <th>Type</th>
                            <th>Template</th>
                            <th>SEO Target</th>
                            <th>Status</th>
                            <th>Public URL</th>
                            <th>Activity</th>
                            <th style="width:220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in pages %}
                            <tr>
                                <td>
                                    <strong>{{ item.title }}</strong>
                                    {% if item.excerpt %}
                                        <div class="cms-muted" style="margin-top:6px;">
                                            {{ item.excerpt|slice(0, 90) }}{% if item.excerpt|length > 90 %}...{% endif %}
                                        </div>
                                    {% endif %}
                                </td>
                                <td>
                                    <strong>{{ (item.content_type ?: item.type)|replace({'_':' '})|title }}</strong><br>
                                    <span class="cms-muted">{{ item.language ?: 'en' }}</span>
                                </td>
                                <td>
                                    {% if item.template_name %}
                                        <strong>{{ item.template_name }}</strong><br>
                                        <span class="cms-muted">{{ item.template_key }}</span>
                                    {% else %}
                                        <span class="cms-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="cms-slug">{{ item.slug }}</span>
                                    {% if item.meta_title %}
                                        <div class="cms-muted" style="margin-top:6px;">
                                            {{ item.meta_title|slice(0, 80) }}{% if item.meta_title|length > 80 %}...{% endif %}
                                        </div>
                                    {% endif %}
                                </td>
                                <td>
                                    {% set statusClass = item.status|lower %}
                                    <span class="cms-badge {{ statusClass }}">{{ item.status }}</span>
                                </td>
                                <td>
                                    {% if item.main_route and item.main_route.route %}
                                        <span class="cms-path">{{ item.main_route.route }}</span>
                                    {% else %}
                                        <span class="cms-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if item.published_at %}
                                        {{ item.published_at }}
                                    {% else %}
                                        <span class="cms-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="cms-actions">
                                        <a href="{{ path('panel/cms/pages/edit') }}?id={{ item.id }}" class="cms-btn cms-btn-light">Edit</a>
                                        <a href="{{ path('panel/cms/pages/preview') }}?id={{ item.id }}" class="cms-btn cms-btn-light">Preview</a>

                                        {% if item.main_route and item.main_route.route %}
                                            <a href="{{ path(item.main_route.route|trim('/')) }}" target="_blank" class="cms-btn cms-btn-light">Open</a>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="cms-empty">
                <strong>No content found</strong>
                No Ophyra Growth Hub content matches these filters.
                <div style="margin-top:16px;">
                    <a href="{{ path('panel/cms/pages/create') }}" class="cms-btn cms-btn-primary">+ Create First Content</a>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
