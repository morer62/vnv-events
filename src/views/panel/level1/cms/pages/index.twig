{% extends "templates/base.admin.twig" %}

{% block body %}
<style>
    .cms-wrap{
        padding:24px;
    }

    .cms-header{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:16px;
        margin-bottom:24px;
        flex-wrap:wrap;
    }

    .cms-title{
        font-size:2rem;
        font-weight:800;
        color:#111827;
        margin:0 0 6px 0;
    }

    .cms-subtitle{
        color:#6b7280;
        font-size:.96rem;
        margin:0;
    }

    .cms-btn{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        padding:10px 16px;
        border-radius:12px;
        text-decoration:none;
        font-weight:700;
        font-size:.92rem;
        transition:.2s ease;
        border:none;
        cursor:pointer;
    }

    .cms-btn-primary{
        background:#111827;
        color:#fff;
    }

    .cms-btn-primary:hover{
        background:#000;
        color:#fff;
    }

    .cms-btn-light{
        background:#f3f4f6;
        color:#111827;
    }

    .cms-btn-light:hover{
        background:#e5e7eb;
        color:#111827;
    }

    .cms-card{
        background:#fff;
        border:1px solid #e5e7eb;
        border-radius:20px;
        padding:20px;
        box-shadow:0 10px 30px rgba(0,0,0,.05);
    }

    .cms-table-wrap{
        width:100%;
        overflow:auto;
    }

    .cms-table{
        width:100%;
        border-collapse:collapse;
        min-width:900px;
    }

    .cms-table th{
        text-align:left;
        font-size:.85rem;
        color:#6b7280;
        font-weight:700;
        padding:14px 12px;
        border-bottom:1px solid #e5e7eb;
        white-space:nowrap;
    }

    .cms-table td{
        padding:12px;
        border-bottom:1px solid #f1f5f9;
        vertical-align:middle;
        color:#111827;
        font-size:.95rem;
    }

    .cms-table tr:last-child td{
        border-bottom:none;
    }

    .cms-slug{
        font-family:monospace;
        font-size:.92rem;
        color:#374151;
        background:#f9fafb;
        border:1px solid #e5e7eb;
        border-radius:10px;
        display:inline-block;
        padding:4px 8px;
    }

    .cms-path{
        font-family:monospace;
        font-size:.88rem;
        color:#1f2937;
        background:#f9fafb;
        border:1px solid #e5e7eb;
        border-radius:10px;
        display:inline-block;
        padding:5px 8px;
        word-break:break-all;
    }

    .cms-badge{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        padding:6px 10px;
        border-radius:999px;
        font-size:.8rem;
        font-weight:700;
        white-space:nowrap;
    }

    .cms-badge.published{
        background:#ecfdf5;
        color:#047857;
    }

    .cms-badge.draft{
        background:#fff7ed;
        color:#c2410c;
    }

    .cms-badge.preview{
        background:#eff6ff;
        color:#1d4ed8;
    }

    .cms-badge.generated{
        background:#f5f3ff;
        color:#6d28d9;
    }

    .cms-badge.archived{
        background:#f3f4f6;
        color:#4b5563;
    }

    .cms-status-form{
        margin:0;
    }

    .cms-status-select{
        width:100%;
        min-width:120px;
        border:1px solid #d1d5db;
        border-radius:10px;
        padding:7px 9px;
        color:#111827;
        background:#fff;
        font-size:.84rem;
    }

    .cms-muted{
        color:#6b7280;
    }

    .cms-actions{
        display:flex;
        gap:8px;
        flex-wrap:nowrap;
        align-items:center;
    }

    .cms-actions form{
        margin:0;
    }

    .cms-row-check{
        width:36px;
        text-align:center;
    }

    .cms-title-cell{
        min-width:360px;
        width:48%;
    }

    .cms-title-line{
        align-items:center;
        display:flex;
        gap:10px;
        flex-wrap:wrap;
    }

    .cms-thumbnail{
        width:82px;
        height:58px;
        border-radius:10px;
        object-fit:cover;
        background:#f3f4f6;
        border:1px solid #e5e7eb;
        display:block;
    }

    .cms-thumb-empty{
        align-items:center;
        color:#9ca3af;
        display:flex;
        font-size:.72rem;
        justify-content:center;
        text-align:center;
    }

    .cms-date-cell{
        white-space:nowrap;
    }

    .cms-bulk-actions{
        align-items:center;
        display:flex;
        gap:10px;
        margin-bottom:16px;
        flex-wrap:wrap;
    }

    .cms-btn-danger{
        background:#fee2e2;
        color:#b91c1c;
    }

    .cms-btn-danger:hover{
        background:#fecaca;
        color:#991b1b;
    }

    .cms-empty{
        padding:28px;
        text-align:center;
        color:#6b7280;
    }

    .cms-empty strong{
        display:block;
        color:#111827;
        font-size:1.05rem;
        margin-bottom:8px;
    }

    .cms-filters{
        display:grid;
        grid-template-columns:180px 220px minmax(220px, 1fr) auto;
        gap:12px;
        margin-bottom:18px;
    }

    .cms-tabs{
        display:flex;
        flex-wrap:wrap;
        gap:10px;
        margin-bottom:18px;
    }

    .cms-tab{
        align-items:center;
        background:#f3f4f6;
        border-radius:999px;
        color:#374151;
        display:inline-flex;
        gap:8px;
        padding:10px 14px;
        text-decoration:none;
        font-weight:800;
    }

    .cms-tab:hover{
        color:#111827;
        background:#e5e7eb;
    }

    .cms-tab.active{
        background:#111827;
        color:#fff;
    }

    .cms-tab-count{
        background:rgba(255,255,255,.85);
        border-radius:999px;
        color:#111827;
        min-width:24px;
        padding:2px 8px;
        text-align:center;
    }

    .cms-filter-field label{
        display:block;
        color:#6b7280;
        font-size:.78rem;
        font-weight:700;
        margin-bottom:6px;
        text-transform:uppercase;
    }

    .cms-filter-field input,
    .cms-filter-field select{
        width:100%;
        border:1px solid #d1d5db;
        border-radius:12px;
        padding:10px 12px;
        color:#111827;
        background:#fff;
        box-sizing:border-box;
    }

    @media (max-width:768px){
        .cms-wrap{
            padding:16px;
        }

        .cms-title{
            font-size:1.55rem;
        }

        .cms-filters{
            grid-template-columns:1fr;
        }

        .cms-table{
            min-width:760px;
        }

        .cms-title-cell{
            min-width:260px;
        }

        .cms-btn{
            padding:9px 12px;
        }
    }
</style>

<div class="cms-wrap">
    <div class="cms-header">
        <div>
            <h1 class="cms-title">Content</h1>
            <p class="cms-subtitle">
                Review pages, locations and blog articles from Ophyra Growth Hub in cms_contents.
            </p>
        </div>

        <div style="display:flex; gap:10px; flex-wrap:wrap;">
            <a href="{{ path('panel/cms') }}" class="cms-btn cms-btn-light">Back to CMS</a>
            <a href="{{ path('panel/cms/pages/create') }}" class="cms-btn cms-btn-primary">+ New Content</a>
        </div>
    </div>

    <div class="cms-card">
        <div class="cms-tabs">
            {% for type in contentTypes %}
                <a class="cms-tab {% if filters.content_type == type %}active{% endif %}" href="{{ path('panel/cms/pages') }}?content_type={{ type }}{% if filters.status %}&status={{ filters.status }}{% endif %}{% if filters.q %}&q={{ filters.q|url_encode }}{% endif %}">
                    {{ type == 'blog' ? 'Blog Articles' : (type == 'location' ? 'Locations' : 'Pages') }}
                    <span class="cms-tab-count">{{ typeCounts[type]|default(0) }}</span>
                </a>
            {% endfor %}
        </div>

        <form method="GET" class="cms-filters">
            <input type="hidden" name="content_type" value="{{ filters.content_type }}">
            <div class="cms-filter-field">
                <label>Status</label>
                <select name="status">
                    <option value="">All</option>
                    {% for status in ['DRAFT', 'PREVIEW', 'GENERATED', 'READY', 'PUBLISHED', 'ARCHIVED'] %}
                        <option value="{{ status }}" {% if filters.status == status %}selected{% endif %}>{{ status }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="cms-filter-field">
                <label>Category</label>
                <select name="category_id">
                    <option value="0">All {{ filters.content_type == 'blog' ? 'blog categories' : (filters.content_type == 'location' ? 'location categories' : 'page categories') }}</option>
                    {% for category in activeCategories %}
                        <option value="{{ category.id }}" {% if filters.category_id == category.id %}selected{% endif %}>
                            {{ category.name }}{% if categoryCounts[category.id]|default(0) > 0 %} ({{ categoryCounts[category.id] }}){% endif %}
                        </option>
                    {% endfor %}
                    {% if categoryCounts[0]|default(0) > 0 %}
                        <option value="-1" disabled>No category ({{ categoryCounts[0] }})</option>
                    {% endif %}
                </select>
            </div>

            <div class="cms-filter-field">
                <label>Search</label>
                <input type="search" name="q" value="{{ filters.q }}" placeholder="Title, slug or SEO">
            </div>

            <div class="cms-filter-field" style="align-self:end; display:flex; gap:10px;">
                <button type="submit" class="cms-btn cms-btn-primary">Filter</button>
                <a href="{{ path('panel/cms/pages') }}?content_type={{ filters.content_type }}" class="cms-btn cms-btn-light">Reset</a>
            </div>
        </form>

        {% if pages|length > 0 %}
            {% if generatedCount > 0 %}
                <form method="POST" class="cms-actions" style="margin-bottom:16px;">
                    <input type="hidden" name="action" value="publish_generated">
                    <button type="submit" class="cms-btn cms-btn-primary">Publish all generated ({{ generatedCount }})</button>
                    <a href="{{ path('panel/cms/pages/create') }}" class="cms-btn cms-btn-light">Keep generating</a>
                </form>
            {% endif %}
            <form method="POST" id="cms-bulk-form">
                <input type="hidden" name="redirect" value="panel/cms/pages?content_type={{ filters.content_type }}{% if filters.category_id %}&category_id={{ filters.category_id }}{% endif %}{% if filters.status %}&status={{ filters.status }}{% endif %}{% if filters.q %}&q={{ filters.q|url_encode }}{% endif %}">
            </form>
            <div class="cms-bulk-actions">
                <button type="submit" form="cms-bulk-form" name="action" value="bulk_generate_thumbnails" class="cms-btn cms-btn-light" onclick="return confirm('Generate missing thumbnails for up to 3 selected items?');">Generate missing thumbnails</button>
                <button type="submit" form="cms-bulk-form" name="action" value="bulk_draft" class="cms-btn cms-btn-light">Move selected to Draft</button>
                <button type="submit" form="cms-bulk-form" name="action" value="bulk_delete" class="cms-btn cms-btn-danger" onclick="return confirm('Delete selected content? This cannot be undone.');">Delete selected</button>
                <span class="cms-muted">Select rows to run batch actions.</span>
            </div>
            <div class="cms-table-wrap">
                <table class="cms-table">
                    <thead>
                        <tr>
                            <th class="cms-row-check"><input type="checkbox" data-select-all></th>
                            <th>Title</th>
                            <th>Thumbnail</th>
                            <th>Published</th>
                            <th style="width:360px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in pages %}
                            <tr>
                                <td class="cms-row-check">
                                    <input type="checkbox" name="ids[]" value="{{ item.id }}" form="cms-bulk-form" data-row-check>
                                </td>
                                <td class="cms-title-cell">
                                    <div class="cms-title-line">
                                        <strong>{{ item.title }}</strong>
                                        {% set statusClass = item.status|lower %}
                                        <span class="cms-badge {{ statusClass }}">{{ item.status }}</span>
                                    </div>
                                </td>
                                <td>
                                    {% if item.featured_image_url %}
                                        <img class="cms-thumbnail" src="{{ item.featured_image_url }}" alt="{{ item.title }}">
                                    {% else %}
                                        <div class="cms-thumbnail cms-thumb-empty">No image</div>
                                    {% endif %}
                                </td>
                                <td class="cms-date-cell">
                                    {% if item.published_at %}
                                        {{ item.published_at }}
                                    {% else %}
                                        <span class="cms-muted">Not published</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="cms-actions">
                                        <form method="POST" class="cms-status-form">
                                            <input type="hidden" name="action" value="update_status">
                                            <input type="hidden" name="id" value="{{ item.id }}">
                                            <input type="hidden" name="redirect" value="panel/cms/pages?content_type={{ filters.content_type }}{% if filters.category_id %}&category_id={{ filters.category_id }}{% endif %}{% if filters.status %}&status={{ filters.status }}{% endif %}{% if filters.q %}&q={{ filters.q|url_encode }}{% endif %}">
                                            <select name="status" class="cms-status-select" onchange="this.form.submit()">
                                                {% if item.status not in ['DRAFT', 'PUBLISHED'] %}
                                                    <option value="{{ item.status }}" selected disabled>{{ item.status }}</option>
                                                {% endif %}
                                                <option value="DRAFT" {% if item.status == 'DRAFT' %}selected{% endif %}>Draft</option>
                                                <option value="PUBLISHED" {% if item.status == 'PUBLISHED' %}selected{% endif %}>Published</option>
                                            </select>
                                        </form>
                                        <a href="{{ path('panel/cms/pages/edit') }}?id={{ item.id }}" class="cms-btn cms-btn-light">Edit</a>
                                        <a href="{{ path('panel/cms/pages/preview') }}?id={{ item.id }}" class="cms-btn cms-btn-light">View</a>
                                        <form method="POST" onsubmit="return confirm('Delete this content? This cannot be undone.');">
                                            <input type="hidden" name="action" value="delete_one">
                                            <input type="hidden" name="id" value="{{ item.id }}">
                                            <input type="hidden" name="redirect" value="panel/cms/pages?content_type={{ filters.content_type }}{% if filters.category_id %}&category_id={{ filters.category_id }}{% endif %}{% if filters.status %}&status={{ filters.status }}{% endif %}{% if filters.q %}&q={{ filters.q|url_encode }}{% endif %}">
                                            <button type="submit" class="cms-btn cms-btn-danger">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="cms-empty">
                <strong>No content found</strong>
                No Ophyra Growth Hub content matches these filters.
                <div style="margin-top:16px;">
                    <a href="{{ path('panel/cms/pages/create') }}" class="cms-btn cms-btn-primary">+ Create First Content</a>
                </div>
            </div>
        {% endif %}
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var selectAll = document.querySelector('[data-select-all]');
    var checks = document.querySelectorAll('[data-row-check]');

    if (!selectAll || checks.length === 0) {
        return;
    }

    selectAll.addEventListener('change', function () {
        checks.forEach(function (check) {
            check.checked = selectAll.checked;
        });
    });
});
</script>
{% endblock %}
