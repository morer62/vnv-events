{% extends "templates/base.admin.twig" %}

{% block body %}
<style>
    .cms-preview-shell { max-width: 1180px; margin: 0 auto; padding: 24px; }
    .cms-preview-header { align-items: center; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; margin-bottom: 1.5rem; }
    .cms-preview-kicker { color: #6b7280; font-size: .75rem; font-weight: 700; letter-spacing: 0; margin-bottom: .25rem; text-transform: uppercase; }
    .cms-preview-title { font-size: 1.7rem; font-weight: 800; margin: 0; }
    .cms-preview-meta { display: grid; gap: .75rem; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); margin-bottom: 1rem; }
    .cms-preview-meta div { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: .85rem; }
    .cms-preview-meta span { color: #6b7280; display: block; font-size: .78rem; font-weight: 700; text-transform: uppercase; }
    .cms-preview-browser { background: #f8fafc; border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; }
    .cms-preview-bar { align-items: center; background: #111827; color: #d1d5db; display: flex; gap: .45rem; padding: .7rem .9rem; }
    .cms-preview-dot { background: #ef4444; border-radius: 999px; height: .62rem; width: .62rem; }
    .cms-preview-dot:nth-child(2) { background: #f59e0b; }
    .cms-preview-dot:nth-child(3) { background: #22c55e; }
    .cms-preview-url { font-size: .82rem; margin-left: .5rem; overflow-wrap: anywhere; }
    .cms-preview-document-wrap { background: #fff; padding: 1.25rem; }
    .cms-preview-document { margin: 0 auto; max-width: 960px; }
    .cms-preview-code { background: #0f172a; border-radius: 8px; color: #e5e7eb; font-family: Consolas, Monaco, monospace; font-size: .86rem; margin-top: 1rem; overflow: auto; padding: 1rem; white-space: pre-wrap; }
</style>

{% set route = page.main_route.route|default(page.route|default(page.canonical_url|default('/' ~ page.slug ~ '/'))) %}
{% set previewType = page.content_type|default(page.type|default('page')) %}
{% set sampleBody %}
    {% if page.body_html|default('') %}
        {{ page.body_html|raw }}
    {% elseif page.body|default('') %}
        {{ page.body|raw }}
    {% else %}
        <section><h1>{{ page.title }}</h1><p>{{ page.excerpt|default('') }}</p></section>
    {% endif %}
{% endset %}
{% set wrapper = page.preview_html|default('') %}
{% set rendered = wrapper
    ? wrapper|replace({
        '{{ title }}': page.title,
        '{{ body_html|raw }}': sampleBody,
        '{{ body|raw }}': sampleBody
    })
    : sampleBody
%}

<div class="cms-preview-shell">
    <div class="cms-preview-header">
        <div>
            <p class="cms-preview-kicker">CMS preview</p>
            <h1 class="cms-preview-title">{{ page.title }}</h1>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('panel/cms/pages') }}" class="btn btn-outline-secondary">Back</a>
            <a href="{{ path('panel/cms/pages/edit') }}?id={{ page.id }}" class="btn btn-dark">Edit</a>
        </div>
    </div>

    <section class="cms-preview-meta">
        <div><span>Type</span>{{ previewType|replace({'_':' '})|title }}</div>
        <div><span>Status</span>{{ page.status|default('DRAFT') }}</div>
        <div><span>Template</span>{{ page.template_name|default('None') }}</div>
        <div><span>Route</span><code>{{ route }}</code></div>
    </section>

    <section class="cms-preview-browser">
        <div class="cms-preview-bar">
            <span class="cms-preview-dot"></span>
            <span class="cms-preview-dot"></span>
            <span class="cms-preview-dot"></span>
            <code class="cms-preview-url">{{ route }}</code>
        </div>
        <div class="cms-preview-document-wrap">
            {% if page.template_css_text|default('') %}
                <style>{{ page.template_css_text|raw }}</style>
            {% endif %}
            <article class="cms-preview-document cms-preview-template-{{ page.template_key|default('default') }}">
                {{ rendered|raw }}
            </article>
        </div>
    </section>

    {% if page.template_structure_json|default('') %}
        <pre class="cms-preview-code">{{ page.template_structure_json }}</pre>
    {% endif %}
</div>
{% endblock %}
