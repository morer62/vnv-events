{% extends "templates/base.admin.twig" %}

{% block body %}
<style>
    .cms-wrap{
        padding:24px;
    }

    .cms-header{
        margin-bottom:28px;
    }

    .cms-title{
        font-size:2rem;
        font-weight:800;
        color:#111827;
        margin-bottom:6px;
    }

    .cms-subtitle{
        color:#6b7280;
        font-size:.98rem;
        margin:0;
        max-width:900px;
    }

    .cms-stats{
        display:grid;
        grid-template-columns:repeat(auto-fit, minmax(210px, 1fr));
        gap:18px;
        margin-bottom:30px;
    }

    .cms-stat-card{
        background:#fff;
        border:1px solid #e5e7eb;
        border-radius:18px;
        padding:20px;
        box-shadow:0 8px 25px rgba(0,0,0,.05);
    }

    .cms-stat-label{
        font-size:.9rem;
        color:#6b7280;
        margin-bottom:10px;
    }

    .cms-stat-value{
        font-size:2rem;
        font-weight:800;
        color:#111827;
        line-height:1;
    }

    .cms-grid{
        display:grid;
        grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));
        gap:22px;
    }

    .cms-card{
        background:#fff;
        border:1px solid #e5e7eb;
        border-radius:20px;
        padding:22px;
        box-shadow:0 10px 30px rgba(0,0,0,.05);
        display:flex;
        flex-direction:column;
        justify-content:space-between;
        min-height:220px;
    }

    .cms-card-top{
        margin-bottom:18px;
    }

    .cms-card-icon{
        width:52px;
        height:52px;
        border-radius:14px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        font-size:1.35rem;
        font-weight:700;
        margin-bottom:16px;
    }

    .cms-card-icon.pages{
        background:#ecfdf5;
        color:#059669;
    }

    .cms-card-icon.blog-posts{
        background:#eef2ff;
        color:#4338ca;
    }

    .cms-card-icon.blog-categories{
        background:#fff7ed;
        color:#c2410c;
    }

    .cms-card-icon.locations{
        background:#ecfeff;
        color:#0891b2;
    }

    .cms-card-icon.templates{
        background:#f5f3ff;
        color:#6d28d9;
    }

    .cms-card-title{
        font-size:1.2rem;
        font-weight:800;
        color:#111827;
        margin-bottom:8px;
    }

    .cms-card-text{
        color:#6b7280;
        font-size:.95rem;
        line-height:1.6;
        margin:0;
    }

    .cms-card-actions{
        display:flex;
        flex-wrap:wrap;
        gap:10px;
        margin-top:auto;
    }

    .cms-btn{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        padding:10px 16px;
        border-radius:12px;
        text-decoration:none;
        font-weight:700;
        font-size:.92rem;
        transition:.2s ease;
        border:none;
        cursor:pointer;
    }

    .cms-btn-primary{
        background:#111827;
        color:#fff;
    }

    .cms-btn-primary:hover{
        background:#000;
        color:#fff;
    }

    .cms-btn-light{
        background:#f3f4f6;
        color:#111827;
    }

    .cms-btn-light:hover{
        background:#e5e7eb;
        color:#111827;
    }

    .cms-note{
        margin-top:30px;
        background:#f0fdf4;
        border:1px solid #86efac;
        color:#166534;
        border-radius:18px;
        padding:18px 20px;
        line-height:1.65;
    }

    .cms-broadcast{
        margin-top:28px;
        display:grid;
        grid-template-columns:minmax(0, 1fr) minmax(320px, .72fr);
        gap:22px;
        align-items:start;
    }

    .cms-broadcast-panel{
        background:#fff;
        border:1px solid #dfe7ea;
        border-radius:22px;
        padding:24px;
        box-shadow:0 14px 36px rgba(15,23,42,.07);
    }

    .cms-broadcast-kicker{
        display:inline-flex;
        align-items:center;
        gap:8px;
        margin-bottom:12px;
        padding:7px 11px;
        border-radius:999px;
        background:#ecfeff;
        color:#0f766e;
        font-size:.75rem;
        font-weight:900;
        letter-spacing:.08em;
        text-transform:uppercase;
    }

    .cms-broadcast-title{
        margin:0 0 8px;
        color:#111827;
        font-size:1.25rem;
        font-weight:900;
    }

    .cms-field{
        margin-top:14px;
    }

    .cms-label{
        display:block;
        margin-bottom:7px;
        color:#374151;
        font-size:.86rem;
        font-weight:800;
    }

    .cms-input,
    .cms-textarea{
        width:100%;
        border:1px solid #d1d5db;
        border-radius:14px;
        padding:12px 14px;
        color:#111827;
        background:#fff;
        outline:none;
    }

    .cms-textarea{
        min-height:132px;
        resize:vertical;
    }

    .cms-input:focus,
    .cms-textarea:focus{
        border-color:#14b8a6;
        box-shadow:0 0 0 4px rgba(20,184,166,.12);
    }

    .cms-help{
        margin-top:6px;
        color:#6b7280;
        font-size:.82rem;
        line-height:1.5;
    }

    .cms-broadcast-submit{
        margin-top:16px;
    }

    .cms-history{
        display:grid;
        gap:10px;
    }

    .cms-history-item{
        border:1px solid #edf2f4;
        border-radius:16px;
        padding:13px;
        background:#f9fafb;
    }

    .cms-history-item strong{
        display:block;
        color:#111827;
        margin-bottom:4px;
    }

    .cms-history-meta{
        color:#6b7280;
        font-size:.82rem;
        line-height:1.5;
    }

    @media (max-width:768px){
        .cms-wrap{
            padding:16px;
        }

        .cms-title{
            font-size:1.6rem;
        }

        .cms-card{
            min-height:auto;
        }

        .cms-broadcast{
            grid-template-columns:1fr;
        }
    }
</style>

<div class="cms-wrap">
    <div class="cms-header">
        <h1 class="cms-title">VNV Events CMS</h1>
        <p class="cms-subtitle">
            Manage Ophyra Growth Hub content, categories and templates for <strong>{{ siteKey }}</strong>. Legacy local generators are no longer treated as active CMS sources.
        </p>
    </div>

    <div class="cms-stats">
        <div class="cms-stat-card">
            <div class="cms-stat-label">Content Pieces</div>
            <div class="cms-stat-value">{{ totalContent }}</div>
        </div>

        <div class="cms-stat-card">
            <div class="cms-stat-label">Pages / Locations / Blog</div>
            <div class="cms-stat-value">{{ totalPages }}</div>
        </div>

        <div class="cms-stat-card">
            <div class="cms-stat-label">Categories</div>
            <div class="cms-stat-value">{{ totalCategories }}</div>
        </div>

        <div class="cms-stat-card">
            <div class="cms-stat-label">Templates</div>
            <div class="cms-stat-value">{{ totalTemplates }}</div>
        </div>

        <div class="cms-stat-card">
            <div class="cms-stat-label">Published Content</div>
            <div class="cms-stat-value">{{ totalPublishedPages }}</div>
        </div>

        <div class="cms-stat-card">
            <div class="cms-stat-label">Draft Content</div>
            <div class="cms-stat-value">{{ totalDraftPages }}</div>
        </div>
    </div>

    <div class="cms-grid">
        <div class="cms-card">
            <div class="cms-card-top">
                <div class="cms-card-icon pages">CT</div>
                <div class="cms-card-title">Content</div>
                <p class="cms-card-text">
                    Review and manage Ophyra Growth Hub pages, locations and blog content from cms_contents.
                </p>
            </div>

            <div class="cms-card-actions">
                <a href="{{ path('panel/cms/pages') }}" class="cms-btn cms-btn-primary">Open Content</a>
                <a href="{{ path('panel/cms/pages/create') }}" class="cms-btn cms-btn-light">+ New Content</a>
            </div>
        </div>

        <div class="cms-card">
            <div class="cms-card-top">
                <div class="cms-card-icon pages">TX</div>
                <div class="cms-card-title">Categories</div>
                <p class="cms-card-text">
                    Manage shared CMS taxonomy for Growth Hub content.
                </p>
            </div>

            <div class="cms-card-actions">
                <a href="{{ path('panel/cms/pages/categories') }}" class="cms-btn cms-btn-primary">Open Categories</a>
                <a href="{{ path('panel/cms/pages/categories/create') }}" class="cms-btn cms-btn-light">+ New Category</a>
            </div>
        </div>

        <div class="cms-card">
            <div class="cms-card-top">
                <div class="cms-card-icon templates">TP</div>
                <div class="cms-card-title">Templates</div>
                <p class="cms-card-text">
                    Manage Ophyra template structures, style skins and public rendering CSS.
                </p>
            </div>

            <div class="cms-card-actions">
                <a href="{{ path('panel/cms/templates') }}" class="cms-btn cms-btn-primary">Open Templates</a>
                <a href="{{ path('panel/cms/templates/create') }}" class="cms-btn cms-btn-light">+ New Template</a>
            </div>
        </div>

        <div class="cms-card">
            <div class="cms-card-top">
                <div class="cms-card-icon templates">SEO</div>
                <div class="cms-card-title">SEO Center</div>
                <p class="cms-card-text">
                    Regenerate sitemap, llms files and publishing assets from Ophyra Growth Hub content.
                </p>
            </div>

            <div class="cms-card-actions">
                <a href="{{ path('panel/seo-center') }}" class="cms-btn cms-btn-primary">Open SEO Center</a>
            </div>
        </div>

    </div>

    <section class="cms-broadcast">
        <div class="cms-broadcast-panel">
            <span class="cms-broadcast-kicker">Mobile app push</span>
            <h2 class="cms-broadcast-title">Send a notification to mobile app users</h2>
            <p class="cms-card-text">
                Sends an Expo push notification to active users with mobile push tokens and creates an inbox notification record for each recipient.
            </p>

            <form method="post">
                <input type="hidden" name="action" value="send_mobile_broadcast">
                <div class="cms-field">
                    <label class="cms-label">Title</label>
                    <input class="cms-input" type="text" name="mobile_title" maxlength="140" placeholder="Example: New VNV Sessions mix is live" required>
                </div>
                <div class="cms-field">
                    <label class="cms-label">Message</label>
                    <textarea class="cms-textarea" name="mobile_body" maxlength="800" placeholder="Write the notification body users will see." required></textarea>
                </div>
                <div class="cms-field">
                    <label class="cms-label">Optional link</label>
                    <input class="cms-input" type="url" name="mobile_link" maxlength="500" placeholder="https://vnvevents.com/vnv-sessions/">
                    <div class="cms-help">If present, the mobile app should open this link from the notification detail screen.</div>
                </div>
                <button type="submit" class="cms-btn cms-btn-primary cms-broadcast-submit">
                    Send to {{ mobilePushRecipientsCount|default(0) }} mobile device{{ mobilePushRecipientsCount|default(0) == 1 ? '' : 's' }}
                </button>
            </form>
        </div>

        <aside class="cms-broadcast-panel">
            <span class="cms-broadcast-kicker">Broadcast log</span>
            <h2 class="cms-broadcast-title">Recent sends</h2>
            <div class="cms-history">
                {% for item in recentMobileBroadcasts|default([]) %}
                    <div class="cms-history-item">
                        <strong>{{ item.title }}</strong>
                        <div class="cms-history-meta">
                            {{ item.created_at }}<br>
                            Recipients: {{ item.recipient_count }} |
                            Push sent: {{ item.push_sent_count }} |
                            Failed: {{ item.push_failed_count }}<br>
                            Records: {{ item.notification_count }}
                        </div>
                    </div>
                {% else %}
                    <div class="cms-history-item">
                        <strong>No broadcasts yet</strong>
                        <div class="cms-history-meta">Mobile app notification sends will appear here.</div>
                    </div>
                {% endfor %}
            </div>
        </aside>
    </section>

    <div class="cms-note">
        <strong>Publishing rule:</strong> Ophyra Growth Hub is the canonical CMS source. Public consumers should read `cms_contents`, `cms_routes`, `cms_categories` and `cms_templates` scoped to <strong>{{ siteKey }}</strong>. Legacy blog, AI and location generators are historical compatibility only.
    </div>
</div>
{% endblock %}
