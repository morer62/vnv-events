{% extends "templates/base.admin.twig" %}

{% block body %}
<style>
    .cms-wrap{
        padding:24px;
    }

    .cms-header{
        margin-bottom:28px;
    }

    .cms-title{
        font-size:2rem;
        font-weight:800;
        color:#111827;
        margin-bottom:6px;
    }

    .cms-subtitle{
        color:#6b7280;
        font-size:.98rem;
        margin:0;
        max-width:900px;
    }

    .cms-stats{
        display:grid;
        grid-template-columns:repeat(auto-fit, minmax(210px, 1fr));
        gap:18px;
        margin-bottom:30px;
    }

    .cms-stat-card{
        background:#fff;
        border:1px solid #e5e7eb;
        border-radius:18px;
        padding:20px;
        box-shadow:0 8px 25px rgba(0,0,0,.05);
    }

    .cms-stat-label{
        font-size:.9rem;
        color:#6b7280;
        margin-bottom:10px;
    }

    .cms-stat-value{
        font-size:2rem;
        font-weight:800;
        color:#111827;
        line-height:1;
    }

    .cms-grid{
        display:grid;
        grid-template-columns:repeat(auto-fit, minmax(280px, 1fr));
        gap:22px;
    }

    .cms-card{
        background:#fff;
        border:1px solid #e5e7eb;
        border-radius:20px;
        padding:22px;
        box-shadow:0 10px 30px rgba(0,0,0,.05);
        display:flex;
        flex-direction:column;
        justify-content:space-between;
        min-height:220px;
    }

    .cms-card-top{
        margin-bottom:18px;
    }

    .cms-card-icon{
        width:52px;
        height:52px;
        border-radius:14px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        font-size:1.35rem;
        font-weight:700;
        margin-bottom:16px;
    }

    .cms-card-icon.pages{
        background:#ecfdf5;
        color:#059669;
    }

    .cms-card-icon.blog-posts{
        background:#eef2ff;
        color:#4338ca;
    }

    .cms-card-icon.blog-categories{
        background:#fff7ed;
        color:#c2410c;
    }

    .cms-card-icon.locations{
        background:#ecfeff;
        color:#0891b2;
    }

    .cms-card-icon.templates{
        background:#f5f3ff;
        color:#6d28d9;
    }

    .cms-card-title{
        font-size:1.2rem;
        font-weight:800;
        color:#111827;
        margin-bottom:8px;
    }

    .cms-card-text{
        color:#6b7280;
        font-size:.95rem;
        line-height:1.6;
        margin:0;
    }

    .cms-card-actions{
        display:flex;
        flex-wrap:wrap;
        gap:10px;
        margin-top:auto;
    }

    .cms-btn{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        padding:10px 16px;
        border-radius:12px;
        text-decoration:none;
        font-weight:700;
        font-size:.92rem;
        transition:.2s ease;
        border:none;
        cursor:pointer;
    }

    .cms-btn-primary{
        background:#111827;
        color:#fff;
    }

    .cms-btn-primary:hover{
        background:#000;
        color:#fff;
    }

    .cms-btn-light{
        background:#f3f4f6;
        color:#111827;
    }

    .cms-btn-light:hover{
        background:#e5e7eb;
        color:#111827;
    }

    .cms-note{
        margin-top:30px;
        background:#f0fdf4;
        border:1px solid #86efac;
        color:#166534;
        border-radius:18px;
        padding:18px 20px;
        line-height:1.65;
    }

    @media (max-width:768px){
        .cms-wrap{
            padding:16px;
        }

        .cms-title{
            font-size:1.6rem;
        }

        .cms-card{
            min-height:auto;
        }
    }
</style>

<div class="cms-wrap">
    <div class="cms-header">
        <h1 class="cms-title">VNV Events CMS</h1>
        <p class="cms-subtitle">
            Manage Ophyra Growth Hub content, categories and templates for <strong>{{ siteKey }}</strong>. Legacy local generators are no longer treated as active CMS sources.
        </p>
    </div>

    <div class="cms-stats">
        <div class="cms-stat-card">
            <div class="cms-stat-label">Content Pieces</div>
            <div class="cms-stat-value">{{ totalContent }}</div>
        </div>

        <div class="cms-stat-card">
            <div class="cms-stat-label">Pages / Locations / Blog</div>
            <div class="cms-stat-value">{{ totalPages }}</div>
        </div>

        <div class="cms-stat-card">
            <div class="cms-stat-label">Categories</div>
            <div class="cms-stat-value">{{ totalCategories }}</div>
        </div>

        <div class="cms-stat-card">
            <div class="cms-stat-label">Templates</div>
            <div class="cms-stat-value">{{ totalTemplates }}</div>
        </div>

        <div class="cms-stat-card">
            <div class="cms-stat-label">Published Content</div>
            <div class="cms-stat-value">{{ totalPublishedPages }}</div>
        </div>

        <div class="cms-stat-card">
            <div class="cms-stat-label">Draft Content</div>
            <div class="cms-stat-value">{{ totalDraftPages }}</div>
        </div>
    </div>

    <div class="cms-grid">
        <div class="cms-card">
            <div class="cms-card-top">
                <div class="cms-card-icon pages">CT</div>
                <div class="cms-card-title">Content</div>
                <p class="cms-card-text">
                    Review and manage Ophyra Growth Hub pages, locations and blog content from cms_contents.
                </p>
            </div>

            <div class="cms-card-actions">
                <a href="{{ path('panel/cms/pages') }}" class="cms-btn cms-btn-primary">Open Content</a>
                <a href="{{ path('panel/cms/pages/create') }}" class="cms-btn cms-btn-light">+ New Content</a>
            </div>
        </div>

        <div class="cms-card">
            <div class="cms-card-top">
                <div class="cms-card-icon pages">TX</div>
                <div class="cms-card-title">Categories</div>
                <p class="cms-card-text">
                    Manage shared CMS taxonomy for Growth Hub content.
                </p>
            </div>

            <div class="cms-card-actions">
                <a href="{{ path('panel/cms/pages/categories') }}" class="cms-btn cms-btn-primary">Open Categories</a>
                <a href="{{ path('panel/cms/pages/categories/create') }}" class="cms-btn cms-btn-light">+ New Category</a>
            </div>
        </div>

        <div class="cms-card">
            <div class="cms-card-top">
                <div class="cms-card-icon templates">TP</div>
                <div class="cms-card-title">Templates</div>
                <p class="cms-card-text">
                    Manage Ophyra template structures, style skins and public rendering CSS.
                </p>
            </div>

            <div class="cms-card-actions">
                <a href="{{ path('panel/cms/templates') }}" class="cms-btn cms-btn-primary">Open Templates</a>
                <a href="{{ path('panel/cms/templates/create') }}" class="cms-btn cms-btn-light">+ New Template</a>
            </div>
        </div>

        <div class="cms-card">
            <div class="cms-card-top">
                <div class="cms-card-icon templates">SEO</div>
                <div class="cms-card-title">SEO Center</div>
                <p class="cms-card-text">
                    Regenerate sitemap, llms files and publishing assets from Ophyra Growth Hub content.
                </p>
            </div>

            <div class="cms-card-actions">
                <a href="{{ path('panel/seo-center') }}" class="cms-btn cms-btn-primary">Open SEO Center</a>
            </div>
        </div>

    </div>

    <div class="cms-note">
        <strong>Publishing rule:</strong> Ophyra Growth Hub is the canonical CMS source. Public consumers should read `cms_contents`, `cms_routes`, `cms_categories` and `cms_templates` scoped to <strong>{{ siteKey }}</strong>. Legacy blog, AI and location generators are historical compatibility only.
    </div>
</div>
{% endblock %}
