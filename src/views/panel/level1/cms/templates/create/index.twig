{% extends "templates/base.admin.twig" %}

{% block body %}
<style>
    .template-editor-shell { max-width: 1180px; margin: 0 auto; }
    .template-editor-header { align-items: center; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; margin-bottom: 1.5rem; }
    .template-editor-kicker { color: #6b7280; font-size: .75rem; font-weight: 700; letter-spacing: 0; margin-bottom: .25rem; text-transform: uppercase; }
    .template-editor-title { font-size: 1.65rem; font-weight: 800; margin: 0; }
    .template-editor-layout { display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr) minmax(320px, 420px); }
    .template-editor-panel { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 1rem; }
    .template-editor-section-title { font-size: 1rem; font-weight: 800; margin: 0 0 1rem; }
    .template-preview-frame { background: #f8fafc; border: 1px solid #e5e7eb; border-radius: 8px; min-height: 360px; overflow: auto; padding: 1rem; }
    .template-preview-document { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; min-height: 280px; padding: 1.25rem; }
    .template-code { font-family: Consolas, Monaco, monospace; font-size: .86rem; }
    @media (max-width: 991px) { .template-editor-layout { grid-template-columns: 1fr; } }
</style>

<div class="container py-4">
    <div class="template-editor-shell">
        <div class="template-editor-header">
            <div>
                <p class="template-editor-kicker">CMS templates / {{ site_name }} / {{ site_key }}</p>
                <h1 class="template-editor-title">Create template</h1>
            </div>
            <a href="{{ path('panel/cms/templates') }}" class="btn btn-outline-secondary">Back</a>
        </div>

        <form method="post" class="template-editor-layout" data-template-editor>
            <div class="template-editor-panel">
                <h2 class="template-editor-section-title">Details</h2>
                <div class="row g-3">
                    <div class="col-md-7">
                        <label class="form-label">Name</label>
                        <input name="name" class="form-control" required>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Template key</label>
                        <input name="template_key" class="form-control" placeholder="service-landing" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Type</label>
                        <select name="type" class="form-select">
                            <option value="page">Page</option>
                            <option value="blog">Blog</option>
                            <option value="location">Location</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-select">
                            <option value="ACTIVE">Active</option>
                            <option value="INACTIVE">Inactive</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea name="description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Preview HTML</label>
                        <textarea name="preview_html" class="form-control template-code" rows="9" data-preview-html>{{ default_preview_html }}</textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label">CSS</label>
                        <textarea name="css_text" class="form-control template-code" rows="10" data-preview-css>.cms-template-shell h1 { font-size: 2rem; margin-bottom: 1rem; }
.cms-template-shell .cms-eyebrow { color: #6b7280; font-weight: 700; text-transform: uppercase; }</textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Structure JSON</label>
                        <textarea name="template_structure_json" class="form-control template-code" rows="7">{"supports":["hero","body_html","faq","cta"]}</textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Metadata JSON</label>
                        <textarea name="metadata_json" class="form-control template-code" rows="7">{"version":"1.0"}</textarea>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a href="{{ path('panel/cms/templates') }}" class="btn btn-outline-secondary">Cancel</a>
                    <button class="btn btn-dark">Create</button>
                </div>
            </div>

            <aside class="template-editor-panel">
                <h2 class="template-editor-section-title">Preview</h2>
                <div class="template-preview-frame">
                    <style data-preview-style></style>
                    <article class="template-preview-document" data-preview-output></article>
                </div>
            </aside>
        </form>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const form = document.querySelector('[data-template-editor]');
    if (!form) return;
    const html = form.querySelector('[data-preview-html]');
    const css = form.querySelector('[data-preview-css]');
    const output = form.querySelector('[data-preview-output]');
    const style = form.querySelector('[data-preview-style]');
    const siteName = '{{ site_name|e('js') }}';
    const sampleBody = '<section class="cms-block cms-block-body"><h2>Sample section</h2><p>Body copy, links and blocks inherit this template skin.</p></section>';
    const token = function (name) { return '{' + '{' + name + '}' + '}'; };
    const render = function () {
        let markup = html.value || '';
        markup = markup
            .replaceAll(token(' title '), 'VNV Events Sample Page')
            .replaceAll(token(' site_name '), siteName)
            .replaceAll(token(' body_html|raw '), sampleBody)
            .replaceAll(token(' body|raw '), sampleBody);
        style.textContent = css.value || '';
        output.innerHTML = markup;
    };
    html.addEventListener('input', render);
    css.addEventListener('input', render);
    render();
});
</script>
{% endblock %}
