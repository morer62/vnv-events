{% extends "templates/base.admin.twig" %}

{% block body %}
<div class="container py-4">
    <h2>Create Template</h2>

    <form method="post">
        <input name="name" placeholder="Name" class="form-control mb-3">
        <input name="template_key" placeholder="template-key" class="form-control mb-3">

        <select name="type" class="form-control mb-3">
            <option value="page">Page</option>
            <option value="post">Post</option>
            <option value="location">Location</option>
        </select>

        <textarea name="template_structure_json" class="form-control mb-3" rows="6"></textarea>

        <textarea name="preview_html" class="form-control mb-3" rows="4"></textarea>

        <button class="btn btn-success">Create</button>
    </form>
</div>
{% endblock %}