{% extends "templates/base.admin.twig" %}
{% block body %}
<div class="container-fluid py-4">
  <h1 class="h3">Manager Scheduling</h1>
  <p class="text-muted">Upcoming events, mandatory Main Manager assignments and shared operational validation.</p>
  <details class="card mb-3">
    <summary class="card-header fw-bold">Choose eligible Event Managers</summary>
    <div class="card-body d-flex flex-wrap gap-2">
      {% for person in candidates %}
        <form method="post" class="border rounded p-2">
          <input type="hidden" name="action" value="toggle_manager">
          <input type="hidden" name="manager_id" value="{{ person.id }}">
          <label><input type="checkbox" name="enabled" value="1" {% if person.is_event_manager %}checked{% endif %} onchange="this.form.submit()"> {{ person.name }} {{ person.lastname }}</label>
        </form>
      {% endfor %}
    </div>
  </details>
  <div class="card">
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead><tr><th>Event</th><th>Operational window</th><th>Main Manager</th><th>Status</th><th>Assign / reassign</th></tr></thead>
        <tbody>
        {% for order in orders %}
          <tr>
            <td><strong>#{{ order.id }} · {{ order.client_name }}</strong><br><small>{{ order.event_date }}</small></td>
            <td>Setup {{ order.setup_minutes ?: 60 }} min<br><small>{{ order.start_time }}–{{ order.end_time }}</small></td>
            <td>{{ order.manager_name ?: '⚠ Needs assignment' }}</td>
            <td><span class="badge {{ order.availability_status == 'AVAILABLE' ? 'bg-success' : 'bg-warning text-dark' }}">{{ order.availability_status }}</span></td>
            <td>
              <form method="post" class="d-flex gap-2 flex-wrap">
                <input type="hidden" name="order_id" value="{{ order.id }}">
                <select name="manager_id" class="form-select form-select-sm" required>
                  <option value="">Select manager</option>
                  {% for manager in managers %}<option value="{{ manager.id }}">{{ manager.name }} {{ manager.lastname }}</option>{% endfor %}
                </select>
                <input class="form-control form-control-sm" name="override_reason" placeholder="Override reason only if warned">
                <button class="btn btn-sm btn-primary">Validate &amp; assign</button>
              </form>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="5" class="text-center text-muted py-5">No upcoming events.</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
