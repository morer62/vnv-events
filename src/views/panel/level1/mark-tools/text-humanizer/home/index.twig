{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<div class="container-fluid h-100 d-flex flex-column align-items-center">
    <div class="card shadow-lg p-4 w-100 w-md-75 align-self-stretch">
        <div class="card-body">
            
            <h1 class="h3 mb-3 text-center">Text Humanizer & SEO Optimizer</h1>

            {{ macros.breadcrumb2() }}

            <form method="post" class="w-100">
                {{ macros.csrf() }}

                <div class="mb-3">
                    <label for="textInput" class="form-label">Enter your text:</label>
                    <textarea id="textInput" name="textInput" class="form-control" rows="6">{{ originalText is defined ? originalText|e : '' }}</textarea>
                </div>

                <button type="submit" class="btn btn-success w-100">Optimize Text</button>
            </form>

            <hr>

            {% if humanizedText is defined %}
                <div class="mt-3">
                    <h5><b>Modified Text:</b></h5>
                    <p class="border p-3">{{ humanizedText|raw  }}</p>
                </div>
            {% endif %}

        </div>
    </div>
</div>
{% endblock %}
