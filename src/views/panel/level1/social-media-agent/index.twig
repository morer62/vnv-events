{% extends "templates/base.admin.twig" %}
{% block title %}Social Media Agent{% endblock %}
{% block styles %}<style>.sma{max-width:1500px;margin:auto}.sma-hero{padding:34px;border-radius:24px;background:linear-gradient(135deg,#11172a,#37236d);color:#fff}.sma-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.sma-card{padding:22px;border:1px solid #e1e5ee;border-radius:18px;background:#fff}.sma-table{width:100%;border-collapse:collapse}.sma-table th,.sma-table td{padding:12px;border-bottom:1px solid #edf0f5;text-align:left;vertical-align:top}.sma-state{display:inline-block;padding:4px 9px;border-radius:999px;background:#eef1f7;font-size:.72rem;font-weight:800}.sma-ok{color:#087d53}.sma-bad{color:#b42318}.sma-btn{border:0;border-radius:10px;padding:11px 16px;background:#6f4bf2;color:#fff;font-weight:800}.sma-select{padding:10px;border:1px solid #ccd2dd;border-radius:9px}@media(max-width:800px){.sma-grid{grid-template-columns:1fr}.sma-scroll{overflow:auto}}</style>{% endblock %}
{% block body %}<main class="sma py-4 px-3"><section class="sma-hero"><p class="text-uppercase mb-2">Written content distribution</p><h1>Social Media Agent</h1><p>Discover → analyze → rank → adapt → validate → review → schedule → publish → verify → log.</p><form method="post" class="d-flex gap-2 flex-wrap"><input type="hidden" name="csrf_token" value="{{ get_csrf() }}"><input type="hidden" name="action" value="run"><select class="sma-select" name="mode"><option value="REVIEW_BEFORE_PUBLISH">Review before publishing</option><option value="AUTO_PUBLISH">Auto schedule after validation</option></select><button class="sma-btn">Run complete agent</button></form></section>
<section class="sma-grid my-4">{% for key,name in {'miamitechlab':'Miami Tech Lab','vnvevents':'VNV Events'} %}<article class="sma-card"><h2>{{ name }}</h2>{% for network in ['linkedin','facebook'] %}{% set c=connections[key][network]|default(null) %}<p><strong>{{ network|title }}:</strong> {% if c %}<span class="{{ c.status=='VERIFIED'?'sma-ok':'sma-bad' }}">{{ c.status }}</span> · {{ c.account_label ?: c.account_identifier }}{% else %}<span class="sma-bad">Not configured</span>{% endif %}</p><form method="post" class="mb-3"><input type="hidden" name="csrf_token" value="{{ get_csrf() }}"><input type="hidden" name="action" value="save_connection"><input type="hidden" name="site_key" value="{{ key }}"><input type="hidden" name="platform" value="{{ network }}"><input class="sma-select mb-1 w-100" name="account_label" value="{{ c.account_label|default('') }}" placeholder="Official Page name"><input class="sma-select mb-1 w-100" name="account_identifier" value="{{ c.account_identifier|default('') }}" placeholder="{{ network=='linkedin'?'Organization ID / URN':'Facebook Page ID' }}"><input class="sma-select mb-1 w-100" type="password" name="access_token" autocomplete="new-password" placeholder="{{ c?'Leave blank to keep token':'Access token' }}"><button class="sma-btn">Save securely</button>{% if c %}<button class="btn btn-outline-success" name="action" value="verify_connection">Verify now</button>{% endif %}</form>{% endfor %}</article>{% endfor %}</section>
<section class="sma-card"><h2>Publication queue and history</h2><form method="post"><input type="hidden" name="csrf_token" value="{{ get_csrf() }}"><div class="sma-scroll"><table class="sma-table"><thead><tr><th></th><th>Brand / article</th><th>Network</th><th>Format</th><th>State</th><th>Planned</th><th>External result</th></tr></thead><tbody>{% for p in publications %}<tr><td>{% if p.state=='PREPARED' %}<input type="checkbox" name="publication_ids[]" value="{{ p.id }}">{% endif %}</td><td><strong>{{ p.brand_key=='miamitechlab'?'Miami Tech Lab':'VNV Events' }}</strong><br><a href="{{ p.article_url }}" target="_blank" rel="noopener">{{ p.article_title }}</a></td><td>{{ p.network|title }}</td><td>{{ p.format|replace({'_':' '})|title }}</td><td><span class="sma-state">{{ p.state }}</span>{% if p.last_error %}<br><small class="sma-bad">{{ p.last_error }}</small>{% endif %}</td><td>{{ p.scheduled_for }}</td><td>{{ p.external_post_id ?: '—' }}</td></tr>{% else %}<tr><td colspan="7">No publications yet. Run the complete agent.</td></tr>{% endfor %}</tbody></table></div><div class="mt-3 d-flex gap-2"><button class="sma-btn" name="action" value="schedule">Approve and schedule selected</button><button class="btn btn-outline-secondary" name="action" value="skip">Skip selected</button></div></form></section>
<section class="sma-card mt-4"><h2>Recent runs</h2>{% for run in runs %}<p><strong>#{{ run.id }} {{ run.status }}</strong> · {{ run.mode }} · {{ run.started_at }}{% if run.error_message %}<br><span class="sma-bad">{{ run.error_message }}</span>{% endif %}</p>{% else %}<p>No runs recorded.</p>{% endfor %}</section></main>{% endblock %}
