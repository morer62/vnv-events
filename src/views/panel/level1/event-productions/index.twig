{% extends 'templates/base.admin.twig' %}
{% block body %}
  <div class="container py-4">
    <h1 class="mb-4">Event Productions</h1>
    <p><a class="btn btn-primary" href="{{ path('panel/productions-management-center') }}">Open Productions Management Center</a></p>
    <div class="row">
      <div class="col-lg-7">
        <article class="card overflow-hidden">
          <img class="card-img-top" width="820" height="210" style="height:180px;object-fit:cover;object-position:center 45%;" src="{{ asset_for('assets/break-club/hero-poster.webp') }}" alt="">
          <div class="card-body">
            <h2 class="h3">Mommy &amp; Daddy Break Club</h2>
            <p>Manage the priority list, invite members to each event and check in guests individually.</p>
            <a class="btn btn-primary" href="{{ path('panel/event-productions/break-club') }}">Open club dashboard</a>
          </div>
        </article>
      </div>
    </div>
  </div>
{% endblock %}
