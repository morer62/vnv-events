  function buildCardioSession(data, long = false) {
    const duration = getSessionDurationMinutes(data);
    let minutes = duration;

    if (long && data.time === '60') minutes = 45;
    if (long && data.time === '40') minutes = 35;
    if (long && data.time === '20') minutes = 25;
    if (long && data.time === '10') minutes = 15;

    let focus = 'Zone 2 cardio / brisk walk';
    let prescription = `Brisk walk or easy cardio for ${minutes} min. Keep a pace where you can still speak in short sentences.`;

    if (data.goal === 'fat_loss' || data.goal === 'energy') {
      prescription = `Brisk walk, bike or treadmill for ${minutes} min. Keep effort moderate, not all-out.`;
    }

    if (data.trainingAccess === 'gym' && data.goal === 'muscle_gain') {
      prescription = `Low-impact cardio for ${Math.min(minutes, 25)} min to support conditioning without hurting recovery.`;
    }

    return {
      focus,
      warmup: '2–3 min easy pace before building rhythm',
      exercises: [
        prescription,
        `Finish with 5 min easy pace and 3–5 min light stretching`,
        `Optional: add 5–10 min extra walking later in the day`
      ]
    };
  }

  function buildMobilityRecoverySession(data) {
    const duration = data.time === '60' ? 25 : data.time === '40' ? 20 : data.time === '20' ? 12 : 8;

    return {
      focus: 'Mobility + Recovery',
      warmup: 'Start easy and breathe through each movement',
      exercises: [
        `Cat-camel x 8 reps`,
        `Hip flexor stretch x 30 sec each side`,
        `Thoracic rotation x 8 reps each side`,
        `Hamstring stretch x 30 sec each side`,
        `Child’s pose or breathing reset x 2 min`,
        `Easy walk for ${duration} min if possible`
      ]
    };
  }

  function getWeeklyPlan(data) {
    const strengthDays = getTrainingDays(data);
    const cardioDays = getCardioDays(data);
    const duration = getSessionDurationMinutes(data);

    const strengthA = buildStrengthWorkoutA(data);
    const strengthB = buildStrengthWorkoutB(data);
    const strengthC = buildStrengthWorkoutC(data);
    const cardio = buildCardioSession(data, false);
    const longerCardio = buildCardioSession(data, true);
    const mobility = buildMobilityRecoverySession(data);

    const plan = [];

    if (strengthDays === 2) {
      plan.push(
        { day: 'Monday', type: 'Strength', duration: `${duration} min`, ...strengthA },
        { day: 'Tuesday', type: 'Cardio', duration: `${duration} min`, ...cardio },
        { day: 'Wednesday', type: 'Recovery', duration: `10–20 min`, ...mobility },
        { day: 'Thursday', type: 'Strength', duration: `${duration} min`, ...strengthB },
        { day: 'Friday', type: 'Cardio', duration: `${duration} min`, ...cardio },
        { day: 'Saturday', type: 'Walk', duration: `${Math.max(20, duration)} min`, ...longerCardio },
        { day: 'Sunday', type: 'Recovery', duration: `10–20 min`, ...mobility }
      );
    } else if (strengthDays === 3) {
      plan.push(
        { day: 'Monday', type: 'Strength', duration: `${duration} min`, ...strengthA },
        { day: 'Tuesday', type: 'Cardio', duration: `${duration} min`, ...cardio },
        { day: 'Wednesday', type: 'Strength', duration: `${duration} min`, ...strengthB },
        { day: 'Thursday', type: 'Recovery', duration: `10–20 min`, ...mobility },
        { day: 'Friday', type: 'Strength', duration: `${duration} min`, ...strengthC },
        { day: 'Saturday', type: 'Walk', duration: `${Math.max(20, duration)} min`, ...longerCardio },
        { day: 'Sunday', type: 'Recovery', duration: `10–20 min`, ...mobility }
      );
    } else {
      plan.push(
        { day: 'Monday', type: 'Strength', duration: `${duration} min`, ...strengthA },
        { day: 'Tuesday', type: 'Cardio', duration: `${Math.min(duration, 30)} min`, ...cardio },
        { day: 'Wednesday', type: 'Strength', duration: `${duration} min`, ...strengthB },
        { day: 'Thursday', type: 'Cardio', duration: `${Math.min(duration, 30)} min`, ...cardio },
        { day: 'Friday', type: 'Strength', duration: `${duration} min`, ...strengthC },
        { day: 'Saturday', type: 'Strength', duration: `${duration} min`, ...strengthA },
        { day: 'Sunday', type: 'Recovery', duration: `15–25 min`, ...mobility }
      );
    }

    if (data.goal === 'longevity' && strengthDays < 4) {
      plan[5] = { day: 'Saturday', type: 'Walk', duration: `${Math.max(25, duration)} min`, ...longerCardio };
    }

    if (data.sleepQuality === 'poor' || data.workStress === 'high') {
      plan[3] = { day: 'Thursday', type: 'Recovery', duration: `10–20 min`, ...mobility };
      if (strengthDays === 4) {
        plan[5] = { day: 'Saturday', type: 'Walk', duration: `${Math.max(20, duration)} min`, ...longerCardio };
      }
    }

    return {
      strengthDays,
      cardioDays,
      days: plan
    };
  }

  function buildOverviewTips(data, weeklyPlan, sleepData) {
    const tips = [];

    tips.push(`Your plan is built for <strong>${getGoalTitle(data.goal)}</strong> with <strong>${data.trainingAccessText}</strong> and about <strong>${data.timeText}</strong> available most days.`);
    tips.push(`You now have a more exact weekly structure: <strong>${weeklyPlan.strengthDays} strength day(s)</strong>, <strong>${weeklyPlan.cardioDays} cardio / walking day(s)</strong>, and a sleep target built around your current routine.`);
    tips.push(`Your recommended training style is <strong>${data.trainingStyle}</strong>.`);
    tips.push(`Your target bedtime is about <strong>${sleepData.bedText}</strong> and your target wake-up time is about <strong>${sleepData.wakeText}</strong>.`);
    tips.push(`<strong>Food support matters:</strong> if you want this plan to work better, review your meals too. Training, energy and recovery improve when food intake supports the work.`);

    return tips;
  }

  function buildExerciseTips(data, weeklyPlan) {
    const tips = [];
    const duration = getSessionDurationMinutes(data);

    tips.push(`<strong>Strength frequency:</strong> train strength about <strong>${weeklyPlan.strengthDays} day(s) per week</strong>.`);
    tips.push(`<strong>Cardio / walking:</strong> aim for about <strong>${weeklyPlan.cardioDays} day(s) per week</strong> of walking, cardio or easy movement.`);
    tips.push(`<strong>Session length:</strong> your main training sessions should usually last about <strong>${duration} minutes</strong>.`);
    tips.push(`<strong>Progression rule:</strong> when all sets feel manageable, add a few reps first, then a little load, then possibly an extra set later.`);
    tips.push(`<strong>Effort rule:</strong> finish most working sets feeling like you could still do 1–2 more good reps. Don’t chase failure on every set.`);

    if (data.trainingAccess === 'none') {
      tips.push(`<strong>No gym plan:</strong> bodyweight can still work. Use slower reps, controlled tempo, pauses, backpacks, stair work and consistent walking.`);
    }

    if (data.trainingAccess === 'gym') {
      tips.push(`<strong>Gym plan:</strong> stay with basic movements, good form and repeatable progression instead of changing exercises every week.`);
    }

    if (data.goal === 'fat_loss') {
      tips.push(`<strong>Fat loss priority:</strong> don’t try to out-cardio bad recovery. Keep strength training in, walk often, and let nutrition do its share.`);
    }

    if (data.goal === 'muscle_gain') {
      tips.push(`<strong>Strength / muscle priority:</strong> protect recovery. Keep cardio supportive, not exhausting.`);
    }

    return tips;
  }

  function buildRecoveryTips(data, sleepData) {
    const tips = [];

    tips.push(`<strong>Sleep target:</strong> aim for about <strong>${sleepData.sleepHours} hours</strong> of sleep per night.`);
    tips.push(`<strong>Suggested bedtime:</strong> around <strong>${sleepData.bedText}</strong>.`);
    tips.push(`<strong>Suggested wake-up time:</strong> around <strong>${sleepData.wakeText}</strong>.`);
    tips.push(`<strong>Daily reset:</strong> aim for about <strong>${getMeditationTarget(data)}</strong> of quiet breathing, meditation, prayer or just intentional stillness.`);
    tips.push(`<strong>Wind-down rule:</strong> try to reduce bright screens, heavy meals and intense work in the final 45–60 min before bed.`);
    tips.push(`<strong>Recovery rule:</strong> if sleep has been poor, keep showing up, but reduce intensity before you reduce consistency.`);

    return tips;
  }

  function renderWeeklySchedule(plan) {
    weeklySchedule.innerHTML = plan.days.map(day => `
      <div class="wa-schedule-item">
        <div class="wa-day-head">
          <div class="wa-day-title">${day.day} — ${day.focus}</div>
          <div class="wa-day-meta">
            <span class="wa-chip"><i class="fa-solid fa-stopwatch"></i> ${day.duration}</span>
            <span class="wa-chip"><i class="fa-solid fa-layer-group"></i> ${day.type}</span>
          </div>
        </div>

        <div style="margin-bottom:.55rem;">
          <strong>Warm-up:</strong> ${day.warmup}
        </div>

        <ul class="wa-ex-list">
          ${day.exercises.map(ex => `<li>${ex}</li>`).join('')}
        </ul>
      </div>
    `).join('');
  }

  function buildCopyPlan(data, weeklyPlan, sleepData) {
    const lines = [
      `My Avomeal Wellness Plan`,
      ``,
      `Goal: ${getGoalTitle(data.goal)}`,
      `Height: ${data.heightText}`,
      `Weight: ${data.weightLb} lb`,
      `Activity level: ${data.activityText}`,
      `Workout access: ${data.trainingAccessText}`,
      `Training experience: ${data.experienceText}`,
      `Time available: ${data.timeText}`,
      `Training style: ${data.trainingStyle}`,
      ``,
      `Sleep target: ${sleepData.sleepHours} hours`,
      `Bedtime target: ${sleepData.bedText}`,
      `Wake-up target: ${sleepData.wakeText}`,
      `Daily reset / meditation: ${getMeditationTarget(data)}`,
      ``,
      `Weekly plan:`
    ];

    weeklyPlan.days.forEach(day => {
      lines.push(``);
      lines.push(`${day.day} — ${day.focus} (${day.duration})`);
      lines.push(`Warm-up: ${day.warmup}`);
      day.exercises.forEach(ex => lines.push(`- ${ex}`));
    });

    lines.push(``);
    lines.push(`Food reminder: review your nutrition advisor and meal plans so recovery and protein intake match your training.`);
    if (data.notes) {
      lines.push(``);
      lines.push(`Extra note: ${data.notes}`);
    }

    return lines.join('\n');
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    copySuccessBox.style.display = 'none';

    const gender = document.getElementById('wa_gender').value;
    const age = parseInt(document.getElementById('wa_age').value || '0', 10);
    const heightFt = parseInt(document.getElementById('wa_height_ft').value || '0', 10);
    const heightIn = parseInt(document.getElementById('wa_height_in').value || '0', 10);
    const weightLb = parseFloat(document.getElementById('wa_weight_lb').value || '0');
    const goal = document.getElementById('wa_goal').value;
    const activity = document.getElementById('wa_activity').value;
    const trainingAccess = document.getElementById('wa_training_access').value;
    const time = document.getElementById('wa_time').value;
    const sleepQuality = document.getElementById('wa_sleep_quality').value;
    const workStress = document.getElementById('wa_work_stress').value;
    const hasKids = document.getElementById('wa_has_kids').value;
    const pregnant = document.getElementById('wa_pregnant').value;
    const injury = document.getElementById('wa_injury').value;
    const experience = document.getElementById('wa_experience').value;
    const notes = document.getElementById('wa_notes').value.trim();

    if (!gender || !age || !heightFt || heightIn < 0 || !weightLb || !goal || !activity || !trainingAccess || !time || !sleepQuality || !workStress || !hasKids || !pregnant || !injury || !experience) {
      return;
    }

    const data = {
      gender,
      age,
      heightFt,
      heightIn,
      heightCm: feetInchesToCm(heightFt, heightIn),
      heightText: formatHeight(heightFt, heightIn),
      weightLb: round(weightLb),
      weightKg: poundsToKg(weightLb),
      goal,
      activity,
      trainingAccess,
      time,
      sleepQuality,
      workStress,
      hasKids,
      pregnant,
      injury,
      experience,
      notes,
      activityText: document.querySelector('#wa_activity option:checked').textContent,
      trainingAccessText: document.querySelector('#wa_training_access option:checked').textContent,
      timeText: document.querySelector('#wa_time option:checked').textContent,
      experienceText: document.querySelector('#wa_experience option:checked').textContent
    };

    data.trainingStyle =
      trainingAccess === 'gym' ? 'structured gym strength + supportive cardio' :
      trainingAccess === 'home_full' ? 'structured home strength training' :
      trainingAccess === 'home_basic' ? 'basic home strength + walking' :
      'bodyweight strength + walking';

    const weeklyPlan = getWeeklyPlan(data);
    const sleepData = getSleepSchedule(data);

    resTrainingDays.textContent = `${weeklyPlan.strengthDays} days`;
    resCardioDays.textContent = `${weeklyPlan.cardioDays} days`;
    resBedtime.textContent = sleepData.bedText;
    resWakeTime.textContent = sleepData.wakeText;

    renderTipList(overviewTips, buildOverviewTips(data, weeklyPlan, sleepData));
    renderTipList(exerciseTips, buildExerciseTips(data, weeklyPlan));
    renderTipList(recoveryTips, buildRecoveryTips(data, sleepData));

    sleepScheduleBox.innerHTML = `
      <strong>Recommended sleep schedule</strong><br>
      Aim to be in bed around <strong>${sleepData.bedText}</strong> and get up around <strong>${sleepData.wakeText}</strong>.<br>
      This gives you about <strong>${sleepData.sleepHours} hours</strong> of sleep if you are actually asleep close to bedtime.<br>
      Add <strong>${getMeditationTarget(data)}</strong> of quiet reset time daily, preferably later in the day or before bed.
    `;

    renderWeeklySchedule(weeklyPlan);
    copyPlanOutput.value = buildCopyPlan(data, weeklyPlan, sleepData);

    document.getElementById('waResultsCard').scrollIntoView({
      behavior: 'smooth',
      block: 'start'
    });
  });

  copyPlanBtn.addEventListener('click', async function () {
    copySuccessBox.style.display = 'none';

    try {
      await navigator.clipboard.writeText(copyPlanOutput.value);
      copySuccessBox.style.display = 'block';
    } catch (e) {
      copyPlanOutput.select();
      document.execCommand('copy');
      copySuccessBox.style.display = 'block';
    }
  });
});
</script>
{% endblock %}
