{% extends "templates/base.admin.twig" %}{% block body %}
<style>.cv{padding:26px;max-width:1400px}.cv-grid{display:grid;grid-template-columns:380px 1fr;gap:18px}.cv-card{background:#fff;border:1px solid #e5e7eb;border-radius:18px;padding:16px}.cv-item{display:block;border-top:1px solid #e5e7eb;padding:12px;text-decoration:none;color:#0f172a}.cv-msg{max-width:75%;padding:11px;border-radius:14px;background:#eef2ff;margin:8px 0}.cv-msg.out{margin-left:auto;background:#dcfce7}@media(max-width:800px){.cv-grid{grid-template-columns:1fr}.cv{padding:14px}}</style>
<div class="cv"><h1>Meta Conversations</h1><p>Messenger, Instagram and WhatsApp messages grounded in VNV content. Suggested replies and estimates always go through Approval Center.</p><div class="cv-grid"><aside class="cv-card">{% for item in items %}<a class="cv-item" href="?id={{ item.id }}"><strong>{{ item.channel|capitalize }} · {{ item.external_user_id }}</strong><small class="d-block">{{ item.status }} · {{ item.last_message_at }}</small><span>{{ item.last_message|slice(0,90) }}</span></a>{% else %}<p>No connected conversations yet.</p>{% endfor %}</aside><main class="cv-card">{% if selected %}{% for message in messages %}<div class="cv-msg {{ message.direction=='OUT'?'out':'' }}"><small>{{ message.direction }} · {{ message.created_at }}</small><div>{{ message.message_text }}</div></div>{% else %}<p>The conversation is waiting for processing.</p>{% endfor %}<a href="{{ path('panel/agents/approvals') }}?tab=reminders&status=PENDING">Open reply approvals</a>{% else %}<p>Select a conversation.</p>{% endif %}</main></div></div>
{% endblock %}
