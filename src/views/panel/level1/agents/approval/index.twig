{% extends "templates/base.admin.twig" %}
{% block body %}
<style>
.ar-wrap{max-width:1200px;padding:26px}.ar-hero{background:linear-gradient(135deg,#111827,#312e81);color:#fff;border-radius:24px;padding:28px;margin:16px 0 20px}.ar-pill{display:inline-block;background:rgba(255,255,255,.15);border-radius:999px;padding:6px 10px;font-weight:900;font-size:.75rem}.ar-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:18px}.ar-card{background:#fff;border:1px solid #e5e7eb;border-radius:18px;padding:20px;margin-bottom:18px}.ar-input{width:100%;border:1px solid #cbd5e1;border-radius:12px;padding:12px;margin:8px 0}.ar-btn{display:inline-block;border:0;border-radius:11px;background:#111827;color:#fff;padding:10px 14px;font-weight:850;text-decoration:none}.ar-btn.ai{background:#4f46e5}.ar-btn.ok{background:#047857}.ar-btn.light{background:#e2e8f0;color:#0f172a}.ar-actions{display:flex;gap:8px;flex-wrap:wrap}.ar-json{background:#0f172a;color:#dbeafe;border-radius:13px;padding:14px;white-space:pre-wrap;max-height:420px;overflow:auto}.ar-history{border-top:1px solid #e5e7eb;padding:12px 0}@media(max-width:800px){.ar-grid{grid-template-columns:1fr}.ar-wrap{padding:14px}}
</style>
<div class="ar-wrap">
 <a href="{{ path('panel/agents/detail') }}?key={{ approval.agent_key }}">← {{ approval.agent_name }}</a>
 <section class="ar-hero"><span class="ar-pill">{{ approval.status|replace({'_':' '}) }}</span><h1>{{ approval.title }}</h1><p>Review the agent output, edit it manually or return it with precise corrections before the final action.</p></section>
 <div class="ar-grid"><main>
  {% if draftField %}<section class="ar-card"><h2>Editable draft</h2><form method="post"><input type="hidden" name="approval_id" value="{{ approval.id }}"><input type="hidden" name="action" value="save_draft"><input type="hidden" name="draft_field" value="{{ draftField }}"><textarea class="ar-input" rows="14" name="draft_value">{{ draftValue }}</textarea><button class="ar-btn">Save manual changes</button></form></section>{% endif %}
  <section class="ar-card"><h2>Complete payload</h2><pre class="ar-json">{{ payloadPretty }}</pre></section>
  <section class="ar-card"><h2>Request corrections from the agent</h2><form method="post" data-processing><input type="hidden" name="approval_id" value="{{ approval.id }}"><input type="hidden" name="action" value="request_revision"><textarea class="ar-input" rows="5" name="review_note" required placeholder="Example: make the tone warmer, mention the event date and remove the payment paragraph."></textarea><button class="ar-btn ai">Process corrections</button></form></section>
 </main><aside>
  <section class="ar-card"><h2>Decision</h2><p>Approval and execution are separate. Nothing is published until you use the final-action button.</p><div class="ar-actions">{% if approval.status == 'PENDING' %}<form method="post"><input type="hidden" name="approval_id" value="{{ approval.id }}"><button class="ar-btn ok" name="action" value="approve">Approve draft</button></form><form method="post"><input type="hidden" name="approval_id" value="{{ approval.id }}"><button class="ar-btn light" name="action" value="reject">Reject</button></form>{% elseif approval.status == 'APPROVED' and canExecute %}<form method="post" data-processing><input type="hidden" name="approval_id" value="{{ approval.id }}"><input type="hidden" name="action" value="execute"><button class="ar-btn ok">Execute final action</button></form>{% endif %}<a class="ar-btn" href="{{ moduleUrl }}">Open corresponding module</a></div></section>
  {% if executions %}<section class="ar-card"><h2>Execution log</h2>{% for item in executions %}<div class="ar-history"><strong>Attempt {{ item.attempt }} · {{ item.status }}</strong><br><small>{{ item.started_at }}</small>{% if item.external_reference %}<p>Reference: {{ item.external_reference }}</p>{% endif %}{% if item.error_message %}<p class="text-danger">{{ item.error_message }}</p>{% endif %}</div>{% endfor %}</section>{% endif %}
  <section class="ar-card"><h2>Revision history</h2>{% for item in history %}<div class="ar-history"><strong>#{{ item.id }} · {{ item.status|replace({'_':' '}) }}</strong><br><small>{{ item.created_at }}</small>{% if item.review_note %}<p>{{ item.review_note }}</p>{% endif %}</div>{% else %}<p>No previous versions.</p>{% endfor %}</section>
 </aside></div>
</div>
<script>document.querySelectorAll('[data-processing]').forEach(function(form){form.addEventListener('submit',function(){const button=this.querySelector('button');button.disabled=true;button.textContent='Processing…'})});</script>
{% endblock %}
