{% extends "templates/base.admin.twig" %}
{% block body %}
<style>
.ac{max-width:1400px;padding:26px}.ac-hero{padding:28px;border-radius:25px;background:linear-gradient(135deg,#0f172a,#312e81);color:#fff}.ac-tabs,.ac-stats,.ac-actions{display:flex;gap:9px;flex-wrap:wrap}.ac-tab,.ac-btn{padding:10px 14px;border-radius:12px;text-decoration:none;border:0;font-weight:850}.ac-tab{background:#eef2ff;color:#3730a3}.ac-tab.on,.ac-btn{background:#111827;color:#fff}.ac-stats{margin:16px 0}.ac-stat{background:#fff;border:1px solid #e5e7eb;border-radius:16px;padding:14px;min-width:130px}.ac-card{display:grid;grid-template-columns:36px 1fr auto;gap:13px;align-items:start;background:#fff;border:1px solid #e5e7eb;border-radius:17px;padding:16px;margin:10px 0}.ac-meta{color:#64748b;font-size:.82rem}.ac-badge{display:inline-block;border-radius:999px;background:#ede9fe;color:#5b21b6;padding:5px 8px;font-size:.7rem;font-weight:900}.ac-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:14px 0}.ac-search{display:flex;gap:8px;flex:1;max-width:620px}.ac-search input{border:1px solid #cbd5e1;border-radius:12px;padding:10px 12px;flex:1}.ac-pagination{display:flex;align-items:center;justify-content:center;gap:9px;margin-top:20px}.ac-muted{color:#64748b}.ac-select-all{display:flex;align-items:center;gap:7px;font-weight:800}@media(max-width:700px){.ac{padding:14px}.ac-card{grid-template-columns:28px 1fr}.ac-card>a{grid-column:2}.ac-toolbar{align-items:stretch;flex-direction:column}}
</style>
<div class="ac"><section class="ac-hero"><h1>Approval Center</h1><p>One place to review social posts, estimates, reminders, content and operations before anything leaves VNV Events.</p></section>
<div class="ac-stats"><div class="ac-stat"><strong>{{ counts.pending|default(0) }}</strong><br>Pending</div><div class="ac-stat"><strong>{{ counts.approved|default(0) }}</strong><br>Approved</div><div class="ac-stat"><strong>{{ counts.executed|default(0) }}</strong><br>Executed</div><div class="ac-stat"><strong>{{ counts.rejected|default(0) }}</strong><br>Rejected</div></div>
<nav class="ac-tabs">{% for key,label in {'all':'All','social':'Social','estimates':'Estimates','reminders':'Reminders','content':'Content','operations':'Operations'} %}<a class="ac-tab {{ tab==key?'on':'' }}" href="?tab={{ key }}&status={{ status }}&q={{ search|url_encode }}">{{ label }}</a>{% endfor %}</nav>
<nav class="ac-tabs mt-2">{% for value in ['PENDING','APPROVED','EXECUTED','REJECTED'] %}<a class="ac-tab {{ status==value?'on':'' }}" href="?tab={{ tab }}&status={{ value }}&q={{ search|url_encode }}">{{ value|capitalize }}</a>{% endfor %}</nav>
<div class="ac-toolbar"><form method="get" class="ac-search"><input type="hidden" name="tab" value="{{ tab }}"><input type="hidden" name="status" value="{{ status }}"><input name="q" value="{{ search }}" placeholder="Search by client, order, action or agent"><button class="ac-btn">Search</button>{% if search %}<a class="ac-tab" href="?tab={{ tab }}&status={{ status }}">Clear</a>{% endif %}</form><span class="ac-muted">{{ total }} result{{ total==1?'':'s' }} · page {{ page }} of {{ pages }}</span></div>
<form method="post" class="mt-3" data-approval-form><input type="hidden" name="tab" value="{{ tab }}"><input type="hidden" name="status" value="{{ status }}"><div class="ac-actions"><label class="ac-select-all"><input type="checkbox" data-select-all> Select this page</label>{% if status=='PENDING' %}<button class="ac-btn" name="bulk_action" value="approve">Approve selected</button><button class="ac-btn" name="bulk_action" value="reject">Reject selected</button>{% elseif status=='APPROVED' %}<button class="ac-btn" name="bulk_action" value="execute">Execute selected</button>{% endif %}</div>
{% for item in items %}<label class="ac-card"><input type="checkbox" name="approval_ids[]" value="{{ item.id }}"><div><span class="ac-badge">{{ item.action_type|replace({'_':' '}) }}</span><h3 class="h6 mt-2">{{ item.title }}</h3><div class="ac-meta">{{ item.agent_name }} · {{ item.created_at }} · {{ item.status }}</div></div><a href="{{ path('panel/agents/approval') }}?id={{ item.id }}">Review</a></label>{% else %}<p class="mt-4">Nothing in this view.</p>{% endfor %}</form>{% if pages>1 %}<nav class="ac-pagination">{% if page>1 %}<a class="ac-tab" href="?tab={{ tab }}&status={{ status }}&q={{ search|url_encode }}&page={{ page-1 }}">← Previous</a>{% endif %}<strong>{{ page }} / {{ pages }}</strong>{% if page<pages %}<a class="ac-tab" href="?tab={{ tab }}&status={{ status }}&q={{ search|url_encode }}&page={{ page+1 }}">Next →</a>{% endif %}</nav>{% endif %}</div>
<script>document.querySelector('[data-select-all]')?.addEventListener('change',function(){document.querySelectorAll('[data-approval-form] [name="approval_ids[]"]').forEach(box=>box.checked=this.checked)});document.querySelector('[data-approval-form]')?.addEventListener('submit',function(event){if(!this.querySelector('[name="approval_ids[]"]:checked')){event.preventDefault();alert('Select at least one item first.')}});</script>
{% endblock %}
