{% extends "templates/layouts/panel.twig" %}
{% block panel %}
<div class="container-fluid py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h3 mb-1">Lead Intake</h1><p class="text-muted mb-0">Pre-CRM requests from ManyChat and future channels. Availability is based on eligible Main Managers.</p></div></div>
<div class="card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Lead</th><th>Request</th><th>Schedule</th><th>Availability</th><th>Suggested manager</th><th></th></tr></thead><tbody>
{% for lead in leads %}<tr><td><strong>{{ lead.contact_name ?: 'Unknown' }}</strong><br><small>{{ lead.channel }} · {{ lead.email ?: lead.phone }}</small></td><td>{{ lead.service_requested ?: 'Not specified' }}<br><small>{{ lead.guest_count ? lead.guest_count ~ ' guests' : '' }} {{ lead.venue }}</small></td><td>{{ lead.event_date ?: 'Incomplete' }}<br><small>{{ lead.start_time }}{% if lead.end_time %}–{{ lead.end_time }}{% endif %} · setup {{ lead.setup_minutes }} min</small></td><td><span class="badge {{ lead.availability_status == 'AVAILABLE' ? 'bg-success' : (lead.availability_status == 'NEEDS_MANUAL_REVIEW' ? 'bg-warning text-dark' : 'bg-danger') }}">{{ lead.availability_status|replace({'_':' '}) }}</span><br><small>{{ lead.availability_checked_at ?: 'Not checked' }}</small></td><td>{{ lead.manager_name ?: 'Manual review' }}</td><td><div class="d-flex gap-2">{% if lead.event_date and lead.start_time and lead.end_time %}<form method="post"><input type="hidden" name="id" value="{{ lead.id }}"><button class="btn btn-sm btn-outline-primary">Recheck</button></form>{% endif %}{% if lead.availability_status == 'AVAILABLE' and not lead.converted_order_id %}<a class="btn btn-sm btn-primary" href="{{ path('panel/planner-hub/management/orders/orders/create?lead_intake_id=' ~ lead.id) }}">Create estimate</a>{% elseif lead.converted_order_id %}<span class="badge bg-secondary">Order #{{ lead.converted_order_id }}</span>{% endif %}</div></td></tr>{% else %}<tr><td colspan="6" class="text-center py-5 text-muted">No Lead Intake requests yet.</td></tr>{% endfor %}
</tbody></table></div></div></div>
{% endblock %}
