{% extends 'templates/base.admin.twig' %}
{% block page_title %}Productions Management Center · VNV Events{% endblock %}
{% block style %}
{{ parent() }}
<style>
.pmc-shell{max-width:1440px;margin:auto;padding:clamp(16px,3vw,44px);color:#172c34}
.pmc-head{border-bottom:2px solid #14635c;padding-bottom:1rem;margin-bottom:1rem}
.pmc-head h1{font-size:clamp(1.65rem,3vw,2.65rem);font-weight:700;letter-spacing:-.035em;margin:0}
.pmc-nav{display:flex;flex-wrap:wrap;gap:.35rem;margin:0 0 1.5rem}
.pmc-nav a{padding:.45rem .75rem;color:#19443f;border:1px solid #baccc8;border-radius:.4rem;font-weight:600;text-decoration:none}
.pmc-nav a[aria-current=page]{background:#15554d;color:#fff;border-color:#15554d}
.pmc-shell a:focus-visible,.pmc-shell button:focus-visible{outline:3px solid #c18c27;outline-offset:2px}
.pmc-shell .table-responsive{overflow:auto}
.pmc-delegate{padding:1rem;border:1px solid #c7d7d4;border-radius:.6rem;background:#fff;margin:.6rem 0}
.pmc-delegate summary{cursor:pointer;font-weight:650}.pmc-delegate label{display:block;padding:.35rem}
@media print{.sidebar,.navbar,.pmc-nav,.footer,.pmc-shell form,.pmc-shell button,.pmc-private{display:none!important}.pmc-shell,main.content{margin:0;padding:0;max-width:none}}
</style>
{% endblock %}
{% block body %}
<main class="pmc-shell" aria-labelledby="pmc-title">
  <header class="pmc-head"><h1 id="pmc-title">Productions Management Center</h1></header>
  <nav class="pmc-nav" aria-label="Productions sections">{% for key,label in tabs %}
    <a href="{{ pmc_url }}?tab={{ key }}" {% if key == pmc_tab %}aria-current="page"{% endif %}>{{ label }}</a>
  {% endfor %}</nav>
  {% if notice %}<div class="alert alert-{{ notice.type }}" role="status">{{ notice.message }}
    {% if notice.invitation_code %}<div class="pmc-private"><label for="pmc-invite">Copy this private invitation now</label><input class="form-control" id="pmc-invite" readonly value="{{ notice.invitation_code }}" autocomplete="off"></div>{% endif %}
  </div>{% endif %}
  {% if load_error %}<p class="alert alert-warning">{{ load_error }}</p>
  {% elseif pmc_tab == 'access' %}
    <h2>Team access</h2><p>Select a team member to grant or withdraw Productions access. Changes take effect on their next request.</p>
    {% for member in staff %}<details class="pmc-delegate" id="member-{{ member.id }}" {% if selected_staff == member.id %}open{% endif %}><summary>{{ member.name }} · {{ 'pmc_center' in member.grants ? 'Access enabled' : 'Access off' }}</summary>
      <form method="post" action="{{ pmc_url }}"><input type="hidden" name="_csrf" value="{{ csrf_token }}"><input type="hidden" name="tab" value="access"><input type="hidden" name="action" value="delegation.save"><input type="hidden" name="staff_id" value="{{ member.id }}">
        <fieldset class="mt-3"><legend class="h5">Permissions for {{ member.name }}</legend>{% for slug,label in grant_labels %}
        <label><input type="checkbox" name="grants[]" value="{{ slug }}" {% if slug in member.grants %}checked{% endif %}> {{ label }}</label>{% endfor %}</fieldset>
        <button class="btn btn-primary mt-2">Save access</button></form>
    </details>{% else %}<p>No active team members.</p>{% endfor %}
  {% elseif pmc_tab == 'onboarding' %}{% include 'templates/components/pmc/onboarding.twig' %}
  {% elseif pmc_tab in ['accounts','demo'] %}{% include 'templates/components/pmc/accounts.twig' %}
  {% else %}{% include 'templates/components/pmc/workboard.twig' %}
    {% if pmc_tab in ['overview','reports'] %}<section class="card mt-4"><div class="card-body">
    <h2 class="h4">Workspace accounts and onboarding</h2>
    {% if portfolio.available %}<div class="row g-3">{% for key,item in {
      demo:['Demo accounts','demo'],active:['Active accounts','accounts'],pending_requests:['Lifecycle requests','accounts'],
      onboarding_pending:['Onboarding pending','onboarding'],onboarding_complete:['Onboarding complete','onboarding']} %}
      <div class="col-6 col-lg"><a href="{{ pmc_url }}?tab={{ item[1] }}"><strong class="d-block h4 mb-0">{{ portfolio[key] is not null ? portfolio[key] : '?' }}</strong>{{ item[0] }}</a></div>
    {% endfor %}</div>{% else %}<p class="mb-0">Workspace totals are unavailable while the private registry is disconnected.</p>{% endif %}
    </div></section>{% endif %}
{% endif %}
</main>
{% endblock %}
