{% extends "templates/base.admin.twig" %}
{% block body %}
<style>
:root{--vsl-ink:#0f172a;--vsl-purple:#5546e8;--vsl-mint:#49f2c2;--vsl-line:#e2e8f0}.vsl{max-width:1500px;padding:24px}.vsl a{text-decoration:none}.vsl-head{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:20px}.vsl-head h1{font-size:1.8rem;font-weight:950;margin:0}.vsl-head p,.vsl-help{color:#64748b;line-height:1.55}.vsl-actions{display:flex;gap:9px;flex-wrap:wrap}.vsl-btn{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:11px;background:var(--vsl-ink);color:#fff!important;padding:10px 14px;font-weight:850;cursor:pointer}.vsl-btn.primary{background:var(--vsl-purple)}.vsl-btn.light{background:#eef2ff;color:#3730a3!important}.vsl-btn:disabled{opacity:.45}.vsl-card{background:#fff;border:1px solid var(--vsl-line);border-radius:18px;padding:20px;box-shadow:0 10px 30px rgba(15,23,42,.04)}.vsl-create{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(300px,.6fr);gap:18px}.vsl-drop{display:grid;place-items:center;min-height:260px;border:2px dashed #a5b4fc;border-radius:18px;background:linear-gradient(145deg,#eef2ff,#f0fdfa);text-align:center;padding:28px;cursor:pointer;transition:.2s}.vsl-drop.drag{border-color:#5546e8;background:#e0e7ff;transform:scale(1.005)}.vsl-drop-icon{font-size:2.5rem}.vsl-input{width:100%;border:1px solid #cbd5e1;border-radius:11px;padding:11px 12px;margin:6px 0;background:#fff}.vsl-upload-state{display:none;margin-top:15px}.vsl-upload-state.show{display:block}.vsl-progress{height:14px;border-radius:999px;background:#e2e8f0;overflow:hidden}.vsl-progress span{display:block;height:100%;width:0;background:linear-gradient(90deg,#5546e8,#49f2c2);transition:width .15s}.vsl-progress-meta{display:flex;justify-content:space-between;margin-top:7px;color:#475569;font-size:.78rem;font-weight:800}.vsl-path{display:block;background:#0f172a;color:var(--vsl-mint);padding:12px;border-radius:10px;overflow:auto}.vsl-folder{display:flex;align-items:center;justify-content:space-between;gap:12px;border-top:1px solid var(--vsl-line);padding:14px 0}.vsl-library{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.vsl-project{display:flex;flex-direction:column;min-height:205px;border:1px solid var(--vsl-line);border-radius:16px;padding:17px;color:var(--vsl-ink);transition:.2s}.vsl-project:hover{transform:translateY(-2px);border-color:#a5b4fc;box-shadow:0 14px 30px rgba(79,70,229,.1)}.vsl-project h3{font-size:1.05rem;font-weight:900;margin:12px 0 4px}.vsl-project p{color:#64748b;flex:1}.vsl-project-actions{display:flex;gap:7px;flex-wrap:wrap}.vsl-project-actions .vsl-btn{font-size:.74rem;padding:8px 10px}.vsl-mini-form{display:none;margin-top:8px;padding:9px;background:#f8fafc;border-radius:10px}.vsl-mini-form.open{display:block}.vsl-status{display:inline-block;width:max-content;border-radius:999px;background:#eef2ff;color:#4338ca;font-size:.7rem;font-weight:950;padding:5px 8px}.vsl-empty{text-align:center;padding:38px;color:#64748b}.vsl-assets{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}.vsl-asset{border:1px solid var(--vsl-line);border-radius:14px;overflow:hidden;background:#f8fafc}.vsl-asset img,.vsl-asset video{display:block;width:100%;aspect-ratio:16/10;object-fit:contain;background:#0f172a}.vsl-asset-meta{padding:10px}.vsl-asset-meta strong{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.vsl-asset-meta small{color:#64748b}@media(max-width:950px){.vsl-create{grid-template-columns:1fr}.vsl-library{grid-template-columns:1fr 1fr}.vsl-assets{grid-template-columns:repeat(3,1fr)}}@media(max-width:650px){.vsl{padding:13px}.vsl-head{align-items:flex-start;flex-direction:column}.vsl-library,.vsl-assets{grid-template-columns:1fr}}
</style>
<div class="vsl">
 <header class="vsl-head"><div><a href="{{ path('panel/growth-hub') }}">← Growth Hub</a><h1>Video projects</h1><p>Create, duplicate and edit projects without handling server folders. Original masters remain untouched.</p></div><div class="vsl-actions"><a class="vsl-btn" href="{{ path('panel/growth-hub/distribution') }}">Social Media Studio</a></div></header>
 <section class="vsl-card vsl-create">
  <div><h2>Create a video project</h2><p class="vsl-help">Upload the master directly. Large files are sent in small resumable chunks so PHP never has to receive the entire video in one request.</p><input class="vsl-input" name="browser_project_title" placeholder="Project name, e.g. Local Tech Lab Episode 7" data-upload-title><label class="vsl-drop" data-upload-drop><input type="file" accept="video/mp4,video/quicktime,video/x-matroska,video/webm,video/x-msvideo,video/mp2t,.mkv,.m4v,.mts,.m2ts,.mpg,.mpeg" hidden data-upload-file><span><span class="vsl-drop-icon">⬆</span><strong class="d-block mt-2" data-upload-file-name>Choose or drop the master video</strong><small class="vsl-help">MP4, MOV, MKV, WebM, AVI, MTS and MPEG · up to {{ browserUploadMaxGb }} GB</small></span></label><button class="vsl-btn primary mt-3" disabled data-upload-start>Upload and create project</button><div class="vsl-upload-state" data-upload-state><strong data-upload-message>Preparing upload…</strong><div class="vsl-progress mt-2"><span data-upload-bar></span></div><div class="vsl-progress-meta"><span data-upload-percent>0%</span><span data-upload-detail></span></div></div></div>
  <aside><h3>What happens next?</h3><ol class="vsl-help"><li>The original uploads privately.</li><li>A lightweight editing proxy is generated.</li><li>Transcription, visual trimming and AI tools become available.</li><li>Final export always uses the full-quality master.</li></ol><p class="vsl-help"><strong>You may leave the original name behind.</strong> The project uses the clear name entered above, and it can be renamed or duplicated later.</p><p style="color:{{ renderReady?'#047857':'#dc2626' }};font-weight:850">{{ renderReady?'FFmpeg is ready.':'FFmpeg is unavailable.' }}</p></aside>
 </section>
 <details class="vsl-card mt-3"><summary><strong>Advanced server/SFTP import</strong> <span class="vsl-help">· optional fallback</span></summary><p class="vsl-help mt-3">Use this only when a connection interruption prevents browser upload.</p>{% if ingestError %}<div class="alert alert-danger">{{ ingestError }}</div>{% else %}<code class="vsl-path">{{ ingestRoot }}</code><form method="post" class="vsl-actions mt-2"><input type="hidden" name="action" value="create_server_folder"><input class="vsl-input" style="margin:0;max-width:430px" name="folder_name" placeholder="New project folder name" required><button class="vsl-btn">Create server folder</button></form>{% endif %}{% for folder in ingestFolders %}<div class="vsl-folder"><div><strong>{{ folder.name }}</strong><small class="d-block vsl-help">{{ folder.files|length }} files · {{ (folder.total_bytes/1073741824)|number_format(2) }} GB · {{ folder.ready_count }} source ready</small></div><form method="post"><input type="hidden" name="action" value="import_server_folder"><input type="hidden" name="folder_name" value="{{ folder.name }}"><button class="vsl-btn primary" {% if not folder.ready_count %}disabled{% endif %}>Import</button></form></div>{% endfor %}</details>
 <section class="vsl-card mt-3"><header class="vsl-head"><div><h2>Project library</h2><p>{{ jobs|length }} projects · open, rename or create an independent working copy</p></div></header><div class="vsl-library">{% for job in jobs %}<article class="vsl-project"><span class="vsl-status">{{ job.project_kind=='reel'?'REEL · ':'' }}{{ job.status }}</span><h3>{{ job.title }}</h3><p>#{{ job.id }} · {{ job.source_name }}<br>{{ job.created_at }}{% if job.parent_project_id %}<br>Derived from #{{ job.parent_project_id }}{% endif %}</p><div class="vsl-project-actions"><a class="vsl-btn primary" href="?project={{ job.id }}">Open editor</a><button class="vsl-btn light" type="button" data-toggle-form="rename-{{ job.id }}">Rename</button><button class="vsl-btn light" type="button" data-toggle-form="duplicate-{{ job.id }}">Duplicate</button></div><form method="post" class="vsl-mini-form" id="rename-{{ job.id }}"><input type="hidden" name="action" value="rename_project"><input type="hidden" name="id" value="{{ job.id }}"><input class="vsl-input" name="project_title" value="{{ job.title }}" maxlength="180" required><button class="vsl-btn">Save name</button></form><form method="post" class="vsl-mini-form" id="duplicate-{{ job.id }}"><input type="hidden" name="action" value="duplicate_project"><input type="hidden" name="id" value="{{ job.id }}"><input class="vsl-input" name="duplicate_title" value="{{ job.title }} — copy" maxlength="180" required><button class="vsl-btn">Create copy</button></form></article>{% else %}<div class="vsl-empty">Upload the first video to begin.</div>{% endfor %}</div></section>
 <details class="vsl-card mt-3"><summary><strong>Reusable media bank</strong> <span class="vsl-help">· logos, images and short supporting clips</span></summary><form method="post" enctype="multipart/form-data" class="mt-3"><input type="hidden" name="action" value="upload_asset"><select class="vsl-input" name="asset_type"><option value="IMAGE">Image</option><option value="TRANSPARENT_PNG">Transparent PNG</option><option value="SHORT_VIDEO">Short video · maximum 10 seconds</option><option value="LOGO">Logo</option><option value="OVERLAY">Overlay</option><option value="AUDIO">Audio</option></select><input class="vsl-input" name="asset_name" placeholder="Descriptive asset name"><input class="vsl-input" type="file" name="asset" accept="image/png,image/jpeg,image/webp,video/mp4,video/quicktime,video/webm,video/x-matroska,audio/mpeg,audio/wav" required><button class="vsl-btn">Add to media bank</button></form><div class="vsl-assets mt-3">{% for asset in assets %}<article class="vsl-asset">{% if asset.mime_type starts with 'video/' %}<video src="{{ asset.asset_url }}" preload="metadata" muted controls></video>{% elseif asset.mime_type starts with 'image/' %}<img src="{{ asset.asset_url }}" alt="{{ asset.name }}" loading="lazy">{% else %}<div class="vsl-empty">Audio</div>{% endif %}<div class="vsl-asset-meta"><strong>{{ asset.name }}</strong><small>{{ asset.asset_type }}</small></div></article>{% else %}<div class="vsl-empty">No reusable assets yet.</div>{% endfor %}</div></details>
</div>
<script>
document.querySelectorAll('[data-toggle-form]').forEach(button=>button.addEventListener('click',()=>document.getElementById(button.dataset.toggleForm)?.classList.toggle('open')));
const drop=document.querySelector('[data-upload-drop]'),fileInput=document.querySelector('[data-upload-file]'),startButton=document.querySelector('[data-upload-start]'),titleInput=document.querySelector('[data-upload-title]'),state=document.querySelector('[data-upload-state]'),bar=document.querySelector('[data-upload-bar]'),percent=document.querySelector('[data-upload-percent]'),detail=document.querySelector('[data-upload-detail]'),message=document.querySelector('[data-upload-message]'),fileName=document.querySelector('[data-upload-file-name]');let selectedFile=null;
const formatBytes=value=>value>=1073741824?(value/1073741824).toFixed(2)+' GB':(value/1048576).toFixed(1)+' MB';
function choose(file){selectedFile=file||null;if(!file)return;fileName.textContent=file.name+' · '+formatBytes(file.size);if(!titleInput.value.trim())titleInput.value=file.name.replace(/\.[^.]+$/,'').replace(/[-_]+/g,' ');startButton.disabled=false}
drop?.addEventListener('click',()=>fileInput.click());fileInput?.addEventListener('change',()=>choose(fileInput.files[0]));['dragenter','dragover'].forEach(name=>drop?.addEventListener(name,event=>{event.preventDefault();drop.classList.add('drag')}));['dragleave','drop'].forEach(name=>drop?.addEventListener(name,event=>{event.preventDefault();drop.classList.remove('drag')}));drop?.addEventListener('drop',event=>choose(event.dataTransfer.files[0]));
async function send(form,retries=3){for(let attempt=0;attempt<retries;attempt++){try{const response=await fetch("{{ path('panel/growth-hub/video-studio/upload') }}",{method:'POST',body:form,headers:{'X-Requested-With':'XMLHttpRequest'}}),result=await response.json();if(!response.ok||!result.success)throw new Error(result.message||'Upload failed');return result}catch(error){if(attempt===retries-1)throw error;await new Promise(resolve=>setTimeout(resolve,1000*(attempt+1)))}}}
startButton?.addEventListener('click',async()=>{if(!selectedFile)return;const chunkSize=5*1024*1024,totalChunks=Math.ceil(selectedFile.size/chunkSize),uploadId=[...crypto.getRandomValues(new Uint8Array(16))].map(value=>value.toString(16).padStart(2,'0')).join('');startButton.disabled=true;state.classList.add('show');message.textContent='Preparing secure upload…';const started=performance.now();try{let form=new FormData();form.append('upload_action','init');form.append('upload_id',uploadId);form.append('title',titleInput.value.trim());form.append('filename',selectedFile.name);form.append('total_bytes',String(selectedFile.size));form.append('total_chunks',String(totalChunks));await send(form);for(let index=0;index<totalChunks;index++){const from=index*chunkSize,to=Math.min(selectedFile.size,from+chunkSize);form=new FormData();form.append('upload_action','chunk');form.append('upload_id',uploadId);form.append('chunk_index',String(index));form.append('chunk',selectedFile.slice(from,to),selectedFile.name+'.part');const result=await send(form);const uploaded=to,progress=Math.round(uploaded/selectedFile.size*100),seconds=Math.max(.1,(performance.now()-started)/1000),speed=uploaded/seconds,remaining=speed>0?(selectedFile.size-uploaded)/speed:0;bar.style.width=progress+'%';percent.textContent=progress+'%';detail.textContent=formatBytes(uploaded)+' / '+formatBytes(selectedFile.size)+' · '+formatBytes(speed)+'/s · '+Math.ceil(remaining)+'s left';message.textContent=result.complete?'Upload complete. Opening the editor…':'Uploading chunk '+(index+1)+' of '+totalChunks;if(result.complete){location.href='{{ path('panel/growth-hub/video-studio') }}?project='+result.project_id+'&autoproxy=1';return}}}catch(error){message.textContent=error.message;message.style.color='#b91c1c';startButton.disabled=false;startButton.textContent='Retry upload'}});
</script>
{% endblock %}
