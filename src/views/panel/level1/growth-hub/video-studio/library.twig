{% extends "templates/base.admin.twig" %}
{% block body %}
<style>
:root{--vsl-ink:#0f172a;--vsl-purple:#5546e8;--vsl-mint:#49f2c2;--vsl-line:#e2e8f0}.vsl{max-width:1500px;padding:24px}.vsl a{text-decoration:none}.vsl-head{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:20px}.vsl-head h1{font-size:1.8rem;font-weight:950;margin:0}.vsl-head p,.vsl-help{color:#64748b;line-height:1.55}.vsl-actions{display:flex;gap:9px;flex-wrap:wrap}.vsl-btn{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:11px;background:var(--vsl-ink);color:#fff!important;padding:10px 14px;font-weight:850;cursor:pointer}.vsl-btn.primary{background:var(--vsl-purple)}.vsl-btn.light{background:#eef2ff;color:#3730a3!important}.vsl-btn:disabled{opacity:.45}.vsl-card{background:#fff;border:1px solid var(--vsl-line);border-radius:18px;padding:20px;box-shadow:0 10px 30px rgba(15,23,42,.04)}.vsl-import{display:grid;grid-template-columns:1.25fr .75fr;gap:18px}.vsl-input{width:100%;border:1px solid #cbd5e1;border-radius:11px;padding:11px 12px;margin:6px 0;background:#fff}.vsl-path{display:block;background:#0f172a;color:var(--vsl-mint);padding:12px;border-radius:10px;overflow:auto}.vsl-folder{display:flex;align-items:center;justify-content:space-between;gap:12px;border-top:1px solid var(--vsl-line);padding:14px 0}.vsl-library{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.vsl-project{display:flex;flex-direction:column;min-height:185px;border:1px solid var(--vsl-line);border-radius:16px;padding:17px;color:var(--vsl-ink);transition:.2s}.vsl-project:hover{transform:translateY(-2px);border-color:#a5b4fc;box-shadow:0 14px 30px rgba(79,70,229,.1)}.vsl-project h3{font-size:1.05rem;font-weight:900;margin-top:12px}.vsl-project p{color:#64748b;flex:1}.vsl-status{display:inline-block;width:max-content;border-radius:999px;background:#eef2ff;color:#4338ca;font-size:.7rem;font-weight:950;padding:5px 8px}.vsl-empty{text-align:center;padding:38px;color:#64748b}@media(max-width:950px){.vsl-import{grid-template-columns:1fr}.vsl-library{grid-template-columns:1fr 1fr}}@media(max-width:650px){.vsl{padding:13px}.vsl-head{align-items:flex-start;flex-direction:column}.vsl-library{grid-template-columns:1fr}}
</style>
<div class="vsl">
 <header class="vsl-head"><div><a href="{{ path('panel/growth-hub') }}">← Growth Hub</a><h1>Video projects</h1><p>Import footage, then open a project in the editor.</p></div><div class="vsl-actions"><a class="vsl-btn light" href="{{ path('panel/growth-hub/distribution') }}?mode=short-video">Short Reels</a><a class="vsl-btn" href="{{ path('panel/growth-hub/distribution') }}">Social Media Studio</a></div></header>
 <section class="vsl-import">
  <div class="vsl-card"><h2>Private SFTP inbox</h2><p class="vsl-help">Create one folder per project. Put the main recording in source/ and optional files in intros/, transitions/, b-roll/, images/, music/, sound-effects/, voice-over/ or outros/.</p>{% if ingestError %}<div class="alert alert-danger">{{ ingestError }}</div>{% else %}<code class="vsl-path">{{ ingestRoot }}</code>{% endif %}{% for folder in ingestFolders %}<div class="vsl-folder"><div><strong>{{ folder.name }}</strong><small class="d-block vsl-help">{{ folder.files|length }} files · {{ (folder.total_bytes/1073741824)|number_format(2) }} GB · {{ folder.ready_count }} source ready</small></div><form method="post"><input type="hidden" name="action" value="import_server_folder"><input type="hidden" name="folder_name" value="{{ folder.name }}"><button class="vsl-btn primary" {% if not folder.ready_count %}disabled{% endif %}>Import</button></form></div>{% else %}<div class="vsl-empty">No SFTP projects are ready.</div>{% endfor %}</div>
  <div class="vsl-card"><details open><summary><strong>Small-file upload</strong></summary><p class="vsl-help">Only for files below 250 MB.</p><form method="post" enctype="multipart/form-data"><input type="hidden" name="action" value="upload"><input class="vsl-input" name="title" placeholder="Project title"><input class="vsl-input" type="file" name="media" accept="video/*,audio/*" required><button class="vsl-btn">Upload</button></form></details><hr><details><summary><strong>Reusable brand asset</strong></summary><form method="post" enctype="multipart/form-data"><input type="hidden" name="action" value="upload_asset"><select class="vsl-input" name="asset_type"><option>LOGO</option><option>INTRO</option><option>OUTRO</option><option>OVERLAY</option><option>AUDIO</option></select><input class="vsl-input" name="asset_name" placeholder="Asset name"><input class="vsl-input" type="file" name="asset" required><button class="vsl-btn">Upload asset</button></form></details><p class="mt-3" style="color:{{ renderReady?'#047857':'#dc2626' }};font-weight:850">{{ renderReady?'FFmpeg is ready.':'FFmpeg is unavailable.' }}</p></div>
 </section>
 <section class="vsl-card mt-3"><header class="vsl-head"><div><h2>Project library</h2><p>{{ jobs|length }} available projects</p></div></header><div class="vsl-library">{% for job in jobs %}<a class="vsl-project" href="?project={{ job.id }}"><span class="vsl-status">{{ job.status }}</span><h3>#{{ job.id }} · {{ job.title }}</h3><p>{{ job.source_name }}<br>{{ job.created_at }}</p><strong>Open editor →</strong></a>{% else %}<div class="vsl-empty">Import your first project to begin.</div>{% endfor %}</div></section>
</div>
{% endblock %}
