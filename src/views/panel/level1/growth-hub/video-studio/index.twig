{% extends "templates/base.admin.twig" %}
{% block body %}
<style>
.vs-wrap{padding:26px;max-width:1540px}.vs-hero{background:linear-gradient(135deg,#111827,#312e81);border-radius:26px;color:#fff;padding:30px;margin-bottom:20px}.vs-hero h1{font-weight:950}.vs-hero p{color:rgba(255,255,255,.7)}.vs-card{background:#fff;border:1px solid #e5e7eb;border-radius:20px;padding:20px;margin-bottom:18px}.vs-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.vs-input{border:1px solid #d1d5db;border-radius:12px;padding:11px;width:100%;margin:7px 0}.vs-btn{border:0;border-radius:11px;background:#111827;color:#fff;font-weight:850;padding:10px 14px;cursor:pointer}.vs-btn.alt{background:#4f46e5}.vs-job{display:none;border:1px solid #e5e7eb;border-radius:20px;padding:20px;margin:18px 0;box-shadow:0 12px 30px rgba(15,23,42,.05)}.vs-job.active{display:block}.vs-status{border-radius:999px;background:#eef2ff;color:#4338ca;font-size:.72rem;font-weight:900;padding:5px 8px}.vs-video{width:100%;max-height:540px;background:#000;border-radius:14px}.vs-preview-wrap{position:relative;background:#000;border-radius:14px;overflow:hidden}.vs-preview-wrap .vs-video{display:block}.vs-overlay-stage{position:absolute;inset:0;pointer-events:none}.vs-overlay-stage canvas{pointer-events:auto}.vs-overlay-tools{display:flex;gap:7px;align-items:center;margin-top:9px}.vs-overlay-tools input{flex:1}.vs-actions{display:flex;gap:8px;flex-wrap:wrap}.vs-plan{background:#0f172a;color:#dbeafe;border-radius:14px;padding:14px;white-space:pre-wrap;max-height:360px;overflow:auto}.vs-muted{color:#64748b}.vs-tools{background:#f8fafc;border:1px solid #e2e8f0;border-radius:16px;padding:15px;margin:13px 0}.vs-step{display:inline-flex;border-radius:999px;background:#ede9fe;color:#5b21b6;padding:6px 9px;font-size:.72rem;font-weight:900}.vs-projects{display:flex;gap:9px;overflow:auto;padding:4px 2px 14px;position:sticky;top:0;z-index:20;background:#fff}.vs-project-tab{min-width:190px;text-align:left;border:1px solid #dbe2ea;background:#f8fafc;border-radius:14px;padding:11px 13px;cursor:pointer}.vs-project-tab.active{color:#fff;background:#312e81;border-color:#312e81}.vs-project-tab small{display:block;opacity:.72}.vs-wave-shell{background:#0f172a;border-radius:16px;padding:13px;margin:13px 0;color:#cbd5e1}.vs-wave{min-height:96px}.vs-timebar{display:flex;align-items:center;justify-content:space-between;gap:12px;font-variant-numeric:tabular-nums}.vs-caption-list{max-height:260px;overflow:auto;border:1px solid #e2e8f0;border-radius:12px}.vs-caption-row{display:grid;grid-template-columns:74px 1fr;gap:8px;padding:9px 11px;border:0;border-bottom:1px solid #edf2f7;width:100%;background:#fff;text-align:left}.vs-caption-row:hover,.vs-caption-row.active{background:#eef2ff}.vs-shortcuts{font-size:.78rem;color:#64748b}.vs-shortcuts kbd{background:#111827;color:#fff;border-radius:5px;padding:2px 5px}.vs-zoom{accent-color:#4f46e5}.vs-tool-tabs{display:flex;gap:7px;position:sticky;top:70px;z-index:12;background:#fff;padding:12px 0 8px}.vs-tool-tab{border:1px solid #cbd5e1;background:#fff;border-radius:999px;padding:8px 12px;font-weight:800}.vs-tool-tab.active{background:#4f46e5;border-color:#4f46e5;color:#fff}[data-editor-section][hidden]{display:none!important}@media(max-width:800px){.vs-grid{grid-template-columns:1fr}.vs-wrap{padding:14px}.vs-project-tab{min-width:155px}}
</style>
<style>
.vs-ingest{background:linear-gradient(135deg,#ecfeff,#eef2ff);border-color:#a5b4fc}.vs-path{display:block;background:#111827;color:#a7f3d0;border-radius:10px;padding:11px;overflow:auto;white-space:nowrap}.vs-folder{display:grid;grid-template-columns:1fr auto;gap:14px;align-items:center;border-top:1px solid #c7d2fe;padding:13px 0}.vs-folder:first-child{border-top:0}.vs-ready{color:#047857;font-weight:850}.vs-wait{color:#b45309;font-weight:850}.vs-assets{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:9px}.vs-asset{border:1px solid #dbe3ee;background:#fff;border-radius:12px;padding:10px;min-width:0;text-align:left}.vs-asset strong,.vs-asset small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.vs-asset-role{color:#4338ca;font-size:.68rem;font-weight:900}@media(max-width:800px){.vs-folder{grid-template-columns:1fr}}
</style>
<div class="vs-wrap">
 <a href="{{ path('panel/growth-hub') }}">← Growth Hub</a>
 <section class="vs-hero"><h1>AI Video Projects</h1><p>Each upload stays as a reusable project: transcript, captions, cuts, creative inserts, brand assets, render history and social distribution.</p></section>
 <section class="vs-card vs-ingest">
  <span class="vs-step">RECOMMENDED FOR 500 MB–10 GB</span><h2 class="mt-2">Private SFTP video inbox</h2>
  <p>Connect to the production server with SFTP, open the private directory below, create one folder per project, and upload the original videos inside it. This bypasses browser and PHP upload limits.</p>
  <code class="vs-path">{{ ingestRoot }}</code>
  <ol><li>Create a project folder and add <code>source/</code>, <code>intros/</code>, <code>transitions/</code>, <code>b-roll/</code>, <code>images/</code>, <code>music/</code>, <code>sound-effects/</code>, <code>voice-over/</code> and <code>outros/</code> as needed.</li><li>Put the principal video in <code>source/</code>. Upload with a temporary <code>.uploading</code> suffix and rename files only after SFTP finishes.</li><li>Wait {{ ingestStableSeconds }} seconds, refresh, and press <strong>Import project</strong>. Every supported file remains attached to the folder.</li></ol>
  <p class="vs-muted">Accepted originals: MP4, MOV, M4V, MKV, WebM, AVI, MTS/M2TS, MPG and MPEG. Keep at least 4× the video size free while rendering.</p>
  <div>{% for folder in ingestFolders %}<div class="vs-folder"><div><strong>{{ folder.name }}</strong><br><small>{{ folder.videos|length }} video(s) · {{ (folder.total_bytes / 1073741824)|number_format(2) }} GB · <span class="{{ folder.ready_count ? 'vs-ready':'vs-wait' }}">{{ folder.ready_count }} ready</span></small>{% for video in folder.videos %}<div class="vs-muted">{{ video.name }} · {{ (video.bytes / 1048576)|number_format(1) }} MB · {{ video.ready ? 'ready':'still uploading / stabilizing' }}</div>{% endfor %}</div><form method="post"><input type="hidden" name="action" value="import_server_folder"><input type="hidden" name="folder_name" value="{{ folder.name }}"><button class="vs-btn alt" {% if not folder.ready_count %}disabled{% endif %}>Import folder</button></form></div>{% else %}<p><strong>No project folders detected yet.</strong> Create the first folder over SFTP and refresh.</p>{% endfor %}</div>
 </section>
 <div class="vs-grid">
  <section class="vs-card"><h2>Small-file fallback</h2><form method="post" enctype="multipart/form-data"><input type="hidden" name="action" value="upload"><input class="vs-input" name="title" placeholder="Project title"><input class="vs-input" type="file" name="media" accept="video/*,audio/*" required><small>For files below 250 MB only. Use the SFTP inbox for production originals.</small><br><button class="vs-btn mt-3">Upload</button></form></section>
  <section class="vs-card"><h2>Brand assets</h2><form method="post" enctype="multipart/form-data"><input type="hidden" name="action" value="upload_asset"><select class="vs-input" name="asset_type"><option>LOGO</option><option>INTRO</option><option>OUTRO</option><option>OVERLAY</option><option>AUDIO</option></select><input class="vs-input" name="asset_name" placeholder="Asset name"><input class="vs-input" type="file" name="asset" required><button class="vs-btn">Upload reusable asset</button></form>{% if renderReady %}<p class="mt-2"><strong>FFmpeg is ready.</strong></p>{% endif %}</section>
 </div>
 <section class="vs-card"><h2>Project workspace</h2>
 <nav class="vs-projects" aria-label="Video projects">{% for project in jobs %}<button type="button" class="vs-project-tab {{ loop.first?'active':'' }}" data-open-project="{{ project.id }}"><strong>#{{ project.id }} · {{ project.title }}</strong><small>{{ project.status }} · {{ project.created_at }}</small></button>{% endfor %}</nav>
 {% for job in jobs %}<article class="vs-job {{ loop.first?'active':'' }}" data-project="{{ job.id }}" data-media-url="{{ job.source_url }}"><div class="d-flex justify-content-between"><strong>#{{ job.id }} — {{ job.title }}</strong><span class="vs-status">{{ job.status }}</span></div><p>{{ job.source_name }} · {{ job.created_at }}</p>
 {% if job.source_url starts with 'vnv-local://' %}<div class="vs-tools"><strong>Private server original</strong><p class="vs-muted">The 500 MB–10 GB master is protected from direct browser access. Transcription and final render read it directly from disk.</p></div>{% elseif job.mime_type starts with 'video/' %}<div class="vs-preview-wrap"><video class="vs-video" controls preload="metadata" src="{{ job.source_url }}"></video><div class="vs-overlay-stage" data-overlay-stage></div></div><div class="vs-overlay-tools"><input class="vs-input" data-overlay-text placeholder="Add an on-screen title"><button class="vs-btn" type="button" data-add-overlay>Add title</button><button class="vs-btn" type="button" data-delete-overlay>Delete selected</button></div>{% elseif job.mime_type starts with 'audio/' %}<audio controls preload="metadata" src="{{ job.source_url }}" style="width:100%"></audio>{% endif %}
 {% if job.project_files %}<div class="vs-tools"><div class="d-flex justify-content-between"><strong>Project folder · {{ job.project_files|length }} files</strong><small class="vs-muted">Click a file to insert its exact name into the AI instructions.</small></div><div class="vs-assets">{% for file in job.project_files %}<button class="vs-asset" type="button" data-use-project-file="{{ file.relative_path }}"><span class="vs-asset-role">{{ file.role }} · {{ file.kind }}</span><strong>{{ file.name }}</strong><small>{{ file.folder ?: 'project root' }} · {{ (file.bytes / 1048576)|number_format(1) }} MB</small></button>{% endfor %}</div></div>{% endif %}
 {% if job.transcript_text %}
 <div class="vs-wave-shell"><div class="vs-timebar"><strong>Timeline & caption regions</strong><span data-time>00:00.00 / 00:00.00</span></div><div class="vs-wave" data-waveform></div><div data-wave-timeline></div><label>Timeline zoom <input class="vs-zoom" type="range" min="10" max="300" value="80" data-wave-zoom></label></div>
 <div class="vs-tools"><div class="d-flex justify-content-between"><strong>Caption navigator</strong><span class="vs-shortcuts"><kbd>Space</kbd> play · <kbd>←</kbd>/<kbd>→</kbd> 1 sec</span></div><div class="vs-caption-list" data-caption-list></div></div>
 <form method="post" data-editor><input type="hidden" name="id" value="{{ job.id }}"><input type="hidden" name="overlay_layout_json" value=""><nav class="vs-tool-tabs"><button type="button" class="vs-tool-tab active" data-editor-tab="script">Script</button><button type="button" class="vs-tool-tab" data-editor-tab="design">Design</button><button type="button" class="vs-tool-tab" data-editor-tab="ai">AI direction</button></nav>
  <div data-editor-section="script"><h3 class="h6 mt-3">Editable transcript</h3><textarea class="vs-input" rows="8" name="transcript_text" data-history>{{ job.transcript_text }}</textarea>
  <details class="mt-2"><summary>Editable SRT subtitles</summary><textarea class="vs-input" rows="12" name="subtitles_srt" data-history>{{ job.subtitles_srt }}</textarea></details></div>
  <div data-editor-section="design" hidden><div class="vs-grid mt-2"><label>Export format<select class="vs-input" name="aspect_ratio"><option value="9:16">Instagram Reel / Shorts — 1080×1920</option><option value="16:9_4k">Horizontal 4K — 3840×2160</option><option value="16:9">Horizontal HD — 1920×1080</option><option value="1:1">Square — 1080×1080</option><option value="4:5">Social portrait — 1080×1350</option></select></label><label>Caption style<select class="vs-input" name="caption_style"><option value="kinetic">Kinetic word-by-word</option><option value="dynamic">Dynamic social phrases</option><option value="clean">Clean</option><option value="minimal">Minimal</option><option value="brand">VNV brand</option></select></label></div>
  <div class="vs-grid"><label>Creative intelligence<select class="vs-input" name="provider"><option value="openai">OpenAI</option></select></label><label>Brand logo<select class="vs-input" name="logo_url"><option value="">No logo intro</option>{% for file in job.project_files %}{% if file.role == 'LOGO' and file.kind == 'image' %}<option value="{{ file.url }}">Folder · {{ file.relative_path }}</option>{% endif %}{% endfor %}{% for asset in assets %}{% if asset.asset_type == 'LOGO' %}<option value="{{ asset.asset_url }}">Library · {{ asset.name }}</option>{% endif %}{% endfor %}</select></label></div>
  <div class="vs-grid"><label>Intro clip<select class="vs-input" name="intro_url"><option value="">No intro clip</option>{% for file in job.project_files %}{% if file.kind == 'video' and file.role != 'SOURCE' %}<option value="{{ file.url }}">Folder · [{{ file.role }}] {{ file.relative_path }}</option>{% endif %}{% endfor %}{% for asset in assets %}{% if asset.asset_type == 'INTRO' %}<option value="{{ asset.asset_url }}">Library · {{ asset.name }}</option>{% endif %}{% endfor %}</select></label><label>Outro clip<select class="vs-input" name="outro_url"><option value="">No outro clip</option>{% for file in job.project_files %}{% if file.kind == 'video' and file.role != 'SOURCE' %}<option value="{{ file.url }}">Folder · [{{ file.role }}] {{ file.relative_path }}</option>{% endif %}{% endfor %}{% for asset in assets %}{% if asset.asset_type == 'OUTRO' %}<option value="{{ asset.asset_url }}">Library · {{ asset.name }}</option>{% endif %}{% endfor %}</select></label></div>
  <div class="vs-grid"><label>Visual overlay<select class="vs-input" name="overlay_url"><option value="">No overlay</option>{% for file in job.project_files %}{% if file.kind == 'image' %}<option value="{{ file.url }}">Folder · [{{ file.role }}] {{ file.relative_path }}</option>{% endif %}{% endfor %}{% for asset in assets %}{% if asset.asset_type == 'OVERLAY' %}<option value="{{ asset.asset_url }}">Library · {{ asset.name }}</option>{% endif %}{% endfor %}</select></label><label>Background audio<select class="vs-input" name="audio_url"><option value="">No music bed</option>{% for file in job.project_files %}{% if file.kind == 'audio' %}<option value="{{ file.url }}">Folder · [{{ file.role }}] {{ file.relative_path }}</option>{% endif %}{% endfor %}{% for asset in assets %}{% if asset.asset_type == 'AUDIO' %}<option value="{{ asset.asset_url }}">Library · {{ asset.name }}</option>{% endif %}{% endfor %}</select></label></div>
  <label>Editing style<select class="vs-input" name="style_preset"><option value="vnv_premium">VNV Premium Events</option><option value="marketing_educator">Marketing Educator — fast, high-contrast, Neil Patel-inspired structure</option></select></label>
  <div class="vs-grid"><label>Camera movement intensity<select class="vs-input" name="motion_intensity"><option value="medium">Balanced</option><option value="low">Subtle</option><option value="high">Energetic</option></select></label><label>Zooms and transitions<textarea class="vs-input" rows="2" name="motion_direction" placeholder="AI decides, or: punch in at 00:12; slow push 00:20–00:24; dip to black at 00:31">AI decides purposeful moments only</textarea></label></div></div>
  <div data-editor-section="ai" hidden><label>Editing instructions<textarea class="vs-input" rows="3" name="instructions" placeholder="Example: prepare a 30-second vertical highlight without changing the speaker's meaning."></textarea></label>
  <label>Timed visual props / inserts<textarea class="vs-input" rows="4" name="visual_insert_instructions" placeholder="Example: from second 12 to 16 add a generated 4-second visual of an elegant wedding reception matching what is being explained."></textarea></label>
  <div class="vs-tools"><label><input type="checkbox" name="generate_visual_inserts" value="1"> Generate up to 3 proposed visual inserts now</label><input type="hidden" name="insert_provider" value="openai"><small>OpenAI-generated props and selected project files are composited only at their approved timestamps.</small></div></div>
  <div class="vs-actions"><button class="vs-btn" name="action" value="save_editor">Save text</button><button class="vs-btn alt" name="action" value="generate_plan">Generate AI edit plan</button><button class="vs-btn" type="button" data-undo>Undo</button><button class="vs-btn" type="button" data-redo>Redo</button></div>
 </form>
 <div class="vs-tools"><span class="vs-step">Caption & cut cleaner</span><p class="vs-muted">Write words or phrases separated by commas or lines. Matching caption blocks are removed and their exact timestamps are marked for removal from the final video.</p><form method="post" data-caption-clean><input type="hidden" name="action" value="clean_captions"><input type="hidden" name="id" value="{{ job.id }}"><input type="hidden" name="selected_text"><textarea class="vs-input" rows="3" name="remove_phrases" placeholder="um, eh, you know, repeated sentence"></textarea><div class="vs-actions"><button class="vs-btn">Remove list from captions + video</button><button class="vs-btn alt" type="button" data-use-selection>Remove selected transcript text</button></div></form></div>
 <form method="post" class="vs-actions"><input type="hidden" name="action" value="duplicate_project"><input type="hidden" name="id" value="{{ job.id }}"><button class="vs-btn">Create reusable remix</button></form>
 {% if job.revisions %}<details class="mt-3"><summary>Version history ({{ job.revisions|length }})</summary>{% for revision in job.revisions %}<div class="vs-muted">#{{ revision.id }} · {{ revision.revision_type }} · {{ revision.created_at }} · {{ revision.notes }}</div>{% endfor %}</details>{% endif %}
 {% if job.edit_plan_json %}<h3 class="h6 mt-3">Edit plan for review</h3><pre class="vs-plan">{{ job.edit_plan_json }}</pre><p class="vs-muted">This is a proposal only; the original media has not been rendered or modified.</p>{% endif %}
 {% if job.mime_type starts with 'video/' and job.status not in ['QUEUED','RENDERING'] %}<form method="post" class="mt-3"><input type="hidden" name="action" value="queue_render"><input type="hidden" name="id" value="{{ job.id }}"><button class="vs-btn alt" {% if not renderReady %}disabled{% endif %}>Render final MP4</button></form>{% endif %}
 {% if job.status in ['QUEUED','RENDERING'] %}<p class="mt-3"><strong>{{ job.status == 'QUEUED' ? 'Waiting for render worker…' : 'Rendering final MP4…' }}</strong> Refresh this page shortly.</p>{% endif %}
 {% if job.output_url %}<div class="mt-3"><h3 class="h6">Final render</h3><video class="vs-video" controls preload="metadata" src="{{ job.output_url }}"></video><div class="vs-actions mt-2"><a class="vs-btn" href="{{ job.output_url }}" target="_blank" rel="noopener">Open / Download MP4</a></div></div>{% endif %}
 {% elseif job.status != 'FAILED' %}<form method="post"><input type="hidden" name="action" value="transcribe"><input type="hidden" name="id" value="{{ job.id }}"><button class="vs-btn">Generate transcript + subtitles</button></form>{% endif %}
 {% if job.error_message %}<p class="text-danger">{{ job.error_message }}</p>{% endif %}</article>{% else %}<p>No media jobs yet.</p>{% endfor %}
 </section>
</div>
<script src="{{ asset_for('assets/lib/wavesurfer/wavesurfer.min.js') }}"></script>
<script src="{{ asset_for('assets/lib/wavesurfer/regions.min.js') }}"></script>
<script src="{{ asset_for('assets/lib/wavesurfer/timeline.min.js') }}"></script>
<script src="{{ asset_for('assets/lib/konva/konva.min.js') }}"></script>
<script>
const videoProjects=new Map();
const clock=s=>{s=Math.max(0,Number(s)||0);const m=Math.floor(s/60),sec=s-m*60;return String(m).padStart(2,'0')+':'+sec.toFixed(2).padStart(5,'0')};
const srtTime=s=>{s=Math.max(0,Number(s)||0);const h=Math.floor(s/3600),m=Math.floor((s%3600)/60),sec=Math.floor(s%60),ms=Math.round((s-Math.floor(s))*1000);return [h,m,sec].map(v=>String(v).padStart(2,'0')).join(':')+','+String(ms).padStart(3,'0')};
const parseSrt=value=>(value||'').trim().split(/\r?\n\r?\n/).map((block,index)=>{const lines=block.split(/\r?\n/),timeIndex=lines.findIndex(line=>line.includes('-->'));if(timeIndex<0)return null;const match=lines[timeIndex].match(/(\d\d):(\d\d):(\d\d)[,.](\d+)\s+-->\s+(\d\d):(\d\d):(\d\d)[,.](\d+)/);if(!match)return null;const seconds=(a,b,c,d)=>Number(a)*3600+Number(b)*60+Number(c)+Number(('0.'+d));return{id:index+1,start:seconds(match[1],match[2],match[3],match[4]),end:seconds(match[5],match[6],match[7],match[8]),text:lines.slice(timeIndex+1).join(' ').trim()}}).filter(Boolean);
function writeSrt(article,captions){const field=article.querySelector('[name="subtitles_srt"]');if(!field)return;field.value=captions.sort((a,b)=>a.start-b.start).map((c,i)=>`${i+1}\n${srtTime(c.start)} --> ${srtTime(c.end)}\n${c.text}`).join('\n\n');field.dispatchEvent(new Event('input',{bubbles:true}))}
function mountVideoProject(article){
 if(article.dataset.mounted)return;article.dataset.mounted='1';
 const overlayHost=article.querySelector('[data-overlay-stage]'),layoutField=article.querySelector('[name="overlay_layout_json"]'),media=article.querySelector('video,audio');
 if(overlayHost&&window.Konva){
  const preview=overlayHost.parentElement,stage=new Konva.Stage({container:overlayHost,width:preview.clientWidth,height:preview.clientHeight}),layer=new Konva.Layer(),transformer=new Konva.Transformer({rotateEnabled:false,anchorSize:9,borderStroke:'#49f2c2'});stage.add(layer);layer.add(transformer);
  const serialize=()=>{if(!layoutField)return;layoutField.value=JSON.stringify(layer.find('.user-overlay').map(node=>({text:node.text(),x:node.x()/stage.width(),y:node.y()/stage.height(),font_size:node.fontSize()/stage.height(),fill:node.fill(),rotation:node.rotation(),start:Number(node.getAttr('start')||0),end:Number(node.getAttr('end')||99999)})))};
  const select=node=>{transformer.nodes(node?[node]:[]);layer.draw()};stage.on('click tap',event=>select(event.target===stage?null:event.target.hasName('user-overlay')?event.target:null));
  article.querySelector('[data-add-overlay]')?.addEventListener('click',()=>{const input=article.querySelector('[data-overlay-text]'),value=input?.value.trim();if(!value)return;const at=media?.currentTime||0,node=new Konva.Text({x:stage.width()*.12,y:stage.height()*.18,text:value,fontSize:Math.max(26,stage.height()*.065),fontFamily:'Arial',fontStyle:'bold',fill:'#ffffff',stroke:'#111827',strokeWidth:2,draggable:true,name:'user-overlay',start:at,end:at+3});node.on('dragend transformend',serialize);layer.add(node);select(node);serialize();input.value=''});
  article.querySelector('[data-delete-overlay]')?.addEventListener('click',()=>{transformer.nodes().forEach(node=>node.destroy());select(null);serialize()});
  const resize=()=>{const oldW=stage.width()||1,oldH=stage.height()||1,newW=preview.clientWidth,newH=preview.clientHeight;layer.find('.user-overlay').forEach(node=>{node.x(node.x()/oldW*newW);node.y(node.y()/oldH*newH)});stage.size({width:newW,height:newH});layer.draw()};new ResizeObserver(resize).observe(preview);
 }
 if(!article.querySelector('[data-waveform]')||!window.WaveSurfer?.create||article.dataset.mediaUrl.startsWith('vnv-local://'))return;
 const srt=article.querySelector('[name="subtitles_srt"]'),list=article.querySelector('[data-caption-list]'),time=article.querySelector('[data-time]'),captions=parseSrt(srt?.value),regions=WaveSurfer.Regions.create(),timeline=WaveSurfer.Timeline.create({container:article.querySelector('[data-wave-timeline]'),height:18});
 const wave=WaveSurfer.create({container:article.querySelector('[data-waveform]'),url:article.dataset.mediaUrl,waveColor:'#64748b',progressColor:'#49f2c2',cursorColor:'#fff',height:90,normalize:true,minPxPerSec:80,plugins:[regions,timeline]});
 videoProjects.set(article.dataset.project,{wave,article,captions});
 const renderList=()=>{if(!list)return;list.innerHTML='';captions.sort((a,b)=>a.start-b.start).forEach((caption,index)=>{caption.id=index+1;const button=document.createElement('button');button.type='button';button.className='vs-caption-row';button.dataset.caption=String(caption.id);button.innerHTML=`<small>${clock(caption.start)}</small><span></span>`;button.querySelector('span').textContent=caption.text;button.onclick=()=>wave.setTime(caption.start);list.appendChild(button)})};
 wave.on('ready',duration=>{captions.forEach(caption=>regions.addRegion({id:'caption-'+caption.id,start:caption.start,end:caption.end,color:'rgba(79,70,229,.28)',content:String(caption.id),minLength:.08}));renderList();if(time)time.textContent=`${clock(0)} / ${clock(duration)}`});
 wave.on('timeupdate',current=>{if(time)time.textContent=`${clock(current)} / ${clock(wave.getDuration())}`;list?.querySelectorAll('.vs-caption-row').forEach(row=>row.classList.toggle('active',captions.some(c=>String(c.id)===row.dataset.caption&&current>=c.start&&current<=c.end)))});
 regions.on('region-clicked',(region,event)=>{event.stopPropagation();wave.setTime(region.start)});
 regions.on('region-updated',region=>{const caption=captions.find(c=>'caption-'+c.id===region.id);if(caption){caption.start=region.start;caption.end=region.end;writeSrt(article,captions);renderList()}});
 article.querySelector('[data-wave-zoom]')?.addEventListener('input',event=>wave.zoom(Number(event.target.value)));
 wave.on('interaction',()=>{if(media){media.currentTime=wave.getCurrentTime();if(wave.isPlaying())media.play().catch(()=>{})}});
 wave.on('play',()=>media?.play().catch(()=>{}));wave.on('pause',()=>media?.pause());
 media?.addEventListener('seeked',()=>{if(Math.abs(wave.getCurrentTime()-media.currentTime)>.15)wave.setTime(media.currentTime)});
}
document.querySelectorAll('[data-open-project]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-open-project]').forEach(item=>item.classList.toggle('active',item===button));document.querySelectorAll('[data-project]').forEach(project=>project.classList.toggle('active',project.dataset.project===button.dataset.openProject));const active=document.querySelector(`[data-project="${button.dataset.openProject}"]`);if(active)mountVideoProject(active)}));
const firstProject=document.querySelector('[data-project].active');if(firstProject)mountVideoProject(firstProject);
document.querySelectorAll('[data-use-project-file]').forEach(button=>button.addEventListener('click',()=>{
 const article=button.closest('.vs-job'),field=article?.querySelector('[name="visual_insert_instructions"]');if(!field)return;
 const line=`Use project file "${button.dataset.useProjectFile}" at: `;field.value+=(field.value.trim()?'\n':'')+line;field.focus();field.setSelectionRange(field.value.length,field.value.length);
 const aiTab=article.querySelector('[data-editor-tab="ai"]');aiTab?.click();
}));
document.addEventListener('keydown',event=>{if(/INPUT|TEXTAREA|SELECT/.test(document.activeElement?.tagName||''))return;const active=document.querySelector('[data-project].active'),entry=active&&videoProjects.get(active.dataset.project);if(!entry)return;if(event.code==='Space'){event.preventDefault();entry.wave.playPause()}if(event.key==='ArrowLeft'){event.preventDefault();entry.wave.skip(-1)}if(event.key==='ArrowRight'){event.preventDefault();entry.wave.skip(1)}});
document.querySelectorAll('[data-editor]').forEach(function(form){
 form.querySelectorAll('[data-editor-tab]').forEach(tab=>tab.addEventListener('click',()=>{form.querySelectorAll('[data-editor-tab]').forEach(item=>item.classList.toggle('active',item===tab));form.querySelectorAll('[data-editor-section]').forEach(section=>section.toggleAttribute('hidden',section.dataset.editorSection!==tab.dataset.editorTab))}));
 const fields=[...form.querySelectorAll('[data-history]')],undo=form.querySelector('[data-undo]'),redo=form.querySelector('[data-redo]');let past=[],future=[],timer;
 const snapshot=()=>fields.map(f=>f.value),restore=s=>fields.forEach((f,i)=>f.value=s[i]||'');past.push(snapshot());
 fields.forEach(f=>f.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(()=>{past.push(snapshot());if(past.length>40)past.shift();future=[]},300)}));
 undo.addEventListener('click',()=>{if(past.length<2)return;future.push(past.pop());restore(past[past.length-1])});
 redo.addEventListener('click',()=>{if(!future.length)return;const s=future.pop();past.push(s);restore(s)});
 form.addEventListener('submit',()=>setTimeout(()=>form.querySelectorAll('button').forEach(b=>b.disabled=true),0));
});
document.querySelectorAll('[data-caption-clean]').forEach(function(clean){
 const article=clean.closest('.vs-job'),transcript=article.querySelector('[name="transcript_text"]'),selected=clean.querySelector('[name="selected_text"]');
 clean.querySelector('[data-use-selection]').addEventListener('click',function(){selected.value=transcript.value.substring(transcript.selectionStart,transcript.selectionEnd).trim();if(!selected.value){alert('Select the exact text in the transcript first.');return;}clean.requestSubmit(clean.querySelector('button'));});
 clean.addEventListener('submit',function(){clean.querySelectorAll('button').forEach(b=>b.disabled=true)});
});
</script>
{% endblock %}
