 <div class="ve-shell">
  <aside class="ve-panel ve-media">
   <div class="ve-panel-head"><h2>Transcript editor</h2>{% if selected.transcript_text %}<form method="post"><input type="hidden" name="action" value="improve_timing"><input type="hidden" name="id" value="{{ selected.id }}"><button class="ve-inline-command" title="Analyze the real audio and automatically reduce long silences">Clean silences</button></form>{% else %}<small>not generated</small>{% endif %}</div>
   <nav class="ve-side-tabs"><button type="button" class="ve-side-tab active" data-side-tab="transcript">Transcript</button><button type="button" class="ve-side-tab" data-side-tab="media">Assets</button><button type="button" class="ve-side-tab" data-side-tab="speakers">People</button><button type="button" class="ve-side-tab" data-side-tab="copilot">Copilot</button></nav>
   <div class="ve-side-pane active" data-side-pane="transcript">
    {% if timeline.blocks %}<form method="post" data-timeline-form data-autosave-url="{{ path('panel/growth-hub/video-studio/timeline') }}" style="display:flex;flex:1;min-height:0;flex-direction:column"><input type="hidden" name="action" value="save_timeline_script"><input type="hidden" name="id" value="{{ selected.id }}"><input type="hidden" name="timeline_edits_json" data-timeline-json><input type="hidden" name="pause_edits_json" data-pause-edits-json><input type="hidden" name="precision_edits_json" data-precision-edits-json value="{{ selected.precision_edits|default([])|json_encode|e('html_attr') }}">
     <div class="ve-transcript-list">{% if timeline.pauses %}<div class="ve-silence-review"><span><strong>{{ timeline.pauses|length }} silence regions</strong><br>Review them one at a time.</span><button type="button" data-review-silences>Review silences</button></div>{% endif %}{% for block in timeline.blocks %}{% for pause in block.pauses_before %}<div class="ve-pause-marker" data-pause-start="{{ pause.start }}" data-pause-end="{{ pause.end }}"><input type="number" min="0" step="any" value="{{ pause.keep|number_format(6,'.','') }}" data-pause-keep><button type="button" data-remove-pause>Remove</button></div>{% endfor %}<div class="ve-transcript-block" data-transcript-block data-id="{{ block.id }}" data-start="{{ block.start }}" data-end="{{ block.end }}" data-words="{{ block.words|json_encode|e('html_attr') }}"><button class="ve-transcript-time" type="button" data-seek-time="{{ block.start }}">{{ block.time }}</button><div class="ve-transcript-content"><div class="ve-transcript-text" contenteditable="true" spellcheck="true" data-original="{{ block.text|e('html_attr') }}">{{ block.text }}{% for command in block.commands %}<span class="ve-command-chip" draggable="true" contenteditable="false" data-command-token="{{ command.token|default('['~command.type~': '~command.instruction~']')|e('html_attr') }}" data-command-type="{{ command.type }}" data-command-instruction="{{ command.instruction|e('html_attr') }}" data-command-options="{{ command.options|join(' | ')|e('html_attr') }}">{{ command.type|capitalize }} · {{ command.instruction }} <button type="button" data-remove-chip>×</button></span>{% endfor %}</div><div class="ve-block-wave" data-block-wave title="Drag across the waveform to select a precise mistake"><canvas width="900" height="108"></canvas><span class="ve-wave-selection"></span><span class="ve-wave-playhead"></span></div><div class="ve-wave-tools"><button type="button" data-wave-play>Preview line/selection</button><button type="button" class="danger" data-wave-cut disabled>Remove selected audio + video</button><button type="button" data-wave-undo>Undo last precision cut</button><output data-wave-range>Drag over the waveform to crop a subtle error</output></div></div></div>{% for pause in block.pauses_after %}<div class="ve-pause-marker" data-pause-start="{{ pause.start }}" data-pause-end="{{ pause.end }}"><input type="number" min="0" step="any" value="{{ pause.keep|number_format(6,'.','') }}" data-pause-keep><button type="button" data-remove-pause>Remove</button></div>{% endfor %}{% endfor %}</div>
     <div class="ve-inline-tools"><div class="ve-inline-buttons"><button type="button" class="ve-inline-command" data-new-command="caption">+ Caption style</button><button type="button" class="ve-inline-command" data-new-command="transition">+ Transition</button><button type="button" class="ve-inline-command" data-new-command="zoom">+ Zoom</button><button type="button" class="ve-inline-command" data-new-command="background">+ Background</button><button type="button" class="ve-inline-command" data-new-command="image">+ Media</button></div><div class="ve-chip-help" data-chip-help><strong>Transcript-first editing</strong>Delete a word or phrase directly above and its exact timed audio/video segment is removed automatically. Drag a chip onto a word to use that word’s timestamp.</div><div class="ve-row mt-2"><span class="ve-help" data-autosave-status>Changes save automatically</span></div></div>
    </form>{% else %}<div class="ve-media-list"><p class="ve-help">Generate the transcript to edit the video directly from its words.</p><form method="post"><input type="hidden" name="action" value="transcribe"><input type="hidden" name="id" value="{{ selected.id }}"><button class="ve-btn purple">Generate transcript</button></form></div>{% endif %}
   </div>
   <div class="ve-side-pane" data-side-pane="media"><div class="ve-media-list"><p class="ve-help">Click a project asset to create an editable insertion chip at the current transcript position.</p>{% for file in selected.project_files %}<button class="ve-media-item {{ file.role=='SOURCE'?'active':'' }}" type="button" data-media-name="{{ file.relative_path }}" data-media-url="{{ file.url }}" data-media-kind="{{ file.kind }}" data-media-mime="{{ file.mime_type }}" data-media-preview="{{ path('panel/growth-hub/video-studio/media') }}?id={{ selected.id }}&asset={{ file.relative_path|url_encode }}"><small class="ve-role">{{ file.role }}</small><strong>{{ file.name }}</strong><small>{{ (file.bytes/1048576)|number_format(1) }} MB · {{ file.kind }}</small></button>{% else %}<p class="ve-help">No attached media.</p>{% endfor %}{% if assets %}<div class="ve-panel-head" style="margin:10px -8px 6px"><h2>Reusable media bank</h2></div>{% for asset in assets %}{% if asset.mime_type starts with 'image/' or asset.mime_type starts with 'video/' %}<button class="ve-media-item" type="button" data-media-name="{{ asset.name }}" data-media-url="{{ asset.asset_url }}" data-media-kind="{{ asset.mime_type starts with 'video/'?'video':'image' }}" data-media-mime="{{ asset.mime_type }}" data-media-preview="{{ asset.asset_url }}"><small class="ve-role">{{ asset.asset_type }}</small><strong>{{ asset.name }}</strong></button>{% endif %}{% endfor %}{% endif %}</div></div>
   <div class="ve-side-pane" data-side-pane="speakers"><form method="post" enctype="multipart/form-data" class="ve-speaker-list"><input type="hidden" name="action" value="save_speaker_profiles"><input type="hidden" name="id" value="{{ selected.id }}"><p class="ve-help">Identify people once. Camera targets, caption identity and every derived reel inherit these settings.</p>{% for slot in 0..3 %}{% set person=selected.speaker_profiles[slot]|default({}) %}<section class="ve-speaker-card"><h3>Participant {{ slot+1 }}</h3><input class="ve-input" name="speaker[{{ slot }}][name]" value="{{ person.name|default('') }}" placeholder="Name, e.g. Jonathan"><div class="ve-speaker-grid"><label class="ve-field">On screen<select class="ve-input" name="speaker[{{ slot }}][position]"><option value="left" {{ person.position|default('')=='left'?'selected':'' }}>Left</option><option value="center" {{ person.position|default('center')=='center'?'selected':'' }}>Center</option><option value="right" {{ person.position|default('')=='right'?'selected':'' }}>Right</option></select></label><label class="ve-field">Caption color<input class="ve-input" type="color" name="speaker[{{ slot }}][caption_color]" value="{{ person.caption_color|default('#ffffff') }}"></label><label class="ve-field">Voice sample start<input class="ve-input" type="number" min="0" step="0.01" name="speaker[{{ slot }}][voice_reference_start]" value="{{ person.voice_reference_start|default('') }}" placeholder="seconds"></label><label class="ve-field">Voice sample end<input class="ve-input" type="number" min="0" step="0.01" name="speaker[{{ slot }}][voice_reference_end]" value="{{ person.voice_reference_end|default('') }}" placeholder="seconds"></label></div><input type="hidden" name="speaker[{{ slot }}][caption_preset]" value="{{ person.caption_preset|default(selected.caption_preset) }}"><label class="ve-help"><input type="checkbox" name="speaker[{{ slot }}][voice_consent]" value="1" {{ person.voice_consent|default(false)?'checked':'' }}> This person authorized use of this voice reference.</label></section>{% endfor %}<section class="ve-speaker-card"><h3>Reference script</h3><p class="ve-help">Optional: upload or paste the prepared script so AI can correct names and terminology. The word-timed audio remains authoritative for cuts.</p><input class="ve-input" type="file" name="reference_script_file" accept=".txt,.md,.srt,.vtt,text/plain"><textarea class="ve-input" rows="7" name="reference_script_text" placeholder="Paste the planned script here">{{ selected.reference_script }}</textarea></section><p class="ve-help">Voice references store consented repair metadata. Recorded speech is never replaced silently: synthesis requires a compatible authorized provider and explicit review.</p><button class="ve-btn purple">Save participants + script</button></form></div>
   <div class="ve-side-pane" data-side-pane="copilot"></div>
  </aside>
  <section class="ve-panel ve-stage">
   <div class="ve-canvas">{% if selected.mime_type starts with 'video/' %}<video data-preview preload="{{ selected.proxy_ready?'auto':'metadata' }}" playsinline data-has-proxy="{{ selected.proxy_ready?'1':'0' }}" data-removed-segments="{{ selected.preview_removed_segments|default([])|json_encode|e('html_attr') }}" src="{{ selected.source_url starts with 'vnv-local://' ? path('panel/growth-hub/video-studio/media')~'?id='~selected.id~(selected.proxy_ready?'&proxy=1&v='~selected.proxy_version:'') : selected.source_url }}"></video><div class="ve-loading" data-preview-loading><div><div class="ve-spinner"></div><span>Loading lightweight editing preview…</span></div></div>{% if not selected.proxy_ready and selected.source_url starts with 'vnv-local://' %}<form method="post" data-proxy-form style="position:absolute;z-index:9"><input type="hidden" name="action" value="generate_editing_proxy"><input type="hidden" name="id" value="{{ selected.id }}"><button class="ve-btn purple">Create fast editing preview</button><p class="ve-help" style="color:#cbd5e1;text-align:center;margin-top:7px">360p optimized proxy · export still uses the master</p></form>{% endif %}<div class="ve-effect-preview" data-effect-preview></div><div class="ve-asset-preview" data-asset-preview hidden></div><div class="ve-caption-preview clean" data-caption-preview></div><button class="ve-caption-gallery-button" type="button" data-open-caption-gallery>Caption looks</button><button class="ve-caption-toggle" type="button" data-caption-toggle>{{ selected.proxy_ready?'Fast preview · captions':'Captions' }}: on</button>{% elseif selected.mime_type starts with 'audio/' %}<audio data-preview controls src="{{ selected.source_url }}"></audio>{% else %}<div class="ve-canvas-empty">Preview unavailable</div>{% endif %}</div>
    <div class="ve-player">{% if selected.project_kind=='reel' %}<div class="ve-reel-notice">Reel editor · transcript cuts, waveform precision, silence cleanup, chips, captions, media, transitions and camera controls inherited from the master.</div>{% endif %}
    <div class="ve-player-row"><button type="button" class="ve-icon-btn" data-play>▶</button><span class="ve-time" data-current-time>00:00</span><input class="ve-seek" type="range" min="0" max="1000" value="0" data-seek><span class="ve-time" data-duration>00:00</span><button type="button" class="ve-icon-btn" data-mute>🔊</button></div>
    <div class="ve-tracks"><span class="ve-track-label">Video 1</span><div class="ve-track video"></div><span class="ve-track-label">Captions</span><div class="ve-track caption"></div></div>
    <div class="ve-graph-wrap"><div class="ve-graph-label"><span>Video and audio timeline</span><span>Yellow = silence · red = automatically removed</span></div><div class="ve-graph-timeline" data-graph-timeline><div class="ve-graph-speech"></div>{% for pause in timeline.pauses %}<button type="button" class="ve-graph-silence" data-graph-silence data-start="{{ pause.start }}" data-end="{{ pause.end }}" data-keep="{{ pause.keep }}" title="Silence {{ pause.start|number_format(2) }}s–{{ pause.end|number_format(2) }}s · {{ pause.duration|number_format(2) }} seconds"></button>{% endfor %}<span class="ve-graph-playhead" data-graph-playhead></span></div><canvas class="ve-waveform" data-waveform width="1200" height="52" aria-label="Audio waveform"></canvas></div>
   </div>
  </section>
  <aside class="ve-panel ve-copilot">
   <div class="ve-panel-head"><h2>AI Copilot</h2><small>OpenAI</small></div>
   <form method="post" class="ve-copilot-body" data-ai-form>
    <input type="hidden" name="id" value="{{ selected.id }}"><input type="hidden" name="transcript_text" value="{{ selected.transcript_text }}"><input type="hidden" name="subtitles_srt" value="{{ selected.subtitles_srt }}"><input type="hidden" name="insert_provider" value="openai"><input type="hidden" name="caption_preset" value="{{ selected.caption_preset|default('classic-bold') }}" data-caption-preset><input type="hidden" name="caption_size_percent" value="{{ selected.caption_size_percent|default(75) }}" data-caption-size-input>
    <div class="ve-ai-title"><span class="ve-ai-orb"></span><div><strong>Function A · AI edit director</strong><small>Creates a reviewable edit plan from your instruction.</small></div></div>
    <div><textarea class="ve-prompt" name="instructions" data-ai-prompt placeholder="Example: Make the first 30 seconds faster, remove filler words, add the intro, use venue-tour.mp4 at 00:42 and finish with the logo."></textarea>
     <div class="ve-chips"><button type="button" class="ve-chip" data-command="Create a strong hook in the first 3 seconds.">Strong hook</button><button type="button" class="ve-chip" data-command="Remove filler words and long silent pauses.">Clean speech</button><button type="button" class="ve-chip" data-command="Add purposeful punch-in zooms and smooth transitions.">Add motion</button><button type="button" class="ve-chip" data-command="Create dynamic captions that emphasize key words.">Dynamic captions</button><button type="button" class="ve-chip" data-command="Use the attached b-roll where it supports the spoken message.">Use b-roll</button></div>
     <p class="ve-ai-explainer"><strong>What Copilot does:</strong> proposes timed cuts, transitions, zooms, captions, titles and uses only exact assets attached to this project or selected from the library. It does not place random files. It may design an intro direction or use an uploaded intro; every result remains reviewable before Export.</p>
    </div>
    <div>
     <details class="ve-advanced"><summary>Output and advanced controls</summary><label class="ve-field">Timed notes<textarea class="ve-input" rows="3" name="visual_insert_instructions" placeholder="00:18 show team.jpg for 3s&#10;00:42 transition to venue-tour.mp4"></textarea></label><div class="ve-grid2"><label class="ve-field">Canvas<select class="ve-input" name="aspect_ratio"><option value="16:9">16:9 · 1080p</option><option value="16:9_4k">16:9 · 4K</option><option value="9:16">9:16 · Vertical</option><option value="4:5">4:5 · Portrait</option><option value="1:1">1:1 · Square</option></select></label><label class="ve-field">Captions<select class="ve-input" name="caption_style" data-caption-style><option value="clean">Clean</option><option value="dynamic">Dynamic</option><option value="kinetic">Word-by-word</option><option value="none">None</option></select></label><label class="ve-field">Style<select class="ve-input" name="style_preset"><option value="vnv_premium">VNV Premium</option><option value="marketing_educator">Marketing educator</option><option value="clean_documentary">Documentary</option></select></label><label class="ve-field">Motion<select class="ve-input" name="motion_intensity"><option>subtle</option><option selected>medium</option><option>high</option></select></label></div><label class="ve-field">Camera direction<input class="ve-input" name="motion_direction" value="AI decides purposeful moments only"></label>
      {% for field,label,types in [['logo_url','Logo',['LOGO']],['intro_url','Intro',['INTRO']],['outro_url','Outro',['OUTRO']],['overlay_url','Overlay',['OVERLAY']],['audio_url','Music',['AUDIO']]] %}<label class="ve-field">{{ label }}<select class="ve-input" name="{{ field }}"><option value="">AI decides / none</option>{% for file in selected.project_files %}{% if file.role in types %}<option value="{{ file.url }}">{{ file.relative_path }}</option>{% endif %}{% endfor %}{% for asset in assets %}{% if asset.asset_type in types %}<option value="{{ asset.asset_url }}">Library · {{ asset.name }}</option>{% endif %}{% endfor %}</select></label>{% endfor %}<label class="ve-field"><input type="checkbox" name="generate_visual_inserts" value="1"> Generate missing supporting images</label>
     </details>
     <button class="ve-btn purple ve-submit" name="action" value="generate_plan" {% if not selected.transcript_text %}disabled{% endif %}>Apply AI directions</button>
     {% if not selected.transcript_text %}<p class="ve-error">Generate the transcript below before asking AI to edit.</p>{% endif %}
    </div>
   </form>
   <section class="ve-copilot-cleanup" data-copilot-cleanup><div class="ve-panel-head"><h2>Function B · Remove words</h2><small>Deterministic timed cut</small></div><div class="ve-copilot-body"><p class="ve-help">Enter filler words, unwanted phrases or complete sentences. Every match is removed from the transcript, captions, audio and video using its exact timestamps.</p><form method="post"><input type="hidden" name="action" value="clean_captions"><input type="hidden" name="id" value="{{ selected.id }}"><textarea class="ve-textarea" rows="6" name="remove_phrases" placeholder="um, eh, you know&#10;complete sentence to remove"></textarea><button class="ve-btn purple mt-2">Remove from text + video</button></form></div></section>
  </aside>
 </div>
 <section class="ve-dock">
  <nav class="ve-dock-tabs"><button class="ve-dock-tab active" data-dock-tab="export">Export</button></nav>
  <div class="ve-dock-body">
   <div class="ve-dock-pane active" data-dock-pane="export"><div class="ve-output"><div><h3>Generate edited video</h3><p class="ve-help">This is the step that creates the edited MP4. Text deletions, removed pauses, inline commands and AI decisions are applied by FFmpeg. The original stays untouched.</p>{% if selected.status in ['QUEUED','RENDERING'] %}<p><strong>{{ selected.status=='QUEUED'?'Waiting for render worker…':'Rendering edited MP4…' }}</strong></p>{% else %}<div class="ve-render-buttons"><form method="post"><input type="hidden" name="action" value="queue_render"><input type="hidden" name="id" value="{{ selected.id }}"><input type="hidden" name="caption_mode" value="with_captions"><button class="ve-btn purple" {% if not renderReady or not selected.transcript_text %}disabled{% endif %}>Render with captions</button></form><form method="post"><input type="hidden" name="action" value="queue_render"><input type="hidden" name="id" value="{{ selected.id }}"><input type="hidden" name="caption_mode" value="without_captions"><button class="ve-btn" {% if not renderReady or not selected.transcript_text %}disabled{% endif %}>Render without captions</button></form></div>{% endif %}<p class="{{ renderReady?'ve-ready':'ve-error' }}">{{ renderReady?'FFmpeg is ready.':'FFmpeg is unavailable.' }}</p></div><div>{% if selected.output_url %}<video controls src="{{ selected.output_url }}"></video><div class="ve-row mt-2"><a class="ve-btn" target="_blank" href="{{ selected.output_url }}">Open edited master</a><a class="ve-btn ghost" href="{{ path('panel/growth-hub/distribution') }}?mode=short-video&project={{ selected.id }}">Create reels</a></div>{% else %}<p class="ve-help">The completed edited video and download controls will appear here.</p>{% endif %}<form method="post" class="mt-3"><input type="hidden" name="action" value="duplicate_project"><input type="hidden" name="id" value="{{ selected.id }}"><button class="ve-btn ghost">Duplicate as remix</button></form></div></div></div>
  </div>
 </section>
</div>
<div class="ve-modal-backdrop" data-command-modal>
 <section class="ve-command-modal" role="dialog" aria-modal="true" aria-labelledby="veCommandTitle">
  <header class="ve-modal-head"><div><h2 id="veCommandTitle">Insert edit chip</h2><p class="ve-help">The chip stays attached to this transcript timestamp. Double-click it later to edit.</p></div><button class="ve-modal-close" type="button" data-close-command>×</button></header>
  <div class="ve-chip-help" data-modal-chip-help></div>
  <div class="ve-modal-grid">
   <div class="ve-field">Editing <strong data-chip-fixed-title></strong><select hidden data-chip-type><option value="caption">Caption</option><option value="text">Text</option><option value="image">Image</option><option value="video">Video</option><option value="background">Background</option><option value="zoom">Zoom</option><option value="transition">Transition</option><option value="out">Effect end</option></select></div>
   <label class="ve-field" data-chip-mode-wrap>Boundary<select class="ve-input" data-chip-mode><option value="start">Start / configure here</option><option value="end">Finish the active effect here</option></select></label>
   <label class="ve-field" data-chip-instruction-wrap>Instruction or filename<input class="ve-input" data-chip-instruction placeholder="zoom, whip, team.jpg, elegant event background…"></label>
   <label class="ve-field" data-transition-kind-wrap>Transition effect<select class="ve-input" data-transition-kind><option value="blur">Blur</option><option value="dip_to_black">Dip to black</option><option value="flash">Flash</option><option value="whip_left">Whip left</option><option value="whip_right">Whip right</option><option value="soft_fade">Soft fade</option></select></label>
   <label class="ve-field" data-zoom-direction-wrap>Camera movement<select class="ve-input" data-zoom-direction><option value="in">Zoom in smoothly</option><option value="out">Zoom out smoothly</option></select></label>
   <label class="ve-field">Target / placement<select class="ve-input" data-chip-target><option value="replace">Full-screen cutaway · keep master audio</option><option value="insert-block">Insert video block · use clip audio</option><option value="overlay-center">Overlay · center</option><option value="overlay-top-right">Overlay · top right</option><option value="overlay-bottom-right">Overlay · bottom right</option><option value="background">Background</option><option value="left speaker">Left person</option><option value="right speaker">Right person</option><option value="center speaker">Center person</option></select></label>
   <label class="ve-field" data-zoom-intensity-wrap>Zoom intensity<select class="ve-input" data-zoom-intensity><option value="105">105% · subtle</option><option value="110" selected>110% · natural</option><option value="116">116% · close</option><option value="125">125% · strong</option><option value="140">140% · dramatic</option></select></label>
   <label class="ve-field">Position</label><div class="ve-position-grid" data-position-grid>{% for position in ['top-left','top-center','top-right','center-left','center','center-right','bottom-left','bottom-center','bottom-right'] %}<button type="button" data-position="{{ position }}" title="{{ position }}"></button>{% endfor %}</div><input type="hidden" data-chip-x value="50"><input type="hidden" data-chip-y value="50">
    <label class="ve-field">Effect duration <small data-duration-hint>seconds · 0.10–10.00</small><input class="ve-input" type="number" min="0.10" max="10.00" step="0.10" inputmode="decimal" data-chip-duration placeholder="Example: 3.50"></label>
    <div class="ve-modal-grid" data-media-transition-fields><label class="ve-field" data-motion-wrap>Image motion<select class="ve-input" data-chip-motion><option value="zoom-in">Slow zoom in</option><option value="zoom-out">Slow zoom out</option><option value="none">Still</option></select></label><span data-motion-spacer></span><label class="ve-field">Entrance<select class="ve-input" data-chip-enter><option value="fade">Fade</option><option value="slide-left">Slide from left</option><option value="slide-up">Slide up</option><option value="pop">Pop</option><option value="none">None</option></select></label><label class="ve-field">Entrance duration <small>seconds</small><input class="ve-input" type="number" min="0.10" max="10.00" step="0.10" inputmode="decimal" value="0.30" data-chip-enter-duration></label><label class="ve-field">Exit<select class="ve-input" data-chip-exit><option value="fade">Fade</option><option value="slide-right">Slide right</option><option value="slide-down">Slide down</option><option value="pop">Pop</option><option value="none">None</option></select></label><label class="ve-field">Exit duration <small>seconds</small><input class="ve-input" type="number" min="0.10" max="10.00" step="0.10" inputmode="decimal" value="0.30" data-chip-exit-duration></label></div>
   <div data-text-style-fields hidden><div class="ve-modal-grid"><label class="ve-field">Font<select class="ve-input" data-chip-font><option value="Arial">Arial</option><option value="Montserrat">Montserrat</option><option value="Poppins">Poppins</option><option value="Impact">Impact</option></select></label><label class="ve-field">Color<input class="ve-input" type="color" data-chip-color value="#ffffff"></label><label class="ve-field">Alignment<select class="ve-input" data-chip-align><option value="center">Center</option><option value="left">Left</option><option value="right">Right</option></select></label><label class="ve-field">Background<input class="ve-input" type="color" data-chip-background value="#000000"></label></div><label class="ve-field"><input type="checkbox" data-chip-background-enabled> Show background</label><label class="ve-field"><input type="checkbox" data-chip-shadow checked> Text shadow</label></div>
   <details class="ve-advanced"><summary>Advanced properties</summary><div class="ve-modal-grid"><label class="ve-field">Layer<input class="ve-input" type="number" min="0" max="100" data-chip-layer></label><label class="ve-field">Scale %<input class="ve-input" type="number" min="10" max="300" data-chip-scale value="100"></label><label class="ve-field">Rotation °<input class="ve-input" type="number" min="-360" max="360" data-chip-rotation value="0"></label><label class="ve-field">Opacity %<input class="ve-input" type="number" min="0" max="100" data-chip-opacity value="100"></label></div><label class="ve-field">Internal notes<textarea class="ve-input" rows="2" data-chip-notes></textarea></label></details>
   <label class="ve-field" data-caption-animation-wrap>Caption animation<select class="ve-input" data-chip-animation><option value="word">Word-by-word · TikTok effect</option><option value="phrase">Phrase pop</option><option value="static">Static subtitle</option></select></label>
