{% extends "templates/base.admin.twig" %}
{% block body %}
<style>
:root{--ve-bg:#eef2f7;--ve-panel:#fff;--ve-ink:#111827;--ve-muted:#64748b;--ve-line:#dbe2ea;--ve-purple:#5746e9;--ve-mint:#42dfbd;--ve-dark:#090d19}.ve-page{padding:14px 18px 22px;max-width:1800px}.ve-top{display:flex;align-items:center;gap:14px;background:#fff;border:1px solid var(--ve-line);border-radius:15px;padding:11px 14px;margin-bottom:10px}.ve-back{display:grid;place-items:center;width:38px;height:38px;border-radius:10px;background:#f1f5f9;color:var(--ve-ink);text-decoration:none;font-size:1.25rem}.ve-title{min-width:0;flex:1}.ve-title h1{font-size:1rem;font-weight:950;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ve-title small{color:var(--ve-muted)}.ve-status{border-radius:999px;background:#eef2ff;color:#4338ca;font-size:.68rem;font-weight:950;padding:6px 9px}.ve-actions{display:flex;gap:7px}.ve-btn{border:0;border-radius:9px;background:var(--ve-ink);color:#fff!important;padding:9px 12px;font-weight:850;text-decoration:none;cursor:pointer}.ve-btn.purple{background:var(--ve-purple)}.ve-btn.ghost{background:#eef2ff;color:#4338ca!important}.ve-btn:disabled{opacity:.4;cursor:not-allowed}.ve-shell{display:grid;grid-template-columns:235px minmax(420px,1fr) 330px;grid-template-rows:minmax(510px,calc(100vh - 300px));gap:10px}.ve-panel{background:var(--ve-panel);border:1px solid var(--ve-line);border-radius:14px;min-width:0;overflow:hidden}.ve-panel-head{display:flex;justify-content:space-between;align-items:center;padding:12px 13px;border-bottom:1px solid var(--ve-line)}.ve-panel-head h2{font-size:.82rem;font-weight:950;margin:0;text-transform:uppercase;letter-spacing:.06em}.ve-panel-head small{color:var(--ve-muted)}.ve-media{display:flex;flex-direction:column}.ve-media-list{padding:8px;overflow:auto}.ve-media-item{display:block;width:100%;border:1px solid transparent;background:#fff;border-radius:9px;padding:9px;text-align:left;margin-bottom:5px;cursor:pointer}.ve-media-item:hover,.ve-media-item.active{background:#eef2ff;border-color:#c7d2fe}.ve-media-item strong{display:block;font-size:.78rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ve-media-item small{display:block;color:var(--ve-muted);font-size:.68rem}.ve-role{color:#4f46e5!important;font-weight:900}.ve-stage{display:flex;flex-direction:column;background:var(--ve-dark)}.ve-canvas{position:relative;display:flex;align-items:center;justify-content:center;flex:1;min-height:0;overflow:hidden;background:radial-gradient(circle at center,#1b2440,#080b14 65%)}.ve-canvas video{display:block;width:100%;height:100%;object-fit:contain}.ve-canvas audio{width:80%}.ve-canvas-empty{color:#94a3b8;text-align:center}.ve-player{background:#111827;color:#fff;padding:9px 12px}.ve-player-row{display:flex;align-items:center;gap:10px}.ve-icon-btn{border:0;background:transparent;color:#fff;font-size:1.1rem;padding:3px 5px}.ve-seek{width:100%;accent-color:var(--ve-purple)}.ve-time{font-variant-numeric:tabular-nums;font-size:.72rem;white-space:nowrap}.ve-tracks{margin-top:8px;display:grid;grid-template-columns:56px 1fr;gap:5px;font-size:.66rem}.ve-track-label{color:#94a3b8}.ve-track{height:24px;border-radius:5px;background:#1e293b;position:relative;overflow:hidden}.ve-track.video:after{content:"MASTER VIDEO";position:absolute;inset:3px 7px;background:linear-gradient(90deg,#4f46e5,#7c3aed);border-radius:4px;padding:2px 6px}.ve-track.caption:after{content:"SCRIPT + CAPTIONS";position:absolute;inset:3px 24% 3px 7px;background:#0f766e;border-radius:4px;padding:2px 6px}.ve-copilot{display:flex;flex-direction:column}.ve-copilot-body{padding:12px;overflow:auto}.ve-ai-title{display:flex;gap:9px;align-items:center;margin-bottom:9px}.ve-ai-orb{width:32px;height:32px;border-radius:10px;background:linear-gradient(135deg,var(--ve-mint),var(--ve-purple))}.ve-ai-title strong{display:block}.ve-ai-title small{color:var(--ve-muted)}.ve-prompt{width:100%;min-height:145px;border:1px solid #cbd5e1;border-radius:12px;padding:11px;line-height:1.5;resize:vertical}.ve-chips{display:flex;gap:5px;flex-wrap:wrap;margin:8px 0}.ve-chip{border:1px solid var(--ve-line);background:#fff;border-radius:999px;padding:6px 8px;font-size:.68rem;font-weight:850;color:#334155}.ve-chip:hover{border-color:#818cf8;color:#4338ca}.ve-field{display:block;font-size:.72rem;font-weight:850;color:#475569;margin-top:8px}.ve-input{width:100%;border:1px solid #cbd5e1;border-radius:9px;padding:8px;margin-top:4px;background:#fff}.ve-advanced{margin-top:10px;border-top:1px solid var(--ve-line);padding-top:9px}.ve-advanced summary{cursor:pointer;font-size:.74rem;font-weight:900}.ve-grid2{display:grid;grid-template-columns:1fr 1fr;gap:7px}.ve-submit{width:100%;margin-top:10px}.ve-error{color:#dc2626;font-size:.75rem}.ve-ready{color:#047857;font-size:.75rem;font-weight:850}.ve-dock{margin-top:10px;background:#fff;border:1px solid var(--ve-line);border-radius:14px;overflow:hidden}.ve-dock-tabs{display:flex;gap:2px;border-bottom:1px solid var(--ve-line);padding:7px 9px}.ve-dock-tab{border:0;background:transparent;border-radius:8px;padding:8px 11px;font-size:.76rem;font-weight:900;color:#64748b}.ve-dock-tab.active{background:#eef2ff;color:#4338ca}.ve-dock-body{padding:13px}.ve-dock-pane{display:none}.ve-dock-pane.active{display:block}.ve-textarea{width:100%;border:1px solid #cbd5e1;border-radius:10px;padding:11px;line-height:1.6;resize:vertical}.ve-script{min-height:220px}.ve-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.ve-help{color:var(--ve-muted);font-size:.78rem;line-height:1.55;white-space:pre-line}.ve-plan{background:#0f172a;color:#dbeafe;border-radius:10px;padding:12px;white-space:pre-wrap;max-height:300px;overflow:auto}.ve-output{display:grid;grid-template-columns:1fr 1fr;gap:12px}.ve-output video{width:100%;max-height:300px;background:#000;border-radius:10px}@media(max-width:1200px){.ve-shell{grid-template-columns:190px 1fr;grid-template-rows:540px auto}.ve-copilot{grid-column:1/-1}.ve-copilot-body{display:grid;grid-template-columns:1fr 1fr;gap:12px}.ve-ai-title,.ve-submit{grid-column:1/-1}}@media(max-width:800px){.ve-page{padding:8px}.ve-shell{display:flex;flex-direction:column}.ve-media{max-height:190px}.ve-stage{height:480px}.ve-copilot-body,.ve-output{display:block}.ve-top{flex-wrap:wrap}.ve-title{order:2;flex-basis:70%}.ve-actions{margin-left:auto}.ve-grid2{grid-template-columns:1fr}}
.ve-shell{grid-template-columns:340px minmax(420px,1fr) 310px}.ve-side-tabs{display:flex;padding:7px;border-bottom:1px solid var(--ve-line);gap:4px}.ve-side-tab{flex:1;border:0;border-radius:8px;background:transparent;padding:7px;font-size:.72rem;font-weight:900}.ve-side-tab.active{background:#eef2ff;color:#4338ca}.ve-side-pane{display:none;min-height:0;flex:1}.ve-side-pane.active{display:flex;flex-direction:column}.ve-transcript-list{padding:7px;overflow:auto;flex:1}.ve-transcript-block{display:grid;grid-template-columns:42px 1fr;gap:7px;padding:7px;border-radius:8px}.ve-transcript-block:hover,.ve-transcript-block.active{background:#eef2ff}.ve-transcript-time{border:0;background:transparent;color:#4f46e5;font-size:.66rem;font-weight:900;padding:3px}.ve-transcript-text{font-size:.78rem;line-height:1.48;outline:none;border-radius:5px;padding:3px;white-space:pre-wrap}.ve-transcript-text:focus{background:#fff;box-shadow:0 0 0 2px #c7d2fe}.ve-inline-tools{padding:8px;border-top:1px solid var(--ve-line);background:#f8fafc}.ve-inline-buttons{display:flex;gap:4px;flex-wrap:wrap}.ve-inline-command{border:1px solid #cbd5e1;background:#fff;border-radius:999px;padding:5px 7px;font-size:.64rem;font-weight:850}.ve-pause-row{display:grid;grid-template-columns:1fr 70px;gap:6px;align-items:center;font-size:.68rem;margin-top:7px}.ve-caption-preview{position:absolute;left:8%;right:8%;bottom:8%;text-align:center;color:#fff;font-weight:950;font-size:clamp(18px,2.2vw,38px);line-height:1.15;text-shadow:0 2px 7px #000,0 0 2px #000;pointer-events:none}.ve-caption-preview.kinetic{color:#49f2c2;text-transform:uppercase}.ve-caption-preview.clean{font-size:clamp(16px,1.6vw,28px);font-weight:800}.ve-caption-toggle{position:absolute;right:10px;top:10px;background:#111827cc;color:#fff;border:1px solid #475569;border-radius:999px;padding:6px 9px;font-size:.68rem}.ve-ai-explainer{background:#eef2ff;border-radius:9px;padding:8px;color:#4338ca;font-size:.7rem;line-height:1.4}.ve-render-buttons{display:flex;gap:8px;flex-wrap:wrap}@media(max-width:1300px){.ve-shell{grid-template-columns:300px minmax(390px,1fr) 290px}}@media(max-width:1200px){.ve-shell{grid-template-columns:270px 1fr;grid-template-rows:540px auto}}
.ve-caption-preview.kinetic{color:#fff}.ve-caption-preview.kinetic .active-word{color:#49f2c2;display:inline-block;transform:scale(1.14)}.ve-caption-preview.dynamic{background:#090d19cc;border-radius:10px;padding:8px 12px;left:14%;right:14%}.ve-command-chip{display:inline-flex;align-items:center;gap:5px;border:1px solid #a5b4fc;background:#eef2ff;color:#4338ca;border-radius:999px;padding:3px 6px;margin:3px;font-size:.66rem;font-weight:900;vertical-align:middle;cursor:pointer}.ve-command-chip button{border:0;background:transparent;color:#6366f1;padding:0;font-weight:950}.ve-modal-backdrop{position:fixed;inset:0;background:#0f172acc;z-index:1055;display:none;align-items:center;justify-content:center;padding:20px}.ve-modal-backdrop.open{display:flex}.ve-command-modal{width:min(920px,96vw);max-height:90vh;overflow:auto;background:#fff;border-radius:18px;padding:20px;box-shadow:0 30px 80px #0008}.ve-modal-head{display:flex;justify-content:space-between;gap:15px;align-items:center}.ve-modal-close{border:0;background:#f1f5f9;border-radius:9px;width:34px;height:34px;font-size:1.2rem}.ve-modal-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.ve-style-gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:10px}.ve-style-card{border:2px solid #e2e8f0;border-radius:11px;background:#111827;min-height:98px;padding:8px;color:#fff;display:flex;flex-direction:column;justify-content:center;text-align:center}.ve-style-card.active{border-color:#49f2c2;box-shadow:0 0 0 2px #4f46e5}.ve-style-card strong{font-size:.8rem}.ve-style-card small{font-size:.62rem;color:#cbd5e1}.ve-style-sample{font-size:calc(1rem * var(--caption-scale,1));font-family:var(--caption-font,Arial);font-weight:950;color:var(--caption-color,#fff);text-shadow:0 2px var(--caption-outline,4px) var(--caption-stroke,#000);text-transform:var(--caption-transform,none);margin-bottom:5px}.ve-caption-picker{width:100%;border:1px solid #cbd5e1;background:#fff;border-radius:9px;padding:9px;text-align:left;font-weight:850}@media(max-width:800px){.ve-style-gallery{grid-template-columns:repeat(2,1fr)}.ve-modal-grid{grid-template-columns:1fr}}
.ve-transcript-list{line-height:1.7}.ve-transcript-block{border-radius:0!important;padding-top:4px!important;padding-bottom:4px!important}.ve-command-chip[draggable=true]{cursor:grab}.ve-command-chip.dragging{opacity:.35}.ve-chip-drop-target{box-shadow:inset 0 0 0 2px #6366f1!important}.ve-pause-marker{margin:3px 8px 5px 49px;padding:6px 8px;border:1px dashed #f59e0b;border-radius:9px;background:#fffbeb;color:#92400e;font-size:.65rem}.ve-pause-marker strong{margin-right:5px}.ve-pause-marker input{width:76px;border:1px solid #fbbf24;border-radius:6px;padding:3px;background:#fff}.ve-pause-marker button{border:0;background:#f59e0b;color:#fff;border-radius:6px;padding:4px 7px;margin-left:4px}.ve-loading{position:absolute;inset:0;z-index:8;display:none;place-items:center;background:#090d19cc;color:#fff;text-align:center;font-weight:900}.ve-loading.show{display:grid}.ve-spinner{width:42px;height:42px;border:4px solid #ffffff40;border-top-color:#49f2c2;border-radius:50%;animation:ve-spin .75s linear infinite;margin:0 auto 10px}@keyframes ve-spin{to{transform:rotate(360deg)}}.ve-caption-preview{left:14%;right:14%;font-size:clamp(12px,1.45vw,25px);line-height:1.08}.ve-caption-preview.clean{font-size:clamp(11px,1.2vw,21px)}
.ve-effect-preview{position:absolute;inset:0;z-index:3;pointer-events:none;opacity:0;transition:opacity .1s}.ve-effect-preview.flash{opacity:.72;background:#fff}.ve-effect-preview.black{opacity:.82;background:#000}.ve-canvas video{transition:transform .18s ease,filter .12s ease}
.ve-caption-gallery-button{position:absolute;left:10px;top:10px;background:#111827cc;color:#fff;border:1px solid #475569;border-radius:999px;padding:6px 9px;font-size:.68rem}
</style>
<div class="ve-page">
 <header class="ve-top">
  <a class="ve-back" href="{{ path('panel/growth-hub/video-studio') }}" title="All projects">←</a>
  <div class="ve-title"><h1>{{ selected.title }}</h1><small>#{{ selected.id }} · {{ selected.source_name }}</small></div>
  <span class="ve-status">{{ selected.status }}</span>
  <div class="ve-actions">{% if selected.output_url %}<a class="ve-btn ghost" href="{{ path('panel/growth-hub/distribution') }}?mode=short-video&project={{ selected.id }}">Create reel</a>{% endif %}<button class="ve-btn purple" type="button" data-open-dock="export">Export</button></div>
 </header>
 <div class="ve-shell">
  <aside class="ve-panel ve-media">
   <div class="ve-panel-head"><h2>Transcript editor</h2>{% if timeline.has_word_timestamps %}<small>word timing</small>{% elseif selected.transcript_text %}<form method="post" onsubmit="return confirm('This will replace the current transcript with a new word-timed transcription. Continue?')"><input type="hidden" name="action" value="transcribe"><input type="hidden" name="id" value="{{ selected.id }}"><button class="ve-inline-command" title="Re-transcribe with exact word timestamps">Improve timing</button></form>{% else %}<small>not generated</small>{% endif %}</div>
   <nav class="ve-side-tabs"><button type="button" class="ve-side-tab active" data-side-tab="transcript">Transcript</button><button type="button" class="ve-side-tab" data-side-tab="media">Media</button></nav>
   <div class="ve-side-pane active" data-side-pane="transcript">
    {% if timeline.blocks %}<form method="post" data-timeline-form data-autosave-url="{{ path('panel/growth-hub/video-studio/timeline') }}" style="display:flex;flex:1;min-height:0;flex-direction:column"><input type="hidden" name="action" value="save_timeline_script"><input type="hidden" name="id" value="{{ selected.id }}"><input type="hidden" name="timeline_edits_json" data-timeline-json><input type="hidden" name="pause_edits_json" data-pause-edits-json>
     <div class="ve-transcript-list">{% for block in timeline.blocks %}<div class="ve-transcript-block" data-transcript-block data-id="{{ block.id }}" data-start="{{ block.start }}" data-end="{{ block.end }}" data-words="{{ block.words|json_encode|e('html_attr') }}"><button class="ve-transcript-time" type="button" data-seek-time="{{ block.start }}">{{ block.time }}</button><div class="ve-transcript-text" contenteditable="true" spellcheck="true" data-original="{{ block.text|e('html_attr') }}">{{ block.text }}{% for command in block.commands %}<span class="ve-command-chip" draggable="true" contenteditable="false" data-command-token="{{ command.token|default('['~command.type~': '~command.instruction~']')|e('html_attr') }}" data-command-type="{{ command.type }}" data-command-instruction="{{ command.instruction|e('html_attr') }}" data-command-options="{{ command.options|join(' | ')|e('html_attr') }}">{{ command.type|capitalize }} · {{ command.instruction }} <button type="button" data-remove-chip>×</button></span>{% endfor %}</div></div>{% for pause in block.pauses %}<div class="ve-pause-marker" data-pause-start="{{ pause.start }}" data-pause-end="{{ pause.end }}"><strong>Silence at {{ pause.start|number_format(1) }}s · {{ pause.duration|number_format(2) }}s</strong> keep <input type="number" min="0" max="{{ pause.duration }}" step=".1" value="{{ pause.keep|number_format(2,'.','') }}" data-pause-keep> sec <button type="button" data-remove-pause>Remove</button></div>{% endfor %}{% endfor %}</div>
     <div class="ve-inline-tools"><div class="ve-inline-buttons"><button type="button" class="ve-inline-command" data-new-command="caption">+ Caption style</button><button type="button" class="ve-inline-command" data-new-command="transition">+ Transition</button><button type="button" class="ve-inline-command" data-new-command="zoom">+ Zoom person</button><button type="button" class="ve-inline-command" data-new-command="background">+ Background</button><button type="button" class="ve-inline-command" data-new-command="image">+ Media</button></div><div class="ve-pause-row"><label><input type="checkbox" name="remove_long_pauses" value="1"> Remove pauses longer than</label><input class="ve-input" type="number" name="pause_threshold" min=".6" max="10" step=".1" value="1.25"></div><div class="ve-row mt-2"><button class="ve-btn purple" style="flex:1">Apply now</button><span class="ve-help" data-autosave-status>Saved</span></div></div>
    </form>{% else %}<div class="ve-media-list"><p class="ve-help">Generate the transcript to edit the video directly from its words.</p><form method="post"><input type="hidden" name="action" value="transcribe"><input type="hidden" name="id" value="{{ selected.id }}"><button class="ve-btn purple">Generate transcript</button></form></div>{% endif %}
   </div>
   <div class="ve-side-pane" data-side-pane="media"><div class="ve-media-list">{% for file in selected.project_files %}<button class="ve-media-item {{ file.role=='SOURCE'?'active':'' }}" type="button" data-media-name="{{ file.relative_path }}"><small class="ve-role">{{ file.role }}</small><strong>{{ file.name }}</strong><small>{{ (file.bytes/1048576)|number_format(1) }} MB · {{ file.kind }}</small></button>{% else %}<p class="ve-help">No attached media.</p>{% endfor %}{% if assets %}<div class="ve-panel-head" style="margin:10px -8px 6px"><h2>Brand library</h2></div>{% for asset in assets %}<button class="ve-media-item" type="button" data-media-name="{{ asset.name }}"><small class="ve-role">{{ asset.asset_type }}</small><strong>{{ asset.name }}</strong></button>{% endfor %}{% endif %}</div></div>
  </aside>
  <section class="ve-panel ve-stage">
   <div class="ve-canvas">{% if selected.mime_type starts with 'video/' %}<video data-preview preload="auto" playsinline src="{{ selected.source_url starts with 'vnv-local://' ? path('panel/growth-hub/video-studio/media')~'?id='~selected.id~(selected.proxy_ready?'&proxy=1':'') : selected.source_url }}"></video><div class="ve-loading show" data-preview-loading><div><div class="ve-spinner"></div><span>Loading preview…</span></div></div><div class="ve-effect-preview" data-effect-preview></div><div class="ve-caption-preview clean" data-caption-preview></div><button class="ve-caption-gallery-button" type="button" data-open-caption-gallery>Caption looks</button><button class="ve-caption-toggle" type="button" data-caption-toggle>Captions: on</button>{% elseif selected.mime_type starts with 'audio/' %}<audio data-preview controls src="{{ selected.source_url }}"></audio>{% else %}<div class="ve-canvas-empty">Preview unavailable</div>{% endif %}</div>
   <div class="ve-player">
    {% if selected.mime_type starts with 'video/' and not selected.proxy_ready %}<form method="post" class="mb-2" data-proxy-form><input type="hidden" name="action" value="generate_editing_proxy"><input type="hidden" name="id" value="{{ selected.id }}"><button class="ve-btn ghost" type="submit">Create smooth 720p editing preview</button></form>{% endif %}
    <div class="ve-player-row"><button type="button" class="ve-icon-btn" data-play>▶</button><span class="ve-time" data-current-time>00:00</span><input class="ve-seek" type="range" min="0" max="1000" value="0" data-seek><span class="ve-time" data-duration>00:00</span><button type="button" class="ve-icon-btn" data-mute>🔊</button></div>
    <div class="ve-tracks"><span class="ve-track-label">Video 1</span><div class="ve-track video"></div><span class="ve-track-label">Captions</span><div class="ve-track caption"></div></div>
   </div>
  </section>
  <aside class="ve-panel ve-copilot">
   <div class="ve-panel-head"><h2>AI Copilot</h2><small>OpenAI</small></div>
   <form method="post" class="ve-copilot-body" data-ai-form>
    <input type="hidden" name="id" value="{{ selected.id }}"><input type="hidden" name="transcript_text" value="{{ selected.transcript_text }}"><input type="hidden" name="subtitles_srt" value="{{ selected.subtitles_srt }}"><input type="hidden" name="insert_provider" value="openai"><input type="hidden" name="caption_preset" value="{{ selected.caption_preset|default('classic-bold') }}" data-caption-preset><input type="hidden" name="caption_size_percent" value="{{ selected.caption_size_percent|default(75) }}" data-caption-size-input>
    <div class="ve-ai-title"><span class="ve-ai-orb"></span><div><strong>Describe the edit</strong><small>One request can control the whole project.</small></div></div>
    <div><textarea class="ve-prompt" name="instructions" data-ai-prompt placeholder="Example: Make the first 30 seconds faster, remove filler words, add the intro, use venue-tour.mp4 at 00:42 and finish with the logo."></textarea>
     <div class="ve-chips"><button type="button" class="ve-chip" data-command="Create a strong hook in the first 3 seconds.">Strong hook</button><button type="button" class="ve-chip" data-command="Remove filler words and long silent pauses.">Clean speech</button><button type="button" class="ve-chip" data-command="Add purposeful punch-in zooms and smooth transitions.">Add motion</button><button type="button" class="ve-chip" data-command="Create dynamic captions that emphasize key words.">Dynamic captions</button><button type="button" class="ve-chip" data-command="Use the attached b-roll where it supports the spoken message.">Use b-roll</button></div>
     <p class="ve-ai-explainer">This prepares the cuts, transitions, images, zooms and caption decisions. The edited MP4 is created from Export after you review them.</p>
    </div>
    <div>
     <details class="ve-advanced"><summary>Output and advanced controls</summary><label class="ve-field">Timed notes<textarea class="ve-input" rows="3" name="visual_insert_instructions" placeholder="00:18 show team.jpg for 3s&#10;00:42 transition to venue-tour.mp4"></textarea></label><div class="ve-grid2"><label class="ve-field">Canvas<select class="ve-input" name="aspect_ratio"><option value="16:9">16:9 · 1080p</option><option value="16:9_4k">16:9 · 4K</option><option value="9:16">9:16 · Vertical</option><option value="4:5">4:5 · Portrait</option><option value="1:1">1:1 · Square</option></select></label><label class="ve-field">Captions<select class="ve-input" name="caption_style" data-caption-style><option value="clean">Clean</option><option value="dynamic">Dynamic</option><option value="kinetic">Word-by-word</option><option value="none">None</option></select></label><label class="ve-field">Style<select class="ve-input" name="style_preset"><option value="vnv_premium">VNV Premium</option><option value="marketing_educator">Marketing educator</option><option value="clean_documentary">Documentary</option></select></label><label class="ve-field">Motion<select class="ve-input" name="motion_intensity"><option>subtle</option><option selected>medium</option><option>high</option></select></label></div><label class="ve-field">Camera direction<input class="ve-input" name="motion_direction" value="AI decides purposeful moments only"></label>
      {% for field,label,types in [['logo_url','Logo',['LOGO']],['intro_url','Intro',['INTRO']],['outro_url','Outro',['OUTRO']],['overlay_url','Overlay',['OVERLAY']],['audio_url','Music',['AUDIO']]] %}<label class="ve-field">{{ label }}<select class="ve-input" name="{{ field }}"><option value="">AI decides / none</option>{% for file in selected.project_files %}{% if file.role in types %}<option value="{{ file.url }}">{{ file.relative_path }}</option>{% endif %}{% endfor %}{% for asset in assets %}{% if asset.asset_type in types %}<option value="{{ asset.asset_url }}">Library · {{ asset.name }}</option>{% endif %}{% endfor %}</select></label>{% endfor %}<label class="ve-field"><input type="checkbox" name="generate_visual_inserts" value="1"> Generate missing supporting images</label>
     </details>
     <button class="ve-btn purple ve-submit" name="action" value="generate_plan" {% if not selected.transcript_text %}disabled{% endif %}>Apply AI directions</button>
