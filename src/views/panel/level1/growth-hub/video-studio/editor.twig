  <div class="ve-modal-grid">
   <label class="ve-field">Action<select class="ve-input" data-chip-type><option value="caption">Change caption style</option><option value="transition">Transition</option><option value="zoom">Zoom / reframe person</option><option value="background">Generated background / B-roll</option><option value="image">Image or uploaded media</option><option value="video">Generated short video</option></select></label>
