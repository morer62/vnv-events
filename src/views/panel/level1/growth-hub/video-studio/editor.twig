<script>
const video=document.querySelector('[data-preview]'),seek=document.querySelector('[data-seek]'),current=document.querySelector('[data-current-time]'),duration=document.querySelector('[data-duration]');const clock=n=>{if(!Number.isFinite(n))return'00:00';const h=Math.floor(n/3600),m=Math.floor(n%3600/60),s=Math.floor(n%60);return(h?String(h).padStart(2,'0')+':':'')+String(m).padStart(2,'0')+':'+String(s).padStart(2,'0')};const sync=()=>{if(video?.duration){seek.value=String(Math.round(video.currentTime/video.duration*1000));current.textContent=clock(video.currentTime);duration.textContent=clock(video.duration)}};video?.addEventListener('loadedmetadata',sync);video?.addEventListener('timeupdate',sync);video?.addEventListener('play',()=>document.querySelector('[data-play]').textContent='❚❚');video?.addEventListener('pause',()=>document.querySelector('[data-play]').textContent='▶');document.querySelector('[data-play]')?.addEventListener('click',()=>video?.paused?video.play():video.pause());document.querySelector('[data-mute]')?.addEventListener('click',e=>{video.muted=!video.muted;e.currentTarget.textContent=video.muted?'🔇':'🔊'});seek?.addEventListener('input',()=>{if(video?.duration)video.currentTime=Number(seek.value)/1000*video.duration});
const prompt=document.querySelector('[data-ai-prompt]');document.querySelectorAll('[data-command]').forEach(button=>button.addEventListener('click',()=>{prompt.value+=(prompt.value.trim()?'\n':'')+button.dataset.command;prompt.focus()}));document.querySelectorAll('[data-media-name]').forEach(button=>button.addEventListener('click',async()=>{const name=button.dataset.mediaName;prompt.value+=(prompt.value.trim()?'\n':'')+'Use '+name+' where it best supports the story.';prompt.focus();try{await navigator.clipboard.writeText(name)}catch(e){}}));
function openDock(name){document.querySelectorAll('[data-dock-tab]').forEach(tab=>tab.classList.toggle('active',tab.dataset.dockTab===name));document.querySelectorAll('[data-dock-pane]').forEach(pane=>pane.classList.toggle('active',pane.dataset.dockPane===name));document.querySelector('.ve-dock')?.scrollIntoView({behavior:'smooth',block:'nearest'})}document.querySelectorAll('[data-dock-tab]').forEach(tab=>tab.addEventListener('click',()=>openDock(tab.dataset.dockTab)));document.querySelectorAll('[data-open-dock]').forEach(button=>button.addEventListener('click',()=>openDock(button.dataset.openDock)));
document.querySelectorAll('[data-side-tab]').forEach(tab=>tab.addEventListener('click',()=>{document.querySelectorAll('[data-side-tab]').forEach(item=>item.classList.toggle('active',item===tab));document.querySelectorAll('[data-side-pane]').forEach(pane=>pane.classList.toggle('active',pane.dataset.sidePane===tab.dataset.sideTab))}));
const transcriptBlocks=[...document.querySelectorAll('[data-transcript-block]')],captionPreview=document.querySelector('[data-caption-preview]');let activeTranscriptText=transcriptBlocks[0]?.querySelector('.ve-transcript-text')||null,captionsVisible=true;
transcriptBlocks.forEach(block=>{const text=block.querySelector('.ve-transcript-text');text.addEventListener('focus',()=>activeTranscriptText=text);block.querySelector('[data-seek-time]')?.addEventListener('click',()=>{if(video)video.currentTime=Number(block.dataset.start);video?.play()})});
function syncTranscript(){if(!video)return;let active=null,captionDirective=null;transcriptBlocks.forEach(block=>{const on=video.currentTime>=Number(block.dataset.start)&&video.currentTime<=Number(block.dataset.end);block.classList.toggle('active',on);if(on)active=block;block.querySelectorAll('.ve-command-chip[data-command-type="caption"]').forEach(chip=>{const start=Number(block.dataset.start),duration=(chip.dataset.commandOptions||'').match(/duration:\s*(\d+(?:\.\d+)?)s/i);if(video.currentTime>=start&&(!duration||video.currentTime<=start+Number(duration[1])))captionDirective=chip})});if(captionDirective){const options=captionDirective.dataset.commandOptions||'',size=options.match(/size:\s*(\d+)%/i),animation=options.match(/animation:\s*(word|phrase|static)/i);captionPreview.className='ve-caption-preview '+(!animation||animation[1]==='word'?'kinetic':(animation[1]==='phrase'?'dynamic':'clean'));previewCaptionStyle(captionDirective.dataset.commandInstruction,size?Number(size[1]):100,false)}else{captionPreview.className='ve-caption-preview '+(document.querySelector('[data-caption-style]')?.value||'clean');previewCaptionStyle(captionPresetInput?.value||'classic-bold',Number(captionSizeInput?.value||100),false)}if(active){active.scrollIntoView({block:'nearest'});const value=editorValue(active.querySelector('.ve-transcript-text')).replace(/\[(transition|zoom|background|image|video|caption)\s*:[^\]]+\]/giu,'').trim();if(captionPreview&&captionsVisible){captionPreview.replaceChildren();if(captionPreview.classList.contains('kinetic')){let words=[];try{words=JSON.parse(active.dataset.words||'[]')}catch(e){};words.forEach(word=>{const span=document.createElement('span');span.textContent=word.text+' ';if(video.currentTime>=Number(word.start)&&video.currentTime<=Number(word.end))span.className='active-word';captionPreview.appendChild(span)});if(!words.length)captionPreview.textContent=value}else captionPreview.textContent=value}else if(captionPreview)captionPreview.textContent=''}else if(captionPreview)captionPreview.textContent=''}
video?.addEventListener('timeupdate',syncTranscript);document.querySelector('[data-caption-toggle]')?.addEventListener('click',event=>{captionsVisible=!captionsVisible;event.currentTarget.textContent='Captions: '+(captionsVisible?'on':'off');syncTranscript()});document.querySelector('[data-caption-style]')?.addEventListener('change',event=>{captionPreview.className='ve-caption-preview '+event.target.value;captionsVisible=event.target.value!=='none';syncTranscript()});
const commandModal=document.querySelector('[data-command-modal]'),chipType=document.querySelector('[data-chip-type]'),chipInstruction=document.querySelector('[data-chip-instruction]'),chipInstructionWrap=document.querySelector('[data-chip-instruction-wrap]'),chipTarget=document.querySelector('[data-chip-target]'),chipDuration=document.querySelector('[data-chip-duration]'),chipPersistent=document.querySelector('[data-chip-persistent]'),chipAnimation=document.querySelector('[data-chip-animation]'),captionAnimationWrap=document.querySelector('[data-caption-animation-wrap]'),captionStyleSection=document.querySelector('[data-caption-style-section]'),captionSize=document.querySelector('[data-caption-size]'),captionSizeLabel=document.querySelector('[data-caption-size-label]'),captionPresetInput=document.querySelector('[data-caption-preset]'),captionSizeInput=document.querySelector('[data-caption-size-input]');let selectedCaptionPreset='classic-bold',editingChip=null,globalCaptionSelection=false;
function styleCard(id){return document.querySelector(`[data-style-preset="${CSS.escape(id)}"]`)}function previewCaptionStyle(id,size=100,updateInputs=false){const card=styleCard(id);if(!card||!captionPreview)return;const scale=Number(card.dataset.styleScale||1)*Number(size)/100;captionPreview.style.color=card.dataset.styleColor;captionPreview.style.fontFamily=card.dataset.styleFont;captionPreview.style.fontSize=`calc(clamp(18px,2.2vw,38px) * ${scale})`;captionPreview.style.textTransform=card.dataset.styleUppercase==='1'?'uppercase':'none';captionPreview.style.textShadow=`0 2px 5px ${card.dataset.styleOutline},0 0 2px ${card.dataset.styleOutline}`;if(updateInputs){captionPresetInput.value=id;captionSizeInput.value=String(size)}}function selectStyle(id){selectedCaptionPreset=id;document.querySelectorAll('[data-style-preset]').forEach(card=>card.classList.toggle('active',card.dataset.stylePreset===id));previewCaptionStyle(id,Number(captionSize.value),globalCaptionSelection)}
function refreshCommandFields(){const caption=chipType.value==='caption';captionStyleSection.hidden=!caption;captionAnimationWrap.hidden=!caption;chipInstructionWrap.hidden=caption;if(chipType.value==='transition'&&!chipInstruction.value)chipInstruction.value='zoom';if(chipType.value==='zoom'&&!chipInstruction.value)chipInstruction.value='in'}chipType?.addEventListener('change',refreshCommandFields);
function openCommand(type='caption',chip=null,global=false){editingChip=chip;globalCaptionSelection=global;chipType.value=type;chipInstruction.value=chip?.dataset.commandInstruction||'';chipTarget.value='';chipDuration.value='';chipPersistent.checked=true;selectedCaptionPreset=type==='caption'?(chip?.dataset.commandInstruction||captionPresetInput?.value||'classic-bold'):'classic-bold';const options=chip?.dataset.commandOptions||'';const target=options.match(/target:\s*([^|]+)/i),durationMatch=options.match(/(?:duration:\s*)?(\d+(?:\.\d+)?)s/i),sizeMatch=options.match(/size:\s*(\d+)%/i),animationMatch=options.match(/animation:\s*(word|phrase|static)/i);if(target)chipTarget.value=target[1].trim();if(durationMatch){chipDuration.value=durationMatch[1];chipPersistent.checked=false}chipAnimation.value=animationMatch?animationMatch[1]:'word';captionSize.value=sizeMatch?sizeMatch[1]:(captionSizeInput?.value||100);captionSizeLabel.textContent=captionSize.value+'%';refreshCommandFields();selectStyle(selectedCaptionPreset);commandModal.classList.add('open')}
function closeCommand(){commandModal.classList.remove('open');editingChip=null;globalCaptionSelection=false}document.querySelectorAll('[data-close-command]').forEach(button=>button.addEventListener('click',closeCommand));commandModal?.addEventListener('click',event=>{if(event.target===commandModal)closeCommand()});document.querySelectorAll('[data-new-command]').forEach(button=>button.addEventListener('click',()=>openCommand(button.dataset.newCommand)));document.querySelector('[data-open-caption-gallery]')?.addEventListener('click',()=>openCommand('caption',null,true));document.querySelectorAll('[data-style-preset]').forEach(card=>card.addEventListener('click',()=>selectStyle(card.dataset.stylePreset)));captionSize?.addEventListener('input',()=>{captionSizeLabel.textContent=captionSize.value+'%';previewCaptionStyle(selectedCaptionPreset,Number(captionSize.value),globalCaptionSelection)});
function createChip(token,type,instruction,options=''){const chip=document.createElement('span');chip.className='ve-command-chip';chip.contentEditable='false';chip.draggable=true;chip.dataset.commandToken=token;chip.dataset.commandType=type;chip.dataset.commandInstruction=instruction;chip.dataset.commandOptions=options;chip.append(document.createTextNode(type.charAt(0).toUpperCase()+type.slice(1)+' · '+instruction+' '));const remove=document.createElement('button');remove.type='button';remove.dataset.removeChip='';remove.textContent='×';chip.append(remove);return chip}
document.querySelector('[data-save-command]')?.addEventListener('click',()=>{const type=chipType.value,instruction=type==='caption'?selectedCaptionPreset:chipInstruction.value.trim();if(!instruction)return;const options=[];if(chipTarget.value)options.push('target: '+chipTarget.value);if(type==='caption'){options.push('size: '+captionSize.value+'%');options.push('animation: '+chipAnimation.value)}if(!chipPersistent.checked&&chipDuration.value)options.push('duration: '+chipDuration.value+'s');else if(chipPersistent.checked&&type==='caption')options.push('persistent');const token='['+type+': '+instruction+(options.length?' | '+options.join(' | '):'')+']';if(globalCaptionSelection){previewCaptionStyle(instruction,Number(captionSize.value),true);const mode=chipAnimation.value==='word'?'kinetic':(chipAnimation.value==='phrase'?'dynamic':'clean');const modeSelect=document.querySelector('[data-caption-style]');if(modeSelect){modeSelect.value=mode;modeSelect.dispatchEvent(new Event('change'))}}if(!activeTranscriptText){closeCommand();return}if(editingChip){const replacement=createChip(token,type,instruction,options.join(' | '));editingChip.replaceWith(replacement)}else{activeTranscriptText.append(document.createElement('br'),createChip(token,type,instruction,options.join(' | ')))}activeTranscriptText.dispatchEvent(new Event('input'));closeCommand()});
document.addEventListener('click',event=>{const remove=event.target.closest('[data-remove-chip]');if(remove){event.preventDefault();event.stopPropagation();const text=remove.closest('.ve-transcript-text');remove.closest('.ve-command-chip')?.remove();text?.dispatchEvent(new Event('input'))}});document.addEventListener('dblclick',event=>{const chip=event.target.closest('.ve-command-chip');if(chip)openCommand(chip.dataset.commandType,chip,false)});
function editorValue(element){let value='';element.childNodes.forEach(node=>{if(node.nodeType===Node.TEXT_NODE)value+=node.nodeValue;else if(node.nodeType===Node.ELEMENT_NODE){if(node.matches('.ve-command-chip'))value+='\n'+node.dataset.commandToken+'\n';else if(node.tagName==='BR')value+='\n';else value+=editorValue(node)}});return value.replace(/\n{3,}/g,'\n\n').trim()}
const timelineForm=document.querySelector('[data-timeline-form]'),autosaveStatus=document.querySelector('[data-autosave-status]');function serializeTimeline(){const edits=transcriptBlocks.map(block=>({id:Number(block.dataset.id),start:Number(block.dataset.start),end:Number(block.dataset.end),text:editorValue(block.querySelector('.ve-transcript-text'))}));if(timelineForm)timelineForm.querySelector('[data-timeline-json]').value=JSON.stringify(edits);return edits}timelineForm?.addEventListener('submit',serializeTimeline);
let autosaveTimer=null,autosaveController=null;function scheduleTimelineSave(){if(!timelineForm)return;clearTimeout(autosaveTimer);if(autosaveStatus)autosaveStatus.textContent='Unsaved';autosaveTimer=setTimeout(async()=>{serializeTimeline();autosaveController?.abort();autosaveController=new AbortController();if(autosaveStatus)autosaveStatus.textContent='Saving…';try{const response=await fetch(timelineForm.dataset.autosaveUrl,{method:'POST',body:new FormData(timelineForm),signal:autosaveController.signal,headers:{'X-Requested-With':'XMLHttpRequest'}}),result=await response.json();if(!response.ok||!result.success)throw new Error(result.message||'Unable to save');if(autosaveStatus)autosaveStatus.textContent='Saved · '+result.saved_at}catch(error){if(error.name!=='AbortError'&&autosaveStatus){autosaveStatus.textContent='Save failed';autosaveStatus.classList.add('ve-error')}}},900)}transcriptBlocks.forEach(block=>block.querySelector('.ve-transcript-text').addEventListener('input',scheduleTimelineSave));timelineForm?.querySelectorAll('[name=remove_long_pauses],[name=pause_threshold]').forEach(input=>input.addEventListener('change',scheduleTimelineSave));

// Transcript-first editing: visible silence controls, draggable edit chips and a compact live caption window.
const pauseMarkers=[...document.querySelectorAll('[data-pause-start]')],pauseJson=document.querySelector('[data-pause-edits-json]'),previewLoading=document.querySelector('[data-preview-loading]');
const baseSerializeTimeline=serializeTimeline;
serializeTimeline=function(){const edits=baseSerializeTimeline();if(pauseJson)pauseJson.value=JSON.stringify(pauseMarkers.map(marker=>({start:Number(marker.dataset.pauseStart),end:Number(marker.dataset.pauseEnd),keep:Number(marker.querySelector('[data-pause-keep]')?.value||0)})));return edits};
pauseMarkers.forEach(marker=>{const input=marker.querySelector('[data-pause-keep]');input?.addEventListener('change',scheduleTimelineSave);marker.querySelector('[data-remove-pause]')?.addEventListener('click',()=>{input.value='0';input.dispatchEvent(new Event('change'));marker.style.opacity='.55})});
let draggedChip=null;
document.addEventListener('dragstart',event=>{const chip=event.target.closest('.ve-command-chip');if(!chip)return;draggedChip=chip;chip.classList.add('dragging');event.dataTransfer.effectAllowed='move'});
document.addEventListener('dragend',()=>{draggedChip?.classList.remove('dragging');draggedChip=null;document.querySelectorAll('.ve-chip-drop-target').forEach(el=>el.classList.remove('ve-chip-drop-target'))});
function retimeChip(chip,target,range){const block=target.closest('[data-transcript-block]');if(!block)return;let before='';if(range&&target.contains(range.startContainer)){const probe=document.createRange();probe.selectNodeContents(target);try{probe.setEnd(range.startContainer,range.startOffset);before=probe.toString()}catch(e){}}let words=[];try{words=JSON.parse(block.dataset.words||'[]')}catch(e){}const wordIndex=Math.max(0,Math.min(words.length-1,(before.trim().match(/\S+/g)||[]).length));const at=words[wordIndex]?.start||Number(block.dataset.start),clean=(chip.dataset.commandOptions||'').split('|').map(x=>x.trim()).filter(x=>x&&!/^at\s*:/i.test(x));clean.push('at: '+Number(at).toFixed(2)+'s');chip.dataset.commandOptions=clean.join(' | ');chip.dataset.commandToken='['+chip.dataset.commandType+': '+chip.dataset.commandInstruction+' | '+clean.join(' | ')+']'}
transcriptBlocks.forEach(block=>{const target=block.querySelector('.ve-transcript-text');target.addEventListener('dragover',event=>{if(!draggedChip)return;event.preventDefault();target.classList.add('ve-chip-drop-target')});target.addEventListener('dragleave',()=>target.classList.remove('ve-chip-drop-target'));target.addEventListener('drop',event=>{if(!draggedChip)return;event.preventDefault();target.classList.remove('ve-chip-drop-target');const range=document.caretRangeFromPoint?.(event.clientX,event.clientY);if(range&&target.contains(range.startContainer)){retimeChip(draggedChip,target,range);range.insertNode(draggedChip);range.collapse(false)}else{target.append(draggedChip);retimeChip(draggedChip,target,null)}activeTranscriptText=target;target.dispatchEvent(new Event('input'))})});
function compactCaptionPreview(){if(!captionPreview||!video||!captionsVisible)return;const active=transcriptBlocks.find(block=>video.currentTime>=Number(block.dataset.start)&&video.currentTime<=Number(block.dataset.end));if(!active)return;let words=[];try{words=JSON.parse(active.dataset.words||'[]')}catch(e){}if(!words.length)return;let index=words.findIndex(word=>video.currentTime>=Number(word.start)&&video.currentTime<=Number(word.end));if(index<0)index=Math.max(0,words.findIndex(word=>Number(word.start)>video.currentTime)-1);const first=Math.max(0,index-1),visible=words.slice(first,first+4);captionPreview.replaceChildren();visible.forEach((word,offset)=>{const span=document.createElement('span');span.textContent=word.text+(offset===visible.length-1?'':' ');if(first+offset===index)span.className='active-word';captionPreview.append(span)})}
video?.addEventListener('timeupdate',compactCaptionPreview);
const effectPreview=document.querySelector('[data-effect-preview]');
function previewTimedEffects(){if(!video)return;let zoom=null,transition=null;document.querySelectorAll('.ve-command-chip').forEach(chip=>{const block=chip.closest('[data-transcript-block]'),options=chip.dataset.commandOptions||'',atMatch=options.match(/at:\s*(\d+(?:\.\d+)?)s?/i),durationMatch=options.match(/duration:\s*(\d+(?:\.\d+)?)s/i),at=atMatch?Number(atMatch[1]):Number(block?.dataset.start||0),duration=durationMatch?Number(durationMatch[1]):(chip.dataset.commandType==='transition'?.35:3);if(video.currentTime>=at&&video.currentTime<=at+duration){if(chip.dataset.commandType==='zoom')zoom=chip;if(chip.dataset.commandType==='transition')transition=chip}});if(zoom){const options=zoom.dataset.commandOptions||'';video.style.transform='scale(1.12)';video.style.transformOrigin=/left/i.test(options)?'30% 45%':(/right/i.test(options)?'70% 45%':'50% 45%')}else{video.style.transform='';video.style.transformOrigin=''}if(effectPreview){effectPreview.className='ve-effect-preview';if(transition)effectPreview.classList.add(/black/i.test(transition.dataset.commandInstruction)?'black':'flash')}}
video?.addEventListener('timeupdate',previewTimedEffects);
video?.addEventListener('loadstart',()=>previewLoading?.classList.add('show'));video?.addEventListener('waiting',()=>previewLoading?.classList.add('show'));video?.addEventListener('seeking',()=>previewLoading?.classList.add('show'));['canplay','playing','seeked','loadeddata'].forEach(name=>video?.addEventListener(name,()=>previewLoading?.classList.remove('show')));
if(video?.readyState>=3)previewLoading?.classList.remove('show');
if(autosaveStatus&&previewLoading)new MutationObserver(()=>{const saving=autosaveStatus.textContent.startsWith('Saving');previewLoading.querySelector('span').textContent=saving?'Applying edit…':'Loading preview…';previewLoading.classList.toggle('show',saving)}).observe(autosaveStatus,{childList:true,characterData:true,subtree:true});
document.querySelector('[data-proxy-form]')?.addEventListener('submit',()=>{previewLoading?.classList.add('show');const label=previewLoading?.querySelector('span');if(label)label.textContent='Building smooth editing preview…'});
document.querySelectorAll('.ve-command-chip').forEach(chip=>chip.draggable=true);
</script>
{% endblock %}
