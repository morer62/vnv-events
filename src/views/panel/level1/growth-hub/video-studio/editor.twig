{% extends "templates/base.admin.twig" %}
{% block body %}
<style>
:root{--ve-bg:#eef2f7;--ve-panel:#fff;--ve-ink:#111827;--ve-muted:#64748b;--ve-line:#dbe2ea;--ve-purple:#5746e9;--ve-mint:#42dfbd;--ve-dark:#090d19}.ve-page{padding:14px 18px 22px;max-width:1800px}.ve-top{display:flex;align-items:center;gap:14px;background:#fff;border:1px solid var(--ve-line);border-radius:15px;padding:11px 14px;margin-bottom:10px}.ve-back{display:grid;place-items:center;width:38px;height:38px;border-radius:10px;background:#f1f5f9;color:var(--ve-ink);text-decoration:none;font-size:1.25rem}.ve-title{min-width:0;flex:1}.ve-title h1{font-size:1rem;font-weight:950;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ve-title small{color:var(--ve-muted)}.ve-status{border-radius:999px;background:#eef2ff;color:#4338ca;font-size:.68rem;font-weight:950;padding:6px 9px}.ve-actions{display:flex;gap:7px}.ve-btn{border:0;border-radius:9px;background:var(--ve-ink);color:#fff!important;padding:9px 12px;font-weight:850;text-decoration:none;cursor:pointer}.ve-btn.purple{background:var(--ve-purple)}.ve-btn.ghost{background:#eef2ff;color:#4338ca!important}.ve-btn:disabled{opacity:.4;cursor:not-allowed}.ve-shell{display:grid;grid-template-columns:235px minmax(420px,1fr) 330px;grid-template-rows:minmax(510px,calc(100vh - 300px));gap:10px}.ve-panel{background:var(--ve-panel);border:1px solid var(--ve-line);border-radius:14px;min-width:0;overflow:hidden}.ve-panel-head{display:flex;justify-content:space-between;align-items:center;padding:12px 13px;border-bottom:1px solid var(--ve-line)}.ve-panel-head h2{font-size:.82rem;font-weight:950;margin:0;text-transform:uppercase;letter-spacing:.06em}.ve-panel-head small{color:var(--ve-muted)}.ve-media{display:flex;flex-direction:column}.ve-media-list{padding:8px;overflow:auto}.ve-media-item{display:block;width:100%;border:1px solid transparent;background:#fff;border-radius:9px;padding:9px;text-align:left;margin-bottom:5px;cursor:pointer}.ve-media-item:hover,.ve-media-item.active{background:#eef2ff;border-color:#c7d2fe}.ve-media-item strong{display:block;font-size:.78rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ve-media-item small{display:block;color:var(--ve-muted);font-size:.68rem}.ve-role{color:#4f46e5!important;font-weight:900}.ve-stage{display:flex;flex-direction:column;background:var(--ve-dark)}.ve-canvas{position:relative;display:flex;align-items:center;justify-content:center;flex:1;min-height:0;overflow:hidden;background:radial-gradient(circle at center,#1b2440,#080b14 65%)}.ve-canvas video{display:block;width:100%;height:100%;object-fit:contain}.ve-canvas audio{width:80%}.ve-canvas-empty{color:#94a3b8;text-align:center}.ve-player{background:#111827;color:#fff;padding:9px 12px}.ve-player-row{display:flex;align-items:center;gap:10px}.ve-icon-btn{border:0;background:transparent;color:#fff;font-size:1.1rem;padding:3px 5px}.ve-seek{width:100%;accent-color:var(--ve-purple)}.ve-time{font-variant-numeric:tabular-nums;font-size:.72rem;white-space:nowrap}.ve-tracks{margin-top:8px;display:grid;grid-template-columns:56px 1fr;gap:5px;font-size:.66rem}.ve-track-label{color:#94a3b8}.ve-track{height:24px;border-radius:5px;background:#1e293b;position:relative;overflow:hidden}.ve-track.video:after{content:"MASTER VIDEO";position:absolute;inset:3px 7px;background:linear-gradient(90deg,#4f46e5,#7c3aed);border-radius:4px;padding:2px 6px}.ve-track.caption:after{content:"SCRIPT + CAPTIONS";position:absolute;inset:3px 24% 3px 7px;background:#0f766e;border-radius:4px;padding:2px 6px}.ve-copilot{display:flex;flex-direction:column}.ve-copilot-body{padding:12px;overflow:auto}.ve-ai-title{display:flex;gap:9px;align-items:center;margin-bottom:9px}.ve-ai-orb{width:32px;height:32px;border-radius:10px;background:linear-gradient(135deg,var(--ve-mint),var(--ve-purple))}.ve-ai-title strong{display:block}.ve-ai-title small{color:var(--ve-muted)}.ve-prompt{width:100%;min-height:145px;border:1px solid #cbd5e1;border-radius:12px;padding:11px;line-height:1.5;resize:vertical}.ve-chips{display:flex;gap:5px;flex-wrap:wrap;margin:8px 0}.ve-chip{border:1px solid var(--ve-line);background:#fff;border-radius:999px;padding:6px 8px;font-size:.68rem;font-weight:850;color:#334155}.ve-chip:hover{border-color:#818cf8;color:#4338ca}.ve-field{display:block;font-size:.72rem;font-weight:850;color:#475569;margin-top:8px}.ve-input{width:100%;border:1px solid #cbd5e1;border-radius:9px;padding:8px;margin-top:4px;background:#fff}.ve-advanced{margin-top:10px;border-top:1px solid var(--ve-line);padding-top:9px}.ve-advanced summary{cursor:pointer;font-size:.74rem;font-weight:900}.ve-grid2{display:grid;grid-template-columns:1fr 1fr;gap:7px}.ve-submit{width:100%;margin-top:10px}.ve-error{color:#dc2626;font-size:.75rem}.ve-ready{color:#047857;font-size:.75rem;font-weight:850}.ve-dock{margin-top:10px;background:#fff;border:1px solid var(--ve-line);border-radius:14px;overflow:hidden}.ve-dock-tabs{display:flex;gap:2px;border-bottom:1px solid var(--ve-line);padding:7px 9px}.ve-dock-tab{border:0;background:transparent;border-radius:8px;padding:8px 11px;font-size:.76rem;font-weight:900;color:#64748b}.ve-dock-tab.active{background:#eef2ff;color:#4338ca}.ve-dock-body{padding:13px}.ve-dock-pane{display:none}.ve-dock-pane.active{display:block}.ve-textarea{width:100%;border:1px solid #cbd5e1;border-radius:10px;padding:11px;line-height:1.6;resize:vertical}.ve-script{min-height:220px}.ve-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.ve-help{color:var(--ve-muted);font-size:.78rem;line-height:1.55;white-space:pre-line}.ve-plan{background:#0f172a;color:#dbeafe;border-radius:10px;padding:12px;white-space:pre-wrap;max-height:300px;overflow:auto}.ve-output{display:grid;grid-template-columns:1fr 1fr;gap:12px}.ve-output video{width:100%;max-height:300px;background:#000;border-radius:10px}@media(max-width:1200px){.ve-shell{grid-template-columns:190px 1fr;grid-template-rows:540px auto}.ve-copilot{grid-column:1/-1}.ve-copilot-body{display:grid;grid-template-columns:1fr 1fr;gap:12px}.ve-ai-title,.ve-submit{grid-column:1/-1}}@media(max-width:800px){.ve-page{padding:8px}.ve-shell{display:flex;flex-direction:column}.ve-media{max-height:190px}.ve-stage{height:480px}.ve-copilot-body,.ve-output{display:block}.ve-top{flex-wrap:wrap}.ve-title{order:2;flex-basis:70%}.ve-actions{margin-left:auto}.ve-grid2{grid-template-columns:1fr}}
</style>
<div class="ve-page">
 <header class="ve-top">
  <a class="ve-back" href="{{ path('panel/growth-hub/video-studio') }}" title="All projects">←</a>
  <div class="ve-title"><h1>{{ selected.title }}</h1><small>#{{ selected.id }} · {{ selected.source_name }}</small></div>
  <span class="ve-status">{{ selected.status }}</span>
  <div class="ve-actions">{% if selected.output_url %}<a class="ve-btn ghost" href="{{ path('panel/growth-hub/distribution') }}?mode=short-video&project={{ selected.id }}">Create reel</a>{% endif %}<button class="ve-btn purple" type="button" data-open-dock="export">Export</button></div>
 </header>
 <div class="ve-shell">
  <aside class="ve-panel ve-media">
   <div class="ve-panel-head"><h2>Project media</h2><small>{{ selected.project_files|length }}</small></div>
   <div class="ve-media-list">
    {% for file in selected.project_files %}<button class="ve-media-item {{ file.role=='SOURCE'?'active':'' }}" type="button" data-media-name="{{ file.relative_path }}"><small class="ve-role">{{ file.role }}</small><strong>{{ file.name }}</strong><small>{{ (file.bytes/1048576)|number_format(1) }} MB · {{ file.kind }}</small></button>{% else %}<p class="ve-help">No attached media.</p>{% endfor %}
    {% if assets %}<div class="ve-panel-head" style="margin:10px -8px 6px"><h2>Brand library</h2></div>{% for asset in assets %}<button class="ve-media-item" type="button" data-media-name="{{ asset.name }}"><small class="ve-role">{{ asset.asset_type }}</small><strong>{{ asset.name }}</strong></button>{% endfor %}{% endif %}
   </div>
  </aside>
  <section class="ve-panel ve-stage">
   <div class="ve-canvas">{% if selected.mime_type starts with 'video/' %}<video data-preview preload="metadata" src="{{ selected.source_url starts with 'vnv-local://' ? path('panel/growth-hub/video-studio/media')~'?id='~selected.id : selected.source_url }}"></video>{% elseif selected.mime_type starts with 'audio/' %}<audio data-preview controls src="{{ selected.source_url }}"></audio>{% else %}<div class="ve-canvas-empty">Preview unavailable</div>{% endif %}</div>
   <div class="ve-player">
    <div class="ve-player-row"><button type="button" class="ve-icon-btn" data-play>▶</button><span class="ve-time" data-current-time>00:00</span><input class="ve-seek" type="range" min="0" max="1000" value="0" data-seek><span class="ve-time" data-duration>00:00</span><button type="button" class="ve-icon-btn" data-mute>🔊</button></div>
    <div class="ve-tracks"><span class="ve-track-label">Video 1</span><div class="ve-track video"></div><span class="ve-track-label">Captions</span><div class="ve-track caption"></div></div>
   </div>
  </section>
  <aside class="ve-panel ve-copilot">
   <div class="ve-panel-head"><h2>AI Copilot</h2><small>OpenAI</small></div>
   <form method="post" class="ve-copilot-body" data-ai-form>
    <input type="hidden" name="id" value="{{ selected.id }}"><input type="hidden" name="transcript_text" value="{{ selected.transcript_text }}"><input type="hidden" name="subtitles_srt" value="{{ selected.subtitles_srt }}"><input type="hidden" name="insert_provider" value="openai">
    <div class="ve-ai-title"><span class="ve-ai-orb"></span><div><strong>Describe the edit</strong><small>One request can control the whole project.</small></div></div>
    <div><textarea class="ve-prompt" name="instructions" data-ai-prompt placeholder="Example: Make the first 30 seconds faster, remove filler words, add the intro, use venue-tour.mp4 at 00:42 and finish with the logo."></textarea>
     <div class="ve-chips"><button type="button" class="ve-chip" data-command="Create a strong hook in the first 3 seconds.">Strong hook</button><button type="button" class="ve-chip" data-command="Remove filler words and long silent pauses.">Clean speech</button><button type="button" class="ve-chip" data-command="Add purposeful punch-in zooms and smooth transitions.">Add motion</button><button type="button" class="ve-chip" data-command="Create dynamic captions that emphasize key words.">Dynamic captions</button><button type="button" class="ve-chip" data-command="Use the attached b-roll where it supports the spoken message.">Use b-roll</button></div>
     <label class="ve-field">Timed notes (optional)<textarea class="ve-input" rows="3" name="visual_insert_instructions" placeholder="00:18 show team.jpg for 3s&#10;00:42 transition to venue-tour.mp4"></textarea></label>
    </div>
    <div>
     <div class="ve-grid2"><label class="ve-field">Canvas<select class="ve-input" name="aspect_ratio"><option value="16:9">16:9 · 1080p</option><option value="16:9_4k">16:9 · 4K</option><option value="9:16">9:16 · Vertical</option><option value="4:5">4:5 · Portrait</option><option value="1:1">1:1 · Square</option></select></label><label class="ve-field">Captions<select class="ve-input" name="caption_style"><option value="clean">Clean</option><option value="dynamic">Dynamic</option><option value="kinetic">Word-by-word</option><option value="none">None</option></select></label></div>
     <details class="ve-advanced"><summary>Advanced controls</summary><div class="ve-grid2"><label class="ve-field">Style<select class="ve-input" name="style_preset"><option value="vnv_premium">VNV Premium</option><option value="marketing_educator">Marketing educator</option><option value="clean_documentary">Documentary</option></select></label><label class="ve-field">Motion<select class="ve-input" name="motion_intensity"><option>subtle</option><option selected>medium</option><option>high</option></select></label></div><label class="ve-field">Camera direction<input class="ve-input" name="motion_direction" value="AI decides purposeful moments only"></label>
      {% for field,label,types in [['logo_url','Logo',['LOGO']],['intro_url','Intro',['INTRO']],['outro_url','Outro',['OUTRO']],['overlay_url','Overlay',['OVERLAY']],['audio_url','Music',['AUDIO']]] %}<label class="ve-field">{{ label }}<select class="ve-input" name="{{ field }}"><option value="">AI decides / none</option>{% for file in selected.project_files %}{% if file.role in types %}<option value="{{ file.url }}">{{ file.relative_path }}</option>{% endif %}{% endfor %}{% for asset in assets %}{% if asset.asset_type in types %}<option value="{{ asset.asset_url }}">Library · {{ asset.name }}</option>{% endif %}{% endfor %}</select></label>{% endfor %}<label class="ve-field"><input type="checkbox" name="generate_visual_inserts" value="1"> Generate missing supporting images</label>
     </details>
     <button class="ve-btn purple ve-submit" name="action" value="generate_plan" {% if not selected.transcript_text %}disabled{% endif %}>Generate edit plan</button>
     {% if not selected.transcript_text %}<p class="ve-error">Generate the transcript below before asking AI to edit.</p>{% endif %}
    </div>
   </form>
  </aside>
 </div>
 <section class="ve-dock">
  <nav class="ve-dock-tabs"><button class="ve-dock-tab active" data-dock-tab="script">Script</button><button class="ve-dock-tab" data-dock-tab="cleanup">Smart cleanup</button><button class="ve-dock-tab" data-dock-tab="plan">Edit plan</button><button class="ve-dock-tab" data-dock-tab="export">Export</button></nav>
  <div class="ve-dock-body">
   <div class="ve-dock-pane active" data-dock-pane="script">{% if selected.transcript_text %}<form method="post"><input type="hidden" name="id" value="{{ selected.id }}"><textarea class="ve-textarea ve-script" name="transcript_text">{{ selected.transcript_text }}</textarea><details><summary><strong>Timed SRT captions</strong></summary><textarea class="ve-textarea ve-script" name="subtitles_srt">{{ selected.subtitles_srt }}</textarea></details><div class="ve-row mt-2"><button class="ve-btn" name="action" value="save_editor">Save script</button><span class="ve-help">Edit the transcript directly. Use Smart cleanup when text must also be removed from the final video.</span></div></form>{% else %}<div class="ve-row"><p class="ve-help">Create the timed transcript to unlock script editing, captions, cuts and AI direction.</p><form method="post"><input type="hidden" name="action" value="transcribe"><input type="hidden" name="id" value="{{ selected.id }}"><button class="ve-btn purple">{{ selected.status=='FAILED'?'Retry transcription':'Generate transcript + captions' }}</button></form></div>{% endif %}{% if selected.error_message %}<p class="ve-error">{{ selected.error_message }}</p>{% endif %}</div>
   <div class="ve-dock-pane" data-dock-pane="cleanup"><div class="ve-output"><div><h3>Remove words or moments</h3><p class="ve-help">Write filler words, unwanted phrases or entire sentences. Their timed caption blocks are also marked for removal from the final video.</p><form method="post"><input type="hidden" name="action" value="clean_captions"><input type="hidden" name="id" value="{{ selected.id }}"><textarea class="ve-textarea" rows="5" name="remove_phrases" placeholder="um, eh, you know&#10;complete sentence to remove"></textarea><button class="ve-btn purple mt-2">Remove from text + video</button></form></div><div><h3>Quick AI instruction</h3><p class="ve-help">For contextual edits, use the AI Copilot above. Examples:
“Keep this sentence but remove the pause before it.”
“Use only the clearest explanation between 01:20 and 02:10.”
“Remove repeated ideas without changing the meaning.”</p></div></div></div>
   <div class="ve-dock-pane" data-dock-pane="plan">{% if selected.edit_plan_json %}<pre class="ve-plan">{{ selected.edit_plan_json }}</pre>{% else %}<p class="ve-help">No AI edit plan yet. Describe the result in AI Copilot and generate the first plan.</p>{% endif %}{% if selected.revisions %}<details class="mt-2"><summary><strong>Version history · {{ selected.revisions|length }}</strong></summary>{% for revision in selected.revisions %}<p class="ve-help">#{{ revision.id }} · {{ revision.revision_type }} · {{ revision.created_at }}</p>{% endfor %}</details>{% endif %}</div>
   <div class="ve-dock-pane" data-dock-pane="export"><div class="ve-output"><div><h3>Final master</h3><p class="ve-help">The original stays untouched. Rendering applies the approved plan, script cuts, captions, motion, assets and output format.</p>{% if selected.status in ['QUEUED','RENDERING'] %}<p><strong>{{ selected.status=='QUEUED'?'Waiting for render worker…':'Rendering final MP4…' }}</strong></p>{% else %}<form method="post"><input type="hidden" name="action" value="queue_render"><input type="hidden" name="id" value="{{ selected.id }}"><button class="ve-btn purple" {% if not renderReady or not selected.transcript_text %}disabled{% endif %}>Render final MP4</button></form>{% endif %}<p class="{{ renderReady?'ve-ready':'ve-error' }}">{{ renderReady?'FFmpeg is ready.':'FFmpeg is unavailable.' }}</p></div><div>{% if selected.output_url %}<video controls src="{{ selected.output_url }}"></video><div class="ve-row mt-2"><a class="ve-btn" target="_blank" href="{{ selected.output_url }}">Open master</a><a class="ve-btn ghost" href="{{ path('panel/growth-hub/distribution') }}?mode=short-video&project={{ selected.id }}">Create reels</a></div>{% else %}<p class="ve-help">The completed master and download controls will appear here.</p>{% endif %}<form method="post" class="mt-3"><input type="hidden" name="action" value="duplicate_project"><input type="hidden" name="id" value="{{ selected.id }}"><button class="ve-btn ghost">Duplicate as remix</button></form></div></div></div>
  </div>
 </section>
</div>
<script>
const video=document.querySelector('[data-preview]'),seek=document.querySelector('[data-seek]'),current=document.querySelector('[data-current-time]'),duration=document.querySelector('[data-duration]');const clock=n=>{if(!Number.isFinite(n))return'00:00';const h=Math.floor(n/3600),m=Math.floor(n%3600/60),s=Math.floor(n%60);return(h?String(h).padStart(2,'0')+':':'')+String(m).padStart(2,'0')+':'+String(s).padStart(2,'0')};const sync=()=>{if(video?.duration){seek.value=String(Math.round(video.currentTime/video.duration*1000));current.textContent=clock(video.currentTime);duration.textContent=clock(video.duration)}};video?.addEventListener('loadedmetadata',sync);video?.addEventListener('timeupdate',sync);video?.addEventListener('play',()=>document.querySelector('[data-play]').textContent='❚❚');video?.addEventListener('pause',()=>document.querySelector('[data-play]').textContent='▶');document.querySelector('[data-play]')?.addEventListener('click',()=>video?.paused?video.play():video.pause());document.querySelector('[data-mute]')?.addEventListener('click',e=>{video.muted=!video.muted;e.currentTarget.textContent=video.muted?'🔇':'🔊'});seek?.addEventListener('input',()=>{if(video?.duration)video.currentTime=Number(seek.value)/1000*video.duration});
const prompt=document.querySelector('[data-ai-prompt]');document.querySelectorAll('[data-command]').forEach(button=>button.addEventListener('click',()=>{prompt.value+=(prompt.value.trim()?'\n':'')+button.dataset.command;prompt.focus()}));document.querySelectorAll('[data-media-name]').forEach(button=>button.addEventListener('click',async()=>{const name=button.dataset.mediaName;prompt.value+=(prompt.value.trim()?'\n':'')+'Use '+name+' where it best supports the story.';prompt.focus();try{await navigator.clipboard.writeText(name)}catch(e){}}));
function openDock(name){document.querySelectorAll('[data-dock-tab]').forEach(tab=>tab.classList.toggle('active',tab.dataset.dockTab===name));document.querySelectorAll('[data-dock-pane]').forEach(pane=>pane.classList.toggle('active',pane.dataset.dockPane===name));document.querySelector('.ve-dock')?.scrollIntoView({behavior:'smooth',block:'nearest'})}document.querySelectorAll('[data-dock-tab]').forEach(tab=>tab.addEventListener('click',()=>openDock(tab.dataset.dockTab)));document.querySelectorAll('[data-open-dock]').forEach(button=>button.addEventListener('click',()=>openDock(button.dataset.openDock)));
</script>
{% endblock %}
