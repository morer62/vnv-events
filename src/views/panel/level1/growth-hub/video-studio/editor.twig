  <div data-caption-style-section><h3 class="mt-3">Caption looks</h3><p class="ve-help">These previews use the same preset definitions passed to FFmpeg. Select one and adjust caption size if needed.</p><label class="ve-field">Caption size <input type="range" min="35" max="140" value="75" data-caption-size> <span data-caption-size-label>75%</span></label>
   <div class="ve-style-gallery">{% for style in captionStyles %}<button class="ve-style-card {{ loop.first?'active':'' }}" type="button" data-style-preset="{{ style.id }}" data-style-color="{{ style.color }}" data-style-outline="{{ style.outline }}" data-style-font="{{ style.font }}" data-style-scale="{{ style.scale }}" data-style-uppercase="{{ style.uppercase?'1':'0' }}"><span class="ve-style-sample" style="--caption-color:{{ style.color }};--caption-stroke:{{ style.outline }};--caption-font:{{ style.font }};--caption-scale:{{ style.scale }};--caption-transform:{{ style.uppercase?'uppercase':'none' }}">TRENDING TEXT</span><strong>{{ style.name }}</strong><small>{{ style.description }}</small></button>{% endfor %}</div>
  </div>
