let draggingText=false;textEventPreview.style.pointerEvents='auto';textEventPreview.style.cursor='move';textEventPreview.addEventListener('pointerdown',event=>{if(textEventPreview.hidden)return;draggingText=true;textEventPreview.setPointerCapture(event.pointerId);event.preventDefault()});textEventPreview.addEventListener('pointermove',event=>{if(!draggingText)return;const canvas=textEventPreview.parentElement.getBoundingClientRect();textEventPreview.style.left=Math.max(0,Math.min(100,(event.clientX-canvas.left)/canvas.width*100))+'%';textEventPreview.style.top=Math.max(0,Math.min(100,(event.clientY-canvas.top)/canvas.height*100))+'%'});textEventPreview.addEventListener('pointerup',event=>{if(!draggingText||!activeTextChip)return;draggingText=false;const canvas=textEventPreview.parentElement.getBoundingClientRect(),x=Math.max(0,Math.min(100,(event.clientX-canvas.left)/canvas.width*100)),y=Math.max(0,Math.min(100,(event.clientY-canvas.top)/canvas.height*100)),chip=activeTextChip;let options=(chip.dataset.commandOptions||'').split('|').map(item=>item.trim()).filter(item=>item&&!/^[xy]\s*:/i.test(item));options.push('x: '+x.toFixed(1),'y: '+y.toFixed(1));chip.dataset.commandOptions=options.join(' | ');chip.dataset.commandToken='['+chip.dataset.commandType+': '+chip.dataset.commandInstruction+' | '+options.join(' | ')+']';chip.closest('.ve-transcript-text')?.dispatchEvent(new Event('input'))});
const stopPreviewLoading=()=>previewLoading?.classList.remove('show');
video?.addEventListener('loadstart',()=>{if(video.dataset.hasProxy==='1')previewLoading?.classList.add('show')});video?.addEventListener('waiting',()=>previewLoading?.classList.add('show'));['loadedmetadata','canplay','playing','seeked','loadeddata','error','stalled','suspend'].forEach(name=>video?.addEventListener(name,stopPreviewLoading));
if(video?.readyState>=3)previewLoading?.classList.remove('show');
setTimeout(stopPreviewLoading,12000);
// Text and chip edits are composited immediately over the lightweight source.
// Autosave never blocks or reloads the player.
document.querySelector('[data-proxy-form]')?.addEventListener('submit',async event=>{event.preventDefault();const form=event.currentTarget,button=form.querySelector('button'),label=form.querySelector('p');button.disabled=true;button.textContent='Building lightweight preview…';if(label)label.textContent='You can keep this tab open. The master is never modified.';try{const response=await fetch(location.href,{method:'POST',body:new FormData(form),headers:{'X-Requested-With':'XMLHttpRequest'}});if(!response.ok)throw new Error('Preview request failed');button.textContent='Preview ready';location.reload()}catch(error){button.disabled=false;button.textContent='Retry fast preview';if(label){label.textContent='Preview failed without blocking the editor. Retry or continue editing the transcript.';label.style.color='#fca5a5'}}});
if(new URLSearchParams(location.search).get('autoproxy')==='1')setTimeout(()=>document.querySelector('[data-proxy-form]')?.requestSubmit(),250);
document.querySelectorAll('.ve-command-chip').forEach(chip=>chip.draggable=true);
const configuredSpeakers={{ selected.speaker_profiles|default([])|json_encode|raw }};
configuredSpeakers.forEach(person=>{const option=[...chipTarget.options].find(item=>item.value===(person.position+' speaker'));if(option)option.textContent=person.name+' · '+person.position});
