{% extends "templates/base.admin.twig" %}
{% block body %}
<style>.ep{max-width:1050px;padding:26px}.ep-hero{background:linear-gradient(135deg,#111827,#0f766e);color:#fff;border-radius:24px;padding:28px}.ep-card{background:#fff;border:1px solid #e5e7eb;border-radius:20px;padding:22px;margin-top:18px}.ep-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}.ep-input{width:100%;border:1px solid #cbd5e1;border-radius:12px;padding:11px}.ep-btn{border:0;border-radius:12px;background:#111827;color:#fff;padding:11px 15px;font-weight:850}@media(max-width:800px){.ep-grid{grid-template-columns:1fr 1fr}.ep{padding:14px}}</style>
<div class="ep"><a href="{{ path('panel/growth-hub') }}">← Growth Hub</a><section class="ep-hero"><h1>Editorial Automation</h1><p>Set weekly production targets. The AI proposes a trend- and service-aware calendar; every item still enters Approval Center.</p></section><form method="post" class="ep-card"><div class="ep-grid">{% for field,label in {'articles_per_week':'Articles','location_pages_per_week':'Locations','pages_per_week':'Pages','social_posts_per_week':'Social posts','video_posts_per_week':'Videos'} %}<label>{{ label }} / week<input class="ep-input" type="number" min="0" max="50" name="{{ field }}" value="{{ attribute(plan,field)|default(field=='articles_per_week'?1:(field=='social_posts_per_week'?3:(field=='video_posts_per_week'?1:0))) }}"></label>{% endfor %}</div><label class="d-block mt-3">Standing direction<textarea class="ep-input" rows="6" name="instructions" placeholder="Priorities, cities, services, tone, campaigns, exclusions…">{{ plan.instructions|default('') }}</textarea></label><div class="mt-3"><button class="ep-btn" name="action" value="save">Save settings</button> <button class="ep-btn" name="action" value="generate">Save + generate this week</button></div></form></div>
{% endblock %}
