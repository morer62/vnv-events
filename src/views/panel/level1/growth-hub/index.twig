{% extends "templates/base.admin.twig" %}
{% block body %}
<style>
.gh-wrap{padding:26px;max-width:1450px}.gh-hero{background:radial-gradient(circle at 85% 15%,rgba(73,242,194,.25),transparent 30%),linear-gradient(135deg,#0f172a,#312e81);border-radius:28px;color:#fff;padding:36px;margin-bottom:22px}.gh-hero small{color:#49f2c2;font-weight:900;letter-spacing:.15em}.gh-hero h1{font-size:2.5rem;font-weight:950;margin:7px 0}.gh-hero p{max-width:780px;color:#cbd5e1}.gh-stats,.gh-grid{display:grid;gap:16px}.gh-stats{grid-template-columns:repeat(4,1fr);margin-bottom:20px}.gh-stat,.gh-card,.gh-approval{background:#fff;border:1px solid #e5e7eb;border-radius:20px;padding:20px}.gh-stat strong{display:block;font-size:1.8rem}.gh-stat span{color:#64748b}.gh-grid{grid-template-columns:repeat(3,1fr)}.gh-card{min-height:240px;display:flex;flex-direction:column;box-shadow:0 12px 34px rgba(15,23,42,.06)}.gh-card i{color:#4f46e5}.gh-card h2{font-size:1.15rem;font-weight:950;margin-top:16px}.gh-card p{color:#64748b;flex:1}.gh-btn{background:#111827;color:#fff;border-radius:11px;padding:10px 14px;text-decoration:none;font-weight:850;width:max-content}.gh-badge{background:#fff7ed;color:#9a3412;border-radius:999px;padding:5px 8px;font-size:.72rem;font-weight:900}.gh-approvals{margin-top:24px}.gh-approval{display:flex;justify-content:space-between;gap:15px;margin-top:10px}@media(max-width:900px){.gh-grid{grid-template-columns:1fr 1fr}.gh-stats{grid-template-columns:1fr 1fr}}@media(max-width:620px){.gh-grid,.gh-stats{grid-template-columns:1fr}.gh-wrap{padding:14px}.gh-hero h1{font-size:2rem}}
</style>
<div class="gh-wrap">
 <section class="gh-hero"><small>VNV EVENTS CREATIVE OPERATING SYSTEM</small><h1>Growth Hub</h1><p>Create, review and distribute articles, images, videos, carousels and social posts. Automations can operate these same workspaces in the background, but every final publication stays behind approval.</p></section>
 <div class="gh-stats"><div class="gh-stat"><strong>{{ content.total|default(0) }}</strong><span>Content items</span></div><div class="gh-stat"><strong>{{ content.generated|default(0) }}</strong><span>Awaiting CMS publication</span></div><div class="gh-stat"><strong>{{ media.ready|default(0) }}</strong><span>Ready video projects</span></div><div class="gh-stat"><strong>{{ approvals|length }}</strong><span>Creative approvals</span></div></div>
 <div class="gh-grid">
  <article class="gh-card"><i data-feather="edit-3"></i><h2>Article & Page Studio</h2><p>Create from zero or a searchable VNV base page/article, then send any generated body to OpenAI, Claude or Gemini for revision before publication.</p><div class="gh-actions"><a class="gh-btn" href="{{ path('panel/cms/pages/create') }}?mode=ai">Create</a> <a class="gh-btn" href="{{ path('panel/agents/detail') }}?key=blog_writer">Review existing</a></div></article>
  <article class="gh-card"><i data-feather="film"></i><h2>Video Studio</h2><p>Transcription, captions, color, audio, brand assets, AI edit plans and final FFmpeg rendering.</p><a class="gh-btn" href="{{ path('panel/growth-hub/video-studio') }}">Open studio</a></article>
  <article class="gh-card"><i data-feather="share-2"></i><h2>Social Publisher</h2><p>Create platform-specific Facebook, Instagram and LinkedIn drafts from approved content.</p><a class="gh-btn" href="{{ path('panel/growth-hub/distribution') }}?mode=social">Prepare posts</a></article>
  <article class="gh-card"><i data-feather="layers"></i><h2>Instagram Carousel</h2><p>Generate covers, slides, captions, visual prompts and hashtags for approval.</p><a class="gh-btn" href="{{ path('panel/growth-hub/distribution') }}?mode=carousel">Create carousel</a></article>
  <article class="gh-card"><i data-feather="video"></i><h2>Short Video Studio</h2><p>Turn ready projects into Reels, Shorts and TikTok deliverables with branded captions and platform copy.</p><a class="gh-btn" href="{{ path('panel/growth-hub/distribution') }}?mode=short-video">Prepare short video</a></article>
  <article class="gh-card"><i data-feather="cpu"></i><h2>Automations</h2><p>Schedules, webhooks, operational agents, run history and autonomous production triggers.</p><a class="gh-btn" href="{{ path('panel/agents') }}">Open automations</a></article>
  <article class="gh-card"><i data-feather="calendar"></i><h2>Editorial Automation</h2><p>Weekly quotas for articles, location pages, pages, social posts and videos with a modifiable AI plan.</p><a class="gh-btn" href="{{ path('panel/growth-hub/settings') }}">Configure calendar</a></article>
  <article class="gh-card"><i data-feather="check-square"></i><h2>Approval Center</h2><p>Tabbed review for social output, estimates, reminder batches, content and operational actions.</p><a class="gh-btn" href="{{ path('panel/agents/approvals') }}">Review queue</a></article>
 </div>
 {% if approvals %}<section class="gh-approvals"><h2>Creative work awaiting approval</h2>{% for approval in approvals|slice(0,10) %}<div class="gh-approval"><div><strong>{{ approval.agent_name }}</strong><div>{{ approval.title }}</div></div><a class="gh-btn" href="{{ path('panel/agents/approval') }}?id={{ approval.id }}">Review</a></div>{% endfor %}</section>{% endif %}
</div>
{% endblock %}
