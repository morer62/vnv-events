{% extends "templates/base.admin.twig" %}
{% block body %}
<style>
.ds-wrap{max-width:1250px;padding:26px}.ds-hero{background:linear-gradient(135deg,#111827,#4f46e5);border-radius:24px;color:#fff;padding:28px;margin:16px 0}.ds-tabs{display:flex;gap:8px;flex-wrap:wrap}.ds-tab,.ds-btn{border:0;border-radius:11px;padding:10px 14px;text-decoration:none;font-weight:850}.ds-tab{background:#eef2ff;color:#3730a3}.ds-tab.active,.ds-btn{background:#111827;color:#fff}.ds-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:18px}.ds-card{background:#fff;border:1px solid #e5e7eb;border-radius:18px;padding:20px;margin-bottom:16px}.ds-input{width:100%;border:1px solid #cbd5e1;border-radius:11px;padding:11px;margin:7px 0}.ds-network{display:inline-block;border:1px solid #cbd5e1;border-radius:12px;padding:10px;margin:5px}.ds-approval{border-top:1px solid #e5e7eb;padding:12px 0}.ds-connected{color:#047857;font-weight:900}@media(max-width:800px){.ds-grid{grid-template-columns:1fr}.ds-wrap{padding:14px}}
</style>
<div class="ds-wrap"><a href="{{ path('panel/growth-hub') }}">← Growth Hub</a><section class="ds-hero"><h1>Distribution Studio</h1><p>Turn approved VNV content and video into channel-specific deliverables, then review every version before publishing.</p></section>
<nav class="ds-tabs"><a class="ds-tab {{ mode=='social'?'active':'' }}" href="?mode=social">Social Publisher</a><a class="ds-tab {{ mode=='carousel'?'active':'' }}" href="?mode=carousel">Instagram Carousel</a><a class="ds-tab {{ mode=='short-video'?'active':'' }}" href="?mode=short-video">Short Video</a></nav>
<div class="ds-grid mt-3"><main><section class="ds-card"><h2>{{ agent.name }}</h2><p>{{ agent.description }}</p><form method="post" data-run><input type="hidden" name="action" value="run"><input type="hidden" name="mode" value="{{ mode }}">
{% if mode=='social' %}<label>Intelligent source<select class="ds-input" name="source_kind" data-source-kind><option value="content">Article / CMS page</option><option value="video">Completed video project</option><option value="trend">Current YouTube format signals</option></select></label>{% endif %}
{% if mode in ['social','carousel'] %}<label data-source-content>Source content<select class="ds-input" name="content_id" {% if mode=='carousel' %}required{% endif %}><option value="">Select approved/generated content</option>{% for item in contents %}<option value="{{ item.id }}">#{{ item.id }} — {{ item.title }} ({{ item.status }})</option>{% endfor %}</select></label>{% endif %}
{% if mode=='social' %}<label data-source-video hidden>Completed video project<select class="ds-input" name="media_job_id"><option value="">Select video</option>{% for item in media %}<option value="{{ item.id }}">#{{ item.id }} — {{ item.title }}</option>{% endfor %}</select></label><label>Networks</label><div>{% for network in ['facebook','instagram','linkedin','youtube'] %}<label class="ds-network"><input type="checkbox" name="networks[]" value="{{ network }}"> {{ network|capitalize }}</label>{% endfor %}</div>{% endif %}
{% if mode=='carousel' %}<label class="ds-network"><input type="checkbox" name="generate_images" value="1"> Generate final slide images</label><select class="ds-input" name="image_provider"><option value="gemini">Gemini image</option><option value="openai">OpenAI image</option></select>{% endif %}
{% if mode=='short-video' %}<label>Ready video project<select class="ds-input" name="media_job_id" required><option value="">Select project</option>{% for item in media %}<option value="{{ item.id }}">#{{ item.id }} — {{ item.title }} ({{ item.status }})</option>{% endfor %}</select></label>{% endif %}
<button class="ds-btn mt-2">Generate for approval</button></form></section>
<section class="ds-card"><h2>Pending approvals</h2>{% for approval in approvals %}{% if approval.status=='PENDING' %}<div class="ds-approval"><strong>{{ approval.title }}</strong><br><a href="{{ path('panel/agents/approval') }}?id={{ approval.id }}">Review, edit or request changes</a></div>{% endif %}{% else %}<p>No pending items.</p>{% endfor %}</section></main>
<aside><section class="ds-card"><h2>Network connections</h2><p>Credentials are encrypted independently per network.</p>{% for platform in ['facebook','instagram','linkedin'] %}{% set c=connections[platform]|default(null) %}<div class="ds-approval"><strong>{{ platform|capitalize }}</strong>{% if c and c.status!='DISCONNECTED' %}<span class="ds-connected"> · {{ c.status|capitalize }}</span><small class="d-block">{{ c.account_label }} · token ending {{ c.credential_hint }}</small>{% if c.last_error %}<small class="text-danger d-block">{{ c.last_error }}</small>{% endif %}{% endif %}<form method="post"><input type="hidden" name="action" value="save_connection"><input type="hidden" name="mode" value="{{ mode }}"><input type="hidden" name="platform" value="{{ platform }}"><input class="ds-input" name="account_label" value="{{ c.account_label|default('') }}" placeholder="Account name"><input class="ds-input" name="account_identifier" value="{{ c.account_identifier|default('') }}" placeholder="Page, account ID or URN"><input class="ds-input" type="password" name="access_token" placeholder="{{ c?'Leave blank to keep token':'Access token' }}">{% if platform=='facebook' %}<input class="ds-input" type="password" name="app_secret" placeholder="App secret (optional; keep blank to preserve)"><input class="ds-input" type="password" name="verify_token" placeholder="Webhook verify token (optional)">{% endif %}<button class="ds-btn">Save</button></form>{% if c and c.status!='DISCONNECTED' %}<form method="post" class="mt-2"><input type="hidden" name="action" value="verify_connection"><input type="hidden" name="mode" value="{{ mode }}"><input type="hidden" name="platform" value="{{ platform }}"><button class="ds-btn">Verify now</button></form>{% endif %}</div>{% endfor %}</section></aside></div></div>
<script>const run=document.querySelector('[data-run]'),kind=run?.querySelector('[data-source-kind]');function sourceFields(){const value=kind?.value||'content';run?.querySelector('[data-source-content]')?.toggleAttribute('hidden',value!=='content');run?.querySelector('[data-source-video]')?.toggleAttribute('hidden',value!=='video')}kind?.addEventListener('change',sourceFields);sourceFields();run?.addEventListener('submit',function(e){if(this.querySelector('[name="networks[]"]')&&!this.querySelector('[name="networks[]"]:checked')){e.preventDefault();alert('Select at least one network.')}});</script>
{% endblock %}
