{% extends "templates/base.admin.twig" %}
{% block body %}
<style>
.ds-wrap{max-width:1250px;padding:26px}.ds-hero{background:linear-gradient(135deg,#111827,#4f46e5);border-radius:24px;color:#fff;padding:28px;margin:16px 0}.ds-tabs{display:flex;gap:8px;flex-wrap:wrap}.ds-tab,.ds-btn{border:0;border-radius:11px;padding:10px 14px;text-decoration:none;font-weight:850}.ds-tab{background:#eef2ff;color:#3730a3}.ds-tab.active,.ds-btn{background:#111827;color:#fff}.ds-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:18px}.ds-card{background:#fff;border:1px solid #e5e7eb;border-radius:18px;padding:20px;margin-bottom:16px}.ds-input{width:100%;border:1px solid #cbd5e1;border-radius:11px;padding:11px;margin:7px 0}.ds-network{display:inline-block;border:1px solid #cbd5e1;border-radius:12px;padding:10px;margin:5px}.ds-approval{border-top:1px solid #e5e7eb;padding:12px 0}.ds-connected{color:#047857;font-weight:900}@media(max-width:800px){.ds-grid{grid-template-columns:1fr}.ds-wrap{padding:14px}}
.ds-hero h1{color:#fff}
.ds-grid.solo{grid-template-columns:1fr}
.ds-reel-editor{display:grid;grid-template-columns:220px 290px minmax(300px,1fr);gap:12px}.ds-reel-panel{border:1px solid #e2e8f0;border-radius:14px;padding:14px;background:#f8fafc}.ds-reel-panel h3{font-size:.82rem;font-weight:950;text-transform:uppercase;letter-spacing:.05em}.ds-phone{height:460px;border-radius:24px;background:#080b14;border:7px solid #111827;overflow:hidden;display:flex;align-items:center;justify-content:center;color:#94a3b8}.ds-phone video{width:100%;height:100%;object-fit:contain}.ds-reel-prompt{min-height:190px}.ds-reel-chips{display:flex;flex-wrap:wrap;gap:6px}.ds-reel-chip{border:1px solid #cbd5e1;background:#fff;border-radius:999px;padding:7px 9px;font-size:.72rem;font-weight:850}.ds-reel-options{display:grid;grid-template-columns:1fr 1fr;gap:8px}.ds-project-list{max-height:370px;overflow:auto}.ds-project-option{display:block;border:1px solid #e2e8f0;background:#fff;border-radius:9px;padding:9px;margin:6px 0;color:#0f172a}.ds-project-option.active{border-color:#6366f1;background:#eef2ff}@media(max-width:1000px){.ds-reel-editor{grid-template-columns:200px 260px 1fr}}@media(max-width:800px){.ds-reel-editor{grid-template-columns:1fr}.ds-phone{height:520px;max-width:330px;margin:auto}}
</style>
<div class="ds-wrap"><a href="{{ path('panel/growth-hub') }}">← Growth Hub</a><section class="ds-hero"><h1>Social Media Studio</h1><p>One workspace for short reels, carousels and channel-specific posts. Every deliverable starts from finished VNV content and goes through approval before publishing.</p></section>
<nav class="ds-tabs"><a class="ds-tab {{ mode=='social'?'active':'' }}" href="?mode=social">Posts & publishing</a><a class="ds-tab {{ mode=='carousel'?'active':'' }}" href="?mode=carousel">Carousels</a><a class="ds-tab {{ mode=='short-video'?'active':'' }}" href="?mode=short-video">Short reels</a></nav>
<div class="ds-grid mt-3 {{ mode!='social'?'solo':'' }}"><main><section class="ds-card"><h2>{{ mode=='short-video'?'Short Reel Editor':agent.name }}</h2><p>{{ mode=='short-video'?'Turn a finished master into a focused vertical social edit.':agent.description }}</p><form method="post" data-run><input type="hidden" name="action" value="run"><input type="hidden" name="mode" value="{{ mode }}">
{% if mode=='social' %}<label>Intelligent source<select class="ds-input" name="source_kind" data-source-kind><option value="content">Article / CMS page</option><option value="video">Completed video project</option><option value="trend">Current YouTube format signals</option></select></label>{% endif %}
{% if mode in ['social','carousel'] %}<label data-source-content>Source content<select class="ds-input" name="content_id" {% if mode=='carousel' %}required{% endif %}><option value="">Select approved/generated content</option>{% for item in contents %}<option value="{{ item.id }}">#{{ item.id }} — {{ item.title }} ({{ item.status }})</option>{% endfor %}</select></label>{% endif %}
{% if mode=='social' %}<label data-source-video hidden>Completed video project<select class="ds-input" name="media_job_id"><option value="">Select video</option>{% for item in media %}<option value="{{ item.id }}">#{{ item.id }} — {{ item.title }}</option>{% endfor %}</select></label><label>Networks</label><div>{% for network in ['facebook','instagram','linkedin','youtube'] %}<label class="ds-network"><input type="checkbox" name="networks[]" value="{{ network }}"> {{ network|capitalize }}</label>{% endfor %}</div>{% endif %}
{% if mode=='carousel' %}<label class="ds-network"><input type="checkbox" name="generate_images" value="1"> Generate final slide images with OpenAI</label><input type="hidden" name="image_provider" value="openai">{% endif %}
{% if mode=='short-video' %}<div class="ds-reel-editor"><aside class="ds-reel-panel"><h3>Finished masters</h3><input type="hidden" name="media_job_id" value="{{ selectedProject }}" data-reel-project required><div class="ds-project-list">{% for item in media %}<a class="ds-project-option {{ selectedProject==item.id?'active':'' }}" href="?mode=short-video&project={{ item.id }}"><strong>#{{ item.id }}</strong><small class="d-block">{{ item.title }}</small></a>{% else %}<p class="text-muted">Render a completed master in Video Studio first.</p>{% endfor %}</div></aside><section class="ds-reel-panel"><h3>Vertical preview</h3><div class="ds-phone">{% if selectedMedia %}<video controls preload="metadata" src="{{ selectedMedia.output_url }}"></video>{% else %}<span>Select a completed master</span>{% endif %}</div></section><section class="ds-reel-panel"><h3>Reel Copilot</h3><p class="text-muted">Describe the result once. OpenAI selects the excerpt and creates fresh social captions from its script.</p><textarea class="ds-input ds-reel-prompt" name="reel_instructions" data-reel-prompt placeholder="Create a 30-second educational reel. Start with the strongest statement, remove pauses, use quick punch-in zooms and emphasize the key words."></textarea><div class="ds-reel-chips"><button type="button" class="ds-reel-chip" data-reel-command="Open with the strongest 3-second hook.">Strong hook</button><button type="button" class="ds-reel-chip" data-reel-command="Remove pauses and keep the pacing fast.">Fast pacing</button><button type="button" class="ds-reel-chip" data-reel-command="Use word-by-word captions with key-word emphasis.">Trending captions</button><button type="button" class="ds-reel-chip" data-reel-command="Add purposeful punch-in zooms and quick transitions.">Motion</button></div><div class="ds-reel-options"><label>Captions<select class="ds-input" name="caption_style"><option value="kinetic">Word-by-word</option><option value="dynamic">Dynamic phrases</option><option value="clean">Clean</option></select></label><label>Length<select class="ds-input" name="target_duration"><option value="30">30 seconds</option><option value="45">45 seconds</option><option value="60">60 seconds</option></select></label></div><button class="ds-btn mt-2" {% if not selectedMedia %}disabled{% endif %}>Generate reel plan</button><p class="text-muted mt-2"><small>The master remains unchanged. The reel receives a new vertical caption treatment.</small></p></section></div>{% else %}<button class="ds-btn mt-2">Generate for approval</button>{% endif %}</form></section>
<section class="ds-card"><h2>Pending approvals</h2>{% for approval in approvals %}{% if approval.status=='PENDING' %}<div class="ds-approval"><strong>{{ approval.title }}</strong><br><a href="{{ path('panel/agents/approval') }}?id={{ approval.id }}">Review, edit or request changes</a></div>{% endif %}{% else %}<p>No pending items.</p>{% endfor %}</section></main>
{% if mode=='social' %}<aside><section class="ds-card"><h2>Network connections</h2><p>Credentials are encrypted independently per network.</p>{% for platform in ['facebook','instagram','linkedin'] %}{% set c=connections[platform]|default(null) %}<div class="ds-approval"><strong>{{ platform|capitalize }}</strong>{% if c and c.status!='DISCONNECTED' %}<span class="ds-connected"> · {{ c.status|capitalize }}</span><small class="d-block">{{ c.account_label }} · token ending {{ c.credential_hint }}</small>{% if c.last_error %}<small class="text-danger d-block">{{ c.last_error }}</small>{% endif %}{% endif %}<form method="post"><input type="hidden" name="action" value="save_connection"><input type="hidden" name="mode" value="{{ mode }}"><input type="hidden" name="platform" value="{{ platform }}"><input class="ds-input" name="account_label" value="{{ c.account_label|default('') }}" placeholder="Account name"><input class="ds-input" name="account_identifier" value="{{ c.account_identifier|default('') }}" placeholder="Page, account ID or URN"><input class="ds-input" type="password" name="access_token" placeholder="{{ c?'Leave blank to keep token':'Access token' }}">{% if platform=='facebook' %}<input class="ds-input" type="password" name="app_secret" placeholder="App secret (optional; keep blank to preserve)"><input class="ds-input" type="password" name="verify_token" placeholder="Webhook verify token (optional)">{% endif %}<button class="ds-btn">Save</button></form>{% if c and c.status!='DISCONNECTED' %}<form method="post" class="mt-2"><input type="hidden" name="action" value="verify_connection"><input type="hidden" name="mode" value="{{ mode }}"><input type="hidden" name="platform" value="{{ platform }}"><button class="ds-btn">Verify now</button></form>{% endif %}</div>{% endfor %}</section></aside>{% endif %}</div></div>
<script>const run=document.querySelector('[data-run]'),kind=run?.querySelector('[data-source-kind]');function sourceFields(){const value=kind?.value||'content';run?.querySelector('[data-source-content]')?.toggleAttribute('hidden',value!=='content');run?.querySelector('[data-source-video]')?.toggleAttribute('hidden',value!=='video')}kind?.addEventListener('change',sourceFields);sourceFields();run?.addEventListener('submit',function(e){if(this.querySelector('[name="networks[]"]')&&!this.querySelector('[name="networks[]"]:checked')){e.preventDefault();alert('Select at least one network.')}});const reelPrompt=document.querySelector('[data-reel-prompt]');document.querySelectorAll('[data-reel-command]').forEach(button=>button.addEventListener('click',()=>{reelPrompt.value+=(reelPrompt.value.trim()?'\n':'')+button.dataset.reelCommand;reelPrompt.focus()}));</script>
{% endblock %}
