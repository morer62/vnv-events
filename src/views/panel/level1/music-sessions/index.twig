{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<main class="container-fluid">
    <h1 class="h3 mb-3">🎵 Music Sessions</h1>
    {{ macros.breadcrumb2() }}

    <div class="d-flex justify-content-between mb-3">
        <a href="{{ path('panel/music-sessions/create') }}" class="btn btn-primary">
            <i data-feather="plus"></i> Add New Session
        </a>
        <a href="{{ path('panel/music-sessions/categories') }}" class="btn btn-outline-secondary">
            <i data-feather="tag"></i> Manage Categories
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            {% if sessions|length > 0 %}
                <div class="row">
                    {% for session in sessions %}
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">{{ session.title }}</h5>
                                    <span class="badge bg-{{ session.is_active ? 'success' : 'secondary' }}">
                                        {{ session.is_active ? 'Active' : 'Inactive' }}
                                    </span>
                                </div>
                                <div class="card-body">
                                    {% if session.description %}
                                        <p class="text-muted">{{ session.description|slice(0, 100) }}{% if session.description|length > 100 %}...{% endif %}</p>
                                    {% endif %}
                                    
                                    <div class="mb-2">
                                        <small class="text-muted">Platform:</small>
                                        <span class="badge bg-info">{{ session.platform|upper }}</span>
                                    </div>
                                    
                                    {% if session.category_name %}
                                        <div class="mb-2">
                                            <small class="text-muted">Category:</small>
                                            <span class="badge bg-primary">{{ session.category_name }}</span>
                                        </div>
                                    {% endif %}
                                    
                                    {% if session.keywords and session.keywords|length > 0 %}
                                        <div class="mb-2">
                                            <small class="text-muted">Keywords:</small>
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                {% for keyword in session.keywords %}
                                                    <span class="badge bg-secondary">{{ keyword.keyword }}</span>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endif %}
                                    
                                    <div class="mb-3">
                                        <small class="text-muted">URL:</small>
                                        <a href="{{ session.url }}" target="_blank" class="d-block text-truncate" style="max-width: 100%;">
                                            {{ session.url|slice(0, 50) }}...
                                        </a>
                                    </div>
                                    
                                    {% if session.embed_code %}
                                        <div class="mb-3">
                                            <div class="ratio ratio-16x9">
                                                {{ session.embed_code|raw }}
                                            </div>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="card-footer">
                                    <div class="btn-group w-100" role="group">
                                        <a href="{{ path('panel/music-sessions/edit') }}?id={{ session.id }}" class="btn btn-sm btn-primary">
                                            <i data-feather="edit"></i> Edit
                                        </a>
                                        <form method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this session?');">
                                            <input type="hidden" name="id" value="{{ session.id }}">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i data-feather="trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center text-muted py-5">
                    <h5>No music sessions found</h5>
                    <p class="mb-3">Start by creating your first music session.</p>
                    <a href="{{ path('panel/music-sessions/create') }}" class="btn btn-primary">
                        <i data-feather="plus"></i> Add New Session
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</main>
{% endblock %}




