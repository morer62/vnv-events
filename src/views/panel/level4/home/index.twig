{% extends 'templates/base.admin.twig' %}

{% set show_whatsapp = true %}

{% block body %}
<main class="vnv-team-home mt-4 container pb-5">

  <style>
    :root{
      --vnv-primary:#5EC6C4;
      --vnv-primary-dark:#49acab;
      --vnv-gold:#D4A84F;
      --vnv-gold-soft:rgba(212,168,79,.14);
      --vnv-black:#0B0B0C;
      --vnv-black-soft:#111214;
      --vnv-black-card:#15181a;
      --vnv-border:rgba(255,255,255,.08);
      --vnv-text:#F6F1E8;
      --vnv-text-muted:#B5ADA3;
      --vnv-light-card:#F7F3ED;
      --vnv-shadow:0 20px 54px rgba(0,0,0,.16);
      --vnv-shadow-soft:0 18px 42px rgba(0,0,0,.10);
    }

    .vnv-team-home{
      color:var(--vnv-text);
    }

    .vnv-badge{
      display:inline-flex;
      align-items:center;
      gap:.5rem;
      border-radius:999px;
      padding:.58rem .95rem;
      font-size:.82rem;
      font-weight:900;
      letter-spacing:1.2px;
      text-transform:uppercase;
      background:rgba(94,198,196,.12);
      border:1px solid rgba(94,198,196,.22);
      color:var(--vnv-primary);
    }

    .vnv-hero{
      position:relative;
      overflow:hidden;
      border-radius:30px;
      padding:2rem 1.8rem;
      color:#fff;
      background:
        radial-gradient(900px 420px at 0% 0%, rgba(94,198,196,.16), transparent 60%),
        radial-gradient(260px 260px at 100% 0%, rgba(212,168,79,.12), transparent 72%),
        linear-gradient(135deg, #0B0B0C 0%, #111214 55%, #191c1f 100%);
      box-shadow:var(--vnv-shadow);
      margin-bottom:2rem;
    }

    .vnv-hero:after{
      content:"";
      position:absolute;
      right:-70px;
      top:-70px;
      width:220px;
      height:220px;
      background:radial-gradient(circle, rgba(255,255,255,.08) 0%, rgba(255,255,255,0) 70%);
      pointer-events:none;
    }

    .vnv-hero > *{
      position:relative;
      z-index:2;
    }

    .vnv-hero-logo{
      max-width:92px;
      margin:1rem 0 .95rem;
      filter:drop-shadow(0 8px 20px rgba(0,0,0,.20));
    }

    .vnv-hero h1{
      font-size:clamp(2rem,4vw,3.05rem);
      line-height:1.04;
      font-weight:900;
      letter-spacing:0;
      margin-bottom:.8rem;
      max-width:860px;
      color:#fff !important;
      text-shadow:0 10px 30px rgba(0,0,0,.34);
    }

    .vnv-hero h1 .gold{
      color:var(--vnv-gold);
    }

    .vnv-hero p{
      max-width:760px;
      color:#ddd5ca;
      line-height:1.76;
      font-size:1rem;
      margin-bottom:1.2rem;
    }

    .vnv-hero-actions{
      display:flex;
      flex-wrap:wrap;
      gap:.85rem;
      margin-top:1rem;
    }

    .btn-vnv-main{
      background:linear-gradient(135deg, #6ed5d3 0%, #5EC6C4 50%, #8cd9d7 100%);
      color:#081011 !important;
      padding:1rem 1.55rem;
      font-size:1rem;
      border-radius:999px;
      text-decoration:none;
      font-weight:900;
      display:inline-flex;
      gap:.55rem;
      align-items:center;
      justify-content:center;
      border:none;
      box-shadow:0 12px 28px rgba(94,198,196,.25);
      transition:all .22s ease;
    }

    .btn-vnv-main:hover{
      transform:translateY(-2px);
    }

    .btn-vnv-light{
      padding:.92rem 1.25rem;
      font-size:1rem;
      border-radius:999px;
      font-weight:800;
      border:1.2px solid rgba(255,255,255,.18);
      color:#fff !important;
      background:rgba(255,255,255,.07);
      text-decoration:none;
      display:inline-flex;
      align-items:center;
      gap:.45rem;
      justify-content:center;
      backdrop-filter:blur(6px);
      transition:all .2s ease;
    }

    .btn-vnv-light:hover{
      background:rgba(255,255,255,.14);
      transform:translateY(-1px);
    }

    .vnv-section-head{
      margin-bottom:1.15rem;
    }

    .vnv-title{
      font-weight:900;
      font-size:clamp(1.6rem,3vw,2.3rem);
      line-height:1.12;
      letter-spacing:0;
      margin-bottom:.5rem;
      color:#15181a;
    }

    .vnv-title .highlight{
      color:#247170;
    }

    .vnv-subtitle{
      color:#69787b;
      font-size:1rem;
      line-height:1.75;
      margin-bottom:0;
      max-width:760px;
    }

    .vnv-main-card p,
    .vnv-subtitle,
    .vnv-hero p,
    .vnv-final p{
      display:none;
    }

    .vnv-main-card{
      background:#fff;
      padding:1.8rem 1.35rem;
      border-radius:24px;
      box-shadow:var(--vnv-shadow-soft);
      border:1px solid rgba(17,24,26,.06);
      height:100%;
      transition:all .22s ease;
      text-align:center;
    }

    .vnv-main-card:hover{
      transform:translateY(-4px);
      box-shadow:0 24px 54px rgba(0,0,0,.10);
    }

    .vnv-main-card i.big-icon{
      font-size:2rem;
      color:#247170;
      margin-bottom:.95rem;
    }

    .vnv-main-card h3{
      font-size:1.24rem;
      font-weight:900;
      margin-bottom:.65rem;
      color:#141a1b;
    }

    .vnv-main-card p{
      color:#6b7a7d;
      line-height:1.68;
      margin-bottom:1rem;
    }

    .vnv-link-btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:.45rem;
      padding:.82rem 1.15rem;
      border-radius:999px;
      font-weight:900;
      text-decoration:none;
      background:#eef8f8;
      color:#1f6e6d;
      border:1px solid #d7ecec;
      transition:all .2s ease;
    }

    .vnv-link-btn:hover{
      background:#def3f2;
      color:#145958;
      transform:translateY(-1px);
    }

    .vnv-mini-row{
      display:grid;
      grid-template-columns:repeat(4, 1fr);
      gap:1rem;
      margin-top:1.2rem;
    }

    .vnv-mini-card{
      background:#14181a;
      border:1px solid rgba(255,255,255,.08);
      border-radius:22px;
      padding:1.1rem .9rem;
      text-align:center;
      text-decoration:none;
      color:#fff !important;
      transition:all .22s ease;
      box-shadow:0 14px 34px rgba(0,0,0,.10);
    }

    .vnv-mini-card-button{
      width:100%;
      min-height:100%;
      cursor:pointer;
      font-family:inherit;
    }

    .vnv-mini-card:hover{
      transform:translateY(-3px);
      border-color:rgba(94,198,196,.22);
    }

    .vnv-mini-card i{
      font-size:1.25rem;
      color:var(--vnv-gold);
      margin-bottom:.7rem;
      display:block;
    }

    .vnv-mini-card span{
      display:block;
      font-size:.95rem;
      font-weight:800;
      line-height:1.4;
      color:#f6f1e8;
    }

    .vnv-final{
      margin-top:2rem;
      background:linear-gradient(135deg,#121516 0%, #1b2022 100%);
      color:#fff;
      border-radius:26px;
      padding:2rem 1.3rem;
      box-shadow:0 20px 50px rgba(0,0,0,.16);
      text-align:center;
    }

    .vnv-final p{
      max-width:720px;
      margin:0 auto 1.2rem;
      color:#d5cec3;
      font-size:1rem;
      line-height:1.75;
    }

    @media (max-width: 991px){
      .vnv-mini-row{
        grid-template-columns:repeat(2,1fr);
      }
    }

    @media (max-width: 768px){
      .vnv-hero{
        padding:1.4rem 1.05rem;
        border-radius:22px;
      }

      .vnv-main-card,
      .vnv-final,
      .vnv-mini-card{
        border-radius:20px;
      }

      .vnv-hero-actions{
        flex-direction:column;
      }

      .btn-vnv-main,
      .btn-vnv-light{
        width:100%;
      }

      .vnv-mini-row{
        grid-template-columns:1fr 1fr;
      }
    }


    .vnv-hero h1{
  font-size:clamp(2rem,4vw,3.15rem);
  line-height:1.04;
  font-weight:900;
  letter-spacing:0;
  margin-bottom:.8rem;
  max-width:860px;
  color:#fff !important;
  text-shadow:0 10px 30px rgba(0,0,0,.34);
}
  </style>

  <section class="vnv-hero">
    <span class="vnv-badge">
      <i class="fa-solid fa-briefcase"></i> Team Flow
    </span>

    <div>
      <img src="{{ asset_for('assets/images/planner-hub-logo-positive.png') }}" class="vnv-hero-logo" alt="VNV Events Logo">
    </div>

    <h1>
      Welcome back{% if user.name is defined and user.name %}, {{ user.name }}{% endif %}. <span class="gold">Move through your work with clarity.</span>
    </h1>

    <p>
      Track time, check your assigned jobs and stay aligned with event execution in one clean team workspace.
    </p>

    <div class="vnv-hero-actions">
      <a href="{{ path('panel/planner-hub/team/payroll/clock') }}" class="btn-vnv-main">
        <i class="fa-solid fa-clock"></i> Clock In / Out
      </a>

      <a href="{{ path('panel/planner-hub/team/contracts') }}" class="btn-vnv-light">
        <i class="fa-solid fa-file-contract"></i> My Contract
      </a>

      <a href="{{ path('panel/planner-hub/team/orders/orders/') }}" class="btn-vnv-light">
        <i class="fa-solid fa-calendar-check"></i> Open Schedule
      </a>
      <a href="{{ path('panel/event-execution') }}" class="btn-vnv-light"><i class="fa-solid fa-microphone-lines"></i> Event Area</a>

      <a href="{{ path('panel/planner-hub/team/orders/calendar') }}" class="btn-vnv-light">
        <i class="fa-solid fa-calendar-days"></i> Calendar View
      </a>
    </div>
  </section>

  {% if isEventManager %}
    <div class="alert {{ futureAvailabilityBlocks > 0 ? 'alert-info' : 'alert-warning' }} d-flex flex-wrap justify-content-between align-items-center gap-3 shadow-sm">
      <div>
        <strong><i class="fa-solid fa-calendar-xmark me-1"></i> Event Manager availability</strong>
        <span class="d-block">Tell us which days you cannot work. Existing orders will remain active and Level 1 will receive a conflict alert when review is needed.</span>
        {% if futureAvailabilityBlocks > 0 %}<small>{{ futureAvailabilityBlocks }} upcoming unavailable period(s) recorded.</small>{% endif %}
      </div>
      <a href="{{ path('panel/manager-availability') }}" class="btn btn-dark fw-bold">Update unavailable days</a>
    </div>
  {% endif %}

  {% if teamContract %}
    {% if teamContract.status in ['PENDING','SENT'] %}
      <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
          <strong>Contract pending.</strong>
          <span> Sign your contract before clocking in.</span>
        </div>
        <a href="{{ path('panel/planner-hub/team/contracts') }}" class="btn btn-warning fw-bold">Sign Contract</a>
      </div>
    {% elseif teamContract.status in ['SIGNED','VALIDATED','MANUALLY_UPLOADED'] %}
      <div class="alert alert-success d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
          <strong>Contract validated.</strong>
          <span> Your clock-in access is available.</span>
        </div>
        <a href="{{ path('panel/planner-hub/team/contracts') }}" class="btn btn-outline-success fw-bold">View Contract</a>
      </div>
    {% else %}
      <div class="alert alert-danger d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
          <strong>Contract {{ teamContract.status|lower }}.</strong>
          <span> Contact your administrator before clocking in.</span>
        </div>
        <a href="{{ path('panel/planner-hub/team/contracts') }}" class="btn btn-outline-danger fw-bold">My Contract</a>
      </div>
    {% endif %}
  {% else %}
    <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div>
        <strong>No contract assigned.</strong>
        <span> Contact your administrator if you need a contract before clocking in.</span>
      </div>
      <a href="{{ path('panel/planner-hub/team/contracts') }}" class="btn btn-outline-primary fw-bold">My Contract</a>
    </div>
  {% endif %}

  <section>
    <div class="vnv-section-head">
      <h2 class="vnv-title">
        Your core <span class="highlight">tools</span>
      </h2>
      <p class="vnv-subtitle">
        The areas you will use most often every week, based on the new team dashboard flow.
      </p>
    </div>

    <div class="row g-4">
      <div class="col-md-4">
        <div class="vnv-main-card">
          <i class="fa-solid fa-stopwatch big-icon"></i>
          <h3>Track Your Time</h3>
          <p>
            Clock in and out quickly, keep shifts clean and maintain a more reliable record of your working hours.
          </p>
          <a href="{{ path('panel/planner-hub/team/payroll/clock') }}" class="vnv-link-btn">
            Open Clock <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>

      <div class="col-md-4">
        <div class="vnv-main-card">
          <i class="fa-solid fa-file-contract big-icon"></i>
          <h3>My Contract</h3>
          <p>
            Review your team agreement and complete your signature when it is required.
          </p>
          <a href="{{ path('panel/planner-hub/team/contracts') }}" class="vnv-link-btn">
            Open Contract <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>

      <div class="col-md-4">
        <div class="vnv-main-card">
          <i class="fa-solid fa-list-check big-icon"></i>
          <h3>Job Schedule</h3>
          <p>
            Open your assigned events, job details and tasks so you always know what is coming next.
          </p>
          <a href="{{ path('panel/planner-hub/team/orders/orders/') }}" class="vnv-link-btn">
            Open Schedule <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="mt-5">
    <div class="vnv-section-head">
      <h2 class="vnv-title">
        More <span class="highlight">access</span>
      </h2>
      <p class="vnv-subtitle">
        Supporting tools that help you stay connected without overwhelming the daily workflow.
      </p>
    </div>

    <div class="vnv-mini-row">
      <a href="{{ path('panel/planner-hub') }}" class="vnv-mini-card">
        <i class="fa-solid fa-house"></i>
        <span>Planner Hub</span>
      </a>

      <a href="{{ path('panel/planner-hub/team/contracts') }}" class="vnv-mini-card">
        <i class="fa-solid fa-file-contract"></i>
        <span>My Contract</span>
      </a>

      <a href="{{ path('panel/planning-tools') }}" class="vnv-mini-card">
        <i class="fa-solid fa-compass-drafting"></i>
        <span>Planner Tools</span>
      </a>

      <a href="{{ path('panel/planner-hub/team/chat') }}" class="vnv-mini-card">
        <i class="fa-solid fa-comments"></i>
        <span>Chat</span>
      </a>

      <a href="{{ path('panel/planner-hub/team/orders/calendar') }}" class="vnv-mini-card">
        <i class="fa-solid fa-calendar-days"></i>
        <span>Calendar</span>
      </a>

      <a href="{{ path('panel/settings') }}" class="vnv-mini-card">
        <i class="fa-solid fa-sliders"></i>
        <span>Settings</span>
      </a>

      <form method="post" action="{{ path('panel/home') }}" class="m-0">
        <input type="hidden" name="level" value="5">
        <button type="submit" class="vnv-mini-card vnv-mini-card-button">
          <i class="fa-solid fa-user"></i>
          <span>Client View</span>
        </button>
      </form>
    </div>
  </section>

  <section class="vnv-final">
    <h2 class="vnv-title" style="color:#fff;">
      Stay sharp and stay ready
    </h2>
    <p>
      Keep your hours, assignments and communication organized in one elegant workflow built for team execution.
    </p>

    <div class="d-flex flex-wrap gap-3 justify-content-center">
      <a href="{{ path('panel/planner-hub/team/orders/orders/') }}" class="btn-vnv-main">
        <i class="fa-solid fa-calendar-check"></i> Open Schedule
      </a>

      <a href="{{ path('panel/planner-hub/team/chat') }}" class="btn-vnv-light">
        <i class="fa-solid fa-comments"></i> Open Chat
      </a>
    </div>
  </section>

</main>
{% endblock %}
