{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
<main class="mt-4">
 
 
<div class="container cocktail-calculator">
  <h2 class="mb-4 text-2xl font-semibold">🍸 Cocktail Calculator for Events</h2>
     {{ macros.breadcrumb2() }}

  <div class="form-group mb-2">
    <label for="cocktail" class="font-medium">Choose a cocktail:</label>
    <select id="cocktail" class="form-select rounded w-full p-2 border border-gray-300">
      <option value="">-- Select a cocktail --</option>
    </select>
  </div>

 
  <div id="result" class="bg-gray-100 p-4 rounded mb-2 hidden"></div>

  <div class="form-group mb-2">
    <label for="quantity" class="font-medium">How many drinks will you serve?</label>
    <input type="number" id="quantity" class="form-input rounded w-full p-2 border border-gray-300" min="1" placeholder="Enter number of servings">
  </div>

 
<button onclick="calculateNeeds()" style="background-color:#1abc9c; color:white; padding:10px 20px; border:none; border-radius:5px; font-weight:600; cursor:pointer;">
  🍹 Calculate Ingredients
</button>

  <div id="event-output" class="bg-gray-100 p-4 rounded mt-3 hidden"></div>
</div>
</main>
{% endblock %}

