const cocktailSelect = document.getElementById("cocktail");
const resultDiv = document.getElementById("result");
const outputDiv = document.getElementById("event-output");

for (let name in cocktails) {
  const option = document.createElement("option");
  option.value = name;
  option.textContent = name;
  cocktailSelect.appendChild(option);
}

cocktailSelect.addEventListener("change", function () {
  const selected = this.value;
  if (!selected) {
    resultDiv.innerHTML = "";
    resultDiv.classList.add("hidden");
    return;
  }
  const cocktail = cocktails[selected];
  let html = `<div class='text-lg font-bold mb-2'>${selected}</div>`;
  html += `<p class="mb-2"><strong>Description:</strong> ${cocktail.description}</p>`;
  html += `<p><strong>Ingredients per serving:</strong></p><ul class="list-disc pl-5">`;
  for (let key in cocktail.ingredients) {
    html += `<li>${key}: ${cocktail.ingredients[key]} ml</li>`;
  }
  html += `</ul>`;
  resultDiv.innerHTML = html;
  resultDiv.classList.remove("hidden");
});

function calculateNeeds() {
  const selected = cocktailSelect.value;
  const qty = parseInt(document.getElementById("quantity").value);
  if (!selected || !qty || qty <= 0) return;
  const cocktail = cocktails[selected];
  let html = `<div class='text-lg font-bold mb-2'><h4>Shopping List for ${qty} servings of ${selected}</h4></div><ul class="list-disc pl-5">`;
  for (let key in cocktail.ingredients) {
    const total = (cocktail.ingredients[key] * qty) / 750;
    html += `<li>${key}: ${total.toFixed(1)} bottles (750ml)</li>`;
  }
  for (let extra in cocktail.extras) {
    const total = cocktail.extras[extra] * qty;
    html += `<li>${extra}: ${extra === 'ice' ? (total / 1000).toFixed(1) + ' kg' : total.toFixed(1)}</li>`;
  }
  html += `</ul>`;
  outputDiv.innerHTML = html;
  outputDiv.classList.remove("hidden");
}
</script>
