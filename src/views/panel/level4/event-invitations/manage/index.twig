{% extends 'templates/base.admin.twig' %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="h3 mb-2">⚙️ Manage Event - {{ event.event_name }}</h1>
            <p class="text-muted">Event ID: {{ event.id }} | Slug: {{ event.slug }}</p>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('panel/event-invitations/guests') }}?id={{ event.id }}" class="btn btn-success shadow me-2">
                <i class="bi bi-people-fill me-1"></i> Manage Guests
            </a>
            <a href="{{ path('panel/event-invitations') }}" class="btn btn-secondary shadow">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>
    </div>

    {% if message %}
    <div class="alert alert-{{ message.type|default('success') }} alert-dismissible fade show" role="alert">
        {{ message.message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    {% endif %}

    <!-- Stats Overview -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Total Invited</h6>
                    <h2 class="text-primary">{{ stats.total_invited }}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Confirmed</h6>
                    <h2 class="text-success">{{ stats.total_confirmed }}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Total Attending</h6>
                    <h2 class="text-info">{{ stats.total_attending }}</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Status</h6>
                    {% if event.status == 'active' %}
                        <span class="badge bg-success fs-5">Active</span>
                    {% elseif event.status == 'draft' %}
                        <span class="badge bg-warning fs-5">Draft</span>
                    {% elseif event.status == 'closed' %}
                        <span class="badge bg-secondary fs-5">Closed</span>
                    {% else %}
                        <span class="badge bg-danger fs-5">Cancelled</span>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#details">📝 Event Details</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#design">🎨 Design</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#settings">⚙️ Settings</button>
        </li>
    </ul>

    <div class="tab-content">
        <!-- Event Details Tab -->
        <div class="tab-pane fade show active" id="details">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" name="action" value="update_event">
                        <input type="hidden" name="event_id" value="{{ event.id }}">
                        
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label class="form-label">Event Name *</label>
                                <input type="text" name="event_name" class="form-control" value="{{ event.event_name }}" required>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Event Type *</label>
                                <select name="event_type" class="form-select" required>
                                    {% for key, label in eventTypes %}
                                    <option value="{{ key }}" {% if event.event_type == key %}selected{% endif %}>{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-12 mb-3">
                                <label class="form-label">Event Description</label>
                                <textarea name="event_description" class="form-control" rows="4">{{ event.event_description }}</textarea>
                            </div>
                            <div class="col-12 mb-3">
                                <label class="form-label">Custom Welcome Message</label>
                                <textarea name="custom_message" class="form-control" rows="3">{{ event.custom_message }}</textarea>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Event Date *</label>
                                {% set maxChanges = env.MAX_EVENT_DATE_CHANGES|default(2) %}
                                <input type="date" name="event_date" class="form-control" value="{{ event.event_date }}" required 
                                    {% if event.date_changes_count >= maxChanges %}disabled{% endif %}>
                                {% set changesRemaining = maxChanges - (event.date_changes_count|default(0)) %}
                                {% if changesRemaining > 0 %}
                                    <small class="text-warning">⚠️ You can change the date {{ changesRemaining }} more time(s)</small>
                                {% else %}
                                    <small class="text-danger">🔒 Date changes limit reached ({{ event.date_changes_count }}/{{ maxChanges }}). Create a new event for different dates.</small>
                                {% endif %}
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">Start Time *</label>
                                <input type="time" name="event_time" class="form-control" value="{{ event.event_time }}" required>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">End Time</label>
                                <input type="time" name="event_end_time" class="form-control" value="{{ event.event_end_time }}">
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="form-label">Venue Name</label>
                                <input type="text" name="venue_name" class="form-control" value="{{ event.venue_name }}">
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="form-label">Venue Address</label>
                                <input type="text" name="venue_address" class="form-control" value="{{ event.venue_address }}" data-places>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">City</label>
                                <input type="text" name="venue_city" class="form-control" value="{{ event.venue_city }}">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">State</label>
                                <input type="text" name="venue_state" class="form-control" value="{{ event.venue_state }}" maxlength="2">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="form-label">ZIP</label>
                                <input type="text" name="venue_zip" class="form-control" value="{{ event.venue_zip }}" maxlength="10">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Expected Guests</label>
                                <input type="number" name="expected_guests" class="form-control" value="{{ event.expected_guests }}">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Max Capacity</label>
                                <input type="number" name="max_guests" class="form-control" value="{{ event.max_guests }}">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">RSVP Deadline</label>
                                <input type="date" name="rsvp_deadline" class="form-control" value="{{ event.rsvp_deadline }}">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Dress Code</label>
                                <input type="text" name="dress_code" class="form-control" value="{{ event.dress_code }}">
                            </div>
                            <div class="col-12 mb-3">
                                <div class="form-check form-switch">
                                    <input type="checkbox" name="allow_plus_ones" class="form-check-input" id="allow_plus_ones" {% if event.allow_plus_ones %}checked{% endif %}>
                                    <label class="form-check-label" for="allow_plus_ones">Allow Plus Ones</label>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Max Plus Ones Per Guest</label>
                                <input type="number" name="max_plus_ones_per_guest" class="form-control" value="{{ event.max_plus_ones_per_guest }}" min="1" max="10">
                            </div>
                        </div>
                        
                        <div class="text-end">
                            <button type="submit" class="btn btn-primary shadow">
                                <i class="bi bi-save me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Design Tab -->
        <div class="tab-pane fade" id="design">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        <input type="hidden" name="action" value="update_design">
                        <input type="hidden" name="event_id" value="{{ event.id }}">
                        
                        <h5 class="mb-3">Choose Template</h5>
                        <div class="row mb-4">
                            <div class="col-md-4 mb-3">
                                <div class="card template-card {% if event.template_id == 1 %}border-success{% endif %}" onclick="selectTemplate(1)">
                                    <div class="card-body text-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; height: 150px; display: flex; align-items: center; justify-content: center;">
                                        <h6>Elegant Purple</h6>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="card template-card {% if event.template_id == 2 %}border-success{% endif %}" onclick="selectTemplate(2)">
                                    <div class="card-body text-center" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; height: 150px; display: flex; align-items: center; justify-content: center;">
                                        <h6>Pink Sunset</h6>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="card template-card {% if event.template_id == 3 %}border-success{% endif %}" onclick="selectTemplate(3)">
                                    <div class="card-body text-center" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white; height: 150px; display: flex; align-items: center; justify-content: center;">
                                        <h6>Ocean Blue</h6>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="card template-card {% if event.template_id == 4 %}border-success{% endif %}" onclick="selectTemplate(4)">
                                    <div class="card-body text-center" style="background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); color: white; height: 150px; display: flex; align-items: center; justify-content: center;">
                                        <h6>Mint Green</h6>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="card template-card {% if event.template_id == 5 %}border-success{% endif %}" onclick="selectTemplate(5)">
                                    <div class="card-body text-center" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); color: white; height: 150px; display: flex; align-items: center; justify-content: center;">
                                        <h6>Warm Sunset</h6>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" name="template_id" id="template_id" value="{{ event.template_id }}">
                        <input type="hidden" name="primary_color" id="primary_color" value="{{ event.primary_color }}">
                        <input type="hidden" name="secondary_color" id="secondary_color" value="{{ event.secondary_color }}">
                        
                        <div class="row mb-4">
                            <div class="col-md-12">
                                <h5 class="mb-3">Cover Image</h5>
                                {% if event.cover_image_url %}
                                <div class="mb-3">
                                    <label class="form-label">Current Cover Image</label>
                                    <div>
                                        <img src="{{ event.cover_image_url }}" alt="Cover Image" class="img-fluid rounded shadow-sm mb-2" style="max-height: 200px;">
                                        <div class="mt-2">
                                            <button type="button" class="btn btn-danger btn-sm" onclick="confirmDeleteImage()">
                                                <i class="bi bi-trash me-1"></i> Delete Image
                                            </button>
                                        </div>
                                    </div>
                                    <input type="hidden" name="delete_cover_image" id="delete_cover_image" value="0">
                                </div>
                                {% endif %}
                                <div class="mb-3">
                                    <label class="form-label">{% if event.cover_image_url %}Change Cover Image{% else %}Upload Cover Image{% endif %}</label>
                                    <input type="file" name="cover_image" class="form-control" accept="image/*" id="cover_image_input" onchange="previewCoverImage(this)">
                                    <small class="text-muted">Recommended: 1200x600px or larger. Leave empty to keep current image.</small>
                                    <div id="cover_preview" class="mt-3" style="display:none;">
                                        <label class="form-label">New Image Preview</label>
                                        <img id="cover_preview_img" src="" alt="Cover Preview" class="img-fluid rounded shadow-sm" style="max-height: 200px;">
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <hr>
                        
                        <h5 class="mb-3">Typography</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Font Family</label>
                                <select name="font_family" class="form-select">
                                    <option value="Poppins" {% if event.font_family == 'Poppins' %}selected{% endif %}>Poppins (Modern)</option>
                                    <option value="Playfair Display" {% if event.font_family == 'Playfair Display' %}selected{% endif %}>Playfair Display (Elegant)</option>
                                    <option value="Montserrat" {% if event.font_family == 'Montserrat' %}selected{% endif %}>Montserrat (Clean)</option>
                                    <option value="Dancing Script" {% if event.font_family == 'Dancing Script' %}selected{% endif %}>Dancing Script (Romantic)</option>
                                    <option value="Roboto" {% if event.font_family == 'Roboto' %}selected{% endif %}>Roboto (Simple)</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Header Text Color</label>
                                <input type="color" name="header_text_color" class="form-control form-control-color" id="header_text_color" value="{{ event.header_text_color|default('#FFFFFF') }}" onchange="updateTextColorPreview()">
                                <small class="text-muted">Color for header text</small>
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="form-label">Preview</label>
                                <div id="text_color_preview" style="background: linear-gradient(135deg, {{ event.primary_color }}, {{ event.secondary_color }}); padding: 20px; border-radius: 8px; color: {{ event.header_text_color|default('#FFFFFF') }}; text-align: center; font-weight: bold;">
                                    Sample Header Text
                                </div>
                            </div>
                        </div>
                        
                        <div class="text-end">
                            <a href="{{ path('event') }}?slug={{ event.slug }}" target="_blank" class="btn btn-outline-info shadow me-2">
                                <i class="bi bi-eye me-1"></i> Preview
                            </a>
                            <button type="submit" class="btn btn-primary shadow">
                                <i class="bi bi-save me-1"></i> Save Design
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Settings Tab -->
        <div class="tab-pane fade" id="settings">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="mb-4">Event Status</h5>
                    
                    <form method="post">
                        <input type="hidden" name="action" value="change_status">
                        <input type="hidden" name="event_id" value="{{ event.id }}">
                        
                        <div class="mb-4">
                            <label class="form-label">Current Status: <strong>{{ event.status|upper }}</strong></label>
                            <select name="status" class="form-select">
                                <option value="draft" {% if event.status == 'draft' %}selected{% endif %}>Draft</option>
                                <option value="active" {% if event.status == 'active' %}selected{% endif %}>Active</option>
                                <option value="closed" {% if event.status == 'closed' %}selected{% endif %}>Closed</option>
                                <option value="cancelled" {% if event.status == 'cancelled' %}selected{% endif %}>Cancelled</option>
                            </select>
                        </div>
                        
                        <button type="submit" class="btn btn-warning shadow">
                            <i class="bi bi-arrow-repeat me-1"></i> Change Status
                        </button>
                    </form>

                    <hr class="my-4">

                    <h5 class="mb-3">Event Links</h5>
                    <div class="mb-3">
                        <label class="form-label">Public Event Page</label>
                        <div class="input-group">
                            <input type="text" class="form-control" value="{{ path('event') }}?slug={{ event.slug }}" id="publicUrl" readonly>
                            <button class="btn btn-outline-secondary" onclick="copyUrl()">
                                <i class="bi bi-clipboard"></i> Copy
                            </button>
                        </div>
                    </div>

                    <hr class="my-4">

                    <h5 class="mb-3 text-danger">Danger Zone</h5>
                    <p class="text-muted">Deleting this event will remove all guests and invitation history.</p>
                    <button class="btn btn-danger shadow" onclick="confirmDelete()">
                        <i class="bi bi-trash me-1"></i> Delete Event
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.template-card { cursor: pointer; transition: all 0.3s; border-width: 3px; }
.template-card:hover { transform: translateY(-5px); box-shadow: 0 4px 8px rgba(0,0,0,0.2); }
</style>

<script>
const templates = {
    1: { primary: '#667eea', secondary: '#764ba2' },
    2: { primary: '#f093fb', secondary: '#f5576c' },
    3: { primary: '#4facfe', secondary: '#00f2fe' },
    4: { primary: '#43e97b', secondary: '#38f9d7' },
    5: { primary: '#fa709a', secondary: '#fee140' }
};

function selectTemplate(id) {
    document.querySelectorAll('.template-card').forEach(card => {
        card.classList.remove('border-success');
    });
    event.currentTarget.classList.add('border-success');
    
    document.getElementById('template_id').value = id;
    document.getElementById('primary_color').value = templates[id].primary;
    document.getElementById('secondary_color').value = templates[id].secondary;
    updateTextColorPreview();
}

function updateTextColorPreview() {
    const textColor = document.getElementById('header_text_color').value;
    const preview = document.getElementById('text_color_preview');
    const primaryColor = document.getElementById('primary_color').value;
    const secondaryColor = document.getElementById('secondary_color').value;
    
    if (preview) {
        preview.style.color = textColor;
        preview.style.background = `linear-gradient(135deg, ${primaryColor}, ${secondaryColor})`;
    }
}

function copyUrl() {
    const url = document.getElementById('publicUrl');
    url.select();
    document.execCommand('copy');
    alert('URL copied to clipboard!');
}

function confirmDelete() {
    if (confirm('Are you sure you want to delete this event? This action cannot be undone.')) {
        alert('Delete functionality coming soon!');
    }
}

function previewCoverImage(input) {
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('cover_preview_img').src = e.target.result;
            document.getElementById('cover_preview').style.display = 'block';
        };
        reader.readAsDataURL(input.files[0]);
    }
}

function confirmDeleteImage() {
    if (confirm('¿Estás seguro de que deseas eliminar la imagen de portada?')) {
        document.getElementById('delete_cover_image').value = '1';
        document.querySelector('.btn-danger[onclick="confirmDeleteImage()"]').innerHTML = '<i class="bi bi-check me-1"></i> Will be deleted on save';
        document.querySelector('.btn-danger[onclick="confirmDeleteImage()"]').classList.add('btn-warning');
        document.querySelector('.btn-danger[onclick="confirmDeleteImage()"]').classList.remove('btn-danger');
    }
}
</script>
{% endblock %}

