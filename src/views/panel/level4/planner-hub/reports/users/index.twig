{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block style %}
    <style>
        .filter-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        
        .table th {
            background-color: #343a40;
            color: white;
            font-weight: 600;
            border: none;
        }
        
        .table td {
            vertical-align: middle;
            border-color: #dee2e6;
        }
        
        .table tbody tr:hover {
            background-color: #f8f9fa;
        }
        
        .badge {
            font-size: 0.75rem;
        }
        
        .btn-group .btn {
            border-radius: 0.375rem;
        }
        
        .btn-group .btn:not(:last-child) {
            margin-right: 0.25rem;
        }
        
        .membership-paid {
            color: #28a745;
            font-weight: bold;
        }
        
        .membership-free {
            color: #6c757d;
        }
        
        .modal-header {
            background-color: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
        }
        
        .modal-title {
            color: #495057;
        }
        
        .table-responsive {
            border-radius: 0.375rem;
        }
        
        .text-success {
            font-weight: 600;
        }
        
        .btn-outline-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 2px 4px rgba(0,123,255,0.25);
        }
        
        .btn-outline-info:hover {
            transform: translateY(-1px);
            box-shadow: 0 2px 4px rgba(23,162,184,0.25);
        }
        
        .btn-outline-warning:hover {
            transform: translateY(-1px);
            box-shadow: 0 2px 4px rgba(255,193,7,0.25);
        }
    </style>
{% endblock %}

{% block body %}
    <section>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">📊 User Reports</h1>
            <div class="text-muted">
                <i data-feather="users" class="me-1"></i>
                Total Users: <strong>{{ total_users }}</strong>
            </div>
        </div>
        

        {{ macros.breadcrumb2() }}

        <!-- Filtros -->
        <div class="card filter-card mb-4">
            <div class="card-body">
                <h5 class="card-title text-white mb-3">
                    <i data-feather="filter" class="me-2"></i>Filters
                </h5>
                <form method="GET" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label text-white">Membership Start Date</label>
                        <input type="date" class="form-control" name="start_date" value="{{ start_date }}" title="Filter by membership due date">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-white">Membership End Date</label>
                        <input type="date" class="form-control" name="end_date" value="{{ end_date }}" title="Filter by membership due date">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-white">User Level</label>
                        <select class="form-select" name="level">
                            <option value="">All Levels</option>
                            <option value="2" {% if level == '2' %}selected{% endif %}>Level 2 (Venue)</option>
                            <option value="3" {% if level == '3' %}selected{% endif %}>Level 3 (Vendor)</option>
                            <option value="4" {% if level == '4' %}selected{% endif %}>Level 4 (Client)</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-white">Search</label>
                        <input type="text" class="form-control" name="search" value="{{ search }}" placeholder="Name or Email">
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-light">
                            <i data-feather="search" class="me-1"></i>Apply Filters
                        </button>
                        <a href="{{ base_url }}/panel/planner-hub/reports/users" class="btn btn-outline-light ms-2">
                            <i data-feather="refresh-cw" class="me-1"></i>Reset
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Reportes -->
        {% if reports|length > 0 %}
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>User Info</th>
                                    <th>Level</th>
                                    <th>Profiles</th>
                                    <th>Team Members</th>
                                    <th>Monthly Revenue</th>
                                    <th>Orders</th>
                                    <th>Membership</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for report in reports %}
                                    <tr>
                                        <td>
                                            <div>
                                                <strong>{{ report.user.name }} {{ report.user.lastname }}</strong><br>
                                                <small class="text-muted">{{ report.user.email }}</small><br>
                                                <small class="text-muted">ID: {{ report.user.id }}</small>
                                                {% if report.user.membership_due_date %}
                                                    <br><small class="text-muted">Due: {{ report.user.membership_due_date|date('M j, Y') }}</small>
                                                {% endif %}
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary">Level {{ report.user.level }}</span>
                                        </td>
                                        <td>
                                            {% if report.vendor_profile %}
                                                <div class="mb-1">
                                                    <small>Vendor:</small>
                                                    <span class="badge {% if report.vendor_profile.status == 'approved' %}bg-success{% elseif report.vendor_profile.status == 'pending' %}bg-warning{% else %}bg-danger{% endif %}">
                                                        {{ report.vendor_profile.status|title }}
                                                    </span>
                                                </div>
                                            {% endif %}
                                            {% if report.venue_profile %}
                                                <div class="mb-1">
                                                    <small>Venue:</small>
                                                    <span class="badge {% if report.venue_profile.status == 'approved' %}bg-success{% elseif report.venue_profile.status == 'pending' %}bg-warning{% else %}bg-danger{% endif %}">
                                                        {{ report.venue_profile.status|title }}
                                                    </span>
                                                </div>
                                            {% endif %}
                                            {% if not report.vendor_profile and not report.venue_profile %}
                                                <small class="text-muted">No profiles</small>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <span class="badge bg-info me-2">{{ report.team_members_count }}</span>
                                                {% if report.team_members_count > 0 %}
                                                    <button class="btn btn-sm btn-outline-primary team-members-btn" 
                                                            data-user-id="{{ report.user.id }}" 
                                                            data-user-name="{{ report.user.name }} {{ report.user.lastname }}">
                                                        <i data-feather="users" class="me-1"></i>View
                                                    </button>
                                                {% endif %}
                                            </div>
                                        </td>
                                        <td>
                                            <span class="text-success fw-bold">${{ report.monthly_revenue|number_format(2) }}</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">{{ report.orders_processed }}</span>
                                        </td>
                                        <td>
                                            <div>
                                                <span class="{% if report.membership_status == 'paid' %}text-success{% else %}text-muted{% endif %}">
                                                    {% if report.membership_status == 'paid' %}
                                                        <i data-feather="check-circle" class="me-1"></i>Paid
                                                    {% else %}
                                                        <i data-feather="circle" class="me-1"></i>Free
                                                    {% endif %}
                                                </span>
                                                {% if report.membership_expires %}
                                                    <br><small class="text-muted">Expires: {{ report.membership_expires|date('M j, Y') }}</small>
                                                {% endif %}
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="text-center py-5">
                <i data-feather="users" style="width: 4rem; height: 4rem;" class="text-muted mb-3"></i>
                <h5 class="text-muted">No users found</h5>
                <p class="text-muted">Try adjusting your filters to see more results.</p>
            </div>
        {% endif %}
        
        <!-- Modal para mostrar miembros del equipo -->
        <div class="modal fade" id="teamMembersModal" tabindex="-1" aria-labelledby="teamMembersModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="teamMembersModalLabel">
                            <i data-feather="users" class="me-2"></i>Team Members
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div id="teamMembersContent">
                            <div class="text-center">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p class="mt-2">Loading team members...</p>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block scripts %}
    <script>
        
        document.querySelectorAll('input[type="date"], select').forEach(function(element) {
            element.addEventListener('change', function() {
                this.form.submit();
            });
        });
        
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.team-members-btn').forEach(function(button) {
                button.addEventListener('click', function() {
                    const userId = this.getAttribute('data-user-id');
                    const userName = this.getAttribute('data-user-name');
                    showTeamMembers(userId, userName);
                });
            });
        });
        
        function showTeamMembers(userId, userName) {
            
            const modal = new bootstrap.Modal(document.getElementById('teamMembersModal'));
            const modalTitle = document.getElementById('teamMembersModalLabel');
            const modalContent = document.getElementById('teamMembersContent');
            
            modalTitle.innerHTML = '<i data-feather="users" class="me-2"></i>Team Members - ' + userName;
            modalContent.innerHTML = '<div class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div><p class="mt-2">Loading team members...</p></div>';
            modal.show();
            
            const url = '{{ base_url }}/panel/planner-hub/reports/users/team-members?user_id=' + userId;
            
            fetch(url)
                .then(function(response) {
                    if (!response.ok) {
                        throw new Error('HTTP error! status: ' + response.status);
                    }
                    return response.json();
                })
                .then(function(data) {
                    if (data.success) {
                        let html = '';
                        if (data.members && data.members.length > 0) {
                            html = '<div class="table-responsive"><table class="table table-sm"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Level</th><th>Status</th></tr></thead><tbody>';
                            data.members.forEach(function(member) {
                                html += '<tr><td>' + member.name + ' ' + member.lastname + '</td><td>' + member.email + '</td><td>' + (member.phone || 'N/A') + '</td><td><span class="badge bg-secondary">Level ' + member.level + '</span></td><td><span class="badge ' + (member.is_active ? 'bg-success' : 'bg-danger') + '">' + (member.is_active ? 'Active' : 'Inactive') + '</span></td></tr>';
                            });
                            html += '</tbody></table></div>';
                        } else {
                            html = '<div class="text-center text-muted"><i data-feather="users" class="me-2"></i>No team members found</div>';
                        }
                        modalContent.innerHTML = html;
                    } else {
                        modalContent.innerHTML = '<div class="alert alert-danger">Error loading team members: ' + (data.message || 'Unknown error') + '</div>';
                    }
                    feather.replace();
                })
                .catch(function(error) {
                    modalContent.innerHTML = '<div class="alert alert-danger">Error loading team members: ' + error.message + '</div>';
                });
        }
        
        feather.replace();
    </script>
{% endblock %}
