{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}

    <h1 class="h3 mb-4 text-gray-800">
        Edit Lead
    </h1>

    {{ macros.breadcrumb2() }}

    <section class="card">
        <div class="card-body">
            <form method="POST">
                <input type="hidden" name="id" value="{{ lead.id }}">

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Name</label>
                        <input type="text" name="name" class="form-control" value="{{ lead.name }}" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Email</label>
                        <input type="email" name="email" class="form-control" value="{{ lead.email }}">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Phone</label>
                        <input type="text" name="phone" class="form-control" value="{{ lead.phone }}">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Address</label>
                    <input type="text" class="form-control" name="address" value="{{ lead.address }}" placeholder="Enter address" data-places />
                </div>

                {# NUEVO: Languaje #}
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Language</label>
                        <select name="languaje" class="form-select">
                            {% set lang = (lead.languaje|default('english'))|lower %}
                            <option value="english" {{ lang == 'english' ? 'selected' : '' }}>English</option>
                            <option value="spanish" {{ lang == 'spanish' ? 'selected' : '' }}>Spanish</option>
                            <option value="portuguese" {{ lang == 'portuguese' ? 'selected' : '' }}>Portuguese</option>
                            <option value="french" {{ lang == 'french' ? 'selected' : '' }}>French</option>
                            <option value="other" {{ lang == 'other' ? 'selected' : '' }}>Other</option>
                        </select>
                        <div class="form-text">Default: English.</div>
                    </div>

                    {# NUEVO: Comments #}
                    <div class="col-md-6">
                        <label class="form-label">Comments</label>
                        <textarea class="form-control" name="comments" rows="3" maxlength="240" placeholder="Short note (max 240 chars)">{{ lead.comments }}</textarea>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Category</label>
                        <select name="id_category" class="form-select">
                            <option value="">Select category</option>
                            {% for category in categories %}
                                <option value="{{ category.id }}" {{ category.id == (lead.id_category|default(0)) ? 'selected' : '' }}>{{ category.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="mb-4 text-end">
                    <button class="btn btn-primary">Save Changes</button>
                    <a href="{{ path('panel/planner-hub/management/crm/lead') }}" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </section>

{% endblock %}
