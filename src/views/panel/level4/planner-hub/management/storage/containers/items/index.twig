{% extends "templates/base.admin.twig" %}
{% import 'templates/macros.twig' as macros %}

{% block body %}
    <h1 class="h3 mb-4">📦 Storage Items</h1>
    {{ macros.breadcrumb2() }}



    <section
        class="card"
        id="container-detail-card"
        data-container-name="{{ container.name|e('html_attr') }}"
        data-container-url="{{ path('panel/planner-hub/team/storage/containers/items', { container_id: container.id })|e('html_attr') }}"
    >
        <div class="card-body">

            <div class="d-flex flex-wrap gap-2 mb-3">
                <a href="{{ path(current_location ~ '/create', { container: containerId }) }}" class="btn btn-primary">
                    <i class="align-middle" data-feather="plus"></i> Add New Item
                </a>
                <button type="button" class="btn btn-outline-secondary" onclick="openContainerTagModal()">
                    <i class="align-middle" data-feather="printer"></i> Print Container Tag
                </button>
            </div>

            <h1>{{ container.name }}</h1>
            
            {% if container.img_reference %}
                <p>
                    <a href="#" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#imgModal">
                        📷 Click to see reference image
                    </a>
                </p>

                <!-- Modal -->
                <div class="modal fade" id="imgModal" tabindex="-1" aria-labelledby="imgModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-lg">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="imgModalLabel">Reference Image - {{ container.name }}</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body text-center">

                                <img src="{{ asset_for(container.img_reference) }}" alt="Reference Image" class="img-fluid">
 

                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}

            <hr>

            <div class="table-responsive">
                <table class="table table-bordered table-striped text-center align-middle" style="min-width: 500px;">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Quantity</th>
                            <th>Container Name</th>
                            <th>Edit</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in items %}
                            <tr>
                                <td>{{ item.name }}</td>
                                <td>{{ item.quantity }}</td>
                                <td>{{ container.name }}</td>
                                <td>
                                    <a href="{{ path(current_location ~ '/edit', { container: containerId, item: item.id }) }}" class="btn btn-primary">Edit</a>
                                </td>
                                <td>
                                    {{ macros.delete_form(item.id) }}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-muted">No items were found.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <div class="modal fade" id="containerTagModal" tabindex="-1" aria-labelledby="containerTagModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="containerTagModalLabel">Print Container Tag</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <h2 id="container-tag-title" class="mb-3"></h2>
                    <div id="container-tag-qr" class="d-flex justify-content-center"></div>
                    <p id="container-tag-url" class="small text-muted mt-3 text-break"></p>
                    <div class="form-check d-inline-flex gap-2 mt-2">
                        <input class="form-check-input" type="checkbox" id="container-tag-include-items">
                        <label class="form-check-label" for="container-tag-include-items">Include current items</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" onclick="printContainerTag()">Print</button>
                </div>
            </div>
        </div>
    </div>

    <div id="container-print-items" hidden>
        <table>
            <thead><tr><th>Item</th><th>Quantity</th></tr></thead>
            <tbody>
                {% for item in items %}
                    <tr><td>{{ item.name }}</td><td>{{ item.quantity }}</td></tr>
                {% else %}
                    <tr><td colspan="2">No items in this container</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"></script>
<script>
function openContainerTagModal() {
    const card = document.getElementById('container-detail-card');
    const qr = document.getElementById('container-tag-qr');
    document.getElementById('container-tag-title').textContent = card.dataset.containerName;
    document.getElementById('container-tag-url').textContent = card.dataset.containerUrl;
    document.getElementById('container-tag-include-items').checked = false;
    qr.replaceChildren();
    new QRCode(qr, { text: card.dataset.containerUrl, width: 160, height: 160 });
    bootstrap.Modal.getOrCreateInstance(document.getElementById('containerTagModal')).show();
}

function printContainerTag() {
    const card = document.getElementById('container-detail-card');
    const canvas = document.querySelector('#container-tag-qr canvas');
    if (!canvas) return;
    const includeItems = document.getElementById('container-tag-include-items').checked;
    const items = includeItems ? document.getElementById('container-print-items').innerHTML : '';
    const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, (character) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;'
    })[character]);
    const printWindow = window.open('', '_blank', 'width=800,height=700');
    if (!printWindow) return;
    printWindow.document.write(`<!doctype html><html><head><title>Container Tag</title><style>
        body{font-family:Arial,sans-serif;text-align:center;margin:0;padding:28px;color:#111}
        h1{font-size:44px;margin:0 0 24px;overflow-wrap:anywhere}
        img{width:180px;height:180px}.url{font-size:12px;color:#555;overflow-wrap:anywhere;margin:16px auto;max-width:640px}
        table{width:100%;border-collapse:collapse;margin-top:28px}th,td{border:1px solid #333;padding:8px;text-align:left}th{background:#f1f1f1}
        @media print{body{padding:12px}h1{page-break-after:avoid}table{page-break-inside:auto}}
    </style></head><body><h1>${escapeHtml(card.dataset.containerName)}</h1><img src="${canvas.toDataURL('image/png')}" alt="Container QR code"><p class="url">${escapeHtml(card.dataset.containerUrl)}</p>${items}</body></html>`);
    printWindow.document.close();
    printWindow.addEventListener('load', () => window.setTimeout(() => {
        printWindow.print();
        printWindow.close();
    }, 300));
}
</script>
{% endblock %}
