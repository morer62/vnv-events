{% extends 'templates/base.admin.twig' %}

{% block body %}
<main class="container mt-4 pb-5">

  <style>
    :root{
      --gourmet-primary:#f59e0b;
      --gourmet-primary-dark:#d97706;
      --gourmet-accent:#fb923c;
      --gourmet-dark:#1f1307;
      --gourmet-text:#2d241c;
      --gourmet-muted:#6f6255;
      --gourmet-border:#ecd9bf;
      --gourmet-shadow:0 18px 44px rgba(79,43,8,.10);
      --gourmet-success:#16a34a;
      --gourmet-soft:#fff8ef;
    }

    .k-hero{
      border-radius:28px;
      padding:2rem 1.5rem;
      color:#fff;
      background:
        radial-gradient(900px 420px at 0% 0%, rgba(245,158,11,.16), transparent 60%),
        linear-gradient(135deg, #251508 0%, #1f1307 55%, #361a06 100%);
      box-shadow:0 22px 54px rgba(0,0,0,.16);
      margin-bottom:1.6rem;
    }

    .k-badge{
      display:inline-flex;
      align-items:center;
      gap:.45rem;
      padding:.55rem .9rem;
      border-radius:999px;
      font-size:.9rem;
      font-weight:800;
      background:rgba(255,255,255,.08);
      border:1px solid rgba(255,255,255,.15);
      color:#fff;
      margin-bottom:1rem;
    }

    .k-hero h1{
      font-size:clamp(2rem,4vw,3rem);
      line-height:1.05;
      font-weight:900;
      margin-bottom:.8rem;
      letter-spacing:-1px;
    }

    .k-hero p{
      max-width:840px;
      color:#f4e4cb;
      line-height:1.72;
      margin-bottom:0;
    }

    .k-grid{
      display:grid;
      grid-template-columns:repeat(2,minmax(0,1fr));
      gap:1rem;
      margin-bottom:1.4rem;
    }

    .k-card{
      background:#fff;
      border:1px solid rgba(94,55,15,.06);
      border-radius:22px;
      box-shadow:var(--gourmet-shadow);
      padding:1.4rem 1.2rem;
      height:100%;
    }

    .k-card i{
      font-size:1.9rem;
      color:var(--gourmet-primary-dark);
      margin-bottom:.8rem;
    }

    .k-card h3{
      font-size:1.16rem;
      font-weight:800;
      color:var(--gourmet-dark);
      margin-bottom:.5rem;
    }

    .k-card p{
      color:var(--gourmet-muted);
      line-height:1.7;
      margin-bottom:0;
    }

    .k-stage{
      background:linear-gradient(135deg,#fff5e6, #fffdf9);
      border:1px solid #efd4a9;
      border-radius:22px;
      padding:1.2rem;
      margin-bottom:1.2rem;
    }

    .k-stage h2{
      font-size:1.25rem;
      font-weight:900;
      color:var(--gourmet-dark);
      margin-bottom:.8rem;
    }

    .k-stage p{
      color:var(--gourmet-muted);
      line-height:1.75;
      margin-bottom:0;
    }

    .k-checklist{
      display:grid;
      gap:.75rem;
      margin-top:1rem;
    }

    .k-check{
      background:#fff;
      border:1px solid #ecd9bf;
      border-radius:16px;
      padding:.95rem 1rem;
      color:var(--gourmet-text);
    }

    .k-actions{
      display:flex;
      flex-wrap:wrap;
      gap:.85rem;
      margin-top:1rem;
    }

    .btn-k-main{
      background:linear-gradient(135deg,var(--gourmet-primary),var(--gourmet-accent));
      color:#23160a !important;
      padding:1rem 1.35rem;
      font-size:1rem;
      border-radius:999px;
      text-decoration:none;
      font-weight:800;
      display:inline-flex;
      gap:.55rem;
      align-items:center;
      justify-content:center;
      border:none;
      box-shadow:0 12px 28px rgba(245,158,11,.28);
    }

    .btn-k-soft{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:.45rem;
      padding:.92rem 1.15rem;
      border-radius:999px;
      font-weight:800;
      text-decoration:none;
      background:#fff6e8;
      color:#8b4f00;
      border:1px solid #f1d4a3;
    }

    .k-order-items-wrap{
      max-height:220px;
      overflow:auto;
    }

    @media (max-width: 991px){
      .k-grid{
        grid-template-columns:1fr;
      }
    }
  </style>

  <section class="k-hero">
    <span class="k-badge">
      <i class="fa-solid fa-kitchen-set"></i> Kitchen Flow
    </span>

    <h1>Kitchen Orders Board</h1>

    <p>Prioritized for operations: assigned orders first, then totals by dish. {% if currentInstitution %}<br><strong>Institution:</strong> {{ currentInstitution.company_name }}{% endif %}</p>
  </section>

  <section class="k-stage">
    <h2>Quick summary</h2>
    <p><strong>Assigned orders:</strong> {{ orders|length }} · <strong>Role:</strong> {{ storeTeamRole|default('general')|upper }}</p>
  </section>

  <div class="k-actions">
    <a href="{{ path('panel/planner-hub/team/store/orders/home') }}" class="btn-k-main">
      <i class="fa-solid fa-box-open"></i> Back to Store Orders
    </a>

    <a href="{{ path('panel/planner-hub/team/store/delivery/home') }}" class="btn-k-soft">
      <i class="fa-solid fa-truck-fast"></i> Go to Delivery
    </a>
  </div>

  <section class="card mt-4">
    <div class="card-body">
      <h5 class="mb-3">Orders Board</h5>
      {% if orders|length > 0 %}
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead>
              <tr>
                <th>Order</th>
                <th>Client</th>
                <th>City</th>
                <th>Order items</th>
                <th class="text-end">Meals</th>
                <th>Status</th>
                <th>Delivery</th>
                <th class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              {% for o in orders %}
                <tr>
                  <td>#{{ o.id }}</td>
                  <td>
                    <div>{{ o.guest_name ?: '—' }}</div>
                    <small class="text-muted">{{ o.guest_email ?: '—' }}</small>
                  </td>
                  <td>{{ o.city ?: '—' }}</td>
                  <td>
                    {% if o.items is defined and o.items|length > 0 %}
                      <div class="d-flex flex-column gap-1">
                        {% for it in o.items %}
                          <div class="small">
                            <span class="badge bg-light text-dark border me-1">x{{ it.quantity ?: 0 }}</span>
                            {{ it.product_name_snapshot ?: 'Meal' }}
                          </div>
                        {% endfor %}
                      </div>
                    {% else %}
                      <span class="text-muted small">No item details</span>
                    {% endif %}
                  </td>
                  <td class="text-end">{{ o.meals_count }}</td>
                  <td>
                    {% if o.status == 'PROCESSING' %}
                      <span class="badge bg-info text-dark">Paid / Preparing</span>
                    {% elseif o.status == 'READY' %}
                      <span class="badge bg-warning text-dark">Sending</span>
                    {% elseif o.status == 'DELIVERED' %}
                      <span class="badge bg-success">Received</span>
                    {% else %}
                      <span class="badge bg-secondary">{{ o.status }}</span>
                    {% endif %}
                  </td>
                  <td class="small">
                    <div>{{ o.delivery_assignee_name ?: (o.delivery_user_id ? ('#' ~ o.delivery_user_id) : '—') }}</div>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary mt-1"
                            data-bs-toggle="modal"
                            data-bs-target="#assignDeliveryKitchenModal"
                            data-order-id="{{ o.id }}"
                            data-delivery-user-id="{{ o.delivery_user_id ?: '' }}">
                      Assign
                    </button>
                  </td>
                  <td class="text-end">
                    <div class="d-inline-flex flex-wrap gap-1 justify-content-end">
                      <button type="button"
                              class="btn btn-sm btn-outline-primary order-details-btn"
                              data-bs-toggle="modal"
                              data-bs-target="#orderDetailsModal"
                              data-order-id="{{ o.id }}"
                              data-client="{{ o.guest_name ?: '—' }}"
                              data-email="{{ o.guest_email ?: '—' }}"
                              data-phone="{{ o.guest_phone ?: '—' }}"
                              data-city="{{ o.city ?: '—' }}"
                              data-status="{{ o.status }}"
                              data-total="{{ o.total|number_format(2, '.', ',') }}"
                              data-items="{{ o.items_json|e('html_attr') }}">
                        View details
                      </button>
                      {% if o.status == 'PROCESSING' %}
                        <button type="button"
                                class="btn btn-sm btn-warning"
                                data-bs-toggle="modal"
                                data-bs-target="#markSendingModal"
                                data-order-id="{{ o.id }}"
                                data-delivery-user-id="{{ o.delivery_user_id ?: '' }}">
                          Mark as Sending
                        </button>
                      {% elseif o.status == 'READY' %}
                        <form method="post" class="d-inline">
                          <input type="hidden" name="action" value="mark_received">
                          <input type="hidden" name="order_id" value="{{ o.id }}">
                          <button type="submit" class="btn btn-sm btn-success">Mark as Received</button>
                        </form>
                      {% endif %}
                      <button type="button" class="btn btn-sm btn-outline-dark print-label-btn"
                              data-order-id="{{ o.id }}"
                              data-client="{{ o.guest_name ?: '—' }}"
                              data-city="{{ o.city ?: '—' }}"
                              data-total="{{ o.total|number_format(2, '.', ',') }}"
                              data-items="{{ o.items_json|e('html_attr') }}">Print label</button>
                    </div>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <p class="text-muted mb-0">No orders to prepare.</p>
      {% endif %}
    </div>
  </section>

  <section class="card mt-4">
    <div class="card-body">
      <h5 class="mb-3">Preparation Board (Totals by dish)</h5>
      {% if preparationTotals|length > 0 %}
        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead>
              <tr>
                <th>Dish</th>
                <th class="text-end">Total Qty</th>
              </tr>
            </thead>
            <tbody>
              {% for t in preparationTotals %}
                <tr>
                  <td>{{ t.product_name ?: '—' }}</td>
                  <td class="text-end fw-bold">{{ t.total_qty }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <p class="text-muted mb-0">No assigned kitchen orders for this user.</p>
      {% endif %}
    </div>
  </section>

  <div class="modal fade" id="orderDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Order details</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3 mb-3">
            <div class="col-md-6"><strong>Order:</strong> <span id="detailsOrderId">—</span></div>
            <div class="col-md-6"><strong>Status:</strong> <span id="detailsStatus">—</span></div>
            <div class="col-md-6"><strong>Client:</strong> <span id="detailsClient">—</span></div>
            <div class="col-md-6"><strong>Email:</strong> <span id="detailsEmail">—</span></div>
            <div class="col-md-6"><strong>Phone:</strong> <span id="detailsPhone">—</span></div>
            <div class="col-md-6"><strong>City:</strong> <span id="detailsCity">—</span></div>
            <div class="col-md-6"><strong>Total:</strong> $<span id="detailsTotal">0.00</span></div>
          </div>
          <div>
            <h6 class="mb-2">Items</h6>
            <div class="table-responsive k-order-items-wrap">
              <table class="table table-sm align-middle mb-0">
                <thead>
                  <tr>
                    <th>Meal</th>
                    <th class="text-end">Qty</th>
                  </tr>
                </thead>
                <tbody id="detailsItemsBody">
                  <tr><td colspan="2" class="text-muted text-center">No items</td></tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="assignDeliveryKitchenModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form method="post">
          <div class="modal-header">
            <h5 class="modal-title">Assign delivery</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" name="action" value="assign_delivery">
            <input type="hidden" name="order_id" id="kitchenAssignDeliveryOrderId">
            <div class="mb-0">
              <label class="form-label">Delivery user</label>
              <select class="form-select" name="delivery_user_id" id="kitchenAssignDeliveryUserId">
                <option value="">Unassigned</option>
                {% for u in deliveryUsers %}
                  <option value="{{ u.id_user }}">{{ (u.name ~ ' ' ~ u.lastname)|trim }}{% if u.email %} ({{ u.email }}){% endif %}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary">Save</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="modal fade" id="markSendingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <form method="post">
          <div class="modal-header">
            <h5 class="modal-title">Mark as sending</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" name="action" value="mark_sending">
            <input type="hidden" name="order_id" id="markSendingOrderId">
            <div class="mb-0">
              <label class="form-label">Delivery user</label>
              <select class="form-select" name="delivery_user_id" id="markSendingDeliveryUserId" required>
                <option value="">Select delivery user</option>
                {% for u in deliveryUsers %}
                  <option value="{{ u.id_user }}">{{ (u.name ~ ' ' ~ u.lastname)|trim }}{% if u.email %} ({{ u.email }}){% endif %}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-warning">Mark as Sending</button>
          </div>
        </form>
      </div>
    </div>
  </div>


</main>
{% endblock %}

{% block scripts %}
  {{ parent() }}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      function escHtml(value) {
        return String(value || '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      const detailsModal = document.getElementById('orderDetailsModal');
      if (detailsModal) {
        detailsModal.addEventListener('show.bs.modal', function (event) {
          const btn = event.relatedTarget;
          if (!btn) return;
          const orderId = btn.getAttribute('data-order-id') || '—';
          const client = btn.getAttribute('data-client') || '—';
          const email = btn.getAttribute('data-email') || '—';
          const phone = btn.getAttribute('data-phone') || '—';
          const city = btn.getAttribute('data-city') || '—';
          const status = btn.getAttribute('data-status') || '—';
          const total = btn.getAttribute('data-total') || '0.00';
          const itemsJson = btn.getAttribute('data-items') || '[]';

          document.getElementById('detailsOrderId').textContent = '#' + orderId;
          document.getElementById('detailsClient').textContent = client;
          document.getElementById('detailsEmail').textContent = email;
          document.getElementById('detailsPhone').textContent = phone;
          document.getElementById('detailsCity').textContent = city;
          document.getElementById('detailsStatus').textContent = status;
          document.getElementById('detailsTotal').textContent = total;

          const body = document.getElementById('detailsItemsBody');
          let items = [];
          try {
            items = JSON.parse(itemsJson);
          } catch (e) {
            items = [];
          }
          if (!body) return;
          if (!items.length) {
            body.innerHTML = '<tr><td colspan="2" class="text-muted text-center">No items</td></tr>';
            return;
          }
          body.innerHTML = items.map(function (it) {
            const name = it.product_name_snapshot || it.name || 'Meal';
            const qty = it.quantity || 0;
            return '<tr><td>' + escHtml(name) + '</td><td class="text-end">' + escHtml(qty) + '</td></tr>';
          }).join('');
        });
      }

      const assignDeliveryModal = document.getElementById('assignDeliveryKitchenModal');
      if (assignDeliveryModal) {
        assignDeliveryModal.addEventListener('show.bs.modal', function (event) {
          const btn = event.relatedTarget;
          if (!btn) return;
          const orderId = btn.getAttribute('data-order-id') || '';
          const deliveryId = btn.getAttribute('data-delivery-user-id') || '';
          const orderInput = document.getElementById('kitchenAssignDeliveryOrderId');
          const select = document.getElementById('kitchenAssignDeliveryUserId');
          if (orderInput) orderInput.value = orderId;
          if (select) select.value = deliveryId;
        });
      }

      const markSendingModal = document.getElementById('markSendingModal');
      if (markSendingModal) {
        markSendingModal.addEventListener('show.bs.modal', function (event) {
          const btn = event.relatedTarget;
          if (!btn) return;
          const orderId = btn.getAttribute('data-order-id') || '';
          const deliveryId = btn.getAttribute('data-delivery-user-id') || '';
          const orderInput = document.getElementById('markSendingOrderId');
          const select = document.getElementById('markSendingDeliveryUserId');
          if (orderInput) orderInput.value = orderId;
          if (select) select.value = deliveryId;
        });
      }

      document.querySelectorAll('.print-label-btn').forEach(function (btn) {
        btn.addEventListener('click', async function () {
          const orderId = btn.getAttribute('data-order-id') || '';
          if (!orderId) return;
          const originalHtml = btn.innerHTML;
          btn.disabled = true;
          btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Generating...';

          try {
            const body = new URLSearchParams();
            body.append('action', 'download_label_pdf');
            body.append('order_id', orderId);

            const response = await fetch(window.location.pathname, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
              },
              body: body.toString()
            });

            if (!response.ok) {
              throw new Error('Failed to generate PDF');
            }

            const blob = await response.blob();
            const blobUrl = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = blobUrl;
            a.download = 'vnv-gourmet-label-order-' + orderId + '.pdf';
            document.body.appendChild(a);
            a.click();
            a.remove();
            window.URL.revokeObjectURL(blobUrl);
          } catch (e) {
            alert('Could not generate the PDF label. Please try again.');
          } finally {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
          }
        });
      });
    });
  </script>
{% endblock %}