{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block body %}

<h2 class="mb-4">Orders Dashboard</h2>
{{ macros.breadcrumb2() }}

<section class="card">
    <div class="card-body">

        <div class="d-flex justify-content-end mb-3">
            <div class="btn-group">
                <a class="btn btn-primary" href="{{ path('/panel/planner-hub/team/orders/calendar') }}">Calendar View</a>
                <a class="btn btn-outline-secondary" href="{{ path('/panel/planner-hub/team/orders/orders') }}">List View</a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle text-center" style="min-width: 1000px;">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Institution</th>
                        <th>Event Date</th>
                        <th>Start - End</th>
                        <th>Address</th>
                        <th>Actions</th>
                        <th>Event Area</th>
                        <th>Confirmation</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in orders %}
                        <tr>
                            <td>vnv-341{{ order.id }}</td>
                            <td>
                                <span class="badge bg-primary">{{ order.institution_name|default('Unknown') }}</span>
                            </td>
                            <td style="min-inline-size: 160px;">{{ order.event_date|date("l, M j - Y" ) }}</td>
                            <td style="min-inline-size: 160px;">{{ order.start_time|date("g:i A") }} - {{ order.end_time|date("g:i A") }}</td>
                            <td style="min-inline-size: 160px;">{{ order.address }}</td>
                            <td style="min-inline-size: 160px;">
                                <div class="btn-group" role="group">
                                    <a href="{{ path(current_location ~ '/tasks') }}?id={{ order.id }}" class="btn btn-sm btn-info">Tasks</a>
                                    <a href="{{ path(current_location ~ '/print') }}?id={{ order.id }}" class="btn btn-sm btn-dark">Print</a>
                                </div>
                            </td>
                            <td>{% if order.is_confirmed == 1 %}<a href="{{ path('panel/event-execution') }}?order_id={{ order.id }}" class="btn btn-sm btn-success">Enter Event Area</a>{% else %}<span class="text-muted">Accept assignment first</span>{% endif %}</td>
                            <td style="min-width: 220px;">
                                {% if order.is_confirmed is null %}
                                    <form method="post" action="?id={{ order.id }}" class="d-flex gap-1 justify-content-center">
                                        <input type="hidden" name="id_order" value="{{ order.id }}">
                                        <select name="is_confirmed" required>
                                            <option value="">Please confirm or reject</option>
                                            <option value="1">Accept</option>
                                            <option value="0">Decline</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-success">Continue</button>
                                    </form>
                                {% elseif order.is_confirmed == 1 %}
                                    <span class="badge bg-success">Accepted</span>
                                    <form method="post" action="?id={{ order.id }}" class="mt-1 cancel-form" data-event-timestamp="{{ order.event_timestamp }}">
                                        <input type="hidden" name="id_order" value="{{ order.id }}">
                                        <input type="hidden" name="is_confirmed" value="0">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                    </form>
                                {% elseif order.is_confirmed == 0 %}
                                    <span class="badge bg-danger">Declined</span>
                                    <form method="post" action="?id={{ order.id }}" class="mt-1">
                                        <input type="hidden" name="id_order" value="{{ order.id }}">
                                        <input type="hidden" name="is_confirmed" value="1">
                                        <button type="submit" class="btn btn-sm btn-outline-success">Re-Accept</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.cancel-form').forEach(function(form) {
        form.addEventListener('submit', function(e) {
            const eventTimestamp = parseInt(this.dataset.eventTimestamp);
            const now = new Date();
            const eventDate = new Date(eventTimestamp * 1000);
            const diffHours = (eventDate - now) / (1000 * 60 * 60);

            let message = "Are you sure you want to cancel?";
            if (diffHours < 48) {
                message = "Warning: Please avoid canceling less than 48 hours before the event to ensure performance is not affected. Are you sure?";
            }

            if (!confirm(message)) {
                e.preventDefault();
            }
        });
    });
});
</script>

{% endblock %}
