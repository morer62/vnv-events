{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block style %}
<style>
.clock-workspace {
    --clock-ink: #122033;
    --clock-muted: #64748b;
    --clock-line: rgba(20, 34, 52, .12);
    --clock-start: #12b981;
    --clock-stop: #ef476f;
    --clock-teal: #1fa99a;
    --clock-surface: #ffffff;
    --clock-soft: #f4f8fb;
    color: var(--clock-ink);
}

.clock-hero {
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    padding: 24px;
    background:
        radial-gradient(circle at top right, rgba(31, 169, 154, .22), transparent 38%),
        linear-gradient(135deg, #10263a 0%, #15394a 48%, #1c8078 100%);
    color: #fff;
    box-shadow: 0 24px 60px rgba(15, 23, 42, .16);
}

.clock-hero::after {
    content: "";
    position: absolute;
    right: -90px;
    bottom: -120px;
    width: 300px;
    height: 300px;
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 50%;
}

.clock-eyebrow {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #99f6e4;
}

.clock-hero h1 {
    max-width: 720px;
    margin: 12px 0 10px;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.03;
    color: #fff;
}

.clock-hero p {
    max-width: 780px;
    margin: 0;
    color: rgba(255,255,255,.82);
    font-size: 1.02rem;
}

.clock-context-card,
.clock-panel,
.clock-side-card {
    border: 1px solid var(--clock-line);
    border-radius: 18px;
    background: var(--clock-surface);
    box-shadow: 0 18px 45px rgba(15, 23, 42, .08);
}

.clock-context-card {
    padding: 18px;
}

.clock-company-icon {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #dffcf6, #b4f1e5);
    color: #0f766e;
    box-shadow: 0 12px 30px rgba(31, 169, 154, .18);
}

.clock-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
}

.clock-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 6px 11px;
    border-radius: 999px;
    border: 1px solid rgba(31, 169, 154, .2);
    background: #eefbf8;
    color: #0f766e;
    font-weight: 700;
    font-size: .82rem;
}

.clock-panel {
    padding: 28px;
}

.clock-orbit {
    position: relative;
    width: min(100%, 360px);
    aspect-ratio: 1;
    margin: 8px auto 22px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background:
        radial-gradient(circle at center, #ffffff 0 54%, transparent 55%),
        conic-gradient(from 0deg, rgba(31,169,154,.14), rgba(31,169,154,.72), rgba(18,185,129,.18), rgba(31,169,154,.14));
    box-shadow:
        inset 0 0 0 1px rgba(31, 169, 154, .18),
        0 22px 56px rgba(15, 23, 42, .10);
}

.clock-orbit::before {
    content: "";
    position: absolute;
    inset: 14px;
    border-radius: 50%;
    border: 1px solid rgba(31,169,154,.2);
    border-top-color: rgba(31,169,154,.9);
    animation: clockOrbitSpin 7s linear infinite;
}

.clock-orbit::after {
    content: "";
    position: absolute;
    inset: 34px;
    border-radius: 50%;
    background:
        linear-gradient(135deg, rgba(255,255,255,.92), rgba(244,248,251,.96));
    box-shadow: inset 0 0 0 1px rgba(20, 34, 52, .08);
}

.clock-orbit.is-running {
    background:
        radial-gradient(circle at center, #ffffff 0 54%, transparent 55%),
        conic-gradient(from 0deg, rgba(18,185,129,.2), rgba(18,185,129,.9), rgba(20,184,166,.22), rgba(18,185,129,.2));
    animation: clockRunningGlow 2.4s ease-in-out infinite;
}

.clock-orbit.is-running::before {
    border-top-color: rgba(18,185,129,.98);
    animation-duration: 4.4s;
}

.clock-orbit.is-idle {
    background:
        radial-gradient(circle at center, #ffffff 0 54%, transparent 55%),
        conic-gradient(from 0deg, rgba(245,158,11,.16), rgba(245,158,11,.72), rgba(31,169,154,.12), rgba(245,158,11,.16));
}

.clock-orbit.is-idle::before {
    border-top-color: rgba(245,158,11,.86);
    animation-duration: 9s;
}

.clock-orbit-content {
    position: relative;
    z-index: 1;
    width: calc(100% - 86px);
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 18px;
}

.clock-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 999px;
    font-weight: 800;
    font-size: .82rem;
}

.clock-status.is-running {
    background: rgba(18, 185, 129, .13);
    color: #047857;
}

.clock-status.is-idle {
    background: rgba(245, 158, 11, .14);
    color: #92400e;
}

.clock-status-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: currentColor;
    box-shadow: 0 0 0 6px rgba(18, 185, 129, .12);
}

.clock-time {
    margin: 18px 0 6px;
    font-size: clamp(2.8rem, 9vw, 5.4rem);
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0;
}

.clock-orbit .clock-time {
    margin-top: 12px;
    font-size: clamp(2.4rem, 7vw, 4.5rem);
}

.clock-subtext {
    color: var(--clock-muted);
    font-size: 1rem;
}

.clock-action-button {
    width: 100%;
    min-height: 78px;
    border: 0;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 22px;
    color: #fff;
    font-size: 1.18rem;
    font-weight: 900;
    box-shadow: 0 18px 38px rgba(15, 23, 42, .18);
    transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
}

.clock-action-button:hover {
    transform: translateY(-2px);
    filter: saturate(1.05);
    color: #fff;
}

.clock-action-button:active {
    transform: translateY(0);
}

.clock-action-button.is-start {
    background: linear-gradient(135deg, #10b981, #0f766e);
}

.clock-action-button.is-stop {
    background: linear-gradient(135deg, #f43f5e, #be123c);
}

.clock-action-icon {
    width: 42px;
    height: 42px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: rgba(255,255,255,.18);
}

.clock-location-state {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 16px;
    color: var(--clock-muted);
    font-size: .92rem;
}

.clock-location-state[data-ready="1"] {
    color: #047857;
}

.clock-assignment-trigger {
    width: 100%;
    margin-top: 14px;
    border: 1px solid rgba(31, 169, 154, .22);
    border-radius: 18px;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    background: linear-gradient(135deg, #ecfdf5, #f8fffd);
    color: #0f766e;
    font-weight: 900;
    box-shadow: 0 14px 34px rgba(15, 23, 42, .08);
    transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
}

.clock-assignment-trigger:hover {
    transform: translateY(-1px);
    border-color: rgba(31, 169, 154, .46);
    box-shadow: 0 18px 38px rgba(15, 23, 42, .11);
}

.clock-assignment-trigger-main,
.clock-assignment-trigger-meta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
}

.clock-assignment-badge {
    min-width: 34px;
    height: 34px;
    padding: 0 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #0f766e;
    color: #fff;
    font-weight: 900;
}

.clock-assignments-modal .modal-content {
    border: 0;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 28px 80px rgba(15, 23, 42, .24);
}

.clock-assignments-hero {
    padding: 24px;
    color: #fff;
    background: radial-gradient(circle at top right, rgba(153, 246, 228, .32), transparent 36%), linear-gradient(135deg, #0f2538 0%, #0f766e 100%);
}

.clock-assignments-hero small {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    color: #99f6e4;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.clock-assignments-hero h5 {
    margin: 10px 0 6px;
    color: #fff;
    font-size: clamp(1.5rem, 4vw, 2.15rem);
    font-weight: 950;
}

.clock-assignments-hero p {
    max-width: 720px;
    margin: 0;
    color: rgba(255, 255, 255, .82);
}

.clock-assignments-body {
    padding: 22px;
    background: linear-gradient(180deg, #f8fffd 0%, #f3f7fb 100%);
}

.clock-events-table {
    margin: 0;
    overflow: hidden;
    border-collapse: separate;
    border-spacing: 0 12px;
}

.clock-events-table thead th {
    border: 0;
    color: #64748b;
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
}

.clock-events-table tbody tr.clock-event-row td {
    border: 0;
    padding: 16px;
    background: #fff;
    box-shadow: 0 14px 34px rgba(15, 23, 42, .06);
}

.clock-events-table tbody tr.clock-event-row td:first-child {
    border-radius: 18px 0 0 18px;
}

.clock-events-table tbody tr.clock-event-row td:last-child {
    border-radius: 0 18px 18px 0;
}

.clock-event-time {
    font-weight: 950;
    color: #0f766e;
    white-space: nowrap;
}

.clock-event-address,
.clock-event-contact {
    color: #334155;
    font-weight: 700;
}

.clock-task-toggle {
    border: 0;
    border-radius: 999px;
    padding: 10px 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #0f766e;
    color: #fff;
    font-weight: 900;
    white-space: nowrap;
}

.clock-task-row td {
    border: 0;
    padding: 0 8px 8px;
}

.clock-task-list {
    display: grid;
    gap: 12px;
    padding: 14px;
    border-radius: 22px;
    background: rgba(15, 118, 110, .07);
}

.clock-task-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    align-items: flex-start;
    padding: 16px;
    border: 1px solid rgba(15, 118, 110, .14);
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 10px 24px rgba(15, 23, 42, .05);
}

.clock-task-card input[type="checkbox"] {
    width: 22px;
    height: 22px;
    accent-color: #0f766e;
    margin-top: 2px;
}

.clock-task-title {
    margin: 0;
    color: #102033;
    font-weight: 950;
}

.clock-task-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
}

.clock-task-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 9px;
    border-radius: 999px;
    background: #f1f5f9;
    color: #475569;
    font-size: .78rem;
    font-weight: 800;
}

.clock-task-notes {
    margin: 10px 0 0;
    color: #64748b;
    font-size: .9rem;
}

.clock-task-status {
    border-radius: 999px;
    padding: 6px 10px;
    background: #fff7ed;
    color: #9a3412;
    font-size: .75rem;
    font-weight: 900;
}

.clock-task-status.is-done {
    background: #dcfce7;
    color: #166534;
}

.clock-empty-assignments {
    padding: 34px 20px;
    border-radius: 22px;
    text-align: center;
    background: #fff;
    color: #64748b;
    box-shadow: 0 16px 36px rgba(15, 23, 42, .06);
}

.clock-manager-warning {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 16px;
    padding: 16px 18px;
    border: 1px solid rgba(220, 38, 38, .26);
    border-left: 5px solid #dc2626;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(254, 242, 242, .98), rgba(255, 255, 255, .96));
    color: #991b1b;
    box-shadow: 0 16px 34px rgba(220, 38, 38, .10);
}

.clock-manager-warning-icon {
    width: 42px;
    height: 42px;
    min-width: 42px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: rgba(220, 38, 38, .12);
    color: #dc2626;
}

.clock-manager-warning strong {
    display: block;
    font-size: .95rem;
    font-weight: 950;
    letter-spacing: .03em;
}

.clock-side-card {
    padding: 18px;
    overflow: hidden;
}

.clock-side-card.is-approved {
    border-color: rgba(18, 185, 129, .28);
    background: #f0fdf4;
}

.clock-side-card + .clock-side-card {
    margin-top: 14px;
}

.clock-side-label {
    color: var(--clock-muted);
    font-size: .72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .04em;
    overflow-wrap: anywhere;
}

.clock-side-value {
    margin-top: 4px;
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.25;
    overflow-wrap: anywhere;
}

.clock-side-card p {
    line-height: 1.45;
    overflow-wrap: anywhere;
}

.clock-switch-btn {
    border-radius: 14px;
    font-weight: 800;
}

@keyframes clockOrbitSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

@keyframes clockRunningGlow {
    0%, 100% {
        box-shadow:
            inset 0 0 0 1px rgba(31, 169, 154, .18),
            0 22px 56px rgba(15, 23, 42, .10),
            0 0 0 0 rgba(18,185,129,.16);
    }
    50% {
        box-shadow:
            inset 0 0 0 1px rgba(31, 169, 154, .2),
            0 24px 60px rgba(15, 23, 42, .12),
            0 0 0 16px rgba(18,185,129,0);
    }
}

@media (prefers-reduced-motion: reduce) {
    .clock-orbit,
    .clock-orbit::before {
        animation: none !important;
    }
}

@media (max-width: 767.98px) {
    .clock-hero {
        padding: 20px;
        border-radius: 18px;
    }

    .clock-panel {
        padding: 22px;
    }

    .clock-orbit {
        width: min(100%, 300px);
    }

    .clock-orbit-content {
        width: calc(100% - 68px);
    }

    .clock-action-button {
        min-height: 70px;
    }

    .clock-context-card .d-flex {
        align-items: flex-start !important;
    }

    .clock-context-card,
    .clock-panel,
    .clock-side-card {
        border-radius: 16px;
    }

    .clock-side-card {
        padding: 16px;
    }

    .clock-side-label {
        font-size: .68rem;
    }

    .clock-side-value {
        font-size: 1rem;
    }

    .clock-assignment-trigger {
        align-items: flex-start;
        padding: 14px;
    }

    .clock-assignments-body {
        padding: 14px;
    }

    .clock-events-table,
    .clock-events-table tbody,
    .clock-events-table tr,
    .clock-events-table td {
        display: block;
        width: 100%;
    }

    .clock-events-table thead {
        display: none;
    }

    .clock-events-table tbody tr.clock-event-row td {
        border-radius: 0;
        box-shadow: none;
        padding: 10px 14px;
    }

    .clock-events-table tbody tr.clock-event-row {
        display: block;
        margin-bottom: 12px;
        border-radius: 20px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 14px 34px rgba(15, 23, 42, .07);
    }

    .clock-events-table tbody tr.clock-event-row td::before {
        content: attr(data-label);
        display: block;
        margin-bottom: 4px;
        color: #94a3b8;
        font-size: .68rem;
        font-weight: 900;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .clock-task-row td {
        padding: 0 0 12px;
    }

    .clock-task-card {
        grid-template-columns: auto 1fr;
    }

    .clock-task-status {
        grid-column: 2;
        justify-self: flex-start;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="clock-workspace">
  <section class="clock-hero mb-4">
    <div class="clock-eyebrow">
      <i data-feather="clock"></i>
      My Clock
    </div>
    <h1>{{ activeLog ? 'Session Active' : 'Start Clock' }}</h1>
    <p>{{ activeLog ? 'Session started at ' ~ activeLog.start_time : 'No active work session' }}</p>
  </section>

  {{ macros.breadcrumb2() }}

  {% if isLevel4 and currentInstitution %}
  <section class="clock-context-card mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
      <div class="d-flex gap-3">
        <div class="clock-company-icon">
          <i data-feather="briefcase"></i>
        </div>
        <div>
          <h2 class="h4 fw-bold mb-1">{{ currentInstitution.company_name }}</h2>
          <div class="clock-meta">
            {% if currentInstitutionRole == 'owner' %}
              <span class="clock-pill"><i data-feather="shield"></i> Owner</span>
            {% elseif roleName %}
              <span class="clock-pill"><i data-feather="user-check"></i> {{ roleName }}</span>
            {% else %}
              <span class="clock-pill"><i data-feather="user"></i> No role assigned</span>
            {% endif %}

            {% if hourlyRate and hourlyRate > 0 %}
              <span class="clock-pill"><i data-feather="dollar-sign"></i> ${{ hourlyRate|number_format(2) }}/hr</span>
            {% else %}
              <span class="clock-pill"><i data-feather="minus-circle"></i> Not set</span>
            {% endif %}

            <span class="clock-pill"><i data-feather="briefcase"></i> VNV Events Team</span>
          </div>
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  <div class="row g-4 align-items-stretch">
    <div class="col-xl-8">
      <section class="clock-panel h-100">
        {% if activeLog %}
          <div class="clock-orbit is-running">
            <div class="clock-orbit-content">
              <div>
                <span class="clock-status is-running"><span class="clock-status-dot"></span> Session Active</span>
                <div class="clock-time" id="elapsed-time">00:00:00</div>
                <div class="clock-subtext">Session started at {{ activeLog.start_time }}</div>
              </div>
            </div>
          </div>

          <form method="post" class="clock-form" id="clockEndForm" data-vnv-async data-async-success-url="{{ path('panel/planner-hub/team/payroll/clock') }}" data-async-success-message="Clock stopped successfully." data-async-waiting="Stopping clock...">
            <input type="hidden" name="action" value="end">
            <input type="hidden" name="location_lat">
            <input type="hidden" name="location_long">
            <input type="hidden" id="notesField" name="notes">
            <input type="hidden" name="tz" class="session-tz">

            <button class="clock-action-button is-stop" type="button" onclick="openNotesModal()">
              <span class="clock-action-icon"><i data-feather="square"></i></span>
              Stop Clock
            </button>
          </form>
        {% else %}
          <div class="clock-orbit is-idle">
            <div class="clock-orbit-content">
              <div>
                <span class="clock-status is-idle"><span class="clock-status-dot"></span> No active work session</span>
                <div class="clock-time">00:00:00</div>
                <div class="clock-subtext">Press start when you are ready to begin your shift.</div>
              </div>
            </div>
          </div>

          <form method="post" class="clock-form" id="clockStartForm" data-vnv-async data-async-success-url="{{ path('panel/planner-hub/team/payroll/clock') }}" data-async-success-message="Clock started successfully." data-async-waiting="Starting clock...">
            <input type="hidden" name="action" value="start">
            <input type="hidden" name="location_lat">
            <input type="hidden" name="location_long">
            <input type="hidden" name="tz" class="session-tz">

            <button class="clock-action-button is-start" type="submit">
              <span class="clock-action-icon"><i data-feather="play"></i></span>
              Start Clock
            </button>
          </form>
        {% endif %}

        <div class="clock-location-state" id="locationState" data-ready="0">
          <i data-feather="map-pin"></i>
          <span>Requesting location...</span>
        </div>

        {% if hasAssignedEventsWithoutTasks|default(false) %}
          <div class="clock-manager-warning" role="alert">
            <span class="clock-manager-warning-icon"><i data-feather="alert-triangle"></i></span>
            <strong>PLEASE CONTACT YOUR MANAGER TO REVIEW YOUR ASSIGNED TASKS</strong>
          </div>
        {% endif %}

        <button class="clock-assignment-trigger" type="button" data-bs-toggle="modal" data-bs-target="#clockAssignmentsModal">
          <span class="clock-assignment-trigger-main">
            <i data-feather="calendar-check"></i>
            View Assigned Events
          </span>
          <span class="clock-assignment-trigger-meta">
            <span class="clock-assignment-badge">{{ assignedOrdersCount|default(assignedEvents|default([])|length) }}</span>
          </span>
        </button>
      </section>
    </div>

    <div class="col-xl-4">
      {% set contractStatus = clockContractStatus|default({'allowed': false}) %}
      {% set contractAllowed = contractStatus.allowed|default(false) %}
      <section class="clock-side-card">
        <div class="clock-side-label">Timezone</div>
        <div class="clock-side-value" id="clockTimezone">-</div>
      </section>
      <section class="clock-side-card {% if contractAllowed %}is-approved{% endif %}">
        <div class="clock-side-label">Clock Access</div>
        {% if contractAllowed %}
          <div class="clock-side-value">Contract approved</div>
          <p class="text-muted mb-0 mt-2 small">Your employee contract is signed or admin-validated. You can clock in normally.</p>
        {% else %}
          <div class="clock-side-value">Contract required before clock in</div>
          <p class="text-muted mb-0 mt-2 small">You need a signed or approved contract before using the clock.</p>
        {% endif %}
      </section>
      {% if isLevel4 and currentInstitution %}
      <section class="clock-side-card">
        <div class="clock-side-label">Current Company</div>
        <div class="clock-side-value">{{ currentInstitution.company_name }}</div>
        <p class="text-muted mb-0 mt-2 small">Your hours will be recorded under this company.</p>
      </section>
      {% endif %}
    </div>
  </div>

  <section class="clock-context-card mt-4">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
      <div><div class="clock-side-label">My Hours</div><h2 class="h4 mb-0">Recent work sessions</h2></div>
      <span class="clock-pill">Last {{ recentLogs|default([])|length }} sessions</span>
    </div>
    <div class="table-responsive">
      <table class="table align-middle mb-0">
        <thead><tr><th>Date</th><th>Clock in</th><th>Clock out</th><th>Duration</th><th>Status</th><th>Notes</th></tr></thead>
        <tbody>
        {% for log in recentLogs|default([]) %}
          {% set seconds = log.duration_seconds|default(0) %}
          {% set hours = (seconds / 3600)|round(0, 'floor') %}
          {% set minutes = ((seconds % 3600) / 60)|round(0, 'floor') %}
          <tr><td>{{ log.start_time|date('M j, Y') }}</td><td>{{ log.start_time|date('g:i A') }}</td><td>{{ log.end_time ? log.end_time|date('g:i A') : 'Active' }}</td><td>{{ hours }}h {{ minutes }}m</td><td><span class="badge {{ log.is_paid ? 'bg-success' : 'bg-warning text-dark' }}">{{ log.is_paid ? 'Paid' : 'Pending' }}</span></td><td>{{ log.notes|default('—') }}</td></tr>
        {% else %}<tr><td colspan="6" class="text-center text-muted py-4">No work sessions recorded yet.</td></tr>{% endfor %}
        </tbody>
      </table>
    </div>
  </section>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {
  const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
  document.querySelectorAll('.session-tz').forEach((input) => {
    input.value = timezone;
  });

  const timezoneLabel = document.getElementById('clockTimezone');
  if (timezoneLabel) {
    timezoneLabel.textContent = timezone;
  }

{% if activeLog %}
  const startStr = "{{ activeLog.start_time|e }}";
  const startDate = new Date(startStr.replace(" ", "T"));
  const elapsedEl = document.getElementById("elapsed-time");

  function updateElapsed() {
    const now = new Date();
    let diff = Math.max(0, Math.floor((now - startDate) / 1000));

    const hours = Math.floor(diff / 3600);
    diff %= 3600;
    const minutes = Math.floor(diff / 60);
    const seconds = diff % 60;

    elapsedEl.textContent = [hours, minutes, seconds]
      .map((value) => String(value).padStart(2, '0'))
      .join(':');
  }

  updateElapsed();
  setInterval(updateElapsed, 1000);
{% endif %}

  document.querySelectorAll('.clock-form').forEach((form) => {
    setLocationFields(form).catch(() => {
      updateLocationState('Location is optional for this session.', false);
    });
  });

  document.querySelectorAll('[data-clock-task-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const row = document.getElementById(button.dataset.clockTaskToggle || '');
      const label = button.querySelector('[data-task-toggle-label]');
      if (!row || !label) return;
      const isHidden = row.hasAttribute('hidden');
      if (isHidden) {
        row.removeAttribute('hidden');
        label.textContent = button.dataset.hideLabel || label.textContent;
      } else {
        row.setAttribute('hidden', 'hidden');
        label.textContent = button.dataset.showLabel || label.textContent;
      }
    });
  });

  const startForm = document.getElementById('clockStartForm');  if (startForm) {
    startForm.addEventListener('submit', (event) => {
      if (startForm.dataset.submitting === '1') return;
      startForm.dataset.submitting = '1';
      const submitButton = startForm.querySelector("button[type='submit']");
      if (submitButton) submitButton.disabled = true;
      if (startForm.dataset.locationReady === '1') return;

      event.preventDefault();
      const locationMessage = 'Starting without GPS location.';
      updateLocationState(locationMessage, false);
      alert(locationMessage);
      if (window.vnvAsyncSubmit) window.vnvAsyncSubmit(startForm);
      else HTMLFormElement.prototype.submit.call(startForm);
    });
  }
});

function updateLocationState(message, ready) {
  const state = document.getElementById('locationState');
  if (!state) return;
  state.dataset.ready = ready ? '1' : '0';
  const text = state.querySelector('span');
  if (text) text.textContent = message;
}

async function setLocationFields(form) {
  return new Promise((resolve, reject) => {
    const bridgedLocation = getMobileLocationBridge();
    if (bridgedLocation && applyLocationToForm(form, bridgedLocation)) {
      updateLocationState('Mobile app location captured.', true);
      resolve();
      return;
    }

    if (!("geolocation" in navigator) || !form) {
      reject(new Error("Geolocation is unavailable."));
      return;
    }
    navigator.geolocation.getCurrentPosition((position) => {
      if (!applyLocationToForm(form, {
        latitude: position.coords.latitude,
        longitude: position.coords.longitude
      })) {
        reject(new Error("Location fields are unavailable."));
        return;
      }

      updateLocationState('Location captured.', true);
      resolve();
    }, reject, { enableHighAccuracy: true, timeout: 3500, maximumAge: 60000 });
  });
}

function applyLocationToForm(form, location) {
  if (!form || !location) return false;

  const latitude = Number(location.latitude ?? location.lat ?? location.location_lat);
  const longitude = Number(location.longitude ?? location.lng ?? location.long ?? location.location_long);
  if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) return false;

  const latInput = form.querySelector("input[name='location_lat']");
  const lngInput = form.querySelector("input[name='location_long']");
  if (!latInput || !lngInput) return false;

  latInput.value = String(latitude);
  lngInput.value = String(longitude);
  form.dataset.locationReady = '1';
  return true;
}

function getMobileLocationBridge() {
  const fromWindow = window.OPHYRA_MOBILE_LOCATION || window.VNV_MOBILE_LOCATION;
  if (fromWindow && typeof fromWindow === 'object') {
    return fromWindow;
  }

  const params = new URLSearchParams(window.location.search);
  const latitude = params.get('mobile_lat') || params.get('lat') || params.get('location_lat');
  const longitude = params.get('mobile_lng') || params.get('lng') || params.get('long') || params.get('location_long');
  if (latitude && longitude) {
    return { latitude, longitude };
  }

  return null;
}

function receiveMobileLocation(location) {
  window.OPHYRA_MOBILE_LOCATION = location;
  document.querySelectorAll('.clock-form').forEach((form) => {
    if (applyLocationToForm(form, location)) {
      updateLocationState('Mobile app location captured.', true);
    }
  });
}

window.addEventListener('ophyra:mobile-location', (event) => {
  receiveMobileLocation(event.detail || {});
});

window.addEventListener('message', (event) => {
  let payload = event.data;
  if (typeof payload === 'string') {
    try {
      payload = JSON.parse(payload);
    } catch (error) {
      return;
    }
  }

  if (payload && (payload.type === 'OPHYRA_MOBILE_LOCATION' || payload.type === 'VNV_MOBILE_LOCATION')) {
    receiveMobileLocation(payload.location || payload);
  }
});

document.addEventListener('message', (event) => {
  window.dispatchEvent(new MessageEvent('message', { data: event.data }));
});

function openNotesModal() {
  const modalElement = document.getElementById('notesModal');
  try {
    if (!modalElement || !window.bootstrap || !window.bootstrap.Modal) {
      submitWithNotes();
      return;
    }
    const modal = new window.bootstrap.Modal(modalElement);
    modal.show();
  } catch (error) {
    submitWithNotes();
  }
}

function submitWithNotes() {
  const form = document.getElementById('clockEndForm');
  if (!form || form.dataset.submitting === '1') {
    return;
  }

  form.dataset.submitting = '1';

  const notesInput = document.getElementById('notesInput');
  const notesField = document.getElementById('notesField');
  if (notesField && notesInput) {
    notesField.value = notesInput.value;
  }

  document.querySelectorAll("#clockEndForm button, #notesModal button").forEach((button) => {
    button.disabled = true;
  });

  if (form.dataset.locationReady !== '1') {
    updateLocationState('Clocking out without refreshing location.', false);
  }

  if (window.vnvAsyncSubmit) window.vnvAsyncSubmit(form);
  else HTMLFormElement.prototype.submit.call(form);
}

</script>
{% endblock %}

{% block aside %}
<div class="modal fade clock-assignments-modal" id="clockAssignmentsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="clock-assignments-hero">
        <div class="d-flex justify-content-between align-items-start gap-3">
          <div>
            <small><i data-feather="calendar-check"></i> Assigned Events</small>
            <h5>Assigned Events</h5>
            <p>Review the events and tasks assigned to your shift.</p>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
      </div>
      <div class="clock-assignments-body">
        {% set events = assignedEvents|default([]) %}
        {% if events|length > 0 %}
          <div class="table-responsive">
            <table class="table clock-events-table align-middle">
              <thead>
                <tr>
                  <th>Start Time</th>
                  <th>Address</th>
                  <th>Contact</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for event in events %}
                  {% set eventKey = 'clockEventTasks' ~ event.id %}
                  <tr class="clock-event-row">
                    <td class="clock-event-time" data-label="Start Time">
                      {% if event.event_date and event.start_time %}
                        {{ (event.event_date ~ ' ' ~ event.start_time)|date('g:i A') }}
                      {% elseif event.start_time %}
                        {{ event.start_time|date('g:i A') }}
                      {% else %}
                        -
                      {% endif %}
                    </td>
                    <td class="clock-event-address" data-label="Address">{{ event.address|default('-') ?: '-' }}</td>
                    <td class="clock-event-contact" data-label="Contact">{{ event.contact_name|default(event.contact_email|default('-')) ?: '-' }}</td>
                    <td class="text-end" data-label="Actions">
                      <button class="clock-task-toggle" type="button" data-clock-task-toggle="{{ eventKey }}" data-show-label="View Tasks" data-hide-label="Hide Tasks">
                        <i data-feather="list"></i>
                        <span data-task-toggle-label>View Tasks</span>
                      </button>
                      <a class="clock-task-toggle" href="{{ path('panel/planner-hub/team/orders/orders/tasks') }}?id={{ event.id }}" target="_blank" rel="noopener">
                        <i data-feather="external-link"></i>
                        <span>Full View</span>
                      </a>
                      <a class="clock-task-toggle" href="{{ path('panel/planner-hub/team/orders/orders/print/team-assignment') }}?id={{ event.id }}" target="_blank" rel="noopener">
                        <i data-feather="file-text"></i>
                        <span>PDF</span>
                      </a>
                    </td>
                  </tr>
                  <tr class="clock-task-row" id="{{ eventKey }}" hidden>
                    <td colspan="4">
                      <div class="clock-task-list">
                        {% for task in event.tasks %}
                          <label class="clock-task-card">
                            <input type="checkbox" disabled {% if task.is_done %}checked{% endif %}>
                            <span>
                              <p class="clock-task-title">{{ task.title|default('Task') }}</p>
                              <span class="clock-task-meta">
                                <span class="clock-task-chip"><i data-feather="tool"></i> Setup / Installation: {{ task.setup_time ? task.setup_time|date('g:i A') : '-' }}</span>
                                <span class="clock-task-chip"><i data-feather="play-circle"></i> Activity Start: {{ task.activity_start_time ? task.activity_start_time|date('g:i A') : '-' }}</span>
                                <span class="clock-task-chip"><i data-feather="stop-circle"></i> End: {{ task.activity_end_time ? task.activity_end_time|date('g:i A') : '-' }}</span>
                                <span class="clock-task-chip"><i data-feather="package"></i> Breakdown: {{ task.breakdown_time ? task.breakdown_time|date('g:i A') : '-' }}</span>
                              </span>
                              <p class="clock-task-notes"><strong>Notes:</strong> {{ task.notes|default('No notes') ?: 'No notes' }}</p>
                            </span>
                            <span class="clock-task-status {% if task.is_done %}is-done{% endif %}">
                              {{ task.is_done ? 'Done' : 'Pending' }}
                            </span>
                          </label>
                        {% else %}
                          <div class="clock-manager-warning" role="alert">
                            <span class="clock-manager-warning-icon"><i data-feather="alert-triangle"></i></span>
                            <strong>PLEASE CONTACT YOUR MANAGER TO REVIEW YOUR ASSIGNED TASKS</strong>
                          </div>
                        {% endfor %}
                      </div>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div class="clock-empty-assignments">
            <i data-feather="calendar"></i>
            <p class="fw-bold mt-3 mb-1">No assigned events found</p>
            <span>When events are assigned to you, they will appear here.</span>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="notesModal" tabindex="-1" aria-labelledby="notesModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4">
      <div class="modal-header">
        <h5 class="modal-title" id="notesModalLabel">Clock-out Notes</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="mb-2">Add a short note about this work session before clocking out.</p>
        <textarea id="notesInput" class="form-control" rows="3" maxlength="240" placeholder="Optional notes for this session"></textarea>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" onclick="submitWithNotes()">Stop Clock</button>
      </div>
    </div>
  </div>
</div>
{% endblock %}



