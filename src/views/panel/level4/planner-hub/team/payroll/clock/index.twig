{% extends 'templates/base.admin.twig' %}
{% import 'templates/macros.twig' as macros %}

{% block style %}
<style>
.clock-workspace {
    --clock-ink: #122033;
    --clock-muted: #64748b;
    --clock-line: rgba(20, 34, 52, .12);
    --clock-start: #12b981;
    --clock-stop: #ef476f;
    --clock-teal: #1fa99a;
    --clock-surface: #ffffff;
    --clock-soft: #f4f8fb;
    color: var(--clock-ink);
}

.clock-hero {
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    padding: 24px;
    background:
        radial-gradient(circle at top right, rgba(31, 169, 154, .22), transparent 38%),
        linear-gradient(135deg, #10263a 0%, #15394a 48%, #1c8078 100%);
    color: #fff;
    box-shadow: 0 24px 60px rgba(15, 23, 42, .16);
}

.clock-hero::after {
    content: "";
    position: absolute;
    right: -90px;
    bottom: -120px;
    width: 300px;
    height: 300px;
    border: 1px solid rgba(255,255,255,.18);
    border-radius: 50%;
}

.clock-eyebrow {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #99f6e4;
}

.clock-hero h1 {
    max-width: 720px;
    margin: 12px 0 10px;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.03;
    color: #fff;
}

.clock-hero p {
    max-width: 780px;
    margin: 0;
    color: rgba(255,255,255,.82);
    font-size: 1.02rem;
}

.clock-context-card,
.clock-panel,
.clock-side-card {
    border: 1px solid var(--clock-line);
    border-radius: 18px;
    background: var(--clock-surface);
    box-shadow: 0 18px 45px rgba(15, 23, 42, .08);
}

.clock-context-card {
    padding: 18px;
}

.clock-company-icon {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #dffcf6, #b4f1e5);
    color: #0f766e;
    box-shadow: 0 12px 30px rgba(31, 169, 154, .18);
}

.clock-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
}

.clock-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 6px 11px;
    border-radius: 999px;
    border: 1px solid rgba(31, 169, 154, .2);
    background: #eefbf8;
    color: #0f766e;
    font-weight: 700;
    font-size: .82rem;
}

.clock-panel {
    padding: 28px;
}

.clock-orbit {
    position: relative;
    width: min(100%, 360px);
    aspect-ratio: 1;
    margin: 8px auto 22px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background:
        radial-gradient(circle at center, #ffffff 0 54%, transparent 55%),
        conic-gradient(from 0deg, rgba(31,169,154,.14), rgba(31,169,154,.72), rgba(18,185,129,.18), rgba(31,169,154,.14));
    box-shadow:
        inset 0 0 0 1px rgba(31, 169, 154, .18),
        0 22px 56px rgba(15, 23, 42, .10);
}

.clock-orbit::before {
    content: "";
    position: absolute;
    inset: 14px;
    border-radius: 50%;
    border: 1px solid rgba(31,169,154,.2);
    border-top-color: rgba(31,169,154,.9);
    animation: clockOrbitSpin 7s linear infinite;
}

.clock-orbit::after {
    content: "";
    position: absolute;
    inset: 34px;
    border-radius: 50%;
    background:
        linear-gradient(135deg, rgba(255,255,255,.92), rgba(244,248,251,.96));
    box-shadow: inset 0 0 0 1px rgba(20, 34, 52, .08);
}

.clock-orbit.is-running {
    background:
        radial-gradient(circle at center, #ffffff 0 54%, transparent 55%),
        conic-gradient(from 0deg, rgba(18,185,129,.2), rgba(18,185,129,.9), rgba(20,184,166,.22), rgba(18,185,129,.2));
    animation: clockRunningGlow 2.4s ease-in-out infinite;
}

.clock-orbit.is-running::before {
    border-top-color: rgba(18,185,129,.98);
    animation-duration: 4.4s;
}

.clock-orbit.is-idle {
    background:
        radial-gradient(circle at center, #ffffff 0 54%, transparent 55%),
        conic-gradient(from 0deg, rgba(245,158,11,.16), rgba(245,158,11,.72), rgba(31,169,154,.12), rgba(245,158,11,.16));
}

.clock-orbit.is-idle::before {
    border-top-color: rgba(245,158,11,.86);
    animation-duration: 9s;
}

.clock-orbit-content {
    position: relative;
    z-index: 1;
    width: calc(100% - 86px);
    aspect-ratio: 1;
    border-radius: 50%;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 18px;
}

.clock-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-radius: 999px;
    font-weight: 800;
    font-size: .82rem;
}

.clock-status.is-running {
    background: rgba(18, 185, 129, .13);
    color: #047857;
}

.clock-status.is-idle {
    background: rgba(245, 158, 11, .14);
    color: #92400e;
}

.clock-status-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: currentColor;
    box-shadow: 0 0 0 6px rgba(18, 185, 129, .12);
}

.clock-time {
    margin: 18px 0 6px;
    font-size: clamp(2.8rem, 9vw, 5.4rem);
    line-height: 1;
    font-weight: 900;
    letter-spacing: 0;
}

.clock-orbit .clock-time {
    margin-top: 12px;
    font-size: clamp(2.4rem, 7vw, 4.5rem);
}

.clock-subtext {
    color: var(--clock-muted);
    font-size: 1rem;
}

.clock-action-button {
    width: 100%;
    min-height: 78px;
    border: 0;
    border-radius: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 22px;
    color: #fff;
    font-size: 1.18rem;
    font-weight: 900;
    box-shadow: 0 18px 38px rgba(15, 23, 42, .18);
    transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
}

.clock-action-button:hover {
    transform: translateY(-2px);
    filter: saturate(1.05);
    color: #fff;
}

.clock-action-button:active {
    transform: translateY(0);
}

.clock-action-button.is-start {
    background: linear-gradient(135deg, #10b981, #0f766e);
}

.clock-action-button.is-stop {
    background: linear-gradient(135deg, #f43f5e, #be123c);
}

.clock-action-icon {
    width: 42px;
    height: 42px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: rgba(255,255,255,.18);
}

.clock-location-state {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 16px;
    color: var(--clock-muted);
    font-size: .92rem;
}

.clock-location-state[data-ready="1"] {
    color: #047857;
}

.clock-side-card {
    padding: 18px;
    overflow: hidden;
}

.clock-side-card.is-approved {
    border-color: rgba(18, 185, 129, .28);
    background: #f0fdf4;
}

.clock-side-card + .clock-side-card {
    margin-top: 14px;
}

.clock-side-label {
    color: var(--clock-muted);
    font-size: .72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .04em;
    overflow-wrap: anywhere;
}

.clock-side-value {
    margin-top: 4px;
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.25;
    overflow-wrap: anywhere;
}

.clock-side-card p {
    line-height: 1.45;
    overflow-wrap: anywhere;
}

.clock-switch-btn {
    border-radius: 14px;
    font-weight: 800;
}

@keyframes clockOrbitSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

@keyframes clockRunningGlow {
    0%, 100% {
        box-shadow:
            inset 0 0 0 1px rgba(31, 169, 154, .18),
            0 22px 56px rgba(15, 23, 42, .10),
            0 0 0 0 rgba(18,185,129,.16);
    }
    50% {
        box-shadow:
            inset 0 0 0 1px rgba(31, 169, 154, .2),
            0 24px 60px rgba(15, 23, 42, .12),
            0 0 0 16px rgba(18,185,129,0);
    }
}

@media (prefers-reduced-motion: reduce) {
    .clock-orbit,
    .clock-orbit::before {
        animation: none !important;
    }
}

@media (max-width: 767.98px) {
    .clock-hero {
        padding: 20px;
        border-radius: 18px;
    }

    .clock-panel {
        padding: 22px;
    }

    .clock-orbit {
        width: min(100%, 300px);
    }

    .clock-orbit-content {
        width: calc(100% - 68px);
    }

    .clock-action-button {
        min-height: 70px;
    }

    .clock-context-card .d-flex {
        align-items: flex-start !important;
    }

    .clock-context-card,
    .clock-panel,
    .clock-side-card {
        border-radius: 16px;
    }

    .clock-side-card {
        padding: 16px;
    }

    .clock-side-label {
        font-size: .68rem;
    }

    .clock-side-value {
        font-size: 1rem;
    }
}
</style>
{% endblock %}

{% block body %}
<div class="clock-workspace">
  <section class="clock-hero mb-4">
    <div class="clock-eyebrow">
      <i data-feather="clock"></i>
      {{ trans('planner_hub.my_clock') }}
    </div>
    <h1>{{ activeLog ? trans('planner_hub.session_active') : trans('planner_hub.start_clock') }}</h1>
    <p>{{ activeLog ? trans('planner_hub.session_started_at') ~ ' ' ~ activeLog.start_time : trans('planner_hub.no_active_work_session') }}</p>
  </section>

  {{ macros.breadcrumb2() }}

  {% if isLevel4 and currentInstitution %}
  <section class="clock-context-card mb-4">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
      <div class="d-flex gap-3">
        <div class="clock-company-icon">
          <i data-feather="briefcase"></i>
        </div>
        <div>
          <h2 class="h4 fw-bold mb-1">{{ currentInstitution.company_name }}</h2>
          <div class="clock-meta">
            {% if currentInstitutionRole == 'owner' %}
              <span class="clock-pill"><i data-feather="shield"></i> {{ trans('planner_hub.clock_owner') }}</span>
            {% elseif roleName %}
              <span class="clock-pill"><i data-feather="user-check"></i> {{ roleName }}</span>
            {% else %}
              <span class="clock-pill"><i data-feather="user"></i> {{ trans('planner_hub.clock_no_role') }}</span>
            {% endif %}

            {% if hourlyRate and hourlyRate > 0 %}
              <span class="clock-pill"><i data-feather="dollar-sign"></i> ${{ hourlyRate|number_format(2) }}/hr</span>
            {% else %}
              <span class="clock-pill"><i data-feather="minus-circle"></i> {{ trans('planner_hub.clock_not_set') }}</span>
            {% endif %}

            {% if hasMultipleInstitutions %}
              <span class="clock-pill"><i data-feather="shuffle"></i> {{ trans('planner_hub.clock_multiple_companies') }}</span>
            {% endif %}
          </div>
        </div>
      </div>
      {% if hasMultipleInstitutions %}
      <div class="d-flex align-items-center">
        <button class="btn btn-outline-primary clock-switch-btn px-4 py-2" type="button" onclick="showInstitutionSwitcher()">
          <i data-feather="repeat"></i>
          {{ trans('planner_hub.clock_switch_company') }}
        </button>
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  <div class="row g-4 align-items-stretch">
    <div class="col-xl-8">
      <section class="clock-panel h-100">
        {% if activeLog %}
          <div class="clock-orbit is-running">
            <div class="clock-orbit-content">
              <div>
                <span class="clock-status is-running"><span class="clock-status-dot"></span> {{ trans('planner_hub.session_active') }}</span>
                <div class="clock-time" id="elapsed-time">00:00:00</div>
                <div class="clock-subtext">{{ trans('planner_hub.session_started_at') }} {{ activeLog.start_time }}</div>
              </div>
            </div>
          </div>

          <form method="post" class="clock-form" id="clockEndForm">
            <input type="hidden" name="action" value="end">
            <input type="hidden" name="location_lat">
            <input type="hidden" name="location_long">
            <input type="hidden" id="notesField" name="notes">
            <input type="hidden" name="tz" class="session-tz">

            <button class="clock-action-button is-stop" type="button" onclick="openNotesModal()">
              <span class="clock-action-icon"><i data-feather="square"></i></span>
              {{ trans('planner_hub.stop_clock') }}
            </button>
          </form>
        {% else %}
          <div class="clock-orbit is-idle">
            <div class="clock-orbit-content">
              <div>
                <span class="clock-status is-idle"><span class="clock-status-dot"></span> {{ trans('planner_hub.no_active_work_session') }}</span>
                <div class="clock-time">00:00:00</div>
                <div class="clock-subtext">{{ trans('planner_hub.push_to_start_clock') }}</div>
              </div>
            </div>
          </div>

          <form method="post" class="clock-form" id="clockStartForm">
            <input type="hidden" name="action" value="start">
            <input type="hidden" name="location_lat">
            <input type="hidden" name="location_long">
            <input type="hidden" name="tz" class="session-tz">

            <button class="clock-action-button is-start" type="submit">
              <span class="clock-action-icon"><i data-feather="play"></i></span>
              {{ trans('planner_hub.start_clock') }}
            </button>
          </form>
        {% endif %}

        <div class="clock-location-state" id="locationState" data-ready="0">
          <i data-feather="map-pin"></i>
          <span>{{ trans('planner_hub.clock_requesting_location') }}</span>
        </div>
      </section>
    </div>

    <div class="col-xl-4">
      {% set contractStatus = clockContractStatus|default({'allowed': false}) %}
      {% set contractAllowed = contractStatus.allowed|default(false) %}
      <section class="clock-side-card">
        <div class="clock-side-label">{{ trans('planner_hub.clock_timezone') }}</div>
        <div class="clock-side-value" id="clockTimezone">-</div>
      </section>
      <section class="clock-side-card {% if contractAllowed %}is-approved{% endif %}">
        <div class="clock-side-label">{{ trans('planner_hub.clock_contract_rule') }}</div>
        {% if contractAllowed %}
          <div class="clock-side-value">{{ trans('planner_hub.clock_contract_approved') }}</div>
          <p class="text-muted mb-0 mt-2 small">{{ trans('planner_hub.clock_contract_approved_body') }}</p>
        {% else %}
          <div class="clock-side-value">{{ trans('planner_hub.clock_contract_required_before_clock_in') }}</div>
          <p class="text-muted mb-0 mt-2 small">{{ trans('planner_hub.team_contract_clock_blocked') }}</p>
        {% endif %}
      </section>
      {% if isLevel4 and currentInstitution %}
      <section class="clock-side-card">
        <div class="clock-side-label">{{ trans('planner_hub.clock_current_company') }}</div>
        <div class="clock-side-value">{{ currentInstitution.company_name }}</div>
        <p class="text-muted mb-0 mt-2 small">{{ trans('planner_hub.clock_company_hours_scope') }}</p>
      </section>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {
  const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
  document.querySelectorAll('.session-tz').forEach((input) => {
    input.value = timezone;
  });

  const timezoneLabel = document.getElementById('clockTimezone');
  if (timezoneLabel) {
    timezoneLabel.textContent = timezone;
  }

{% if activeLog %}
  const startStr = "{{ activeLog.start_time|e }}";
  const startDate = new Date(startStr.replace(" ", "T"));
  const elapsedEl = document.getElementById("elapsed-time");

  function updateElapsed() {
    const now = new Date();
    let diff = Math.max(0, Math.floor((now - startDate) / 1000));

    const hours = Math.floor(diff / 3600);
    diff %= 3600;
    const minutes = Math.floor(diff / 60);
    const seconds = diff % 60;

    elapsedEl.textContent = [hours, minutes, seconds]
      .map((value) => String(value).padStart(2, '0'))
      .join(':');
  }

  updateElapsed();
  setInterval(updateElapsed, 1000);
{% endif %}

  document.querySelectorAll('.clock-form').forEach((form) => {
    setLocationFields(form).catch(() => {
      updateLocationState('{{ trans('planner_hub.clock_location_optional')|e('js') }}', false);
    });
  });

  const startForm = document.getElementById('clockStartForm');
  if (startForm) {
    startForm.addEventListener('submit', (event) => {
      if (startForm.dataset.submitting === '1') return;
      startForm.dataset.submitting = '1';
      const submitButton = startForm.querySelector("button[type='submit']");
      if (submitButton) submitButton.disabled = true;
      if (startForm.dataset.locationReady === '1') return;

      event.preventDefault();
      const locationMessage = '{{ trans('planner_hub.clock_location_starting_without_gps')|e('js') }}';
      updateLocationState(locationMessage, false);
      alert(locationMessage);
      startForm.submit();
    });
  }
});

function updateLocationState(message, ready) {
  const state = document.getElementById('locationState');
  if (!state) return;
  state.dataset.ready = ready ? '1' : '0';
  const text = state.querySelector('span');
  if (text) text.textContent = message;
}

async function setLocationFields(form) {
  return new Promise((resolve, reject) => {
    if (!("geolocation" in navigator) || !form) {
      reject(new Error("Geolocation is unavailable."));
      return;
    }
    navigator.geolocation.getCurrentPosition((position) => {
      const latInput = form.querySelector("input[name='location_lat']");
      const lngInput = form.querySelector("input[name='location_long']");
      if (!latInput || !lngInput) {
        reject(new Error("Location fields are unavailable."));
        return;
      }

      latInput.value = position.coords.latitude;
      lngInput.value = position.coords.longitude;
      form.dataset.locationReady = '1';
      updateLocationState('{{ trans('planner_hub.clock_location_captured')|e('js') }}', true);
      resolve();
    }, reject, { enableHighAccuracy: true, timeout: 3500, maximumAge: 60000 });
  });
}

function openNotesModal() {
  const modalElement = document.getElementById('notesModal');
  try {
    if (!modalElement || !window.bootstrap || !window.bootstrap.Modal) {
      submitWithNotes();
      return;
    }
    const modal = new window.bootstrap.Modal(modalElement);
    modal.show();
  } catch (error) {
    submitWithNotes();
  }
}

function submitWithNotes() {
  const form = document.getElementById('clockEndForm');
  if (!form || form.dataset.submitting === '1') {
    return;
  }

  form.dataset.submitting = '1';

  const notesInput = document.getElementById('notesInput');
  const notesField = document.getElementById('notesField');
  if (notesField && notesInput) {
    notesField.value = notesInput.value;
  }

  document.querySelectorAll("#clockEndForm button, #notesModal button").forEach((button) => {
    button.disabled = true;
  });

  if (form.dataset.locationReady !== '1') {
    updateLocationState('{{ trans('planner_hub.clock_location_out_without_refresh')|e('js') }}', false);
  }

  form.submit();
}

function showInstitutionSwitcher() {
  const modalElement = document.getElementById('institutionSwitcherModal');
  if (!modalElement) {
    return;
  }

  try {
    if (window.bootstrap && window.bootstrap.Modal) {
      const modal = new window.bootstrap.Modal(modalElement);
      modal.show();
      return;
    }
  } catch (error) {
  }

  modalElement.classList.add('show');
  modalElement.style.display = 'block';
  modalElement.removeAttribute('aria-hidden');
  modalElement.setAttribute('aria-modal', 'true');
}

function switchInstitution(institutionId, role) {
  const form = document.createElement('form');
  form.method = 'POST';
  form.action = window.location.href;

  const switchInput = document.createElement('input');
  switchInput.type = 'hidden';
  switchInput.name = 'switch_institution';
  switchInput.value = '1';

  const idInput = document.createElement('input');
  idInput.type = 'hidden';
  idInput.name = 'institution_id';
  idInput.value = institutionId;

  const roleInput = document.createElement('input');
  roleInput.type = 'hidden';
  roleInput.name = 'role';
  roleInput.value = role;

  form.appendChild(switchInput);
  form.appendChild(idInput);
  form.appendChild(roleInput);

  document.body.appendChild(form);
  form.submit();
}
</script>
{% endblock %}

{% block aside %}
{% if isLevel4 %}
<div class="modal fade" id="institutionSwitcherModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4">
      <div class="modal-header">
        <h5 class="modal-title fw-bold">{{ trans('planner_hub.clock_switch_company') }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="mb-3">{{ trans('planner_hub.clock_select_company') }}</p>
        <div class="list-group">
          {% for institution in userInstitutions %}
          <div class="list-group-item d-flex justify-content-between align-items-center gap-3">
            <div>
              <h6 class="mb-1">{{ institution.company_name }}</h6>
              <small class="text-muted">
                {% if institution.relationship_type == 'primary' %}
                  {{ trans('planner_hub.role') }}: <span class="badge bg-success">{{ trans('planner_hub.clock_owner') }}</span>
                {% else %}
                  {{ trans('planner_hub.role') }}:
                  {% if institution.role_name %}
                    <span class="badge bg-info">{{ institution.role_name }}</span>
                  {% else %}
                    <span class="text-muted">{{ trans('planner_hub.clock_no_role') }}</span>
                  {% endif %}
                  | {{ trans('planner_hub.hourly_rate') }}:
                  {% if institution.hourly_rate and institution.hourly_rate > 0 %}
                    ${{ institution.hourly_rate|number_format(2) }}/hr
                  {% else %}
                    <span class="text-muted">{{ trans('planner_hub.clock_not_set') }}</span>
                  {% endif %}
                {% endif %}
                {% if institution.working_institution_id == currentInstitution.id %}
                  <span class="badge bg-success ms-2">{{ trans('planner_hub.current') }}</span>
                {% endif %}
              </small>
            </div>
            {% if institution.working_institution_id != currentInstitution.id %}
            {% set institutionRole = institution.relationship_type == 'primary' ? 'owner' : 'employee' %}
            <button class="btn btn-outline-primary btn-sm" onclick="switchInstitution('{{ institution.working_institution_id }}', '{{ institutionRole }}')">
              {{ trans('planner_hub.clock_switch_company') }}
            </button>
            {% endif %}
          </div>
          {% endfor %}
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ trans('ui.cancel') }}</button>
      </div>
    </div>
  </div>
</div>
{% endif %}

