{% extends "templates/base.admin.twig" %}{% block body %}
<div class="container py-4"><h1 class="h3">My Event Availability</h1><p class="text-muted">Block vacations or unavailable periods within the rolling six-month window. Existing assignments are never cancelled automatically; Level 1 is alerted for review.</p>
<div class="row g-4"><div class="col-lg-5"><div class="card"><div class="card-body"><h2 class="h5">Add availability period</h2><form method="post"><input type="hidden" name="action" value="save"><div class="row g-3"><div class="col-6"><label class="form-label">From</label><input class="form-control" type="date" name="start_date" min="{{ today }}" max="{{ horizon }}" required></div><div class="col-6"><label class="form-label">Through</label><input class="form-control" type="date" name="end_date" min="{{ today }}" max="{{ horizon }}" required></div><div class="col-12"><label class="form-label">Status</label><select class="form-select" name="availability"><option value="UNAVAILABLE">Unavailable</option><option value="AVAILABLE">Available note</option></select></div><div class="col-12"><label class="form-label">Note</label><textarea class="form-control" name="note" rows="3" placeholder="Vacation, personal block, available on request…"></textarea></div><div class="col-12"><button class="btn btn-primary w-100">Save period</button></div></div></form></div></div></div>
<div class="col-lg-7"><div class="card"><div class="card-body"><h2 class="h5">Next six months</h2>{% for block in blocks %}<div class="border rounded p-3 mb-2 d-flex justify-content-between align-items-center"><div><span class="badge {{ block.availability == 'UNAVAILABLE' ? 'bg-danger' : 'bg-success' }}">{{ block.availability }}</span> <strong>{{ block.starts_at|date('M j, Y') }} – {{ block.ends_at|date_modify('-1 day')|date('M j, Y') }}</strong><div class="small text-muted">{{ block.note }}</div></div><form method="post"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="{{ block.id }}"><input type="hidden" name="start_date" value="{{ today }}"><input type="hidden" name="end_date" value="{{ today }}"><button class="btn btn-sm btn-outline-danger">Remove</button></form></div>{% else %}<p class="text-muted">No personal availability blocks. Your assigned-event schedule still controls availability.</p>{% endfor %}</div></div></div></div></div>
{% endblock %}
