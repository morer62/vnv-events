{% extends "templates/base.twig" %}

{% block title %}{{ title }}{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Revert User Profile Changes</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <strong>Warning:</strong> This action will revert the user's profile to the state it was in before the selected changes were made.
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h5>User Information</h5>
                            <p><strong>Name:</strong> {{ user.name }} {{ user.lastname }}</p>
                            <p><strong>Email:</strong> {{ user.email }}</p>
                            <p><strong>Phone:</strong> {{ user.phone }}</p>
                        </div>
                        <div class="col-md-6">
                            <h5>Change Details</h5>
                            <p><strong>Changed by:</strong> {{ log.editor_name }} {{ log.editor_lastname }}</p>
                            <p><strong>Date:</strong> {{ log.created_at|date('Y-m-d H:i:s') }}</p>
                        </div>
                    </div>

                    <div class="mt-4">
                        <h5>Changes to be reverted:</h5>
                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Field</th>
                                        <th>Current Value</th>
                                        <th>Previous Value</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% set changes = log.changes|json_decode %}
                                    {% for field, change in changes %}
                                    <tr>
                                        <td><strong>{{ field|title }}</strong></td>
                                        <td>{{ change.new }}</td>
                                        <td class="text-success"><strong>{{ change.old }}</strong></td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="mt-4">
                        <form method="post" onsubmit="return confirm('Are you sure you want to revert these changes? This action cannot be undone.');">
                            <button type="submit" name="revert" class="btn btn-warning">
                                <i class="fas fa-undo"></i> Revert Changes
                            </button>
                            <a href="/panel/planner-hub/management/users" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Cancel
                            </a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
