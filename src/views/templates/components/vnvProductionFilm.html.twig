{% set media = film.media|default('assets/video/production-films/v6/' ~ film.slug) %}
<section class="vnv-film ve-film" aria-labelledby="{{ film.slug }}-film-title" id="{{ film.slug }}-film">
  <div class="vnv-offer__wrap vnv-film__layout">
    <div class="vnv-film__copy">
      <h2 id="{{ film.slug }}-film-title">{{ film.title }}</h2>
      <p>{{ film.description }}</p>
      {% if film.cta is defined and film.request_type is defined %}
        <button class="vnvp-button vnvp-button--gold" type="button" data-vnv-open-quick-request data-quick-request-type="{{ film.request_type }}" data-quick-request-source="{{ film.request_source }}">{{ film.cta }}</button>
      {% elseif film.cta is defined %}
        <a class="vnvp-button vnvp-button--gold" href="{{ film.href }}">{{ film.cta }}</a>
      {% endif %}
    </div>
    <figure class="vnv-film__media vnv-caption-frame">
      <video class="vnv-film__player" controls playsinline preload="none" width="1280" height="720" poster="{{ asset_for(media ~ '.webp') }}" aria-labelledby="{{ film.slug }}-film-title" aria-describedby="{{ film.slug }}-film-credit">
        <source src="{{ asset_for(media ~ '.mp4') }}" type="video/mp4">
        <track kind="captions" srclang="en" label="English" src="{{ asset_for(media ~ '-en.vtt') }}">
        <a href="{{ asset_for(media ~ '.mp4') }}">Download the video</a>
      </video>
      {% include 'templates/components/vnvFilmCaptions.html.twig' with {caption_id: film.slug ~ '-captions'} only %}
      <figcaption id="{{ film.slug }}-film-credit">{{ film.credit ?? (film.music_only|default(false) ? 'AI-generated scenes with instrumental music' : 'AI-generated narration') }}</figcaption>
      <div class="ve-film__tools">
        <a href="{{ asset_for(media ~ '.mp4') }}" target="_blank" rel="noopener">Open film with sound</a>
        <button type="button" class="ve-film__share" data-vnv-share-film="{{ path(film.route) }}#{{ film.slug }}-film" data-film-title="{{ film.title }}" hidden>Share film</button>
        <span class="ve-film__status" role="status"></span>
      </div>
    </figure>
  </div>
</section>
