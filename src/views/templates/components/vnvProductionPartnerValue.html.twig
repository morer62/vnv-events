} %}
<section class="vp-value{{ compact|default(false) ? ' vp-value--compact' : '' }}" aria-labelledby="partner-system-title">
  <div class="vp-value__inner">
    <h2 id="partner-system-title">Your digital event system is included</h2>
    <p>Your team pays <strong>$0 for setup and access</strong> to the digital tools in its VNV agreement. This applies to paid productions and sponsorships, as well as approved no-fee and in-kind partnerships.</p>
    <p>{{ examples[audience] }}</p>
    <table>
      <caption>One-time setup costs in US dollars</caption>
      <thead>
        <tr><th scope="col">Setup service</th><th scope="col">Published example</th><th scope="col">With VNV</th></tr>
      </thead>
      <tbody>
        <tr><th scope="row">Team and dashboard setup</th><td>From $99</td><td>$0</td></tr>
        <tr><th scope="row">Event registration form</th><td>$300</td><td>$0</td></tr>
        <tr><th scope="row">Event website setup</th><td>$500</td><td>$0</td></tr>
        <tr><th scope="row">Full platform configuration</th><td>$1,000</td><td>$0</td></tr>
      </tbody>
    </table>
    <p><strong>Access after setup.</strong> HoldThat lists its Professional Event Pass at $499 for one event with 90 days of access. Your VNV team can reuse its workspace for future events at no additional platform fee.</p>
    <p class="vp-value__note">Each row is a separate example. The full setup is a package. Your agreement specifies your team's tools, sponsorship rights, production costs and any third-party fees.</p>
    <p class="vp-value__sources">Prices checked November 27, 2026. <a href="https://events.holdthat.systems/pricing">HoldThat EventOS pricing</a> · <a href="https://eventation.io/pricing/">Eventation pricing</a></p>
  </div>
</section>
