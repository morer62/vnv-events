{% set request_form_action = request_form_action|default('/api/public/event-request') %}
{% set request_form_source = request_form_source|default('public_home_modal') %}

<div class="vnv-request-modal" id="vnvRequestModal" aria-hidden="true">
    <div class="vnv-request-modal__backdrop" data-vnv-request-close></div>

    <div class="vnv-request-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="vnvRequestModalTitle">
        <button type="button" class="vnv-request-modal__close" data-vnv-request-close aria-label="Close">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <div class="vnv-request-modal__brand">Plan your event</div>

        <form
            id="vnvRequestForm"
            class="vnv-request-modal__form"
            method="post"
            action="{{ request_form_action }}"
        >
            <input type="hidden" name="selected_services" id="vnvSelectedServicesInput">
            <input type="hidden" name="form_source" value="{{ request_form_source }}">

            {# NUEVO: token recaptcha #}
            <input type="hidden" name="recaptcha_token" id="vnvRecaptchaToken" value="">

            <div class="vnv-request-modal__head">
                <h2 id="vnvRequestModalTitle">Plan your event in seconds</h2> 
            </div>

            <div class="vnv-request-progress">
                <span class="is-active" data-vnv-step-dot="1"></span>
                <span data-vnv-step-dot="2"></span>
                <span data-vnv-step-dot="3"></span>
                <span data-vnv-step-dot="4"></span>
            </div>

            {# STEP 1 #}
            <section class="vnv-request-step is-active" data-vnv-step="1">
                <div class="vnv-request-panel">

                <a class="vnv-request-cta" href="https://maps.app.goo.gl/XE7zewaukQPHUwbFA" target="_blank" rel="noopener noreferrer">
                    <div class="vnv-request-cta__icon">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>
                    <div class="vnv-request-cta__content">
                        <strong>Visit our Sunrise showroom</strong>
                        <p>Preview event ideas, catering direction and production details in person.</p>
                    </div>
                </a>
                    <h3>1) Where is your event?</h3>

                    <div class="vnv-request-grid vnv-request-grid--location">
                        <div>
                            <label class="vnv-request-label" for="vnv_event_address">Full address</label>
                            <input
                                id="vnv_event_address"
                                name="event_address"
                                type="text"
                                class="vnv-request-input"
                                placeholder="e.g., 123 Main St, Miami, FL"
                                required
                            >
                        </div>

                        <div class="vnv-request-map-preview" id="vnvRequestMapPreview">
                            <div class="vnv-request-map-preview__icon">
                                <i class="fa-solid fa-location-dot"></i>
                            </div>
                            <strong>Location preview</strong>
                            <p>Enter the venue address and we’ll use it to prepare your request.</p>
                            <small id="vnvRequestAddressMirror">No address entered yet.</small>
                            <div id="vnvRequestMiniMap" class="vnv-request-mini-map" aria-label="Map preview"></div>
                        </div>
                    </div>

                    <div class="vnv-request-actions vnv-request-actions--end">
                        <button type="button" class="vnv-request-btn vnv-request-btn--primary" data-vnv-next>
                            Next
                        </button>
                    </div>
                </div>
            </section>

            {# STEP 2 #}
            <section class="vnv-request-step" data-vnv-step="2">
                <div class="vnv-request-panel">
                    <h3>2) What services do you need?</h3>

                    <div class="vnv-request-service-group">
                        <h4>Primary Services</h4>
                        <div class="vnv-request-pill-list">
                            <button type="button" class="vnv-request-pill" data-service="Event Planner">Event Planner</button>
                            <button type="button" class="vnv-request-pill" data-service="Event Coordinator">Event Coordinator</button>
                            <button type="button" class="vnv-request-pill" data-service="Venue Rental">Venue Rental</button>
                            <button type="button" class="vnv-request-pill" data-service="Dj and Karaoke Services">Dj and Karaoke Services</button>
                            <button type="button" class="vnv-request-pill" data-service="Flower Decorations & Arrangements">Flower Decorations & Arrangements</button>
                            <button type="button" class="vnv-request-pill" data-service="Wedding Arches">Wedding Arches</button>
                            <button type="button" class="vnv-request-pill" data-service="Balloon Decorations">Balloon Decorations</button>
                            <button type="button" class="vnv-request-pill" data-service="Photo Booth">Photo Booth</button>
                        </div>
                    </div>

                    <div class="vnv-request-service-group">
                        <h4>Catering</h4>
                        <div class="vnv-request-pill-list">
                            <button type="button" class="vnv-request-pill" data-service="Appetizers">Appetizers</button>
                            <button type="button" class="vnv-request-pill" data-service="Brunch Stations">Brunch Stations</button>
                            <button type="button" class="vnv-request-pill" data-service="Crepes Station">Crepes Station</button>
                            <button type="button" class="vnv-request-pill" data-service="Desserts">Desserts</button>
                            <button type="button" class="vnv-request-pill" data-service="Entrées & Sides">Entrées & Sides</button>
                            <button type="button" class="vnv-request-pill" data-service="Paella Station">Paella Station</button>
                            <button type="button" class="vnv-request-pill" data-service="Pasta Station">Pasta Station</button>
                            <button type="button" class="vnv-request-pill" data-service="Pizza Station">Pizza Station</button>
                            <button type="button" class="vnv-request-pill" data-service="Salad Station">Salad Station</button>
                            <button type="button" class="vnv-request-pill" data-service="Taco Station">Taco Station</button>
                            <button type="button" class="vnv-request-pill" data-service="Sushi Boat Packages">Sushi Boat Packages</button>
                            <button type="button" class="vnv-request-pill" data-service="Professional Servers">Professional Servers</button>
                            <button type="button" class="vnv-request-pill" data-service="Bartenders">Bartenders</button>
                        </div>
                    </div>

                    <div class="vnv-request-service-group">
                        <h4>Rentals</h4>
                        <div class="vnv-request-pill-list">
                            <button type="button" class="vnv-request-pill" data-service="Tents">Tents</button>
                            <button type="button" class="vnv-request-pill" data-service="Chairs">Chairs</button>
                            <button type="button" class="vnv-request-pill" data-service="Tables">Tables</button>
                            <button type="button" class="vnv-request-pill" data-service="Linens & Chargers">Linens & Chargers</button>
                            <button type="button" class="vnv-request-pill" data-service="Dance Floor">Dance Floor</button>
                            <button type="button" class="vnv-request-pill" data-service="Chandeliers">Chandeliers</button>
                            <button type="button" class="vnv-request-pill" data-service="Coolers">Coolers</button>
                        </div>
                    </div>

                    <div class="vnv-request-service-group">
                        <h4>Décor, Lighting & Effects</h4>
                        <div class="vnv-request-pill-list">
                            <button type="button" class="vnv-request-pill" data-service="Backdrops & Draping">Backdrops & Draping</button>
                            <button type="button" class="vnv-request-pill" data-service="Balloon Décor">Balloon Décor</button>
                            <button type="button" class="vnv-request-pill" data-service="Welcome Boards & Seating Charts">Welcome Boards & Seating Charts</button>
                            <button type="button" class="vnv-request-pill" data-service="Monogram Projection">Monogram Projection</button>
                            <button type="button" class="vnv-request-pill" data-service="Uplighting">Uplighting</button>
                            <button type="button" class="vnv-request-pill" data-service="Cold Sparks / CO₂ / Confetti Cannons">Cold Sparks / CO₂ / Confetti Cannons</button>
                        </div>
                    </div>

                    <div class="vnv-request-service-group">
                        <h4>Photo & Video</h4>
                        <div class="vnv-request-pill-list">
                            <button type="button" class="vnv-request-pill" data-service="Photography">Photography</button>
                            <button type="button" class="vnv-request-pill" data-service="Videography & Drone">Videography & Drone</button>
                        </div>
                    </div>

                    <div class="vnv-request-selected" id="vnvSelectedServicesPreview">
                        No services selected yet.
                    </div>

                    <div class="vnv-request-actions">
                        <button type="button" class="vnv-request-btn vnv-request-btn--ghost" data-vnv-prev>
                            Back
                        </button>
                        <button type="button" class="vnv-request-btn vnv-request-btn--primary" data-vnv-next>
                            Next
                        </button>
                    </div>
                </div>
            </section>

            {# STEP 3 #}
            <section class="vnv-request-step" data-vnv-step="3">
                <div class="vnv-request-panel">
                    <h3>3) Event details & contact</h3>

                    <div class="vnv-request-grid vnv-request-grid--two">
                        <div>
                            <label class="vnv-request-label" for="vnv_event_date">Date</label>
                            <div class="vnv-request-input-wrap">
                                <i class="fa-regular fa-calendar-days" aria-hidden="true"></i>
                                <input
                                    id="vnv_event_date"
                                    name="event_date"
                                    type="date"
                                    class="vnv-request-input vnv-request-input--with-icon"
                                    required
                                >
                            </div>
                        </div>

                        <div>
                            <label class="vnv-request-label" for="vnv_event_time">Time</label>
                            <div class="vnv-request-input-wrap">
                                <i class="fa-regular fa-clock" aria-hidden="true"></i>
                                <input
                                    id="vnv_event_time"
                                    name="event_time"
                                    type="time"
                                    step="60"
                                    class="vnv-request-input vnv-request-input--with-icon"
                                    required
                                >
                            </div>
                        </div>

                        <div>
                            <label class="vnv-request-label" for="vnv_guest_count">Guest count</label>
                            <input id="vnv_guest_count" name="guest_count" type="number" min="1" class="vnv-request-input" placeholder="e.g., 120">
                        </div>

                        <div>
                            <label class="vnv-request-label" for="vnv_full_name">Full name</label>
                            <input id="vnv_full_name" name="full_name" type="text" class="vnv-request-input" required>
                        </div>

                        <div>
                            <label class="vnv-request-label" for="vnv_email">Email</label>
                            <input id="vnv_email" name="email" type="email" class="vnv-request-input" required>
                        </div>

                        <div>
                            <label class="vnv-request-label" for="vnv_phone">Phone</label>
                            <input
                                id="vnv_phone"
                                name="phone"
                                type="tel"
                                inputmode="numeric"
                                maxlength="14"
                                class="vnv-request-input"
                                placeholder="(305) 555-5555"
                                required
                            >
                        </div>
                    </div>

                    <div>
                        <label class="vnv-request-label" for="vnv_details">Details (optional)</label>
                        <textarea
                            id="vnv_details"
                            name="details"
                            rows="5"
                            class="vnv-request-textarea"
                            placeholder="Tell us any details like theme, timing, venue rules, special ideas, or any promo you saw."
                        ></textarea>
                    </div>

                    <div class="vnv-request-actions">
                        <button type="button" class="vnv-request-btn vnv-request-btn--ghost" data-vnv-prev>
                            Back
                        </button>
                        <button type="button" class="vnv-request-btn vnv-request-btn--primary" data-vnv-next>
                            Next
                        </button>
                    </div>
                </div>
            </section>

            {# STEP 4 #}
            <section class="vnv-request-step" data-vnv-step="4">
                <div class="vnv-request-panel">
                    <h3>4) One more thing before we send it</h3>

                    <div class="vnv-request-step4-copy">
                        <p>
                            We don’t just coordinate services — we design full experiences.
                            If you’d like, you can also visit us for a <strong>complimentary tasting</strong>
                            or explore your event idea in a more immersive way through our <strong>360° studio experience</strong>.
                        </p>
                    </div>

                    <div class="vnv-request-offers">
                        <div class="vnv-request-offer-card">
                            <div class="vnv-request-offer-icon">
                                <i class="fa-solid fa-utensils"></i>
                            </div>
                            <h4>Complimentary Tasting</h4>
                            <p>Visit us and experience the flavor, style and hospitality behind our event concepts.</p>
                        </div>

                        <div class="vnv-request-offer-card">
                            <div class="vnv-request-offer-icon">
                                <i class="fa-solid fa-vr-cardboard"></i>
                            </div>
                            <h4>360° Studio Experience</h4>
                            <p>Preview ideas, demos and production direction in our studio for a more complete vision.</p>
                        </div>
                    </div>

                    <div class="vnv-request-summary">
                        <div>
                            <small>Selected services</small>
                            <strong id="vnvSummaryServices">No services selected yet.</strong>
                        </div>
                        <div>
                            <small>Event address</small>
                            <strong id="vnvSummaryAddress">Not provided yet.</strong>
                        </div>
                    </div>

                    <div class="vnv-request-actions">
                        <button type="button" class="vnv-request-btn vnv-request-btn--ghost" data-vnv-prev>
                            Back
                        </button>
                        <button type="submit" class="vnv-request-btn vnv-request-btn--primary" id="vnvSendRequestBtn">
                            <span class="vnv-send-label">Send Request</span>
                            <span class="vnv-send-loading d-none">
                                <i class="fa-solid fa-spinner fa-spin"></i>
                                Sending...
                            </span>
                        </button>
                    </div>
                </div>
            </section>
        </form>
    </div>
</div>

<style>

.vnv-request-cta{
    display: flex;
    gap: 12px;
    align-items: center;
    text-decoration: none;
    background: linear-gradient(135deg, rgba(51,195,192,0.18), rgba(94,198,196,0.08));
    border: 1px solid rgba(94,198,196,0.22);
    border-radius: 16px;
    padding: 12px 14px;
    margin-bottom: 14px;
    color: #fff;
    box-shadow: 0 10px 26px rgba(0,0,0,0.16);
    transition: transform .18s ease, border-color .18s ease, background .18s ease;
}

.vnv-request-cta:hover{
    transform: translateY(-1px);
    border-color: rgba(94,198,196,0.42);
    background: linear-gradient(135deg, rgba(51,195,192,0.24), rgba(94,198,196,0.12));
}

.vnv-request-cta__icon{
    width: 42px;
    height: 42px;
    border-radius: 14px;
    background: rgba(94,198,196,0.16);
    color: #5EC6C4;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    flex: 0 0 auto;
}

.vnv-request-cta__content strong{
    display: block;
    font-size: .95rem;
    font-weight: 900;
    margin-bottom: 2px;
    letter-spacing: .02em;
}

.vnv-request-cta__content p{
    margin: 0;
    font-size: .82rem;
    line-height: 1.35;
    color: rgba(255,255,255,0.68);
}

/* Mobile tweak */
@media (max-width: 768px){
    .vnv-request-cta{
        align-items: center;
        padding: 11px 12px;
    }

    .vnv-request-cta__icon{
        width: 38px;
        height: 38px;
    }
}

.vnv-request-cta__text{
    font-size: 1.05rem;
    margin: 0 0 6px;
    line-height: 1.4;
}

.vnv-request-cta__text .highlight{
    font-weight: 800;
}

.vnv-request-cta__subtext{
    font-size: 0.95rem;
    margin: 0;
    opacity: 0.9;
}

.vnv-request-cta__experience{
    font-size: 1.15rem;
    font-weight: 900;
    margin-top: 8px;
    letter-spacing: 0.2px;
}

.vnv-request-cta__experience span{
    display: inline-block;
    background: #041019;
    color: #33c3c0;
    padding: 4px 10px;
    border-radius: 999px;
    margin-left: 6px;
}
.vnv-request-modal{
    position: fixed;
    inset: 0;
    z-index: 3000;
    display: none;
}

.vnv-request-modal.is-open{
    display: block;
}

.vnv-request-modal__backdrop{
    position: absolute;
    inset: 0;
    background: rgba(3, 7, 15, 0.72);
    backdrop-filter: blur(8px);
}

.vnv-request-modal__dialog{
    position: relative;
    width: min(1180px, calc(100% - 32px));
    max-height: calc(100vh - 24px);
    margin: 12px auto;
    overflow-y: auto;
    border-radius: 22px;
    background: linear-gradient(180deg, #040814 0%, #08101d 100%);
    border: 1px solid rgba(94, 198, 196, 0.18);
    box-shadow: 0 30px 90px rgba(0,0,0,0.45);
    padding: 28px 28px 34px;
    color: #fff;
    box-sizing: border-box;
}

.vnv-request-modal__dialog::after{
    content: "";
    display: block;
    height: 10px;
}

.vnv-request-modal__brand{
    font-size: 1rem;
    font-weight: 900;
    color: #ffffff;
    margin-bottom: 18px;
}

.vnv-request-modal__close{
    position: absolute;
    top: 18px;
    right: 18px;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.18);
    background: #d93672;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    cursor: pointer;
}

.vnv-request-modal__head{
    text-align: center;
    margin-bottom: 18px;
}

.vnv-request-modal__head h2{
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 800;
    margin: 0 0 8px;
    color: #fff;
}

.vnv-request-modal__head p{
    margin: 0;
    color: rgba(255,255,255,0.72);
    font-size: 1.08rem;
}

.vnv-request-progress{
    display: flex;
    justify-content: center;
    gap: 10px;
    margin: 0 0 28px;
}

.vnv-request-progress span{
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255,255,255,0.18);
    transition: .25s ease;
}

.vnv-request-progress span.is-active{
    background: #33c3c0;
    box-shadow: 0 0 0 6px rgba(51,195,192,0.14);
}

.vnv-request-step{
    display: none;
}

.vnv-request-step.is-active{
    display: block;
}

.vnv-request-panel{
    background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.02));
    border-radius: 20px;
    padding: 22px;
    border: 1px solid rgba(255,255,255,0.05);
}

.vnv-request-panel h3{
    margin: 0 0 20px;
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    font-weight: 800;
    color: #fff;
}

.vnv-request-grid{
    display: grid;
    gap: 16px;
}

.vnv-request-grid--location{
    grid-template-columns: 1fr 1fr;
    align-items: start;
}

.vnv-request-grid--two{
    grid-template-columns: 1fr 1fr;
}

.vnv-request-label{
    display: block;
    margin-bottom: 8px;
    font-weight: 700;
    color: #e8edf8;
}

.vnv-request-input,
.vnv-request-textarea{
    width: 100%;
    border-radius: 14px;
    border: 1px solid rgba(94, 198, 196, 0.16);
    background: rgba(3, 10, 20, 0.9);
    color: #fff;
    padding: 14px 16px;
    outline: none;
    transition: .2s ease;
    box-sizing: border-box;
}

.vnv-request-input::placeholder,
.vnv-request-textarea::placeholder{
    color: rgba(255,255,255,0.35);
}

.vnv-request-input:focus,
.vnv-request-textarea:focus{
    border-color: rgba(94, 198, 196, 0.45);
    box-shadow: 0 0 0 4px rgba(94,198,196,0.08);
}

.vnv-request-map-preview{
    min-height: 260px;
    border-radius: 18px;
    border: 1px solid rgba(94, 198, 196, 0.14);
    background: linear-gradient(180deg, rgba(94,198,196,0.12), rgba(255,255,255,0.03));
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 24px;
    gap: 10px;
}

.vnv-request-map-preview__icon{
    width: 52px;
    height: 52px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(94,198,196,0.14);
    color: #5EC6C4;
    font-size: 1.3rem;
}

.vnv-request-map-preview strong{
    font-size: 1.2rem;
}

.vnv-request-map-preview p,
.vnv-request-map-preview small{
    margin: 0;
    color: rgba(255,255,255,0.72);
}

.vnv-request-mini-map{
    width: 100%;
    height: 158px;
    border-radius: 14px;
    border: 1px solid rgba(94, 198, 196, 0.18);
    background: rgba(2, 12, 24, 0.72);
    margin-top: 8px;
}

.vnv-request-input-wrap{
    position: relative;
}

.vnv-request-input-wrap > i{
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255,255,255,0.72);
    pointer-events: none;
    z-index: 2;
}

.vnv-request-input--with-icon{
    padding-left: 42px;
}

.vnv-request-input[type="date"]::-webkit-calendar-picker-indicator,
.vnv-request-input[type="time"]::-webkit-calendar-picker-indicator{
    filter: invert(1) brightness(1.2);
    opacity: .9;
    cursor: pointer;
}

.vnv-request-input[type="date"]::-webkit-datetime-edit,
.vnv-request-input[type="time"]::-webkit-datetime-edit{
    color: #fff;
}

.pac-container{
    z-index: 5000 !important;
    border-radius: 12px;
    border: 1px solid rgba(94, 198, 196, 0.25);
    box-shadow: 0 16px 40px rgba(0,0,0,0.35);
}

.vnv-request-service-group{
    margin-bottom: 22px;
}

.vnv-request-service-group h4{
    margin: 0 0 10px;
    font-size: 1.25rem;
    color: #dce7ff;
    font-weight: 800;
}

.vnv-request-pill-list{
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.vnv-request-pill{
    border: 1px solid rgba(94, 198, 196, 0.18);
    background: rgba(3, 10, 20, 0.78);
    color: #fff;
    border-radius: 999px;
    padding: 10px 14px;
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
    transition: .2s ease;
}

.vnv-request-pill:hover,
.vnv-request-pill.is-active{
    background: #0f2330;
    border-color: #33c3c0;
    color: #fff;
    box-shadow: 0 8px 18px rgba(0,0,0,0.18);
}

.vnv-request-selected{
    margin-top: 8px;
    padding: 14px 16px;
    border-radius: 14px;
    background: rgba(255,255,255,0.03);
    color: rgba(255,255,255,0.72);
    border: 1px solid rgba(255,255,255,0.05);
}

.vnv-request-step4-copy{
    margin-bottom: 18px;
}

.vnv-request-step4-copy p{
    margin: 0;
    color: rgba(255,255,255,0.78);
    font-size: 1.05rem;
}

.vnv-request-offers{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 20px;
}

.vnv-request-offer-card{
    border-radius: 18px;
    padding: 20px;
    background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.02));
    border: 1px solid rgba(255,255,255,0.05);
}

.vnv-request-offer-icon{
    width: 54px;
    height: 54px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(197,160,89,0.12);
    color: #d8b768;
    font-size: 1.35rem;
    margin-bottom: 12px;
}

.vnv-request-offer-card h4{
    margin: 0 0 8px;
    font-size: 1.15rem;
    color: #fff;
    font-weight: 800;
}

.vnv-request-offer-card p{
    margin: 0;
    color: rgba(255,255,255,0.68);
}

.vnv-request-summary{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 18px;
}

.vnv-request-summary > div{
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 16px;
    padding: 16px;
}

.vnv-request-summary small{
    display: block;
    margin-bottom: 6px;
    color: rgba(255,255,255,0.46);
    text-transform: uppercase;
    letter-spacing: 1.2px;
    font-size: 0.74rem;
}

.vnv-request-summary strong{
    color: #fff;
    font-size: 1rem;
    line-height: 1.4;
}

.vnv-request-actions{
    margin-top: 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
}

.vnv-request-actions--end{
    justify-content: flex-end;
}

.vnv-request-btn{
    border: none;
    border-radius: 14px;
    padding: 14px 24px;
    font-weight: 900;
    font-size: 1rem;
    cursor: pointer;
    transition: .2s ease;
}

.vnv-request-btn--primary{
    background: #33c3c0;
    color: #041019;
}

.vnv-request-btn--primary:hover{
    transform: translateY(-1px);
    filter: brightness(1.04);
}

.vnv-request-btn.is-loading{
    opacity: .85;
    cursor: not-allowed;
}

.vnv-send-loading{
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.d-none{
    display: none !important;
}

.vnv-request-btn--ghost{
    background: rgba(255,255,255,0.06);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.08);
}

.vnv-request-btn--ghost:hover{
    background: rgba(255,255,255,0.1);
}

body.vnv-request-lock{
    overflow: hidden;
}

@media (max-width: 991px){
    .vnv-request-modal__dialog{
        width: min(100% - 18px, 100%);
        padding: 20px 16px calc(120px + env(safe-area-inset-bottom, 0px));
        max-height: calc(100vh - 12px);
        margin: 6px auto;
    }

    .vnv-request-modal__dialog::after{
        height: calc(70px + env(safe-area-inset-bottom, 0px));
    }

    .vnv-request-grid--location,
    .vnv-request-grid--two,
    .vnv-request-offers,
    .vnv-request-summary{
        grid-template-columns: 1fr;
    }

    .vnv-request-panel{
        padding: 18px 16px 26px;
    }

    .vnv-request-actions{
        flex-direction: column;
        align-items: stretch;
        padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    .vnv-request-btn{
        width: 100%;
    }
}
</style>

<script>
(function () {
    const modal = document.getElementById('vnvRequestModal');
    const form = document.getElementById('vnvRequestForm');
    if (!modal || !form) return;

    function normalizeActionUrl() {
        const rawAction = form.getAttribute('action') || '';
        if (!rawAction || !rawAction.startsWith('/api/public/')) return;

        const pathParts = window.location.pathname.split('/').filter(Boolean);
        if (!pathParts.length) return;

        const appBase = pathParts[0];
        if (!appBase || appBase === 'api') return;

        form.setAttribute('action', '/' + appBase + rawAction);
    }

    const openers = document.querySelectorAll('[data-vnv-open-request]');
    const closers = modal.querySelectorAll('[data-vnv-request-close]');
    const steps = Array.from(modal.querySelectorAll('[data-vnv-step]'));
    const dots = Array.from(modal.querySelectorAll('[data-vnv-step-dot]'));
    const nextButtons = modal.querySelectorAll('[data-vnv-next]');
    const prevButtons = modal.querySelectorAll('[data-vnv-prev]');
    const serviceButtons = modal.querySelectorAll('.vnv-request-pill');
    const selectedServicesInput = document.getElementById('vnvSelectedServicesInput');
    const selectedServicesPreview = document.getElementById('vnvSelectedServicesPreview');
    const summaryServices = document.getElementById('vnvSummaryServices');
    const summaryAddress = document.getElementById('vnvSummaryAddress');
    const addressMirror = document.getElementById('vnvRequestAddressMirror');
    const addressInput = document.getElementById('vnv_event_address');
    const sendRequestBtn = document.getElementById('vnvSendRequestBtn');
    const sendLabel = sendRequestBtn ? sendRequestBtn.querySelector('.vnv-send-label') : null;
    const sendLoading = sendRequestBtn ? sendRequestBtn.querySelector('.vnv-send-loading') : null;
    const dateInput = document.getElementById('vnv_event_date');
    const timeInput = document.getElementById('vnv_event_time');
    const phoneInput = document.getElementById('vnv_phone');
    const miniMapEl = document.getElementById('vnvRequestMiniMap');
    const recaptchaTokenInput = document.getElementById('vnvRecaptchaToken');

    const AUTO_OPEN_STORAGE_KEY = 'vnv_request_modal_last_auto_open_at';
    const AUTO_OPEN_HOURS_RAW = Number('{{ env.REQUEST_MODAL_AUTO_OPEN_HOURS|default(24) }}');
    const AUTO_OPEN_HOURS = Number.isFinite(AUTO_OPEN_HOURS_RAW) && AUTO_OPEN_HOURS_RAW > 0
        ? AUTO_OPEN_HOURS_RAW
        : 24;
    const AUTO_OPEN_INTERVAL_MS = AUTO_OPEN_HOURS * 60 * 60 * 1000;

    let currentStep = 1;
    const selectedServices = new Set();
    let requestMap = null;
    let requestMarker = null;
    let requestGeocoder = null;
    let requestAutocomplete = null;
    let lastLatLng = null;
    let vnvRecaptchaSubmitting = false;

    function setFieldError(field, message) {
        if (!field) return false;
        field.setCustomValidity(message || '');
        if (message) field.reportValidity();
        return !message;
    }

    function clearFieldError(field) {
        if (!field) return;
        field.setCustomValidity('');
    }

    function openModal() {
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.classList.add('vnv-request-lock');
        setTimeout(function () {
            ensureMapVisible();
        }, 80);
    }

    function closeModal() {
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('vnv-request-lock');
    }

    function isRootPath() {
        const parts = window.location.pathname.split('/').filter(Boolean);
        if (!parts.length) return true;
        return parts.length === 1;
    }

    function shouldAutoOpenNow() {
        return isRootPath();
    }

    function goToStep(step) {
        currentStep = step;
        steps.forEach((el, index) => {
            el.classList.toggle('is-active', index + 1 === step);
        });
        dots.forEach((dot, index) => {
            dot.classList.toggle('is-active', index + 1 === step);
        });
        if (step === 4) {
            updateSummary();
        }
        if (step === 1) {
            setTimeout(function () {
                ensureMapVisible();
            }, 40);
        }
    }

    function updateSelectedServices() {
        const items = Array.from(selectedServices);
        selectedServicesInput.value = JSON.stringify(items);

        if (!items.length) {
            selectedServicesPreview.textContent = 'No services selected yet.';
            summaryServices.textContent = 'No services selected yet.';
            return;
        }

        const text = items.join(', ');
        selectedServicesPreview.textContent = text;
        summaryServices.textContent = text;
    }

    function updateSummary() {
        const address = addressInput.value.trim();
        summaryAddress.textContent = address || 'Not provided yet.';
        updateSelectedServices();
    }

    function updateMiniMap(latLng) {
        if (!miniMapEl || !window.google || !google.maps) return;
        lastLatLng = latLng;
        if (!requestMap) {
            requestMap = new google.maps.Map(miniMapEl, {
                center: latLng,
                zoom: 15,
                mapTypeControl: false,
                streetViewControl: false,
                fullscreenControl: false
            });
        } else {
            requestMap.setCenter(latLng);
        }
        if (!requestMarker) {
            requestMarker = new google.maps.Marker({
                map: requestMap,
                position: latLng
            });
        } else {
            requestMarker.setPosition(latLng);
        }

        ensureMapVisible();
    }

    function ensureMapVisible() {
        if (!requestMap || !window.google || !google.maps) return;
        google.maps.event.trigger(requestMap, 'resize');
        if (lastLatLng) {
            requestMap.setCenter(lastLatLng);
            if (requestMarker) {
                requestMarker.setPosition(lastLatLng);
            }
        }
    }

    function initLocationTools() {
        if (!addressInput || !miniMapEl || !window.google || !google.maps || !google.maps.places) return false;

        requestGeocoder = new google.maps.Geocoder();
        updateMiniMap({ lat: 25.7617, lng: -80.1918 });

        requestAutocomplete = new google.maps.places.Autocomplete(addressInput, {
            fields: ['formatted_address', 'geometry', 'name'],
            types: ['geocode']
        });

        requestAutocomplete.addListener('place_changed', function () {
            const place = requestAutocomplete.getPlace();
            if (!place || !place.geometry || !place.geometry.location) return;
            if (place.formatted_address) {
                addressInput.value = place.formatted_address;
            }
            const chosenAddress = addressInput.value.trim();
            if (addressMirror) addressMirror.textContent = chosenAddress || 'No address entered yet.';
            updateMiniMap(place.geometry.location);
            setTimeout(function () {
                ensureMapVisible();
            }, 60);
            updateSummary();
        });

        return true;
    }

    function geocodeTypedAddress() {
        if (!requestGeocoder || !addressInput || !addressInput.value.trim()) return;
        const address = addressInput.value.trim();
        requestGeocoder.geocode({ address: address }, function (results, status) {
            if (status === 'OK' && results && results[0] && results[0].geometry && results[0].geometry.location) {
                updateMiniMap(results[0].geometry.location);
            }
        });
    }

    function waitForGoogleAndInit(maxAttempts = 20) {
        let attempts = 0;
        const timer = setInterval(function () {
            attempts += 1;
            if (initLocationTools()) {
                clearInterval(timer);
                return;
            }
            if (attempts >= maxAttempts) {
                clearInterval(timer);
            }
        }, 350);
    }

    function formatPhoneNumber(value) {
        const digits = (value || '').replace(/\D/g, '').slice(0, 10);

        if (digits.length === 0) return '';
        if (digits.length < 4) return '(' + digits;
        if (digits.length < 7) return '(' + digits.slice(0, 3) + ') ' + digits.slice(3);
        return '(' + digits.slice(0, 3) + ') ' + digits.slice(3, 6) + '-' + digits.slice(6, 10);
    }

    function validateDateField() {
        if (!dateInput || !dateInput.value.trim()) {
            return setFieldError(dateInput, 'Date is required.');
        }

        const selected = new Date(dateInput.value + 'T00:00:00');
        const now = new Date();
        const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());

        if (Number.isNaN(selected.getTime())) {
            return setFieldError(dateInput, 'Please enter a valid date.');
        }

        if (selected < today) {
            return setFieldError(dateInput, 'Event date cannot be in the past.');
        }

        return setFieldError(dateInput, '');
    }

    function validateTimeField() {
        if (!timeInput) return true;

        const value = timeInput.value.trim();
        if (!value) {
            return setFieldError(timeInput, 'Time is required.');
        }

        if (timeInput.validity && timeInput.validity.badInput) {
            return setFieldError(timeInput, 'Please enter a valid time.');
        }

        const parts = value.split(':');
        if (parts.length < 2) {
            return setFieldError(timeInput, 'Please enter a valid time.');
        }

        const hours = parseInt(parts[0], 10);
        const minutes = parseInt(parts[1], 10);

        if (
            Number.isNaN(hours) ||
            Number.isNaN(minutes) ||
            hours < 0 ||
            hours > 23 ||
            minutes < 0 ||
            minutes > 59
        ) {
            return setFieldError(timeInput, 'Please enter a valid time.');
        }

        return setFieldError(timeInput, '');
    }

    function validatePhoneField() {
        if (!phoneInput || !phoneInput.value.trim()) {
            return setFieldError(phoneInput, 'Phone is required.');
        }

        const digits = phoneInput.value.replace(/\D/g, '');
        if (digits.length !== 10) {
            return setFieldError(phoneInput, 'Please enter a valid phone number.');
        }

        return setFieldError(phoneInput, '');
    }

    function validateStep(step) {
        if (step === 1) {
            if (!addressInput.value.trim()) {
                addressInput.focus();
                return false;
            }
        }

        if (step === 2) {
            if (!selectedServices.size) {
                selectedServicesPreview.textContent = 'Please select at least one service.';
                selectedServicesPreview.style.color = '#ffb9b9';
                return false;
            } else {
                selectedServicesPreview.style.color = 'rgba(255,255,255,0.72)';
            }
        }

        if (step === 3) {
            const requiredIds = ['vnv_event_date', 'vnv_event_time', 'vnv_full_name', 'vnv_email', 'vnv_phone'];
            for (const id of requiredIds) {
                const field = document.getElementById(id);
                if (field && !field.value.trim()) {
                    field.focus();
                    return false;
                }
            }

            if (!validateDateField()) return false;
            if (!validateTimeField()) return false;
            if (!validatePhoneField()) return false;
        }

        return true;
    }

    function setSubmitLoading(loading) {
        if (sendRequestBtn) {
            sendRequestBtn.disabled = !!loading;
            sendRequestBtn.classList.toggle('is-loading', !!loading);
        }
        if (sendLabel) sendLabel.classList.toggle('d-none', !!loading);
        if (sendLoading) sendLoading.classList.toggle('d-none', !loading);
    }

    function getRecaptchaToken() {
        return new Promise(function(resolve, reject) {
            const siteKey = '{{ env.RECAPTCHA_SITE_KEY|default('') }}';

            if (!siteKey) {
                resolve('');
                return;
            }

            function executeRecaptcha() {
                if (!window.grecaptcha || typeof window.grecaptcha.ready !== 'function') {
                    reject(new Error('grecaptcha_not_available'));
                    return;
                }

                window.grecaptcha.ready(function() {
                    window.grecaptcha.execute(siteKey, { action: 'public_event_request' })
                        .then(function(token) {
                            resolve(token || '');
                        })
                        .catch(function(error) {
                            reject(error);
                        });
                });
            }

            if (window.grecaptcha && typeof window.grecaptcha.ready === 'function') {
                executeRecaptcha();
                return;
            }

            const existingScript = document.querySelector('script[data-vnv-recaptcha]');
            if (existingScript) {
                existingScript.addEventListener('load', executeRecaptcha, { once: true });
                existingScript.addEventListener('error', function () {
                    reject(new Error('grecaptcha_load_failed'));
                }, { once: true });
                return;
            }

            const script = document.createElement('script');
            script.src = 'https://www.google.com/recaptcha/api.js?render=' + encodeURIComponent(siteKey);
            script.async = true;
            script.defer = true;
            script.setAttribute('data-vnv-recaptcha', '1');
            script.addEventListener('load', executeRecaptcha, { once: true });
            script.addEventListener('error', function () {
                reject(new Error('grecaptcha_load_failed'));
            }, { once: true });
            document.head.appendChild(script);
        });
    }

    openers.forEach(btn => {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            openModal();
        });
    });

    closers.forEach(btn => {
        btn.addEventListener('click', closeModal);
    });

    modal.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeModal();
    });

    nextButtons.forEach(btn => {
        btn.addEventListener('click', function () {
            if (!validateStep(currentStep)) return;
            if (currentStep < 4) goToStep(currentStep + 1);
        });
    });

    prevButtons.forEach(btn => {
        btn.addEventListener('click', function () {
            if (currentStep > 1) goToStep(currentStep - 1);
        });
    });

    serviceButtons.forEach(btn => {
        btn.addEventListener('click', function () {
            const value = this.getAttribute('data-service');
            if (!value) return;

            if (selectedServices.has(value)) {
                selectedServices.delete(value);
                this.classList.remove('is-active');
            } else {
                selectedServices.add(value);
                this.classList.add('is-active');
            }

            updateSelectedServices();
        });
    });

    if (addressInput && addressMirror) {
        addressInput.addEventListener('input', function () {
            const value = this.value.trim();
            addressMirror.textContent = value || 'No address entered yet.';
        });
        addressInput.addEventListener('blur', geocodeTypedAddress);
    }

    if (dateInput) {
        dateInput.addEventListener('input', function () {
            clearFieldError(dateInput);
        });
        dateInput.addEventListener('change', validateDateField);
    }

    if (timeInput) {
        timeInput.addEventListener('input', function () {
            clearFieldError(timeInput);
        });
        timeInput.addEventListener('change', validateTimeField);
        timeInput.addEventListener('blur', validateTimeField);
    }

    if (phoneInput) {
        phoneInput.addEventListener('input', function () {
            const start = this.selectionStart || 0;
            const oldLength = this.value.length;
            this.value = formatPhoneNumber(this.value);
            clearFieldError(phoneInput);

            const newLength = this.value.length;
            const newPos = start + (newLength - oldLength);
            try {
                this.setSelectionRange(newPos, newPos);
            } catch (e) {}
        });

        phoneInput.addEventListener('blur', function () {
            this.value = formatPhoneNumber(this.value);
            validatePhoneField();
        });
    }

    form.addEventListener('submit', function (e) {
        updateSummary();

        if (!validateStep(3)) {
            e.preventDefault();
            goToStep(3);
            return;
        }

        if (vnvRecaptchaSubmitting) {
            return;
        }

        const siteKey = '{{ env.RECAPTCHA_SITE_KEY|default('') }}';
        if (!siteKey) {
            return;
        }

        e.preventDefault();
        setSubmitLoading(true);

        getRecaptchaToken()
            .then(function(token) {
                if (recaptchaTokenInput) {
                    recaptchaTokenInput.value = token;
                }
                vnvRecaptchaSubmitting = true;
                form.submit();
            })
            .catch(function() {
                setSubmitLoading(false);
                alert('Security verification failed. Please try again.');
            });
    });

    normalizeActionUrl();
    waitForGoogleAndInit();
    goToStep(1);

    
})();
</script>
