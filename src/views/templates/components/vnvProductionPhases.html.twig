<section class="vp-commercial vp-method" id="production-process" aria-labelledby="production-method-title">
  <div class="vp-commercial__inner">
    <h2 id="production-method-title">{{ heading|default('Five phases from brief to recap') }}</h2>
    <p>{{ intro|default('The same five phases guide every production. We tailor the tasks, documents and people responsible to your event.') }}</p>
    <ol class="vp-phase-list">
      {% for phase in phases %}<li><h3>{{ phase.name }}</h3><p>{{ phase.summary }}</p></li>{% endfor %}
    </ol>
  </div>
</section>
