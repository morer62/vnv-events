{% extends 'templates/base.admin.twig' %}

{% set status = proposal.status|default('NOT_STARTED') %}
{% set status_labels = {
    'NOT_STARTED': 'Not started',
    'DRAFT': 'Ready for client approval',
    'PENDING_APPROVAL': 'Client approval pending',
    'APPROVED': 'Approved and signed',
    'CHANGES_REQUESTED': 'Changes requested'
} %}
{% set has_details = proposal and proposal.current_revision_id %}
{% set status_display = has_details ? status_labels[status]|default(status) : 'No details yet' %}

{% block style %}
<style>
    .proposal-shell { max-width: 1120px; margin: 0 auto; }
    .proposal-header { display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; flex-wrap:wrap; }
    .proposal-status { display:inline-flex; align-items:center; min-height:38px; padding:.45rem .8rem; border-radius:999px; font-weight:700; background:#e9f1f4; color:#17384a; }
    .proposal-status--approved { background:#dff5e8; color:#11633b; }
    .proposal-status--pending { background:#fff0c9; color:#805b00; }
    .proposal-status--changes { background:#ffe3e3; color:#8c2727; }
    .proposal-card { border:1px solid #dbe3e8; border-radius:18px; background:#fff; box-shadow:0 12px 32px rgba(19,45,60,.07); overflow:hidden; }
    .proposal-toolbar { display:flex; gap:.4rem; flex-wrap:wrap; padding:.75rem; border-bottom:1px solid #dbe3e8; background:#f5f8fa; position:sticky; top:0; z-index:2; }
    .proposal-toolbar button, .proposal-toolbar select, .proposal-toolbar label { min-height:42px; }
    .proposal-editor, .proposal-document { min-height:520px; padding:clamp(1.25rem, 4vw, 3.5rem); font:17px/1.65 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color:#17242c; outline:none; }
    .proposal-editor:empty::before { content:'Write the proposal or menu here…'; color:#8a98a2; }
    .proposal-editor h2, .proposal-document h2 { font-size:1.9rem; margin:1.4rem 0 .7rem; }
    .proposal-editor h3, .proposal-document h3 { font-size:1.35rem; margin:1.2rem 0 .55rem; }
    .proposal-editor p, .proposal-document p { margin:0 0 1rem; }
    .proposal-editor small, .proposal-document small { display:block; color:#5f6f78; font-size:.82em; line-height:1.55; }
    .proposal-editor ul, .proposal-editor ol, .proposal-document ul, .proposal-document ol { padding-left:1.7rem; margin:0 0 1rem; }
    .proposal-editor img, .proposal-document img { display:block; max-width:100%; height:auto; margin:1rem auto; border-radius:12px; }
    .proposal-page-break { border-top:2px dashed #8ca3af; margin:2rem 0; height:0; position:relative; page-break-after:always; break-after:page; }
    .proposal-editor .proposal-page-break::after { content:'Page break'; position:absolute; top:-.8rem; left:50%; transform:translateX(-50%); background:#fff; color:#647780; padding:0 .65rem; font-size:.78rem; }
    .proposal-actions { display:flex; align-items:end; gap:.75rem; flex-wrap:wrap; padding:1rem; border-top:1px solid #dbe3e8; background:#fbfcfd; }
    .proposal-actions .form-group { flex:1 1 260px; }
    .proposal-signature-card { border:1px solid #cfe5e2; border-radius:16px; background:#f4fbfa; padding:1.25rem; }
    .proposal-signature-preview { min-height:130px; border:2px dashed #8aa7b1; border-radius:14px; background:#fff; display:flex; align-items:center; justify-content:center; padding:1rem; text-align:center; overflow:hidden; }
    .proposal-signature-preview__typed { font-family:'Brush Script MT','Segoe Script',cursive; font-size:clamp(2.2rem,7vw,3.4rem); line-height:1.1; color:#17384a; overflow-wrap:anywhere; }
    .proposal-signature-preview__image { display:block; max-width:100%; max-height:150px; object-fit:contain; }
    .proposal-signature-preview__placeholder { color:#7a8b94; font-style:italic; }
    .proposal-alert { border-radius:14px; padding:1rem; background:#f1f6f8; border:1px solid #d7e3e8; }
    @media (max-width: 767px) {
        .proposal-editor, .proposal-document { min-height:380px; padding:1rem; font-size:16px; }
        .proposal-toolbar { position:static; }
        .proposal-toolbar .btn { padding:.45rem .65rem; }
        .proposal-actions > * { width:100%; }
    }
    @media print {
        .proposal-toolbar, .proposal-actions, .proposal-screen-only, nav, aside, header { display:none !important; }
        .proposal-card { border:0; box-shadow:none; }
        .proposal-document { padding:0; }
        .proposal-page-break { border:0; page-break-after:always; }
    }
</style>
{% endblock %}

{% block body %}
<div class="proposal-shell">
    <nav aria-label="breadcrumb" class="mb-3 proposal-screen-only">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ team_mode ? path('panel/planner-hub/team/my-work') : (manager_mode ? path('panel/planner-hub/management/orders/orders') : path('panel/planner-hub/orders/orders')) }}">{{ team_mode ? 'My Work' : 'Orders' }}</a></li>
            <li class="breadcrumb-item active">Menu / Proposal</li>
        </ol>
    </nav>

    <div class="proposal-header mb-4">
        <div>
            <div class="text-uppercase small fw-bold text-primary mb-1">Order VNV-341{{ order.id }}</div>
            <h1 class="h2 mb-2">Proposal – {{ manager_mode ? 'View / Edit proposal / menu' : (team_mode ? 'Event menu / proposal' : 'Review proposal / menu') }}</h1>
            <div class="text-muted">Event {{ order.event_date|date('F j, Y') }}{% if guest_count %} · {{ guest_count }} guests{% endif %}{% if manager_mode %} · Internal version {{ proposal.revision_number|default('—') }}{% endif %}</div>
        </div>
        <span class="proposal-status {{ status == 'APPROVED' ? 'proposal-status--approved' : (status in ['DRAFT', 'PENDING_APPROVAL'] and has_details ? 'proposal-status--pending' : (status == 'CHANGES_REQUESTED' ? 'proposal-status--changes' : '')) }}">
            {{ status_display }}
        </span>
    </div>

    {% if manager_mode %}
        <section class="proposal-card mb-3 proposal-screen-only" aria-labelledby="proposalClientLinkTitle">
            <div class="p-3 p-md-4">
                <h2 class="h5 mb-2" id="proposalClientLinkTitle">Client proposal link</h2>
                <p class="text-muted mb-3">Open or copy this secure link whenever you need to send the proposal manually. The client does not need to log in.</p>
                <div class="input-group">
                    <input id="proposalClientLink" class="form-control" type="text" value="{{ client_access_url }}" readonly aria-label="Secure client proposal link">
                    <button class="btn btn-outline-primary" type="button" id="copyProposalClientLink">Copy link</button>
                    <a class="btn btn-outline-secondary" href="{{ client_access_url }}" target="_blank" rel="noopener">Open</a>
                </div>
                <div id="proposalCopyStatus" class="small text-success mt-2" role="status" aria-live="polite"></div>
            </div>
        </section>
        {% if status == 'APPROVED' %}
            <div class="proposal-alert mb-3"><strong>This revision is locked.</strong> Reopen the approval with a reason before making a change. The replacement will become the only active client version.</div>
        {% elseif not has_details %}
            <div class="proposal-alert mb-3"><strong>No details yet.</strong> Add the menu or proposal below, save the first revision, and then send the secure client link for signature.</div>
        {% endif %}
        <form method="post" id="proposalEditorForm" class="proposal-card" enctype="multipart/form-data">
            <input type="hidden" name="id_order" value="{{ order.id }}">
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
            <input type="hidden" name="action" value="save_draft">
            <input type="hidden" name="content_html" id="proposalContentInput">
            <div class="px-3 pt-3 pb-2 bg-light border-bottom small text-muted">Select text—or place the cursor on a line—then choose Large title, Medium title, Paragraph, Bold, Italic, or a list format.</div>
            <div class="proposal-toolbar" role="toolbar" aria-label="Proposal formatting tools">
                <select id="proposalBlockFormat" class="form-select form-select-sm w-auto" aria-label="Text style" {{ status == 'APPROVED' ? 'disabled' : '' }}>
                    <option value="p">Paragraph</option>
                    <option value="h2">Large title</option>
                    <option value="h3">Medium title</option>
                </select>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-command="bold" {{ status == 'APPROVED' ? 'disabled' : '' }}><strong>Bold</strong></button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-command="italic" {{ status == 'APPROVED' ? 'disabled' : '' }}><em>Italic</em></button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-command="insertUnorderedList" {{ status == 'APPROVED' ? 'disabled' : '' }}>• Bullets</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-command="insertOrderedList" {{ status == 'APPROVED' ? 'disabled' : '' }}>1. List</button>
                <label class="btn btn-sm btn-outline-primary mb-0 {{ status == 'APPROVED' ? 'disabled' : '' }}">
                    Insert image <input type="file" id="proposalImageInput" accept="image/jpeg,image/png,image/webp" hidden {{ status == 'APPROVED' ? 'disabled' : '' }}>
                </label>
                <button type="button" class="btn btn-sm btn-outline-primary" id="proposalPageBreak" {{ status == 'APPROVED' ? 'disabled' : '' }}>Page break</button>
                <button type="button" class="btn btn-sm btn-outline-warning" data-proposal-disclaimer="food" {{ status == 'APPROVED' ? 'disabled' : '' }}>+ Food station disclaimer</button>
                <button type="button" class="btn btn-sm btn-outline-warning" data-proposal-disclaimer="decor" {{ status == 'APPROVED' ? 'disabled' : '' }}>+ Décor &amp; setup disclaimer</button>
                <span id="proposalUploadStatus" class="small align-self-center" role="status" aria-live="polite"></span>
            </div>
            <div id="proposalEditor" class="proposal-editor" contenteditable="{{ status == 'APPROVED' ? 'false' : 'true' }}" role="textbox" aria-multiline="true" aria-label="Proposal content">{{ proposal.content_html|default('')|raw }}</div>
            {% if status != 'APPROVED' %}
                <div class="proposal-actions">
                    <div class="form-group">
                        <label for="proposalChangeNote" class="form-label">Revision note <span class="text-muted">(optional)</span></label>
                        <input id="proposalChangeNote" name="change_note" class="form-control" maxlength="500" placeholder="What changed in this revision?">
                    </div>
                    <button type="submit" class="btn btn-primary">Save and request client approval</button>
                </div>
            {% endif %}
        </form>
    {% elseif team_mode %}
        {% if not has_details %}
            <div class="proposal-alert"><strong>No details yet.</strong> The event menu / proposal has not been prepared.</div>
        {% else %}
            <article class="proposal-card">
                <div class="proposal-document">{{ proposal.content_html|raw }}</div>
            </article>
        {% endif %}
    {% else %}
        {% if not proposal or not proposal.current_revision_id or status == 'CHANGES_REQUESTED' %}
            <div class="proposal-alert"><strong>No details yet.</strong> The event team is preparing your menu / proposal. You will be notified when it is ready to review.</div>
        {% else %}
            <article class="proposal-card">
                <div class="proposal-document">{{ proposal.content_html|raw }}</div>
            </article>
        {% endif %}

        {% if status in ['DRAFT', 'PENDING_APPROVAL'] %}
            <form method="post" enctype="multipart/form-data" class="proposal-signature-card mt-4" id="proposalApprovalForm">
                <input type="hidden" name="id_order" value="{{ order.id }}">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <input type="hidden" name="action" value="approve">
                <input type="hidden" name="user_local_timestamp" id="proposalLocalTimestamp">
                <h2 class="h5">Approve and sign this proposal</h2>
                <p class="text-muted">Your signature creates a dated PDF copy of the approved menu / proposal.</p>
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label" for="typedInitials">Type your signature or initials</label><input id="typedInitials" name="typed_initials" class="form-control" maxlength="30" autocomplete="off" placeholder="Your name or initials"></div>
                    <div class="col-md-6"><label class="form-label" for="signatureImage">Or upload signature image</label><input id="signatureImage" type="file" name="signature_image" class="form-control" accept="image/jpeg,image/png,image/webp"></div>
                </div>
                <div class="mt-3">
                    <label class="form-label fw-bold">Signature preview</label>
                    <div class="proposal-signature-preview" id="proposalSignaturePreview" aria-live="polite">
                        <span class="proposal-signature-preview__placeholder" id="proposalSignaturePlaceholder">Your signature will appear here.</span>
                        <span class="proposal-signature-preview__typed d-none" id="proposalTypedSignature"></span>
                        <img class="proposal-signature-preview__image d-none" id="proposalImageSignature" alt="Uploaded signature preview">
                    </div>
                    <div class="small text-muted mt-2" id="proposalSignatureMethod">Type a signature or choose an image before signing.</div>
                </div>
                <button class="btn btn-success mt-3" id="proposalSignButton" disabled>Approve and sign proposal</button>
            </form>
        {% endif %}
    {% endif %}

    {% if status == 'APPROVED' %}
        <section class="proposal-signature-card mt-4">
            <h2 class="h5">Approved proposal</h2>
            {% if proposal.current_signed_pdf_path %}
                <p><a href="{{ proposal.current_signed_pdf_path }}" target="_blank" rel="noopener" class="btn btn-outline-success">Open current signed PDF</a></p>
            {% endif %}
            {% if team_mode %}
                <p class="mb-0">This is the current approved and signed menu / proposal.</p>
            {% else %}
                <p>This proposal is signed and locked. If a correction is needed, reopen it below and publish the replacement for a new signature.</p>
                <form method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="id_order" value="{{ order.id }}">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="action" value="revoke">
                    <div class="col-md-9"><label class="form-label" for="revokeReason">Reason for reopening <span class="text-danger">required</span></label><input id="revokeReason" name="reason" class="form-control" required minlength="5" maxlength="500"></div>
                    <div class="col-md-3"><button class="btn btn-outline-danger w-100">Reopen approval</button></div>
                </form>
            {% endif %}
        </section>
    {% endif %}

</div>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script>
(() => {
    const editor = document.getElementById('proposalEditor');
    const form = document.getElementById('proposalEditorForm');
    const contentInput = document.getElementById('proposalContentInput');
    const format = document.getElementById('proposalBlockFormat');
    if (editor && editor.contentEditable === 'true') {
        let savedSelection = null;
        const rememberSelection = () => {
            const selection = window.getSelection();
            if (selection?.rangeCount && editor.contains(selection.anchorNode)) {
                savedSelection = selection.getRangeAt(0).cloneRange();
            }
        };
        const restoreSelection = () => {
            editor.focus();
            if (!savedSelection) return;
            const selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(savedSelection);
        };
        ['keyup', 'mouseup', 'input', 'focus'].forEach(eventName => editor.addEventListener(eventName, rememberSelection));
        document.querySelectorAll('[data-command]').forEach(button => {
            button.addEventListener('mousedown', event => event.preventDefault());
            button.addEventListener('click', () => {
                restoreSelection();
                document.execCommand(button.dataset.command, false);
                rememberSelection();
            });
        });
        format?.addEventListener('mousedown', rememberSelection);
        format?.addEventListener('change', () => {
            restoreSelection();
            document.execCommand('formatBlock', false, format.value);
            rememberSelection();
        });
        document.getElementById('proposalPageBreak')?.addEventListener('click', () => {
            editor.focus();
            document.execCommand('insertHTML', false, '<div class="proposal-page-break" data-page-break="true" contenteditable="false"></div><p><br></p>');
        });
        const disclaimerTexts = {
            food: 'Colors and decorative elements are for reference purposes only. VNV Events may adapt its selection based on availability while making every effort to maintain the event’s visual harmony.',
            decor: 'The setup will aim to match the approved design as closely as possible. Slight variations in proportions, layout, and details may occur due to venue conditions, terrain, weather, or other external factors.'
        };
        document.querySelectorAll('[data-proposal-disclaimer]').forEach(button => button.addEventListener('click', () => {
            const text = disclaimerTexts[button.dataset.proposalDisclaimer];
            if (!text) return;
            const paragraph = document.createElement('p');
            const small = document.createElement('small');
            small.textContent = text;
            paragraph.appendChild(small);
            editor.appendChild(paragraph);
            const nextParagraph = document.createElement('p');
            nextParagraph.appendChild(document.createElement('br'));
            editor.appendChild(nextParagraph);
            editor.focus();
            const selection = window.getSelection();
            const range = document.createRange();
            range.selectNodeContents(nextParagraph);
            range.collapse(true);
            selection.removeAllRanges();
            selection.addRange(range);
            document.getElementById('proposalUploadStatus').textContent = 'Editable disclaimer inserted.';
        }));
        form?.addEventListener('submit', () => { contentInput.value = editor.innerHTML; });

        const imageInput = document.getElementById('proposalImageInput');
        const uploadStatus = document.getElementById('proposalUploadStatus');
        imageInput?.addEventListener('change', async () => {
            const file = imageInput.files?.[0]; if (!file) return;
            uploadStatus.textContent = 'Uploading…';
            const payload = new FormData();
            payload.append('id_order', '{{ order.id }}'); payload.append('csrf_token', '{{ csrf_token|e('js') }}');
            payload.append('action', 'upload_image'); payload.append('proposal_image', file);
            try {
                const response = await fetch(window.location.href, {method:'POST', body:payload, credentials:'same-origin'});
                const result = await response.json();
                if (!response.ok || !result.ok) throw new Error(result.error || 'Upload failed');
                editor.focus(); document.execCommand('insertHTML', false, `<figure><img src="${result.url}" alt="Proposal image"><figcaption>Proposal image</figcaption></figure><p><br></p>`);
                uploadStatus.textContent = 'Image inserted.';
            } catch (error) { uploadStatus.textContent = error.message; }
            imageInput.value = '';
        });
    }
    const timestamp = document.getElementById('proposalLocalTimestamp');
    if (timestamp) timestamp.value = new Date().toISOString().slice(0, 19).replace('T', ' ');

    const typedSignature = document.getElementById('typedInitials');
    const signatureFile = document.getElementById('signatureImage');
    const typedPreview = document.getElementById('proposalTypedSignature');
    const imagePreview = document.getElementById('proposalImageSignature');
    const signaturePlaceholder = document.getElementById('proposalSignaturePlaceholder');
    const signatureMethod = document.getElementById('proposalSignatureMethod');
    const signButton = document.getElementById('proposalSignButton');
    const updateSignaturePreview = () => {
        const typedValue = typedSignature?.value.trim() || '';
        const file = signatureFile?.files?.[0] || null;
        if (file && imagePreview) {
            const reader = new FileReader();
            reader.addEventListener('load', () => {
                imagePreview.src = String(reader.result || '');
                imagePreview.classList.remove('d-none');
                typedPreview?.classList.add('d-none');
                signaturePlaceholder?.classList.add('d-none');
            });
            reader.readAsDataURL(file);
            if (signatureMethod) signatureMethod.textContent = 'The uploaded image will be used as your signature.';
        } else if (typedValue && typedPreview) {
            typedPreview.textContent = typedValue;
            typedPreview.classList.remove('d-none');
            imagePreview?.classList.add('d-none');
            imagePreview?.removeAttribute('src');
            signaturePlaceholder?.classList.add('d-none');
            if (signatureMethod) signatureMethod.textContent = 'The handwritten-style preview above will be used as your signature.';
        } else {
            typedPreview?.classList.add('d-none');
            imagePreview?.classList.add('d-none');
            imagePreview?.removeAttribute('src');
            signaturePlaceholder?.classList.remove('d-none');
            if (signatureMethod) signatureMethod.textContent = 'Type a signature or choose an image before signing.';
        }
        if (signButton) signButton.disabled = !typedValue && !file;
    };
    typedSignature?.addEventListener('input', updateSignaturePreview);
    signatureFile?.addEventListener('change', updateSignaturePreview);
    updateSignaturePreview();

    const copyButton = document.getElementById('copyProposalClientLink');
    const clientLink = document.getElementById('proposalClientLink');
    const copyStatus = document.getElementById('proposalCopyStatus');
    copyButton?.addEventListener('click', async () => {
        if (!clientLink) return;
        try {
            await navigator.clipboard.writeText(clientLink.value);
            copyStatus.textContent = 'Link copied. You can now send it to the client.';
        } catch (error) {
            clientLink.focus(); clientLink.select();
            document.execCommand('copy');
            copyStatus.textContent = 'Link copied. You can now send it to the client.';
        }
    });
})();
</script>
{% endblock %}
