<details class="my-3 px-3" id="directCoordinatorEntry" data-target="{{ target }}">
    <summary class="fw-semibold">Add a separate Day Coordinator fee</summary>
    <p class="small text-muted mt-2">Use the amount agreed with the coordinator. This line is for the client’s records. Keep it out of the planner or production fee and check that the order and its suborders have no billable charge for the same work.</p>
    <label class="form-label" for="directCoordinatorAmount">Payable directly to the Day Coordinator (USD)</label>
    <div class="d-flex flex-wrap gap-2">
        <input type="text" inputmode="decimal" class="form-control w-auto" id="directCoordinatorAmount" autocomplete="off">
        <button class="btn btn-outline-secondary" type="button" id="addDirectCoordinatorLine">Insert line</button>
    </div>
    <p class="small mb-0 mt-1" id="directCoordinatorStatus" role="status" aria-live="polite"></p>
</details>
<script>
(() => {
    const entry = document.getElementById('directCoordinatorEntry');
    const target = document.getElementById(entry.dataset.target);
    const input = document.getElementById('directCoordinatorAmount');
    const status = document.getElementById('directCoordinatorStatus');
    const currency = new Intl.NumberFormat('en-US', {style: 'currency', currency: 'USD'});
    document.getElementById('addDirectCoordinatorLine').addEventListener('click', () => {
        const raw = input.value.trim();
        if (!/^(?:\d+|\d{1,3}(?:,\d{3})+)(?:\.\d{1,2})?$/.test(raw)) {
            status.textContent = 'Enter the agreed amount in USD, with up to two decimal places.';
            input.focus();
            return;
        }
        const amount = Number(raw.replace(/,/g, ''));
        if (amount <= 0 || !Number.isSafeInteger(Math.round(amount * 100))) {
            status.textContent = 'Enter a positive amount.';
            input.focus();
            return;
        }
        const paymentTerms = ' payable directly to the coordinator. Amount due to VNV for this service is $0.00.';
        const line = 'Day Coordinator — ' + currency.format(amount) + paymentTerms;
        const isNotes = target instanceof HTMLTextAreaElement;
        const current = isNotes ? target.value : target.textContent;
        if (current.includes(paymentTerms)) {
            status.textContent = 'The document already has a direct coordinator fee. Edit that line to change the amount.';
            return;
        }
        if (isNotes) {
            target.value += (target.value && !target.value.endsWith('\n') ? '\n' : '') + line;
        } else {
            const paragraph = document.createElement('p');
            paragraph.textContent = line;
            target.appendChild(paragraph);
        }
        target.dispatchEvent(new Event('input', {bubbles: true}));
        input.value = '';
        status.textContent = 'Line inserted. Review the document and save your changes.';
    });
})();
</script>
