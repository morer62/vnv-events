<section class="vp-commercial vp-pricing" id="production-fees" aria-labelledby="production-fees-title">
  <div class="vp-commercial__inner">
    <h2 id="production-fees-title">{{ heading|default(activation|default(false) ? 'How brand engagements are priced' : 'Choose your level of production') }}</h2>
    <div class="vp-rate-list">
      {% for key in keys %}
        {% set item = services[key] %}
        <article class="vp-rate">
          <div>
            <h3>{{ key == 'brand-activation' ? 'Standalone Brand Activation' : item.name }}</h3>
            <p>{{ item.summary }}</p>
            {% if key != 'sponsorship-opportunities' %}
              <p>On-site coordination is booked separately as <a href="{{ path('product/' ~ services['day-coordinator'].product_slug) }}">Day Coordinator</a>.</p>
            {% endif %}
          </div>
          <div class="vp-rate__action"><strong>{{ item.price }}</strong>
            <a href="{{ path('') }}?request_service={{ item.request_service }}#vnvRequestModal" data-vnv-open-request data-vnv-request-service="{{ item.request_service }}">Request {{ key == 'sponsorship-opportunities' ? 'availability' : 'a proposal' }}<span class="visually-hidden"> for {{ item.name }}</span> <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      {% endfor %}
    </div>
    {% if activation|default(false) %}
      <p class="vp-commercial__note"><strong>Producing your own event?</strong> When VNV produces your event, your activation is included in the production fee. {{ services['production-essential'].name }} is {{ services['production-essential'].price }}, {{ services['full-event-production'].name }} is {{ services['full-event-production'].price }} and {{ services['full-event-production-plus'].name }} is {{ services['full-event-production-plus'].price }}. <a href="{{ path('event-production') }}#production-fees">Compare all production levels</a>.</p>
    {% elseif show_activation_note is not defined or show_activation_note %}
      <p class="vp-commercial__note">Brand activation is included when VNV produces your event. For a booth or activation at another organizer’s event, see <a href="{{ path('sponsor-activation-production') }}#production-fees">standalone brand activation pricing</a>.</p>
    {% endif %}
    <details class="vp-terms">
      <summary>What's included in the production fee?</summary>
      <p>{{ fee_includes }}</p>
      <p>{{ direct_costs }} {% if activation|default(false) %}Sponsorship rights are a separate agreement with the event organizer.{% endif %}</p>
    </details>
  </div>
</section>
