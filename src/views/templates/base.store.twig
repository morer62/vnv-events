{% extends "templates/base.twig" %}
{% set skip_base_app_css = true %}
{% set skip_base_bootstrap_css = true %}
{% set skip_public_bootstrap_js = true %}
{% set skip_public_google_maps = true %}
{% set skip_public_stripe = true %}
{% set show_whatsapp = false %}

{% block meta_keywords %}food delivery South Florida, party trays, Latin catering trays, hallacas, Nochebuena dinner, Thanksgiving dinner to go, family dinners, VNV Gourmet To Go{% endblock %}
{% block head %}<meta name="subject" content="Chef-prepared Latin food, party boxes and family trays for delivery or pickup"><meta name="category" content="Food Delivery, Party Trays, Latin Food, Holiday Dinners">{% block store_head %}{% endblock %}{% endblock %}
{% block styles %}
<style>
:root{--store-ink:#17201d;--store-green:#173f35;--store-mint:#63c9c5;--store-gold:#d8aa4f;--store-cream:#fbf6ed;--store-line:#dfd4c0;--store-white:#fff}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--store-cream);color:var(--store-ink);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.store-header{position:sticky;top:0;z-index:50;background:rgba(251,246,237,.96);border-bottom:1px solid var(--store-line);backdrop-filter:blur(14px)}.store-header__inner{width:min(1180px,calc(100% - 32px));min-height:76px;margin:auto;display:flex;align-items:center;gap:24px}.store-brand{display:flex;align-items:center;color:var(--store-ink);text-decoration:none}.store-brand img{display:block;width:210px;height:58px;object-fit:contain;object-position:left center}.store-nav{display:flex;gap:20px;margin-left:auto}.store-nav a,.store-footer a{color:inherit;text-decoration:none}.store-nav a{font-size:.87rem;font-weight:800}.store-tools{display:flex;align-items:center;gap:9px}.store-pill{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:0 16px;border-radius:999px;background:var(--store-green);color:#fff!important;text-decoration:none;font-weight:850}.store-cart{background:#fff;color:var(--store-green)!important;border:1px solid var(--store-line)}.store-footer{background:#10241f;color:#f9f4e9;padding:46px 0 22px}.store-footer__grid{width:min(1180px,calc(100% - 32px));margin:auto;display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:36px}.store-footer h2,.store-footer h3{margin-top:0}.store-footer p,.store-footer li{color:rgba(255,255,255,.76);line-height:1.7}.store-footer ul{padding:0;list-style:none}.store-footer__bottom{width:min(1180px,calc(100% - 32px));margin:30px auto 0;padding-top:20px;border-top:1px solid rgba(255,255,255,.15);font-size:.85rem;color:rgba(255,255,255,.68)}@media(max-width:880px){.store-nav{display:none}.store-header__inner{gap:8px}.store-brand img{width:155px;height:52px}.store-tools{margin-left:auto}.store-tools .store-wa{display:none}.store-footer__grid{grid-template-columns:1fr}.store-pill{padding:0 12px}}
</style>
{% block store_styles %}{% endblock %}
{% endblock %}
{% block body %}
<header class="store-header"><div class="store-header__inner"><a class="store-brand" href="{{ path('gourmet-to-go') }}" aria-label="VNV Gourmet To Go home"><img src="{{ path('assets/images/vnv-gourmet-to-go-logo.png') }}" alt="VNV Gourmet To Go" width="210" height="58"></a><nav class="store-nav" aria-label="Store menu"><a href="{{ path('gourmet-to-go') }}#holidays">Holidays</a><a href="{{ path('gourmet-to-go') }}#party-boxes">Party Boxes</a><a href="{{ path('gourmet-to-go') }}#family-dinners">Family Occasion Meals</a><a href="{{ path('gourmet-to-go') }}#desserts">Desserts</a></nav><div class="store-tools"><a class="store-pill store-wa" href="https://wa.me/13053761210?text=Hi%21%20I%27d%20like%20to%20order%20from%20VNV%20Gourmet%20To%20Go" target="_blank" rel="noopener">WhatsApp</a><a class="store-pill store-cart" href="{{ path('store/cart') }}" aria-label="Open cart">Cart{% if cart_count|default(0) %} ({{ cart_count }}){% endif %}</a></div></div></header>
{% block store_body %}{% endblock %}
<footer class="store-footer"><div class="store-footer__grid"><section><h2>VNV Gourmet To Go</h2><p>Chef-prepared Latin favorites and family-style trays, delivered or ready for pickup.</p><p><a href="tel:+13052045427">(305) 204-5427</a><br><a href="mailto:info@vnvevents.com">info@vnvevents.com</a></p></section><section><h3>Delivery & pickup</h3><ul>{% for zone in delivery_zones|default([]) %}<li>{{ zone.zone_name }}</li>{% endfor %}{% if not delivery_zones|default([])|length %}<li>South Florida service area</li>{% endif %}<li>{{ gourmet_settings.pickup_address_1|default('10258 NW 47th St') }}, {{ gourmet_settings.pickup_city|default('Sunrise') }}, FL {{ gourmet_settings.pickup_zip|default('33351') }}</li></ul></section><section><h3>Information</h3><ul><li><a href="{{ path('gourmet-to-go') }}#delivery">Delivery & pickup</a></li><li><a href="{{ path('gourmet-to-go') }}#faq">FAQ</a></li><li><a href="{{ path('terms-and-conditions') }}">Terms</a></li></ul></section></div><div class="store-footer__bottom">Planning a bigger event with staff and setup? <a href="{{ path('') }}">VNV Events full-service →</a></div></footer>
<script>(function(){const keys=['utm_source','utm_medium','utm_campaign','utm_term','utm_content','fbclid'];const q=new URLSearchParams(location.search),saved=JSON.parse(localStorage.getItem('vnv_store_attribution')||'{}');let changed=false;keys.forEach(k=>{if(q.get(k)){saved[k]=q.get(k);changed=true}});if(changed){saved.landing_page=location.pathname;saved.captured_at=new Date().toISOString();localStorage.setItem('vnv_store_attribution',JSON.stringify(saved))}})();</script>
{% endblock %}
