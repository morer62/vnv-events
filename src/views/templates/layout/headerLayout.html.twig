<nav class="navbar navbar-expand navbar-light navbar-bg">
  <a class="sidebar-toggle js-sidebar-toggle"><i class="hamburger align-self-center"></i></a>

  <div class="navbar-collapse collapse">
    <ul class="navbar-nav navbar-align">

      <li class="nav-item dropdown">
        <a class="nav-icon dropdown-toggle" href="#" id="alertsDropdown" data-bs-toggle="dropdown">
          <div class="position-relative">
            <i class="align-middle" data-feather="bell"></i>
            {% if notifications_count > 0 %}
              <span class="indicator">{{ notifications_count }}</span>
            {% endif %}
          </div>
        </a>
        
        <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end py-0" aria-labelledby="alertsDropdown">
          {% if notifications|length > 0 %}
            <div class="dropdown-menu-header">{{ notifications_count }} New Notification{% if notifications_count != 1 %}s{% endif %}</div>
            <div class="list-group">
              {% for notification in notifications %}
                <a href="{{ notification.link }}" class="list-group-item notification-item" data-notification-id="{{ notification.id }}">
                  <div class="row g-0 align-items-center">
                    <div class="col-2">
                      <i class="text-primary" data-feather="bell"></i>
                    </div>
                    <div class="col-10">
                      <div class="text-dark">{{ notification.mensaje }}</div>
                      <div class="text-muted small mt-1">{{ notification.timestamp|date('M j, g:i A') }}</div>
                    </div>
                  </div>
                </a>
              {% endfor %}
            </div>
            <div class="dropdown-menu-footer">
              <a href="{{ path('panel/notifications') }}" class="text-muted">Show all notifications</a>
            </div>
          {% else %}
            <div class="dropdown-menu-header">No New Notifications</div>
            <div class="list-group">
              <div class="list-group-item text-center text-muted py-3">
                <i data-feather="check-circle" class="text-success mb-2"></i>
                <div>You're all caught up!</div>
              </div>
            </div>
            <div class="dropdown-menu-footer">
              <a href="{{ path('panel/notifications') }}" class="text-muted">View all notifications</a>
            </div>
          {% endif %}
        </div>
      </li>

      <script>
        document.addEventListener('DOMContentLoaded', function() {
          // Limitar el handler solo a enlaces del dropdown, no a tarjetas de la lista
          const notificationItems = document.querySelectorAll('.dropdown-menu .notification-item, a.notification-item');
          
          notificationItems.forEach(item => {
            item.addEventListener('click', function(e) {
              e.preventDefault(); // Prevenir la navegación inmediata
              
              const notificationId = this.getAttribute('data-notification-id');
              const notificationLink = this.getAttribute('href');
              
              if (notificationId) {
                // Marcar como leída y luego redirigir
                markNotificationAsReadAndRedirect(notificationId, notificationLink);
              } else {
                // Si no hay ID, navegar normalmente
                window.location.href = notificationLink;
              }
            });
          });
        });

        function getMarkReadRoute() {
          // Detectar el nivel actual basado en la URL
          const currentPath = window.location.pathname;
          
          // Obtener la URL base del proyecto
          const baseUrl = '{{ app_url ?? "http://localhost/vnv-venue" }}';
          
          if (currentPath.includes('/level1/')) {
            return baseUrl + '/panel/level1/notifications/mark-read';
          } else if (currentPath.includes('/level2/')) {
            return baseUrl + '/panel/level2/notifications/mark-read';
          } else if (currentPath.includes('/level3/')) {
            return baseUrl + '/panel/level3/notifications/mark-read';
          } else if (currentPath.includes('/level4/')) {
            return baseUrl + '/panel/level4/notifications/mark-read';
          } else if (currentPath.includes('/level5/')) {
            return baseUrl + '/panel/level5/notifications/mark-read';
          } else {
            // Ruta por defecto
            return baseUrl + '/panel/notifications/mark-read';
          }
        }

        function markNotificationAsReadAndRedirect(notificationId, redirectUrl) {
          // Obtener la ruta correcta según el nivel
          let route = getMarkReadRoute();

          fetch(route, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ notification_id: notificationId })
          })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              // Ocultar inmediatamente la notificación del dropdown
              const notificationElement = document.querySelector(`[data-notification-id="${notificationId}"]`);
              if (notificationElement) {
                notificationElement.style.display = 'none';
              }
              
              // Actualizar el contador en el header
              updateHeaderNotificationCount();
              
              // Si no quedan notificaciones visibles, actualizar el contenido del dropdown
              updateDropdownContent();
              
              // Redirigir inmediatamente después de marcar como leída
              if (redirectUrl) {
                window.location.href = redirectUrl;
              }
            } else {
              // Si falla marcar como leída, aún así redirigir
              if (redirectUrl) {
                window.location.href = redirectUrl;
              }
            }
          })
          .catch(error => {
            console.error('Error marking notification as read:', error);
            // Si hay error, aún así redirigir
            if (redirectUrl) {
              window.location.href = redirectUrl;
            }
          });
        }

        function markNotificationAsRead(notificationId) {
          // Obtener la ruta correcta según el nivel
          let route = getMarkReadRoute();

          fetch(route, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ notification_id: notificationId })
          })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              // Ocultar inmediatamente la notificación del dropdown
              const notificationElement = document.querySelector(`[data-notification-id="${notificationId}"]`);
              if (notificationElement) {
                notificationElement.style.display = 'none';
              }
              
              // Actualizar el contador en el header
              updateHeaderNotificationCount();
              
              // Si no quedan notificaciones visibles, actualizar el contenido del dropdown
              updateDropdownContent();
            }
          })
          .catch(error => {
            console.error('Error marking notification as read:', error);
          });
        }

        function updateHeaderNotificationCount() {
          const indicator = document.querySelector('#alertsDropdown .indicator');
          if (indicator) {
            const currentCount = parseInt(indicator.textContent) || 0;
            if (currentCount > 0) {
              indicator.textContent = currentCount - 1;
              if (currentCount - 1 === 0) {
                indicator.style.display = 'none';
              }
            }
          }
        }

        function updateDropdownContent() {
          // Contar notificaciones visibles
          const visibleNotifications = document.querySelectorAll('.notification-item:not([style*="display: none"])');
          const dropdownHeader = document.querySelector('.dropdown-menu-header');
          const listGroup = document.querySelector('.dropdown-menu .list-group');
          
          if (visibleNotifications.length === 0) {
            // No quedan notificaciones, mostrar mensaje de "no notifications"
            if (dropdownHeader) {
              dropdownHeader.textContent = 'No New Notifications';
            }
            if (listGroup) {
              listGroup.innerHTML = `
                <div class="list-group-item text-center text-muted py-3">
                  <i data-feather="check-circle" class="text-success mb-2"></i>
                  <div>You're all caught up!</div>
                </div>
              `;
              // Re-inicializar los iconos de feather
              if (typeof feather !== 'undefined') {
                feather.replace();
              }
            }
          } else {
            // Actualizar el contador en el header
            if (dropdownHeader) {
              dropdownHeader.textContent = `${visibleNotifications.length} New Notification${visibleNotifications.length !== 1 ? 's' : ''}`;
            }
          }
        }
      </script>

      <li class="nav-item dropdown">
        <a class="nav-icon dropdown-toggle" href="#" id="chatUnreadDropdown" data-bs-toggle="dropdown" title="{{ trans('messages_hub.unread_messages') }}">
          <div class="position-relative">
            <i class="align-middle" data-feather="message-circle"></i>
            {% if chat_unread_count|default(0) > 0 %}
              <span class="indicator" data-chat-unread-indicator>{{ chat_unread_count }}</span>
            {% else %}
              <span class="indicator" data-chat-unread-indicator style="display:none;">0</span>
            {% endif %}
          </div>
        </a>

        <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end py-0" aria-labelledby="chatUnreadDropdown" data-chat-unread-menu>
          <div class="dropdown-menu-header" data-chat-unread-header>
            {% if chat_unread_count|default(0) > 0 %}
              {{ chat_unread_count }} {{ trans('messages_hub.unread_messages') }}
            {% else %}
              {{ trans('messages_hub.no_unread_messages') }}
            {% endif %}
          </div>
          <div class="list-group" data-chat-unread-list>
            {% if chat_unread_threads|default([])|length > 0 %}
              {% for unreadThread in chat_unread_threads %}
                <a href="{{ path(chat_unread_base_route ~ '?thread=' ~ unreadThread.id) }}" class="list-group-item chat-unread-item" data-chat-thread-id="{{ unreadThread.id }}">
                  <div class="row g-0 align-items-center">
                    <div class="col-2"><i class="text-success" data-feather="message-circle"></i></div>
                    <div class="col-10">
                      <div class="text-dark fw-bold">{{ trans('messages_hub.new_unread_message') }}</div>
                      <div class="text-dark small">{{ trans('messages_hub.unread_from') }} {{ unreadThread.partner_name ?: unreadThread.partner_email ?: (trans('messages_hub.user_fallback') ~ ' ' ~ unreadThread.partner_id) }}</div>
                      {% if unreadThread.last_unread_message %}
                        <div class="text-muted small mt-1">{{ unreadThread.last_unread_message|slice(0, 70) }}{% if unreadThread.last_unread_message|length > 70 %}...{% endif %}</div>
                      {% endif %}
                    </div>
                  </div>
                </a>
              {% endfor %}
            {% else %}
              <div class="list-group-item text-center text-muted py-3" data-chat-unread-empty>
                <i data-feather="check-circle" class="text-success mb-2"></i>
                <div>{{ trans('messages_hub.no_unread_messages') }}</div>
              </div>
            {% endif %}
          </div>
          <div class="dropdown-menu-footer">
            <a href="{{ path(chat_unread_base_route|default('panel/planner-hub/team/chat')) }}" class="text-muted">{{ trans('messages_hub.open_conversation') }}</a>
          </div>
        </div>
      </li>

      <script>
        document.addEventListener('DOMContentLoaded', function () {
          const list = document.querySelector('[data-chat-unread-list]');
          const header = document.querySelector('[data-chat-unread-header]');
          const indicator = document.querySelector('[data-chat-unread-indicator]');
          if (!list || !header || !indicator) return;

          const labels = {
            unreadMessages: '{{ trans('messages_hub.unread_messages')|e('js') }}',
            noUnreadMessages: '{{ trans('messages_hub.no_unread_messages')|e('js') }}',
            newUnreadMessage: '{{ trans('messages_hub.new_unread_message')|e('js') }}',
            unreadFrom: '{{ trans('messages_hub.unread_from')|e('js') }}',
            userFallback: '{{ trans('messages_hub.user_fallback')|e('js') }}'
          };

          function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>'"]/g, function (char) {
              return {'&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;'}[char];
            });
          }

          function renderUnreadThreads(threads) {
            const count = Array.isArray(threads) ? threads.length : 0;
            indicator.textContent = String(count);
            indicator.style.display = count > 0 ? '' : 'none';
            header.textContent = count > 0 ? `${count} ${labels.unreadMessages}` : labels.noUnreadMessages;

            if (count === 0) {
              list.innerHTML = `<div class="list-group-item text-center text-muted py-3" data-chat-unread-empty><i data-feather="check-circle" class="text-success mb-2"></i><div>${escapeHtml(labels.noUnreadMessages)}</div></div>`;
              if (typeof feather !== 'undefined') feather.replace();
              return;
            }

            list.innerHTML = threads.map(function (thread) {
              const partner = thread.partner_name || thread.partner_email || `${labels.userFallback} ${thread.partner_id}`;
              const rawPreview = String(thread.last_unread_message || '');
              const preview = rawPreview ? `<div class="text-muted small mt-1">${escapeHtml(rawPreview.slice(0, 70))}${rawPreview.length > 70 ? '...' : ''}</div>` : '';
              return `<a href="${escapeHtml(thread.link)}" class="list-group-item chat-unread-item" data-chat-thread-id="${escapeHtml(thread.id)}"><div class="row g-0 align-items-center"><div class="col-2"><i class="text-success" data-feather="message-circle"></i></div><div class="col-10"><div class="text-dark fw-bold">${escapeHtml(labels.newUnreadMessage)}</div><div class="text-dark small">${escapeHtml(labels.unreadFrom)} ${escapeHtml(partner)}</div>${preview}</div></div></a>`;
            }).join('');
            if (typeof feather !== 'undefined') feather.replace();
          }

          async function refreshChatUnread() {
            try {
              const response = await fetch('{{ path('api/chat/unread') }}', {
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json', 'Cache-Control': 'no-cache' }
              });
              if (!response.ok) return;
              const data = await response.json();
              if (data && data.success) renderUnreadThreads(data.data || []);
            } catch (error) {}
          }

          window.addEventListener('focus', refreshChatUnread);
          window.setInterval(refreshChatUnread, 20000);
        });
      </script>

      {% if not isMobileApp|default(false) %}
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle d-inline-flex align-items-center" href="#" data-bs-toggle="dropdown" aria-label="Account menu">
            <img src="{{ asset_for('template/img/avatars/profile.png') }}" class="avatar img-fluid rounded me-1" alt="Account" />
            <span class="text-dark d-none d-sm-inline">{{ user.email }}</span>
          </a>
          <div class="dropdown-menu dropdown-menu-end">
            {#<div class="dropdown-divider"></div>#}
            <a class="dropdown-item" href="{{ path('logout') }}">Log out</a>
          </div>
        </li>
      {% endif %}

    </ul>
  </div>
</nav>

{% if isMobileApp|default(false) %}
  <style>
    a[href$="/logout"],
    a[href*="/logout?"],
    a[href$="/vnv-events/logout"],
    a[href*="/vnv-events/logout?"] {
      display: none !important;
    }
  </style>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('a[href]').forEach(function (link) {
        const href = link.getAttribute('href') || '';
        if (/\/logout(?:$|[?#])/.test(href)) {
          const item = link.closest('.nav-item.dropdown') || link;
          item.style.display = 'none';
          item.setAttribute('aria-hidden', 'true');
        }
      });
    });
  </script>
{% endif %}
