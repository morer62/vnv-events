<style>
/* =========================
   NEW PUBLIC HEADER - VNVX
========================= */

.vnvx-header{
    position: sticky;
    top: 0;
    z-index: 1400;
    width: 100%;
    background: rgba(255,255,255,0.88);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(17,24,26,0.08);
}

.vnvx-header__wrap{
    max-width: 1320px;
}

.vnvx-header__row{
    min-height: 84px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
}

.vnvx-header__nav{
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
}

.vnvx-header__nav a{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 16px;
    border-radius: 999px;
    text-decoration: none;
    color: #11181a;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    transition: all .22s ease;
}

.vnvx-header__nav a:hover{
    background: rgba(17,24,26,0.06);
    color: #000;
}

.vnvx-header__right{
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
}

.vnvx-header__socials{
    display: flex;
    align-items: center;
    gap: 10px;
}

.vnvx-header__socials a{
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #11181a;
    background: rgba(17,24,26,0.05);
    border: 1px solid rgba(17,24,26,0.08);
    transition: all .22s ease;
}

.vnvx-header__socials a:hover{
    transform: translateY(-2px);
    background: #fff;
    color: #000;
}

.vnvx-header__cta{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 18px;
    border-radius: 999px;
    text-decoration: none;
    background: linear-gradient(135deg, #e3c06c 0%, #cfa24b 100%);
    color: #11181a;
    font-size: .82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: 0 14px 28px rgba(207,162,75,0.22);
    transition: all .22s ease;
}

.vnvx-header__cta:hover{
    transform: translateY(-2px);
    color: #000;
}

.vnvx-header__toggle{
    display: none;
    width: 48px;
    height: 48px;
    border: 1px solid rgba(17,24,26,0.10);
    background: #fff;
    border-radius: 14px;
    padding: 0;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;
    box-shadow: 0 10px 22px rgba(0,0,0,0.06);
}

.vnvx-header__toggle span{
    width: 20px;
    height: 2px;
    border-radius: 999px;
    background: #11181a;
    transition: all .22s ease;
}

.vnvx-header__toggle.is-active span:nth-child(1){
    transform: translateY(7px) rotate(45deg);
}

.vnvx-header__toggle.is-active span:nth-child(2){
    opacity: 0;
}

.vnvx-header__toggle.is-active span:nth-child(3){
    transform: translateY(-7px) rotate(-45deg);
}

.vnvx-mobile{
    display: none;
    width: 100%;
    background: rgba(255,255,255,0.96);
    border-top: 1px solid rgba(17,24,26,0.08);
}

.vnvx-mobile.is-open{
    display: block;
}

.vnvx-mobile__content{
    padding: 18px 0 26px;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.vnvx-mobile__content > a{
    text-decoration: none;
    color: #11181a;
    font-weight: 800;
    padding: 14px 0;
    border-bottom: 1px solid rgba(17,24,26,0.08);
}

.vnvx-mobile__meta{
    padding-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.vnvx-mobile__meta a{
    text-decoration: none;
    color: #475254;
    font-weight: 600;
}

.vnvx-mobile__socials{
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 14px;
}

.vnvx-mobile__socials a{
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    background: #11181a;
    color: #fff;
}

.vnvx-mobile-appbar{
    display: none;
}

.vnvx-mobile-header-offset{
    display: none;
}

.vnvx-mobile-appbar__menu,
.vnvx-mobile-appbar__call,
.vnvx-mobile-appbar__request{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    text-decoration: none;
    font-weight: 900;
    line-height: 1;
    white-space: nowrap;
}

.vnvx-mobile-appbar__menu{
    width: 46px;
    height: 46px;
    border-radius: 16px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(94,234,212,0.18);
    flex-direction: column;
    gap: 5px;
}

.vnvx-mobile-appbar__menu span{
    width: 19px;
    height: 2px;
    border-radius: 999px;
    background: #5eead4;
    transition: all .22s ease;
}

.vnvx-mobile-appbar__menu.is-active span:nth-child(1){
    transform: translateY(7px) rotate(45deg);
}

.vnvx-mobile-appbar__menu.is-active span:nth-child(2){
    opacity: 0;
}

.vnvx-mobile-appbar__menu.is-active span:nth-child(3){
    transform: translateY(-7px) rotate(-45deg);
}

.vnvx-mobile-appbar__call{
    min-height: 46px;
    padding: 0 14px;
    border-radius: 16px;
    color: #d7fff7;
    background: rgba(255,255,255,0.075);
    border: 1px solid rgba(255,255,255,0.08);
    gap: 7px;
    font-size: .78rem;
}

.vnvx-mobile-appbar__request{
    min-height: 46px;
    padding: 0 15px;
    border-radius: 16px;
    color: #061211;
    background: linear-gradient(135deg, #5eead4 0%, #2dd4bf 100%);
    box-shadow: 0 14px 30px rgba(45,212,191,0.22);
    font-size: .78rem;
}

/* Tablet / laptop */
@media (max-width: 1100px){
    .vnvx-header__nav a{
        padding: 10px 12px;
        font-size: 0.9rem;
    }

    .vnvx-header__socials{
        display: none;
    }
}

/* Mobile */
@media (max-width: 860px){
    .vnvx-header{
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        background: rgba(18,21,25,0.88);
        backdrop-filter: blur(22px);
        border-bottom: 1px solid rgba(94,234,212,0.16);
        box-shadow: 0 18px 40px rgba(0,0,0,0.28);
    }

    .vnvx-header__wrap{
        max-width: none;
        padding-left: max(12px, env(safe-area-inset-left));
        padding-right: max(12px, env(safe-area-inset-right));
    }

    .vnvx-header__row{
        min-height: calc(68px + env(safe-area-inset-top));
        padding-top: env(safe-area-inset-top);
        justify-content: center;
    }

    .vnvx-header__nav{
        display: none;
    }

    .vnvx-header__right{
        display: none;
    }

    .vnvx-header__cta{
        display: none;
    }

    .vnvx-mobile-appbar{
        display: grid;
        grid-template-columns: 46px minmax(0, 1fr) minmax(0, 1.05fr);
        align-items: center;
        gap: 9px;
        width: 100%;
    }

    .vnvx-mobile{
        background: rgba(18,21,25,0.96);
        border-top: 1px solid rgba(94,234,212,0.13);
        box-shadow: 0 22px 44px rgba(0,0,0,0.34);
    }

    .vnvx-mobile__content{
        padding: 14px max(4px, env(safe-area-inset-left)) 22px;
    }

    .vnvx-mobile__content > a{
        color: rgba(255,255,255,0.86);
        border-bottom-color: rgba(255,255,255,0.08);
    }

    .vnvx-mobile__meta a{
        color: #5eead4;
    }

    .vnvx-mobile__socials a{
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.08);
        color: #fff;
    }

    .vnvx-mobile-header-offset{
        display: block;
        height: calc(68px + env(safe-area-inset-top));
    }
}
</style>
 
