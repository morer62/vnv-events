                <a href="#"  data-vnv-open-request class="vnvx-header__cta">New Request</a>

                <button class="vnvx-header__toggle" type="button" aria-label="Open menu" data-vnvx-toggle>
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>
    </div>

    <div class="vnvx-mobile" data-vnvx-panel>
        <div class="container">
            <div class="vnvx-mobile__content">
                <a href="{{ path('/') }}">Home</a>
                <a href="{{ path('/#services') }}">Services</a>
                <a href="{{ path('/#why-vnv') }}">Why VNV</a>
                <a href="{{ path('/#podcast') }}">Sessions</a>
                <a href="{{ path('/#instagram-feed') }}">Gallery</a>
                <a href="{{ path('/store-categories') }}" >Services & Pricing</a>

                <div class="vnvx-mobile__meta">
                    <a href="tel:+13052045427">+1 305-204-5427</a>
                    <a href="mailto:info@vnvevents.com">info@vnvevents.com</a>
                </div>

                <div class="vnvx-mobile__socials">
                    <a href="https://www.instagram.com/vnv_events/" target="_blank" rel="noopener" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                    <a href="https://www.youtube.com/" target="_blank" rel="noopener" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                    <a href="https://www.facebook.com/" target="_blank" rel="noopener" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="https://www.tiktok.com/" target="_blank" rel="noopener" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a>
                    <a href="https://www.linkedin.com/" target="_blank" rel="noopener" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                    <a href="https://www.pinterest.com/" target="_blank" rel="noopener" aria-label="Pinterest"><i class="fa-brands fa-pinterest-p"></i></a>
