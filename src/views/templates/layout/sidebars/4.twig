<li class="sidebar-header">{{ trans('ui.my_dashboard') }}</li>

{% set canOrders = user.hasPermissionForModule('orders') %}
{% set canPayroll = user.hasPermissionForModule('payroll') %}
{% set canCrm = user.hasPermissionForModule('crm') %}
{% set canStorage = user.hasPermissionForModule('storage') %}
{% set canUsers = user.hasPermissionForModule('users') %}
{% set canManagement = canOrders or canCrm or canStorage or canUsers %}

<li class="sidebar-item">
    <a class="sidebar-link" href="{{ path('panel/planner-hub') }}">
        <i class="align-middle" data-feather="grid"></i>
        <span class="align-middle">{{ trans('level4_access_center.sidebar_access_center') }}</span>
    </a>
</li>

<li class="sidebar-item">
    <a class="sidebar-link" href="{{ path('panel/home') }}">
