<li class="sidebar-header">{{ trans('ui.my_dashboard') }}</li>

{% set canOrders = user.hasPermissionForModule('orders') %}
{% set canCrm = user.hasPermissionForModule('crm') %}
{% set canStorage = user.hasPermissionForModule('storage') %}
{% set canUsers = user.hasPermissionForModule('users') %}
{% set canManagement = canOrders or canCrm or canStorage or canUsers %}

<li class="sidebar-item">
    <a class="sidebar-link" href="{{ path('panel/home') }}">
        <i class="align-middle" data-feather="briefcase"></i>
        <span class="align-middle">Team Home</span>
    </a>
</li>

<li class="sidebar-header">{{ trans('ui.my_work') }}</li>

<li class="sidebar-item">
    <a class="sidebar-link" href="{{ path('panel/planner-hub/team/orders/orders/') }}">
        <i class="align-middle" data-feather="calendar"></i>
        <span class="align-middle">{{ trans('ui.assigned_orders') }}</span>
    </a>
</li>

<li class="sidebar-item">
    <a class="sidebar-link" href="{{ path('panel/planner-hub/team/my-work') }}">
        <i class="align-middle" data-feather="check-square"></i>
        <span class="align-middle">{{ trans('ui.my_work') }}</span>
    </a>
</li>

<li class="sidebar-item">
    <a class="sidebar-link" href="{{ path('panel/planner-hub/team/chat') }}">
        <i class="align-middle" data-feather="message-circle"></i>
        <span class="align-middle">{{ trans('ui.team_chat') }}</span>
    </a>
</li>

<li class="sidebar-item">
    <a class="sidebar-link" href="{{ path('panel/planner-hub/team/contracts') }}">
        <i class="align-middle" data-feather="file-text"></i>
        <span class="align-middle">{{ trans('ui.my_contract') }}</span>
    </a>
</li>
<li class="sidebar-item">
    <a class="sidebar-link" href="{{ path('panel/manager-availability') }}">
        <i class="align-middle" data-feather="calendar"></i>
        <span class="align-middle">My Availability</span>
    </a>
</li>

<li class="sidebar-header">{{ trans('ui.time') }}</li>

<li class="sidebar-item">
    <a class="sidebar-link" href="{{ path('panel/planner-hub/team/payroll/clock') }}">
        <i class="align-middle" data-feather="clock"></i>
        <span class="align-middle">Clock In / Out</span>
    </a>
</li>

{% if canManagement %}
<li class="sidebar-header">{{ trans('level4_access_center.sidebar_approved_tools') }}</li>
{% endif %}

{% if canOrders %}
<li class="sidebar-item">
    <a class="sidebar-link" href="{{ path('panel/planner-hub/management/orders') }}">
        <i class="align-middle" data-feather="briefcase"></i>
        <span class="align-middle">{{ trans('ui.orders') }}</span>
    </a>
</li>
{% endif %}

{% if canCrm %}
<li class="sidebar-item">
    <a class="sidebar-link" href="{{ path('panel/planner-hub/management/crm') }}">
        <i class="align-middle" data-feather="users"></i>
        <span class="align-middle">{{ trans('ui.crm') }}</span>
    </a>
</li>
{% endif %}

{% if canStorage %}
<li class="sidebar-item">
    <a class="sidebar-link" href="{{ path('panel/planner-hub/management/storage') }}">
        <i class="align-middle" data-feather="box"></i>
        <span class="align-middle">{{ trans('ui.inventory_storage') }}</span>
    </a>
</li>
{% endif %}

{% if canUsers %}
<li class="sidebar-item">
    <a class="sidebar-link" href="{{ path('panel/planner-hub/management/users') }}">
        <i class="align-middle" data-feather="user-check"></i>
        <span class="align-middle">{{ trans('ui.team') }}</span>
    </a>
</li>
{% endif %}

<li class="sidebar-header">{{ trans('ui.account') }}</li>

<li class="sidebar-item">
    <a class="sidebar-link" href="{{ path('panel/settings') }}">
        <i class="align-middle" data-feather="user"></i>
        <span class="align-middle">{{ trans('ui.profile') }}</span>
    </a>
</li>

<li class="sidebar-item">
    <form method="post" action="{{ path('panel/home') }}" class="m-0">
        <input type="hidden" name="level" value="5">
        <button type="submit" class="sidebar-link border-0 w-100 text-start" style="background: transparent;">
            <i class="align-middle" data-feather="user"></i>
            <span class="align-middle">Client View</span>
        </button>
    </form>
</li>
