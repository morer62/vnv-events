    </a>
</li>

<li class="sidebar-header">{{ trans('ui.my_work') }}</li>

<li class="sidebar-item">
    <a class="sidebar-link" href="{{ path(canOrders ? 'panel/planner-hub/team/orders/orders/' : 'panel/planner-hub/no-access?module=orders') }}">
