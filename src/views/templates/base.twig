    {% set site_name = 'VNV Events' %}
    {% set site_url = 'https://vnvevents.com' %}
    {% set site_phone_display = '+1 (305) 204-5427' %}
    {% set site_phone_raw = '+13052045427' %}
    {% set site_email = 'info@vnvevents.com' %}
    {% set site_logo = asset_for('assets/images/planner-hub-logo-negative.png') %}
   {% set site_favicon = asset_for('assets/images/planner-hub-logo-negative.png') %}

    {% set default_description = 'VNV Events is a full-service event company in South Florida specializing in weddings, corporate events, private parties, catering, DJs, photo booth rentals, and event production. Serving Broward, Miami-Dade, and Palm Beach with premium, all-in-one event experiences.' %}

    {% set default_keywords = 'VNV Events, event planner South Florida, wedding planner South Florida, corporate event planning Miami, event company Broward, party planning Palm Beach, catering South Florida, wedding catering Miami, DJ services South Florida, photo booth rental Miami, event production company Florida, luxury events South Florida, event coordination Broward, private events Miami, full service event company, wedding services Miami, event rentals South Florida, VNV Studio, Avomeal, South Florida events' %}

    {% set default_og_image = site_logo %}

    {% set robots_value = page_seo.robots|default('index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1') %}
    <meta name="robots" content="{{ robots_value }}">
    <meta name="googlebot" content="{{ robots_value }}">
    <meta name="bingbot" content="{{ robots_value }}">

    {% set description_value = page_seo.description|default(block('meta_description') is defined ? block('meta_description')|striptags|trim : default_description) %}
    <meta name="description" content="{{ description_value ?: default_description }}">
    <meta name="keywords" content="{% block meta_keywords %}{{ default_keywords }}{% endblock %}">
    <meta name="author" content="VNV Events">
    <meta name="publisher" content="VNV Events">
    <meta name="application-name" content="VNV Events">
    <meta name="apple-mobile-web-app-title" content="VNV Events">
    <meta name="format-detection" content="telephone=no">
    <meta name="theme-color" content="#1f1307">
