    <meta property="og:site_name" content="VNV Events">
    {% set og_type_value = page_seo.og_type|default(block('og_type') is defined ? block('og_type')|striptags|trim : 'website') %}
    {% set og_title_value = page_seo.title|default(block('og_title') is defined ? block('og_title')|striptags|trim : title_value) %}
    {% set og_description_value = page_seo.description|default(block('og_description') is defined ? block('og_description')|striptags|trim : description_value) %}
    {% set og_url_value = page_seo.canonical|default(block('og_url') is defined ? block('og_url')|striptags|trim : canonical_value) %}
    {% set og_image_value = page_seo.og_image|default(block('og_image') is defined ? block('og_image')|striptags|trim : default_og_image) %}
    <meta property="og:type" content="{{ og_type_value ?: 'website' }}">
