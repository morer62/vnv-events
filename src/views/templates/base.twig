    <meta property="og:image" content="{{ og_image_value ?: default_og_image }}">
    <meta property="og:image:alt" content="{{ page_seo.og_image_alt|default(block('og_image_alt') is defined ? block('og_image_alt')|striptags|trim : 'VNV Events logo') }}">
    <meta property="og:locale" content="en_US">

    <meta name="twitter:card" content="summary_large_image">
