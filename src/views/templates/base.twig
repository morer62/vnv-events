    <style>
      .floating-whatsapp{
          position:fixed;
          right:20px;
          bottom:20px;
          z-index:10;
          display:inline-flex;
          align-items:center;
          gap:.65rem;
          padding:.9rem 1.1rem;
          border-radius:999px;
          background:#25D366;
          color:#fff !important;
          text-decoration:none;
          font-weight:800;
          box-shadow:0 14px 30px rgba(0,0,0,.18);
          transition:transform .2s ease, box-shadow .2s ease;
      }

      .floating-whatsapp i{
          font-size:1.3rem;
      }

      .floating-whatsapp:hover{
          transform:translateY(-2px);
          box-shadow:0 18px 36px rgba(0,0,0,.22);
      }

      @media (max-width: 768px){
          .floating-whatsapp{
              right:14px;
              bottom:14px;
              width:66px;
              height:66px;
              justify-content:center;
              border-radius:50%;
              padding:0;
          }

          .floating-whatsapp span{
              display:none;
          }

          .floating-whatsapp i{
              font-size:2rem;
          }
      }

      /* =========================
   PUBLIC HEADER VNV
========================= */
.vnv-public-header{
    position: sticky;
    top: 0;
    z-index: 1200;
    background: rgba(255,255,255,0.78);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(17,24,26,0.06);
}

.vnv-public-header__inner{
    min-height: 92px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:24px;
}

.vnv-public-header__brand{
    display:flex;
    align-items:center;
    gap:14px;
    text-decoration:none;
    min-width: 0;
}

.vnv-public-header__logo-mark{
    width:54px;
    height:54px;
    border-radius:18px;
    display:flex;
    align-items:center;
    justify-content:center;
    background: linear-gradient(145deg, rgba(94,198,196,0.10), rgba(197,160,89,0.10));
    border:1px solid rgba(17,24,26,0.06);
    flex-shrink:0;
    overflow:hidden;
}

.vnv-public-header__logo-mark img{
    width: 36px;
    height: 36px;
    object-fit: contain;
}

.vnv-public-header__brand-text{
    display:flex;
    flex-direction:column;
    line-height:1.05;
}

.vnv-public-header__brand-text strong{
    font-size: 1.05rem;
    letter-spacing: 2px;
    color:#12191b;
    font-weight:800;
}

.vnv-public-header__brand-text small{
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--vnv-primary);
    font-weight:700;
}

.vnv-public-header__nav{
    align-items:center;
    gap: 10px;
    padding: 8px;
    border-radius: 999px;
    background: rgba(17,24,26,0.04);
    border: 1px solid rgba(17,24,26,0.06);
}

.vnv-public-header__nav a{
    text-decoration:none;
    color:#192123;
    font-weight:700;
    font-size:.95rem;
    padding:12px 18px;
    border-radius:999px;
    transition: .25s ease;
}

.vnv-public-header__nav a:hover{
    background:#fff;
    color:#000;
    box-shadow: 0 12px 24px rgba(0,0,0,0.06);
}

.vnv-public-header__actions{
    align-items:center;
    gap:12px;
}

.vnv-public-header__icon{
    width:44px;
    height:44px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    text-decoration:none;
    color:#11181a;
    background: rgba(17,24,26,0.05);
    border:1px solid rgba(17,24,26,0.06);
    transition:.25s ease;
}

.vnv-public-header__icon:hover{
    transform: translateY(-2px);
    background:#fff;
    color: var(--vnv-primary);
}

.vnv-public-header__cta{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:14px 22px;
    border-radius:999px;
    text-decoration:none;
    font-size:.82rem;
    font-weight:800;
    letter-spacing:2px;
    text-transform:uppercase;
    color:#000;
    background: var(--vnv-gold-gradient);
    box-shadow: 0 16px 30px rgba(197,160,89,0.18);
}

.vnv-public-header__toggle{
    width:52px;
    height:52px;
    border-radius:16px;
    border:1px solid rgba(17,24,26,0.08);
    background:#fff;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:6px;
    box-shadow: 0 12px 24px rgba(0,0,0,0.05);
}

.vnv-public-header__toggle span{
    width:20px;
    height:2px;
    background:#11181a;
    border-radius:10px;
    transition:.25s ease;
}

.vnv-public-header__toggle.is-active span:first-child{
    transform: translateY(4px) rotate(45deg);
}
.vnv-public-header__toggle.is-active span:last-child{
    transform: translateY(-4px) rotate(-45deg);
}

.vnv-public-mobile-panel{
    display:none;
    border-top:1px solid rgba(17,24,26,0.06);
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(20px);
}

.vnv-public-mobile-panel.is-open{
    display:block;
}

.vnv-public-mobile-panel__content{
    padding: 18px 0 24px;
    display:flex;
    flex-direction:column;
    gap:10px;
}

.vnv-public-mobile-panel__content > a{
    text-decoration:none;
    color:#11181a;
    font-weight:800;
    padding:14px 0;
    border-bottom:1px solid rgba(17,24,26,0.06);
}

.vnv-public-mobile-panel__meta{
    padding-top:14px;
    display:flex;
    flex-direction:column;
    gap:10px;
}

.vnv-public-mobile-panel__meta a{
    text-decoration:none;
    color:#475254;
    font-weight:600;
}

.vnv-public-mobile-panel__socials{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    padding-top:12px;
}

.vnv-public-mobile-panel__socials a{
    width:44px;
    height:44px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    text-decoration:none;
    background:#11181a;
    color:#fff;
}

/* =========================
   PUBLIC FOOTER VNV
========================= */
.vnv-public-footer{
    background:
        radial-gradient(circle at top left, rgba(94,198,196,0.10), transparent 28%),
        radial-gradient(circle at bottom right, rgba(197,160,89,0.10), transparent 24%),
        #0b0f10;
    padding: 0 0 70px;
    position: relative;
    overflow: hidden;
}

.vnv-public-footer__shell{
    background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.015));
    border:1px solid rgba(255,255,255,0.06);
    border-radius: 36px;
    padding: 42px;
    box-shadow: 0 30px 80px rgba(0,0,0,0.18);
}

.vnv-public-footer__brandbox,
.vnv-public-footer__card{
    height:100%;
}

.vnv-public-footer__eyebrow{
    color: var(--vnv-primary);
    font-size: .78rem;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 18px;
}

.vnv-public-footer__brandbox h3{
    color:#fff;
    font-size: clamp(1.8rem, 2.4vw, 2.6rem);
    line-height:1.08;
    margin-bottom:18px;
}

.vnv-public-footer__brandbox p,
.vnv-public-footer__card p{
    color: rgba(255,255,255,0.66);
    margin:0;
}

.vnv-public-footer__title{
    color:#fff;
    font-size:1rem;
    font-weight:800;
    letter-spacing:1px;
    margin-bottom:18px;
}

.vnv-public-footer__list{
    list-style:none;
    margin:0;
    padding:0;
    display:flex;
    flex-direction:column;
    gap:12px;
}

.vnv-public-footer__list a,
.vnv-public-footer__textlink{
    color: rgba(255,255,255,0.68);
    text-decoration:none;
    transition:.25s ease;
}

.vnv-public-footer__list a:hover,
.vnv-public-footer__textlink:hover{
    color: var(--vnv-primary);
}

.vnv-public-footer__socials{
    display:flex;
    flex-wrap:wrap;
    gap:12px;
    margin-top:24px;
}

.vnv-public-footer__socials a{
    width:46px;
    height:46px;
    border-radius:16px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-decoration:none;
    color:#fff;
    background: rgba(255,255,255,0.06);
    border:1px solid rgba(255,255,255,0.07);
    transition:.25s ease;
}

.vnv-public-footer__socials a:hover{
    transform: translateY(-3px);
    background: rgba(94,198,196,0.14);
    color: var(--vnv-primary);
}

.vnv-public-footer__bottom{
    border-top:1px solid rgba(255,255,255,0.08);
    margin-top:34px;
    padding-top:24px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:18px;
    flex-wrap:wrap;
}

.vnv-public-footer__hours{
    display:flex;
    flex-wrap:wrap;
    gap:14px 22px;
    color: rgba(255,255,255,0.58);
    font-size:.95rem;
}

.vnv-public-footer__bottom p{
    margin:0;
    color: rgba(255,255,255,0.48);
    font-size:.95rem;
}

@media (max-width: 1399px){
    .vnv-public-header__nav a{
        padding: 12px 14px;
        font-size: .9rem;
    }
}

@media (max-width: 1199px){
    .vnv-public-header__inner{
        min-height:84px;
    }

    .vnv-public-footer__shell{
        padding: 34px 28px;
        border-radius: 28px;
    }
}

@media (max-width: 767px){
    .vnv-public-header__brand-text strong{
        font-size: .92rem;
    }

    .vnv-public-header__brand-text small{
        font-size: .62rem;
        letter-spacing: 2px;
    }

    .vnv-public-footer__shell{
        padding: 26px 20px;
    }

    .vnv-public-footer__bottom{
        flex-direction:column;
        align-items:flex-start;
    }

    .vnv-public-footer__hours{
        flex-direction:column;
        gap:8px;
    }
}

