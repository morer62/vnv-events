    <style>
      .floating-whatsapp{
          position:fixed;
          right:20px;
          bottom:20px;
          z-index:10;
          display:inline-flex;
          align-items:center;
          gap:.65rem;
          padding:.9rem 1.1rem;
          border-radius:999px;
          background:#25D366;
          color:#fff !important;
          text-decoration:none;
          font-weight:800;
          box-shadow:0 14px 30px rgba(0,0,0,.18);
          transition:transform .2s ease, box-shadow .2s ease;
      }

      .floating-whatsapp i{
          font-size:1.3rem;
      }

      .floating-whatsapp:hover{
          transform:translateY(-2px);
          box-shadow:0 18px 36px rgba(0,0,0,.22);
      }

      @media (max-width: 768px){
          .floating-whatsapp{
              right:14px;
              bottom:14px;
              width:66px;
              height:66px;
              justify-content:center;
              border-radius:50%;
              padding:0;
          }

          .floating-whatsapp span{
              display:none;
          }

          .floating-whatsapp i{
              font-size:2rem;
          }
      }
      </style>

