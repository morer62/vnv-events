    {# -------------------------------------------------------
       CANONICAL / FAVICON / APP ICONS
       ------------------------------------------------------- #}
    {% set canonical_value = page_seo.canonical|default(block('canonical') is defined ? block('canonical')|striptags|trim : site_url) %}
    <link rel="canonical" href="{{ canonical_value ?: site_url }}">
    <link rel="icon" type="image/png" href="{{ site_favicon }}">
    <link rel="shortcut icon" href="{{ site_favicon }}">
    <link rel="apple-touch-icon" href="{{ site_favicon }}">
    <link rel="mask-icon" href="{{ site_favicon }}" color="#1f1307">

