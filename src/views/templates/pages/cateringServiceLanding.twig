{% extends "templates/base.twig" %}

{% set show_whatsapp = false %}
{% set defer_public_third_party = true %}
{% set skip_public_gtm_initial = true %}
{% set initial_whatsapp_url = 'https://wa.me/' ~ page.whatsapp_number ~ '?text=' ~ page.whatsapp_message|url_encode %}

{% block title %}{{ page.meta_title|replace({'&':'and'}) }}{% endblock %}
{% block meta_description %}{{ page.meta_description }}{% endblock %}
{% block meta_keywords %}{{ page.meta_keywords }}{% endblock %}
{% block canonical %}{{ page.canonical_url }}{% endblock %}
{% block og_image %}{{ asset_for(page.hero_image) }}{% endblock %}
{% block og_image_alt %}{{ page.image_alt }}{% endblock %}

{% block head %}
<link rel="preload" as="image" href="{{ asset_for(page.hero_image) }}" fetchpriority="high">
<script type="application/ld+json">{{ page.schema|json_encode|raw }}</script>
{% endblock %}

{% block styles %}
<style>
:root{--cl-ink:#090c0d;--cl-card:#151b1c;--cl-mint:#5ec6c4;--cl-gold:#c5a059;--cl-paper:#f4f7f8;--cl-muted:#536164;--cl-danger:#a62424}*{box-sizing:border-box}html,body{width:100%;max-width:100%;overflow-x:hidden}body{margin:0;background:var(--cl-ink);color:#fff;font-family:"Trebuchet MS","Segoe UI",sans-serif;line-height:1.65}.cl-wrap{width:min(1140px,calc(100% - 32px));margin:auto}.cl-hero{min-height:82vh;display:grid;align-items:center;padding:126px 0 76px;background:linear-gradient(90deg,rgba(6,9,9,.96),rgba(6,9,9,.55)),url('{{ asset_for(page.hero_image) }}') center/cover}.cl-eyebrow{color:var(--cl-mint);font-size:.76rem;font-weight:900;letter-spacing:.15em;text-transform:uppercase}.cl-hero h1,.cl-title,.cl-card h2,.cl-cta h2{font-family:Georgia,"Times New Roman",serif;overflow-wrap:anywhere}.cl-hero h1{font-size:clamp(2.55rem,6.3vw,5.3rem);line-height:1.01;max-width:920px;margin:12px 0 14px}.cl-price-line{display:flex;flex-wrap:wrap;gap:10px 18px;align-items:center;margin:16px 0;font-weight:900}.cl-price-line strong{font-size:clamp(1.35rem,3vw,2.2rem);color:#fff}.cl-minimum{padding:7px 12px;border-radius:999px;background:rgba(94,198,196,.17);color:var(--cl-mint)}.cl-lead{max-width:760px;font-size:1.12rem;color:rgba(255,255,255,.84)}.cl-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}.cl-btn{min-height:48px;display:inline-flex;align-items:center;justify-content:center;padding:13px 21px;border:0;border-radius:999px;background:var(--cl-gold);color:#101313;text-decoration:none;font:inherit;font-weight:900;cursor:pointer}.cl-btn.alt{background:transparent;color:var(--cl-mint);border:2px solid var(--cl-mint)}.cl-btn.dark{background:#0c7773;color:#fff}.cl-btn:focus-visible,.cl-input:focus-visible,.cl-faq summary:focus-visible{outline:3px solid #fff;outline-offset:3px}.cl-trust{display:flex;flex-wrap:wrap;gap:12px 30px;margin-top:26px;color:rgba(255,255,255,.72);font-size:.9rem}.cl-section{padding:88px 0}.cl-light{background:var(--cl-paper);color:#111718}.cl-heading{max-width:820px;margin-bottom:38px}.cl-title{font-size:clamp(2.1rem,5vw,3.8rem);line-height:1.06;margin:10px 0}.cl-heading p,.cl-card p,.cl-card li,.cl-faq p{color:var(--cl-muted)}.cl-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:28px;align-items:stretch}.cl-card{padding:clamp(24px,5vw,44px);border-radius:28px;background:#fff;border:1px solid #dde4e5;box-shadow:0 18px 55px rgba(0,0,0,.08)}.cl-card.dark{background:linear-gradient(145deg,#1b2223,#111516);border-color:rgba(94,198,196,.16)}.cl-card.dark p,.cl-card.dark li{color:rgba(255,255,255,.74)}.cl-card h2{font-size:2.15rem;line-height:1.1;margin:8px 0 16px}.cl-card ul{padding-left:20px}.cl-card li{margin:8px 0}.cl-price{font-size:clamp(2rem,5vw,3.4rem);font-weight:900;color:var(--cl-mint);line-height:1.05}.cl-price small{display:block;font-size:.85rem;color:rgba(255,255,255,.66);margin-top:10px;font-weight:500}.cl-media{border-radius:28px;overflow:hidden;min-height:420px}.cl-media img{width:100%;height:100%;object-fit:cover;display:block}.cl-choice-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.cl-choice{padding:25px;border-radius:20px;background:#fff;border:1px solid #dce4e5}.cl-choice strong{display:block;color:#087a76;font-size:1.12rem;margin-bottom:7px}.cl-choice p{color:var(--cl-muted);margin:0}.cl-faq details{background:#fff;border:1px solid #dce3e4;border-radius:16px;padding:18px 22px;margin:12px 0}.cl-faq summary{font-weight:900;cursor:pointer}.cl-related{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}.cl-related a{color:#087a76;border:1px solid #9fcfcd;border-radius:999px;padding:9px 14px;text-decoration:none;font-weight:800}.cl-quote{background:#fff;color:#111718}.cl-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.cl-field label{display:block;font-weight:900;margin-bottom:6px}.cl-field.full{grid-column:1/-1}.cl-input{width:100%;min-height:48px;border:1px solid #9fb0b2;border-radius:12px;padding:11px 13px;background:#fff;color:#111;font:inherit}.cl-help{font-size:.86rem;color:#5d696b}.cl-notice{padding:15px 18px;border-radius:12px;margin-bottom:22px;background:#e5f5ef;color:#17513d}.cl-notice.error{background:#fde8e8;color:#741b1b}.cl-honeypot{position:absolute!important;left:-9999px!important}.cl-cta{text-align:center;padding:82px 16px 110px;background:radial-gradient(circle at top,#263738,#090c0d)}.cl-cta h2{font-size:clamp(2.3rem,5vw,4.1rem);max-width:820px;margin:0 auto 16px}.cl-cta p{color:rgba(255,255,255,.75)}.cl-mobile-bar{display:none}.cl-ads-label{font-size:.8rem;color:#647174;margin:10px 0 0}
@media(max-width:800px){body{padding-bottom:calc(86px + env(safe-area-inset-bottom))}.cl-grid,.cl-choice-grid,.cl-form{grid-template-columns:1fr}.cl-field.full{grid-column:auto}.cl-media{min-height:290px}.cl-section{padding:68px 0}.cl-btn{width:100%}.cl-hero{min-height:auto;padding:62px 0 96px}.cl-hero h1{font-size:clamp(2.15rem,10.5vw,3.8rem);margin:8px 0 10px}.cl-hero .cl-actions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.cl-hero .cl-actions .cl-btn{width:auto;min-height:48px;padding:9px 5px;font-size:.82rem}.cl-trust{display:grid}.cl-mobile-bar{position:fixed;display:grid;grid-template-columns:1fr 1fr;left:0;right:0;bottom:0;z-index:1000;padding:8px 10px calc(8px + env(safe-area-inset-bottom));background:#0c1112;border-top:1px solid rgba(255,255,255,.15);gap:8px}.cl-mobile-bar a{min-height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;text-decoration:none;font-weight:900}.cl-mobile-call{background:#fff;color:#111}.cl-mobile-wa{background:#1f9d64;color:#fff}}
</style>
{% endblock %}

{% block body %}
{% if not page.ads_mode %}{% include "templates/layout/publicHeaderVnv.html.twig" %}{% endif %}
<main>
<section class="cl-hero"><div class="cl-wrap">
  <span class="cl-eyebrow">VNV Gourmet · {{ page.eyebrow }}</span>
  <h1>{{ page.h1 }}</h1>
  <div class="cl-price-line"><strong>{{ page.store_price_label }}</strong><span class="cl-minimum">Minimum: {{ page.minimum }}</span></div>
  <p class="cl-lead">{{ page.hero_copy }}</p>
  <div class="cl-actions">
    <a class="cl-btn" href="tel:{{ page.phone_number }}" data-cl-call>Call now</a>
    <a class="cl-btn dark" href="{{ initial_whatsapp_url }}" target="_blank" rel="noopener" data-cl-whatsapp>WhatsApp</a>
    <a class="cl-btn alt" href="#quote">Get a quote</a>
  </div>
  <div class="cl-trust"><span>Broward · Miami-Dade · Palm Beach</span><span>Published starting price</span><span>Real VNV event service</span></div>
</div></section>

{% if page.service_key == 'corporate' and page.campaign_stations|default([]) %}
<section class="cl-section cl-light"><div class="cl-wrap"><div class="cl-heading"><span class="cl-eyebrow">Corporate catering stations</span><h2 class="cl-title">Choose the right station for your company event</h2><p>Corporate service begins at 50 guests. For groups of 25&ndash;49, use the regular station program shown on each service page.</p></div><div class="cl-choice-grid">{% for station in page.campaign_stations %}<article class="cl-choice"><strong>{{ station.name }}</strong><p>{{ station.price }} &middot; {{ station.minimum }}</p><a class="cl-btn dark" href="{{ path(station.landing_url) }}">View station</a></article>{% endfor %}</div></div></section>
{% if page.meal_box_price_label|default('') %}<section class="cl-section"><div class="cl-wrap"><div class="cl-grid"><article class="cl-card dark"><span class="cl-eyebrow">Separate format</span><h2>Corporate meal boxes</h2><div class="cl-price">{{ page.meal_box_price_label }}</div><p>Meal boxes are a separate breakfast or lunch format. Menu, quantity, packaging and delivery are confirmed in the proposal.</p></article><article class="cl-card dark"><h2>When boxes fit best</h2><p>Choose meal boxes when fast individual distribution matters more than a staffed station experience.</p></article></div></div></section>{% endif %}
{% endif %}

<section class="cl-section cl-light"><div class="cl-wrap"><div class="cl-heading"><span class="cl-eyebrow">What is included</span><h2 class="cl-title">{{ page.section_title }}</h2><p>{{ page.section_copy }}</p></div><div class="cl-grid"><div class="cl-media"><img src="{{ asset_for(page.secondary_image) }}" alt="{{ page.image_alt }}" width="720" height="600" loading="lazy" decoding="async"></div><article class="cl-card"><h2>Included with this service</h2><ul>{% for item in page.included %}<li>{{ item }}</li>{% endfor %}</ul><p>{{ page.inclusion_note }}</p><a class="cl-btn dark" href="{{ page.ads_mode ? '#menu' : page.product_url }}">View menu and options</a></article></div></div></section>

<section class="cl-section"><div class="cl-wrap"><div class="cl-grid"><article class="cl-card dark"><span class="cl-eyebrow">Current store price</span><div class="cl-price">{{ page.store_price_label }}<small>Minimum: {{ page.minimum }}</small></div><p>{{ page.price_note }}</p><p><strong>Base price loaded from the VNV Store. Add-ons and combinations do not change this “From” price.</strong></p></article><article class="cl-card dark"><h2>Recommended occasions</h2><ul>{% for item in page.best_for %}<li>{{ item }}</li>{% endfor %}</ul></article></div></div></section>

<section class="cl-section cl-light" id="menu"><div class="cl-wrap"><div class="cl-heading"><span class="cl-eyebrow">Menu choices</span><h2 class="cl-title">Make the station fit your event</h2></div><div class="cl-choice-grid">{% for choice in page.choices %}<div class="cl-choice"><strong>{{ choice.title }}</strong><p>{{ choice.copy }}</p></div>{% endfor %}</div>{% if not page.ads_mode %}<div class="cl-related"><a href="{{ path('/catering-stations-south-florida/') }}">Compare Pasta, Appetizers, Crepes and Taco</a><a href="{{ path('/vnv-gourmet') }}">Explore VNV Gourmet</a><a href="{{ page.product_url }}">Current menu</a></div>{% endif %}</div></section>

<section class="cl-section cl-light" style="padding-top:0"><div class="cl-wrap cl-faq"><div class="cl-heading"><span class="cl-eyebrow">Questions</span><h2 class="cl-title">Before you reserve</h2></div>{% for faq in page.faqs %}<details><summary>{{ faq.question }}</summary><p>{{ faq.answer }}</p></details>{% endfor %}</div></section>

<section class="cl-section cl-quote" id="quote"><div class="cl-wrap"><div class="cl-heading"><span class="cl-eyebrow">Quick quote request</span><h2 class="cl-title">Check availability in one step</h2><p>Share the essentials. Phone or email is required; both are welcome.</p></div>
{% if page.landing_notice.message|default('') %}<div class="cl-notice {{ page.landing_notice.type == 'error' ? 'error' : '' }}" role="status" aria-live="polite">{{ page.landing_notice.message }}</div>{% endif %}
<form class="cl-card cl-form" method="post" action="{{ path('/api/public/gourmet-lead') }}" data-cl-form>
  <input type="hidden" name="csrf_token" value="{{ get_csrf() }}">
  <input type="hidden" name="service" value="{{ page.service_key }}">
  <input type="hidden" name="service_name" value="{{ page.service_name }}">
  <input type="hidden" name="landing_url" value="/{{ page.slug }}/">
  <input type="hidden" name="ref_code" value="{{ page.ref_code }}">
  <input type="hidden" name="vnv_test" value="{{ page.is_test ? '1' : '0' }}">
  {% for key in ['gclid','gbraid','wbraid','utm_source','utm_medium','utm_campaign','utm_term','utm_content'] %}<input type="hidden" name="{{ key }}" value="" data-cl-attribution="{{ key }}">{% endfor %}
  <div class="cl-honeypot" aria-hidden="true"><label>Website<input type="text" name="company_website" tabindex="-1" autocomplete="off"></label></div>
  <div class="cl-field"><label for="cl-date">Event date</label><input class="cl-input" id="cl-date" name="event_date" type="date" min="{{ page.minimum_event_date }}" required></div>
  <div class="cl-field"><label for="cl-guests">Guests</label><select class="cl-input" id="cl-guests" name="guest_bucket" required><option value="">Choose a range</option><option value="25-40">25–40</option><option value="41-75">41–75</option><option value="76-150">76–150</option><option value="150+">150+</option><option value="fewer-than-25">Fewer than 25</option></select></div>
  <div class="cl-field"><label for="cl-zip">Event ZIP</label><input class="cl-input" id="cl-zip" name="zip" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" required></div>
  <div class="cl-field"><label for="cl-name">Name <span class="cl-help">(optional)</span></label><input class="cl-input" id="cl-name" name="full_name" autocomplete="name"></div>
  <div class="cl-field"><label for="cl-phone">Phone</label><input class="cl-input" id="cl-phone" name="phone" type="tel" autocomplete="tel"></div>
  <div class="cl-field"><label for="cl-email">Email</label><input class="cl-input" id="cl-email" name="email" type="email" autocomplete="email"></div>
  <div class="cl-field full"><p class="cl-help">For groups under 25, submit the request and our team will confirm the smaller-format options currently available.</p><button class="cl-btn dark" type="submit">Send request</button></div>
</form></div></section>

<section class="cl-cta"><h2>{{ page.cta_title }}</h2><p>{{ page.cta_copy }}</p><div class="cl-actions" style="justify-content:center"><a class="cl-btn" href="#quote">Get a quote</a><a class="cl-btn alt" href="{{ page.ads_mode ? '#menu' : page.product_url }}">View menu</a></div></section>
</main>
{% if not page.ads_mode %}{% include "templates/layout/publicFooterVnv.html.twig" %}{% endif %}
<div class="cl-mobile-bar" aria-label="Quick contact"><a class="cl-mobile-call" href="tel:{{ page.phone_number }}" data-cl-call>Call</a><a class="cl-mobile-wa" href="{{ initial_whatsapp_url }}" target="_blank" rel="noopener" data-cl-whatsapp>WhatsApp</a></div>
{% if not page.ads_mode %}
{% include "templates/components/publicEventRequestModal.html.twig" with {
  request_form_source: 'gourmet_landing_' ~ page.service_key
} %}
{% endif %}
{% endblock %}

{% block scripts %}
<script>
(function(){
  const keys=['gclid','gbraid','wbraid','utm_source','utm_medium','utm_campaign','utm_term','utm_content'];
  const q=new URLSearchParams(location.search),maxAge=7776000,secure=location.protocol==='https:'?'; Secure':'';
  if(q.get('gclid')||q.get('gbraid')||q.get('wbraid')||(q.get('utm_source')||'').toLowerCase()==='google'){document.cookie='vnv_ads_session=1; Path=/; SameSite=Lax'+secure;}
  keys.forEach(function(key){const incoming=q.get(key);if(incoming){document.cookie='vnv_'+key+'='+encodeURIComponent(incoming)+'; Max-Age='+maxAge+'; Path=/; SameSite=Lax'+secure;}const match=document.cookie.match(new RegExp('(?:^|; )vnv_'+key+'=([^;]*)'));const value=incoming||(match?decodeURIComponent(match[1]):'');document.querySelectorAll('[data-cl-attribution="'+key+'"]').forEach(function(input){input.value=value;});});
  const form=document.querySelector('[data-cl-form]'),date=document.getElementById('cl-date'),guests=document.getElementById('cl-guests'),zip=document.getElementById('cl-zip');
  function track(event,extra){window.vnvTrackMarketingEvent(event,Object.assign({service:'{{ page.service_key|e('js') }}',ref_code:'{{ page.ref_code|e('js') }}',landing_url:location.pathname},extra||{}));}
  function waUrl(){const message=['Hi VNV Events, I am interested in {{ page.service_name|e('js') }}.','Visible price: {{ page.store_price_label|e('js') }}','Event date: '+(date?.value||'Not provided'),'Guests: '+(guests?.options[guests.selectedIndex]?.text||'Not provided'),'ZIP: '+(zip?.value||'Not provided'),'Reference: {{ page.ref_code|e('js') }}'].join('\n');return 'https://wa.me/{{ page.whatsapp_number|e('js') }}?text='+encodeURIComponent(message);}
  document.querySelectorAll('[data-cl-call]').forEach(a=>a.addEventListener('click',()=>track('call_click',{method:'phone'})));
  document.querySelectorAll('[data-cl-whatsapp]').forEach(function(a){a.addEventListener('click',function(){a.href=waUrl();track('whatsapp_click',{method:'whatsapp'});const payload={csrf_token:form?.querySelector('[name=csrf_token]')?.value||'',service:'{{ page.service_key|e('js') }}',landing_url:location.pathname,ref_code:'{{ page.ref_code|e('js') }}',vnv_test:form?.querySelector('[name=vnv_test]')?.value||'0'};keys.forEach(k=>payload[k]=form?.querySelector('[name='+k+']')?.value||'');navigator.sendBeacon('{{ path('/api/public/gourmet-track') }}',new Blob([JSON.stringify(payload)],{type:'application/json'}));});});
  form?.addEventListener('submit',function(event){const phone=form.phone.value.replace(/\D/g,''),email=form.email.value.trim();if(phone.length<10&&!email){event.preventDefault();alert('Please enter a phone number or email address.');}});
  const leadId=(q.get('lead_id')||'').replace(/[^0-9]/g,'');
  if(q.get('lead')==='success'&&leadId){const eventId='gourmet-request-'+leadId,storageKey='vnv_tracked_generate_lead_'+eventId;if(!sessionStorage.getItem(storageKey)){track('generate_lead',{event_id:eventId,lead_qualified:q.get('lead_qualified')==='1',form_name:'gourmet_short_form'});sessionStorage.setItem(storageKey,'1');}}
})();
</script>
{% endblock %}
