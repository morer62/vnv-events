APP_ENV=debug|prod
DATABASE_URL=mysql:host=[host];port=[port];dbname=[db];user=[user];password=[password]

# VNV Events public site scope
SITE_KEY=vnvevents
SITE_NAME="VNV Events"
SITE_PUBLIC_BASE_URL=https://vnvevents.com
SITE_BUSINESS_USER_ID=2
AVOMEAL_BUSINESS_USER_ID=2
VNV_EVENTS_OWNER_ID=2
STORE_OWNER_ID=2
STORE_MINIMUM_ORDER_AMOUNT=65.00
AVOMEAL_BRAND_NAME="Avomeal"

# Ophyra Growth Hub public content source.
# This site must consume only VNV Events content from Ophyra.
OPHYRA_BASE_URL=http://localhost/ophyra
OPHYRA_GROWTH_SITE_KEY=vnvevents
OPHYRA_GROWTH_TIMEOUT=4
PUBLIC_BASE_URL=https://vnvevents.com

# AI Content Assistant - VNV Events default.
# To port this same sprint to Avomeal, set AI_CONTENT_SITE_KEY=avomeal and keep owner/business ids as needed.
OPENAI_TOKEN=
AI_CONTENT_ENABLED=false
AI_CONTENT_DAILY_BLOG_COUNT=1
AI_CONTENT_DAILY_LOCATION_COUNT=5
AI_CONTENT_AUTO_PUBLISH=false
AI_CONTENT_REQUIRE_APPROVAL=true
AI_CONTENT_DEFAULT_LANGUAGE=en
AI_CONTENT_REVIEW_PASSWORD=CHANGE_ME
AI_CONTENT_REVIEW_REMEMBER_DAYS=30
AI_CONTENT_SITE_KEY=vnv_events
AI_CONTENT_OWNER_ID=2
AI_CONTENT_ID_USER_BUSINESS=2
AI_CONTENT_CLOUDINARY_ENABLED=true

# Absolute FFmpeg binary path for AI Video Studio final rendering.
# Windows example: C:\ffmpeg\bin\ffmpeg.exe
# Linux example: /usr/bin/ffmpeg
FFMPEG_PATH=

# Private SFTP inbox for large (500 MB–10 GB) Video Studio originals.
# Keep this outside the public web root in production and writable by both the SFTP user and PHP/worker user.
# Linux example: /srv/vnv-video-ingest/incoming
VIDEO_INGEST_PATH=
VIDEO_INGEST_STABLE_SECONDS=60

# Optional external publishing connectors. Draft creation and approval work without these.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
LINKEDIN_AUTHOR_URN=
LINKEDIN_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0
LINKEDIN_API_VERSION=202605

# Agent approval alerts and current public video-format signals.
AI_AGENT_NOTIFY_EMAIL=false
AI_AGENT_NOTIFY_PUSH=false
YOUTUBE_API_KEY=

# Meta Lead Ads webhook: /api/agents/meta-webhook
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_WEBHOOK_OWNER_ID=2

# OpenAI, Claude and Gemini keys can also be stored encrypted from Level 1 > Agents.
# VNV_SECRET_KEY must be stable between deployments or stored provider credentials cannot be decrypted.
AI_CONTENT_REDDIT_SOURCES_ENABLED=false
AI_CONTENT_MAX_PENDING_DRAFTS=50
AI_CONTENT_MODEL=gpt-4o-mini

APPLE_SERVICE_ID=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_SECRET_NAME=
APPLE_SIGN_IN_URL=https://appleid.apple.com/auth/authorize

APPLE_REDIRECT_SIGN_UP_URL=
APPLE_REDIRECT_SIGN_IN_URL=
APPLE_REDIRECT_CONNECT_ACCOUNT=
