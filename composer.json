{
    "name": "kenned/php-template",
    "require": {
        "vlucas/phpdotenv": "^5.6",
        "twig/twig": "^3.0",
        "ext-pdo": "*",
        "twilio/sdk": "^8.3",
        "stripe/stripe-php": "^16.6",
        "square/square": "^44.0",
        "ext-curl": "*",
        "ralouphie/mimey": "^1.0",
        "fpdf/fpdf": "^1.86",
        "firebase/php-jwt": "^6.11",
        "chillerlan/php-qrcode": "^5.0",
        "tecnickcom/tcpdf": "^6.10",
        "dompdf/dompdf": "^3.1",
        "aws/aws-sdk-php": "^3.349",
        "cloudinary/cloudinary_php": "^3.1", 
        "google/apiclient": "^v2.18.4",
        "ext-dom": "*",
        "ext-libxml": "*",
